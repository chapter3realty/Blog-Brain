new file mode 100644
index 00000000..b4b4ced6
--- /dev/null
+++ b/data/2026-11-a/buyers-retirees/README.md
@@ -0,0 +1,29 @@
+# Data for /buyers/retirees/ (batch 2026-11-a)
+
+Every chart and table on the page is built from a file here. Scripts write to this folder; raw downloads go in `raw/`.
+No owner names, street addresses or single-listing prices are kept.
+
+| Script | Pulls / builds | Writes |
+|---|---|---|
+| pull-suggestions.sh | Google search suggestions (30 searches) | raw/google-suggestions.txt |
+| pull_parcels.py | Horry County parcel layer 24: the four 55+ communities' home parcels (class, sale date, owner state only) and county-wide counts by class | raw/parcels-55plus.json, raw/county-class-stats.json |
+| analyze_parcels.py | Share of homes taxed at 4% (full-time home) per community and county | parcels-findings.json |
+| pull-cms.sh | CMS Hospital General Information, Horry and Georgetown | raw/cms-hospitals-*.json |
+| pull_drives.py | Census geocoder for hospitals; OSRM drives from each community | raw/geocodes.json, drives.json |
+| pull_zones.py | Horry County HazardsMap layers 2, 3, 8 at each community point | zones.json |
+| analyze_zones.py | SCEMD Know Your Zone polygons (downloaded to $RAW/scemd-evac-zones.json, 7 MB, kept out of the repo) against every home parcel | zones-findings.json |
+| pull-acs.sh | Census ACS S0101 (age) and B07001 (movers by age), Horry, SC, US | raw/acs-*.json |
+| pull-noaa.sh | NOAA 1991-2020 normals, Conway, Myrtle Beach, North Myrtle Beach airport | raw/noaa-*.csv |
+| pull_listings.py | Chapter3 CRM map API, aggregate counts of one-level houses and 55+ listings | listings-counts.json |
+| build_examples.py | Property tax on a $400,000 house (2026 levy) and three 2026 SC income tax examples | examples.json |
+| build_communities.py | One row per 55+ community for the comparison table | communities.json |
+
+Statutes and documents read are saved in raw/ (t12c006.html, t12c037.html, t12c043.html, h4216.htm, IL26-20.pdf, tax-levy-2026.pdf, scemd-annex-c-2026.pdf, lii26-86.html, lii42-3607.html).
+
+## Added by the writer (build)
+
+| File | What | Writes |
+|---|---|---|
+| pull_listings.py, re-run on build day into a scratch folder, plus one query for every one-level house under $400,000 | Aggregate counts of active listings | listings-counts-build.json |
+| build_page_data.py | The one file the page reads: the researcher's files with the verifier's corrections of 2026-11-02 applied (rows 25, 35, 45, 46), the build-day listing counts, and examples.json | page-data.json |
+| sctax.js | The 2026 South Carolina income tax rules of build_examples.py as one browser function. The spec checks it against the three examples on every build, and the page's calculator runs it. | (used by specs/retirees.js) |
diff --git a/data/2026-11-a/buyers-retirees/analyze_parcels.py b/data/2026-11-a/buyers-retirees/analyze_parcels.py
new file mode 100644
index 00000000..cf258000
--- /dev/null
+++ b/data/2026-11-a/buyers-retirees/analyze_parcels.py
@@ -0,0 +1,30 @@
+"""Findings from raw/parcels-55plus.json and raw/county-class-stats.json. Run: python3 -I analyze_parcels.py <datadir>
+Writes parcels-findings.json: per community, homes with a building, the share taxed at 4% (legal residence), the same for
+owners who bought before 2026 (a new owner's first bill can still carry the old class), and owners' mailing states (counts only)."""
+import sys, json, os, collections, datetime
+D = sys.argv[1]; R = json.load(open(os.path.join(D, "raw", "parcels-55plus.json")))
+C = json.load(open(os.path.join(D, "raw", "county-class-stats.json")))
+cut = datetime.datetime(2026, 1, 1).timestamp() * 1000
+res = {}
+for name, rows in R["parcels"].items():
+    homes = [r for r in rows if str(r["LandUseCode"]).startswith("1") and (r["MarketImprv"] or 0) > 0 and (r["TaxableProp"] or 0) > 0]
+    def cls(r): return "4%" if r["AssessedProp"] < r["TaxableProp"] * 0.05 else "6%"
+    lu = collections.Counter(r["LandUseCode"] for r in homes)
+    old = [r for r in homes if r["SaleDate"] and r["SaleDate"] < cut]
+    st = collections.Counter((r["OwnerState"] or "").strip() or "(blank)" for r in homes)
+    st_old = collections.Counter((r["OwnerState"] or "").strip() or "(blank)" for r in old)
+    n4 = sum(cls(r) == "4%" for r in homes); o4 = sum(cls(r) == "4%" for r in old)
+    ratios = collections.Counter(round(r["AssessedProp"] / r["TaxableProp"], 3) for r in homes)
+    res[name] = {"parcels_in_set": len(rows), "homes_with_building": len(homes), "landuse": dict(lu),
+                 "at_4pct": n4, "share_4pct": round(n4 / len(homes), 3),
+                 "owned_before_2026": len(old), "owned_before_2026_at_4pct": o4, "share_4pct_owned_before_2026": round(o4 / len(old), 3) if old else None,
+                 "owner_state_top": st.most_common(8), "owner_in_sc": st.get("SC", 0), "share_owner_mail_sc": round(st.get("SC", 0) / len(homes), 3),
+                 "owner_state_top_owned_before_2026": st_old.most_common(8),
+                 "ratio_values": dict(ratios.most_common(6))}
+cs = {(s["set"], s["class"], s["landuse"]): s["n"] for s in C["stats"]}
+for since in ["all", "owned before 2026"]:
+    for lu in ["all homes", "101 house"]:
+        a, b = cs[(since, "4%", lu)], cs[(since, "6%", lu)]
+        res["Horry County, %s, %s" % (lu, since)] = {"at_4pct": a, "at_6pct": b, "share_4pct": round(a / (a + b), 3)}
+json.dump(res, open(os.path.join(D, "parcels-findings.json"), "w"), indent=1)
+print(json.dumps(res, indent=1))
diff --git a/data/2026-11-a/buyers-retirees/analyze_zones.py b/data/2026-11-a/buyers-retirees/analyze_zones.py
new file mode 100644
index 00000000..97ac9e64
--- /dev/null
+++ b/data/2026-11-a/buyers-retirees/analyze_zones.py
@@ -0,0 +1,50 @@
+"""Which SCEMD hurricane evacuation zone (scemd.org/json/evac_zones.json, the polygons behind scemd.org Know Your Zone,
+file Last-Modified 2024-04-28) holds each 55+ community's reference point, and the county HazardsMap answer for comparison.
+Run: RAW=<scratch> python3 -I analyze_zones.py <datadir>. Reads raw/scemd-evac-zones.json and zones.json; writes zones-findings.json."""
+import sys, json, os
+D = sys.argv[1]
+ZF = os.path.join(os.environ.get("RAW", os.path.join(D, "raw")), "scemd-evac-zones.json")  # 7 MB; kept out of the repo. Set RAW to a scratch folder.
+if not os.path.exists(ZF):
+    import subprocess; subprocess.run(["curl", "-sS", "-m", "300", "-A", "Mozilla/5.0", "-o", ZF, "https://www.scemd.org/json/evac_zones.json?v=1.2"], check=True)
+Z = json.load(open(ZF))["features"]
+H = json.load(open(os.path.join(D, "zones.json")))
+ORIG = {"Del Webb at Grande Dunes": (-78.842661, 33.749305), "Del Webb North Myrtle Beach": (-78.700908, 33.821769),
+        "Myrtle Trace": (-78.996618, 33.778502), "Seasons at Prince Creek West": (-79.07094, 33.586369)}
+def rings(g):
+    if g["type"] == "Polygon": return [g["coordinates"]]
+    if g["type"] == "MultiPolygon": return g["coordinates"]
+    if g["type"] == "GeometryCollection": return [p for gg in g["geometries"] for p in rings(gg)]
+    return []
+def pip(x, y, ring):
+    c = False
+    for i in range(len(ring) - 1):
+        (x1, y1), (x2, y2) = ring[i][:2], ring[i + 1][:2]
+        if (y1 > y) != (y2 > y) and x < (x2 - x1) * (y - y1) / (y2 - y1) + x1: c = not c
+    return c
+def inpoly(x, y, poly): return pip(x, y, poly[0]) and not any(pip(x, y, h) for h in poly[1:])
+out = {}
+for name, (x, y) in ORIG.items():
+    hits = [f["properties"]["county"] + " " + f["properties"]["name"] for f in Z if any(inpoly(x, y, p) for p in rings(f["geometry"]))]
+    out[name] = {"point": [x, y], "scemd_zone": hits or ["none"],
+                 "county_hazardsmap_zone": [a.get("Zone") for a in H[name]["2"]["attributes"]] or ["none"],
+                 "fema_zone_at_point": [a.get("FLD_ZONE") for a in H[name]["8"]["attributes"]]}
+    print(name, out[name])
+json.dump(out, open(os.path.join(D, "zones-findings.json"), "w"), indent=1)
+# Every home parcel: centroid of its first ring (parcel layer 24, outSR 4326), same parcel sets as pull_parcels.py.
+import urllib.parse, subprocess, collections, time
+sys.path.insert(0, D)
+SETS = json.load(open(os.path.join(D, "raw", "parcels-55plus.json")))["sets"]
+Q = "https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer/24/query"
+GD_BOX = {"geometry": "-78.86,33.735,-78.82,33.765", "geometryType": "esriGeometryEnvelope", "inSR": "4326", "spatialRel": "esriSpatialRelIntersects"}
+for name, where in SETS.items():
+    p = dict(where=where, outFields="PIN,LandUseCode,MarketImprv", returnGeometry="true", outSR="4326", f="json", resultRecordCount=2000)
+    if name == "Del Webb at Grande Dunes": p.update(GD_BOX)
+    r = subprocess.run(["curl", "-sS", "-m", "300", "--data", urllib.parse.urlencode(p), Q], capture_output=True, text=True).stdout
+    feats = [f for f in json.loads(r)["features"] if str(f["attributes"]["LandUseCode"]).startswith("1") and (f["attributes"]["MarketImprv"] or 0) > 0]
+    cnt = collections.Counter()
+    for f in feats:
+        ring = f["geometry"]["rings"][0]; x = sum(p[0] for p in ring) / len(ring); y = sum(p[1] for p in ring) / len(ring)
+        hits = [z["properties"]["name"] for z in Z if z["properties"]["county"] == "Horry" and any(inpoly(x, y, pp) for pp in rings(z["geometry"]))]
+        cnt[",".join(hits) or "none"] += 1
+    out[name]["home_parcels_by_scemd_zone"] = dict(cnt); print(name, dict(cnt), flush=True)
+json.dump(out, open(os.path.join(D, "zones-findings.json"), "w"), indent=1)
diff --git a/data/2026-11-a/buyers-retirees/build_communities.py b/data/2026-11-a/buyers-retirees/build_communities.py
new file mode 100644
index 00000000..7b641958
--- /dev/null
+++ b/data/2026-11-a/buyers-retirees/build_communities.py
@@ -0,0 +1,29 @@
+"""One row per 55+ community for the comparison table, joined from this folder's data files.
+Measured here: homes with a building and the share taxed as a full-time home (parcels-findings.json), evacuation zone
+(zones-findings.json), drive to the nearest hospital (drives.json). Carried from the four live 55+ pages so the site gives
+one value (facts.md rows 29 to 32, 35, 41): HOA fee, years built, the guest rule, and the rounded drive minutes those pages print.
+Run: python3 -I build_communities.py <datadir>. Writes communities.json."""
+import sys, json, os
+D = sys.argv[1]
+P = json.load(open(os.path.join(D, "parcels-findings.json"))); Z = json.load(open(os.path.join(D, "zones-findings.json")))
+R = {(d["from"], d["to"]): d for d in json.load(open(os.path.join(D, "drives.json")))["drives"]}
+CARRIED = {  # value as printed on the community's own page; facts.md row in brackets
+  "Del Webb at Grande Dunes": {"url": "/buyers/55-plus-communities/del-webb-grande-dunes/", "where": "Myrtle Beach", "fee": "about $400 a month (house), $445 (villa)", "built": "2018 to 2026",
+                               "guests": "Under 19: up to 90 nights in any 12 months", "hospital": "Grand Strand Medical Center", "minutes": 6, "row": "29, 35"},
+  "Del Webb North Myrtle Beach": {"url": "/buyers/55-plus-communities/del-webb-north-myrtle-beach/", "where": "North Myrtle Beach", "fee": "about $315 a month", "built": "2022 to now",
+                                  "guests": "Not published", "hospital": "McLeod Health Seacoast", "minutes": 12, "row": "30, 35"},
+  "Myrtle Trace": {"url": "/buyers/55-plus-communities/myrtle-trace/", "where": "Conway", "fee": "$95 a month", "built": "mostly 1980s and 1990s",
+                   "guests": "No age limit for others in the home", "hospital": "Conway Medical Center", "minutes": 3, "row": "31, 35"},
+  "Seasons at Prince Creek West": {"url": "/buyers/55-plus-communities/seasons-at-prince-creek-west/", "where": "near Murrells Inlet", "fee": "about $340 a month", "built": "2006 to 2016",
+                                   "guests": "Under 18: visits up to 60 days a year", "hospital": "Tidelands Waccamaw Community Hospital", "minutes": 8, "row": "32, 35"},
+}
+rows = []
+for name, c in CARRIED.items():
+    p, z = P[name], Z[name]
+    zone = list(z["home_parcels_by_scemd_zone"].keys())
+    rows.append({"name": name, **c, "homes": p["homes_with_building"], "full_time_share": p["share_4pct"], "full_time_share_owned_before_2026": p["share_4pct_owned_before_2026"],
+                 "evacuation_zone": "none" if zone == ["none"] else ",".join(zone), "drive_measured_minutes": R[(name, c["hospital"])]["minutes"]})
+county = {"houses": P["Horry County, 101 house, all"]["share_4pct"], "all_homes": P["Horry County, all homes, all"]["share_4pct"]}
+json.dump({"communities": rows, "county_full_time_share": county}, open(os.path.join(D, "communities.json"), "w"), indent=1)
+for r in rows: print(r["name"], r["homes"], r["full_time_share"], r["evacuation_zone"], r["minutes"], r["drive_measured_minutes"])
+print(county)
