tyOfPage":{"@id":"https://chapter3realty.com/buyers/retirees/"},"about":{"@type":"Thing","name":"Retiring to Myrtle Beach and Horry County, South Carolina"},"keywords":"retire to Myrtle Beach, retiring in Myrtle Beach, is Myrtle Beach a good place to retire, does South Carolina tax pensions, South Carolina tax on Social Security, SC retirement income deduction 2026, homestead exemption Horry County, 55+ retirement communities near Myrtle Beach, Myrtle Beach hospitals, hurricane evacuation zones Myrtle Beach"}</script>
+<script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How do I apply for the homestead exemption in Horry County?","acceptedAnswer":{"@type":"Answer","text":"Apply at the Horry County Auditor's office, and inside a city at the city too, by July 15 for that year's bill. You must own the home, live in it as your legal home, have lived in South Carolina for a year, and have turned 65 by December 31 of the year before. The exemption takes the first $50,000 of the home's value off the tax."}},{"@type":"Question","name":"Can grandchildren visit a 55+ community near Myrtle Beach?","acceptedAnswer":{"@type":"Answer","text":"Yes, with limits that differ by community. In Del Webb at Grande Dunes, a visitor under 19 may stay overnight up to 90 days in any 12 months. In Seasons at Prince Creek West, a visitor under 18 may stay up to 60 days a year. In Myrtle Trace, no minimum age applies to anyone else in the home once one person is 55 or older."}},{"@type":"Question","name":"What makes a community 55+ under federal law?","acceptedAnswer":{"@type":"Answer","text":"To count as 55+ housing under federal fair housing law, a community needs at least one person 55 or older in at least 80 percent of its occupied homes. It must also publish and follow its age policy, and check ages."}},{"@type":"Question","name":"How many people 65 and older live in Horry County?","acceptedAnswer":{"@type":"Answer","text":"About 3 in 10 people in Horry County are 65 or older, against about 2 in 10 in South Carolina and in the U.S. as a whole."}},{"@type":"Question","name":"Does South Carolina tax Social Security?","acceptedAnswer":{"@type":"Answer","text":"No. South Carolina does not tax Social Security at all. Pensions and IRAs also get a deduction for each person, larger from the year you turn 65, and military retirement pay is deducted in full at any age."}}]}</script>
