play:block;width:100%;height:auto;aspect-ratio:var(--c3ph-r,4/3);object-fit:cover}.c3ph-card .c3ph-cr{font-size:.56rem;padding:1.2rem .45rem .25rem 1.6rem}.c3ph-card strong{display:block;color:var(--navy);font-size:.98rem;font-weight:500;line-height:1.3;padding:.7rem .8rem 0}.c3ph-card span.c3ph-t{display:block;color:var(--muted);font-size:.86rem;line-height:1.45;padding:.2rem .8rem .85rem}.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:620px}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Four 55+ communities have a full guide of their own on our site. In each, 83 to 93 percent of homes are taxed as someone's full-time home, against 76 percent of single-family houses across the county.</p><figure class="c3-gchart"><div role="table" aria-label="Share of homes taxed as someone's full-time home"><span class="cap" aria-hidden="true">Share of homes taxed as someone's full-time home</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Community, where</span><span role="columnheader">share</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n"><a href="#seasons-at-prince-creek-west">Seasons at Prince Creek West</a></span><span class="dot" aria-hidden="true">&middot;</span><span class="f">near Murrells Inlet</span></span><span role="cell"><span class="b" style="--f:0.93" aria-hidden="true"></span><span class="v">93%</span></span></div><div role="row"><span role="rowheader"><span class="n"><a href="#myrtle-trace">Myrtle Trace</a></span><span class="dot" aria-hidden="true">&middot;</span><span class="f">Conway</span></span><span role="cell"><span class="b" style="--f:0.87" aria-hidden="true"></span><span class="v">87%</span></span></div><div role="row"><span role="rowheader"><span class="n"><a href="#del-webb-grande-dunes">Del Webb at Grande Dunes</a></span><span class="dot" aria-hidden="true">&middot;</span><span class="f">Myrtle Beach</span></span><span role="cell"><span class="b" style="--f:0.86" aria-hidden="true"></span><span class="v">86%</span></span></div><div role="row"><span role="rowheader"><span class="n"><a href="#del-webb-north-myrtle-beach">Del Webb North Myrtle Beach</a></span><span class="dot" aria-hidden="true">&middot;</span><span class="f">North Myrtle Beach</span></span><span role="cell"><span class="b" style="--f:0.83" aria-hidden="true"></span><span class="v">83%</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">All single-family houses in the county</span></span><span role="cell"><span class="b" style="--f:0.76" aria-hidden="true"></span><span class="v">76%</span></span></div></div></div><figcaption>Our count of every home in the county's tax records. A home counts when the county taxes it at the 4 percent rate for a legal residence. The rest are second homes, rentals, homes owned by a company, and owners who have not applied.</figcaption></figure><h3 id="myrtle-trace" style="font-family:var(--serif);font-size:1.35rem;color:var(--navy);margin:2.2rem 0 .7rem;line-height:1.3">1. Myrtle Trace</h3><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/55-plus/myrtle-trace/myrtle-trace-from-above-1200w.webp" srcset="/images/55-plus/myrtle-trace/myrtle-trace-from-above-600w.webp 600w, /images/55-plus/myrtle-trace/myrtle-trace-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="675" alt="Myrtle Trace from above, with its edge drawn in orange: houses among tall pines and ponds, the clubhouse and main entrance marked, and the golf course next door" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo. License: Public domain" title="License: Public domain">U.S. government aerial photo</a></span></div><figcaption>Myrtle Trace from above. The orange line is the edge of the neighborhood. The golf course next door is not part of it.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Myrtle Trace, in Conway, has about 500 homes, mostly built in the 1980s and 1990s. Its HOA fee is the lowest of the four, $95 a month.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Under the HOA's rules, at least one person in each home must be 55 or older, and no minimum age is set for anyone else in the home. Read our <a href="/buyers/55-plus-communities/myrtle-trace/" style="color:var(--navy);text-decoration:underline">Myrtle Trace guide</a>.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Myrtle%20Trace">Get the homes for sale in Myrtle Trace<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p><h3 id="seasons-at-prince-creek-west" style="font-family:var(--serif);font-size:1.35rem;color:var(--navy);margin:2.2rem 0 .7rem;line-height:1.3">2. Seasons at Prince Creek West</h3><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/55-plus/seasons-at-prince-creek-west/seasons-at-prince-creek-west-homes-from-above-1200w.webp" srcset="/images/55-plus/seasons-at-prince-creek-west/seasons-at-prince-creek-west-homes-from-above-600w.webp 600w, /images/55-plus/seasons-at-prince-creek-west/seasons-at-prince-creek-west-homes-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="One-story homes with gray and tan roofs and wide lawns around a pond and a curving street in Seasons at Prince Creek West, seen from above" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo. License: Public domain" title="License: Public domain">U.S. government aerial photo</a></span></div><figcaption>One-story homes around a pond in Seasons at Prince Creek West, from above.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Seasons at Prince Creek West, near Murrells Inlet, has about 440 homes built from 2006 to 2016. It has the highest share of full-time homes of the four. Its HOA fee, about $340 a month, includes internet, weekly trash pickup and lawn care.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The 55+ resident must live there at least six months a year. No one under 18 may live there, and a visitor under 18 may stay up to 60 days a year.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Clients of ours owned a single-family home in Blackmoor, a golf community in Murrells Inlet with no age rule. They sold it and bought in Seasons at Prince Creek West. Read our <a href="/buyers/55-plus-communities/seasons-at-prince-creek-west/" style="color:var(--navy);text-decoration:underline">Seasons guide</a>.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Seasons%20at%20Prince%20Creek%20West">Get the homes for sale in Seasons at Prince Creek West<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p><h3 id="del-webb-grande-dunes" style="font-family:var(--serif);font-size:1.35rem;color:var(--navy);margin:2.2rem 0 .7rem;line-height:1.3">3. Del Webb at Grande Dunes</h3><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/55-plus/del-webb-grande-dunes/del-webb-grande-dunes-homes-from-above-1200w.webp" srcset="/images/55-plus/del-webb-grande-dunes/del-webb-grande-dunes-homes-from-above-600w.webp 600w, /images/55-plus/del-webb-grande-dunes/del-webb-grande-dunes-homes-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Curving streets lined with single-family houses with gray roofs, small yards and driveways in Del Webb at Grande Dunes, seen from above, with the label Houses" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo. License: Public domain" title="License: Public domain">U.S. government aerial photo</a></span></div><figcaption>Houses on curving streets in Del Webb at Grande Dunes, from above.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Del Webb at Grande Dunes, in Myrtle Beach, has both houses and villas. The HOA fee is about $400 a month for a house and about $445 for a villa.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Every lived-in home needs one resident 55 or older, and a visitor under 19 may stay overnight up to 90 days in any 12 months. The builder and the board can make exceptions. Read our <a href="/buyers/55-plus-communities/del-webb-grande-dunes/" style="color:var(--navy);text-decoration:underline">Grande Dunes guide</a>.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Del%20Webb%20at%20Grande%20Dunes">Get the homes for sale in Del Webb at Grande Dunes<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p><h3 id="del-webb-north-myrtle-beach" style="font-family:var(--serif);font-size:1.35rem;color:var(--navy);margin:2.2rem 0 .7rem;line-height:1.3">4. Del Webb North Myrtle Beach</h3><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/55-plus/del-webb-north-myrtle-beach/del-webb-north-myrtle-beach-homes-from-above-2026-1200w.webp" srcset="/images/55-plus/del-webb-north-myrtle-beach/del-webb-north-myrtle-beach-homes-from-above-2026-600w.webp 600w, /images/55-plus/del-webb-north-myrtle-beach/del-webb-north-myrtle-beach-homes-from-above-2026-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Two rows of homes with gray roofs and short driveways along a straight street in Del Webb North Myrtle Beach, with a pond and a paved walking path behind them, seen from above" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.govinfo.gov/content/pkg/USCODE-2023-title17/html/USCODE-2023-title17-chap1-sec105.htm" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo. License: Public domain" title="License: Public domain">U.S. government aerial photo</a></span></div><figcaption>One-story homes on a street in Del Webb North Myrtle Beach, with a pond and a walking path behind them, from above.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Del Webb North Myrtle Beach is the newest of the four. About 400 homes have been built there since 2022, and the builder also sells new homes there. The HOA fee is about $315 a month.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">At least one person in each household must be 55 or older, under the city's agreement with the builder. Its rule for visitors under 18 is not published. Read our <a href="/buyers/55-plus-communities/del-webb-north-myrtle-beach/" style="color:var(--navy);text-decoration:underline">Del Webb North Myrtle Beach guide</a>.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Del%20Webb%20North%20Myrtle%20Beach">Get the homes for sale in Del Webb North Myrtle Beach<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do you need a 55+ community?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. About 2,100 houses on one level are for sale across the area, and fewer than 40 homes are for sale in these four 55+ communities. About two in three of the one-level houses are under $400,000. Conway has the most of those; North Myrtle Beach has the fewest.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}@media (max-width:699px){main#main .c3-gchart.c3-gchart-list [role=row]{grid-template-columns:minmax(0,1fr) auto;column-gap:.8rem;align-items:start}main#main .c3-gchart.c3-gchart-list .b{display:none}main#main .c3-gchart.c3-gchart-list .dot{display:none}main#main .c3-gchart.c3-gchart-list .f{display:block}main#main .c3-gchart.c3-gchart-list [role=cell]{justify-content:flex-end}}</style><figure class="c3-gchart c3-gchart-compact c3-gchart-list"><div role="table" aria-label="One-level houses for sale under $400,000, by mailing town"><span class="cap" aria-hidden="true">One-level houses for sale under $400,000, by mailing town</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Town, one-level houses for sale at any price</span><span role="columnheader">under $400,000</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Conway</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">475 in all</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">386</span></span></div><div role="row"><span role="rowheader"><span class="n">Myrtle Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">472 in all</span></span><span role="cell"><span class="b" style="--f:0.596" aria-hidden="true"></span><span class="v">230</span></span></div><div role="row"><span role="rowheader"><span class="n">Longs</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">240 in all</span></span><span role="cell"><span class="b" style="--f:0.521" aria-hidden="true"></span><span class="v">201</span></span></div><div role="row"><span role="rowheader"><span class="n">Little River</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">117 in all</span></span><span role="cell"><span class="b" style="--f:0.179" aria-hidden="true"></span><span class="v">69</span></span></div><div role="row"><span role="rowheader"><span class="n">North Myrtle Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">76 in all</span></span><span role="cell"><span class="b" style="--f:0.039" aria-hidden="true"></span><span class="v">15</span></span></div><div role="row"><span role="rowheader"><span class="n">Murrells Inlet</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">74 in all</span></span><span role="ce