@@ -0,0 +1,364 @@
+/* /buyers/retirees/ - retiring to Myrtle Beach: whether it is a good place to retire, what a house costs a year
+ * at 65 and what people miss, how South Carolina taxes retirement income under the 2026 law, the four 55+
+ * communities we have guides for, hospitals, hurricane zones, and the weather.
+ *
+ * Batch 2026-11-a, Lane U. Version 1, 2026-11-02. The live page was hand-made old-template HTML; this spec
+ * replaces it. Reader and must-answers: Blog-Brain batches/2026-11-a/buyers-retirees/must-answer.md and PLAN.md.
+ * Facts: batches/2026-11-a/buyers-retirees/facts.md, VERIFIED and CORRECTED rows only, at their corrected values
+ * (VERIFY.md, buyers-retirees-struck.json). Every chart and table is built from data/2026-11-a/buyers-retirees/:
+ * page-data.json (build_page_data.py: the researcher's files with the verifier's corrections applied, and the
+ * one-level listing counts re-pulled on build day), examples.json (build_examples.py) and sctax.js (the same
+ * 2026 income tax rules as build_examples.py, checked against its three examples below).
+ * Kept from the live page: the title and the H1 (data/headlines.json, the owner liked them), the four 55+
+ * communities, the true story of the New York household's tax (stories.json "ny-client-tax-drop", rounded,
+ * one household, not a promise), the insurance and HOA checks as things we do, the links to the relocating
+ * pages for each state's taxes. Cut from the live page (no source, or not in the story bank): the $20,000 a
+ * year and the tuition story, "ranks among the top", Cresswind and Murrells Inlet as 55+ communities, the
+ * veterans' tuition section (no verified row in this ledger), the dead search box and the "Find My Community"
+ * band, the 2025 income tax rules.
+ * Stories used as recorded: ny-client-tax-drop, blackmoor-to-seasons (the distance phrase left out), off-season-open.
+ * Not printed: CMS star ratings (row 37), owners' mailing states (row 28), any count of hospitals with an ER (row 34).
+ * Built by tools/mkpage.js. */
+const fs = require("fs"), path = require("path");
+const { h } = require("../tools/mkpage.js");
+
+const BB = [path.join(__dirname, "..", "tools", "blog-brain-2026-11-a"), path.join(__dirname, "..", "tools", "blog-brain-2026-10-b"), process.env.BLOG_BRAIN,
+  path.join(__dirname, "..", "..", ".."), "/home/user/Blog-Brain"].filter(Boolean)
+  .find((d) => fs.existsSync(path.join(d, "tools", "page-kit.js")));
+if (!BB) throw new Error("Blog-Brain tools not found (tools/page-kit.js)");
+const PK = require(path.join(BB, "tools", "page-kit.js"));
+const G = require(path.join(BB, "tools", "glass.js"));
+const { compareCards } = require(path.join(BB, "tools", "compare.js"));
+
+const DATA = path.join(__dirname, "..", "data", "2026-11-a", "buyers-retirees");
+const PD = JSON.parse(fs.readFileSync(path.join(DATA, "page-data.json"), "utf8"));
+const EX = PD.examples;
+const SCTAX_SRC = fs.readFileSync(path.join(DATA, "sctax.js"), "utf8").replace(/^if \(typeof module.*$/m, "");
+/* The calculator runs the same function as this check: the three ledger examples (rows 11 to 13). */
+const c3ScTax = new Function(SCTAX_SRC + "; return c3ScTax;")();
+EX.income_tax_2026.forEach((e) => {
+  const p1 = e.people[0], p2 = e.people[1] || {};
+  const r = c3ScTax({ joint: e.joint, age1: p1.age, age2: p2.age, ss: e.social_security, ret1: p1.retirement || 0, ret2: p2.retirement || 0, mil: p1.military || 0 });
+  if (Math.abs(r.tax - e.sc_income_tax_2026) > 0.005) throw new Error(`sctax.js disagrees with examples.json: ${e.name}`);
+});
+
+const IMG_DIR = path.join(__dirname, "..", "chapter3realty", "images", "2026-11-a", "buyers-retirees");
+fs.mkdirSync(IMG_DIR, { recursive: true });
+const kit = PK.create({ h, theme: "glass", photos: JSON.parse(fs.readFileSync(path.join(__dirname, "..", "data", "photos.json"), "utf8")).photos,
+  mapDir: IMG_DIR, mapSrc: "/images/2026-11-a/buyers-retirees" });
+const { placesMap, glance, story } = kit;
+const ph = kit.photoSet({ aerialWidth: "620px" });
+
+const SELF = "/buyers/retirees/";
+const money = (v) => "$" + Math.round(v).toLocaleString("en-US");
+const r10 = (v) => "$" + (Math.round(v / 10) * 10).toLocaleString("en-US");
+const pct = (v) => Math.round(v * 100);
+
+/* Sources a reader can open. */
+const ACT110 = "https://www.scstatehouse.gov/sess126_2025-2026/bills/4216.htm";
+const IL2620 = "https://dor.sc.gov/sites/dor/files/policies/IL26-20.pdf";
+const T12_6 = "https://www.scstatehouse.gov/code/t12c006.php";
+const T12_37 = "https://www.scstatehouse.gov/code/t12c037.php";
+const T12_43 = "https://www.scstatehouse.gov/code/t12c043.php";
+const PROVISO = "https://www.scstatehouse.gov/sess126_2025-2026/appropriations2026/tap1b.htm";
+const LEVY = "https://www.horrycountysc.gov/media/kufln4qp/tax-levy-2026_2.pdf";
+const AUDITOR = "https://www.horrycountysc.gov/departments/auditor/";
+const ASSESSOR = "https://www.horrycountysc.gov/departments/assessor/";
+const ZONES = "https://www.scemd.org/prepare/know-your-zone/";
+const ANNEX_C = "https://www.scemd.org/media/2202/2026-annex-c-evacuation-zones-and-clearance-times.pdf";
+const CARE = "https://www.medicare.gov/care-compare/";
+const NOAA = "https://www.ncei.noaa.gov/products/land-based-station/us-climate-normals";
+const ACS = "https://data.census.gov/table/ACSST1Y2025.S0101?g=050XX00US45051";
+const HOPA = "https://www.law.cornell.edu/uscode/text/42/3607";
+
+/* ---------------------------------------------------------------------------- */
+/* Data, from page-data.json                                                       */
+
+const PT = EX.property_tax;                               // row 23
+const T64 = r10(PT.legal_residence_under_65), T65 = r10(PT.legal_residence_65_homestead), T2ND = r10(PT.second_home_or_rental);
+const YEAR65 = r10(PT.legal_residence_65_homestead + PT.stormwater_fee);   // rows 23, 24
+const C = Object.fromEntries(PD.communities.map((c) => [c.name, c]));
+const MT = C["Myrtle Trace"], SPC = C["Seasons at Prince Creek West"], GD = C["Del Webb at Grande Dunes"], NMB = C["Del Webb North Myrtle Beach"];
+const ORDER = [MT, SPC, GD, NMB];
+const shares = ORDER.map((c) => pct(c.full_time_share));
+const OUTSIDE = ORDER.filter((c) => c.evacuation_zone === "none").length;
+if (OUTSIDE !== 3 || SPC.evacuation_zone !== "C") throw new Error("zones changed: rewrite the storm section");
+const mins = ORDER.map((c) => c.hospital.minutes);
+const OL = PD.one_level;                                  // row 45, re-pulled on build day
+const OL_TOTAL = Math.round(OL.total / 100) * 100, OL_SHARE = OL.under_400k / OL.total;
+if (OL_SHARE < 0.6 || OL_SHARE > 0.73) throw new Error("one-level share moved off two in three: rewrite the line");
+const IN55 = PD.communities.reduce((t, c) => t + parseInt(String(c.for_sale).replace(/\D/g, ""), 10), 0);   // row 46
+
+/* Row 11 to 13: the three worked examples. */
+const [EX1, EX2, EX3] = EX.income_tax_2026;
+const taxText = (v) => (v === 0 ? "$0" : `about ${r10(v)}`);
+
+/* ---------------------------------------------------------------------------- */
+/* Visuals                                                                         */
+
+/* V3: the tax on one $400,000 house, three ways (row 23). */
+const TAX_CHART = G.bars([
+  { name: "You live in it, 65 or older", value: PT.legal_residence_65_homestead, valueText: T65, feature: "4 percent rate and the $50,000 exemption" },
+  { name: "You live in it, under 65", value: PT.legal_residence_under_65, valueText: T64, feature: "4 percent rate, no school operating tax" },
+  { name: "A second home or a rental", value: PT.second_home_or_rental, valueText: T2ND, feature: "6 percent rate and the full school tax", reference: true },
+], { caption: "Property tax a year on one $400,000 house outside the cities", nameLabel: "How the house is used", featureLabel: "why", valueLabel: "tax a year",
+  note: "Horry County's 2026 tax rates, in the county outside the city limits, where Myrtle Trace is. Inside a city, the city's tax is added." });
+
+/* V5: the share of homes taxed as a full-time home (rows 25, 27). */
+const SHARE_CHART = G.bars([
+  ...ORDER.slice().sort((a, b) => b.full_time_share - a.full_time_share).map((c) => ({ name: c.name, value: pct(c.full_time_share), valueText: `${pct(c.full_time_share)}%`, feature: c.where, href: `#${c.url.split("/").filter(Boolean).pop()}` })),
+  { name: "All single-family houses in the county", value: pct(PD.county_full_time_share_houses), valueText: `${pct(PD.county_full_time_share_houses)}%`, reference: true },
+], { caption: "Share of homes taxed as someone's full-time home", nameLabel: "Community", featureLabel: "where", valueLabel: "share", max: 100,
+  note: "Our count of every home in the county's tax records. A home counts when the county taxes it at the 4 percent rate for a legal residence. The rest are second homes, rentals, homes owned by a company, and owners who have not applied." });
+
+/* V7: one-level houses for sale by town, under $400,000 (row 45, aggregate counts of active listings). */
+const OL_CHART = G.bars(OL.towns.map((t) => ({ name: t.town, value: t.under_400k, valueText: `${t.under_400k}`, feature: `${t.total} in all` })),
+  { caption: "One-level houses for sale under $400,000, by mailing town", nameLabel: "Town", featureLabel: "one-level houses for sale at any price", valueLabel: "under $400,000",
+    format: (v) => String(v), compact: true, phoneList: true,
+    note: "Houses for sale on the MLS on the day this page was built, counted by the town in their mailing address. The count changes every day." });
+
+/* The decision table (V2): the reader finds their own row. */
+const { icon } = require(path.join(BB, "tools", "icons.js"));
+const decide = (rows) => "<style>main#main .c3-decide{list-style:none;margin:1.2rem 0 1.4rem;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(17rem,1fr));gap:.75rem;max-width:880px}"
+  + "main#main .c3-decide li{margin:0;padding:1rem 1.05rem 1.05rem;border-radius:18px;background:linear-gradient(180deg,rgba(255,255,255,.78),rgba(255,255,255,.55));border:1px solid rgba(255,255,255,.8);box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 10px 28px -16px rgba(28,32,40,.35)}"
+  + "main#main .c3-decide .q{display:flex;align-items:center;gap:.6rem;color:var(--navy);font-weight:600;font-size:var(--read,1.0625rem);line-height:1.4;margin:0 0 .45rem}"
+  + "main#main .c3-decide .q .i{flex:none;display:flex;width:2.3rem;height:2.3rem;border-radius:50%;align-items:center;justify-content:center;color:var(--brass-ink);background:rgba(196,120,58,.12)}"
+  + "main#main .c3-decide .a{color:var(--muted);line-height:1.6;margin:0}"
+  + "@media (prefers-reduced-transparency:reduce){main#main .c3-decide li{background:#fbf8f3}}</style>"
+  + `<ul class="c3-decide" role="list">` + rows.map((r) => `<li><p class="q"><span class="i" aria-hidden="true">${icon(r.icon, { size: 22 })}</span><span>If ${r.ifText}</span></p><p class="a">${r.then}</p></li>`).join("") + "</ul>";
+const DECIDE = decide([
+  { icon: "home", ifText: "you will live here most of the year", then: `Apply for the 4 percent rate. At 65, the $50,000 exemption brings the tax on a $400,000 house down to about ${T65} a year.` },
+  { icon: "calendar", ifText: "it will be a second home for a few years first", then: `The same house is taxed about ${T2ND} a year until it becomes your legal home.` },
+  { icon: "dollar", ifText: "your income is Social Security and a modest pension", then: "Many households like this owe no South Carolina income tax at all. The examples below show three." },
+  { icon: "tax", ifText: "your pension is from another state's government", then: `South Carolina taxes it past its deductions. In our example below, a single person with a New York public pension owes ${taxText(EX2.sc_income_tax_2026)}.` },
+  { icon: "hospital", ifText: "you want a hospital close by", then: `Each of the four 55+ communities below is ${Math.min(...mins)} to ${Math.max(...mins)} minutes by car from a hospital.` },
+  { icon: "storm", ifText: "you would rather not plan a hurricane evacuation", then: "Three of the four 55+ communities are outside every evacuation zone." },
+]);
+
+/* V4: the three 2026 income tax examples (rows 11 to 13). */
+const INCOME_TABLE = compareCards([
+  { name: "Married, both 66", cells: { ss: money(EX1.social_security), other: `${money(EX1.people[0].retirement)} private pension`, tax: taxText(EX1.sc_income_tax_2026) } },
+  { name: "Single, 67", cells: { ss: money(EX2.social_security), other: `${money(EX2.people[0].retirement)} New York public pension`, tax: taxText(EX2.sc_income_tax_2026) } },
+  { name: "Married, 60 and 58", cells: { ss: "None", other: `${money(EX3.people[0].military)} military retirement pay`, tax: taxText(EX3.sc_income_tax_2026) } },
+], [{ key: "ss", label: "Social Security a year", num: true }, { key: "other", label: "Other income a year" }, { key: "tax", label: "State income tax", num: true }],
+{ caption: "Three example households under the 2026 rules", nameLabel: "Example" });
+
