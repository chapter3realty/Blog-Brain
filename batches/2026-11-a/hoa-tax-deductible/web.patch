+#!/bin/sh
+# Google search suggestions for /hoa/tax-deductible/. Run: sh pull-suggestions.sh > raw/google-suggestions-<date>.txt
+for q in "are hoa fees tax deductible" "are hoa fees tax deductible on rental property" "are hoa fees tax deductible on primary residence" "are hoa fees tax deductible for second home" "are hoa fees tax deductible in south carolina" "are hoa fees tax deductible if you work from home" "are condo fees tax deductible" "are condo fees tax deductible on rental property" "are condo hoa fees tax deductible" "hoa fees tax deduction" "hoa fees deductible" "hoa fees deductible rental" "hoa fees schedule e" "hoa fees airbnb deduction" "hoa fees vacation home tax" "hoa fees vacation rental deduction" "hoa special assessment tax deductible" "special assessment tax deductible rental property" "hoa special assessment depreciation" "is hoa special assessment capital improvement" "can you deduct hoa fees" "can i deduct hoa fees on my taxes" "can you write off hoa fees" "can you write off hoa fees on a rental" "do hoa fees count as property tax" "are hoa fees part of property tax" "are hoa fees deductible on schedule a" "hoa fees cost basis" "hoa fees home office deduction" "hoa fees deductible llc" "myrtle beach condo tax deduction" "myrtle beach condo rental tax" "myrtle beach condo hoa fees" "south carolina hoa fees" "condo rental tax deductions" "vacation rental tax deductions" "rental property tax deductions list" "14 day rule vacation home" "personal use days rental property" "hoa fees a" "hoa fees t" "hoa fees d" "are hoa fees a" "are hoa fees d" "are hoa fees i" "are hoa fees t"; do
+  printf '== %s\n' "$q"
+  curl -sS -A "Mozilla/5.0" "https://suggestqueries.google.com/complete/search?client=firefox&hl=en&gl=us&q=$(python3 -c "import urllib.parse,sys;print(urllib.parse.quote(sys.argv[1]))" "$q")"; echo
