+# data/2026-11-a/invest-property-management
+
+Research data for /invest/property-management/ (batch 2026-11-a, Lane U). Ledger: Blog-Brain `batches/2026-11-a/invest-property-management/facts.md`. Pulled 2026-11-04. Charts and tables read `findings.json`; no number is typed into the spec.
+
+| File | What | Made by |
+|---|---|---|
+| `raw/owner-distance.json` | Horry County GIS parcel layer 24, homes with a building (LandUseCode LIKE '1%', MarketImprv > 0), split by the 4 percent legal-residence ratio (AssessedProp < TaxableProp*0.05) and the 6 percent ratio, and by condo (LegalDescr has HPR) or not. Counts by owner tax-bill state, and for SC by ZIP. Every query URL. No owner names read. | `python3 -I fetch_owner_distance.py .` |
+| `raw/bulk-addresses.json` | Mailing addresses (street + ZIP + state) that receive 10 or more 6 percent tax bills: timeshare and resort companies, builders, large landlords, managers. Used to show the share for individual owners. | `python3 -I fetch_bulk_addresses.py .` |
+| `owner-distance.json` | Shares by where the tax bill goes: Grand Strand ZIPs (the 21 Horry County post-office ZIPs plus 29585 Pawleys Island), elsewhere in SC, NC, other states, abroad. All owners, and without the bulk addresses. | `python3 -I analyze_owner_distance.py .` |
+| `fee-pages.json`, `raw/fees/` | The owner-fee pages of managers that serve Horry County, saved as HTML and text with the date read (`raw/fees/index.json`). | `python3 -I fetch_fee_pages.py .` |
+| `fees.json` | The published fee terms copied from `raw/fees/*.txt`, with line numbers; firms kept and firms left out, with the reason. Typed from the saved pages; the verifier re-reads each line. | by hand from `raw/fees/` |
+| `raw/law/` | SC Code Title 40 Ch. 57 and Title 27 Ch. 40 and Title 12 Ch. 36, SCDOR accommodations tax page, Horry County hospitality fee page, City of Myrtle Beach business FAQ, IRS Publication 527, as HTML and text. | curl, 2026-11-04 |
+| `raw/google-suggestions.txt` | Google search suggestions, 45 queries. | `sh pull-suggestions.sh > raw/google-suggestions.txt` |
+| `findings.json` | Every derived number: owner distance, the published fee summary, the worked year for a 3-bedroom house, the short-term year. | `python3 -I build_findings.py .` |
+
+Reused, not pulled again (lead, 2026-11-03):
+- `../invest-rent-prices/findings.json`: `new_vs_long_lease_3br.moved_in_last_2y` (about $1,600 lease rent for a 3-bedroom house with a tenant who moved in within two years; rent-prices ledger row 7) and `pums_detached_moved_in` (share of rented houses whose tenant moved in within 12 months, from `../invest-rent-prices/pums-2024-5yr.json`, made by `analyze_pums.py` there).
+- `../invest-condos/listings.json`: vacation rental program flags on condos for sale (invest-condos ledger row 17).
+- `../2026-10-d/sell-out-of-state-buyers/raw/stock-by-state*.json`: the same parcel layer counted by mailing state for all homes (2026-10-d ledger row 6). Our counts split it by tax ratio.
+- `../../str-market.json`: Myrtle Beach market revenue and the owner-observed management ranges ("management").
+
+Rerun order: fetch_owner_distance.py, fetch_bulk_addresses.py, analyze_owner_distance.py, fetch_fee_pages.py, build_findings.py.
+
+Blocked: the SC LLR licence lookup (verify.llronline.com) requires a reCAPTCHA, so licence counts by county were not pulled. LLR sells licensee lists through a request form (llr.sc.gov/re/resources.aspx, "Sample Licensee List Request Form"). Wikimedia Commons answered 429 (rate limit) on 2026-11-04.
diff --git a/data/2026-11-a/invest-property-management/analyze_owner_distance.py b/data/2026-11-a/invest-property-management/analyze_owner_distance.py
new file mode 100644
index 00000000..82c3f01b
--- /dev/null
+++ b/data/2026-11-a/invest-property-management/analyze_owner_distance.py
@@ -0,0 +1,56 @@
+"""Summarise raw/owner-distance.json: for homes taxed at the 4 and 6 percent ratios, condo and other,
+the share whose tax bill goes to a local address, elsewhere in SC, NC, another state, or abroad.
+Local = the 21 ZIP codes of Horry County post offices plus 29585 (Pawleys Island, the south end of the Grand Strand).
+Run: python3 -I analyze_owner_distance.py <datadir>. Writes owner-distance.json."""
+import json, sys
+D = sys.argv[1]; raw = json.load(open(D + "/raw/owner-distance.json"))
+LOCAL = {"29511","29526","29527","29528","29544","29545","29566","29568","29569","29572","29575","29576","29577","29578","29579","29581","29582","29587","29588","29597","29598","29585"}
+US = set("AL AK AZ AR CA CO CT DE DC FL GA HI ID IL IN IA KS KY LA ME MD MA MI MN MS MO MT NE NV NH NJ NM NY NC ND OH OK OR PA RI SC SD TN TX UT VT VA WA WV WI WY PR VI GU AE AP AA".split())
+out = {"read": raw["read"], "local_zips": sorted(LOCAL), "groups": {}}
+for k, v in raw["q"].items():
+    st = v["by_state"]; z = v["sc_by_zip"]; n = v["count"]
+    local = sum(c for zz, c in z.items() if zz in LOCAL)
+    sc = st.get("SC", 0); nc = st.get("NC", 0)
+    other_us = sum(c for s, c in st.items() if s in US and s not in ("SC", "NC"))
+    blank = sum(c for s, c in st.items() if s in ("",))
+    abroad = n - sc - nc - other_us - blank
+    g = {"count": n, "local": local, "sc_elsewhere": sc - local, "nc": nc, "other_states": other_us, "abroad": abroad, "blank": blank}
+    g["pct"] = {x: round(100 * g[x] / n, 1) for x in ("local", "sc_elsewhere", "nc", "other_states", "abroad", "blank")}
+    g["not_local"] = n - local; g["pct_not_local"] = round(100 * (n - local) / n, 1)
+    g["top_states_outside_sc"] = sorted(((s, c) for s, c in st.items() if s != "SC" and s), key=lambda x: -x[1])[:8]
+    out["groups"][k] = g
+a = out["groups"]
+t6 = {x: a["other6_condo"][x] + a["other6_house_other"][x] for x in ("count", "local", "sc_elsewhere", "nc", "other_states", "abroad", "blank", "not_local")}
+t6["pct_not_local"] = round(100 * t6["not_local"] / t6["count"], 1); t6["pct_local"] = round(100 * t6["local"] / t6["count"], 1)
+out["all_6pct"] = t6
+t4 = {x: a["res4_condo"][x] + a["res4_house_other"][x] for x in ("count", "local")}
+out["all_4pct"] = t4
+json.dump(out, open(D + "/owner-distance.json", "w"), indent=1)
+print(json.dumps(out, indent=1))
+
+# Second pass: leave out mailing addresses that receive 10 or more 6 percent tax bills (raw/bulk-addresses.json):
+# timeshare and resort companies, builders, large landlords and managers. What remains is closer to individual owners.
+bulk = json.load(open(D + "/raw/bulk-addresses.json"))
+ind = {}
+for k in ("condo", "house_other"):
+    g = dict(a["other6_" + k]); rows = bulk["q"][k]["groups"]
+    b = {"count": 0, "local": 0, "sc_elsewhere": 0, "nc": 0, "other_states": 0, "abroad": 0}
+    for street, z, s, n in rows:
+        b["count"] += n
+        if s == "SC" and z in LOCAL: b["local"] += n
+        elif s == "SC": b["sc_elsewhere"] += n
+        elif s == "NC": b["nc"] += n
+        elif s in US: b["other_states"] += n
+        else: b["abroad"] += n
+    r = {x: g[x] - b[x] for x in b}
+    r["not_local"] = r["count"] - r["local"]; r["pct_not_local"] = round(100 * r["not_local"] / r["count"], 1)
+    r["pct"] = {x: round(100 * r[x] / r["count"], 1) for x in ("local", "sc_elsewhere", "nc", "other_states", "abroad")}
+    r["bulk_addresses"] = len(rows); r["bulk_homes"] = b["count"]; r["bulk_local"] = b["local"]
+    ind[k] = r
+t = {x: ind["condo"][x] + ind["house_other"][x] for x in ("count", "local", "sc_elsewhere", "nc", "other_states", "abroad", "not_local", "bulk_homes", "bulk_addresses")}
+t["pct_not_local"] = round(100 * t["not_local"] / t["count"], 1)
+t["pct_out_of_state"] = round(100 * (t["nc"] + t["other_states"] + t["abroad"]) / t["count"], 1)
+ind["all"] = t
+out["individual_6pct"] = ind
+json.dump(out, open(D + "/owner-distance.json", "w"), indent=1)
+print(json.dumps(ind, indent=1))
diff --git a/data/2026-11-a/invest-property-management/build_findings.py b/data/2026-11-a/invest-property-management/build_findings.py
new file mode 100644
index 00000000..a117c95d
--- /dev/null
+++ b/data/2026-11-a/invest-property-management/build_findings.py
@@ -0,0 +1,56 @@
+"""Every derived number for /invest/property-management/. Run: python3 -I build_findings.py <datadir>. Writes findings.json.
+Inputs: owner-distance.json (this folder), fees.json (this folder),
+../invest-rent-prices/findings.json (rent for a 3-bedroom house, share of rented houses with a new tenant in 12 months),
+../../str-market.json (short-term rental revenue and the owner-observed management ranges)."""
+import json, sys, statistics as st
+D = sys.argv[1]
+od = json.load(open(D + "/owner-distance.json")); fees = json.load(open(D + "/fees.json"))
+rp = json.load(open(D + "/../invest-rent-prices/findings.json")); strm = json.load(open(D + "/../../str-market.json"))
+F = {"note": "Built by build_findings.py. Do not edit by hand."}
+# 1. Who owns the homes that are not anyone's legal residence
+a6 = od["all_6pct"]; i6 = od["individual_6pct"]; g = od["groups"]
+F["owners"] = {
+  "homes_6pct": a6["count"], "homes_4pct": od["all_4pct"]["count"],
+  "pct_6pct_not_local": a6["pct_not_local"], "pct_6pct_local": a6["pct_local"],
+  "condo_6pct": g["other6_condo"]["count"], "condo_6pct_not_local_pct": g["other6_condo"]["pct_not_local"],
+  "house_6pct": g["other6_house_other"]["count"], "house_6pct_not_local_pct": g["other6_house_other"]["pct_not_local"],
+  "res4_local_pct": round(100 * od["all_4pct"]["local"] / od["all_4pct"]["count"], 1),
+  "individual_all_pct_not_local": i6["all"]["pct_not_local"], "individual_condo_pct_not_local": i6["condo"]["pct_not_local"],
+  "individual_house_pct_not_local": i6["house_other"]["pct_not_local"], "bulk_homes": i6["all"]["bulk_homes"], "bulk_addresses": i6["all"]["bulk_addresses"],
+  "chart_6pct": [  # where the tax bill goes, homes taxed at 6 percent, all owners
+    {"label": "Grand Strand", "n": a6["local"]}, {"label": "Elsewhere in South Carolina", "n": a6["sc_elsewhere"]},
+    {"label": "North Carolina", "n": a6["nc"]}, {"label": "Other states", "n": a6["other_states"]}, {"label": "Outside the U.S.", "n": a6["abroad"]}],
+  "top_states_condo_6pct": g["other6_condo"]["top_states_outside_sc"][:5], "top_states_house_6pct": g["other6_house_other"]["top_states_outside_sc"][:5],
+}
+for r in F["owners"]["chart_6pct"]: r["pct"] = round(100 * r["n"] / a6["count"], 1)
+# 2. Published long-term fees
+lt = fees["long_term"]
+pcts = [f["monthly_pct"] for f in lt]; lease = [f["leasing_share_of_month"] for f in lt]
+F["lt_fees"] = {"firms": len(lt), "at_10pct": sum(1 for p in pcts if p == 10), "monthly_min_pct": min(pcts), "monthly_max_pct": max(pcts),
+  "monthly_median_pct": st.median(pcts), "leasing_median_share": st.median(lease), "leasing_min_share": min(lease), "leasing_max_share": max(lease),
+  "renewals_published_usd": sorted(f["renewal_usd"] for f in lt if f.get("renewal_usd")), "excluded": len(fees["long_term_excluded"])}
+# 3. Worked year, 3-bedroom house, new lease rent from the rent-prices page (Census PUMS, moved in within 2 years)
+rent = round(rp["new_vs_long_lease_3br"]["moved_in_last_2y"] / 100) * 100   # about $1,600
+turn = rp["pums_detached_moved_in"]["1"] / 100                             # share of rented houses with a tenant who moved in within 12 months
+mgmt = round(rent * 0.10 * 12)
+lease_lo, lease_hi = round(rent * 0.5), rent
+renew = 125   # midpoint of the two published renewal fees, $100 and $150
+# low: half a month's rent to lease, 10 percent every month (J and P Unlimited, PURE HomeRiver terms);
+# high: one full month's rent to lease, then 10 percent from the 2nd month (Beach Rental Group's stated terms)
+yr_new_lo, yr_new_hi = mgmt + lease_lo, lease_hi + round(rent * 0.10 * 11)
+yr_renew = mgmt + renew
+avg_lo = round(turn * yr_new_lo + (1 - turn) * yr_renew); avg_hi = round(turn * yr_new_hi + (1 - turn) * yr_renew)
+childs_eff = round(100 * max(150, 0.07 * rent) / rent, 1)
+F["worked_year"] = {"rent": rent, "annual_rent": rent * 12, "monthly_fee": round(rent * 0.10), "mgmt_year": mgmt, "leasing_half": lease_lo, "leasing_full": lease_hi,
+  "renewal_mid": renew, "year_new_tenant_low": yr_new_lo, "year_new_tenant_high": yr_new_hi, "year_renewal": yr_renew,
+  "turnover_share_12m": round(turn * 100, 1), "avg_year_low": avg_lo, "avg_year_high": avg_hi,
+  "avg_pct_of_rent_low": round(100 * avg_lo / (rent * 12), 1), "avg_pct_of_rent_high": round(100 * avg_hi / (rent * 12), 1),
+  "new_year_pct_low": round(100 * yr_new_lo / (rent * 12), 1), "new_year_pct_high": round(100 * yr_new_hi / (rent * 12), 1),
+  "seven_pct_with_150_min_effective_pct": childs_eff, "seven_pct_breakeven_rent": round(150 / 0.07)}
+# 4. Short-term: the Myrtle Beach market's average revenue and the owner-observed basic plan range
+mb = next(m for m in strm["markets"] if m["slug"] == "myrtle-beach"); M = strm["management"]
+F["str_year"] = {"market": "myrtle-beach", "revenue": mb["revenue"], "dataAsOf": strm["dataAsOf"], "basic_low_pct": M["basicLow"], "basic_high_pct": M["basicHigh"],
+  "basic_low_usd": round(mb["revenue"] * M["basicLow"] / 100, -1), "basic_high_usd": round(mb["revenue"] * M["basicHigh"] / 100, -1),
+  "full_low_pct": M["fullServiceLow"], "full_high_pct": M["fullServiceHigh"], "full_base": M["fullServiceBase"]}
+json.dump(F, open(D + "/findings.json", "w"), indent=1)
+print(json.dumps(F, indent=1))
