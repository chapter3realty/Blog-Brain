+{
+ "note": "Built by build_findings.py. Do not edit by hand.",
+ "acs_period": "2020-2024 American Community Survey 5-year estimates",
+ "zillow_latest_month": "2026-09-30",
+ "headline": {
+  "zillow_house_asking": 2074,
+  "zillow_apartment_asking": 1583,
+  "zillow_all_asking": 1722,
+  "zillow_house_12m_pct": 2.7,
+  "zillow_all_12m_pct": 2.3,
+  "zillow_house_peak": {
+   "month": "2026-09-30",
+   "value": 2074.1,
+   "change_since_pct": 0.0
+  }
+ },
+ "fmr_fy2027": {
+  "0": 1155,
+  "1": 1258,
