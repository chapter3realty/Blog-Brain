--- /dev/null
+++ b/data/2026-11-a/submarkets-garden-city/analyze_fema.py
@@ -0,0 +1,26 @@
+#!/usr/bin/env python3
+"""NFIP policy cost (what the policyholder pays a year, fees included) for ZIP 29576 policies that began June 2025 to May 2026,
+by area and rated zone. Strip = the three Census block groups the Waccamaw Drive strip falls in (450510513011, 450510513012
+in Horry; 450439205101 in Georgetown). Run: python3 -I analyze_fema.py <datadir>. Writes nfip-findings.json."""
+import json, sys, os, statistics, collections
+D = sys.argv[1]
+r = json.load(open(os.path.join(D, "raw/nfip-policies-29576.json")))["NfipPolicies"]
+STRIP = {"450510513011", "450510513012", "450439205101"}
+OCC = {11: "single-family home", 16: "unit in a multi-unit building (condo unit policy)", 15: "condo association building policy (RCBAP)", 14: "manufactured home"}
+def zg(z):
+    z = (z or "").upper()
+    return "V" if z.startswith("V") else ("A" if z.startswith("A") else ("X" if z in ("X", "B", "C", "AR") or z.startswith("X") else "other"))
+G = collections.defaultdict(list)
+for x in r:
+    area = "strip" if (x.get("censusGeoid") or "") in STRIP else "rest_29576"
+    for a in (area, "all_29576"):
+        G[(a, x["occupancyType"], zg(x["ratedFloodZone"]))].append(x)
+        G[(a, x["occupancyType"], "any")].append(x)
+out = {}
+for (a, o, z), xs in sorted(G.items()):
+    if o not in OCC or len(xs) < 5: continue
+    pc = [x["policyCost"] for x in xs if x.get("policyCost") is not None]
+    out["%s/%s/%s" % (a, o, z)] = {"what": OCC[o], "policies": len(xs), "median_cost": statistics.median(pc), "p25": statistics.quantiles(pc, n=4)[0], "p75": statistics.quantiles(pc, n=4)[2],
+        "primary_residence": sum(bool(x.get("primaryResidenceIndicator")) for x in xs), "median_building_coverage": statistics.median([x["totalBuildingInsuranceCoverage"] or 0 for x in xs])}
+json.dump({"source": "OpenFEMA NfipPolicies v3", "filter": "reportedZipCode 29576, policyEffectiveDate 2025-06-01 to 2026-05-31", "groups": out}, open(os.path.join(D, "nfip-findings.json"), "w"), indent=1)
+for k, v in out.items(): print(k, v)
diff --git a/data/2026-11-a/submarkets-garden-city/analyze_listings.py b/data/2026-11-a/submarkets-garden-city/analyze_listings.py
new file mode 100644
index 00000000..6684ad8f
--- /dev/null
+++ b/data/2026-11-a/submarkets-garden-city/analyze_listings.py
@@ -0,0 +1,33 @@
+#!/usr/bin/env python3
+"""Active listings in the CRM's Garden City area, in aggregate: count, median list price and median price per square foot by type,
+by side of Waccamaw Drive and by county. Run: RAW=<scratch> python3 -I analyze_listings.py <datadir>. Writes <datadir>/listings-findings.json."""
+import sys, os, json, statistics, collections
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from zones import *
+from shapely.geometry import Point, LineString
+from shapely.ops import unary_union
+D = sys.argv[1]
+L = J("listings-gc.json")
+osm = J("osm.json")
+WALL = unary_union([LineString([(p["lon"], p["lat"]) for p in e["geometry"]]) for e in osm["elements"] if "Waccamaw Drive" in e.get("tags", {}).get("name", "")])
+GT = CTY["Georgetown County"]
+out = collections.defaultdict(list)
+for mls, h in L["homes"].items():
+    if h["lat"] is None: continue
+    pt = Point(h["lng"], h["lat"])
+    county = "georgetown" if GT.contains(pt) else "horry"
+    if county == "horry": z = zone(pt)
+    else:
+        s, d = side(pt, WALL); z = "beach" if s > 0 else ("middle" if d < 400 else "inland")
+    h = dict(h, county=county, zone=z, dock=mls in L["features"]["private_dock"], str_ok=mls in L["features"]["str_allowed"])
+    for key in ("all", h["type"], "%s/%s" % (z, h["type"]), "%s/%s/%s" % (county, z, h["type"]), county + "/all"):
+        out[key].append(h)
+def s(xs):
+    pr = [x["price"] for x in xs if x["price"]]; pp = [x["price"] / x["sqft"] for x in xs if x["price"] and x["sqft"]]
+    return {"n": len(xs), "median_price": statistics.median(pr) if pr else None, "min": min(pr) if pr else None, "max": max(pr) if pr else None,
+            "median_ppsf": round(statistics.median(pp)) if pp else None, "with_sqft": len(pp), "docks": sum(x["dock"] for x in xs), "str_allowed": sum(x["str_ok"] for x in xs)}
+F = {"pulled": L["pulled"], "api_totals": L["api_totals"], "feature_counts": {k: len(v) for k, v in L["features"].items()},
+     "note": "CRM public map API, has=area_garden_city; MLS listings counted in aggregate only. The oceanfront and no_hoa flags came back on every home in this area and are not used.",
+     "groups": {k: s(v) for k, v in sorted(out.items())}}
+json.dump(F, open(os.path.join(D, "listings-findings.json"), "w"), indent=1)
+for k, v in F["groups"].items(): print(k, v)
