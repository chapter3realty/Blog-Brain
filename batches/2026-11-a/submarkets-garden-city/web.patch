+  im.save(k+'-labelled.png'); out[k]={'labels':rec,'bbox_wgs84':[round(ilo(bb[0]),6),round(ila(bb[1]),6),round(ilo(bb[2]),6),round(ila(bb[3]),6)],'size':[Wd,Hd]}
+  print(k, json.dumps(out[k]))
