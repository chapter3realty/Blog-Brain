+/* Row 28: FEMA high-risk zone by part. */
+must(ST["beach/all"].pct_high_risk === 96.4 && ST["middle/all"].pct_high_risk === 54.3 && ST["inland/all"].fema.none === 3142, "row 28 changed");
+/* Row 29: NFIP policy cost, ZIP 29576. */
