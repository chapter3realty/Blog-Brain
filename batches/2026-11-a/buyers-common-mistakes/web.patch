n-items:center;gap:.75rem;margin:.5rem 0 1.6rem;color:var(--navy);font:500 .95rem/1.3 var(--sans)}.c3ph-dots{display:inline-flex;gap:.45rem}.c3ph-dots i{display:block;width:10px;height:10px;border-radius:50%;border:1.5px solid var(--navy);box-sizing:border-box}.c3ph-dots i:first-child{background:var(--navy)}@supports (animation-timeline:view()){.c3ph-rowbox{timeline-scope:--c3ph-p1,--c3ph-p2,--c3ph-p3}.c3ph-row>figure:nth-child(1){view-timeline:--c3ph-p1 inline}.c3ph-row>figure:nth-child(2){view-timeline:--c3ph-p2 inline}.c3ph-row>figure:nth-child(3){view-timeline:--c3ph-p3 inline}.c3ph-dots i{animation:c3ph-dot linear both;animation-range:cover}.c3ph-dots i:nth-child(1){animation-timeline:--c3ph-p1}.c3ph-dots i:nth-child(2){animation-timeline:--c3ph-p2}.c3ph-dots i:nth-child(3){animation-timeline:--c3ph-p3}@keyframes c3ph-dot{0%,36%{background:transparent}42%,60%{background:var(--navy)}66%,100%{background:transparent}}}@media (min-width:700px){.c3ph-swipe{display:none}}.c3ph-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:1.4rem 0 1.8rem;padding:0;list-style:none}@media (min-width:700px){.c3ph-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}}@media (min-width:1000px){.c3ph-cards.c3ph-4{grid-template-columns:repeat(4,minmax(0,1fr))}}.c3ph-card{margin:0;background:var(--ivory);border:1px solid var(--rule);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}.c3ph-card .c3ph-f{border-radius:0}.c3ph-card img,.c3ph-card svg{display:block;width:100%;height:auto;aspect-ratio:var(--c3ph-r,4/3);object-fit:cover}.c3ph-card .c3ph-cr{font-size:.56rem;padding:1.2rem .45rem .25rem 1.6rem}.c3ph-card strong{display:block;color:var(--navy);font-size:.98rem;font-weight:500;line-height:1.3;padding:.7rem .8rem 0}.c3ph-card span.c3ph-t{display:block;color:var(--muted);font-size:.86rem;line-height:1.45;padding:.2rem .8rem .85rem}.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:760px}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The biggest are the tax rate on a home you live in, the seller's tax bill, and flood insurance in and out of the high-risk zone. Each one below says what it costs and when we catch it. If this is your first home, read our <a href="/buyers/first-time-home-buyer-myrtle-beach/" style="color:var(--navy);text-decoration:underline">first-time buyer guide</a> too.</p><ol class="c3m-rank" role="list"><li><span class="n" aria-hidden="true">1</span><a href="#six-percent-tax">Paying the 6 percent tax on a home you live in</a><span class="c"><strong>About $2,930 a year</strong> more than the 4 percent rate</span></li><li><span class="n" aria-hidden="true">2</span><a href="#seller-tax-bill">Budgeting from the seller's tax bill</a><span class="c"><strong>About $3,400 a year</strong> over the seller's bill, for a second home</span></li><li><span class="n" aria-hidden="true">3</span><a href="#flood-outside-the-zone">No flood insurance outside the high-risk zone</a><span class="c"><strong>About $26,400</strong>, FEMA's middle payment after one flood</span></li><li><span class="n" aria-hidden="true">4</span><a href="#flood-zone-listing">A flood zone the listing does not mention</a><span class="c"><strong>About $1,070 a year</strong> of flood insurance the loan requires</span></li><li><span class="n" aria-hidden="true">5</span><a href="#condo-repair-savings">A condo building short on repair savings</a><span class="c"><strong>About $4,750 a unit</strong> in one bill, in our example</span></li><li><span class="n" aria-hidden="true">6</span><a href="#weekly-rentals">Planning weekly rentals in a Myrtle Beach residential zone</a><span class="c"><strong>The rental income</strong>, and fines of up to $500 each time</span></li><li><span class="n" aria-hidden="true">7</span><a href="#inspection">Skipping the inspection to win the house</a><span class="c"><strong>Any repair</strong> the inspection would have found</span></li><li><span class="n" aria-hidden="true">8</span><a href="#your-agent">Thinking the agent you called works for you</a><span class="c"><strong>Advice</strong> on your side of the deal</span></li><li><span class="n" aria-hidden="true">9</span><a href="#hoa-rules">HOA rules that do not fit how you live</a><span class="c"><strong>The boat, the golf cart or the rental</strong> you bought for</span></li><li><span class="n" aria-hidden="true">10</span><a href="#job-before-closing">Changing jobs before closing</a><span class="c"><strong>The loan</strong>, in the last days before closing</span></li></ol></div></section><section style="background:var(--ivory)" id="six-percent-tax"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The 6 percent tax">Are you paying the 6 percent tax on a home you live in?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, until you apply. A home you live in is taxed on 4 percent of its value once you apply and qualify, and it pays no school operating tax. Until then, the county bills it at 6 percent, the rate for second homes and rentals.</p><figure class="c3-gchart"><div role="table" aria-label="Property tax a year on a house the county values at $350,000"><span class="cap" aria-hidden="true">Property tax a year on a house the county values at $350,000</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">How the house is taxed, rate</span><span role="columnheader">tax a year</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Your home, outside the city limits</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">4 percent rate</span></span><span role="cell"><span class="b" style="--f:0.241" aria-hidden="true"></span><span class="v">about $1,290</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Same house at 6 percent, outside the city</span></span><span role="cell"><span class="b" style="--f:0.789" aria-hidden="true"></span><span class="v">about $4,220</span></span></div><div role="row"><span role="rowheader"><span class="n">Your home, in the City of Myrtle Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">4 percent rate</span></span><span role="cell"><span class="b" style="--f:0.264" aria-hidden="true"></span><span class="v">about $1,410</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Same house at 6 percent, in the city</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">about $5,350</span></span></div></div></div><figcaption>Horry County's 2026 tax rates. Outside the city limits is the county's tax district 100. The county's stormwater fee and small special districts are left out.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">That is about $2,930 more a year outside the city limits, and about $3,930 more in the City of Myrtle Beach. Over five years, it comes to about $14,700 and $19,700.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Newer owners are the most likely to still pay it.</p><div class="c3m-tiles"><div><span class="big">About 1 in 5</span><span class="t">bought in 2025</span></div><div><span class="big">About 1 in 7</span><span class="t">bought in 2024</span></div><div><span class="big">About 1 in 17</span><span class="t">bought in 2018 or 2019, not sold since</span></div></div><p class="c3m-tnote">Houses owned by a person in Horry County, with the tax bill mailed to the house itself, that are still taxed at 6 percent. Buyers from 2025 can still apply for 2026.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In one county tax district outside the cities, 613 of these houses bought in 2024 or 2025 are billed about $2,750 a year more than at 4 percent. Together, that is about $1.8 million a year.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Why do people moving here miss it?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The county asks for South Carolina papers with the application:</p><ul style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem">a South Carolina driver's license or ID at the home's address, for each owner who lives there and a spouse;</li><li style="margin-bottom:.5rem">South Carolina registration for every vehicle you own, at that address;</li><li style="margin-bottom:.5rem">your state and federal tax returns, or the Social Security 1099;</li><li style="margin-bottom:.5rem">if you own another home, its tax bill showing no exemption, or a letter that the exemption was removed.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You also certify that neither you, nor a spouse or a dependent child under 18, claims to be a legal resident of another state, or claims the 4 percent rate on another home.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You apply once, unless the ownership or who lives there changes. A home that becomes your legal residence for any part of the year gets the 4 percent rate for the whole year.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The county asks for the application by the end of May, so the bill mailed later that year is at 4 percent. You can still apply for a tax year until its bill is due, usually January 15 of the next year.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If you qualified and paid at 6 percent, you can claim a refund of the extra tax from the county assessor. State law allows the claim only for recent bills.</p><div class="c3m-we"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.2 4.2L19 7"/></svg></span><p>We price the tax at both rates before you offer. At closing, we give you the county's checklist in the order to do it: the license, the car registration, then the online application. Our <a href="/buyers/property-taxes/" style="color:var(--navy);text-decoration:underline">property tax calculator</a> works out the bill in any town.</p></div></div></section><section style="background:var(--ivory-2)" id="seller-tax-bill"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The seller's tax bill">Why is my tax bill so much higher than the seller's?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The seller's bill shows what the seller pays, not what you will pay. A home owned for many years is often taxed on a value far below what the county says it is worth. A sale resets that value, and the new value is first taxed the year after the sale.</p><div class="c3m-ex"><span class="k">Example</span><p>One owner has lived in a house since about 2010. The county values it at $350,000, but taxes it on about 63 percent of that.</p><p>Buy it as a second home, and you pay about 5 times the seller's bill.</p></div><figure class="c3-gchart"><div role="table" aria-label="Example: tax a year on one house the county values at $350,000"><span class="cap" aria-hidden="true">Example: tax a year on one house the county values at $350,000</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Whose bill, why</span><span role="columnheader">tax a year</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">The seller's bill</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">their home since about 2010</span></span><span role="cell"><span class="b" style="--f:0.191" aria-hidden="true"></span><span class="v">about $800</span></span></div><div role="row"><span role="rowheader"><span class="n">Your bill, as your home</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">after you apply</span></span><span role="cell"><span class="b" style="--f:0.305" aria-hidden="true"></span><span class="v">about $1,290</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Your bill, as a second home</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">6 percent rate</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">about $4,220</span></span></div></div></div><figcaption>Outside the city limits, at the county's 2026 rates. The seller's figure uses the average taxed share for homes whose last deed was in 2005 to 2014.</figcaption></figure><div class="c3m-we"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.2 4.2L19 7"/></svg></span><p>We never price a house from the seller's bill. We work out your bill at your price and your tax rate before you offer. Our <a href="/buyers/property-taxes/" style="color:var(--navy);text-decoration:underline">property tax guide</a> explains how a sale resets the value.</p></div></div></section><section style="background:var(--ivory)" id="flood-outside-the-zone"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Flood insurance outside the zone">Do I need flood insurance if the house is not in a flood zone?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Federal law does not require it outside FEMA's high-risk zone, so the choice is yours. Since 2015, 3 in 10 paid flood claims in Horry County were on buildings outside that zone.</p><div class="c3m-tiles"><div><span class="big">$26,400</span><span class="t">FEMA's middle payment for the building since 2015, when an insured house outside the high-risk zone flooded</span></div><div><span class="big">$550 a year</span><span class="t">the middle flood policy there, on a house the owner lives in</span></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">One middle payment outside the zone equals about 48 years of that policy. Inside the high-risk zone, the middle payment was lower, about $15,700.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-10-d/buyers-undisclosed-flooding/conway-florence-floodwater-street-1200w.webp" srcset="/images/2026-10-d/buyers-undisclosed-flooding/conway-florence-floodwater-street-600w.webp 600w, /images/2026-10-d/buyers-undisclosed-flooding/conway-florence-floodwater-street-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="844" alt="Floodwater covering a residential street and the yards of single-story houses, with road signs standing in the water, in the Conway area after Hurricane Florence" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://commons.wikimedia.org/wiki/Template:PD-USGov-Military-National_Guard" target="_blank" rel="noopener noreferrer" aria-label="Photo: SC National Guard. License: Public domain" title="License: Public domain">Photo: SC National Guard</a></span></div><figcaption>Floodwater on a street of houses in the Conway area after Hurricane Florence.</figcaption></figure></div><div class="c3m-we"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.2 4.2L19 7"/></svg></span><p>We get a flood insurance quote on every house during due diligence, in the zone or out of it. Whether a house has flooded before is on our <a href="/buyers/undisclosed-flooding/" style="color:var(--navy);text-decoration:underline">flood history page</a>.</p></div></div></section><section style="background:var(--ivory-2)" id="flood-zone-listing"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="A flood zone the listing leaves out">Will the listing tell me the house is in a flood zone?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Usually not. Of the 245 houses for sale in Horry County inside FEMA's high-risk flood zone, 196 do not say "flood zone" in their listing's feature list.</p><figure class="c3m-stack"><span class="cap">Homes for sale in FEMA's high-risk flood zone, and whether the listing's feature list says so</span><div class="row"><span class="lab">Houses: 245 for sale in the zone</span><div class="bar" aria-hidden="true"><span class="no" style="width:80.0%"></span><span class="yes" style="width:20.0%"></span></div><div class="key"><span><span class="sw" style="background:#c4783a" aria-hidden="true"></span><b>196</b> do not say flood zone</span><span><span class="sw" style="background:#5c6b78" aria-hidden="true"></span><b>49</b> do</span></div></div><div class="row"><span class="lab">Condos: 814 for sale in the zone</span><div class="bar" aria-hidden="true"><span class="no" style="width:78.1%"></span><span class="yes" style="width:21.9%"></span></div><div class="key"><span><span class="sw" style="background:#c4783a" aria-hidden="true"></span><b>636</b> do not say flood zone</span><span><span class="sw" style="background:#5c6b78" aria-hidden="true"></span><b>178</b> do</span></div></div><figcaption>Homes for sale in Horry County on the day this page was built, each tested against the county's copy of FEMA's flood map. The agent's own remarks may still mention it.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Condos are in the zone more often. Of the homes resold in the county in the year to September 2026, about 1 in 4 condos and 1 in 15 houses were in it.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the zone, a loan from a federally regulated lender requires flood insurance, and you must be told in writing.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The middle policy on a house in the zone costs about $1,070 a year if the owner lives in it, and about $1,370 if not. In FEMA's coastal high-hazard zone, marked V, the middle of 141 policies was about $3,200.</p><div class="c3m-we"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.2 4.2L19 7"/></svg></span><p>We test every address against FEMA's flood map before you offer, so the insurance is in your budget before the lender asks for it.</p></div><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Found a house you like?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We find its flood zone on FEMA's map, get a flood insurance quote and price the tax at both rates, before you make an offer.</p><a class="btn btn-brass" href="/contact/">Have us check a house</a></div></div></section><section style="background:var(--ivory)" id="condo-repair-savings"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Condo repair savings">How do I know a condo building has saved enough for repairs?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Only from the building's own budget and records. South Carolina does not require a condo to keep repair savings, called reserves, or to study what its repairs will need.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">More than half of the condos for sale on the Grand Strand are in buildings 30 years old or older.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-10-d/hoa-reserves/myrtle-beach-oceanfront-towers-2011-1200w.webp" srcset="/images/2026-10-d/hoa-reserves/myrtle-beach-oceanfront-towers-2011-600w.webp 600w, /images/2026-10-d/hoa-reserves/myrtle-beach-oceanfront-towers-2011-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="675" alt="A row of oceanfront towers in Myrtle Beach with flat roofs, stacked balconies and pools behind the dunes, seen from a plane over the ocean" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: U.S. Geological Survey. License: Public domain" title="License: Public domain">Photo: U.S. Geological Survey</a></span></div><figcaption>Oceanfront towers in Myrtle Beach. Roofs, balconies and pools like these are what a condo's repair savings pay for.</figcaption></figure></div><div class="c3m-ex"><span class="k">Example</span><p>An 80-unit building has saved 26 percent of what its repairs will need. Over five years it is $380,000 short.</p><p>Split evenly, that is about $4,750 a unit in one bill. The example leaves out inflation and interest.</p></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For loan applications from January 4, 2027, <a href="https://guide.freddiemac.com/app/guide/bulletin/2026-C" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Freddie Mac</a> needs a building's budget to put at least 15 percent of its dues into reserves, up from 10 percent. A buyer whose loan follows Freddie Mac's rules needs a building that meets it.</p><div class="c3m-we"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.2 4.2L19 7"/></svg></span><p>We get the building's budget, its reserve figure and its recent board minutes before you offer. Our pages on <a href="/hoa/reserves/" style="color:var(--navy);text-decoration:underline">condo reserves</a>, <a href="/hoa/special-assessments/" style="color:var(--navy);text-decoration:underline">special assessments</a> and <a href="/buyers/condo-in-litigation/" style="color:var(--navy);text-decoration:underline">condos in a lawsuit</a> explain each one.</p></div></div></section><section style="background:var(--ivory-2)" id="weekly-rentals"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Weekly rentals">Can I rent my Myrtle Beach house by the week?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Inside the City of Myrtle Beach, only where the zoning allows rentals under 90 days. Zoning districts whose names begin with R do not allow them, except the RMV district.</p><ul class="c3m-cards" role="list" aria-label="The City of Myrtle Beach rule on rentals under 90 days"><li><p class="h"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span><span>Districts starting with R, except RMV</span></p><p>No rentals under 90 days.</p></li><li><p class="h"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span>The RMV district</span></p><p>Rentals under 90 days are allowed. RMV stands for Residential Multifamily Visitor.</p></li><li><p class="h"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 5h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM3 10h18M8 3v4M16 3v4M8 14h.01M12 14h.01M16 14h.01M8 17.5h.01M12 17.5h.01"/></svg></span><span>24 houses</span></p><p>Grandfathered in the traditional residential zones, in the whole city.</p></li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A violation is a misdemeanor, with a fine of up to $500, 30 days in jail, or both, each time. Where the zoning allows a short-term rental, the city requires a business license for it.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/buyers-common-mistakes/houses-and-towers-from-the-ocean-1200w.webp" srcset="/images/2026-11-a/buyers-common-mistakes/houses-and-towers-from-the-ocean-600w.webp 600w, /images/2026-11-a/buyers-common-mistakes/houses-and-towers-from-the-ocean-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="782" alt="Older two-story houses on lawns along the beach at left, and two tall condo towers on the beach at right, with streets of houses under oak trees behind, seen from a plane over the ocean in Myrtle Beach" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: U.S. Geological Survey. License: Public domain" title="License: Public domain">Photo: U.S. Geological Survey</a></span></div><figcaption>Houses and condo towers on the same beach in Myrtle Beach.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The <a href="https://www.cityofmyrtlebeach.com/departments/planning_and_zoning_department.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">city is rewriting its zoning code</a>. The rules also differ in each other town and in the county outside the cities; our <a href="/invest/str-rules/" style="color:var(--navy);text-decoration:underline">short-term rental rules page</a> has each one.</p><div class="c3m-we"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.2 4.2L19 7"/></svg></span><p>We look up the zoning of the address before you offer.</p></div></div></section><section style="background:var(--ivory)" id="inspection"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The inspection">Should I skip the inspection to win the house?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. Under South Carolina law, inspecting the house is the buyer's job, and the agents have no duty to inspect it.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The seller's disclosure form is not an inspection. On most resales of a house with one to four units, the seller must give you the state's form before you sign, unless the contract says otherwise. It tells you only what the seller knows.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The law exempts some sales from the form, such as a new home no one has lived in, a foreclosure, an estate sale and an auction.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Septic tanks are rare at the beach and more common inland. About 1 in 16 houses for sale on the Grand Strand list one, and 79 list well water.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}@media (max-width:699px){main#main .c3-gchart.c3-gchart-list [role=row]{grid-template-columns:minmax(0,1fr) auto;column-gap:.8rem;align-items:start}main#main .c3-gchart.c3-gchart-list .b{display:none}main#main .c3-gchart.c3-gchart-list .dot{display:none}main#main .c3-gchart.c3-gchart-list .f{display:block}main#main .c3-gchart.c3-gchart-list [role=cell]{justify-content:flex-end}}</style><figure class="c3-gchart c3-gchart-compact c3-gchart-list"><div role="table" aria-label="Houses for sale that list a septic tank, by mailing town"><span class="cap" aria-hidden="true">Houses for sale that list a septic tank, by mailing town</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Town, houses with septic of houses for sale</span><span role="columnheader">share</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Aynor</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">13 of 44 houses</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">about 1 in 3</span></span></div><div role="row"><span role="rowheader"><span class="n">Loris</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">40 of 154 houses</span></span><span role="cell"><span class="b" style="--f:0.879" aria-hidden="true"></span><span class="v">about 1 in 4</span></span></div><div role="row"><span role="rowheader"><span class="n">Conway</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">61 of 673 houses</span></span><span role="cell"><span class="b" style="--f:0.307" aria-hidden="true"></span><span class="v">about 1 in 11</span></span></div><div role="row"><span role="rowheader"><span class="n">Myrtle Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">13 of 1,036 houses</span></span><span role="cell"><span class="b" style="--f:0.042" aria-hidden="true"></span><span class="v">about 1 in 80</span></span></div><div role="row"><span role="rowheader"><span class="n">North Myrtle Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">4 of 255 houses</span></span><span role="cell"><span class="b" style="--f:0.053" aria-hidden="true"></span><span class="v">about 1 in 64</span></span></div><div role="row"><span role="rowheader"><span class="n">Surfside Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">0 of 82 houses</span></span><span role="cell"><span class="b" style="--f:0" aria-hidden="true"></span><span class="v">none</span></span></div></div></div><figcaption>Houses for sale on the MLS on the day this page was built, counted by the town in their mailing address, which can include land outside the town limits. Some listings do not say, so these are the least.</figcaption></figure><div class="c3m-we"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.2 4.2L19 7"/></svg></span><p>We line up the inspection during due diligence, with a septic and a well check where the house has them.</p></div></div></section><section style="background:var(--ivory-2)" id="your-agent"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Who your agent works for">Does the agent I called work for me?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not until you both sign. In South Carolina, no brokerage firm represents you until you and the firm agree to it in writing.</p><ul class="c3m-cards" role="list" aria-label="Who the firm works for, before and after you sign"><li><p class="h"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5.5 7h8A1.5 1.5 0 0 1 15 8.5v11a1.5 1.5 0 0 1-1.5 1.5h-8A1.5 1.5 0 0 1 4 19.5v-11A1.5 1.5 0 0 1 5.5 7zM8 7V4.5A1.5 1.5 0 0 1 9.5 3h9A1.5 1.5 0 0 1 20 4.5v11a1.5 1.5 0 0 1-1.5 1.5H15M9.5 17.5l-2.3-2.4a1.4 1.4 0 0 1 2.3-1.6 1.4 1.4 0 0 1 2.3 1.6z"/></svg></span><span>Before you both sign</span></p><p>The law presumes you are the firm's customer, and the firm a transaction broker, not your agent.</p></li><li><p class="h"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span>After you both sign an agreement</span></p><p>The firm is your agent, on the terms the agreement states, including its pay.</p></li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Paying an agent does not by itself make the agent yours.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Since August 2024, <a href="https://www.nar.realtor/the-facts/what-the-nar-settlement-means-for-home-buyers-and-sellers" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">agents who use the MLS</a>, the shared list of homes for sale, must sign a written agreement with you before you tour a home. It must state the agent's pay as an amount or a rate, and bar the agent from taking more from any source.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">It must also say that fees are fully negotiable and not fixed by law.</p><div class="c3m-we"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.2 4.2L19 7"/></svg></span><p>On the first call, we explain both choices and put what we will do for you in writing.</p></div></div></section><section style="background:var(--ivory)" id="hoa-rules"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="HOA rules">Will the HOA let me keep my boat, golf cart or rental?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Only if its covenants allow it. A homeowners association (HOA) has written rules, called covenants, that can limit what you keep and how you use the home.</p><ul class="c3m-chips" role="list" aria-label="What HOA covenants can limit"><li><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v13M12 3l7 11h-7M10 6l-5 8h5M3 16h18l-2 4H5z"/></svg></span>Boats</li><li><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 4h12M6 4v8M14 4v8M5 17.5H3V12h12l3-4h1.5L21 13v4.5h-2M9 17.5h6"/><circle cx="7" cy="17.5" r="2"/><circle cx="17" cy="17.5" r="2"/></svg></span>Golf carts</li><li><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span>Rentals</li><li><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 15V5a2 2 0 0 0-2-2M15 15V5a2 2 0 0 0-2-2M9 7h6M9 11h6M2 18c1.7 1.2 3.3 1.2 5 0s3.3-1.2 5 0 3.3 1.2 5 0 3.3-1.2 5 0M2 21.5c1.7 1.2 3.3 1.2 5 0s3.3-1.2 5 0 3.3 1.2 5 0 3.3-1.2 5 0"/></svg></span>Pools</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The biggest mistake we see from buyers moving from New York is not checking that a community's rules fit how they live.</p><div class="c3m-we"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.2 4.2L19 7"/></svg></span><p>We read the covenants for each thing you plan before you offer. If you would rather have no HOA, see our page on <a href="/buyers/no-hoa-homes/" style="color:var(--navy);text-decoration:underline">homes with no HOA</a>.</p></div><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Buying in a community with an HOA?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us about the boat, the cart or the rental plans. We read the covenants for each one before you offer.</p><a class="btn btn-brass" href="/contact/">Talk to a specialized agent</a></div><p style="margin:-.6rem 0 1.2rem"><a class="btn btn-brass" href="tel:+18543332135">Call 854.333.2135</a></p></div></section><section style="background:var(--ivory-2)" id="job-before-closing"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Your job before closing">Can I change jobs while buying a house in Myrtle Beach?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Wait if you can. On a loan that follows <a href="https://selling-guide.fanniemae.com/sel/b3-3.1-04/verbal-verification-employment" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Fannie Mae's rules</a>, the lender checks again that you still have your job no more than 10 business days before closing, or 15 in some cases.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If you are moving here for work, a loan officer at our preferred lender can tell you what your loan will need.</p></div></section><section style="background:var(--ivory)" id="when-we-catch-them"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="When we catch them">When do we catch each mistake?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most of them before you make an offer. Each mistake is listed once, at the stage where we deal with it.</p><ol class="c3m-steps" role="list"><li><p class="s">Before you tour</p><ul role="list"><li><a href="#your-agent">Who your agent works for</a></li></ul></li><li><p class="s">Before you offer</p><ul role="list"><li><a href="#seller-tax-bill">The seller's tax bill</a></li><li><a href="#flood-zone-listing">A flood zone the listing leaves out</a></li><li><a href="#condo-repair-savings">Condo repair savings</a></li><li><a href="#weekly-rentals">Weekly rentals</a></li><li><a href="#hoa-rules">HOA rules</a></li></ul></li><li><p class="s">During due diligence</p><ul role="list"><li><a href="#flood-outside-the-zone">Flood insurance outside the zone</a></li><li><a href="#inspection">The inspection</a></li></ul></li><li><p class="s">Before closing</p><ul role="list"><li><a href="#job-before-closing">Your job</a></li></ul></li><li><p class="s">At and after closing</p><ul role="list"><li><a href="#six-percent-tax">The 4 percent tax rate</a></li></ul></li></ol></div></section><section style="background:var(--ivory-2)" id="buyer-mistakes-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Buyer mistakes FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What is the biggest mistake home buyers make in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Paying the 6 percent tax on a home they live in. On a house the county values at $350,000 outside the city limits, it costs about $2,930 a year more than the 4 percent rate.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do out-of-state buyers make different mistakes?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, because some rules here differ from other states: the 4 percent tax rate, the flood maps and the city's rental zones. The county asks for a South Carolina license and car registration at the house with the 4 percent application.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I get a refund if I paid the 6 percent rate on my home?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, for recent bills. If you qualified and paid at 6 percent, you can claim a refund of the extra tax from the county assessor. State law allows the claim only for recent bills.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do I need flood insurance outside a flood zone in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Federal law does not require it there. Since 2015, FEMA's middle payment after a flood on an insured house outside the high-risk zone was about $26,400. The middle policy for a home the owner lives in there costs about $550 a year.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.scstatehouse.gov/code/t12c043.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-43</a>, <a href="https://www.scstatehouse.gov/code/t12c037.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">12-37</a>, <a href="https://www.scstatehouse.gov/code/t12c054.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">12-54</a>, <a href="https://www.scstatehouse.gov/code/t27c050.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">27-50</a>, <a href="https://www.scstatehouse.gov/code/t40c057.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">40-57</a>, <a href="https://www.horrycountysc.gov/media/oy0hxkmu/spa-required-docs-4252023.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County checklist</a>, <a href="https://www.horrycountysc.gov/media/kufln4qp/tax-levy-2026_2.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">2026 county levy</a>, <a href="https://www.fema.gov/openfema-data-page/fima-nfip-redacted-claims-v2" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FEMA flood claims</a>, <a href="https://www.law.cornell.edu/uscode/text/42/4012a" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">42 U.S.C. 4012a</a>, <a href="https://www.cityofmyrtlebeach.com/departments/planning_and_zoning_department.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Myrtle Beach zoning</a>, <a href="https://www.nar.realtor/the-facts/what-the-nar-settlement-means-for-home-buyers-and-sellers" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NAR</a>, <a href="https://selling-guide.fanniemae.com/sel/b3-3.1-04/verbal-verification-employment" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Fannie Mae</a>, <a href="https://guide.freddiemac.com/app/guide/bulletin/2026-C" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Freddie Mac</a>. Our counts: Horry County parcel records, FEMA's flood policy and claim files, and homes for sale on the MLS, counted in total. Not legal or tax advice.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Floodwater on a street of houses in the Conway area after Hurricane Florence. Photo: Senior Master Sgt. Edward Snyder, 169th Fighter Wing, South Carolina National Guard, <a href="https://commons.wikimedia.org/wiki/Template:PD-USGov-Military-National_Guard" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://commons.wikimedia.org/wiki/File:Hurricane_Florence_-_South_Carolina_National_Guard_Responds_(44200296354).jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>. Chapter3 Realty cropped the left edge to hide a mailbox number.</div><div role="listitem">Oceanfront towers in Myrtle Beach. Photo: U.S. Geological Survey, <a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://doi.org/10.5066/F7N877XX" target="_blank" rel="noopener noreferrer">U.S. Geological Survey</a>. Chapter3 Realty cropped and resized the photo.</div><div role="listitem">Houses and condo towers on the same beach in Myrtle Beach. Photo: U.S. Geological Survey, <a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://doi.org/10.5066/F7N877XX" target="_blank" rel="noopener noreferrer">U.S. Geological Survey</a>. Chapter3 Realty resized the photo and cut 1x1, 4x3 and