--- /dev/null
+++ b/data/2026-11-a/buyers-common-mistakes/pull_listings.py
@@ -0,0 +1,37 @@
+"""Homes for sale now, counted in aggregate from the Chapter3 CRM's public map API (no addresses, prices of single homes or photos kept).
+Houses on septic, public sewer and well water by town; houses and condos tagged in a flood zone; condos whose MLS entry allows short-term rentals.
+Run: python3 -I pull_listings.py <datadir>. Writes listings-counts.json."""
+import json, sys, time, subprocess, urllib.parse, datetime
+D = sys.argv[1]
+BASE = "https://chapter3realty.com/homes/api/map?"
+def total(p):
+    url = BASE + urllib.parse.urlencode(p)
+    for i in range(3):
+        try:
+            d = json.loads(subprocess.run(["curl", "-sS", "-m", "60", "-A", "Mozilla/5.0", url], capture_output=True, text=True).stdout)
+            return d.get("total"), d.get("params"), d["meta"]["refreshedAt"], url
+        except Exception: time.sleep(2)
+    return None, None, None, url
+rows = []
+def add(label, p):
+    n, echo, ref, url = total(p); rows.append({"label": label, "params": p, "echo": echo, "total": n, "refreshedAt": ref, "url": url}); print(label, n, flush=True)
+for t in ("house", "condo"):
+    add(f"all {t}", {"type": t})
+    add(f"{t} flood_zone", {"type": t, "has": "flood_zone"})
+for h in ("septic", "public_sewer", "well_water"):
+    add(f"house {h}", {"type": "house", "has": h})
+for c in ["Myrtle Beach", "North Myrtle Beach", "Conway", "Murrells Inlet", "Little River", "Longs", "Surfside Beach", "Loris", "Aynor", "Galivants Ferry", "Green Sea", "Nichols", "Garden City", "Pawleys Island", "Georgetown"]:
+    add(f"house in {c}", {"type": "house", "city": c})
+    add(f"house septic in {c}", {"type": "house", "city": c, "has": "septic"})
+    add(f"house sewer in {c}", {"type": "house", "city": c, "has": "public_sewer"})
+for lo, hi in [(None, 300000), (300000, 500000), (500000, None)]:
+    p = {"type": "house", "has": "septic"}
+    if lo: p["min"] = lo
+    if hi: p["max"] = hi
+    add(f"house septic {lo}-{hi}", p)
+add("condo str_allowed", {"type": "condo", "has": "str_allowed"})
+add("condo long_term_rental_allowed", {"type": "condo", "has": "long_term_rental_allowed"})
+add("condo in Myrtle Beach", {"type": "condo", "city": "Myrtle Beach"})
+add("condo str_allowed in Myrtle Beach", {"type": "condo", "city": "Myrtle Beach", "has": "str_allowed"})
+add("house str_allowed in Myrtle Beach", {"type": "house", "city": "Myrtle Beach", "has": "str_allowed"})
+json.dump({"pulled": datetime.datetime.utcnow().isoformat() + "Z", "rows": rows}, open(f"{D}/listings-counts.json", "w"), indent=1)
diff --git a/data/2026-11-a/buyers-common-mistakes/pull_parcels.py b/data/2026-11-a/buyers-common-mistakes/pull_parcels.py
new file mode 100644
index 00000000..5c732ae5
--- /dev/null
+++ b/data/2026-11-a/buyers-common-mistakes/pull_parcels.py
@@ -0,0 +1,37 @@
+"""Horry County GIS layer 24 (parcels) and layer 22 (address points) for every home parcel whose last recorded sale
+falls in one of the periods below. Owner name, owner street and site address are read so the analysis can tell
+(1) a person from a company and (2) whether the tax bill is mailed to the home itself. These raw files stay OUT of
+the repo (PRIVATE dir). analyze_parcels.py writes only counts and medians.
+Run: PRIVATE=<dir> python3 -I pull_parcels.py"""
+import sys, json, os, time, urllib.request, urllib.parse
+P = os.environ["PRIVATE"]; os.makedirs(P, exist_ok=True)
+Q = "https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer/%d/query"
+def q(layer, params):
+    data = urllib.parse.urlencode(dict(params, f="json")).encode()
+    for i in range(6):
+        try:
+            d = json.loads(urllib.request.urlopen(urllib.request.Request(Q % layer, data=data), timeout=300).read())
+            if "error" in d: raise Exception(d["error"])
+            return d
+        except Exception as e:
+            print("retry", e, file=sys.stderr); time.sleep(5)
+    raise SystemExit("failed")
+F = "OBJECTID,PIN,LandUseCode,LegalDescr,AssessedProp,TaxableProp,MarketProp,MarketImprv,SaleDate,TaxDistrict,OwnerName,OwnerStreet,OwnerCity,OwnerState,OwnerZip,OwnerZipCode"
+PERIODS = {"2024-2025": ("2024-01-01", "2026-01-01"), "2018-2019": ("2018-01-01", "2020-01-01")}
+for name, (a, b) in PERIODS.items():
+    f = os.path.join(P, "parcels-%s.json" % name)
+    if os.path.exists(f): continue
+    where = "LandUseCode LIKE '1%%' AND MarketImprv > 0 AND SaleDate >= DATE '%s' AND SaleDate < DATE '%s'" % (a, b)
+    rows, last = [], 0
+    while True:
+        d = q(24, {"where": where + " AND OBJECTID > %d" % last, "outFields": F, "orderByFields": "OBJECTID", "returnGeometry": "false", "resultRecordCount": 2000})
+        feats = [x["attributes"] for x in d["features"]]
+        if not feats: break
+        rows += feats; last = feats[-1]["OBJECTID"]; print(name, len(rows), flush=True)
+    json.dump({"where": where, "pulled": time.strftime("%Y-%m-%d"), "rows": rows}, open(f, "w"))
+    pins = sorted({str(int(r["PIN"])) for r in rows if r["PIN"]})
+    addr = []
+    for i in range(0, len(pins), 250):
+        addr += [x["attributes"] for x in q(22, {"where": "PIN IN (" + ",".join(pins[i:i + 250]) + ")", "outFields": "PIN,StreetNum,STREETNAME,UNIT,ADDRESS,ZIPCODE,POSTAL_CITY", "returnGeometry": "false"})["features"]]
+        if i % 5000 == 0: print("addr", name, i, len(addr), flush=True)
+    json.dump(addr, open(os.path.join(P, "addresses-%s.json" % name), "w"))
