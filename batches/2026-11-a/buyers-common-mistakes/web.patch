+++ b/data/2026-11-a/buyers-common-mistakes/analyze_claims.py
@@ -0,0 +1,25 @@
+"""What a flood cost the owner when it was insured: median NFIP building payment in Horry County, by rated zone, since 2015.
+Input: the sibling page's slim OpenFEMA NfipClaims v3 pull, data/2026-10-d/buyers-undisclosed-flooding/raw/nfip-claims-horry-slim.json
+(countyCode 45051, asOfDate 2026-09-08). Dollars are as paid (not adjusted for inflation). Writes claims-findings.json.
+Run: python3 -I analyze_claims.py <datadir> <slim.json>"""
+import json, os, sys, statistics as st, collections
+D, SRC = sys.argv[1], sys.argv[2]
+d = json.load(open(SRC)); rows = d["rows"] if isinstance(d, dict) and "rows" in d else d
+def grp(z):
+    z = (z or "").upper()
+    if z[:1] in ("A", "V"): return "high"
+    if z in ("X", "B", "C") or z.startswith("X"): return "outside"
+    return "unknown"
+out = {"source": SRC, "fields_seen": sorted(rows[0].keys()), "by": {}}
+for since in (1978, 2015):
+    G = collections.defaultdict(list); R = collections.defaultdict(list)
+    for r in rows:
+        y = r.get("yearOfLoss") or int(str(r.get("dateOfLoss", "0"))[:4] or 0)
+        if not y or int(y) < since: continue
+        b = r.get("netBuildingPaymentAmount") or 0
+        if b > 0:
+            g = grp(r.get("ratedFloodZone")); G[g].append(b)
+            if r.get("occupancyType") in (1, 11): R[g].append(b)
+    out["by"]["since_%d" % since] = {g: {"n": len(v), "median_building_payment": round(st.median(v))} for g, v in G.items()}
+    out["by"]["since_%d_single_family" % since] = {g: {"n": len(v), "median_building_payment": round(st.median(v))} for g, v in R.items()}
+json.dump(out, open(os.path.join(D, "claims-findings.json"), "w"), indent=1); print(json.dumps(out, indent=1))
diff --git a/data/2026-11-a/buyers-common-mistakes/analyze_fema.py b/data/2026-11-a/buyers-common-mistakes/analyze_fema.py
new file mode 100644
index 00000000..cf5d3b24
--- /dev/null
+++ b/data/2026-11-a/buyers-common-mistakes/analyze_fema.py
@@ -0,0 +1,29 @@
+"""Median NFIP flood policy cost in Horry County by flood zone, for one-family houses (not condos), lived in or not.
+Input PRIVATE/nfip-policies-horry-2025-26.json (fetch_fema_policies.py). Writes fema-findings.json.
+policyCost = premium + reserve fund assessment + federal policy fee + HFIAA surcharge (FEMA's definition): what the owner pays.
+Run: PRIVATE=<dir> python3 -I analyze_fema.py <datadir>"""
+import json, os, sys, statistics as st, collections
+D = sys.argv[1]; P = os.environ["PRIVATE"]
+d = json.load(open(os.path.join(P, "nfip-policies-horry-2025-26.json")))
+def grp(z):
+    z = (z or "").upper()
+    if z.startswith("V"): return "V (coastal high hazard)"
+    if z.startswith("A"): return "A (high risk)"
+    if z in ("X", "B", "C"): return "X (moderate or low risk)"
+    return "other/unknown"
+def q(xs, p): xs = sorted(xs); return xs[min(len(xs) - 1, int(p * (len(xs) - 1) + 0.5))]
+out = {"source": d["source"], "filter": d["filter"], "pulled": d["pulled"], "records": d["count"], "asOfDate": d["rows"][0].get("asOfDate") if d["rows"] else None,
+       "definition": "one-year policies on one-family houses (occupancyType 1 or 11, not a condo unit or condo association), policyCost in dollars", "groups": {}}
+H = [r for r in d["rows"] if r.get("occupancyType") in (1, 11) and (r.get("condominiumCoverageTypeCode") in (None, "N")) and r.get("policyTermIndicator") == 1 and (r.get("policyCost") or 0) > 0]
+out["house_policies"] = len(H)
+for zone_field in ("ratedFloodZone", "floodZoneCurrent"):
+    G = collections.defaultdict(list)
+    for r in H:
+        k = (grp(r.get(zone_field)), "lived in" if r.get("primaryResidenceIndicator") else "not lived in")
+        G[k].append(r["policyCost"])
+        G[(grp(r.get(zone_field)), "all")].append(r["policyCost"])
+    out["groups"][zone_field] = {" | ".join(k): {"n": len(v), "median": st.median(v), "p25": q(v, .25), "p75": q(v, .75)} for k, v in sorted(G.items())}
+req = collections.Counter((grp(r.get("floodZoneCurrent")), bool(r.get("mandatoryPurchaseFlag"))) for r in H)
+out["lender_required_by_current_zone"] = {"%s | required=%s" % k: n for k, n in sorted(req.items())}
+json.dump(out, open(os.path.join(D, "fema-findings.json"), "w"), indent=1)
+print(json.dumps(out, indent=1))
diff --git a/data/2026-11-a/buyers-common-mistakes/analyze_flood_tag.py b/data/2026-11-a/buyers-common-mistakes/analyze_flood_tag.py
new file mode 100644
index 00000000..8d4198e3
--- /dev/null
+++ b/data/2026-11-a/buyers-common-mistakes/analyze_flood_tag.py
@@ -0,0 +1,51 @@
+"""Does the listing say "flood zone" when the house is in FEMA's high-risk zone? Homes for sale now, tested point by point
+against Horry County GIS layer 19 polygons with SFHA_TF = 'T' (FEMA high-risk zones A, AE, VE ...), compared with the MLS
+"flood zone" feature on the same listings. Points outside Horry County's flood layer coverage (Georgetown County) are not
+tested: the layer covers Horry County only. Writes flood-tag-findings.json (counts only).
+Run: PRIVATE=<dir> python3 -I analyze_flood_tag.py <datadir>"""
+import json, os, sys
+from shapely.geometry import Point, Polygon, MultiPolygon
+from shapely.strtree import STRtree
+from shapely.ops import unary_union
+D = sys.argv[1]; P = os.environ["PRIVATE"]
+polys = []
+for f in json.load(open(os.path.join(P, "flood-sfha.json"))):
+    rings = f["geometry"]["rings"]
+    # ArcGIS rings: outer rings clockwise, holes counter-clockwise. Build by orientation.
+    outer, holes = [], []
+    for r in rings:
+        a = sum((r[i][0] - r[i - 1][0]) * (r[i][1] + r[i - 1][1]) for i in range(len(r)))
+        (outer if a > 0 else holes).append(r)
+    for o in outer:
+        po = Polygon(o)
+        hs = [h for h in holes if po.contains(Point(h[0]))]
+        polys.append(Polygon(o, hs).buffer(0))
+tree = STRtree(polys)
+L = json.load(open(os.path.join(P, "listing-points.json")))
+# Horry County outline (Horry GIS layer 33, saved by the sibling page as raw/county.json) to keep only Horry points
+cj = json.load(open(os.path.join(D, "..", "..", "2026-10-d", "buyers-undisclosed-flooding", "raw", "county.json")))
+def to_geom(x):
+    if isinstance(x, list): x = x[0]
+    if "features" in x: x = x["features"][0]
+    g = x.get("geometry", x)
+    if "rings" in g: return unary_union([Polygon(r) for r in g["rings"]])
+    from shapely.geometry import shape; return shape(g)
+county = to_geom(cj).buffer(0)
+def inside(lat, lng):
+    pt = Point(lng, lat)
+    return any(polys[i].contains(pt) for i in tree.query(pt))
+out = {"pulled_listings": L["pulled"], "truncated_bands": len(L["truncated"]), "by_type": {}}
+for t in ("house", "condo"):
+    tagged = set(L["sets"][t + "|flood_zone"])
+    c = {"listings": 0, "in_horry": 0, "in_sfha": 0, "in_sfha_tagged": 0, "in_sfha_not_tagged": 0, "outside_sfha_tagged": 0, "tagged_total": len(tagged)}
+    for mls, p in L["sets"][t].items():
+        if p["lat"] is None: continue
+        c["listings"] += 1
+        if not county.contains(Point(p["lng"], p["lat"])): continue
+        c["in_horry"] += 1
+        s = inside(p["lat"], p["lng"]); g = mls in tagged
+        if s: c["in_sfha"] += 1; c["in_sfha_tagged" if g else "in_sfha_not_tagged"] += 1
+        elif g: c["outside_sfha_tagged"] += 1
+    c["share_in_sfha_not_tagged"] = round(c["in_sfha_not_tagged"] / c["in_sfha"], 3) if c["in_sfha"] else None
+    out["by_type"][t] = c
+json.dump(out, open(os.path.join(D, "flood-tag-findings.json"), "w"), indent=1); print(json.dumps(out, indent=1))
diff --git a/data/2026-11-a/buyers-common-mistakes/analyze_parcels.py b/data/2026-11-a/buyers-common-mistakes/analyze_parcels.py
new file mode 100644
index 00000000..deb0eed9
--- /dev/null
+++ b/data/2026-11-a/buyers-common-mistakes/analyze_parcels.py
@@ -0,0 +1,73 @@
+"""Who never filed for the 4 percent rate? Horry County houses bought in 2024-2025 (and, for comparison, 2018-2019),
+owned by a person (not a company), whose tax bill is mailed to the house itself, split by assessment class.
+Assessment class = AssessedProp / TaxableProp: about 0.04 = legal residence (4%), about 0.06 = all other (6%).
+"Mailed to the house" = the owner mailing house number and street name (suffix, direction and spacing ignored) match the county address point, and the mailing state is SC with a 295xx ZIP.
+Houses only: land use 101, not a condo (no 'HPR' in the legal description), building value > 0, one address point.
+Input: PRIVATE/parcels-<period>.json, PRIVATE/addresses-<period>.json (pull_parcels.py). Output: parcels-findings.json (counts and medians only).
+Run: PRIVATE=<dir> python3 -I analyze_parcels.py <datadir>"""
+import json, os, re, sys, statistics as st, collections, datetime
+D = sys.argv[1]; P = os.environ["PRIVATE"]
+COMPANY = re.compile(r"\b(LLC|L L C|INC|CORP|CORPORATION|COMPANY|CO|LP|LLP|LTD|PARTNERS|PARTNERSHIP|HOLDINGS|PROPERTIES|INVESTMENTS?|GROUP|ENTERPRISES|BANK|ASSOCIATION|FUND|REIT|TRUST|TRUSTEE|TRUSTEES|TR|REVOCABLE|ESTATE|HOMES|BUILDERS?|CHURCH|AUTHORITY|COUNTY|CITY|STATE)\b")
+SUF = {"STREET": "ST", "ROAD": "RD", "DRIVE": "DR", "AVENUE": "AVE", "AV": "AVE", "LANE": "LN", "COURT": "CT", "CIRCLE": "CIR", "BOULEVARD": "BLVD", "PLACE": "PL",
+       "TRAIL": "TRL", "HIGHWAY": "HWY", "PARKWAY": "PKWY", "TERRACE": "TER", "WAY": "WAY", "LOOP": "LOOP", "POINT": "PT", "COVE": "CV", "NORTH": "N", "SOUTH": "S", "EAST": "E", "WEST": "W"}
+def norm(s):
+    s = re.sub(r"[^A-Z0-9 ]", " ", (s or "").upper())
+    s = re.sub(r"\b(UNIT|APT|STE|SUITE|BLDG|#)\b.*$", "", s)
+    return [SUF.get(t, t) for t in s.split()]
+ORD = {"FIRST": "1ST", "SECOND": "2ND", "THIRD": "3RD", "FOURTH": "4TH", "FIFTH": "5TH", "SIXTH": "6TH", "SEVENTH": "7TH", "EIGHTH": "8TH", "NINTH": "9TH", "TENTH": "10TH",
+       "ELEVENTH": "11TH", "TWELFTH": "12TH", "THIRTEENTH": "13TH", "FOURTEENTH": "14TH", "FIFTEENTH": "15TH", "SIXTEENTH": "16TH", "SEVENTEENTH": "17TH", "EIGHTEENTH": "18TH", "NINETEENTH": "19TH", "TWENTIETH": "20TH"}
+DROP = {"N", "S", "E", "W", "ST", "RD", "DR", "AVE", "LN", "CT", "CIR", "BLVD", "PL", "TRL", "HWY", "PKWY", "PKY", "TER", "WAY", "LOOP", "LP", "PT", "CV", "RUN", "BND", "XING", "SQ"}
+def key(num, name):
+    num = re.match(r"\d+", str(num).strip()); num = num.group(0) if num else ""
+    toks = [ORD.get(t, t) for t in norm(name)]
+    toks = [t for t in toks if t not in DROP] or toks
+    return (num, "".join(toks))
+def cls(r):
+    a, t = r.get("AssessedProp") or 0, r.get("TaxableProp") or 0
+    if t <= 0 or a <= 0: return None
+    x = a / t
+    return "4%" if x < 0.05 else "6%"
+out = {"method": __doc__.strip().splitlines()[0:5], "periods": {}}
+for period in ("2024-2025", "2018-2019"):
+    rows = json.load(open(os.path.join(P, "parcels-%s.json" % period)))["rows"]
+    addrs = collections.defaultdict(list)
+    for a in json.load(open(os.path.join(P, "addresses-%s.json" % period))): addrs[int(a["PIN"])].append(a)
+    gaps = []; c = collections.Counter(); vals = collections.defaultdict(list); dist = collections.Counter()
+    for r in rows:
+        if r.get("LandUseCode") != "101" or "HPR" in (r.get("LegalDescr") or "") or not r.get("PIN"): continue
+        c["houses"] += 1
+        k = cls(r)
+        if not k: c["no_value"] += 1; continue
+        if COMPANY.search(r.get("OwnerName") or ""): c["company_or_trust"] += 1; continue
+        c["person"] += 1
+        A = addrs.get(int(r["PIN"]), [])
+        if len(A) != 1: c["person_not_one_address"] += 1; continue
+        a = A[0]
+        own = norm(r.get("OwnerStreet"))
+        if not own or not own[0].isdigit():
+            c["person_po_box_or_no_number"] += 1; mailed = False
+        else:
+            mailed = key(own[0], " ".join(own[1:])) == key(a.get("StreetNum"), a.get("STREETNAME")) and (r.get("OwnerState") or "").strip() == "SC" and str(r.get("OwnerZip") or "")[:3] == "295"
+        c["person_one_address"] += 1
+        g = "mailed_to_house" if mailed else "mailed_elsewhere"
+        c[g] += 1; c[g + "_" + k] += 1
+        yr = str(datetime.datetime.utcfromtimestamp(r["SaleDate"] / 1000).year)
+        c[yr + "_" + g] += 1; c[yr + "_" + g + "_" + k] += 1
+        if g == "mailed_to_house" and k == "6%" and r.get("TaxDistrict") == "100":
+            T = r["TaxableProp"]; gap = T * 0.06 * 201.0 / 1000 - T * 0.04 * 91.9 / 1000
+            gaps.append(gap)
+        vals[g + "_" + k].append(r["TaxableProp"])
+        if g == "mailed_to_house" and k == "6%": dist[r.get("TaxDistrict")] += 1
+    res = dict(c)
+    for g in ("mailed_to_house", "mailed_elsewhere"):
+        n = c[g]; s6 = c[g + "_6%"]
+        res[g + "_share_6pct"] = round(s6 / n, 4) if n else None
+    for yr in sorted({k.split("_")[0] for k in c if k[:2] in ("20",)}):
+        n = c[yr + "_mailed_to_house"]; res[yr + "_mailed_to_house_share_6pct"] = round(c[yr + "_mailed_to_house_6%"] / n, 4) if n else None
+    res["district100_mailed_to_house_6pct"] = {"n": len(gaps), "median_yearly_gap": round(st.median(gaps)) if gaps else None, "sum_yearly_gap": round(sum(gaps)),
+        "rule": "gap = TaxableProp x 0.06 x 201.0/1000 - TaxableProp x 0.04 x 91.9/1000 (2026 district 100 millage, school operating 109.1 exempt at 4%)"}
+    res["median_taxable"] = {k: round(st.median(v)) for k, v in vals.items()}
+    res["mailed_to_house_6pct_by_tax_district_top"] = dist.most_common(12)
+    out["periods"][period] = res
+json.dump(out, open(os.path.join(D, "parcels-findings.json"), "w"), indent=1)
+print(json.dumps(out, indent=1))
diff --git a/data/2026-11-a/buyers-common-mistakes/build_examples.py b/data/2026-11-a/buyers-common-mistakes/build_examples.py
new file mode 100644
index 00000000..b84d44a6
--- /dev/null
+++ b/data/2026-11-a/buyers-common-mistakes/build_examples.py
@@ -0,0 +1,39 @@
+"""Worked examples for /buyers/common-mistakes/, from verified rules only. Writes examples.json.
+Millage: Horry County 2026 certified levy (retirees ledger rows 21-22): unincorporated district 100 = 201.0 mills, of which
+109.1 is school operating (exempt at 4%, S.C. Code 12-37-220(B)(47)); City of Myrtle Beach = 254.6 mills incl. 83.4 city, with the
+city's 53.4% credit on the city tax for a legal residence (/buyers/property-taxes/ model). Same model as the site's property tax calculator.
+Run: python3 -I build_examples.py <datadir>"""
+import json, os, sys
+D = sys.argv[1]
+SCHOOL_OPS = 109.1
+PLACES = {"Unincorporated Horry County": (201.0, 0.0), "City of Myrtle Beach": (254.6, 83.4)}
+TDF = 0.534
+def tax(value, ratio, mills, city):
+    if ratio == 0.06: return value * 0.06 * mills / 1000
+    t = value * 0.04 * (mills - SCHOOL_OPS) / 1000
+    if city: t -= value * 0.04 * city / 1000 * TDF
+    return t
+PRICE = 350000  # middle resale house, Horry County, deeds Oct 2025-Sep 2026 (sell-home-value ledger row 2)
+out = {"price": PRICE, "tax": {}}
+for p, (m, c) in PLACES.items():
+    four, six = tax(PRICE, 0.04, m, c), tax(PRICE, 0.06, m, c)
+    out["tax"][p] = {"4pct": round(four, 2), "6pct": round(six, 2), "gap_per_year": round(six - four, 2), "gap_5_years": round(5 * (six - four), 2), "ratio": round(six / four, 2)}
+# Seller's bill: a house last sold 2005-2014 is taxed on about 62.5% of the county's market value (sell-home-value ledger row 15, value-weighted band).
+SHARE = 0.625
+seller_taxable = PRICE * SHARE
+m, c = PLACES["Unincorporated Horry County"]
+out["seller_bill_example"] = {"assumption": "house worth $350,000, seller owned since about 2010 and lived in it (4%), taxable value at the 2005-2014 band's 62.5% of market",
+    "seller_taxable": round(seller_taxable), "seller_bill_4pct": round(tax(seller_taxable, 0.04, m, c), 2),
+    "buyer_bill_4pct": out["tax"]["Unincorporated Horry County"]["4pct"], "buyer_bill_6pct": out["tax"]["Unincorporated Horry County"]["6pct"]}
+s = out["seller_bill_example"]; s["buyer_6pct_over_seller"] = round(s["buyer_bill_6pct"] - s["seller_bill_4pct"], 2); s["times"] = round(s["buyer_bill_6pct"] / s["seller_bill_4pct"], 2)
+# Flood: one insured flood outside the high-risk zone vs a year of cover (claims-findings.json, fema-findings.json)
+cl = json.load(open(os.path.join(D, "claims-findings.json")))["by"]["since_2015_single_family"]
+fe = json.load(open(os.path.join(D, "fema-findings.json")))["groups"]["ratedFloodZone"]
+out["flood"] = {"median_paid_house_outside_high_risk_since_2015": cl["outside"]["median_building_payment"], "n_outside": cl["outside"]["n"],
+                "median_paid_house_high_risk_since_2015": cl["high"]["median_building_payment"], "n_high": cl["high"]["n"],
+                "median_policy_house_lived_in_X": fe["X (moderate or low risk) | lived in"]["median"], "n_X_lived_in": fe["X (moderate or low risk) | lived in"]["n"],
+                "median_policy_house_lived_in_A": fe["A (high risk) | lived in"]["median"], "n_A_lived_in": fe["A (high risk) | lived in"]["n"],
+                "median_policy_house_not_lived_in_A": fe["A (high risk) | not lived in"]["median"],
+                "median_policy_house_V_all": fe["V (coastal high hazard) | all"]["median"], "n_V": fe["V (coastal high hazard) | all"]["n"]}
+out["flood"]["years_of_X_cover_per_median_outside_claim"] = round(out["flood"]["median_paid_house_outside_high_risk_since_2015"] / out["flood"]["median_policy_house_lived_in_X"], 1)
+json.dump(out, open(os.path.join(D, "examples.json"), "w"), indent=1); print(json.dumps(out, indent=1))
