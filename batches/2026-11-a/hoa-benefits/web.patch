index 00000000..9f12e4fc
--- /dev/null
+++ b/data/2026-11-a/hoa-benefits/pull_condo_fees.py
@@ -0,0 +1,41 @@
+"""Monthly condo fee, oceanfront buildings against the rest, from the CRM's public map API (CCMLS active
+listings for sale), the same method as ../../2026-10-d/hoa-hoa-vs-poa/pull_fees.py and refine_medians.py
+(whole feed, no county filter): count condos at or under each fee step (hoaMax), $25 steps, then $5 steps
+around the median. "Not oceanfront" = all condos minus has=oceanfront_building. Counts only.
+Run: python3 -I pull_condo_fees.py <outdir>. Writes <outdir>/condo-fees.json."""
+import json, sys, time, urllib.request, urllib.parse, datetime
+out = sys.argv[1]; BASE = "https://chapter3realty.com/homes/api/map?"; calls = []
+def total(p):
+    url = BASE + urllib.parse.urlencode(dict(p, limit=1))
+    for i in range(5):
+        try:
+            t = json.load(urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (research; chapter3realty.com)"}), timeout=60)).get("total")
+            calls.append([url, t]); time.sleep(0.15); return t
+        except Exception: time.sleep(4)
+    raise SystemExit("failed " + url)
+STEPS = list(range(0, 2001, 25)) + [3000, 100000]
+def cdf(extra):
+    return {s: total(dict(extra, type="condo", hoaMax=s)) for s in STEPS}
+def median5(extra, c, tot):
+    zero = c[0]; half = zero + (tot - zero) / 2
+    hi = next(s for s in STEPS if c[s] >= half); lo = max(s for s in STEPS if s < hi)
+    for s in range(lo + 5, hi + 1, 5):
+        if total(dict(extra, type="condo", hoaMax=s)) >= half: return s, zero, tot - zero
+    return hi, zero, tot - zero
+res = {"pulled": datetime.datetime.now(datetime.timezone.utc).isoformat(), "api": BASE, "groups": {}}
+allc = cdf({}); oc = cdf({"has": "oceanfront_building"})
+t_all = total({"type": "condo"}); t_oc = total({"type": "condo", "has": "oceanfront_building"})
+for name, c, t, extra in (("all condos", allc, t_all, {}), ("oceanfront building", oc, t_oc, {"has": "oceanfront_building"})):
+    m, z, w = median5(extra, c, t)
+    res["groups"][name] = {"total": t, "fee_zero_or_blank": z, "with_fee": w, "median_fee_5": m, "cdf": c,
+                           "share_over_500_pct": round(100 * (t - c[500]) / t, 1)}
+rest = {s: allc[s] - oc[s] for s in STEPS}; t_rest = t_all - t_oc; zero = rest[0]; half = zero + (t_rest - zero) / 2
+hi = next(s for s in STEPS if rest[s] >= half); lo = max(s for s in STEPS if s < hi)
+m = hi
+for s in range(lo + 5, hi + 1, 5):
+    if total({"type": "condo", "hoaMax": s}) - total({"type": "condo", "has": "oceanfront_building", "hoaMax": s}) >= half: m = s; break
+res["groups"]["not oceanfront"] = {"total": t_rest, "fee_zero_or_blank": zero, "with_fee": t_rest - zero, "median_fee_5": m, "cdf": rest,
+                                   "share_over_500_pct": round(100 * (t_rest - rest[500]) / t_rest, 1)}
+res["calls"] = calls
+json.dump(res, open(f"{out}/condo-fees.json", "w"), indent=1)
+print(json.dumps({k: {kk: vv for kk, vv in v.items() if kk != "cdf"} for k, v in res["groups"].items()}, indent=1))
diff --git a/data/2026-11-a/hoa-benefits/pull_counts.py b/data/2026-11-a/hoa-benefits/pull_counts.py
new file mode 100644
index 00000000..fe4174cb
--- /dev/null
+++ b/data/2026-11-a/hoa-benefits/pull_counts.py
@@ -0,0 +1,32 @@
+"""Counts only, from the CRM's public map API (CCMLS active listings for sale), for /hoa/benefits/.
+1) Houses by year built: how many are for sale and how many list no HOA fee (hoaMax=0), per band.
+2) Houses with an HOA fee that list a community pool, clubhouse, gate, tennis, or RV and boat parking
+   (count with the feature, minus the count with the feature and no fee).
+No listing is saved. Run: python3 -I pull_counts.py <outdir>. Writes <outdir>/counts.json."""
+import json, sys, time, urllib.request, urllib.parse, datetime
+out = sys.argv[1]; BASE = "https://chapter3realty.com/homes/api/map?"; calls = []
+def total(p):
+    p = dict(p, limit=1); url = BASE + urllib.parse.urlencode(p)
+    for i in range(5):
+        try:
+            t = json.load(urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (research; chapter3realty.com)"}), timeout=60)).get("total")
+            calls.append([url, t]); time.sleep(0.2); return t
+        except Exception: time.sleep(4)
+    return None
+BANDS = [("before 1980", None, 1979), ("1980 to 1999", 1980, 1999), ("2000 to 2009", 2000, 2009), ("2010 to 2019", 2010, 2019), ("2020 or later", 2020, None)]
+res = {"pulled": datetime.datetime.now(datetime.timezone.utc).isoformat(), "api": BASE, "by_year": [], "features_with_fee": {}}
+res["house_total"] = total({"type": "house"}); res["house_no_fee"] = total({"type": "house", "hoaMax": 0})
+for name, lo, hi in BANDS:
+    q = {"type": "house"}
+    if lo: q["yearMin"] = lo
+    if hi: q["yearMax"] = hi
+    t = total(q); z = total(dict(q, hoaMax=0))
+    res["by_year"].append({"band": name, "yearMin": lo, "yearMax": hi, "houses": t, "no_fee": z, "with_fee": t - z, "pct_with_fee": round(100 * (t - z) / t, 1) if t else None})
+with_fee = res["house_total"] - res["house_no_fee"]; res["house_with_fee"] = with_fee
+for f in ["community_pool", "clubhouse", "gated", "tennis", "rv_boat_parking", "fenced_yard", "boat_ramp", "boat_slip"]:
+    a = total({"type": "house", "has": f}); z = total({"type": "house", "has": f, "hoaMax": 0})
+    res["features_with_fee"][f] = {"all": a, "no_fee": z, "with_fee": a - z, "pct_of_with_fee": round(100 * (a - z) / with_fee, 1),
+                                   "pct_of_no_fee": round(100 * z / res["house_no_fee"], 1)}
+res["calls"] = calls
+json.dump(res, open(f"{out}/counts.json", "w"), indent=1)
+print(json.dumps({k: v for k, v in res.items() if k != "calls"}, indent=1))
diff --git a/data/2026-11-a/hoa-benefits/pull_houses.py b/data/2026-11-a/hoa-benefits/pull_houses.py
new file mode 100644
index 00000000..f73aad19
--- /dev/null
+++ b/data/2026-11-a/hoa-benefits/pull_houses.py
@@ -0,0 +1,64 @@
+"""Houses for sale, with and without an HOA fee, from the CRM's public map API (CCMLS active listings), for
+aggregate medians only. The API returns at most 144 pins a call, so each search is split into price bands
+until every home is returned. A search with no match returns nearby homes with its filters
+dropped (the "closest" block); those pins are skipped. Four searches: all houses; houses with no fee listed (hoaMax=0, the site's
+"No HOA" filter count); houses built 2000 or later (yearMin=2000); houses built 2015 or later (yearMin=2015).
+Saved per home: ZIP (from the pin's address line), list price, square feet, lot acres, the straight-line
+distance to the beach as a band (under 1 mile, 1 to 3, 3 to 10, over 10), and which of the
+searches returned it. No MLS number, address, firm, photo or coordinate is saved.
+Run: python3 -I pull_houses.py <outdir>. Writes <outdir>/raw/houses-active.json."""
+import json, sys, os, re, math, time, urllib.request, urllib.parse, datetime
+# The beach, as points along the shore from Pawleys Island to Waites Island (approximate, read off the map to about
+# 0.2 mile). A home's straight-line distance to this line is kept only as a band; its coordinates are not saved.
+SHORE = [(33.400, -79.130), (33.500, -79.060), (33.5838, -78.9908), (33.6058, -78.9727), (33.651, -78.927), (33.6919, -78.8784),
+         (33.760, -78.782), (33.785, -78.750), (33.816, -78.668), (33.8297, -78.6338), (33.846, -78.597), (33.856, -78.567)]
+def miles_to_shore(lat, lng):
+    if lat is None or lng is None: return None
+    kx = 69.17 * math.cos(math.radians(lat)); ky = 69.0; best = 1e9
+    for (a1, o1), (a2, o2) in zip(SHORE, SHORE[1:]):
+        ax, ay, bx, by, px, py = o1 * kx, a1 * ky, o2 * kx, a2 * ky, lng * kx, lat * ky
+        dx, dy = bx - ax, by - ay; t = max(0, min(1, ((px - ax) * dx + (py - ay) * dy) / (dx * dx + dy * dy)))
+        best = min(best, math.hypot(px - ax - t * dx, py - ay - t * dy))
+    return best
+def band_of(m):
+    if m is None: return None
+    return "under 1 mile" if m < 1 else "1 to 3 miles" if m < 3 else "3 to 10 miles" if m < 10 else "over 10 miles"
+out = sys.argv[1]; RAW = os.path.join(out, "raw"); os.makedirs(RAW, exist_ok=True)
+BASE = "https://chapter3realty.com/homes/api/map?"
+calls = []
+def get(p):
+    url = BASE + urllib.parse.urlencode(p)
+    for i in range(5):
+        try:
+            d = json.load(urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (research; chapter3realty.com)"}), timeout=60))
+            calls.append([url, d.get("total")]); return d
+        except Exception: time.sleep(4)
+    raise SystemExit("failed " + url)
+def num(s):
+    try: return float(str(s).replace("$", "").replace(",", ""))
+    except Exception: return None
+def band(extra, lo, hi, acc, warn):
+    d = get(dict(extra, type="house", min=lo, max=hi))
+    if not d.get("total") or d.get("closest"): return  # an empty search returns nearby homes with the filters dropped; skip them
+    if d["total"] > len(d["pins"]) and hi - lo > 500:
+        mid = (lo + hi) // 2; band(extra, lo, mid, acc, warn); band(extra, mid + 1, hi, acc, warn); return
+    if d["total"] > len(d["pins"]): warn.append([extra, lo, hi, d["total"], len(d["pins"])])
+    for p in d["pins"]:
+        m = re.search(r"(\d{5})\s*$", p.get("addr") or "")
+        acc[p["mls"]] = {"zip": m.group(1) if m else None, "price": num(p.get("price")), "sqft": p.get("sqft") or None,
+                         "acres": num(p.get("acres")), "beach_band": band_of(miles_to_shore(p.get("lat"), p.get("lng"))), "new_tag": bool(re.match(r"Built 20(2[5-9])", p.get("tag") or ""))}
+EDGES = list(range(0, 1000001, 50000)) + [1250000, 1500000, 2000000, 3000000, 60000000]
+STARTS = [(EDGES[i] + (1 if i else 0), EDGES[i + 1]) for i in range(len(EDGES) - 1)]
+SEARCHES = {"all": {}, "no_fee": {"hoaMax": 0}, "built_2000_plus": {"yearMin": 2000}, "built_2015_plus": {"yearMin": 2015}}
+sets, totals, warn, homes = {}, {}, [], {}
+for k, extra in SEARCHES.items():
+    acc = {}
+    for lo, hi in STARTS: band(extra, lo, hi, acc, warn)
