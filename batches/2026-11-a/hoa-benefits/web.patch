@@ -0,0 +1,24 @@
+# Data for /hoa/benefits/ (batch 2026-11-a)
+
+Every number on the page comes from these files. Ledger: Blog-Brain `batches/2026-11-a/hoa-benefits/facts.md`.
+
+| File | What | Made by |
+|---|---|---|
+| raw/houses-active.json | Every house for sale from four map API searches (all, no fee, built 2000+, built 2015+), split into price bands: ZIP, list price, square feet, lot acres, distance-to-beach band, and which searches returned it. No MLS number, address, firm or coordinate. | pull_houses.py (2026-11-04) |
+| price-test.json | Asking price per square foot and lot size, with a fee against no fee: county, ZIP by ZIP, by age, by lot size and by distance from the beach (rows 9 to 12) | analyze_houses.py |
+| counts.json | Houses with a fee by year built; house features with and without a fee; every URL called (rows 6, 8) | pull_counts.py (2026-11-04) |
+| condo-fees.json | Condo fee medians, oceanfront buildings against the rest, $5 steps (row 2) | pull_condo_fees.py (2026-11-04) |
+| prices.json | Public pool and gym prices read from the saved city pages (row 13) | extract_prices.py |
+| scdca-concerns.json | Horry County HOA complaints to SC Consumer Affairs by concern, 2022 to 2025 (row 25). Counts only. | scdca_concerns.py (reads ../../2026-10-d/hoa-special-assessments/raw/scdca-legislative-*.xlsx) |
+| findings.json, chart-*.json | Every derived number and the chart data the spec reads | build_findings.py |
+| raw/nmb-afc-membership.html, raw/nmb-afc-home.html | North Myrtle Beach Aquatic & Fitness Center pages, read 2026-11-04 | curl |
+| raw/mb-rec-memberships.html, raw/mb-pepper-geddings.html | City of Myrtle Beach recreation pages, read 2026-11-04 | curl |
+| raw/fnma-b7-3-03.html, .txt | Fannie Mae Selling Guide B7-3-03 (08/05/2026), read 2026-11-04 (row 21) | curl |
+| raw/clarke-freedman-2019.txt | Clarke and Freedman (2019), text of the full paper posted by the Minnesota Legislative Coordinating Commission (row 7). The 8 MB PDF stays out of the repo (scratch `wf2/hoa-benefits/`). | curl, pypdf |
+| raw/google-suggestions-2026-11-04.txt | Google suggestions for 51 seed queries | pull-suggestions.sh |
+
+Reused inputs: `../../2026-10-d/hoa-hoa-vs-poa/fees-by-type.json` and `has-with-fee.json` (typical fee, what it includes), `../hoa-tax-deductible/includes.json` (oceanfront inclusions), `../buyers-cost-to-own/ahs-2023-replacements.json` (roof cost), statutes in `../../2026-10-d/hoa-special-assessments/raw/`.
+
+Rerun, in order: `python3 -I pull_houses.py .` (about 280 calls), `python3 -I analyze_houses.py .`, `python3 -I pull_counts.py .`, `python3 -I pull_condo_fees.py .`, `python3 -I extract_prices.py .`, `python3 -I scdca_concerns.py . ../../2026-10-d/hoa-special-assessments/raw`, `python3 -I build_findings.py .`. Listing counts change daily; a rerun gives new numbers and the page must be rebuilt from them, not edited by hand.
+
+Note on the API: a search that matches nothing returns nearby homes with its filters dropped (a `closest` block). pull_houses.py skips those replies.
diff --git a/data/2026-11-a/hoa-benefits/analyze_houses.py b/data/2026-11-a/hoa-benefits/analyze_houses.py
new file mode 100644
index 00000000..686a0922
--- /dev/null
+++ b/data/2026-11-a/hoa-benefits/analyze_houses.py
@@ -0,0 +1,68 @@
+"""Do houses with an HOA fee list for more? Asking price per square foot and lot size, houses with a fee
+against houses with none, in the same ZIP code and of a similar age, from raw/houses-active.json (pull_houses.py).
+Groups: "with fee" = returned by the all-houses search and not by the no-fee search (hoaMax=0); "no fee" =
+returned by the no-fee search. Age: built 2000 or later (yearMin=2000 search) and built 2015 or later. Land: a fourth cut keeps
+houses built 2000 or later on lots of 0.10 to 0.30 acre, to compare houses on the same size of lot.
+Kept: list price $50,000 or more, 600 to 6,000 square feet. Lot acres: only pins with acres above 0.
+A ZIP is compared only when each group has at least MIN homes. The county line: the 15 Horry County ZIPs
+(as in ../buyers-cost-to-own/hoa-horry.json). Asking prices, not sale prices.
+Distance: the same houses (built 2000 or later) by straight-line distance band to the beach, county-wide and
+ZIP by band.
+Run: python3 -I analyze_houses.py <this dir>. Writes price-test.json."""
+import json, os, sys, statistics as st
+d = sys.argv[1]; MIN = 15
+raw = json.load(open(os.path.join(d, "raw", "houses-active.json")))
+HORRY = ["29511", "29526", "29527", "29544", "29566", "29568", "29569", "29572", "29575", "29576", "29577", "29579", "29581", "29582", "29588"]
+NAMES = {"29579": "Carolina Forest and Myrtle Beach west of the waterway", "29588": "Socastee", "29577": "Myrtle Beach (central and south)",
+         "29572": "Myrtle Beach (north end)", "29575": "Surfside Beach", "29576": "Murrells Inlet and Garden City", "29582": "North Myrtle Beach",
+         "29566": "Little River", "29568": "Longs", "29526": "Conway (29526)", "29527": "Conway (29527)", "29569": "Loris", "29544": "Galivants Ferry",
+         "29511": "Aynor", "29581": "Nichols"}
+homes = [h for h in raw["homes"] if h["in_all"] and h["price"] and h["price"] >= 50000 and h["sqft"] and 600 <= h["sqft"] <= 6000 and h["zip"] in HORRY]
+def summ(g):
+    if not g: return None
+    ppsf = [h["price"] / h["sqft"] for h in g]; ac = [h["acres"] for h in g if h["acres"] and h["acres"] > 0]
+    return {"n": len(g), "median_ppsf": round(st.median(ppsf)), "median_price": round(st.median([h["price"] for h in g]), -3),
+            "median_sqft": round(st.median([h["sqft"] for h in g])), "n_acres": len(ac), "median_acres": round(st.median(ac), 2) if ac else None}
+out = {"rule": __doc__, "pulled": raw["pulled"], "api_totals": raw["api_totals"], "truncated_bands": raw["truncated_bands"], "kept": len(homes), "cuts": {}}
+for cut, test in (("all ages", lambda h: True), ("built 2000 or later", lambda h: h["built_2000_plus"]), ("built 2015 or later", lambda h: h["built_2015_plus"]),
+                  ("built 2000 or later, lot 0.10 to 0.30 acre", lambda h: h["built_2000_plus"] and h["acres"] and 0.10 <= h["acres"] <= 0.30)):
+    sel = [h for h in homes if test(h)]
+    res = {"county": {"with_fee": summ([h for h in sel if not h["no_fee"]]), "no_fee": summ([h for h in sel if h["no_fee"]])}, "zips": []}
+    diffs = []
+    for z in HORRY:
+        w = [h for h in sel if h["zip"] == z and not h["no_fee"]]; n = [h for h in sel if h["zip"] == z and h["no_fee"]]
+        if len(w) >= MIN and len(n) >= MIN:
+            sw, sn = summ(w), summ(n)
+            pct = round(100 * (sw["median_ppsf"] - sn["median_ppsf"]) / sn["median_ppsf"], 1)
+            res["zips"].append({"zip": z, "name": NAMES.get(z, z), "with_fee": sw, "no_fee": sn, "ppsf_diff_pct": pct})
+            diffs.append(pct)
+    res["zips_compared"] = len(diffs)
+    res["zips_fee_higher"] = sum(1 for x in diffs if x > 0)
+    res["median_of_zip_diffs_pct"] = round(st.median(diffs), 1) if diffs else None
+    out["cuts"][cut] = res
+# Same distance from the beach: houses built 2000 or later, by straight-line band to the shore (pull_houses.py),
+# county-wide and then ZIP by band where both groups have MIN homes.
+BANDS = ["under 1 mile", "1 to 3 miles", "3 to 10 miles", "over 10 miles"]
+sel = [h for h in homes if h["built_2000_plus"] and h.get("beach_band")]
+bb = {"county_by_band": [], "zip_band": []}
+for b in BANDS:
+    w = [h for h in sel if h["beach_band"] == b and not h["no_fee"]]; n = [h for h in sel if h["beach_band"] == b and h["no_fee"]]
+    sw, sn = summ(w), summ(n)
+    bb["county_by_band"].append({"band": b, "with_fee": sw, "no_fee": sn, "share_with_fee_pct": round(100 * len(w) / (len(w) + len(n)), 1) if (w or n) else None,
+                                 "ppsf_diff_pct": round(100 * (sw["median_ppsf"] - sn["median_ppsf"]) / sn["median_ppsf"], 1) if sw and sn else None})
+    for z in HORRY:
+        wz = [h for h in w if h["zip"] == z]; nz = [h for h in n if h["zip"] == z]
+        if len(wz) >= MIN and len(nz) >= MIN:
+            a, c = summ(wz), summ(nz)
+            bb["zip_band"].append({"zip": z, "name": NAMES.get(z, z), "band": b, "with_fee": a, "no_fee": c, "ppsf_diff_pct": round(100 * (a["median_ppsf"] - c["median_ppsf"]) / c["median_ppsf"], 1)})
+bb["zip_band_compared"] = len(bb["zip_band"]); bb["zip_band_fee_higher"] = sum(1 for x in bb["zip_band"] if x["ppsf_diff_pct"] > 0)
+bb["median_of_zip_band_diffs_pct"] = round(st.median([x["ppsf_diff_pct"] for x in bb["zip_band"]]), 1) if bb["zip_band"] else None
+out["beach_bands_built_2000_plus"] = bb
+json.dump(out, open(os.path.join(d, "price-test.json"), "w"), indent=1)
+print("== by beach band, built 2000+")
+for r in bb["county_by_band"]: print("  ", r["band"], "fee", r["with_fee"] and (r["with_fee"]["n"], r["with_fee"]["median_ppsf"], r["with_fee"]["median_acres"], r["with_fee"]["median_sqft"]), "| none", r["no_fee"] and (r["no_fee"]["n"], r["no_fee"]["median_ppsf"], r["no_fee"]["median_acres"], r["no_fee"]["median_sqft"]), r["ppsf_diff_pct"], r["share_with_fee_pct"])
+for r in bb["zip_band"]: print("  ", r["zip"], r["band"], r["with_fee"]["n"], r["with_fee"]["median_ppsf"], "|", r["no_fee"]["n"], r["no_fee"]["median_ppsf"], r["ppsf_diff_pct"])
+print("zip-band compared", bb["zip_band_compared"], "fee higher", bb["zip_band_fee_higher"], "median", bb["median_of_zip_band_diffs_pct"])
+for cut, r in out["cuts"].items():
+    print("==", cut, r["county"], "zips", r["zips_compared"], "fee higher in", r["zips_fee_higher"], "median diff", r["median_of_zip_diffs_pct"])
+    for z in r["zips"]: print("  ", z["zip"], z["name"], "fee", z["with_fee"]["n"], z["with_fee"]["median_ppsf"], z["with_fee"]["median_acres"], "| none", z["no_fee"]["n"], z["no_fee"]["median_ppsf"], z["no_fee"]["median_acres"], "|", z["ppsf_diff_pct"])
diff --git a/data/2026-11-a/hoa-benefits/build_findings.py b/data/2026-11-a/hoa-benefits/build_findings.py
new file mode 100644
index 00000000..6fc5a6fa
--- /dev/null
+++ b/data/2026-11-a/hoa-benefits/build_findings.py
@@ -0,0 +1,55 @@
+"""Every derived number for /hoa/benefits/, and the chart and table files the spec reads. Nothing is typed:
+each value comes from a pulled file here or a sibling's file named below.
+Inputs: counts.json, price-test.json, condo-fees.json, prices.json, scdca-concerns.json (this folder);
+../../2026-10-d/hoa-hoa-vs-poa/fees-by-type.json and has-with-fee.json (typical fee and what it includes, 2026-11-01).
+Run: python3 -I build_findings.py <this dir>. Writes findings.json and chart-*.json."""
+import json, os, sys
+d = sys.argv[1]; J = lambda *p: json.load(open(os.path.join(d, *p)))
+counts, pt, cf, pr, sc = J("counts.json"), J("price-test.json"), J("condo-fees.json"), J("prices.json"), J("scdca-concerns.json")
+sib = os.path.join(d, "..", "..", "2026-10-d", "hoa-hoa-vs-poa")
+fees = json.load(open(os.path.join(sib, "fees-by-type.json"))); has = json.load(open(os.path.join(sib, "has-with-fee.json")))
+F = {"made": "build_findings.py", "inputs": ["counts.json", "price-test.json", "condo-fees.json", "prices.json", "scdca-concerns.json",
+     "../../2026-10-d/hoa-hoa-vs-poa/fees-by-type.json", "../../2026-10-d/hoa-hoa-vs-poa/has-with-fee.json"]}
+# 1. Typical fee by kind of home (sibling, 2026-11-01) and condo oceanfront split (this pull, 2026-11-04)
+F["typical_fee"] = {t: {"median_month": fees["types"][t]["median_fee_5"]["median_at_or_below"], "with_fee": fees["types"][t]["with_fee"],
+                        "year": 12 * fees["types"][t]["median_fee_5"]["median_at_or_below"]} for t in ("condo", "townhouse", "house")}
+F["condo_split"] = {g: {k: v for k, v in x.items() if k != "cdf"} | {"year": 12 * x["median_fee_5"]} for g, x in cf["groups"].items()}
+# 2. What the fee includes, share of homes with a fee (sibling)
+KEYS = [("hoa_includes_insurance", "Insurance"), ("hoa_includes_water_sewer", "Water and sewer"), ("hoa_includes_trash", "Trash pickup"),
+        ("lawn_care_included", "Lawn care"), ("hoa_includes_internet", "Internet"), ("community_amenities", "Amenities (pool, clubhouse and the like)"), ("gated", "A gate")]
+F["includes"] = {"pulled": has["pulled"], "rows": [{"key": k, "label": l, **{t: round(has["types"][t]["has"][k]["pct_of_with_fee"]) for t in ("condo", "townhouse", "house")}} for k, l in KEYS],
+                 "with_fee": {t: has["types"][t]["with_fee"] for t in ("condo", "townhouse", "house")}}
+# 3. Houses: share with a fee, by year built; amenities among houses with a fee
+F["by_year"] = counts["by_year"]; F["house_counts"] = {k: counts[k] for k in ("house_total", "house_no_fee", "house_with_fee")}
+F["house_features"] = counts["features_with_fee"]
+since2010 = [r for r in counts["by_year"] if r["yearMin"] and r["yearMin"] >= 2010]
+F["built_2010_plus"] = {"houses": sum(r["houses"] for r in since2010), "with_fee": sum(r["with_fee"] for r in since2010)}
+F["built_2010_plus"]["pct_with_fee"] = round(100 * F["built_2010_plus"]["with_fee"] / F["built_2010_plus"]["houses"], 1)
+# 4. Price test
+F["price_test"] = {"pulled": pt["pulled"], "built_2000_plus_county": pt["cuts"]["built 2000 or later"]["county"],
+                   "all_ages_zips": {k: pt["cuts"]["all ages"][k] for k in ("zips_compared", "zips_fee_higher", "median_of_zip_diffs_pct")},
+                   "built_2000_zips": {k: pt["cuts"]["built 2000 or later"][k] for k in ("zips_compared", "zips_fee_higher", "median_of_zip_diffs_pct")},
+                   "beach_bands": pt["beach_bands_built_2000_plus"]["county_by_band"],
+                   "zip_band": {k: pt["beach_bands_built_2000_plus"][k] for k in ("zip_band_compared", "zip_band_fee_higher", "median_of_zip_band_diffs_pct")}}
+# 5. The house fee against a public pool and gym
+house_year = F["typical_fee"]["house"]["year"]; n = pr["nmb_aquatic_fitness"]; m = pr["myrtle_beach_rec"]["annual"]
+F["fee_vs_pool"] = {"house_fee_year": house_year, "house_fee_month": F["typical_fee"]["house"]["median_month"],
+    "options": [{"label": "Myrtle Beach recreation center, one adult, city resident", "year": m["Adult (18-54)"]["city_resident"], "source": pr["myrtle_beach_rec"]["url"]},
+                {"label": "Myrtle Beach recreation center, one adult, not a city resident", "year": m["Adult (18-54)"]["non_city_resident"], "source": pr["myrtle_beach_rec"]["url"]},
+                {"label": "North Myrtle Beach Aquatic and Fitness Center, one adult", "year": n["individual"]["annual_paid_in_full"], "joining_fee": n["individual"]["joining_fee"], "source": n["url"]},
+                {"label": "North Myrtle Beach Aquatic and Fitness Center, a couple", "year": n["couple"]["annual_paid_in_full"], "joining_fee": n["couple"]["joining_fee"], "source": n["url"]}]}
+# 6. Complaints (merge the one label the state spells two ways)
+c = dict(sc["total"]["concerns"]); q = "Request to access information/ view documents ignored"
+c[q] = c.get(q, 0) + c.pop(q + "?", 0); tot = sc["total"]["horry_complaints"]
+F["complaints"] = {"horry_complaints": tot, "reports": list(sc["years"].keys()),
+                   "top": [{"concern": k, "count": v, "pct": round(100 * v / tot, 1)} for k, v in sorted(c.items(), key=lambda x: -x[1]) if k != "Other"][:8]}
+json.dump(F, open(os.path.join(d, "findings.json"), "w"), indent=1)
+json.dump({"title": "Share of houses for sale with an HOA fee, by year built", "rows": [{"label": r["band"], "pct": r["pct_with_fee"], "houses": r["houses"]} for r in counts["by_year"]], "source": "counts.json"}, open(os.path.join(d, "chart-hoa-by-year-built.json"), "w"), indent=1)
+json.dump({"title": "Asking price per square foot, houses built 2000 or later, with and without an HOA fee, by distance from the beach",
+           "rows": [{"band": r["band"], "with_fee": r["with_fee"]["median_ppsf"], "no_fee": r["no_fee"]["median_ppsf"], "n_with": r["with_fee"]["n"], "n_none": r["no_fee"]["n"],
+                     "acres_with": r["with_fee"]["median_acres"], "acres_none": r["no_fee"]["median_acres"], "diff_pct": r["ppsf_diff_pct"], "share_with_fee_pct": r["share_with_fee_pct"]} for r in F["price_test"]["beach_bands"]], "source": "price-test.json"},
+          open(os.path.join(d, "chart-price-by-beach.json"), "w"), indent=1)
+json.dump({"title": "What Horry County owners complained to the state about", "complaints": tot, "rows": F["complaints"]["top"], "source": "scdca-concerns.json"}, open(os.path.join(d, "chart-complaints.json"), "w"), indent=1)
+json.dump({"title": "A year of the typical house fee against a year at a public pool and gym", "rows": [{"label": "The typical house HOA fee", "year": house_year}] + F["fee_vs_pool"]["options"], "source": "findings.json"}, open(os.path.join(d, "chart-fee-vs-pool.json"), "w"), indent=1)
+print(json.dumps({k: F[k] for k in ("typical_fee", "condo_split", "built_2010_plus", "fee_vs_pool", "complaints")}, indent=1))
+print(json.dumps(F["includes"], indent=1)); print(json.dumps(F["price_test"]["zip_band"]), json.dumps(F["price_test"]["built_2000_zips"]), json.dumps(F["price_test"]["all_ages_zips"]))
