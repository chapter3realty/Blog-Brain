+    gpull("GCGIS_Export", 0, "g-addr.geojson", "TMS,Zip_Code,Zip_Comm,Inc_Muni,Add_Type,Status,UNIT,St_Full")
+    gpull("GCGIS_Nature", 9, "g-flood.geojson", "FLD_ZONE,ZONE_SUBTY,STATIC_BFE,SFHA_TF")
