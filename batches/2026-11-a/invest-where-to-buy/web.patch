each","url":"https://chapter3realty.com/invest/where-to-buy/#myrtle-beach"},{"@type":"ListItem","position":7,"name":"Longs","url":"https://chapter3realty.com/invest/where-to-buy/#longs"},{"@type":"ListItem","position":8,"name":"Socastee","url":"https://chapter3realty.com/invest/where-to-buy/#socastee"},{"@type":"ListItem","position":9,"name":"Conway","url":"https://chapter3realty.com/invest/where-to-buy/#conway"},{"@type":"ListItem","position":10,"name":"Little River","url":"https://chapter3realty.com/invest/where-to-buy/#little-river"},{"@type":"ListItem","position":11,"name":"Carolina Forest","url":"https://chapter3realty.com/invest/where-to-buy/#carolina-forest"}]}</script></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Send your budget and your plan.</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">The request we hear most from investors is for homes with the numbers to back them up. Tell us your budget and how you will rent. We send back homes for sale in the areas that fit, with the rent, the rental-rate tax, the HOA fee and the nightly rule checked.</p><a class="btn btn-brass btn-lg" href="/contact/">Send my budget</a></div></section></main>
