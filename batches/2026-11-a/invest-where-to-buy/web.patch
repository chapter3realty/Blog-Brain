diff --git a/data/2026-11-a/invest-where-to-buy/fetch_areas.py b/data/2026-11-a/invest-where-to-buy/fetch_areas.py
new file mode 100644
index 00000000..5f9c02fa
--- /dev/null
+++ b/data/2026-11-a/invest-where-to-buy/fetch_areas.py
@@ -0,0 +1,30 @@
+"""Census TIGERweb polygons for the areas on /invest/where-to-buy/: incorporated places (layer 4) and CDPs (layer 5)
+in Horry and Georgetown counties, ZIP code tabulation areas (PUMA_TAD_TAZ_UGA_ZCTA layer 1 or 2), and the two county outlines.
+Run: python3 -I fetch_areas.py <datadir>. Writes raw/places.json, raw/counties.json, raw/zctas.json."""
+import sys, json, os, time, urllib.request, urllib.parse
+D = sys.argv[1]; RAW = os.path.join(D, "raw"); os.makedirs(RAW, exist_ok=True)
+def post(url, params):
+    data = urllib.parse.urlencode(params).encode()
+    for i in range(5):
+        try:
+            r = json.loads(urllib.request.urlopen(urllib.request.Request(url, data=data), timeout=180).read())
+            if "error" in r: raise Exception(r["error"])
+            return r
+        except Exception as e: print("retry", e, file=sys.stderr); time.sleep(5)
+    raise SystemExit("failed " + url)
+BOX = {"geometry": "-79.45,33.25,-78.5,34.25", "geometryType": "esriGeometryEnvelope", "inSR": "4326", "spatialRel": "esriSpatialRelIntersects",
+       "returnGeometry": "true", "outSR": "4326", "f": "json"}
+T = "https://tigerweb.geo.census.gov/arcgis/rest/services/TIGERweb"
+out = []
+for layer in (4, 5):
+    r = post(f"{T}/Places_CouSub_ConCity_SubMCD/MapServer/{layer}/query", dict(BOX, where="STATE='45'", outFields="NAME,BASENAME,LSADC,GEOID"))
+    out += [{"name": f["attributes"]["NAME"], "geoid": f["attributes"]["GEOID"], "layer": layer, "rings": f["geometry"]["rings"]} for f in r["features"]]
+json.dump({"source": f"{T}/Places_CouSub_ConCity_SubMCD/MapServer/4 and /5 (current vintage)", "read": time.strftime("%Y-%m-%d"), "places": out}, open(os.path.join(RAW, "places.json"), "w"))
+print(sorted(o["name"] for o in out))
+r = post(f"{T}/State_County/MapServer/1/query", {"where": "STATE='45' AND COUNTY IN ('051','043')", "outFields": "NAME,GEOID", "returnGeometry": "true", "outSR": "4326", "f": "json", "maxAllowableOffset": "0.0005"})
+json.dump({"source": f"{T}/State_County/MapServer/1", "read": time.strftime("%Y-%m-%d"), "counties": [{"name": f["attributes"]["NAME"], "geoid": f["attributes"]["GEOID"], "rings": f["geometry"]["rings"]} for f in r["features"]]}, open(os.path.join(RAW, "counties.json"), "w"))
+print([f["attributes"]["NAME"] for f in r["features"]])
+Z = ["29511","29526","29527","29528","29544","29545","29566","29568","29569","29572","29575","29576","29577","29579","29581","29582","29588","29585","29440"]
+r = post(f"{T}/PUMA_TAD_TAZ_UGA_ZCTA/MapServer/1/query", {"where": "ZCTA5 IN (" + ",".join("'%s'" % z for z in Z) + ")", "outFields": "ZCTA5,GEOID", "returnGeometry": "true", "outSR": "4326", "f": "json", "maxAllowableOffset": "0.0003"})
+json.dump({"source": f"{T}/PUMA_TAD_TAZ_UGA_ZCTA/MapServer/1", "read": time.strftime("%Y-%m-%d"), "zctas": [{"zcta": f["attributes"]["ZCTA5"], "rings": f["geometry"]["rings"]} for f in r["features"]]}, open(os.path.join(RAW, "zctas.json"), "w"))
+print(sorted(f["attributes"]["ZCTA5"] for f in r["features"]))
diff --git a/data/2026-11-a/invest-where-to-buy/fetch_flood.py b/data/2026-11-a/invest-where-to-buy/fetch_flood.py
new file mode 100644
index 00000000..9a882fd5
--- /dev/null
+++ b/data/2026-11-a/invest-where-to-buy/fetch_flood.py
@@ -0,0 +1,22 @@
+"""Horry County GIS layer 19 (FEMA flood zones): every special flood hazard area polygon (SFHA_TF = 'T': zones A, AE, AO, VE),
+county-wide, in WGS84, lightly generalised (maxAllowableOffset 0.00001 degrees, about 1 m).
+Run: RAW=<scratch> python3 -I fetch_flood.py. Writes RAW/horry-sfha.json (kept out of the repo for size)."""
+import json, os, sys, time, urllib.request, urllib.parse
+RAW = os.environ["RAW"]
+Q = "https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer/19/query"
+def q(params):
+    data = urllib.parse.urlencode(dict(params, f="json")).encode()
+    for i in range(6):
+        try:
+            d = json.loads(urllib.request.urlopen(urllib.request.Request(Q, data=data), timeout=300).read())
+            if "error" in d: raise Exception(d["error"])
+            return d
+        except Exception as e: print("retry", e, file=sys.stderr); time.sleep(5)
+    raise SystemExit("failed")
+ids = sorted(q({"where": "SFHA_TF='T'", "returnIdsOnly": "true"})["objectIds"]); feats = []
+for i in range(0, len(ids), 50):
+    d = q({"objectIds": ",".join(map(str, ids[i:i+50])), "outFields": "FLD_ZONE,SFHA_TF,STATIC_BFE", "returnGeometry": "true", "outSR": "4326", "maxAllowableOffset": "0.00001"})
+    feats += [{"a": f["attributes"], "rings": f["geometry"]["rings"]} for f in d["features"] if f.get("geometry")]
+    print(i, len(feats), flush=True)
+json.dump({"source": Q, "where": "SFHA_TF='T'", "pulled": time.strftime("%Y-%m-%d"), "features": feats}, open(os.path.join(RAW, "horry-sfha.json"), "w"))
+print("done", len(feats))
diff --git a/data/2026-11-a/invest-where-to-buy/fetch_georgetown.py b/data/2026-11-a/invest-where-to-buy/fetch_georgetown.py
new file mode 100644
index 00000000..31474a8f
--- /dev/null
+++ b/data/2026-11-a/invest-where-to-buy/fetch_georgetown.py
@@ -0,0 +1,39 @@
+"""Georgetown County parcels (GIS open data, GCGIS_Export layer 2) and the county's FEMA flood zones (GCGIS_Nature layer 9)
+for the Waccamaw Neck: Garden City's south end, Murrells Inlet, Litchfield and Pawleys Island.
+Parcels keep TMS, LandUseCode (first letter Q = legal residence, taxed at 4 percent), mailing State, SaleDate, SalePrice,
+LegalDescription and a representative point. No owner name or street is kept.
+Run: RAW=<scratch> python3 -I fetch_georgetown.py. Writes RAW/gt-homes.json and RAW/gt-flood.geojson (kept out of the repo)."""
+import json, os, sys, time, urllib.parse, urllib.request
+from shapely.geometry import shape
+RAW = os.environ["RAW"]
+B = "https://gis1.georgetowncountysc.org/portal/rest/services"
+ENV = "-79.25,33.36,-78.98,33.62"
+def get(url, params):
+    for i in range(6):
+        try:
+            with urllib.request.urlopen(urllib.request.Request(url, data=urllib.parse.urlencode(params).encode()), timeout=180) as r:
+                return json.load(r)
+        except Exception as e:
+            print("retry", i, e, file=sys.stderr); time.sleep(4 + 3 * i)
+    raise SystemExit("failed " + url)
+def pull(layer, fields, where="1=1"):
+    feats, off = [], 0
+    while True:
+        d = get(f"{B}/{layer}/query", {"where": where, "outFields": fields, "returnGeometry": "true", "outSR": 4326, "f": "geojson",
+                "resultOffset": off, "resultRecordCount": 2000, "geometryPrecision": 6, "geometry": ENV, "geometryType": "esriGeometryEnvelope",
+                "inSR": 4326, "spatialRel": "esriSpatialRelIntersects"})
+        fs = d.get("features", []); feats += fs; print(layer, off, len(fs), flush=True)
+        if len(fs) < 2000 and not d.get("exceededTransferLimit") and not d.get("properties", {}).get("exceededTransferLimit"): break
+        off += len(fs)
+        if not fs: break
+    return feats
+rows = []
+for f in pull("GCGIS_Export/FeatureServer/2", "TMS,LandUseCode,State,SaleDate,SalePrice,LegalDescription"):
+    if not f.get("geometry"): continue
+    p = f["properties"]; pt = shape(f["geometry"]).representative_point()
+    rows.append([p["TMS"], p["LandUseCode"], (p["State"] or "").strip().upper(), p["SaleDate"], p["SalePrice"], p["LegalDescription"], round(pt.x, 6), round(pt.y, 6)])
+json.dump({"source": B + "/GCGIS_Export/FeatureServer/2", "env": ENV, "pulled": time.strftime("%Y-%m-%d"), "cols": ["TMS", "LandUseCode", "State", "SaleDate", "SalePrice", "LegalDescription", "x", "y"], "rows": rows},
+          open(os.path.join(RAW, "gt-homes.json"), "w"))
+print("parcels", len(rows))
+fl = pull("GCGIS_Nature/FeatureServer/9", "FLD_ZONE,SFHA_TF,ZONE_SUBTY")
+json.dump({"type": "FeatureCollection", "features": fl}, open(os.path.join(RAW, "gt-flood.geojson"), "w")); print("flood", len(fl))
diff --git a/data/2026-11-a/invest-where-to-buy/fetch_parcels.py b/data/2026-11-a/invest-where-to-buy/fetch_parcels.py
new file mode 100644
index 00000000..1bb0947b
--- /dev/null
+++ b/data/2026-11-a/invest-where-to-buy/fetch_parcels.py
@@ -0,0 +1,32 @@
+"""Every Horry County home parcel with a building (GIS layer 24, LandUseCode 1xx, MarketImprv > 0), county-wide.
+Keeps PIN, LandUseCode, TaxDistrict, AssessedProp, TaxableProp, MarketProp, OwnerState, SaleDate, the HPR (condo regime)
+flag from the legal description, and the parcel's centroid. No owner name, street or city is kept.
+Assessment class: AssessedProp / TaxableProp about 0.04 = legal residence (4%), about 0.06 = every other home (6%).
+Run: RAW=<scratch> python3 -I fetch_parcels.py. Writes RAW/horry-homes.json (kept out of the repo; it has PINs)."""
+import json, os, sys, time, urllib.request, urllib.parse
+RAW = os.environ["RAW"]
+Q = "https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer/24/query"
+def q(params):
+    data = urllib.parse.urlencode(dict(params, f="json")).encode()
+    for i in range(8):
+        try:
+            d = json.loads(urllib.request.urlopen(urllib.request.Request(Q, data=data), timeout=300).read())
+            if "error" in d: raise Exception(d["error"])
+            return d
+        except Exception as e:
+            print("retry", e, file=sys.stderr); time.sleep(5 + 3 * i)
+    raise SystemExit("failed")
+W = "LandUseCode LIKE '1%' AND MarketImprv > 0"
+ids = sorted(q({"where": W, "returnIdsOnly": "true"})["objectIds"]); print("ids", len(ids), flush=True)
+rows = []
+F = "PIN,LandUseCode,TaxDistrict,AssessedProp,TaxableProp,MarketProp,OwnerState,SaleDate,LegalDescr"
+for i in range(0, len(ids), 1000):
+    d = q({"objectIds": ",".join(map(str, ids[i:i+1000])), "outFields": F, "returnGeometry": "false", "returnCentroid": "true", "outSR": "4326"})
+    for f in d["features"]:
+        a = f["attributes"]; c = f.get("centroid") or {}
+        rows.append([a["PIN"], a["LandUseCode"], a["TaxDistrict"], a["AssessedProp"], a["TaxableProp"], a["MarketProp"], a["OwnerState"], a["SaleDate"],
+                     1 if "HPR" in (a["LegalDescr"] or "") else 0, round(c.get("x", 0), 6), round(c.get("y", 0), 6)])
+    if i % 20000 == 0: print(i, len(rows), flush=True)
+json.dump({"source": Q, "where": W, "pulled": time.strftime("%Y-%m-%d"), "cols": ["PIN", "LandUseCode", "TaxDistrict", "AssessedProp", "TaxableProp", "MarketProp", "OwnerState", "SaleDate", "HPR", "x", "y"], "rows": rows},
+          open(os.path.join(RAW, "horry-homes.json"), "w"))
+print("done", len(rows))
diff --git a/data/2026-11-a/invest-where-to-buy/fetch_points.py b/data/2026-11-a/invest-where-to-buy/fetch_points.py
new file mode 100644
index 00000000..98e4a093
--- /dev/null
+++ b/data/2026-11-a/invest-where-to-buy/fetch_points.py
@@ -0,0 +1,26 @@
+"""Centre points for every Horry home parcel in RAW/horry-homes.json (layer 24 returned no centroid).
+Asks layer 24 for each parcel's outline, generalised to about 30 m (maxAllowableOffset 0.0003), and keeps the mean of the
+first ring's vertices. Run: RAW=<scratch> python3 -I fetch_points.py. Writes RAW/horry-points.json {PIN: [lon, lat]}."""
+import json, os, sys, time, urllib.request, urllib.parse
+RAW = os.environ["RAW"]
+Q = "https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer/24/query"
+def q(params):
+    data = urllib.parse.urlencode(dict(params, f="json")).encode()
+    for i in range(8):
+        try:
+            d = json.loads(urllib.request.urlopen(urllib.request.Request(Q, data=data), timeout=300).read())
+            if "error" in d: raise Exception(d["error"])
+            return d
+        except Exception as e: print("retry", e, file=sys.stderr); time.sleep(5 + 3 * i)
+    raise SystemExit("failed")
+W = "LandUseCode LIKE '1%' AND MarketImprv > 0"
+ids = sorted(q({"where": W, "returnIdsOnly": "true"})["objectIds"]); pts = {}
+for i in range(0, len(ids), 1000):
+    d = q({"objectIds": ",".join(map(str, ids[i:i+1000])), "outFields": "PIN", "returnGeometry": "true", "outSR": "4326", "maxAllowableOffset": "0.0003", "geometryPrecision": "6"})
+    for f in d["features"]:
+        rings = (f.get("geometry") or {}).get("rings") or []
+        if not rings: continue
+        r = rings[0][:-1] or rings[0]
+        pts[str(f["attributes"]["PIN"])] = [round(sum(p[0] for p in r) / len(r), 6), round(sum(p[1] for p in r) / len(r), 6)]
+    if i % 20000 == 0: print(i, len(pts), flush=True)
+json.dump(pts, open(os.path.join(RAW, "horry-points.json"), "w")); print("done", len(pts))
