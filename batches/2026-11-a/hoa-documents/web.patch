@@ -0,0 +1,19 @@
+# Data for /hoa/documents/ (batch 2026-11-a)
+
+Every number on the page comes from these files. Ledger: Blog-Brain `batches/2026-11-a/hoa-documents/facts.md`.
+
+| File | What | Made by |
+|---|---|---|
+| raw/recorded-months-170-213.json, raw/recorded-months-166.json | Monthly totals of Horry County Register of Deeds index rows, 2012-01 to 2026-10: RESTRICTIONS (082), MASTER DEED (022), AMENDMENT DEED BOOK (069). Totals only. | pull_recorded.py |
+| recorded-by-year.json | Association papers recorded, by year and kind (rules and policies, amendments, declarations, bylaws), January counts, the last 12 months, and amendments to master deeds and declarations (ledger rows 29, 30, 30a). Counts only, no names. | analyze_recorded.py (reads the monthly index pulls; RAW stays out of the repo because rows carry party names) |
+| scdca-documents.json | Horry County HOA complaints to SC Consumer Affairs, 2022 to 2025: documents before or after purchase, denied access, when and by whom the owner was told of the association (rows 31 to 33) | scdca_documents.py (reads the workbooks in ../../2026-10-d/hoa-special-assessments/raw/) |
+| listings-counts.json | Active listings in the CRM feed with and without an association fee, by type, with each query (row 1) | pull_listings.py |
+| chart-recorded.json, chart-scdca.json, chart-states.json | Chart and table rows for the page, built from the files above and the ledger | build_charts.py |
+| raw/google-suggestions-2026-11-04.txt | Google suggestions for the must-answer list | pull-suggestions.sh |
+| raw/acclaim-no-images-2026-11-04.txt | The county's reply to an online document image request (row 13) | curl |
+| raw/rod-register-of-deeds.*, raw/rod-request-form.* | The Register of Deeds page (hours, address) and its copy request form (fees, index since 1984) (rows 14 to 16) | curl, pdftotext |
+| raw/va-55.1-2308.*, va-55.1-2310.*, va-55.1-2312.*, va-55.1-2316.*, md-11b-106.*, fl-720.401.*, nc-47c-4-109.* | Other states' statutes (rows 24 to 27) | curl |
+
+South Carolina statutes, the disclosure addendum, the Fannie Mae guide pages and bill H. 5204 were saved the same week by sibling pages; rows quote them from `../hoa-liens-and-foreclosure/raw/` and `../../2026-10-d/hoa-special-assessments/raw/`.
+
+Rerun: `RAW=<scratch dir> python3 -I pull_recorded.py . 2012-01 2026-10` and `... 166`, then `RAW=<same> python3 -I analyze_recorded.py .`; `python3 scdca_documents.py . ../../2026-10-d/hoa-special-assessments/raw` (needs openpyxl); `python3 -I pull_listings.py .`; `python3 -I build_charts.py .`. Listing counts change daily and the county index grows; a rerun gives new numbers, and the page must be rebuilt from them, not edited by hand.
diff --git a/data/2026-11-a/hoa-documents/analyze_recorded.py b/data/2026-11-a/hoa-documents/analyze_recorded.py
new file mode 100644
index 00000000..c6bedeaf
--- /dev/null
+++ b/data/2026-11-a/hoa-documents/analyze_recorded.py
@@ -0,0 +1,58 @@
+"""Count association papers recorded at the Horry County Register of Deeds, from the index rows pulled by pull_recorded.py.
+A RESTRICTIONS (082) row counts as an association paper when a party name is an association (ASSOC, REGIME, HPR,
+HORIZONTAL, COUNCIL OF CO-OWNERS, CONDO, OWNERS, POA, HOA, COMMUNITY, MASTER, CLUB) or the index description names an
+association paper (rules, regulations, bylaws, declaration, policy, guidelines, fines, amendment, supplement).
+Stormwater maintenance agreements, county and housing-program covenants and plain lot covenants filed by a person or
+a business with no association paper word are left out. Each kept row gets one kind from its description:
+rules and policies, bylaws, amendment, declaration. AMENDMENT DEED BOOK (069) rows are counted when the description
+says MASTER DEED or DECLARATION (an amendment to a condo master deed or an HOA declaration).
+Usage: RAW=<dir with the monthly pulls> python3 -I analyze_recorded.py <outdir>
+Writes <outdir>/recorded-by-year.json (counts only, no names)."""
+import sys, os, re, json, glob, collections
+out = sys.argv[1]; RAW = os.environ["RAW"]
+ASSOC = re.compile(r"ASSOC|REGIME|\bHPR\b|HORIZONTAL|COUNCIL OF CO|CONDO|OWNERS|\bPOA\b|\bHOA\b|COMMUNITY|MASTER|\bCLUB\b", re.I)
+PAPER = re.compile(r"RULE|REGULATION|BY ?-?LAW|DECLARATION|POLIC|GUIDELINE|FINE|AMEND|SUPPLEMENT|HOA ACT|COLLECTION|ARCHITECTURAL|DESIGN REVIEW", re.I)
+EXCL = re.compile(r"STORMWATER|AGREEMENT AS TO RESTRICTIVE|AGREEMENT AS TO RESTRICTIVE CONVENANT|LAND USE RESTRICTIVE|OWNER OCCUPIED HOUSING|DEED RESTRICTION AGREEMENT|RESTRICTIVE USE COVENANT|CONSERVATION", re.I)
+def kind(c):
+    c = c.upper()
+    if re.search(r"AMEND|RESTATE", c): return "amendment"
+    if re.search(r"BY ?-?LAW", c): return "bylaws"
+    if re.search(r"RULE|REGULATION|POLIC|GUIDELINE|FINE|HOA ACT|COLLECTION|ARCHITECTURAL|DESIGN REVIEW", c): return "rules and policies"
+    return "declaration"
+years = collections.defaultdict(lambda: collections.Counter()); months = collections.Counter(); jan = collections.Counter()
+last12 = collections.Counter(); assoc12 = set(); words12 = collections.Counter()
+WORDS = {"rent or lease": r"RENT|LEAS", "short-term": r"SHORT ?-?TERM", "pet": r"\bPETS?\b", "parking": r"PARKING", "fine": r"\bFINES?\b", "collection or delinquency": r"COLLECTION|DELINQUEN", "architectural": r"ARCHITECT|DESIGN"}; excluded = collections.Counter(); dm = collections.Counter()
+for f in sorted(glob.glob(os.path.join(RAW, "restrictions-*.json"))):
+    ym = f[-12:-5]; y, m = int(ym[:4]), int(ym[5:])
+    for r in json.load(open(f))["Data"]:
+        c = (r.get("Comments") or "").strip(); names = (r.get("DirectName") or "") + " | " + (r.get("IndirectName") or "")
+        if EXCL.search(c): excluded["excluded by description"] += 1; continue
+        if not (ASSOC.search(names) or PAPER.search(c)): excluded["no association name or paper word"] += 1; continue
+        k = kind(c); years[y][k] += 1; years[y]["all"] += 1; months[ym] += 1
+        if m == 1: jan[y] += 1
+        if "2025-11" <= ym <= "2026-10":
+            last12[k] += 1; last12["all"] += 1
+            for w, rx in WORDS.items():
+                if re.search(rx, c.upper()): words12[w] += 1
+            if ASSOC.search(r.get("DirectName") or ""): assoc12.add(re.sub(r"[^A-Z0-9]", "", (r.get("DirectName") or "").upper()))
+for f in sorted(glob.glob(os.path.join(RAW, "amendment-deed-book-*.json"))):
+    ym = f[-12:-5]; y = int(ym[:4])
+    for r in json.load(open(f))["Data"]:
+        c = (r.get("Comments") or "").upper()
+        if re.search(r"MASTER DEED|DECLARATION", c):
+            dm[y] += 1
+            if "2025-11" <= ym <= "2026-10": last12["amendment (amendment deed book)"] += 1
+res = {"source": "https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeDocType (RESTRICTIONS 082; AMENDMENT DEED BOOK 069)",
+       "method": __doc__.split("Usage")[0].strip(),
+       "by_year": {y: dict(years[y]) for y in sorted(years)},
+       "january_by_year": {y: jan[y] for y in sorted(years)},
+       "january_share_pct": {y: round(100 * jan[y] / years[y]["all"], 1) for y in sorted(years) if years[y]["all"]},
+       "amendment_deed_book_master_deed_or_declaration_by_year": {y: dm[y] for y in sorted(dm)},
+       "last_12_months_2025-11_to_2026-10": dict(last12),
+       "distinct_association_filers_last_12_months": len(assoc12),
+       "description_words_last_12_months (index description only; most descriptions name no subject)": dict(words12),
+       "excluded_rows": dict(excluded),
+       "by_month": dict(sorted(months.items()))}
+json.dump(res, open(os.path.join(out, "recorded-by-year.json"), "w"), indent=1)
+for y in sorted(years): print(y, dict(years[y]), "jan", jan[y], "dm", dm[y])
+print("last12", dict(last12), "filers", len(assoc12), "words", dict(words12)); print("excluded", dict(excluded))
diff --git a/data/2026-11-a/hoa-documents/build_charts.py b/data/2026-11-a/hoa-documents/build_charts.py
new file mode 100644
index 00000000..9e159a46
--- /dev/null
+++ b/data/2026-11-a/hoa-documents/build_charts.py
@@ -0,0 +1,31 @@
+"""Chart rows for /hoa/documents/, built only from the data files in this folder.
+Usage: python3 -I build_charts.py <this dir>. Writes chart-recorded.json, chart-scdca.json, chart-states.json."""
+import sys, json, os
+d = sys.argv[1]
+r = json.load(open(os.path.join(d, "recorded-by-year.json")))
+rows = [{"year": int(y), "rules_and_policies": v.get("rules and policies", 0), "amendments": v.get("amendment", 0),
+         "declarations": v.get("declaration", 0), "bylaws": v.get("bylaws", 0), "all": v["all"],
+         "january": r["january_by_year"][y], "partial": y == "2026"} for y, v in r["by_year"].items()]
+json.dump({"title": "Association papers filed at the Horry County Register of Deeds, by year (our count of the county index)",
+           "note": "RESTRICTIONS (082) rows kept by analyze_recorded.py. 2026 runs to October. January 10 is the yearly recording deadline for rules (SC Code 27-30-130).",
+           "source": r["source"], "rows": rows,
+           "last_12_months": r["last_12_months_2025-11_to_2026-10"],
+           "filers_last_12_months": r["distinct_association_filers_last_12_months"],
+           "months_2018_2019": {k: v for k, v in r["by_month"].items() if "2018-06" <= k <= "2019-06"}},
+          open(os.path.join(d, "chart-recorded.json"), "w"), indent=1)
+s = json.load(open(os.path.join(d, "scdca-documents.json")))["four_years_horry"]
+json.dump({"title": "Horry County owners who complained to the state about an HOA, 2022 to 2025",
+           "source": "https://www.consumer.sc.gov/HOA-reports",
+           "told_of_association": {k: s["when"].get(k, 0) for k in ("Before Closing", "At Closing", "After Closing")},
+           "got_documents": {"Before purchase": s["docs"]["Before"], "After purchase": s["docs"]["After"]},
+           "denied_access": {"Yes": s["denied"]["Yes"], "No": s["denied"]["No"]},
+           "complaints": s["complaints"]}, open(os.path.join(d, "chart-scdca.json"), "w"), indent=1)
+states = [
+  {"state": "South Carolina", "packet_by_law": "No", "deadline": "None", "cancel_right": "None tied to the HOA papers", "fee_cap": "None", "rows": "3, 4, 6"},
+  {"state": "Virginia", "packet_by_law": "Yes, resale certificate", "deadline": "", "cancel_right": "3 days after receipt if the contract sets none; any time before settlement if it never arrives", "fee_cap": "", "rows": "24"},
+  {"state": "Maryland", "packet_by_law": "Yes, HOA disclosures", "deadline": "By 20 calendar days after the contract", "cancel_right": "5 calendar days after receipt, if received late", "fee_cap": "Up to $250", "rows": "25"},
+  {"state": "Florida (HOA)", "packet_by_law": "Disclosure summary before the contract", "deadline": "Before signing", "cancel_right": "3 days after receipt, if not given before signing", "fee_cap": "", "rows": "26"},
+  {"state": "North Carolina (condo)", "packet_by_law": "Statement of fees", "deadline": "Before closing", "cancel_right": "", "fee_cap": "", "rows": "27"}]
+json.dump({"title": "What the law gives a buyer of a home in an association, by state", "note": "Blank cells were not researched; the writer leaves them out, never fills them.", "rows": states},
+          open(os.path.join(d, "chart-states.json"), "w"), indent=1)
+print("ok", len(rows))
