+  printf '== %s\n' "$q"
+  curl -sS -A "Mozilla/5.0" "https://suggestqueries.google.com/complete/search?client=firefox&hl=en&gl=us&q=$(python3 -c "import urllib.parse,sys;print(urllib.parse.quote(sys.argv[1]))" "$q")"; echo
+done
diff --git a/data/2026-11-a/hoa-documents/pull_listings.py b/data/2026-11-a/hoa-documents/pull_listings.py
new file mode 100644
index 00000000..1eef7348
--- /dev/null
+++ b/data/2026-11-a/hoa-documents/pull_listings.py
@@ -0,0 +1,25 @@
+"""Active listings in the CRM feed (chapter3realty.com/homes/api/map), counted in aggregate only:
+how many come with an association fee, and how many say whether rentals are allowed. Counts only, no addresses.
+Run: python3 -I pull_listings.py <this dir>. Writes listings-counts.json with each query string."""
+import json, sys, time, urllib.request, urllib.parse, datetime
+d = sys.argv[1]
+def total(p):
+    url = "https://chapter3realty.com/homes/api/map?" + urllib.parse.urlencode(dict(p, limit=1))
+    for i in range(4):
+        try: return json.load(urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"}), timeout=60))["total"]
+        except Exception: time.sleep(3)
+Q = {}
+for t in ["condo", "townhouse", "house"]:
+    base = {"type": t, "status": "active"}
+    Q[t] = {"all": base, "no_fee": dict(base, hoaMax=0),
+            "rentals_allowed": dict(base, has="rentals_allowed"), "str_allowed": dict(base, has="str_allowed"),
+            "long_term_rental_allowed": dict(base, has="long_term_rental_allowed"),
+            "rentals_allowed_no_fee": dict(base, has="rentals_allowed", hoaMax=0),
+            "str_allowed_no_fee": dict(base, has="str_allowed", hoaMax=0),
+            "ltr_allowed_no_fee": dict(base, has="long_term_rental_allowed", hoaMax=0)}
+out = {"pulled": datetime.datetime.utcnow().isoformat() + "Z", "api": "https://chapter3realty.com/homes/api/map", "counts": {}, "queries": {}}
+for t, qs in Q.items():
+    out["counts"][t] = {k: total(v) for k, v in qs.items()}
+    out["queries"][t] = {k: urllib.parse.urlencode(v) for k, v in qs.items()}
+    print(t, out["counts"][t], flush=True)
+json.dump(out, open(f"{d}/listings-counts.json", "w"), indent=1)
diff --git a/data/2026-11-a/hoa-documents/pull_recorded.py b/data/2026-11-a/hoa-documents/pull_recorded.py
new file mode 100644
index 00000000..47203448
--- /dev/null
+++ b/data/2026-11-a/hoa-documents/pull_recorded.py
@@ -0,0 +1,50 @@
+"""Pull Horry County Register of Deeds index rows (AcclaimWeb, the county's public deed index), month by month,
+for the document types that hold association papers: RESTRICTIONS (082, value 170) and MASTER DEED (022, value 213).
+Value codes are the search page's own checkbox values (read 2026-11-04).
+Usage: RAW=<dir outside the repo> python3 -I pull_recorded.py <outdir> 2012-01 2026-10 [types]
+  types: comma list from 170,213,166 (166 = AMENDMENT DEED BOOK (069)); default 170,213.
+Writes RAW/<type>-YYYY-MM.json per month (party names, so they stay out of the repo) and
+<outdir>/raw/recorded-months.json (monthly totals only)."""
+import sys, json, os, time, datetime, http.cookiejar, urllib.request, urllib.parse
+out, m0, m1 = sys.argv[1], sys.argv[2], sys.argv[3]
+RAW = os.environ.get("RAW", os.path.join(out, "raw-private")); os.makedirs(RAW, exist_ok=True)
+os.makedirs(os.path.join(out, "raw"), exist_ok=True)
+B = "https://acclaimweb.horrycounty.org/AcclaimWeb"
+cj = http.cookiejar.CookieJar()
+op = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cj))
+op.addheaders = [("User-Agent", "Mozilla/5.0 (research; chapter3realty.com)")]
+def post(url, data, xhr=False):
+    req = urllib.request.Request(url, data=urllib.parse.urlencode(data).encode())
+    if xhr: req.add_header("X-Requested-With", "XMLHttpRequest")
+    for i in range(5):
+        try: return op.open(req, timeout=180).read()
+        except Exception as e:
+            print("retry", url, e, file=sys.stderr); time.sleep(6)
+    raise SystemExit("failed " + url)
