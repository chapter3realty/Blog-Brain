+    <div class="threeAreas filter left width98 rounded">
+        <div class="miniStatuteTOC"><a href="/Laws/Statutes/2025/Title40/#Title40"><span class="title">Title XL</span> <span class="descript">REAL AND PERSONAL PROPERTY</span></a></div>
+        
+                    <div class="miniStatuteTOC">
+                        <a href="/Laws/Statutes/2025/Chapter720"><span class="title">Chapter 720</span>
+                        <span class="descript">HOMEOWNERS&#39; ASSOCIATIONS</span></a> 
