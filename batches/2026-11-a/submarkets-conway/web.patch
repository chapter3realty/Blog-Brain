@@ -0,0 +1,13 @@
+"""OSRM drive times (public router, free flow, no traffic) from the USGS GNIS point for Conway, the same start as affordable-facts row 50.
+Destinations from OpenStreetMap Nominatim (2026-11-01). Writes raw/drives.json. Run: python3 -I pull_drives.py <datadir>"""
+import json, sys, os, urllib.request
+D = sys.argv[1]; T = (-79.047814, 33.836003)
+DEST = {"airport_terminal": (-78.9227887, 33.6814671), "ccu": (-79.0126825, 33.7953227), "riverwalk_park": (-79.0439071, 33.8288646),
+        "beach_mb40": (-78.880438, 33.690692), "coastal_grand": (-78.923261, 33.702315), "conway_medical": (-79.001894, 33.785483)}
+out = {}
+for k, (x, y) in DEST.items():
+    u = "https://router.project-osrm.org/route/v1/driving/%f,%f;%f,%f?overview=false" % (T[0], T[1], x, y)
+    r = json.loads(urllib.request.urlopen(urllib.request.Request(u, headers={"User-Agent": "Mozilla/5.0"}), timeout=60).read())["routes"][0]
+    out[k] = {"url": u, "duration_s": r["duration"], "distance_m": r["distance"], "minutes": round(r["duration"] / 60, 1), "miles": round(r["distance"] / 1609.344, 1)}
+    print(k, out[k]["minutes"], out[k]["miles"])
+json.dump(out, open(os.path.join(D, "raw", "drives.json"), "w"), indent=1)
diff --git a/data/2026-11-a/submarkets-conway/pull_fema.py b/data/2026-11-a/submarkets-conway/pull_fema.py
new file mode 100644
index 00000000..d0341377
--- /dev/null
+++ b/data/2026-11-a/submarkets-conway/pull_fema.py
@@ -0,0 +1,19 @@
+#!/usr/bin/env python3
+"""OpenFEMA NFIP policies (v3) for Conway ZIPs 29526 and 29527: single-family (occupancyType 1 or 11), policies that began
+June 1, 2025 to May 31, 2026, split by rated zone (X/B/C = outside the high-risk zone; A* = inside). Writes raw/nfip-policies-<zip>-<grp>.json.
+Run: python3 -I pull_fema.py <datadir>"""
+import sys, json, os, urllib.request, urllib.parse
+D = sys.argv[1]; R = os.path.join(D, "raw")
+B = "https://www.fema.gov/api/open/v3/NfipPolicies"
+for z in ("29526", "29527"):
+    for grp, zf in (("x", "(ratedFloodZone eq 'X' or ratedFloodZone eq 'B' or ratedFloodZone eq 'C')"), ("a", "(startswith(ratedFloodZone,'A'))")):
+        f = ("reportedZipCode eq '%s' and (occupancyType eq 1 or occupancyType eq 11) and %s and policyEffectiveDate ge '2025-06-01T00:00:00.000Z' and policyEffectiveDate lt '2026-06-01T00:00:00.000Z'" % (z, zf))
+        rows = []; skip = 0
+        while True:
+            u = B + "?" + urllib.parse.urlencode({"$filter": f, "$select": "totalInsurancePremiumOfThePolicy,policyCost,ratedFloodZone,reportedZipCode,occupancyType,policyEffectiveDate,primaryResidenceIndicator", "$orderby": "totalInsurancePremiumOfThePolicy", "$top": "1000", "$skip": str(skip)}, quote_via=urllib.parse.quote)
+            got = json.loads(urllib.request.urlopen(u, timeout=300).read()).get("NfipPolicies", [])
+            rows += got; skip += 1000
+            if len(got) < 1000: break
+        d = {"NfipPolicies": rows, "url": u.split("&%24top")[0]}
+        json.dump(d, open(os.path.join(R, "nfip-policies-%s-%s.json" % (z, grp)), "w"))
+        print(z, grp, len(d.get("NfipPolicies", [])))
diff --git a/data/2026-11-a/submarkets-conway/pull_listings.py b/data/2026-11-a/submarkets-conway/pull_listings.py
new file mode 100644
index 00000000..af539334
--- /dev/null
+++ b/data/2026-11-a/submarkets-conway/pull_listings.py
@@ -0,0 +1,35 @@
+"""Active for-sale listings with a Conway mailing address (CRM public map API, city=Conway), for counts and medians in aggregate only.
+Splits price bands until each search returns every home (the API returns at most 144 pins a call).
+Keeps MLS number (to drop duplicates), type, price, beds, square feet, acres, lat, lng and tag. No addresses, firms or photos are saved.
+Run: RAW=<scratch> python3 -I pull_listings.py. Writes RAW/listings-conway.json (kept out of the repo) and prints totals."""
+import json, os, time, urllib.request, urllib.parse, datetime
+RAW = os.environ["RAW"]
+BASE = "https://chapter3realty.com/homes/api/map?"
+TYPES = ["house", "townhouse", "condo", "manufactured", "land"]
+calls = 0
+def get(p):
+    global calls; calls += 1
+    url = BASE + urllib.parse.urlencode(p)
+    for i in range(4):
+        try: return json.load(urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"}), timeout=60))
+        except Exception: time.sleep(3)
+    raise SystemExit("failed " + url)
+def num(s):
+    try: return float(str(s).replace("$", "").replace(",", ""))
+    except Exception: return None
+def band(t, lo, hi, acc, warn):
+    d = get({"city": "Conway", "type": t, "min": lo, "max": hi})
+    if d["total"] > len(d["pins"]) and hi - lo > 500:
+        mid = (lo + hi) // 2; band(t, lo, mid, acc, warn); band(t, mid + 1, hi, acc, warn); return
+    if d["total"] > len(d["pins"]): warn.append([t, lo, hi, d["total"], len(d["pins"])])
+    for p in d["pins"]:
+        acc[p["mls"]] = {"type": t, "price": num(p["price"]), "beds": p.get("beds"), "sqft": p.get("sqft") or None, "acres": num(p.get("acres")), "lat": p.get("lat"), "lng": p.get("lng"), "tag": p.get("tag") or ""}
+res = {}; totals = {}; warn = []; meta = None
+for t in TYPES:
+    acc = {}; band(t, 0, 50000000, acc, warn)
+    d = get({"city": "Conway", "type": t}); totals[t] = d["total"]; meta = d.get("meta")
+    print(t, "pins", len(acc), "api total", d["total"], flush=True); res.update(acc)
+for h in ["flood_zone", "new_construction", "no_hoa"]:
+    d = get({"city": "Conway", "type": "house", "has": h}); totals["house+" + h] = d["total"]; print(h, d["total"], d.get("params"))
+json.dump({"pulled": datetime.datetime.now(datetime.timezone.utc).isoformat(), "calls": calls, "api_totals": totals, "truncated": warn, "meta": meta, "homes": res}, open(os.path.join(RAW, "listings-conway.json"), "w"))
+print("homes", len(res), "calls", calls, "truncated", warn)
