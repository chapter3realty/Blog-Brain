index 00000000..3e9e10a5
--- /dev/null
+++ b/data/2026-11-a/submarkets-myrtle-beach/charts.py
@@ -0,0 +1,80 @@
+#!/usr/bin/env python3
+"""Chart and map data for /submarkets/myrtle-beach/, built only from files in this folder and RAW.
+Run: RAW=<scratch> python3 -I charts.py <datadir>
+Writes:
+  chart-values.json      Zillow ZHVI for the city of Myrtle Beach, condos and single-family, monthly from 2019-01 (raw/zillow-zhvi-city-*.csv)
+  chart-jobs.json        BLS QCEW private leisure and hospitality jobs in Horry County, by month (raw/qcew-*.csv)
+  chart-str-months.json  AirROI average revenue per active Myrtle Beach listing by calendar month (raw/airroi-myrtle-beach.txt)
+  chart-owners.json      Condos and houses inside the city: main home (4 percent rate) or not, owner's tax-bill address in SC or not (findings.json)
+  map-str-zones.geojson  City of Myrtle Beach zoning areas grouped as: shaded on the city's visitor-accommodation map; R zone; planned development
+                         not shaded; other district not shaded. Plus the city limits. Simplified (about 8 m)."""
+import sys, os, json, csv, glob, re
+from shapely.geometry import Polygon, mapping
+from shapely.ops import unary_union
+RAW = os.environ["RAW"]; DD = sys.argv[1]
+def W(n, o): json.dump(o, open(os.path.join(DD, n), "w"), separators=(",", ":"))
+# Zillow
+vals = {}
+for k in ("condo", "sfr"):
+    r = list(csv.reader(open(os.path.join(DD, "raw", f"zillow-zhvi-city-{k}.csv"))))
+    h = r[0]
+    row = [x for x in r[1:] if x[2] == "Myrtle Beach"][0]
+    vals[k] = [[h[i][:7], round(float(row[i]))] for i in range(8, len(h)) if row[i] and h[i] >= "2019-01"]
+W("chart-values.json", {"source": "Zillow Research, ZHVI city files, middle tier, smoothed, seasonally adjusted; RegionName Myrtle Beach (RegionID 46666)",
+                        "condo": vals["condo"], "single_family": vals["sfr"]})
+# QCEW
+jobs = []
+for f in sorted(glob.glob(os.path.join(DD, "raw", "qcew-45051-*.csv"))):
+    for r in csv.DictReader(open(f)):
+        if r["own_code"] == "5" and r["industry_code"] == "1026":
+            y, q = int(r["year"]), int(r["qtr"])
+            for m in range(3):
+                jobs.append([f"{y}-{3 * (q - 1) + m + 1:02d}", int(r[f"month{m + 1}_emplvl"])])
+W("chart-jobs.json", {"source": "BLS QCEW, Horry County (45051), private, NAICS supersector 1026 Leisure and hospitality, monthly employment", "months": jobs})
+# AirROI by calendar month
+t = open(os.path.join(DD, "raw", "airroi-myrtle-beach.txt")).read()
+t = re.sub(r"&\]:[^>]*>", "|", t)
+i = t.find("Average monthly revenue per active listing in Myrtle Beach, by calendar month")
+seg = t[i:i + 900]
+months = re.findall(r"\|(January|February|March|April|May|June|July|August|September|October|November|December) \|[^|]+\|\$([\d,]+)", seg)
+W("chart-str-months.json", {"source": "AirROI, Myrtle Beach market page, 'Revenue by month in Myrtle Beach in numbers' (each calendar month averaged over the past two years), page updated October 1, 2026",
+                            "months": [[m, int(v.replace(",", ""))] for m, v in months]})
+# Owners
+F = json.load(open(os.path.join(DD, "findings.json")))["homes_in_city"]
+W("chart-owners.json", {k: {"homes": F[k]["homes"], "main_home_4pct": F[k]["rate_4pct"], "rate_6pct": F[k]["rate_6pct"],
+                            "tax_bill_outside_sc": F[k]["owner_mail_not_sc"]} for k in ("condo", "house")})
+# Map
+def zone_class(code, row):
+    """R districts other than RMV: never (the city's text). RMV: always (the city's text). Others: shaded on the city's map,
+    measured with about 60 m of tolerance for the image fit (share of the polygon 60 percent or more)."""
+    share = row["pink_px_60m"] / row["px"] if row["px"] else 0
+    if code == "RMV": return "str", share
+    if code.startswith("R"): return "r_no", share
+    if share >= 0.6: return "str", share
+    return ("pud_no" if "PUD" in code else "other_no"), share
+def esri(rings):
+    o, h = [], []
+    for r in rings:
+        a = sum(r[i][0] * r[i + 1][1] - r[i + 1][0] * r[i][1] for i in range(len(r) - 1))
+        (o if a < 0 else h).append(Polygon(r).buffer(0))
+    g = unary_union(o); return g.difference(unary_union(h)) if h else g
+zp = json.load(open(os.path.join(DD, "zone-pink.json")))["by_poly"]
+groups = {"str": [], "r_no": [], "pud_no": [], "other_no": []}
+for f, row in zip(json.load(open(os.path.join(RAW, "zoning.json"))), zp):
+    code = (f["attributes"]["ZONING_DIS"] or "").strip(); cls, share = zone_class(code, row)
+    groups[cls].append(esri(f["geometry"]["rings"]))
+feats = []
+label = {"str": "Nightly rentals allowed (shaded on the city's map)", "r_no": "R zone: no rentals under 90 days",
+         "pud_no": "Planned development, not shaded", "other_no": "Other district, not shaded"}
+for k, gs in groups.items():
+    g = unary_union(gs).simplify(0.00008, preserve_topology=True)
+    feats.append({"type": "Feature", "properties": {"class": k, "label": label[k]}, "geometry": mapping(g)})
+city = unary_union([esri(f["geometry"]["rings"]) for f in json.load(open(os.path.join(RAW, "city.json")))]).simplify(0.00008, preserve_topology=True)
+feats.append({"type": "Feature", "properties": {"class": "city_limits", "label": "City of Myrtle Beach"}, "geometry": mapping(city)})
+def rnd(o):
+    if isinstance(o, float): return round(o, 5)
+    if isinstance(o, (list, tuple)): return [rnd(x) for x in o]
+    if isinstance(o, dict): return {k: rnd(v) for k, v in o.items()}
+    return o
+W("map-str-zones.geojson", rnd({"type": "FeatureCollection", "features": feats}))
+print({k: len(v) for k, v in groups.items()}, len(jobs), len(months), len(vals["condo"]))
diff --git a/data/2026-11-a/submarkets-myrtle-beach/fetch_gis.py b/data/2026-11-a/submarkets-myrtle-beach/fetch_gis.py
new file mode 100644
index 00000000..769a1073
--- /dev/null
+++ b/data/2026-11-a/submarkets-myrtle-beach/fetch_gis.py
@@ -0,0 +1,71 @@
+#!/usr/bin/env python3
+"""City of Myrtle Beach and Horry County GIS records for /submarkets/myrtle-beach/.
+Run: RAW=<scratch> python3 -I fetch_gis.py
+Writes into RAW (kept out of the repo; parcels and address points carry addresses):
+  zoning.json        City of Myrtle Beach zoning districts (terra.cityofmyrtlebeach.com ZONING_DISTRICTS_MB layer 0), WGS84, every field
+  citylimits-city.json  City of Myrtle Beach CITY_LIMITS_MB layer 0, WGS84
+  city.json          Horry County parcelapp layer 31 Municipalities, NAME = MYRTLE BEACH, WGS84
+  parcels.json       county layer 24 residential parcels with a building in the city box: PIN, LandUseCode, TaxDistrict, Acreage, LegalDescr, MarketProp, MarketImprv, SaleDate, OwnerState (no names or street) + centroid
+  addr.json          county layer 22 address points in the box: PIN, STREETNAME, SUBDIVISION, POSTAL_CITY, ZIPCODE, point (no house numbers)
+  sfha.json          county layer 19 FEMA flood zones in the box (every zone), WGS84"""
+import sys, json, os, time, urllib.request, urllib.parse
+RAW = os.environ["RAW"]; os.makedirs(RAW, exist_ok=True)
+PA = "https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer/%d/query"
+CZ = "https://terra.cityofmyrtlebeach.com/server/rest/services/ZONING_DISTRICTS_MB/FeatureServer/0/query"
+CL = "https://terra.cityofmyrtlebeach.com/server/rest/services/CITY_LIMITS_MB/FeatureServer/0/query"
+def q(url, params):
+    data = urllib.parse.urlencode(dict(params, f="json")).encode()
+    for i in range(6):
+        try:
+            d = json.loads(urllib.request.urlopen(urllib.request.Request(url, data=data, headers={"User-Agent": "Mozilla/5.0"}), timeout=300).read())
+            if "error" in d: raise Exception(d["error"])
+            return d
+        except Exception as e:
+            print("retry", url, e, file=sys.stderr); time.sleep(5)
+    raise SystemExit("failed " + url)
+def have(n): return os.path.exists(os.path.join(RAW, n))
+def save(n, o): json.dump(o, open(os.path.join(RAW, n), "w"))
+def page(url, where, fields, geom, env=None, extra=None):
+    p = {"where": where, "returnIdsOnly": "true"}; p.update(env or {})
+    ids = sorted(q(url, p)["objectIds"] or []); rows = []
+    for i in range(0, len(ids), 1000):
+        pp = {"objectIds": ",".join(map(str, ids[i:i+1000])), "outFields": fields, "returnGeometry": "true" if geom else "false", "outSR": "4326"}
+        if extra: pp.update(extra)
+        rows += q(url, pp)["features"]; print(url[-30:], i, len(rows), flush=True)
+    return rows
+if not have("zoning.json"):
+    save("zoning.json", page(CZ, "1=1", "*", True))
+if not have("citylimits-city.json"):
+    save("citylimits-city.json", page(CL, "1=1", "*", True))
+if not have("city.json"):
+    save("city.json", q(PA % 31, {"where": "NAME = 'MYRTLE BEACH'", "outFields": "*", "returnGeometry": "true", "outSR": "4326"})["features"])
+ext = q(PA % 31, {"where": "NAME = 'MYRTLE BEACH'", "returnExtentOnly": "true", "outSR": "4326"})["extent"]
+BOX = "%f,%f,%f,%f" % (ext["xmin"] - 0.005, ext["ymin"] - 0.005, ext["xmax"] + 0.005, ext["ymax"] + 0.005)
+print("box", BOX)
+env = {"geometry": BOX, "geometryType": "esriGeometryEnvelope", "inSR": "4326", "spatialRel": "esriSpatialRelIntersects"}
+if not have("parcels.json"):
+    save("parcels.json", [x["attributes"] | {"c": x.get("centroid")} for x in page(PA % 24, "LandUseCode LIKE '1%' AND MarketImprv > 0", "PIN,LandUseCode,TaxDistrict,Acreage,LegalDescr,MarketProp,MarketImprv,MarketLand,AssessedProp,TaxableProp,SaleDate,OwnerState,CONDOLABEL", True, env, extra={"returnCentroid": "true", "returnGeometry": "false"})])
+if not have("addr.json"):
+    rows = page(PA % 22, "1=1", "PIN,STREETNAME,SUBDIVISION,POSTAL_CITY,ZIPCODE", True, env)
+    save("addr.json", [dict(x["attributes"], x=round(x["geometry"]["x"], 6), y=round(x["geometry"]["y"], 6)) for x in rows if x.get("geometry")])
+if not have("sfha.json"):
+    save("sfha.json", page(PA % 19, "1=1", "FLD_ZONE,SFHA_TF,STATIC_BFE", True, env, extra={"maxAllowableOffset": "0.00002"}))
+print("done")
+# Parcels with no county address point (mostly condo units): fetch the parcel outline and keep one point inside it.
+#   parcel-pts.json  {PIN: [lon, lat]} for those parcels
+if not have("parcel-pts.json"):
+    from shapely.geometry import Polygon
+    ap = set(int(x["PIN"]) for x in json.load(open(os.path.join(RAW, "addr.json"))) if x.get("PIN"))
+    pins = [int(x["PIN"]) for x in json.load(open(os.path.join(RAW, "parcels.json"))) if int(x["PIN"]) not in ap]
+    out = {}
+    for i in range(0, len(pins), 400):
+        ch = pins[i:i+400]
+        fs = q(PA % 24, {"where": "PIN IN (%s)" % ",".join(map(str, ch)), "outFields": "PIN", "returnGeometry": "true", "outSR": "4326", "maxAllowableOffset": "0.00002"})["features"]
+        for f in fs:
+            rr = (f.get("geometry") or {}).get("rings")
+            if not rr: continue
+            pt = Polygon(rr[0]).buffer(0).representative_point()
+            out[str(f["attributes"]["PIN"])] = [round(pt.x, 6), round(pt.y, 6)]
+        print("pts", i, len(out), flush=True)
+    save("parcel-pts.json", out)
+print("done")
diff --git a/data/2026-11-a/submarkets-myrtle-beach/fetch_mailing.py b/data/2026-11-a/submarkets-myrtle-beach/fetch_mailing.py
new file mode 100644
index 00000000..a017ff1f
--- /dev/null
+++ b/data/2026-11-a/submarkets-myrtle-beach/fetch_mailing.py
@@ -0,0 +1,36 @@
+#!/usr/bin/env python3
+"""Every county address point whose mailing city is Myrtle Beach, countywide, and the land use of its parcel.
+Run: RAW=<scratch> python3 -I fetch_mailing.py
+Writes RAW/mb-postal.json (PIN, ZIPCODE, SUBDIVISION, point; no street or house number) and RAW/mb-postal-landuse.json ({PIN: [LandUseCode, MarketImprv]})."""
+import sys, json, os, time, urllib.request, urllib.parse
+RAW = os.environ["RAW"]
+PA = "https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer/%d/query"
+def q(url, params):
+    data = urllib.parse.urlencode(dict(params, f="json")).encode()
+    for i in range(6):
+        try:
+            d = json.loads(urllib.request.urlopen(urllib.request.Request(url, data=data), timeout=300).read())
+            if "error" in d: raise Exception(d["error"])
+            return d
+        except Exception as e:
+            print("retry", e, file=sys.stderr); time.sleep(5)
+    raise SystemExit("failed")
+f1 = os.path.join(RAW, "mb-postal.json")
+if not os.path.exists(f1):
+    ids = sorted(q(PA % 22, {"where": "UPPER(POSTAL_CITY) = 'MYRTLE BEACH'", "returnIdsOnly": "true"})["objectIds"])
+    rows = []
+    for i in range(0, len(ids), 1000):
+        fs = q(PA % 22, {"objectIds": ",".join(map(str, ids[i:i+1000])), "outFields": "PIN,ZIPCODE,SUBDIVISION", "returnGeometry": "true", "outSR": "4326"})["features"]
+        rows += [dict(x["attributes"], x=round(x["geometry"]["x"], 6), y=round(x["geometry"]["y"], 6)) for x in fs if x.get("geometry")]
+        print("addr", i, len(rows), flush=True)
+    json.dump(rows, open(f1, "w"))
+rows = json.load(open(f1))
+f2 = os.path.join(RAW, "mb-postal-landuse.json")
+lu = json.load(open(f2)) if os.path.exists(f2) else {}
+pins = sorted(set(int(r["PIN"]) for r in rows if r.get("PIN")) - set(int(k) for k in lu))
+for i in range(0, len(pins), 400):
+    ch = pins[i:i+400]
+    fs = q(PA % 24, {"where": "PIN IN (%s)" % ",".join(map(str, ch)), "outFields": "PIN,LandUseCode,MarketImprv", "returnGeometry": "false"})["features"]
+    for f in fs: lu[str(f["attributes"]["PIN"])] = [f["attributes"]["LandUseCode"], f["attributes"]["MarketImprv"]]
+    if i % 4000 == 0: print("lu", i, len(lu), flush=True); json.dump(lu, open(f2, "w"))
+json.dump(lu, open(f2, "w")); print("done")
