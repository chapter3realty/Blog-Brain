if" font-size="10" fill="#8a8276" text-anchor="middle">Jul</text></g><g class="bar"><rect x="420.3" y="60.6" width="31.4" height="207.4" rx="3" fill="var(--brass)"><title>Aug: 85% occupancy</title></rect><text x="436.0" y="55.6" font-family="DM Sans,sans-serif" font-size="10" fill="#5a5346" text-anchor="middle">85%</text><text x="436.0" y="284.0" font-family="DM Sans,sans-serif" font-size="10" fill="#8a8276" text-anchor="middle">Aug</text></g><g class="bar"><rect x="470.9" y="114.3" width="31.4" height="153.7" rx="3" fill="var(--brass)"><title>Sep: 63% occupancy</title></rect><text x="486.6" y="109.3" font-family="DM Sans,sans-serif" font-size="10" fill="#5a5346" text-anchor="middle">63%</text><text x="486.6" y="284.0" font-family="DM Sans,sans-serif" font-size="10" fill="#8a8276" text-anchor="middle">Sep</text></g><g class="bar"><rect x="521.6" y="143.6" width="31.4" height="124.4" rx="3" fill="var(--brass)"><title>Oct: 51% occupancy</title></rect><text x="537.3" y="138.6" font-family="DM Sans,sans-serif" font-size="10" fill="#5a5346" text-anchor="middle">51%</text><text x="537.3" y="284.0" font-family="DM Sans,sans-serif" font-size="10" fill="#8a8276" text-anchor="middle">Oct</text></g><g class="bar"><rect x="572.3" y="197.2" width="31.4" height="70.8" rx="3" fill="var(--brass)"><title>Nov: 29% occupancy</title></rect><text x="588.0" y="192.2" font-family="DM Sans,sans-serif" font-size="10" fill="#5a5346" text-anchor="middle">29%</text><text x="588.0" y="284.0" font-family="DM Sans,sans-serif" font-size="10" fill="#8a8276" text-anchor="middle">Nov</text></g><g class="bar"><rect x="622.9" y="216.8" width="31.4" height="51.2" rx="3" fill="var(--brass)"><title>Dec: 21% occupancy</title></rect><text x="638.6" y="211.8" font-family="DM Sans,sans-serif" font-size="10" fill="#5a5346" text-anchor="middle">21%</text><text x="638.6" y="284.0" font-family="DM Sans,sans-serif" font-size="10" fill="#8a8276" text-anchor="middle">Dec</text></g></svg><table style="width:100%;border-collapse:collapse;margin-top:.75rem;font-family:var(--sans);font-size:.8rem"><caption style="text-align:left;font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:#6d675d;margin-bottom:.4rem">Typical short-term rental occupancy by month (illustrative)</caption><thead><tr><th scope="col" style="text-align:left;padding:.3rem .5rem;border-bottom:1px solid var(--rule);color:var(--navy)">Month</th><th scope="col" style="text-align:right;padding:.3rem .5rem;border-bottom:1px solid var(--rule);color:var(--navy)">Occupancy</th></tr></thead><tbody><tr><td style="padding:.3rem .5rem;border-bottom:1px solid rgba(28,32,40,.05)">Jan</td><td style="padding:.3rem .5rem;text-align:right;border-bottom:1px solid rgba(28,32,40,.05)">19%</td></tr><tr><td style="padding:.3rem .5rem;border-bottom:1px solid rgba(28,32,40,.05)">Feb</td><td style="padding:.3rem .5rem;text-align:right;border-bottom:1px solid rgba(28,32,40,.05)">22%</td></tr><tr><td style="padding:.3rem .5rem;border-bottom:1px solid rgba(28,32,40,.05)">Mar</td><td style="padding:.3rem .5rem;text-align:right;border-bottom:1px solid rgba(28,32,40,.05)">39%</td></tr><tr><td style="padding:.3rem .5rem;border-bottom:1px solid rgba(28,32,40,.05)">Apr</td><td style="padding:.3rem .5rem;text-align:right;border-bottom:1px solid rgba(28,32,40,.05)">52%</td></tr><tr><td style="padding:.3rem .5rem;border-bottom:1px solid rgba(28,32,40,.05)">May</td><td style="padding:.3rem .5rem;text-align:right;border-bottom:1px solid rgba(28,32,40,.05)">69%</td></tr><tr><td style="padding:.3rem .5rem;border-bottom:1px solid rgba(28,32,40,.05)">Jun</td><td style="padding:.3rem .5rem;text-align:right;border-bottom:1px solid rgba(28,32,40,.05)">84%</td></tr><tr><td style="padding:.3rem .5rem;border-bottom:1px solid rgba(28,32,40,.05)">Jul</td><td style="padding:.3rem .5rem;text-align:right;border-bottom:1px solid rgba(28,32,40,.05)">90%</td></tr><tr><td style="padding:.3rem .5rem;border-bottom:1px solid rgba(28,32,40,.05)">Aug</td><td style="padding:.3rem .5rem;text-align:right;border-bottom:1px solid rgba(28,32,40,.05)">85%</td></tr><tr><td style="padding:.3rem .5rem;border-bottom:1px solid rgba(28,32,40,.05)">Sep</td><td style="padding:.3rem .5rem;text-align:right;border-bottom:1px solid rgba(28,32,40,.05)">63%</td></tr><tr><td style="padding:.3rem .5rem;border-bottom:1px solid rgba(28,32,40,.05)">Oct</td><td style="padding:.3rem .5rem;text-align:right;border-bottom:1px solid rgba(28,32,40,.05)">51%</td></tr><tr><td style="padding:.3rem .5rem;border-bottom:1px solid rgba(28,32,40,.05)">Nov</td><td style="padding:.3rem .5rem;text-align:right;border-bottom:1px solid rgba(28,32,40,.05)">29%</td></tr><tr><td style="padding:.3rem .5rem;border-bottom:1px solid rgba(28,32,40,.05)">Dec</td><td style="padding:.3rem .5rem;text-align:right;border-bottom:1px solid rgba(28,32,40,.05)">21%</td></tr></tbody></table><p style="font-family:var(--sans);font-size:.74rem;color:#6d675d;line-height:1.5;margin-top:.5rem">Illustrative seasonal pattern for Grand Strand short-term rentals. Actual occupancy varies by building, corridor, and management. Ask for live revenue history on any specific unit.</p></figure><div style="background:#fff;border:1px solid var(--rule);border-radius:8px;padding:1.5rem 1.6rem;margin:2rem 0"><p style="font-family:var(--sans);font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;color:var(--brass);font-weight:600;margin-bottom:1rem">Short-term rental data &middot; Myrtle Beach</p><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(112px,1fr));gap:1.2rem 1rem;margin-bottom:1.15rem"><div><div style="font-family:var(--serif);font-size:1.55rem;color:var(--navy);line-height:1.1">$20,946</div><div style="font-size:.7rem;letter-spacing:.05em;color:var(--muted);margin-top:.15rem">average annual revenue</div></div><div><div style="font-family:var(--serif);font-size:1.55rem;color:var(--navy);line-height:1.1">33.2%</div><div style="font-size:.7rem;letter-spacing:.05em;color:var(--muted);margin-top:.15rem">occupancy</div></div><div><div style="font-family:var(--serif);font-size:1.55rem;color:var(--navy);line-height:1.1">$253</div><div style="font-size:.7rem;letter-spacing:.05em;color:var(--muted);margin-top:.15rem">average nightly rate</div></div><div><div style="font-family:var(--serif);font-size:1.55rem;color:var(--navy);line-height:1.1">8,583</div><div style="font-size:.7rem;letter-spacing:.05em;color:var(--muted);margin-top:.15rem">active listings</div></div></div><p style="color:var(--muted);font-size:.87rem;line-height:1.65;margin:0">The strongest tenth of listings here gross $6,043 a month or more; the median listing makes $2,115. June is the strongest month and January the weakest. Averages cover every listing in the market, including part-time ones, so a well-run property can sit well above them. <a href="/invest/airbnb-income/" style="color:var(--brass);font-weight:600;text-decoration:none">Compare all nine submarkets</a>. <span style="font-size:.78rem">AirROI, data through 2026-08-08.</span></p></div><h2>How rental returns work in Myrtle Beach</h2><p>On an oceanfront condo, returns start with gross rental revenue, but the number that matters is what is left after the building takes its share. Cleaning and turnover, the management split, HOA dues, accommodations taxes, and utilities commonly absorb 45 to 60 percent of gross before debt service. Estimate net operating income and a realistic annual occupancy, not the headline summer weeks, and deals that look average on gross often separate sharply on net. Cap rate and cash-on-cash return, run on conservative numbers, are the honest way to compare one building against another.</p><h2>Financing an investment property in Myrtle Beach</h2><p>Financing is where oceanfront gets specific. Many resort condos are classified as condotels, which means larger down payments, higher rates, and fewer willing lenders. Warrantability, owner-occupancy ratios, reserve health, and litigation status all affect whether a conventional loan is even available. A lender who has financed these buildings before can flag which ones close cleanly and which will cost you a deal, before you spend on an inspection.</p><h2>Myrtle Beach rules and costs that move the numbers</h2><p>Two cost levers move a Myrtle Beach pro forma more than buyers expect. First, South Carolina assesses non-owner-occupied property at a 6 percent ratio rather than the 4 percent applied to a primary residence, so the tax line on an investment condo runs materially higher. Confirm the current millage and ratio for the exact parcel. Second, short-term rentals collect and remit state and local accommodations and hospitality taxes, and the city requires a business license and a permit. Build both into the model from day one. Older oceanfront buildings also carry special-assessment risk, so read the reserve study as closely as the rental history.</p><h2>The Myrtle Beach investor thesis</h2><ol class="thesis-list"><li><span class="thesis-num">01</span><span class="thesis-text">Oceanfront studios and one-bedrooms inside an established rental program are the lowest-friction entry to Myrtle Beach short-term rental investing.</span></li><li><span class="thesis-num">02</span><span class="thesis-text">Building-level rental history matters more than unit-level finishes. Analyze the building, then the unit.</span></li><li><span class="thesis-num">03</span><span class="thesis-text">Confirm City of Myrtle Beach zoning and the building's master deed before you offer. Not every address is short-term-rental eligible.</span></li><li><span class="thesis-num">04</span><span class="thesis-text">Inland single-family in Carolina Forest and The Market Common offers a steadier long-term-rental alternative when you want less seasonality.</span></li></ol><h2>What a first Myrtle Beach deal looks like</h2><p>A realistic first Myrtle Beach deal is an oceanfront studio or one-bedroom in a building with a documented rental program. The work happens before the offer. Pull two or three years of the building's rental revenue. Read the HOA budget and reserve study. Confirm the unit's short-term-rental eligibility under both city zoning and the master deed. Verify condotel status with a lender so financing is locked. Buyers who do that homework can compare two similar-looking units and know which one nets more. The ones who skip it inherit a special assessment or a soft rental program they never priced in.</p><h2>What to watch before you buy in Myrtle Beach</h2><ul style="padding-left:1.1rem;margin-top:.5rem"><li style="margin-bottom:.7rem;color:var(--muted);line-height:1.7"><strong>Condotel financing.</strong> Many oceanfront condos are classified as condotels, which means larger down payments and a shorter list of willing lenders. Line up financing before you shop.</li><li style="margin-bottom:.7rem;color:var(--muted);line-height:1.7"><strong>Special assessments.</strong> Older oceanfront buildings face salt-air maintenance, elevator and balcony repairs, and reserve shortfalls. Read the budget and reserve study along with the listing.</li><li style="margin-bottom:.7rem;color:var(--muted);line-height:1.7"><strong>HOA rental rules.</strong> Some buildings cap rental frequency or require you to use the on-site program. That changes your numbers materially.</li></ul><h2>Where Myrtle Beach sits, and how it is governed</h2><p>Myrtle Beach is the hub of the Grand Strand, an incorporated city of roughly 35,000 residents in Horry County anchoring about 60 miles of Atlantic coastline. Myrtle Beach International Airport sits inside the city, which is unusual for a beach town and a real convenience for out-of-state owners. Because it is an incorporated city, the City of Myrtle Beach sets its own zoning and short-term-rental rules, which are stricter than the surrounding unincorporated county.</p><h2>The Myrtle Beach market right now</h2><p>Myrtle Beach is a condo-heavy market, so a single median can mislead. City-wide figures land anywhere from the high $180,000s to the mid $310,000s depending on the source, because condos pull the number down and single-family homes push it up. As a reference point, Zillow put the city home-value index near $315,000 in early 2026, down about 3 percent year over year. Single-family homes commonly run in the $330,000s to high $380,000s. The ZIP codes range from about $275,000 in 29577 to about $354,000 in 29579. The condo segment carries the most inventory and the most negotiating room. For an accurate figure on the exact segment you want, we pull the Coastal Carolinas MLS. <!-- TIMMY: current CCAR MLS median and DOM for Myrtle Beach single-family vs condo, by month. --></p><h2>Short-term rental rules in the City of Myrtle Beach</h2><p>This is the single most important thing an investor needs to know about Myrtle Beach, and most get it wrong: the city prohibits short-term rentals in nearly all traditional residential neighborhoods. Every zoning district beginning with R is off-limits for rentals under 90 days, with the lone exception of the RMV (Residential Multifamily Visitor) zone, and fewer than 30 grandfathered houses exist citywide. The city defines short-term as under 90 days, the same line the state uses, and treats STRs as a commercial use. A rental needs a business license and collects 13 percent in lodging taxes and fees on the rent. See the <a href="https://www.cityofmyrtlebeach.com/news_detail_T6_R1468.php" target="_blank" rel="noopener noreferrer">City of Myrtle Beach short-term rental guidance</a>. If your plan is nightly rental income, you must buy in an STR-eligible zone (tourist-commercial or RMV) or a designated resort building, not a random R-zoned house. <!-- TIMMY: name the buildings/zones locals rely on for compliant STRs, and any grandfathered pockets. --> Every jurisdiction's licenses and taxes: <a href="/invest/str-rules/" style="color:var(--brass);font-weight:600;text-decoration:none">short-term rental rules by city</a>.</p><h2>Owning in Myrtle Beach: the 4 percent versus 6 percent property tax rule</h2><p>South Carolina assesses an owner-occupied primary residence at a 4 percent ratio, and it does not pay the school operating tax. A second home or investment property is assessed at 6 percent and pays the school operating tax. In the city of Myrtle Beach that makes a second home's tax bill about 3.8 times a primary home's on the same house. A primary home there pays about 0.4 percent of its value a year, and a second home about 1.5 percent. See the <a href="https://dor.sc.gov" target="_blank" rel="noopener noreferrer">South Carolina Department of Revenue</a> for the assessment-ratio rules. Full county math, with a calculator: <a href="/buyers/property-taxes/" style="color:var(--brass);font-weight:600;text-decoration:none">Horry County property taxes</a>.</p><h2>Flood zones and insurance in Myrtle Beach</h2><p>Flood exposure depends heavily on how close a property sits to the ocean, the Intracoastal Waterway, or low-lying inland pockets. Homes inside a FEMA Special Flood Hazard Area generally require flood insurance on a federally backed loan, and coastal wind coverage has gotten more expensive across the Grand Strand. Chapter3 will pull the FEMA flood map for the specific address before you assume anything. <!-- TIMMY: which Myrtle Beach sections flood, and current flood/wind premium ranges. --> What the three coastal policies cost: <a href="/buyers/coastal-insurance/" style="color:var(--brass);font-weight:600;text-decoration:none">coastal home insurance costs</a>.</p><h2>Myrtle Beach lifestyle and amenities</h2><p>Myrtle Beach is the entertainment core of the Strand. It has the oceanfront Boardwalk and Promenade, the SkyWheel, Broadway at the Beach, Market Common, and Grande Dunes on the Intracoastal. Market Common is a walkable town-center district built on the old air-force base. The city also has one of the densest concentrations of golf in the country. Everyday retail, healthcare, and dining are more built-out here than anywhere else on the Strand, and the airport is minutes from most neighborhoods.</p><h2>Schools serving Myrtle Beach</h2><p>Public schools in the city fall within the Myrtle Beach attendance area of <a href="https://www.horrycountyschools.net/about-hcs/our-schools" target="_blank" rel="noopener noreferrer">Horry County Schools</a>, including Myrtle Beach Elementary, Middle, and High, along with other schools serving specific neighborhoods. Assignment is by address, and Chapter3 will confirm the exact schools for any property against the district attendance-boundary map.</p><h2>What it is like to live in Myrtle Beach</h2><p>Day-to-day life in the city itself is more built-out than anywhere on the Strand. You get walkable town-center living at Market Common, a district built on the old air-force base, plus the oceanfront Boardwalk, Broadway at the Beach, and dense retail, dining, and healthcare. Myrtle Beach International Airport is minutes from most neighborhoods, which is unusual for a beach town. The tradeoff is summer traffic and crowds near the oceanfront core.</p><p>For a live-in buyer, the R-zoned residential neighborhoods tend to be quieter and more year-round, while the tourist corridors stay busy in season. Short-term rentals are not allowed in the R zones anyway. Check the flood zone and insurance for the exact address, and on a condo, the regime fees and reserve study.</p><h2>Buying in Myrtle Beach as a primary residence</h2><p>Myrtle Beach is written about as an investor market, but plenty of buyers want a primary residence or a walkable second home here. For them the STR ban in residential zones is an advantage: it keeps R-zoned neighborhoods residential. Weigh Market Common versus a resort community versus an established inland neighborhood, and remember a primary residence is taxed at 4% with the owner-occupant credit while a second home is 6% without it.</p><h2>Read the Myrtle Beach HOA rules before you commit to a house</h2><p>In a market with this many associations, the covenants matter as much as the house. Before you make an offer, read the HOA bylaws and rules, because they can restrict short-term and long-term rentals, pets, parking, golf carts, fences, and exterior changes. The classic trap: you have spent years training your dog to walk off leash, then buy into a community with a strict leash rule and lose the thing you valued most. Read the documents before you make an offer, not after.</p><p>Ask us and we will get you the governing documents for any Myrtle Beach community, from our own files if we already have them or by requesting them for you if we do not. It is also why a Chapter3 agent asks a lot of questions about how you live. We would rather spend the time up front than match you to a home with a rule or an HOA that blocks what you enjoy or turns out to be a poor investment.</p><h2>Myrtle Beach community stats</h2><p>Official figures from government sources, with no interpretation added. Each links to its source so you can read the full data yourself.</p><div style="background:#fff;border:1px solid var(--rule);border-radius:12px;padding:1.25rem 1.4rem;margin:1rem 0"><p style="font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--navy);font-weight:600;margin-bottom:.5rem">Population &amp; income &middot; <a href="https://www.census.gov/quickfacts/fact/table/myrtlebeachcitysouthcarolina" target="_blank" rel="noopener noreferrer">U.S. Census Bureau</a></p><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Population (2020 Census)</span><span style="color:var(--muted);text-align:right">35,972</span></div><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Median household income (ACS)</span><span style="color:var(--muted);text-align:right">about $60,394</span></div><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Persons in poverty (ACS)</span><span style="color:var(--muted);text-align:right">about 19%</span></div><p style="font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--navy);font-weight:600;margin:1.25rem 0 .5rem">Cost, taxes &amp; risk &middot; government sources</p><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Median owner-occupied home value (ACS)</span><span style="color:var(--muted);text-align:right">about $388,800 &nbsp;<a href="https://www.census.gov/quickfacts/fact/table/myrtlebeachcitysouthcarolina" target="_blank" rel="noopener noreferrer">Census</a></span></div><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Homeownership rate (ACS)</span><span style="color:var(--muted);text-align:right">about 60.5% &nbsp;<a href="https://www.census.gov/quickfacts/fact/table/myrtlebeachcitysouthcarolina" target="_blank" rel="noopener noreferrer">Census</a></span></div><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Property assessment ratio</span><span style="color:var(--muted);text-align:right">4% primary / 6% second home &nbsp;<a href="https://dor.sc.gov" target="_blank" rel="noopener noreferrer">SC DOR</a></span></div><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Flood hazard by address</span><span style="color:var(--muted);text-align:right"><a href="https://msc.fema.gov" target="_blank" rel="noopener noreferrer">FEMA Flood Map Service Center</a></span></div><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Crime statistics</span><span style="color:var(--muted);text-align:right"><a href="https://cde.ucr.cjis.gov" target="_blank" rel="noopener noreferrer">FBI Crime Data Explorer</a> &middot; <a href="https://www.sled.sc.gov" target="_blank" rel="noopener noreferrer">SLED</a></span></div><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">School performance</span><span style="color:var(--muted);text-align:right"><a href="https://screportcards.ed.sc.gov" target="_blank" rel="noopener noreferrer">SC Dept. of Education report cards</a></span></div></div><p style="color:var(--muted);font-size:.85rem;line-height:1.7">How to pull the crime numbers yourself: on the <a href="https://cde.ucr.cjis.gov" target="_blank" rel="noopener noreferrer">FBI Crime Data Explorer</a>, choose South Carolina, then select the local agency to see reported offenses by year. The local agency is the county sheriff's office or the city police department. On <a href="https://www.sled.sc.gov" target="_blank" rel="noopener noreferrer">SLED</a>, open the current "Crime in South Carolina" report and find the county and agency tables. Chapter3 will pull the current figures for a specific address with you.</p><h2>Myrtle Beach school stats</h2><p>Public schools in the city fall within the Myrtle Beach attendance area of Horry County Schools. Figures are from the South Carolina Department of Education report card and federal education data, with no interpretation added.</p><div style="background:#fff;border:1px solid var(--rule);border-radius:12px;padding:1.25rem 1.4rem;margin:1rem 0"><p style="font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--navy);font-weight:600;margin-bottom:.5rem">Myrtle Beach High School &middot; <a href="https://screportcards.ed.sc.gov" target="_blank" rel="noopener noreferrer">SC report card</a></p><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Grades served</span><span style="color:var(--muted);text-align:right">9-12</span></div><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Enrollment</span><span style="color:var(--muted);text-align:right">about 1,595</span></div><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Four-year graduation rate</span><span style="color:var(--muted);text-align:right">about 83% (recent range 81 to 86%)</span></div><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Math proficiency</span><span style="color:var(--muted);text-align:right">68% (state average 43%)</span></div><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Reading and writing proficiency</span><span style="color:var(--muted);text-align:right">80% (state average 52%)</span></div><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Student-to-teacher ratio</span><span style="color:var(--muted);text-align:right">18 to 1</span></div><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">State report card rating</span><span style="color:var(--muted);text-align:right"><a href="https://screportcards.ed.sc.gov" target="_blank" rel="noopener noreferrer">see current rating</a></span></div></div><p>For the elementary and middle schools that feed it, and for any exact address, read the full report cards at the <a href="https://screportcards.ed.sc.gov" target="_blank" rel="noopener noreferrer">South Carolina Department of Education</a>. The report card also publishes SAT and ACT averages, Advanced Placement and dual-enrollment participation, college-and-career readiness, dropout rate, and chronic absenteeism. Ask your Chapter3 agent and we will pull the report card for the school an address is zoned to.</p><h2>Who Myrtle Beach suits</h2><p>Myrtle Beach fits two different buyers. One is a condo or resort investor who buys specifically in an STR-eligible zone and runs nightly rentals with the amenities and foot traffic the core provides. The other is a primary resident or second-home owner who wants walkable town-center living (Market Common) or an amenity-rich resort community and is not counting on STR income from an R-zoned house. If you want a single-family house to Airbnb, the city is usually the wrong target and an unincorporated oceanfront submarket like Garden City is the right one. We will steer you to the correct zone rather than let you buy a rental you cannot legally rent.</p></div>
