+  <bR>
+  <table width="600" border="0" cellspacing="0" cellpadding="0">
+  <tr>
+  <td>
+  </td>
+  <td>
+  <h2>The 2026 Florida Statutes 
+   
+  
+  <br><img src="../../../Images/dividers/600x3_gradient.gif" border=0 alt="" width=600 height=3></h2>
+  </td>
