+out["permits_active_zip"] = {"all": len(pz), "by_type": collections.Counter(" / ".join(((p["PermitType"] or "").strip(), (p["Workclass"] or "").strip(), (p["DESCRIPTION"] or "").strip()[:20])) for p in pz).most_common(12),
