+        pp = {"objectIds": ",".join(map(str, ids[i:i+step])), "outFields": fields, "returnGeometry": "true" if geom else "false", "outSR": "4326"}
+        if extra: pp.update(extra)
+        rows += q(url, pp)["features"]; print(url[-30:], i, len(rows), flush=True)
+    return rows
