3 2.2-3 2.2-1.6 0-2.7-.7-3.1-1.8M12 5.8v1.8M12 16.4v1.8"/><circle cx="12" cy="12" r="9"/></svg></span><span><strong>$3,500</strong><span class="t">for each 1% of commission</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span><strong>The buyer</strong><span class="t">pays for title insurance</span></span></li></ul></div><p style="color:var(--muted);font-size:.9rem;margin-bottom:1rem">By <strong style="color:var(--navy);font-weight:600">Tim Nash</strong>, Broker-in-Charge, 30+ years on the Grand Strand &middot; Reviewed by <strong style="color:var(--navy);font-weight:600">Devin Day</strong>, Operations Officer &middot; <span style="white-space:nowrap">Updated July 25, 2026</span></p><p class="detail-sub">The commission, the deed stamps, the payoff, the tax split and HOA charges, worked on a $350,000 Horry County home.</p></div></div><section style="background:var(--ivory)"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">The short answer</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On the middle $350,000 home in Horry County, with a mortgage to release, the fixed costs from state law and the standard contract come to $1,320. Each 1 percent of commission, the fee you pay the agents, adds $3,500.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">With a 5 percent commission, as an example, your costs come to about $18,800 plus your attorney's fee. Your mortgage payoff comes out of the same check, and the rest is yours.</p></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><p style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Your own net sheet, from your address and your payoff</p><a class="btn btn-brass btn-lg" href="#lead-form">Have us build my net sheet</a></div></section><section style="background:var(--ivory);padding-top:2.5rem"><div class="wrap"><nav aria-label="On this page" style="margin-top:0;max-width:720px"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.3rem;font-weight:600">On this page</p><ul style="list-style:none;margin:0;padding:0"><li><a href="#net-sheet" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Your net sheet</a></li><li><a href="#calculator" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Calculator</a></li><li><a href="#who-pays" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Who pays what</a></li><li><a href="#deed-stamps" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Deed stamps by price</a></li><li><a href="#payoff" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">The payoff</a></li><li><a href="#property-taxes" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Property taxes</a></li><li><a href="#hoa" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">HOA charges</a></li><li><a href="#out-of-state" style="display:block;padding:.65rem 0;colo