{display:flex;align-items:center;gap:.6rem}main#main .np-tb .b{display:block;height:.9rem;border-radius:999px;width:calc(var(--f) * (100% - 5.5rem));min-width:.5rem}main#main .np-tb.t1 .b{background:#c4783a}main#main .np-tb.t2 .b{background:#2a3040}main#main .np-tb .v{font-family:var(--sans);font-weight:600;color:var(--navy);font-variant-numeric:tabular-nums;white-space:nowrap}main#main .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}main#main .np-stat{max-width:760px;margin:1.2rem 0 1.4rem;padding:1.15rem 1.25rem;border-radius:20px;box-sizing:border-box;background:linear-gradient(160deg,rgba(42,48,64,.96),rgba(28,32,40,.98));border:1px solid rgba(255,255,255,.14);color:var(--ivory)}main#main .np-stat .k{font-family:var(--sans);font-size:.8rem;letter-spacing:.1em;text-transform:uppercase;color:var(--brass-2);font-weight:600;margin:0 0 .8rem;line-height:1.45}main#main .np-stat ul{list-style:none;margin:0;padding:0;display:grid;gap:.9rem}@media (min-width:600px){main#main .np-stat ul{grid-template-columns:repeat(2,minmax(0,1fr))}}main#main .np-stat li{margin:0}main#main .np-stat strong{display:block;color:var(--brass-2);font-family:var(--serif);font-size:clamp(1.6rem,6vw,2rem);line-height:1.1;margin-bottom:.3rem}main#main .np-stat span{display:block;color:rgba(244,239,232,.92);line-height:1.5;font-size:1rem}main#main .np-cards{list-style:none;margin:1.1rem 0 1.3rem;padding:0;display:grid;gap:.65rem;max-width:760px}@media (min-width:760px){main#main .np-cards.c3{grid-template-columns:repeat(3,minmax(0,1fr))}main#main .np-cards.c2{grid-template-columns:repeat(2,minmax(0,1fr))}}main#main .np-cards li{margin:0;padding:1rem 1.05rem;border-radius:18px;background:linear-gradient(180deg,rgba(255,255,255,.84),rgba(255,255,255,.6));border:1px solid rgba(255,255,255,.8);box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 10px 26px -18px rgba(28,32,40,.35);color:var(--muted);line-height:1.55}main#main .np-cards li.hot{border:2px solid #c4783a;background:#fff}main#main .np-cards .k{display:block;font-family:var(--sans);font-size:.78rem;letter-spacing:.1em;text-transform:uppercase;color:#8a5226;font-weight:700;margin-bottom:.3rem}main#main .np-cards b{display:block;color:var(--navy);font-family:var(--sans);font-size:1.08rem;line-height:1.35;margin-bottom:.3rem}main#main .np-form-box{max-width:760px;margin:1.4rem 0 1rem;padding:1.4rem 1.3rem;border-radius:20px;box-sizing:border-box;background:linear-gradient(160deg,rgba(42,48,64,.96),rgba(28,32,40,.98));border:1px solid rgba(255,255,255,.14)}main#main .np-form-box .idx-lead{margin-bottom:.7rem}main#main .np-form-box .idx-input{min-height:48px;font-size:1.0625rem}main#main .np-consent{display:flex;gap:.6rem;align-items:flex-start;font-family:var(--sans);font-size:.875rem;color:rgba(244,239,232,.86);line-height:1.5;margin:.3rem 0 1rem;cursor:pointer}main#main .np-consent input{margin-top:.2rem;accent-color:#c4783a;flex-shrink:0;width:20px;height:20px}main#main .np-form-box .btn{width:100%;justify-content:center;min-height:50px}main#main .np-err{display:none;color:#ffb4a8;font-family:var(--sans);font-size:1rem;margin:0 0 .8rem}main#main .np-tel{color:rgba(244,239,232,.86);font-family:var(--sans);font-size:1rem;margin:.8rem 0 0}main#main .np-form-box a.np-call{display:flex;width:100%;box-sizing:border-box;justify-content:center;align-items:center;min-height:48px;margin-top:.6rem;color:var(--ivory);border:1px solid rgba(244,239,232,.55);background:transparent}main#main .np-ok{display:none;max-width:760px;margin:1.4rem 0 1rem;padding:1.3rem;border-radius:20px;background:var(--navy);color:var(--ivory);font-family:var(--sans);font-size:1.0625rem;line-height:1.6}main#main div[style^="border-left:3px solid var(--brass)"] a.btn{font-size:1.02rem;padding:.85rem 1.4rem;min-height:48px}main#main h2,main#main h3,main#main .np-who-c b,main#main .np-cards b,main#main a.btn{text-wrap:balance}main#main .c3-glance li{line-height:1.4}main#main .c3-glance strong{font-size:1.1rem!important;font-weight:700;line-height:1.25}main#main .c3-glance span.t{font-size:.95rem!important;line-height:1.4!important}@media (min-width:700px){main#main nav[aria-label="On this page"]>ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:1.6rem}}@media (max-width:379px){main#main .hx-fb,main#main .hx-fb>*{min-width:0;max-width:100%}main#main .hx-fb-ai,main#main .hx-fb-q{min-width:0!important;max-width:100%!important;flex-wrap:wrap;box-sizing:border-box}main#main .hx-fb-q textarea{min-width:0;flex:1 1 100%;width:100%}main#main .hx-fb-go{flex:1 1 100%}}@media (min-width:1000px) and (max-width:1100px){.header-ctas .hdr-phone{display:none!important}}main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2){padding:.9rem 0!important}main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2)>.wrap{display:block!important;text-align:center!important;background:linear-gradient(160deg,rgba(42,48,64,.95),rgba(28,32,40,.97))!important;border:1px solid rgba(255,255,255,.14)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.14),0 26px 60px -30px rgba(28,32,40,.6)!important;border-radius:28px!important;padding:2.2rem 1.6rem!important;margin-left:auto!important;margin-right:auto!important}@media (max-width:699px){main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2)>.wrap{padding:1.6rem 1.2rem 1.7rem!important;border-radius:24px!important}}</style><style>main#main .detail-hero .detail-sub{display:none}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Take the price, then subtract the commission, the deed stamps, two county fees, your share of this year's property tax and the mortgage payoff. On the middle home, with $175,000 still owed, you keep about $155,500 before your attorney's fee.</p><figure class="np-fig np-split"><p class="cap">Where the $350,000 goes in the example, as a share of the price</p><svg role="img" aria-label="Where the $350,000 goes: mortgage payoff $175,000, what you keep $155,542, commission, 5 percent $17,500, deed stamps, county fees and tax $1,958" viewBox="0 0 1000 56" preserveAspectRatio="none" class="np-bar"><title>Where the $350,000 goes: mortgage payoff $175,000, what you keep $155,542, commission, 5 percent $17,500, deed stamps, county fees and tax $1,958</title><rect x="0.0" y="0" width="500.0" height="56" fill="#2a3040"><title>Mortgage payoff: $175,000</title></rect><rect x="500.0" y="0" width="444.4" height="56" fill="#2f6b3a"><title>What you keep: $155,542</title></rect><rect x="944.4" y="0" width="50.0" height="56" fill="#c4783a"><title>Commission, 5 percent: $17,500</title></rect><rect x="994.4" y="0" width="5.6" height="56" fill="#8a5226"><title>Deed stamps, county fees and tax: $1,958</title></rect></svg><ul class="np-legend"><li><span class="sw" style="background:#2a3040"></span><span class="n">Mortgage payoff</span><b>50%</b></li><li><span class="sw" style="background:#2f6b3a"></span><span class="n">What you keep</span><b>44.4%</b></li><li><span class="sw" style="background:#c4783a"></span><span class="n">Commission, 5 percent</span><b>5%</b></li><li><span class="sw" style="background:#8a5226"></span><span class="n">Deed stamps, county fees and tax</span><b>0.6%</b></li></ul><figcaption>The commission is the biggest cost you can change. The fixed costs are less than 1 percent of the price.</figcaption></figure><figure class="np-fig np-sheet-fig"><p class="cap">Worked example: a $350,000 home, $175,000 left on the mortgage, closing at the end of June</p><table class="np-sheet"><thead><tr><th scope="col">Line, and who decides it</th><th scope="col">Amount</th></tr></thead><tbody><tr class="plus"><th scope="row">Sale price<span class="w">You and the buyer agree on it</span></th><td>$350,000</td></tr><tr><th scope="row">Commission, 5 percent in this example<span class="w">You and your agent agree on it</span></th><td>&minus;$17,500</td></tr><tr><th scope="row">Deed stamps<span class="w">State law: $1.85 for each $500 of the price</span></th><td>&minus;$1,295</td></tr><tr><th scope="row">Recording the deed, and the release of your mortgage<span class="w">County fees: $15 and $10</span></th><td>&minus;$25</td></tr><tr><th scope="row">Your share of this year's property tax<span class="w">181 days of the year, as the owner's home</span></th><td>&minus;$638</td></tr><tr class="na"><th scope="row">Your attorney and the deed preparation<span class="w">The attorney's own fee</span></th><td>Not shown</td></tr><tr class="na"><th scope="row">HOA charges, if you have an association<span class="w">The box ticked on the contract</span></th><td>Not shown</td></tr><tr><th scope="row">Mortgage payoff<span class="w">Your lender's payoff statement</span></th><td>&minus;$175,000</td></tr></tbody><tfoot><tr class="total"><th scope="row">What you keep<span class="w">Before your attorney's fee and any HOA charges</span></th><td>$155,542</td></tr></tfoot></table><figcaption>The tax line is for most homes outside city limits. The commission is negotiable; type your own in the calculator below.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Two lines have no number here because they differ from one sale to the next. Every South Carolina home closing must be <a href="https://www.sccourts.org/media/opinions/HTMLFiles/SC/25508.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">supervised by a South Carolina attorney</a>. Anyone who prepares your deed for you must be a lawyer. On the standard contract, the deed preparation and your own attorney are your costs.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The commission is the largest line you can change. <a href="https://www.nar.realtor/the-facts/what-the-nar-settlement-means-for-home-buyers-and-sellers" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Agents' fees are negotiable</a>, and no law fixes them. Since August 2024, no rule requires a seller to pay the buyer's agent. You can still offer to, or offer the buyer a credit.</p></div></section><section style="background:var(--ivory)" id="calculator"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Calculator">Seller net proceeds calculator</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The boxes start with the example above. Type your own price, what you owe and your closing month. Leave a box empty if you do not know the number yet.</p><div class="np-calc" role="group" aria-labelledby="npCalcT"><p class="k" id="npCalcT">Your own net sheet</p><div class="np-grid"><div class="np-col"><div class="np-in"><label for="npPrice">Sale price</label><span class="u">$ <input id="npPrice" type="number" min="0" step="1000" inputmode="decimal" value="350000" oninput="npCalc()"></span></div><div class="np-in"><label for="npPayoff">What you still owe on the mortgage</label><span class="u">$ <input id="npPayoff" type="number" min="0" step="1000" inputmode="decimal" value="175000" oninput="npCalc()"></span></div><div class="np-in"><label for="npComm">Commission, in percent (an example; change it)</label><span class="u"><input id="npComm" type="number" min="0" max="10" step="0.25" inputmode="decimal" value="5" oninput="npCalc()"> %</span></div><div class="np-in"><label for="npAtty">Your attorney's fee, if you know it</label><span class="u">$ <input id="npAtty" type="number" min="0" step="1000" inputmode="decimal" placeholder="0" oninput="npCalc()"></span></div><div class="np-in"><label for="npHoa">HOA charges on the sale, if any</label><span class="u">$ <input id="npHoa" type="number" min="0" step="1000" inputmode="decimal" placeholder="0" oninput="npCalc()"></span></div><div class="np-in"><label for="npCredit">Money you give the buyer toward their costs</label><span class="u">$ <input id="npCredit" type="number" min="0" step="1000" inputmode="decimal" placeholder="0" oninput="npCalc()"></span></div></div><div class="np-col"><div class="np-in"><label for="npMonth">Closing at the end of</label><span class="u"><select id="npMonth" onchange="npCalc()"><option value="1">January</option><option value="2">February</option><option value="3">March</option><option value="4">April</option><option value="5">May</option><option value="6" selected>June</option><option value="7">July</option><option value="8">August</option><option value="9">September</option></select></span></div><fieldset class="np-radio"><legend>The home was</legend><label><input type="radio" name="npKind" value="home" checked onchange="npCalc()"> My own home</label><label><input type="radio" name="npKind" value="second" onchange="npCalc()"> A second home or a rental</label></fieldset><div class="np-in"><label for="npBill">This year's property tax bill, if you know it</label><span class="u">$ <input id="npBill" type="number" min="0" step="1000" inputmode="decimal" placeholder="0" oninput="npCalc()"></span></div><label class="np-check"><input type="checkbox" id="npOut" onchange="npCalc()"> I live outside South Carolina</label><div id="npOutBox" class="np-sub" hidden><label class="np-check"><input type="checkbox" id="npAff" onchange="npCalc()"> I will sign the state's gain affidavit</label><div class="np-in"><label for="npGain">Your gain on the sale, if you know it</label><span class="u">$ <input id="npGain" type="number" min="0" step="1000" inputmode="decimal" placeholder="0" oninput="npCalc()"></span></div></div></div></div><dl class="np-out"><div><dt>Commission</dt><dd id="npoComm">&nbsp;</dd></div><div><dt>Deed stamps</dt><dd id="npoDeed">&nbsp;</dd></div><div><dt>Recording fees</dt><dd id="npoRec">&nbsp;</dd></div><div><dt>Attorney, HOA and credit to the buyer</dt><dd id="npoOther">&nbsp;</dd></div><div class="sum"><dt>Your selling costs</dt><dd id="npoCosts">&nbsp;</dd></div><div><dt>Your share of this year's property tax</dt><dd id="npoTax">&nbsp;</dd></div><div><dt>Mortgage payoff</dt><dd id="npoPayoff">&nbsp;</dd></div><div class="big"><dt>What you keep</dt><dd id="npoKeep">&nbsp;</dd></div><div id="npoHoldRow" hidden><dt>Held back for South Carolina income tax</dt><dd id="npoHold">&nbsp;</dd></div><div id="npoPaidRow" class="big" hidden><dt>Paid to you at closing</dt><dd id="npoPaid">&nbsp;</dd></div></dl><p class="n" id="npNote">An estimate for planning. The closing attorney's statement has the exact figures.</p></div><script>function npNet(o){var price=o.price,comm=price*o.pct/100,deed=price>0?Math.ceil(price/500)*1.85:0,rec=price>0?15:0,rel=o.payoff>0?10:0;var days=[31,59,90,120,151,181,212,243,273][o.month-1];var bill=o.bill>0?o.bill:price*(o.kind==='home'?0.04*91.9:0.06*201)/1000;var tax=bill*days/365,costs=comm+deed+rec+rel+o.atty+o.hoa+o.credit,keep=price-costs-tax-o.payoff,hold=0;if(o.out){hold=o.aff?Math.max(0,o.gain)*0.0521:Math.max(0,price-costs)*0.0521;}return{comm:comm,deed:deed,rec:rec+rel,costs:costs,tax:tax,keep:keep,hold:hold,paid:keep-hold};}function npCalc(){var g=function(i){var e=document.getElementById(i);var v=e?parseFloat(e.value):NaN;return isFinite(v)&&v>0?v:0};var m=function(n){return (n<0?"-":"")+"$"+Math.round(Math.abs(n)).toLocaleString("en-US")};var k=document.querySelector('input[name="npKind"]:checked');var o={price:g("npPrice"),payoff:g("npPayoff"),pct:g("npComm"),atty:g("npAtty"),hoa:g("npHoa"),credit:g("npCredit"),month:parseInt(document.getElementById("npMonth").value,10)||6,kind:k?k.value:"home",bill:g("npBill"),out:document.getElementById("npOut").checked,aff:document.getElementById("npAff").checked,gain:g("npGain")};var r=npNet(o),s=function(i,t){document.getElementById(i).textContent=t};s("npoComm",m(r.comm));s("npoDeed",m(r.deed));s("npoRec",m(r.rec));s("npoOther",m(o.atty+o.hoa+o.credit));s("npoCosts",m(r.costs));s("npoTax",m(r.tax));s("npoPayoff",m(o.payoff));s("npoKeep",m(r.keep));document.getElementById("npOutBox").hidden=!o.out;document.getElementById("npoHoldRow").hidden=!o.out;document.getElementById("npoPaidRow").hidden=!o.out;if(o.out){s("npoHold",m(r.hold));s("npoPaid",m(r.paid));}s("npNote",o.out?(o.kind==="home"?"If this was your main home and the whole gain is excluded from federal tax, nothing is held back. ":"")+"The amount held back counts toward your South Carolina tax when you file a return there.":"An estimate for planning. The closing attorney's statement has the exact figures.");}document.addEventListener("DOMContentLoaded",npCalc);</script><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The tax line uses the county's 2026 rates for most homes outside city limits, unless you type your own bill. A closing from October on works differently, because the bill can already be paid. We work that one out from the actual bill.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Want every line filled in for your home?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send the address and what you owe. We fill in each line of the net sheet, the attorney's fee and HOA charges included, free.</p><a class="btn btn-brass" href="#lead-form">Have us fill in every line</a></div></div></section><section style="background:var(--ivory-2)" id="who-pays"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Who pays what">Who pays what when you sell a house in South Carolina?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The contract decides. On <a href="https://screaltors.org/wp-content/uploads/2026/02/310.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Form 310</a>, the state REALTORS association's standard home contract, you pay the deed stamps and your payoff, and the buyer pays for title insurance. Title insurance covers claims against the ownership from before the sale.</p><div class="np-who" role="group" aria-label="Who pays which closing cost on South Carolina's standard home contract"><div class="np-who-c"><p class="k">The seller</p><b>You pay</b><ul><li>The deed preparation</li><li>The deed stamps and the deed recording</li><li>Paying off your mortgage, and recording its release</li><li>Your share of this year's property tax</li><li>The fee you agreed with your own agent</li><li>Your own attorney</li></ul></div><div class="np-who-c"><p class="k">The buyer</p><b>The buyer pays</b><ul><li>Both title insurance policies, the owner's and the lender's</li><li>The costs of the buyer's loan</li><li>The buyer's attorney and the title search</li><li>Inspections, the appraisal and any survey</li><li>The fee the buyer agreed with their own agent</li></ul></div><div class="np-who-c hot"><p class="k">The box on the contract</p><b>Whoever is ticked; you, if no box is</b><ul><li>The HOA's fees for its papers</li><li>Transfer fees</li><li>The HOA's letter that says what you still owe</li><li>A one-time payment some HOAs charge on each sale</li></ul></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Each side pays its own costs unless both agree otherwise in writing. The form also tells both sides they are responsible for getting legal advice before they sign.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Before you sign, we look at which box is ticked. More than 1 in 4 houses for sale here list no HOA fee, but all but one of 2,686 condos for sale list one. If nobody ticks a box, the HOA's charges on the sale are yours.</p></div></section><section style="background:var(--ivory)" id="deed-stamps"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Deed stamps by price">How much are SC deed stamps, and what does selling cost at your price?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Deed stamps, the state's fee for recording the deed, are <a href="https://www.scstatehouse.gov/code/t12c024.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">$1.85 for each $500 of the price</a>, or part of $500. The seller owes them. Of each $1.85, $1.30 goes to the state and $0.55 to the county. In all, it is about 0.37 percent of the price.</p><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);letter-spacing:.01em;color:#fff;text-align:right;background:radial-gradient(farthest-side at 100% 100%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.c3ph-cr a{color:#fff;text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);text-underline-offset:2px;pointer-events:auto;padding:10px 0 6px}.c3ph-hero{margin:1.6rem 0 2rem}.c3ph-hero .c3ph-f{border-radius:8px}.c3ph-hero img{aspect-ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}</style><figure class="c3ph-hero" style="margin:1.4rem 0 1.6rem;max-width:640px;"><div class="c3ph-f"><img src="/images/2026-11-a/sell-net-proceeds/horry-county-government-complex-conway-1200w.webp" srcset="/images/2026-11-a/sell-net-proceeds/horry-county-government-complex-conway-600w.webp 600w, /images/2026-11-a/sell-net-proceeds/horry-county-government-complex-conway-1200w.webp 1200w" sizes="(max-width: 680px) 100vw, 640px" width="1200" height="800" alt="A brick government complex with a white-columned entrance and a parking lot in front, in Conway" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: Pollinator at English Wikipedia. License: CC BY-SA 3.0" title="License: CC BY-SA 3.0">Photo: Pollinator at English Wikipedia</a></span></div><figcaption>Horry County's courthouse and county office complex in Conway, in 2006.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The county also charges <a href="https://www.scstatehouse.gov/code/t08c021.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">$15 to record the deed</a> and $10 to record the release of a paid-off mortgage. The rates are the same in Myrtle Beach, North Myrtle Beach, Conway and the rest of the state. Find your price below:</p><style>.c3-cc{margin:1.4rem 0 1.8rem;max-width:960px}.c3-cc table{width:100%;border-collapse:collapse;font-size:var(--read,1.0625rem);line-height:1.45;color:var(--muted)}.c3-cc caption{caption-side:top;text-align:left;color:var(--navy);font-weight:600;font-size:1em;line-height:1.4;padding:0 0 .7rem}.c3-cc th,.c3-cc td{padding:.6rem .7rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule);overflow-wrap:break-word}.c3-cc thead th{color:var(--navy);font-weight:600;font-size:1em;border-bottom:2px solid var(--navy);vertical-align:bottom}.c3-cc tbody th{color:var(--navy);font-weight:600}.c3-cc .n{text-align:right;font-variant-numeric:tabular-nums}.c3-cc .i{display:inline-flex;vertical-align:-4px;margin-right:.45rem;color:var(--brass-ink)}.c3-cc tr.c3-self>*{background:#fff}@media (max-width:59.999em){.c3-cc table,.c3-cc tbody,.c3-cc tr,.c3-cc th,.c3-cc td{display:block;width:auto}.c3-cc caption{display:block}.c3-cc thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.c3-cc tbody tr{background:var(--ivory-2);border-top:3px solid var(--brass);margin:0 0 .8rem;padding:.5rem 0 .6rem}section[style*="background:var(--ivory-2)"] .c3-cc tbody tr{background:var(--ivory)}.c3-cc tr.c3-self{background:#fff!important;border:2px solid var(--brass)}.c3-cc tr.c3-self>*{background:transparent}.c3-cc th,.c3-cc td{border:0;padding:.2rem 1rem}.c3-cc tbody th{display:flex;align-items:center;font-size:1.1em;padding-bottom:.35rem}.c3-cc tbody th .i{flex:none;vertical-align:0}.c3-cc tbody th a{display:inline-block;padding:.5rem 0}.c3-cc .n{text-align:left}.c3-cc td[data-label]::before{content:attr(data-label) ": ";color:var(--navy);font-weight:500}}</style><div class="c3-cc"><table><caption>What it costs to sell at four prices in Horry County, before your attorney's fee</caption><thead><tr><th scope="col">Sale price</th><th scope="col">Where it falls</th><th scope="col" class="n">Deed stamps</th><th scope="col" class="n">Fixed costs, with a mortgage to release</th><th scope="col" class="n">Each 1% of commission</th><th scope="col" class="n">Total with 5% commission (example)</th></tr></thead><tbody><tr><th scope="row">$266,000</th><td data-label="Where it falls">1 in 4 houses sold for less</td><td class="n" data-label="Deed stamps">$984</td><td class="n" data-label="Fixed costs, with a mortgage to release">$1,009</td><td class="n" data-label="Each 1% of commission">$2,660</td><td class="n" data-label="Total with 5% commission (example)">$14,309</td></tr><tr><th scope="row">$350,000</th><td data-label="Where it falls">The middle house</td><td class="n" data-label="Deed stamps">$1,295</td><td class="n" data-label="Fixed costs, with a mortgage to release">$1,320</td><td class="n" data-label="Each 1% of commission">$3,500</td><td class="n" data-label="Total with 5% commission (example)">$18,820</td></tr><tr><th scope="row">$500,000</th><td data-label="Where it falls">1 in 4 houses sold for more</td><td class="n" data-label="Deed stamps">$1,850</td><td class="n" data-label="Fixed costs, with a mortgage to release">$1,875</td><td class="n" data-label="Each 1% of commission">$5,000</td><td class="n" data-label="Total with 5% commission (example)">$26,875</td></tr><tr><th scope="row">$215,000 condo</th><td data-label="Where it falls">The middle condo</td><td class="n" data-label="Deed stamps">$796</td><td class="n" data-label="Fixed costs, with a mortgage to release">$821</td><td class="n" data-label="Each 1% of commission">$2,150</td><td class="n" data-label="Total with 5% commission (example)">$11,570</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We read the 13,194 home sales recorded in Horry County in the year to September 2026. By the state's formula, their deed stamps come to about $18 million. The middle sale's came to about $1,150.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Buying another home here as well? Our <a href="/buyers/closing-costs/" style="color:var(--navy);text-decoration:underline">closing cost calculator</a> covers the buyer's side.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Have an offer from a buyer?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send it to us. An agent reads who pays each cost under it and works out what you would keep at that price.</p><a class="btn btn-brass" href="#lead-form">Ask us to read my offer</a></div></div></section><section style="background:var(--ivory-2)" id="payoff"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The payoff">Why is my mortgage payoff more than my balance?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The <a href="https://www.consumerfinance.gov/ask-cfpb/what-is-a-payoff-amount-and-is-it-the-same-as-my-current-balance-en-205/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">payoff</a> is more than the balance on your statement. It adds the interest through the day the loan is paid off, and any fees you have been charged and not paid. Some loans also charge a prepayment penalty, a fee for paying the loan off early.</p><ol class="np-cards c3" aria-label="How the payoff works at closing"><li><span class="k">Step 1</span><b>The payoff statement is ordered</b>On a home loan made for personal use, the servicer must send an <a href="https://www.consumerfinance.gov/rules-policy/regulations/1026/36/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">accurate payoff statement</a> within seven business days of a written request. A loan made to buy a rental is not covered by that rule.</li><li><span class="k">Step 2</span><b>The loan is paid from the sale</b>At closing, the payoff comes out of the sale money before you are paid. You can sell a home before the mortgage is paid off this way.</li><li><span class="k">Step 3</span><b>The release is recorded</b>The county records the release of your mortgage for $10. On the standard contract, that fee is yours.</li></ol><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Closing day: guard the wire</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Closing money often moves by wire, and <a href="https://www.consumerfinance.gov/archive/blog/mortgage-closing-scams-how-protect-yourself-and-your-closing-funds/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">scammers send fake wiring instructions</a> by email. Never follow wiring instructions in an email. Confirm them by phone with the attorney's office, at a number you agreed on in advance.</p></div></section><section style="background:var(--ivory)" id="property-taxes"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Property taxes">Who pays the property taxes when you sell in Horry County?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You pay for the part of the year you owned the home, and the buyer pays for the rest. A year's property tax in South Carolina is <a href="https://www.scstatehouse.gov/code/t12c045.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">due between September 30 and January 15</a> after it is assessed. For most of the year, nobody has paid this year's bill yet when you close.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">At closing you give the buyer a credit for your share, and the buyer pays the whole bill when it comes. The credit is your own tax for the months you owned the home, not an extra cost.</p><figure class="np-fig np-tchart"><p class="cap">Your share of the year's tax on a $350,000 home, by closing date</p><p class="np-key" aria-hidden="true"><span class="k1">Your own home</span><span class="k2">Second home or rental</span></p><div role="table" aria-label="Your share of the year's property tax on a $350,000 home, by closing date"><div role="rowgroup"><div role="row" class="np-trow"><span role="rowheader" class="m">End of March</span><span class="np-tb t1" role="cell"><span class="b" style="--f:0.1" aria-hidden="true"></span><span class="v"><span class="sr">Your own home: </span>$317</span></span><span class="np-tb t2" role="cell"><span class="b" style="--f:0.33" aria-hidden="true"></span><span class="v"><span class="sr">Second home or rental: </span>$1,041</span></span></div><div role="row" class="np-trow"><span role="rowheader" class="m">End of June</span><span class="np-tb t1" role="cell"><span class="b" style="--f:0.202" aria-hidden="true"></span><span class="v"><span class="sr">Your own home: </span>$638</span></span><span class="np-tb t2" role="cell"><span class="b" style="--f:0.663" aria-hidden="true"></span><span class="v"><span class="sr">Second home or rental: </span>$2,093</span></span></div><div role="row" class="np-trow"><span role="rowheader" class="m">End of September</span><span class="np-tb t1" role="cell"><span class="b" style="--f:0.305" aria-hidden="true"></span><span class="v"><span class="sr">Your own home: </span>$962</span></span><span class="np-tb t2" role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v"><span class="sr">Second home or rental: </span>$3,157</span></span></div></div></div><figcaption>For most homes outside city limits, at Horry County's 2026 tax rates. A home you live in pays about $1,287 for the year; a second home or rental pays about $4,221.</figcaption></figure><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Why a second home pays about three times as much</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A second home or rental pays about three times as much. A home its owner lives in is <a href="https://www.scstatehouse.gov/code/t12c043.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">assessed at 4 percent</a> of its value and pays no school operating tax. A second home or rental is assessed at 6 percent and pays the full <a href="https://www.horrycountysc.gov/media/kufln4qp/tax-levy-2026_2.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">levy</a>, the county's tax rate.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">If the real bill comes out different</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The closing attorney figures the split from the best tax figures on hand. If the real bill comes out different, you and the buyer settle the difference between yourselves.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The bill is often smaller than one figured on today's price when the home's last deed is old. Taxable value is about 59 percent of the county's market value for a last deed before 2005, and 95 percent for 2023 to 2024. Our <a href="/buyers/property-taxes/" style="color:var(--navy);text-decoration:underline">property tax calculator</a> works out the bill for any town.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">What is your share of this year's tax?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us your address. We work out your tax credit from the county's bill for your home, not from a model.</p><a class="btn btn-brass" href="#lead-form">Have us work out my tax credit</a></div></div></section><section style="background:var(--ivory-2)" id="hoa"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="HOA charges">What HOA fees does a seller pay at closing?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The charges for the sale itself go to the side the contract names, and to you if no box is ticked. Your regular dues are split by the day, like the tax. Four kinds of charge can come with a sale:</p><ul class="np-cards c2" aria-label="HOA charges that can come with a sale"><li><span class="k">Papers</span><b>Fees for the HOA's documents</b>What the association charges to print or send its papers for the sale.</li><li><span class="k">Transfer</span><b>A transfer fee</b>A one-time fee charged only because the home changes owners.</li><li><span class="k">Statement</span><b>A letter of what you owe</b>The association's letter that says what is still owed on the home, so it can be paid at closing.</li><li><span class="k">Payment</span><b>A one-time payment to the HOA</b>Some associations charge one each time a home changes owners, paid into the association's funds.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">South Carolina has no cap on what an association can charge for its resale papers. South Carolina <a href="https://www.scstatehouse.gov/code/t27c001.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">bars a transfer fee covenant</a> recorded after February 1, 2012 that makes an owner pay a third party on each sale. A fee paid to the association itself, for purposes its documents allow, is still allowed.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Unpaid dues come out of your money</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Unpaid HOA fees are usually a lien on the home, a legal claim against it, and they come out of the seller's money at closing. We look for them before closing, so they are not a surprise.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On a condo sale, <a href="https://www.scstatehouse.gov/code/t27c031.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">state law</a> pays unpaid association charges out of the sale price first, after past-due taxes and recorded mortgages. The association must give the buyer a statement of what you owe, on request.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A special assessment is a one-time charge the association votes for a project. For one approved before closing, the contract has two boxes: you pay all of it, or only the part due in the year of closing. One approved after closing is the buyer's. Our <a href="/hoa/estoppel-and-transfer-fees/" style="color:var(--navy);text-decoration:underline">guide to HOA fees when a home sells</a> and <a href="/hoa/special-assessments/" style="color:var(--navy);text-decoration:underline">special assessments page</a> go further.</p></div></section><section style="background:var(--ivory)" id="out-of-state"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Out-of-state sellers">I live outside South Carolina. Will the state hold back part of my money?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, unless the sale is your main home and the whole gain is excluded from federal tax. When your permanent home is in another state, <a href="https://www.scstatehouse.gov/code/t12c008.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">state law</a> says the buyer must hold back part of the price for South Carolina income tax.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The rate is 5.21 percent for a 2026 sale, the state's top rate. It applies to your gain if you sign the state's gain affidavit, Form I-295, a signed statement of your gain. If you do not, it applies to the price less your selling costs.</p><div class="np-stat"><p class="k">Worked example: the middle condo, $215,000, sold by an owner who lives in another state</p><ul><li><strong>About $11,000</strong><span>held back with no gain affidavit, 5.21 percent of the price less your selling costs</span></li><li><strong>About $2,600</strong><span>held back with the affidavit, on a gain of $50,000 (an example)</span></li></ul></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If the closing attorney's office holds the tax back, it must send it to the state on time. The amount counts toward your tax when you file a South Carolina return.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About 6 in 10 Horry County condo units, and about 1 in 5 other homes, have their tax bill mailed to an address outside South Carolina. Our <a href="/sell/capital-gains/" style="color:var(--navy);text-decoration:underline">capital gains page</a> works more examples.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">How much would be held back on your sale?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us the price and what you paid. We work out the hold-back with and without the affidavit, so you know what to expect at closing.</p><a class="btn btn-brass" href="#lead-form">Ask us about the hold-back</a></div></div></section><section style="background:var(--ivory-2)" id="keep-more"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Keep more">How do sellers here keep more of the price?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Start with the price, the biggest number you control. On a $350,000 home, each 1 percent off the asking price is $3,500, the same as 1 percent of commission.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We checked every resale house and townhouse for sale in Horry County for a price cut. Of 2,187 resale houses and townhouses for sale in Horry County, 1,264 (nearly 6 in 10) have cut their asking price. The cheaper the house, the more have cut:</p><figure class="c3-gchart"><div role="table" aria-label="Resale houses for sale in Horry County that have cut their asking price"><span class="cap" aria-hidden="true">Resale houses for sale in Horry County that have cut their asking price</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Asking price, how many</span><span role="columnheader">share with a price cut</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Under $300,000</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">325 of 498 for sale</span></span><span role="cell"><span class="b" style="--f:0.653" aria-hidden="true"></span><span class="v">65%</span></span></div><div role="row"><span role="rowheader"><span class="n">$300,000 to $450,000</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">403 of 707 for sale</span></span><span role="cell"><span class="b" style="--f:0.57" aria-hidden="true"></span><span class="v">57%</span></span></div><div role="row"><span role="rowheader"><span class="n">$450,000 to $700,000</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">311 of 563 for sale</span></span><span role="cell"><span class="b" style="--f:0.552" aria-hidden="true"></span><span class="v">55%</span></span></div><div role="row"><span role="rowheader"><span class="n">Over $700,000</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">225 of 419 for sale</span></span><span role="cell"><span class="b" style="--f:0.537" aria-hidden="true"></span><span class="v">54%</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Resale condos, all prices</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">1,347 of 2,627 for sale</span></span><span role="cell"><span class="b" style="--f:0.513" aria-hidden="true"></span><span class="v">51%</span></span></div></div></div><figcaption>Our count of every resale house and townhouse for sale in the county, from the listing feed, in total only. A price cut means the asking price is now below the first one.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our <a href="/sell/home-value/" style="color:var(--navy);text-decoration:underline">home value page</a> shows how we price a home from the recorded sales most like it.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Home warranties are rare on resale homes here</h3><div class="np-stat"><p class="k">Homes for sale in Horry County that advertise a home warranty</p><ul><li><strong>935 of 1,000</strong><span>houses and townhouses advertising one are new construction</span></li><li><strong>About 3 in 100</strong><span>resale houses advertise one: 65 of 2,187</span></li></ul></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The standard contract has no home warranty clause. Buyer and seller can add one with a separate addendum.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Credits to the buyer</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A credit toward the buyer's closing costs comes out of your side. The contract names the most you will pay. If the buyer's costs come in lower, or the lender allows less, the rest stays with you.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Loans limit credits too. On an <a href="https://www.hud.gov/sites/default/files/Housing/documents/40001-hsgh-Update-18.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FHA loan</a>, the seller and others can pay up to 6 percent of the price toward the buyer's closing costs, prepaid items and points. On a <a href="https://www.va.gov/housing-assistance/home-loans/funding-fee-and-closing-costs/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">VA loan</a>, a seller can pay all the closing costs, but other concessions are capped at 4 percent of the home's value.</p></div></section><section style="background:var(--ivory)" id="tax"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Tax on the gain">Do you pay tax on the money from selling your house?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Often not, if it was your main home. Your selling costs also lower the gain you are taxed on.</p><ul class="np-cards c3" aria-label="Federal tax on the sale of a home"><li><span class="k">The exclusion</span><b>Up to $250,000 of gain</b>Or $500,000 for a married couple filing jointly, if you <a href="https://www.irs.gov/taxtopics/tc701" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">owned and lived in the home</a> at least 2 of the last 5 years.</li><li><span class="k">Your costs</span><b>They lower the gain</b>You <a href="https://www.irs.gov/publications/p523" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">subtract the commission</a>, legal fees and the deed stamps from the price before you figure the gain.</li><li><span class="k">The report</span><b>Form 1099-S</b>The closing attorney's office reports most sales to the <a href="https://www.irs.gov/instructions/i1099s" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">IRS</a>. A main home sold for $250,000 or less ($500,000 if married) can be left off, if you certify the whole gain is excluded.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A rental or a second home is taxed differently. Our <a href="/sell/capital-gains/" style="color:var(--navy);text-decoration:underline">capital gains guide</a> and <a href="/sell/rental-property/" style="color:var(--navy);text-decoration:underline">rental property page</a> work through it.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Ready for a price on your home?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We pull the recorded sales closest to your home and send a price range with a net sheet at that price, free.</p><a class="btn btn-brass" href="#lead-form">Ask us for a price and a net sheet</a></div></div></section><section style="background:var(--ivory-2)" id="lead-form"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Your own net sheet">Get a net sheet for your own home</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Send the address and what you owe. A licensed agent builds your net sheet with every line on this page, the attorney's fee and the HOA charges included. It is free, and you are under no obligation.</p><div id="ldWrap" class="np-form-box"><div class="idx-lead" style="grid-template-columns:1fr"><input class="idx-input" id="ldCtx" placeholder="Property address" aria-label="Property address" autocomplete="street-address"></div><div class="idx-lead"><input class="idx-input" id="ldName" placeholder="Your name" aria-label="Your name" autocomplete="name"><input class="idx-input" id="ldPhone" placeholder="Phone" aria-label="Phone" type="tel" autocomplete="tel"></div><div class="idx-lead" style="grid-template-columns:1fr"><input class="idx-input" id="ldEmail" placeholder="Email" aria-label="Email" type="email" autocomplete="email"></div><label class="np-consent"><input type="checkbox" id="ldConsent"><span>I consent to receive calls and text messages from Chapter 3 Realty about my property inquiry, showing appointments, and listing information I requested, at the phone number provided, including calls placed using an automated system or an artificial or prerecorded voice. Message frequency varies. Message and data rates may apply. Reply HELP for help, STOP to opt out. Consent is not a condition of any purchase.</span></label><p id="ldErr" class="np-err" role="alert"></p><button type="button" class="btn btn-brass btn-lg" onclick="ldSubmit()">Send my net sheet request</button><p class="np-tel">Free, and no obligation. Prefer to talk now?</p><a class="btn btn-outline np-call" href="tel:+18543332135">Call 854.333.2135</a></div><div id="ldOk" class="np-ok">Thanks. A licensed team member will reach out with your seller net sheet.</div><script>function ldSubmit(){var cx=document.getElementById('ldCtx').value.trim(),n=document.getElementById('ldName').value.trim(),ph=document.getElementById('ldPhone').value.trim(),em=document.getElementById('ldEmail').value.trim(),c=document.getElementById('ldConsent').checked,err=document.getElementById('ldErr');function fail(m){err.textContent=m;err.style.display='block';}err.style.display='none';if(!cx||!n){fail('Add the property address and your name.');return;}if(!ph&&!em){fail('Add a phone number or an email so we can reach you.');return;}if(!c){fail('Check the consent box to send the request.');return;}c3SendForm({property_address:cx,name:n,phone:ph,email:em,consent:c?'yes':'no'},'net-proceeds');document.getElementById('ldWrap').style.display='none';document.getElementById('ldOk').style.display='block';}</script><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Selling it yourself instead? Our <a href="/sell/fsbo/" style="color:var(--navy);text-decoration:underline">for sale by owner guide</a> covers the costs that stay the same. Selling from far away? Our page for <a href="/sell/out-of-state-buyers/" style="color:var(--navy);text-decoration:underline">selling from out of state</a> explains the steps.</p></div></section><section style="background:var(--ivory)" id="seller-costs-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Seller costs FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What is a seller net sheet?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A list of every line on your side of the closing. It starts with the price, takes off the payoff and your costs, and adds or takes off the tax split. The $350,000 example at the top of this page is one.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Who pays title insurance in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On the state REALTORS association's standard contract, the buyer pays both title insurance policies, the owner's and the lender's. Buyer and seller can agree to something else in writing.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How much are deed stamps in South Carolina, and who pays them?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">$1.85 for each $500 of the price, and the seller owes them. On a $350,000 sale they come to $1,295.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does the seller need an attorney in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Every South Carolina home closing must be supervised by a South Carolina attorney. If the buyer has a loan for a home they will live in, the buyer chooses the closing attorney. That attorney does not advise you, and your own attorney is a seller's cost on the standard contract.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I sell my house before my mortgage is paid off?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. The payoff is paid at closing from the sale money, and you keep what is left.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is the commission always 6 percent?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. Agents' fees are negotiable, and no law fixes them. On a $350,000 home, each 1 percent is $3,500.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How do I avoid wire fraud at closing?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Never follow wiring instructions in an email. Confirm them by phone with the attorney's office, at a number you agreed on in advance.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://screaltors.org/wp-content/uploads/2026/02/310.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC REALTORS Form 310</a>, <a href="https://www.scstatehouse.gov/code/t12c024.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-24</a>, <a href="https://www.scstatehouse.gov/code/t08c021.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">8-21</a>, <a href="https://www.scstatehouse.gov/code/t12c045.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">12-45</a>, <a href="https://www.scstatehouse.gov/code/t12c043.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">12-43</a>, <a href="https://www.scstatehouse.gov/code/t27c001.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">27-1</a>, <a href="https://www.scstatehouse.gov/code/t27c031.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">27-31</a>, <a href="https://www.scstatehouse.gov/code/t12c008.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">12-8</a>, <a href="https://www.horrycountysc.gov/media/kufln4qp/tax-levy-2026_2.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County 2026 levy</a>, <a href="https://www.consumerfinance.gov/ask-cfpb/what-is-a-payoff-amount-and-is-it-the-same-as-my-current-balance-en-205/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">CFPB</a>, <a href="https://www.consumerfinance.gov/rules-policy/regulations/1026/36/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">12 CFR 1026.36</a>, <a href="https://www.irs.gov/publications/p523" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">IRS Pub 523</a>, <a href="https://www.hud.gov/sites/default/files/Housing/documents/40001-hsgh-Update-18.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">HUD 4000.1</a>, <a href="https://www.va.gov/housing-assistance/home-loans/funding-fee-and-closing-costs/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">VA</a>, <a href="https://www.nar.realtor/the-facts/what-the-nar-settlement-means-for-home-buyers-and-sellers" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NAR</a>, <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeDocType" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">County deeds</a>. Prices and deed stamps: our count of county deeds. Listings: our count of homes for sale, in total only. Not legal or tax advice.</p><style>.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Horry County's courthouse and county office complex, Conway. Photo: Pollinator at English Wikipedia, <a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 3.0</a>, via <a href="https://commons.wikimedia.org/wiki/File:New_Horry_County_Courthouse_and_county_office_complex,_Conway,_South_Carolina_(18_November_2006).jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>. Chapter3 Realty resized it to 1200 and 600 px wide WebP files.</div><div role="listitem">Chapter3 Realty resized these photos and cropped some of them. Each photo keeps the license listed with it.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-11-a/sell-net-proceeds/horry-county-government-complex-conway-1200w.webp","url":"https://chapter3realty.com/images/2026-11-a/sell-net-proceeds/horry-county-government-complex-conway-1200w.webp","width":1200,"height":800,"encodingFormat":"image/webp","name":"A brick government complex with a white-columned entrance and a parking lot in front, in Conway","caption":"Horry County's courthouse and county office complex in Conway, in 2006.","description":"A brick government complex with a white-columned entrance and a parking 