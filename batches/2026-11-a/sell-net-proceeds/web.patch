+
+    <button class="o-expandable__header" data-section="36(e)(2) Permissible Transactions">
+        <span class="o-expandable__label">
+            Official interpretation of 36(e)(2) Permissible Transactions
+        </span>
+        <span class="o-expandable__cues">
