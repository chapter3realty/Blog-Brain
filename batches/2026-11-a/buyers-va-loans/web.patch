 housing\u003c/li\u003e\n\u003cli\u003eJob training, life skills development, and education\u003c/li\u003e\n\u003cli\u003eJustice system navigation and community reentry from jail\u003c/li\u003e\n\u003cli\u003eFinancial support to prevent homelessness\u003c/li\u003e\n\u003cli\u003eAddiction and depression treatment\u003c/li\u003e\n\u003cli\u003eHealth and dental care\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003ca data-entity-substitution=\"canonical\" data-entity-type=\"node\" data-entity-uuid=\"f5592adb-3733-43fc-9cd3-c154405eaf01\" href=\"/charleston-health-care/health-services/homeless-veteran-care\" title=\"Homeless Veteran care\"\u003eLearn more and connect with a care coordinator\u003c/a\u003e\u003c/p\u003e\n","isMentalHealthService":false,"locations":[{"type":"paragraph--service_location","id":"a6753078-6d0c-4fa5-b2f3-339f94f84e00","officeVisits":null,"virtualSupport":null,"apptIntroTextType":"use_default_text","apptIntroTextCustom":null,"appointmentPhoneNumbers":[],"onlineSchedulingAvail":null,"contactInfoPhoneNumbers":[],"emailContacts":[],"hours":"0","officeHours":[],"additionalHoursInfo":null,"useMainFacilityPhone":true,"useFacilityPhoneNumber":true,"serviceLocationAddress":{"type":"paragraph--service_location_address","id":"3adaeb6c-1718-480c-a5cb-da275e61a2cd","drupal_internal__id":46233,"drupal_internal__revision_id":1319788,"langcode":"en","status":true,"created":"2021-06-09T20:16:43+00:00","parent_id":"46234","parent_type":"paragraph","parent_field_name":"field_service_location_address","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":null,"field_address":{"langcode":null,"country_code":"US","administrative_area":"","locality":"","dependent_locality":null,"postal_code":"","sorting_code":null,"address_line1":"","address_line2":null},"field_building_name_number":null,"field_clinic_name":null,"f