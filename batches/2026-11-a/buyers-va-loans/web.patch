. Below, you’ll find our address and hours, parking and transportation information, and the other health services we offer at Ralph H. Johnson VA Health Care System in Charleston.</p></div><div data-template="facilities/facilities_health_services_buttons" data-testid="facility-top-tasks" class="vads-u-margin-bottom--6"><va-link-action class="vads-u-display--block" href="/charleston-health-care/make-an-appointment" text="Make an appointment" type="secondary"></va-link-action><va-link-action class="vads-u-display--block" href="/charleston-health-care/register-for-care" text="Register for care" type="secondary"></va-link-action><va-link-action class="vads-u-display--block" href="/charleston-health-care/pharmacy" text="Learn about pharmacy services" type="secondary"></va-link-action></div><div data-testid="on-this-page"></div><h2 id="location-and-contact-information" class="vads-u-margin-bottom--3">Location and contact information</h2><div class="vads-grid-row vads-u-flex-wrap--nowrap vads-u-flex-direction--column mobile-lg:vads-u-flex-direction--row vads-u-margin-bottom--4 tablet:vads-u-margin-bottom--5 vads-grid-gap-2"><section class="mobile-lg:vads-grid-col-6 tablet:vads-grid-col-7"><div><section><script type="application/ld+json">{"@context":"https://schema.org","@type":"Place","address":{"@type":"PostalAddress","streetAddress":"109 Bee Street","addressLocality":"Charleston","addressRegion":"SC","postalCode":"29401-5799"},"name":"Ralph H. Johnson Department of Veterans Affairs Medical Center","telephone":"843-577-5011","openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":"https://schema.org/Monday","opens":"","closes":""},{"@type":"OpeningHoursSpecification","dayOfWeek":"https://schema.org/Tuesday","opens":"","closes":""},{"@type":"OpeningHoursSpecification","dayOfWeek":"https://schema.org/Wednesday","opens":"","closes":""},{"@type":"OpeningHoursSpecification","dayOfWeek":"https://schema.org/Thursday","opens":"","closes":""},{"@type":"Openin