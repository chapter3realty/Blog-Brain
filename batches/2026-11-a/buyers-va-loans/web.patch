d":"0f967ee1-15d5-4190-9e7b-99486ec54862","entityBundle":"health_care_local_health_service","fieldBody":"\u003cp\u003eWe offer a range of hematology and oncology services. You can arrange appointments and consultation through your primary care provider. Our hematology and oncology services include:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eChemotherapy\u003c/li\u003e\n\u003cli\u003eBlood and platelet transfusions\u003c/li\u003e\n\u003cli\u003eMediport flushes to clean and maintain the small medical appliance inserted under your skin, making it easier to inject drugs and draw blood\u003c/li\u003e\n\u003cli\u003eEvaluation and treatment of blood disorders and cancer\u003c/li\u003e\n\u003cli\u003eDedicated outpatient infusion center, working closely with radiation oncology, interventional radiology, general surgery, diagnostics, palliative care, and social services\u003c/li\u003e\n\u003cli\u003eBone marrow biopsies, to see whether your bone tissue is healthy and making a normal number of blood cells\u003c/li\u003e\n\u003c/ul\u003e\n","isMentalHealthService":false,"locations":[{"type":"paragraph--service_location","id":"34f45818-c9a0-4894-8bc0-068587a6da74","officeVisits":null,"virtualSupport":null,"apptIntroTextType":"use_default_text","apptIntroTextCustom":null,"appointmentPhoneNumbers":[],"onlineSchedulingAvail":null,"contactInfoPhoneNumbers":[],"emailContacts":[],"hours":"0","officeHours":[],"additionalHoursInfo":null,"useMainFacilityPhone":true,"useFacilityPhoneNumber":true,"serviceLocationAddress":{"type":"paragraph--service_location_address","id":"458369a7-23bf-44db-ad0d-37973bf8b52e","drupal_internal__id":46231,"drupal_internal__revision_id":1319786,"langcode":"en","status":true,"created":"2021-06-09T20:16:43+00:00","parent_id":"46232","parent_type":"paragraph","parent_field_name":"field_service_location_address","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_tra