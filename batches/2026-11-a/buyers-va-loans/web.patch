+<!DOCTYPE html><html lang="en" dir="ltr"><head><meta charSet="utf-8" data-next-head=""/><meta charSet="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0" data-next-head=""/><meta http-equiv="X-UA-Compatible" content="IE=edge" data-next-head=""/><meta name="HandheldFriendly" content="True" data-next-head=""/><meta name="MobileOptimized" content="320" data-next-head=""/><link rel="canonical" href="https://www.va.gov/housing-assistance/home-loans/loan-limits/" data-next-head=""/><meta property="og:url" content="https://www.va.gov/housing-assistance/home-loans/loan-limits/" data-next-head=""/><meta property="og:type" content="website" data-next-head=""/><meta name="DC.Date" content="2025-08-12" data-next-head=""/><title data-next-head="">VA Home Loan Entitlement And Limits | Veterans Affairs</title><meta name="description" content="Your Certificate of Eligibility (COE) for VA home loan benefits shows the amount of your entitlement for a VA home loan guaranty. Keep reading to learn about entitlement and home loan limits." data-next-head=""/><link rel="image_src" href="https://www.va.gov/img/design/logo/va-og-image.png" data-next-head=""/><meta property="og:site_name" content="Veterans Affairs" data-next-head=""/><meta property="og:title" content="VA home loan entitlement and limits | Veterans Affairs" data-next-head=""/><meta property="og:description" content="Your Certificate of Eligibility (COE) for VA home loan benefits shows the amount of your entitlement for a VA home loan guaranty. Keep reading to learn about entitlement and home loan limits." data-next-head=""/><meta property="og:image" content="https://www.va.gov/img/design/logo/va-og-image.png" data-next-head=""/><meta property="og:image:alt" content="U.S. Department of Veterans Affairs" data-next-head=""/><meta name="twitter:card" content="summary_large_image" data-next-head=""/><meta name="twitter:site" content="@DeptVetAffairs" data-next-head=""/><meta name="twitter:description" content="Your Certificate of Eligibility (COE) for VA home loan benefits shows the amount of your entitlement for a VA home loan guaranty. Keep reading to learn about entitlement and home loan limits." data-next-head=""/><meta name="twitter:title" content="VA home loan entitlement and limits | Veterans Affairs" data-next-head=""/><meta name="twitter:image:alt" content="U.S. Department of Veterans Affairs" data-next-head=""/><meta name="twitter:image" content="https://www.va.gov/img/design/logo/va-og-image.png" data-next-head=""/><link rel="preconnect" href="https://www.googletagmanager.com"/><link href="/img/design/icons/apple-touch-icon.png" rel="apple-touch-icon-precomposed"/><link href="/img/design/icons/apple-touch-icon-72x72.png" rel="apple-touch-icon-precomposed" sizes="72x72"/><link href="/img/design/icons/apple-touch-icon-114x114.png" rel="apple-touch-icon-precomposed" sizes="114x114"/><link href="/img/design/icons/apple-touch-icon-152x152.png" rel="apple-touch-icon-precomposed" sizes="144x144"/><link rel="shortcut icon" sizes="any" href="/img/design/icons/favicon.ico"/><link nonce="JdcPLyoqykJd8zJyRansAKHsH2HIZSAe" rel="preload" href="/_next/static/chunks/1u1qi4l-ezvo3.css" as="style"/><link nonce="JdcPLyoqykJd8zJyRansAKHsH2HIZSAe" rel="preload" href="/_next/static/chunks/1b2smbz_7kru_.css" as="style"/><link href="https://prod-va-gov-assets.s3-us-gov-west-1.amazonaws.com/generated/static-pages.css" data-entry-name="static-pages.css" rel="stylesheet"/><link rel="stylesheet" href="https://prod-va-gov-assets.s3-us-gov-west-1.amazonaws.com/generated/style.css"/><link rel="stylesheet" href="https://prod-va-gov-assets.s3-us-gov-west-1.amazonaws.com/generated/web-components.css"/><link nonce="JdcPLyoqykJd8zJyRansAKHsH2HIZSAe" rel="stylesheet" href="/_next/static/chunks/1u1qi4l-ezvo3.css" data-n-g=""/><link nonce="JdcPLyoqykJd8zJyRansAKHsH2HIZSAe" rel="stylesheet" href="/_next/static/chunks/1b2smbz_7kru_.css" data-n-p=""/><noscript data-n-css="JdcPLyoqykJd8zJyRansAKH