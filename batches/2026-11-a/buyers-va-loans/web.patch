+<script>
+  function onContactUsSubmit(token) {
+    if (validateForm()) {
+      document.getElementById("ReCaptchaToken").value = token;
+      document.getElementById("contact-form").submit();
+    }
+  }
+
+  function isEmpty(input) {
+    return !input.value.trim().length
+  }
+
+  function isEmailAddress(input) {
+    return /^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,3})+$/.test(input.value)
+  }
+
+  const errorSummary = {
+    name: {},
+    email: {},
+    phone: {},
+    body: {}
+  }
+
+  function validateName(updateSummary) {
+    const nameInput = document.getElementById("Name")
+    if (isEmpty(nameInput)) {
+      nameInput.classList.add('error-state')
+      errorSummary.name = { error: true, message: 'Name is Required' }
+    } else {
+      nameInput.classList.remove('error-state')
+      errorSummary.name.error = false
+    }
+    if (updateSummary) updateErrorSummary()
+  }
+
+  function validatePhone(updateSummary) {
+    const phoneInput = document.getElementById("PhoneNumber")
+    if (isEmpty(phoneInput)) {
+      phoneInput.classList.add('error-state')
+      errorSummary.phone = { error: true, message: 'Phone number is Required' }
+    } else {
+      phoneInput.classList.remove('error-state')
+      errorSummary.phone.error = false
+    }
+    if (updateSummary) updateErrorSummary()
+  }
+
+  function validateEmail(updateSummary) {
+    const emailInput = document.getElementById("Email")
+    if (isEmpty(emailInput)) {
+      emailInput.classList.add('error-state')
+      errorSummary.email = { error: true, message: 'Email is Required' }
+    } else if (!isEmailAddress(emailInput)) {
+      emailInput.classList.add('error-state')
+      errorSummary.email = { error: true, message: `'${emailInput.value}' is not a valid Email address.` }
+    } else {
+      emailInput.classList.remove('error-state')
+      errorSummary.email.error = false
+    }
+    if (updateSummary) updateErrorSummary()
+  }
+
+  function validateBody(updateSummary) {
+    const bodyInput = document.getElementById("Body")
+    if (isEmpty(bodyInput)) {
+      bodyInput.className = 'error'
+      errorSummary.body = { error: true, message: 'Body is Required' }
+    } else {
+      bodyInput.className = ''
+      errorSummary.body.error = false
+    }
+    if (updateSummary) updateErrorSummary()
+  }
+
+  function validateForm() {
+    validateName()
+    validateEmail()
+    validatePhone()
+    validateBody()
+    updateErrorSummary()
+    return !(errorSummary.name.error || errorSummary.email.error || errorSummary.phone.error || errorSummary.body.error)
+  }
+
+  function createErrorSummaryDiv(message) {
+    const newDiv = document.createElement("div")
+    newDiv.className = "error-messages"
+    const newContent = document.createTextNode(message)
+    newDiv.appendChild(newContent)
+    return newDiv
+  }
+  function appendErrorSummary(summaryDiv, summary) {
+    if (summary.error) {
+      const newDiv = createErrorSummaryDiv(summary.message)
+      summaryDiv.appendChild(newDiv)
+    }
+  }
+  function updateErrorSummary() {
+    const errorSummaryDiv = document.getElementById("va_errorSummary")
+    if (errorSummary.name.error || errorSummary.email.error || errorSummary.phone.error || errorSummary.body.error) {
+      errorSummaryDiv.innerHTML = '' // clear error summary div
+      appendErrorSummary(errorSummaryDiv, errorSummary.name)
+      appendErrorSummary(errorSummaryDiv, errorSummary.email)
+      appendErrorSummary(errorSummaryDiv, errorSummary.phone)
+      appendErrorSummary(errorSummaryDiv, errorSummary.body)
+      errorSummaryDiv.style.opacity = 1 // show div
+    } else {
+      errorSummaryDiv.style.opacity = 0 // hide div
+    }
+  }
+</script>
