ldHealthServiceApiId":"emergencyCare"},{"name":"Geriatrics","fieldAlsoKnownAs":"Older adult care, senior care","fieldCommonlyTreatedCondition":"memory problems, sleep problems, falls, bone loss, weight loss","fieldReferralRequired":"2","fieldTricareDescription":null,"description":"As you age, we offer a range of medical and support services to help you stay as healthy, active and independent as possible. We also offer help to family members and caregivers who may support you.","entityId":"0cf2cff8-9012-419c-b8f9-fa625b4ca364","entityBundle":"health_care_local_health_service","fieldBody":"\u003cp\u003eWe assess your situation and condition to decide which outpatient geriatric services are right for you or a senior Veteran in your care, and then we coordinate your care. Our team of specialists provides geriatric services that include:\u003c/p\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eMedicine and nursing\u003c/li\u003e\n\u003cli\u003ePsychology, psychiatry, and social work\u003c/li\u003e\n\u003cli\u003ePhysical and occupational therapy\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003ca href=\"https://www.va.gov/Geriatrics/\"\u003eLearn more about VA long-term care\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003e\u003ca data-entity-substitution=\"canonical\" data-entity-type=\"node\" data-entity-uuid=\"d0cb0842-065b-44cc-856d-e8d7d9944c5b\" href=\"/charleston-health-care/programs/the-medical-foster-home-program\" title=\"The Medical Foster Home Program\"\u003eLearn more about our Medical Foster Home Program\u003c/a\u003e\u003c/p\u003e\n","isMentalHealthService":false,"locations":[{"type":"paragraph--service_location","id":"c394f29b-f1d3-4710-9d5e-5d9bdf4dbf5a","officeVisits":null,"virtualSupport":null,"apptIntroTextType":"use_default_text","apptIntroTextCustom":null,"appointmentPhoneNumbers":[],"onlineSchedulingAvail":null,"contactInfoPhoneNumbers":[],"emailContacts":[],"hours":"0","officeHours":[],"additionalHoursInfo":null,"useMainFaci