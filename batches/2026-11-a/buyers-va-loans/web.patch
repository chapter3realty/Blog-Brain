78,"drupal_internal__target_id":46239},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"bd794386-a382-48d0-84fb-47290c3c1176","resourceIdObjMeta":{"drupal_internal__target_id":"service_location_address"}},"relationshipNames":["paragraph_type"]}}],"fieldFacilityLocatorApiId":"vha_534","fieldHealthServiceApiId":"mentalHealth"},{"name":"Minority Veteran care","fieldAlsoKnownAs":"","fieldCommonlyTreatedCondition":"","fieldReferralRequired":"2","fieldTricareDescription":null,"description":"We offer resources and support for minority Veterans to help address your specific needs with benefits and services at VA.","entityId":"a0efae1d-b328-452a-b8e9-51a7eafcacf9","entityBundle":"health_care_local_health_service","fieldBody":"\u003cp\u003eIf you’re a minority Veteran, we can help you get the services and benefits you need. Our Minority Veterans Program serves all Veterans who are Black American, Asian American, Hispanic American, and Native American (including American Indians, Alaska Natives, Native Hawaiians, and Pacific Island Americans). We work to:\u003c/p\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eHelp the medical center address minority Veterans’ needs\u003c/li\u003e\n\u003cli\u003eMeet minority Veterans’ needs in the local community\u003c/li\u003e\n\u003cli\u003eIdentify barriers and create a more accessible environment for minority Veterans\u003c/li\u003e\n\u003cli\u003eInform minority Veterans of VA benefits, services, and programs\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003ca data-entity-substitution=\"canonical\" data-entity-type=\"node\" data-entity-uuid=\"198b2894-f640-42d6-8592-53e0468032c8\" href=\"/charleston-health-care/health-services/minority-veteran-care\" title=\"Minority Veteran care\"\u003eLearn more and connect with a care coordinator\u003c/a\u003e\u003c/p\u003e\n","isMentalHealthService":false,"locations":[{"type":"paragraph--service_location","id":"2e8b6969-2959-47fb-b64a-702b15d37d83","off