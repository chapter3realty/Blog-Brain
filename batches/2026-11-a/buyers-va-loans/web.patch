ppointmentPhoneNumbers":[],"onlineSchedulingAvail":null,"contactInfoPhoneNumbers":[],"emailContacts":[],"hours":"0","officeHours":[],"additionalHoursInfo":null,"useMainFacilityPhone":true,"useFacilityPhoneNumber":true,"serviceLocationAddress":{"type":"paragraph--service_location_address","id":"580c61bd-03d1-4be9-a832-79697a302e62","drupal_internal__id":46253,"drupal_internal__revision_id":1319809,"langcode":"en","status":true,"created":"2021-06-09T20:16:43+00:00","parent_id":"46254","parent_type":"paragraph","parent_field_name":"field_service_location_address","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":null,"field_address":{"langcode":null,"country_code":"US","administrative_area":"","locality":"","dependent_locality":null,"postal_code":"","sorting_code":null,"address_line1":"","address_line2":null},"field_building_name_number":null,"field_clinic_name":null,"field_use_facility_address":true,"field_wing_floor_or_room_number":null,"links":{"self":{"href":"https://prod.cms.va.gov/jsonapi/paragraph/service_location_address/580c61bd-03d1-4be9-a832-79697a302e62?resourceVersion=id%3A1319809"},"working-copy":{"href":"https://prod.cms.va.gov/jsonapi/paragraph/service_location_address/580c61bd-03d1-4be9-a832-79697a302e62?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":1319809,"drupal_internal__target_id":46253},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"bd794386-a382-48d0-84fb-47290c3c1176","resourceIdObjMeta":{"drupal_internal__target_id":"service_location_address"}},"relationshipNames":["paragraph_type"]}}],"fieldFacilityLocatorApiId":"vha_534","fieldHealthServiceApiId":"pharmacy"},{"name":"Primary care","fieldAlsoKnownAs":"Family and internal medicine","fieldCommonlyTreatedCondition":"","fieldReferralRequired":"1","fieldTricareDescription":null,"description":"\u003cp\u003eYour VA primary care provider will work closely with you to plan for all the care you need to stay healthy and well throughout your life, including immunizations and vaccinations. They will also work with\u0026nbsp;family members or caregivers who support you.\u003c/p\u003e","entityId":"d5e740d1-3549-4d5f-a036-deaa54bb5aaa","entityBundle":"health_care_local_health_service","fieldBody":"\u003cp\u003eA strong network of family and internal medicine specialists and services can offer you the best possible care. Internal medicine doctors (internists) prevent, diagnose, and treat adult diseases. Doctors who specialize in family medicine provide primary health care to the entire family. Your primary care team can coordinate the many services you receive such as:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eLabs and blood work\u003c/li\u003e\n\u003cli\u003eMental health care\u003c/li\u003e\n\u003cli\u003eWomens health care\u003c/li\u003e\n\u003cli\u003eRadiology\u003c/li\u003e\n\u003cli\u003eSocial services\u003c/li\u003e\n\u003cli\u003eTelehealth\u003c/li\u003e\n\u003c/ul\u003e\n","isMentalHealthService":false,"locations":[{"type":"paragraph--service_location","id":"1c01c289-c03b-4506-8605-46875812bb4c","officeVisits":"yes_appointment_only","virtualSupport":"yes_appointment_only","apptIntroTextType":"customize_text","apptIntroTextCustom":"Primary Care services offered here are dedicated to Veterans enrolled in our PACT program. For general primary care, please find the clinic closest to you. ","appointmentPhoneNumbers":[],"onlineSchedulingAvail":"no","contactInfoPhoneNumbers":[],"emailContacts":[],"hours":"0","officeHours":[],"additionalHoursInfo":null,"useMainFacilityPhone":true,"useFacilityPhoneNumber":true,"serviceLocationAddress":{"type":"paragraph--service_location_address","id":"54e80ff7-1383-4f9e-917f-0b81c9e40a37","drupal_internal__id":46229,"drupal_internal__revision_id":2064719,"langcode":"en","status":true,"created":"2021-06-09T20:16:43+00:00","parent_id":"46230","parent_type":"paragraph","parent_field_name":"field_service_location_address","behavior_settings":[],"default_langcode":true,"revision_translation_affected":true,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":null,"field_address":{"langcode":"en","country_code":"US","administrative_area":"","locality":"","dependent_locality":null,"postal_code":"","sorting_code":null,"address_line1":"","address_line2":""},"field_building_name_number":null,"field_clinic_name":null,"field_use_facility_address":true,"field_wing_floor_or_room_number":null,"links":{"self":{"href":"https://prod.cms.va.gov/jsonapi/paragraph/service_location_address/54e80ff7-1383-4f9e-917f-0b81c9e40a37?resourceVersion=id%3A2064719"},"working-copy":{"href":"https://prod.cms.va.gov/jsonapi/paragraph/service_location_address/54e80ff7-1383-4f9e-917f-0b81c9e40a37?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":2064719,"drupal_internal__target_id":46229},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"bd794386-a382-48d0-84fb-47290c3c1176","resourceIdObjMeta":{"drupal_internal__target_id":"service_location_address"}},"relationshipNames":["paragraph_type"]}}],"fieldFacilityLocatorApiId":"vha_534","fieldHealthServiceApiId":"primaryCare"},{"name":"Rehabilitation and extended care","fieldAlsoKnownAs":"","fieldCommonlyTreatedCondition":"","fieldReferralRequired":"2","fieldTricareDescription":"We can provide medical care and rehabilitation services in your home and in our Community Living Center. We offer home-based primary care, medical foster home support, hospice, and palliative care.","description":"We provide medical care and rehabilitation services to Veterans in our Community Living Center and in their homes. Services include home-based primary care, medical foster home support, and hospice and palliative care.","entityId":"d0dbe2b1-7130-446c-aff4-6f2bd8b8b0b9","entityBundle":"health_care_local_health_service","fieldBody":"\u003cp\u003eWe provide long-term care to help you and your family when you’re dealing with a disability, chronic (long-lasting) illness, terminal illness, or serious health issues related to aging. Our long-term health care services include:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e24/7 nursing and medical care\u003c/li\u003e\n\u003cli\u003ePhysical therapy\u003c/li\u003e\n\u003cli\u003eHelp with daily tasks like bathing, dressing, making meals, and taking medicine\u003c/li\u003e\n\u003cli\u003ePain management and palliative care to relieve suffering and improve quality of life for people with serious illnesses\u003c/li\u003e\n\u003cli\u003eHospice care to provide comfort and compassionate care for people in the last phases of an incurable illness\u003c/li\u003e\n\u003cli\u003eTo learn more about the different types of extended care that VA provides, see our guide to long-term services and support.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003ca href=\"https://www.va.gov/Geriatrics/\"\u003eLearn more about VA long-term care\u003c/a\u003e\u003c/p\u003e\n","isMentalHealthService":false,"locations":[{"type":"paragraph--service_location","id":"11324c50-e9a3-4228-ad94-42bf06700fd6","officeVisits":null,"virtualSupport":null,"apptIntroTextType":"use_default_text","apptIntroTextCustom":null,"appointmentPhoneNumbers":[],"onlineSchedulingAvail":null,"contactInfoPhoneNumbers":[],"emailContacts":[],"hours":"0","officeHours":[],"additionalHoursInfo":null,"useMainFacilityPhone":true,"useFacilityPhoneNumber":true,"serviceLocationAddress":{"type":"paragraph--service_location_address","id":"d824f496-fa8b-42b7-b086-d53d40309f1a","drupal_internal__id":46225,"drupal_internal__revision_id":1319780,"langcode":"en","status":true,"created":"2021-06-09T20:16:34+00:00","parent_id":"46226","parent_type":"paragraph","parent_field_name":"field_service_location_address","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":null,"field_address":{"langcode":null,"country_code":"US","administrative_area":"","locality":"","dependent_locality":null,"postal_code":"","sorting_code":null,"address_line1":"","address_line2":null},"field_building_name_number":null,"field_clinic_name":null,"field_use_facility_address":true,"field_wing_floor_or_room_number":null,"links":{"self":{"href":"https://prod.cms.va.gov/jsonapi/paragraph/service_location_address/d824f496-fa8b-42b7-b086-d53d40309f1a?resourceVersion=id%3A1319780"},"working-copy":{"href":"https://prod.cms.va.gov/jsonapi/paragraph/service_location_address/d824f496-fa8b-42b7-b086-d53d40309f1a?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":1319780,"drupal_internal__target_id":46225},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"bd794386-a382-48d0-84fb-47290c3c1176","resourceIdObjMeta":{"drupal_internal__target_id":"service_location_address"}},"relationshipNames":["paragraph_type"]}}],"fieldFacilityLocatorApiId":"vha_534","fieldHealthServiceApiId":"rehabilitation"},{"name":"Returning service member care","fieldAlsoKnownAs":"Post-9/11 Veterans (OEF, OIF, OND) transition and care management services","fieldCommonlyTreatedCondition":"","fieldReferralRequired":"2","fieldTricareDescription":null,"description":"\u003cp\u003eIf you’re returning from military service, we can help you readjust to civilian life and get started with VA health care. We can also help connect you with\u0026nbsp;programs like mental health services and education and career counseling.\u003c/p\u003e","entityId":"645020f3-2376-4851-8357-b79151342631","entityBundle":"health_care_local_health_service","fieldBody":"\u003cp\u003eWe can help you readjust to civilian life if you’re returning from military service, on active duty, or an activated National Guard or Reserve member. Talk to one of our care coordinators about how to best use your health care benefits.\u003c/p\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003ePolytrauma care (if you have multiple traumatic injuries)\u003c/li\u003e\n\u003cli\u003eCounseling and rehabilitation\u003c/li\u003e\n\u003cli\u003eMental and behavioral health services\u003c/li\u003e\n\u003cli\u003eFamily benefits counseling and assistance\u003c/li\u003e\n\u003cli\u003eReferral assistance\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003ca data-entity-substitution=\"canonical\" data-entity-type=\"node\" data-entity-uuid=\"2463f41a-911a-4158-a524-5b169ff6d31d\" href=\"/charleston-health-care/health-services/returning-service-member-care\" title=\"Returning service member care\"\u003eLearn more and connect with a coordinator\u003c/a\u003e\u003c/p\u003e\n","isMentalHealthService":false,"locations":[{"type":"paragraph--service_location","id":"905fd5ea-5503-4de7-a112-eeaa8ad08388","officeVisits":null,"virtualSupport":null,"apptIntroTextType":"use_default_text","apptIntroTextCustom":null,"appointmentPhoneNumbers":[],"onlineSchedulingAvail":null,"contactInfoPhoneNumbers":[],"emailContacts":[],"hours":"0","officeHours":[],"additionalHoursInfo":null,"useMainFacilityPhone":true,"useFacilityPhoneNumber":true,"serviceLocationAddress":{"type":"paragraph--service_location_address","id":"39b5ac11-4579-4a45-88c2-6e43875aefc7","drupal_internal__id":46255,"drupal_internal__revision_id":1319811,"langcode":"en","status":true,"created":"2021-06-09T20:16:43+00:00","parent_id":"46256","parent_type":"paragraph","parent_field_name":"field_service_location_address","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":null,"field_address":{"langcode":null,"country_code":"US","administrative_area":"","locality":"","dependent_locality":null,"postal_code":"","sorting_code":null,"address_line1":"","address_line2":null},"field_building_name_number":null,"field_clinic_name":null,"field_use_facility_address":true,"field_wing_floor_or_room_number":null,"links":{"self":{"href":"https://prod.cms.va.gov/jsonapi/paragraph/service_location_address/39b5ac11-4579-4a45-88c2-6e43875aefc7?resourceVersion=id%3A1319811"},"working-copy":{"href":"https://prod.cms.va.gov/jsonapi/paragraph/service_location_address/39b5ac11-4579-4a45-88c2-6e43875aefc7?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":1319811,"drupal_internal__target_id":46255},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"bd794386-a382-48d0-84fb-47290c3c1176","resourceIdObjMeta":{"drupal_internal__target_id":"service_location_address"}},"relationshipNames":["paragraph_type"]}}],"fieldFacilityLocatorApiId":"vha_534","fieldHealthServiceApiId":"transitionCounseling"},{"name":"Sleep medicine","fieldAlsoKnownAs":"CPAP therapy","fieldCommonlyTreatedCondition":"insomnia, narcolepsy, restless legs syndrome, sleep apnea, sleepwalking ","fieldReferralRequired":"2","fieldTricareDescription":null,"description":"\u003cp\u003eThe sleep medicine service diagnoses and treats your sleep problems, including trouble sleeping, breathing difficulties while sleeping, snoring, teeth grinding\u0026nbsp;and jaw clenching.\u003c/p\u003e","entityId":"cfbfdcff-d48a-4b59-bfd6-cdec98ccd138","entityBundle":"health_care_local_health_service","fieldBody":"\u003cp\u003eAt various points in our lives, all of us suffer from a lack of sleep. But, if you are spending enough time in bed and still wake up tired or feel very sleepy during the day, you may have a sleep disorder. We can help. Our sleep specialists can:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eDiagnose and treat sleep apnea and other sleep disorders\u003c/li\u003e\n\u003cli\u003eMonitor your blood oxygen levels and heart rate\u003c/li\u003e\n\u003cli\u003eStudy your brain waves during sleep\u003c/li\u003e\n\u003cli\u003eEvaluate possible causes for your excessive sleepiness\u003c/li\u003e\n\u003cli\u003eConduct sleep tests performed at home or in the lab\u003c/li\u003e\n\u003cli\u003eWork with your doctors if you need surgery or dental appliances to help you get a good night’s sleep\u003c/li\u003e\n\u003c/ul\u003e\n","isMentalHealthService":false,"locations":[{"type":"paragraph--service_location","id":"e8471ea0-e369-4ae4-bf35-bca4068b0b7e","officeVisits":null,"virtualSupport":null,"apptIntroTextType":"use_default_text","apptIntroTextCustom":null,"appointmentPhoneNumbers":[],"onlineSchedulingAvail":null,"contactInfoPhoneNumbers":[],"emailContacts":[],"hours":"0","officeHours":[],"additionalHoursInfo":null,"useMainFacilityPhone":true,"useFacilityPhoneNumber":true,"serviceLocationAddress":{"type":"paragraph--service_location_address","id":"aa359f2c-ab8e-475d-a5c9-ff50ee48a481","drupal_internal__id":46257,"drupal_internal__revision_id":1319813,"langcode":"en","status":true,"created":"2021-06-09T20:16:43+00:00","parent_id":"46258","parent_type":"paragraph","parent_field_name":"field_service_location_address","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":null,"field_address":{"langcode":null,"country_code":"US","administrative_area":"","locality":"","dependent_locality":null,"postal_code":"","sorting_code":null,"address_line1":"","address_line2":null},"field_building_name_number":null,"field_clinic_name":null,"field_use_facility_address":true,"field_wing_floor_or_room_number":null,"links":{"self":{"href":"https://prod.cms.va.gov/jsonapi/paragraph/service_location_address/aa359f2c-ab8e-475d-a5c9-ff50ee48a481?resourceVersion=id%3A1319813"},"working-copy":{"href":"https://prod.cms.va.gov/jsonapi/paragraph/service_location_address/aa359f2c-ab8e-475d-a5c9-ff50ee48a481?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":1319813,"drupal_internal__target_id":46257},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"bd794386-a382-48d0-84fb-47290c3c1176","resourceIdObjMeta":{"drupal_internal__target_id":"service_location_address"}},"relationshipNames":["paragraph_type"]}}],"fieldFacilityLocatorApiId":"vha_534","fieldHealthServiceApiId":"sleepMedicine"},{"name":"Smoking and tobacco cessation","fieldAlsoKnownAs":"Quit smoking","fieldCommonlyTreatedCondition":"","fieldReferralRequired":"2","fieldTricareDescription":null,"description":"\u003cp\u003eIf you are trying to quit smoking or want to stop using tobacco, we can help you with support, resources\u0026nbsp;and programs.\u003c/p\u003e","entityId":"992bd661-e659-45aa-b99c-cdc3c6b24a83","entityBundle":"health_care_local_health_service","fieldBody":"\u003cp\u003eYou can quit smoking or chewing tobacco. Our goal is to provide support and strategies to add to optional nicotine replacement therapy prescribed by your primary care doctor. These include:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eFDA-approved medications to manage nicotine withdrawal and the urge to smoke.\u003c/li\u003e\n\u003cli\u003eCounseling in person or by phone\u003c/li\u003e\n\u003cli\u003eTobacco Cessation Quitline for individual counseling and strategies\u003c/li\u003e\n\u003cli\u003eSmokefreeVET text message program for daily advice and interactive support\u003c/li\u003e\n\u003cli\u003eStay Quit Coach mobile app to help you quit smoking and stay smoke-free\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003ca href=\"https://www.mentalhealth.va.gov/quit-tobacco/how-to-quit.asp\"\u003eLearn more about how to quit\u003c/a\u003e\u003c/p\u003e\n","isMentalHealthService":false,"locations":[{"type":"paragraph--service_location","id":"b2a27a8b-6780-4506-8f68-5026319fb334","officeVisits":null,"virtualSupport":null,"apptIntroTextType":"use_default_text","apptIntroTextCustom":null,"appointmentPhoneNumbers":[],"onlineSchedulingAvail":null,"contactInfoPhoneNu