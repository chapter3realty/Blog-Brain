+ *   census-pep.json (rows 11 to 15), rfa-projection.json (row 18), irs-migration.json (rows 2 to 9),
+ *   zhvi-origins.json (rows 23, 24), listings-counts.json (row 25), acs.json and
+ *   ../../2026-10-d/sell-out-of-state-buyers/acs-origin-counties.json (row 26), photos.json (the new aerial).
+ * Kept from the live page: the title tag and the "told with numbers" promise (data/headlines.json, the owner liked
+ * them), the four reasons, the IRS and Census numbers (corrected: "2.5 times the income" is gone, the metro rank is
+ * stated as the verifier allows), the links to every state page, the Boston, Ohio, Virginia and Maryland stories,
+ * now told whole. Cut: "Devin" in the copy, the parking-spaces line, "near 0.38 percent", the fragment quotes, the
+ * region label headings. The inline lead form is replaced by the site's contact page, as on every rebuilt guide.
+ * Stories used as recorded: boston-hotel-manager, ohio-move, virginia-beach-comparison, making-friends-seasonal,
+ * business-owners-lower-prices, remote-workers-half, maryland-transplant, ny-client-tax-drop.
+ * Built by tools/mkpage.js. */
+const fs = require("fs"), path = require("path");
+const { h } = require("../tools/mkpage.js");
+
+const BB = [path.join(__dirname, "..", "tools", "blog-brain-2026-11-a"), path.join(__dirname, "..", "tools", "blog-brain-2026-10-b"), process.env.BLOG_BRAIN,
