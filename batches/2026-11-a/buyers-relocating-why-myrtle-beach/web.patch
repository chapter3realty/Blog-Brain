uto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:760px}</style><style>main#main .c3-rc{list-style:none;margin:1.2rem 0 1.4rem;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(19rem,1fr));gap:.75rem;max-width:760px}main#main .c3-rc li{margin:0;padding:1rem 1.05rem 1.05rem;border-radius:18px;background:linear-gradient(180deg,rgba(255,255,255,.78),rgba(255,255,255,.55));border:1px solid rgba(255,255,255,.8);box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 10px 28px -16px rgba(28,32,40,.35)}main#main .c3-rc .q{display:flex;align-items:center;gap:.6rem;color:var(--navy);font-weight:600;font-size:var(--read,1.0625rem);line-height:1.35;margin:0 0 .45rem}main#main .c3-rc .q .i{flex:none;display:flex;width:2.3rem;height:2.3rem;border-radius:50%;align-items:center;justify-content:center;color:var(--brass-ink);background:rgba(196,120,58,.12)}main#main .c3-rc .a{color:var(--muted);line-height:1.6;margin:0}@media (prefers-reduced-transparency:reduce){main#main .c3-rc li{background:#fbf8f3}}</style><style>.c3-glance{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(var(--n),minmax(0,1fr));gap:.75rem;max-width:760px}.c3-glance li{display:flex;align-items:center;gap:.55rem;margin:0;padding:.5rem .6rem;background:rgba(255,255,255,.55);border:1px solid var(--rule);border-radius:6px;line-height:1.25}.c3-glance .i{flex:0 0 auto;display:flex;width:2rem;height:2rem;border-radius:50%;background:var(--ivory-2);color:var(--brass-ink);align-items:center;justify-content:center}.c3-glance strong{display:block;color:var(--navy);font-size:.9rem;font-weight:500}.c3-glance span.t{display:block;color:var(--muted);font-size:1rem}@media (max-width:699px){.c3-glance{gap:.3rem}.c3-glance li{flex-direction:column;justify-content:flex-start;text-align:center;gap:.2rem;padding:.4rem .1rem}.c3-glance .i{width:1.6rem;height:1.6rem}.c3-glance strong{font-size:.875rem}.c3-glance span.t{font-size:1rem;line-height:1.2}}</style><ul role="list" class="c3-glance" style="--n:3"><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 21h18M5 21V9.5l5-3V21M10 21V4h9v17M13 8h3M13 12h3M13 16h3M7.5 13h.01M7.5 16.5h.01"/></svg></span><span><strong>Growth</strong><span class="t">22% since 2020</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span><span><strong>Born elsewhere</strong><span class="t">6 in 10</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span><span><strong>Typical home</strong><span class="t">$320,000</span></span></li></ul></div><p style="color:var(--muted);font-size:.9rem;margin-bottom:1rem">By <strong style="color:var(--navy);font-weight:600">Devin Day</strong>, Operations Officer &middot; Reviewed by <strong style="color:var(--navy);font-weight:600">Tim Nash</strong>, Broker-in-Charge &middot; <span style="white-space:nowrap">Updated August 28, 2026</span></p><p class="detail-sub">Horry County grew about 22 percent since 2020. More people die here than are born, so the growth is people moving in.</p></div></div><section style="background:var(--ivory)"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">The short answer</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most people moving to Myrtle Beach are trading a costly home in the North for a cheaper one near the beach. They also get a lower property tax bill and a shorter winter.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">People are still moving here. In the latest IRS count, about 15,000 households moved into Horry County in one year and about 9,100 moved out.</p></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><p style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Find out what the money from your house buys here.</p><a class="btn btn-brass btn-lg" href="/contact/">Ask us what it buys</a></div></section><section style="background:var(--ivory);padding-top:2.5rem"><div class="wrap"><nav aria-label="On this page" style="margin-top:0;max-width:720px"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.3rem;font-weight:600">On this page</p><ul style="list-style:none;margin:0;padding:0"><li><a href="#four-reasons" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">The four reasons</a></li><li><a href="#still-growing" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Still growing?</a></li><li><a href="#overcrowded" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Overcrowded?</a></li><li><a href="#where-from" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Where from</a></li><li><a href="#what-your-house-buys" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">What your house buys</a></li><li><a href="#jobs-and-pay" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Jobs and pay</a></li><li><a href="#taxes" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Taxes</a></li><li><a href="#why-people-leave" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Who leaves, and why</a></li><li><a href="#should-you-move" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Should you move?</a></li><li><a href="#moving-to-myrtle-beach-faq" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Moving to Myrtle Beach FAQ</a></li></ul></nav></div></section><section style="background:var(--ivory-2)" id="four-reasons"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The four reasons">Why are so many people moving to Myrtle Beach?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">People move to Myrtle Beach for lower house prices, low property tax, a short winter and more work. Each reason has a number you can compare with where you live now.</p><ul class="c3-rc" role="list"><li><p class="q"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span><span>A house costs less</span></p><p class="a">A typical home in Horry County is valued at about $320,000. On Long Island, in Suffolk County, it is about $730,000.</p></li><li><p class="q"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h8l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v4h4M9 17l6-6"/><circle cx="9.5" cy="11.5" r="1"/><circle cx="14.5" cy="16.5" r="1"/></svg></span><span>The property tax is low</span></p><p class="a">An owner who lives in the home here typically pays about $944 a year. In Suffolk and Nassau counties on Long Island, the typical bill is $10,000 or more.</p></li><li><p class="q"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11a9 7.5 0 0 1 18 0q-2.25-1.5-4.5 0t-4.5 0-4.5 0-4.5 0zM12 11v8M2.5 21.5c3-1.4 6.3-1.4 9.5 0s6.5 1.4 9.5 0"/></svg></span><span>The winter is short</span></p><p class="a">The ocean averages the low 70s in October. The nearest long-term government weather station counts about 111 clear days a year, and Cleveland counts 66.</p></li><li><p class="q"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 21h18M5 21V9.5l5-3V21M10 21V4h9v17M13 8h3M13 12h3M13 16h3M7.5 13h.01M7.5 16.5h.01"/></svg></span><span>There is more work</span></p><p class="a">Jobs in Horry County grew about 9 percent from 2019 to 2025. Jobs in the country as a whole grew about 5 percent.</p></li></ul><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/55-plus/del-webb-grande-dunes/myrtle-beach-beach-from-above-1200w.webp" srcset="/images/55-plus/del-webb-grande-dunes/myrtle-beach-beach-from-above-600w.webp 600w, /images/55-plus/del-webb-grande-dunes/myrtle-beach-beach-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="The wide sand beach, the dunes and the ocean in Myrtle Beach, seen from a high floor" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: 28bytes. License: CC BY-SA 4.0" title="License: CC BY-SA 4.0">Photo: 28bytes</a></span></div><figcaption>The beach in Myrtle Beach in late November, seen from a high floor.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The City of Myrtle Beach is in Horry County, South Carolina. People call the coast here and the towns along it the Grand Strand.</p></div></section><section style="background:var(--ivory)" id="still-growing"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Still growing?">Is Myrtle Beach still growing?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. Horry County grew about 22 percent from the 2020 census to the latest estimate.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="People living in Horry County, and the state's projection"><span class="cap" aria-hidden="true">People living in Horry County, and the state's projection</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Year, note</span><span role="columnheader">people</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">2020 census</span></span><span role="cell"><span class="b" style="--f:0.473" aria-hidden="true"></span><span class="v">351,000</span></span></div><div role="row"><span role="rowheader"><span class="n">2021</span></span><span role="cell"><span class="b" style="--f:0.493" aria-hidden="true"></span><span class="v">366,100</span></span></div><div role="row"><span role="rowheader"><span class="n">2022</span></span><span role="cell"><span class="b" style="--f:0.517" aria-hidden="true"></span><span class="v">383,600</span></span></div><div role="row"><span role="rowheader"><span class="n">2023</span></span><span role="cell"><span class="b" style="--f:0.537" aria-hidden="true"></span><span class="v">398,700</span></span></div><div role="row"><span role="rowheader"><span class="n">2024</span></span><span role="cell"><span class="b" style="--f:0.558" aria-hidden="true"></span><span class="v">414,300</span></span></div><div role="row"><span role="rowheader"><span class="n">2025</span></span><span role="cell"><span class="b" style="--f:0.576" aria-hidden="true"></span><span class="v">427,600</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">2030</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">projected</span></span><span role="cell"><span class="b" style="--f:0.667" aria-hidden="true"></span><span class="v">about 495,000</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">2035</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">projected</span></span><span role="cell"><span class="b" style="--f:0.769" aria-hidden="true"></span><span class="v">about 571,000</span></span></div></div></div><figcaption>Census Bureau counts and yearly estimates (each year's figure is for July 1). The 2030 and 2035 figures are South Carolina's own projection, not a count.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Census Bureau's Myrtle Beach metro area is Horry County alone. From mid-2024 to mid-2025 it grew the second fastest of any metro area in the country, behind Ocala, Florida.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Over the whole time since the 2020 census, it was one of the two fastest growing metro areas in the country, with The Villages, Florida.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">More people die here than are born</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Over five years, Horry County had about 25,800 deaths and about 16,400 births. All of the county's growth comes from people moving in.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="Births and deaths in Horry County over five years"><span class="cap" aria-hidden="true">Births and deaths in Horry County over five years</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Place</span><span role="columnheader">people</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Deaths</span></span><span role="cell"><span class="b" style="--f:0.769" aria-hidden="true"></span><span class="v">about 25,800</span></span></div><div role="row"><span role="rowheader"><span class="n">Births</span></span><span role="cell"><span class="b" style="--f:0.489" aria-hidden="true"></span><span class="v">about 16,400</span></span></div></div></div><figcaption>Mid-2020 to mid-2025, Census Bureau estimates.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the latest year, about 39 more people a day moved here from other parts of the country than moved away.</p></div></section><section style="background:var(--ivory-2)" id="overcrowded"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Overcrowded?">Is Myrtle Beach getting overcrowded?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most of the growth is not in the beach towns. The City of Myrtle Beach itself has about 41,000 people. About three in four Horry County residents live outside any city or town.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About four in five of the people added since 2020 settled outside city limits. Outside city limits does not mean the country: Carolina Forest, Socastee, Murrells Inlet and Little River are all outside them.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/buyers-relocating-why-myrtle-beach/woods-cleared-for-new-streets-from-above-1200w.webp" srcset="/images/2026-11-a/buyers-relocating-why-myrtle-beach/woods-cleared-for-new-streets-from-above-600w.webp 600w, /images/2026-11-a/buyers-relocating-why-myrtle-beach/woods-cleared-for-new-streets-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Aerial photo of two new subdivisions being cut out of pine woods: a paved street loop around a pond with empty lots, and more streets being graded across the road" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo, 2023. License: Public domain" title="License: Public domain">U.S. government aerial photo, 2023</a></span></div><figcaption>Woods cleared for new streets and house lots outside the city limits, between Conway and North Myrtle Beach.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">South Carolina's own projection has the county at about 495,000 people in 2030. Our <a href="/buyers/relocating/getting-around/" style="color:var(--navy);text-decoration:underline">getting around page</a> covers the roads and drive times, and our <a href="/buyers/relocating/which-town/" style="color:var(--navy);text-decoration:underline">which town page</a> compares the towns.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">New homes going up outside the city limits</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us your price and how far from the beach you want to live. We send you new homes for sale that fit.</p><a class="btn btn-brass" href="/contact/">Send me new homes for sale</a></div></div></section><section style="background:var(--ivory)" id="where-from"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Where from">Where are people moving to Myrtle Beach from?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">From up and down the East Coast, most of all North Carolina, Long Island and other counties near New York City. About six in ten Horry County residents were born in another state, against about one in four Americans.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Almost as many residents were born in a northeastern state as in South Carolina. About one resident in 19 lived in another state a year earlier, more than twice the national share.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}@media (max-width:699px){main#main .c3-gchart.c3-gchart-list [role=row]{grid-template-columns:minmax(0,1fr) auto;column-gap:.8rem;align-items:start}main#main .c3-gchart.c3-gchart-list .b{display:none}main#main .c3-gchart.c3-gchart-list .dot{display:none}main#main .c3-gchart.c3-gchart-list .f{display:block}main#main .c3-gchart.c3-gchart-list [role=cell]{justify-content:flex-end}}</style><figure class="c3-gchart c3-gchart-compact c3-gchart-list"><div role="table" aria-label="Households that moved to Horry County in one year, by where they came from"><span class="cap" aria-hidden="true">Households that moved to Horry County in one year, by where they came from</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Came from, compared with those who moved there</span><span role="columnheader">households</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">The South, outside South Carolina</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about 1.5 in for each 1 out</span></span><span role="cell"><span class="b" style="--f:0.741" aria-hidden="true"></span><span class="v">5,900 moved in</span></span></div><div role="row"><span role="rowheader"><span class="n">The Northeast</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about 3 in for each 1 out</span></span><span role="cell"><span class="b" style="--f:0.618" aria-hidden="true"></span><span class="v">4,900 moved in</span></span></div><div role="row"><span role="rowheader"><span class="n">The Midwest</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about 1.6 in for each 1 out</span></span><span role="cell"><span class="b" style="--f:0.149" aria-hidden="true"></span><span class="v">1,200 moved in</span></span></div><div role="row"><span role="rowheader"><span class="n">The West</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about 1.8 in for each 1 out</span></span><span role="cell"><span class="b" style="--f:0.121" aria-hidden="true"></span><span class="v">1,000 moved in</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Other South Carolina counties</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">fewer in than out</span></span><span role="cell"><span class="b" style="--f:0.272" aria-hidden="true"></span><span class="v">2,200 moved in</span></span></div></div></div><figcaption>The latest IRS count of tax returns that moved from one county to another. Out means households that moved from Horry County to that region. The South includes North Carolina, Virginia, Maryland and Florida.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Few households go back to the New York and New Jersey counties. For every household that moved from Horry County to Suffolk County, New York, about six came from it. North Carolina counties trade households both ways.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}@media (max-width:699px){main#main .c3-gchart.c3-gchart-list [role=row]{grid-template-columns:minmax(0,1fr) auto;column-gap:.8rem;align-items:start}main#main .c3-gchart.c3-gchart-list .b{display:none}main#main .c3-gchart.c3-gchart-list .dot{display:none}main#main .c3-gchart.c3-gchart-list .f{display:block}main#main .c3-gchart.c3-gchart-list [role=cell]{justify-content:flex-end}}</style><figure class="c3-gchart c3-gchart-compact c3-gchart-list"><div role="table" aria-label="Households that moved between Horry County and eight counties in other states, in one year"><span class="cap" aria-hidden="true">Households that moved between Horry County and eight counties in other states, in one year</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">County, compared with those who moved there</span><span role="columnheader">households in and out</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Suffolk County, NY (Long Island)</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about 6 in for each 1 out</span></span><span role="cell"><span class="b" style="--f:0.625" aria-hidden="true"></span><span class="v">320 in, 50 out</span></span></div><div role="row"><span role="rowheader"><span class="n">Brunswick County, NC</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about 1.1 in for each 1 out</span></span><span role="cell"><span class="b" style="--f:0.498" aria-hidden="true"></span><span class="v">255 in, 224 out</span></span></div><div role="row"><span role="rowheader"><span class="n">Mecklenburg County, NC (Charlotte)</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about 1.2 in for each 1 out</span></span><span role="cell"><span class="b" style="--f:0.445" aria-hidden="true"></span><span class="v">228 in, 194 out</span></span></div><div role="row"><span role="rowheader"><span class="n">Wake County, NC (Raleigh)</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about 1.4 in for each 1 out</span></span><span role="cell"><span class="b" style="--f:0.355" aria-hidden="true"></span><span class="v">182 in, 127 out</span></span></div><div role="row"><span role="rowheader"><span class="n">Ocean County, NJ</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about 5 in for each 1 out</span></span><span role="cell"><span class="b" style="--f:0.352" aria-hidden="true"></span><span class="v">180 in, 33 out</span></span></div><div role="row"><span role="rowheader"><span class="n">Orange County, NY</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about 7 in for each 1 out</span></span><span role="cell"><span class="b" style="--f:0.305" aria-hidden="true"></span><span class="v">156 in, 22 out</span></span></div><div role="row"><span role="rowheader"><span class="n">Nassau County, NY (Long Island)</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about 3 in for each 1 out</span></span><span role="cell"><span class="b" style="--f:0.277" aria-hidden="true"></span><span class="v">142 in, 41 out</span></span></div><div role="row"><span role="rowheader"><span class="n">Dutchess County, NY</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about 4 in for each 1 out</span></span><span role="cell"><span class="b" style="--f:0.227" aria-hidden="true"></span><span class="v">116 in, 26 out</span></span></div></div></div><figcaption>In means households that moved from the county to Horry County. Out means households that moved the other way.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The single largest source of new households is Georgetown County, South Carolina, which borders Horry County to the south. Columbus County, North Carolina, also sends many, and its typical home costs less than one here.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Buyers from away buy here too, not all of them to live here. About 3 in 10 Horry County homes sold in the last 12 months went to a buyer whose tax bill goes to another state or country.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We wrote a page for the move from each of the states most movers come from: <a href="/buyers/relocating/from-new-york/" style="color:var(--navy);text-decoration:underline">New York</a>, <a href="/buyers/relocating/from-new-jersey/" style="color:var(--navy);text-decoration:underline">New Jersey</a>, <a href="/buyers/relocating/from-pennsylvania/" style="color:var(--navy);text-decoration:underline">Pennsylvania</a>, <a href="/buyers/relocating/from-connecticut/" style="color:var(--navy);text-decoration:underline">Connecticut</a>, <a href="/buyers/relocating/from-massachusetts/" style="color:var(--navy);text-decoration:underline">Massachusetts</a>, <a href="/buyers/relocating/from-maryland/" style="color:var(--navy);text-decoration:underline">Maryland</a>, <a href="/buyers/relocating/from-virginia/" style="color:var(--navy);text-decoration:underline">Virginia</a>, <a href="/buyers/relocating/from-north-carolina/" style="color:var(--navy);text-decoration:underline">North Carolina</a>, <a href="/buyers/relocating/from-ohio/" style="color:var(--navy);text-decoration:underline">Ohio</a> and <a href="/buyers/relocating/from-florida/" style="color:var(--navy);text-decoration:underline">Florida</a>.</p></div></section><section style="background:var(--ivory-2)" id="what-your-house-buys"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What your house buys">What would my house buy in Myrtle Beach?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In most of the out-of-state counties that send the most movers, a typical home is worth more than one here. Sell a typical Suffolk County home and buy a typical Horry County home, and about $410,000 is left before moving costs, sale costs and any loan payoff.</p><div class="c3-wbuys c3-calc-box" style="background:var(--navy);background-image:linear-gradient(160deg,rgba(42,48,64,.97),rgba(28,32,40,.98));border:1px solid rgba(255,255,255,.14);border-radius:18px;padding:1.4rem 1.3rem 1.3rem;margin:1.6rem 0;max-width:620px;box-shadow:0 26px 60px -30px rgba(28,32,40,.6)"><p style="font-size:.85rem;letter-spacing:.12em;text-transform:uppercase;color:var(--brass-2);margin:0 0 .4rem;font-family:var(--sans);font-weight:600">What your house buys here</p><label for="wbCounty" style="display:block;color:rgba(244,239,232,.92);font-family:var(--sans);font-size:1rem;line-height:1.4;margin:0 0 .45rem">The county you live in now</label><select id="wbCounty" onchange="c3Wb()" style="width:100%;background:rgba(244,239,232,.12);border:1px solid rgba(244,239,232,.4);border-radius:10px;color:#f4efe8;font-family:var(--sans);font-size:1rem;padding:.65rem .7rem"><option value="852000">Nassau County, NY</option><option value="787000">Monmouth County, NJ</option><option value="756000">Fairfax County, VA</option><option value="730000" selected>Suffolk County, NY</option><option value="551000">Ocean County, NJ</option><option value="505000">Dutchess County, NY</option><option value="471000">Wake County, NC</option><option value="468000">Orange County, NY</option><option value="455000">Maricopa County, AZ</option><option value="415000">Mecklenburg County, NC</option><option value="404000">Brunswick County, NC</option><option value="358000">Baltimore County, MD</option><option value="237000">Allegheny County, PA</option><option value="228000">Cumberland County, NC</option><option value="198000">Columbus County, NC</option></select><div style="display:grid;gap:.55rem;margin-top:1.1rem"><div class="c3-wr"><span>A typical home there</span><strong id="wbThere">$730,000</strong></div><div class="c3-wr"><span>A typical home in Horry County</span><strong id="wbHere">$320,000</strong></div></div><div style="border-top:1px solid rgba(244,239,232,.22);margin-top:1rem;padding-top:.9rem"><p id="wbSay" aria-live="polite" style="font-family:var(--sans);color:rgba(244,239,232,.92);line-height:1.55;margin:0 0 .9rem;font-size:1.05rem">About $410,000 less here, before moving and sale costs.</p><a id="wbLink" class="c3-wblink" href="/homes/map/?type=house&amp;max=730000">See houses for sale at or under $730,000</a></div></div><script>function c3Wb(){var s=document.getElementById("wbCounty");if(!s)return;var v=parseInt(s.value,10),here=320000;var m=function(n){return "$"+Math.round(n).toLocaleString("en-US")};var t=document.getElementById("wbThere"),y=document.getElementById("wbSay"),l=document.getElementById("wbLink");if(!t||!y||!l)return;t.textContent=m(v);var d=Math.round((v-here)/1000)*1000;y.textContent=d>0?"About "+m(d)+" less here, before moving and sale costs.":d<0?"About "+m(-d)+" more here than there.":"About the same as here.";l.href="/homes/map/?type=house&max="+v;l.textContent="See houses for sale at or under "+m(v)}document.addEventListener("DOMContentLoaded",c3Wb);</script><style>main#main .c3-wbuys .c3-wr{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;font-family:var(--sans);color:rgba(244,239,232,.88);font-size:1rem}main#main .c3-wbuys .c3-wr strong{color:var(--brass-2);font-family:var(--serif);font-size:1.5rem;line-height:1.1;white-space:nowrap}main#main .c3-wbuys .c3-wblink{display:inline-block;color:var(--brass-2);font-family:var(--sans);font-weight:600;font-size:1.05rem;text-decoration:underline;text-underline-offset:.2em;line-height:1.4;padding:.35rem 0}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">These are county figures from Zillow's home value index, not a value for your house. We price the house you want here against real sales nearby.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About half of the houses for sale in our MLS area are priced at or under a typical Charlotte-area home's value. About 3,050 are at or under a typical Suffolk County home's value.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}@media (max-width:699px){main#main .c3-gchart.c3-gchart-list [role=row]{grid-template-columns:minmax(0,1fr) auto;column-gap:.8rem;align-items:start}main#main .c3-gchart.c3-gchart-list .b{display:none}main#main .c3-gchart.c3-gchart-list .dot{display:none}main#main .c3-gchart.c3-gchart-list .f{display:block}main#main .c3-gchart.c3-gchart-list [role=cell]{justify-content:flex-end}}</style><figure class="c3-gchart c3-gchart-compact c3-gchart-list"><div role="table" aria-label="Houses for sale here at or under a typical home's value in each county"><span class="cap" aria-hidden="true">Houses for sale here at or under a typical home's value in each county</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Typical home value in, price line</span><span role="columnheader">houses for sale</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Nassau County, NY</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">at or under $852,000</span></span><span role="cell"><span class="b" style="--f:0.759" aria-hidden="true"></span><span class="v">about 3,230</span></span></div><div role="row"><span role="rowheader"><span class="n">Suffolk County, NY</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">at or under $730,000</span></span><span role="cell"><span class="b" style="--f:0.718" aria-hidden="true"></span><span class="v">about 3,050</span></span></div><div role="row"><span role="rowheader"><span class="n">Mecklenburg County, NC</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">at or under $415,000</span></span><span role="cell"><span class="b" style="--f:0.435" aria-hidden="true"></span><span class="v">about 1,850</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Horry County, SC</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">at or under $320,000</span></span><span role="cell"><span class="b" style="--f:0.235" aria-hidden="true"></span><span class="v">about 1,000</span></span></div></div></div><figcaption>Houses only, not condos, out of about 3,700 houses for sale in our MLS area: Horry and Georgetown counties and nearby parts of South Carolina and North Carolina. Counted the day this page was last updated; the count changes every day.</figcaption></figure><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">One move, in real numbers</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A friend who ran a Boston hotel retired with about $100,000 saved and sold his Massachusetts house for about $450,000. He bought three condos in one oceanfront building.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">They gross about $120,000, roughly half of it profit, and he now helps manage fourteen units. Those are his real numbers, from a true story, not a promise.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">The houses your budget buys here</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us what you expect from your sale up north. We send you the houses for sale it buys, town by town.</p><a class="btn btn-brass" href="/contact/">Send us your budget</a></div></div></section><section style="background:var(--ivory)" id="jobs-and-pay"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Jobs and pay">Are there jobs in Myrtle Beach, and what does work pay?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, and the number of jobs grew faster than in the country. Pay is lower, though: the average job here pays about 64 cents for every dollar of the national average.</p><style>.c3-cc{margin:1.4rem 0 1.8rem;max-width:960px}.c3-cc table{width:100%;border-collapse:collapse;font-size:var(--read,1.0625rem);line-height:1.45;color:var(--muted)}.c3-cc caption{caption-side:top;text-align:left;color:var(--navy);font-weight:600;font-size:1em;line-height:1.4;padding:0 0 .7rem}.c3-cc th,.c3-cc td{padding:.6rem .7rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule);overflow-wrap:break-word}.c3-cc thead th{color:var(--navy);font-weight:600;font-size:1em;border-bottom:2px solid var(--navy);vertical-align:bottom}.c3-cc tbody th{color:var(--navy);font-weight:600}.c3-cc .n{text-align:right;font-variant-numeric:tabular-nums}.c3-cc .i{display:inline-flex;vertical-align:-4px;margin-right:.45rem;color:var(--brass-ink)}.c3-cc tr.c3-self>*{background:#fff}@media (max-width:39.999em){.c3-cc table,.c3-cc tbody,.c3-cc tr,.c3-cc th,.c3-cc td{display:block;width:auto}.c3-cc caption{display:block}.c3-cc thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.c3-cc tbody tr{background:var(--ivory-2);border-top:3px solid var(--brass);margin:0 0 .8rem;padding:.5rem 0 .6rem}section[style*="background:var(--ivory-2)"] .c3-cc tbody tr{background:var(--ivory)}.c3-cc tr.c3-self{background:#fff!important;border:2px solid var(--brass)}.c3-cc tr.c3-self>*{background:transparent}.c3-cc th,.c3-cc td{border:0;padding:.2rem 1rem}.c3-cc tbody th{display:flex;align-items:center;font-size:1.1em;padding-bottom:.35rem}.c3-cc tbody th .i{flex:none;vertical-align:0}.c3-cc tbody th a{display:inline-block;padding:.5rem 0}.c3-cc .n{text-align:left}.c3-cc td[data-label]::before{content:attr(data-label) ": ";color:var(--navy);font-weight:500}}</style><div class="c3-cc"><table><caption>Jobs and pay in Horry County and the country</caption><thead><tr><th scope="col">Where</th><th scope="col" class="n">More jobs, 2019 to 2025</th><th scope="col" class="n">Average pay a year</th></tr></thead><tbody><tr><th scope="row">Horry County</th><td class="n" data-label="More jobs, 2019 to 2025">About 9%</td><td class="n" data-label="Average pay a year">About $50,000</td></tr><tr><th scope="row">United States</th><td class="n" data-label="More jobs, 2019 to 2025">About 5%</td><td class="n" data-label="Average pay a year">About $79,000</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Many movers bring their work with them. About half of our clients who come from the northern states arrive with a remote job.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Business owners who move here tell us they cannot charge as much for their services as they did up north. Our <a href="/buyers/relocating/jobs/" style="color:var(--navy);text-decoration:underline">jobs page</a> has more on work and pay here.</p></div></section><section style="background:var(--ivory-2)" id="taxes"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Taxes">How much are taxes in Myrtle Beach?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Property tax on a home you live in is low. A typical owner who lives in the home pays about $944 a year in Horry County, a fraction of the bill in most counties movers come from.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}@media (max-width:699px){main#main .c3-gchart.c3-gchart-list [role=row]{grid-template-columns:minmax(0,1fr) auto;column-gap:.8rem;align-items:start}main#main .c3-gchart.c3-gchart-list .b{display:none}main#main .c3-gchart.c3-gchart-list .dot{display:none}main#main .c3-gchart.c3-gchart-list .f{display:block}main#main .c3-gchart.c3-gchart-list [role=cell]{justify-content:flex-end}}</style><figure class="c3-gchart c3-gchart-compact c3-gchart-list"><div role="table" aria-label="The typical yearly property tax bill on a home its owner lives in"><span class="cap" aria-hidden="true">The typical yearly property tax bill on a home its owner lives in</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">County</span><span role="columnheader">tax a year</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Suffolk County, NY</span></span><span role="cell"><span class="b" style="--f:0.714" aria-hidden="true"></span><span class="v">$10,000 or more</span></span></div><div role="row"><span role="rowheader"><span class="n">Nassau County, NY</span></span><span role="cell"><span class="b" style="--f:0.714" aria-hidden="true"></span><span class="v">$10,000 or more</span></span></div><div role="row"><span role="rowheader"><span class="n">Orange County, NY</span></span><span role="cell"><span class="b" style="--f:0.607" aria-hidden="true"></span><span class="v">$8,494</span></span></div><div role="row"><span role="rowheader"><span class="n">Ocean County, NJ</span></span><span role="cell"><span class="b" style="--f:0.469" aria-hidden="true"></span><span class="v">$6,562</span></span></div><div role="row"><span role="rowheader"><span class="n">Wake County, NC</span></span><span role="cell"><span class="b" style="--f:0.233" aria-hidden="true"></span><span class="v">$3,260</span></span></div><div role="row"><span role="rowheader"><span class="n">Mecklenburg County, NC</span></span><span role="cell"><span class="b" style="--f:0.206" aria-hidden="true"></span><span class="v">$2,890</span></span></div><div role="row"><span role="rowheader"><span class="n">Brunswick County, NC</span></span><span role="cell"><span class="b" style="--f:0.135" aria-hidden="true"></span><span class="v">$1,890</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Horry County, SC</span></span><span role="cell"><span class="b" style="--f:0.067" aria-hidden="true"></span><span class="v">$944</span></span></div></div></div><figcaption>Census Bureau, the middle bill paid by owners who live in their homes, averaged over five years. The Census table stops at $10,000.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The bill depends on how you use the house. On one $400,000 house outside the city limits, the tax is about $1,470 a year if you live in it. It is about $4,820 if it is a second home or a rental.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">One New York household sold a house of about $1 million with more than $20,000 a year in property tax. They bought a house here of about $700,000, with about $3,200 in tax. Those are one household's numbers, not a promise.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">If you are retired</h3><ul style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem">South Carolina <a href="https://www.scstatehouse.gov/code/t12c006.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">does not tax Social Security</a>.</li><li style="margin-bottom:.5rem">Pensions, IRAs and 401(k) plans get a deduction for each person, larger from the year you turn 65. Military retirement pay is not taxed at all.</li><li style="margin-bottom:.5rem">At 65, after a year living in South Carolina, <a href="https://www.scstatehouse.gov/code/t12c037.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">you pay no property tax</a> on the first $50,000 of your home's value. For 2026 only, an owner who already qualified in 2025 gets $75,000.</li><li style="margin-bottom:.5rem">South Carolina has no estate tax.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our <a href="/buyers/retirees/" style="color:var(--navy);text-decoration:underline">retirees page</a> works out the income tax for three example households.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">The tax many movers do not expect</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">South Carolina has a yearly tax on vehicles. One of our team moved here from a village of about 400 in Ohio. His first vehicle tax bill was $325, plus a $250 one-time fee and a $50 road fee.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">The tax bill on one house, before you offer</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Pick a house you like. We work out its property tax as your full-time home and as a second home.</p><a class="btn btn-brass" href="/contact/">Have us work out the tax</a></div></div></section><section style="background:var(--ivory)" id="why-people-leave"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Who leaves, and why">Are people leaving Myrtle Beach, and why?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, about 9,100 households a year leave Horry County, against about 15,000 that move in. The top places they go are nearby: Georgetown County, SC, Brunswick County, NC, and Charleston County, SC.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About one in four households that leave go to another South Carolina county. More households moved from Horry to Charleston County than came from it.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The households moving in reported more income than those moving out: about $83,000 against about $55,000, on average.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Making friends is harder than movers expect, because many people near the city core are tourists or a seasonal population that leaves. Our advice: buy outside the City of Myrtle Beach. Be a regular at places tourists do not go, such as gyms and clubs.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Summer heat and hurricane season are the other things movers weigh. Our <a href="/buyers/relocating/weather/" style="color:var(--navy);text-decoration:underline">weather page</a> and <a href="/buyers/relocating/hurricanes/" style="color:var(--navy);text-decoration:underline">hurricane page</a> give the numbers, and our <a href="/buyers/relocating/pros-and-cons/" style="color:var(--navy);text-decoration:underline">pros and cons page</a> lists the rest.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What one mover noticed</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A colleague who moved here from Howard County, Maryland, noticed three things. Farm stands and butchers fill the organic gap the stores leave. There are many more motorcycles in summer. Construction is everywhere.</p></div></section><section style="background:var(--ivory-2)" id="should-you-move"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Should you move?">Should you move to Myrtle Beach?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The move usually works for people who bring their money or their income with them. It is harder for people who need a local salary like the one they had up north.</p><ul class="c3-rc" role="list"><li><p class="q"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span><span>If your home is worth more than a typical one here</span></p><p class="a">A typical home here is valued at about $320,000. If yours is worth more, selling it can pay for a home here with money left over, before costs.</p></li><li><p class="q"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 9.4c-.4-1-1.5-1.8-3-1.8-1.8 0-3 1-3 2.2 0 3 6 1.6 6 4.4 0 1.3-1.3 2.2-3 2.2-1.6 0-2.7-.7-3.1-1.8M12 5.8v1.8M12 16.4v1.8"/><circle cx="12" cy="12" r="9"/></svg></span><span>If you live on a pension, Social Security or a remote job</span></p><p class="a">Lower local pay matters less to you, and South Carolina does not tax Social Security.</p></li><li><p class="q"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 21h18M5 21V9.5l5-3V21M10 21V4h9v17M13 8h3M13 12h3M13 16h3M7.5 13h.01M7.5 16.5h.01"/></svg></span><span>If you need a local job that pays like a northern one</span></p><p class="a">Plan on lower pay. Our <a href="/buyers/relocating/jobs/" style="color:var(--navy);text-decoration:underline">jobs page</a> shows what work here pays.</p></li><li><p class="q"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11a9 7.5 0 0 1 18 0q-2.25-1.5-4.5 0t-4.5 0-4.5 0-4.5 0zM12 11v8M2.5 21.5c3-1.4 6.3-1.4 9.5 0s6.5 1.4 9.5 0"/></svg></span><span>If you want to be outside in the winter</span></p><p class="a">Winters here are short and mild. Our <a href="/buyers/relocating/weather/" style="color:var(--navy);text-decoration:underline">weather page</a> gives every month.</p></li><li><p class="q"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 5h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM3 10h18M8 3v4M16 3v4M8 14h.01M12 14h.01M16 14h.01M8 17.5h.01M12 17.5h.01"/></svg></span><span>If you want big-city night life</span></p><p class="a">Our clients from Virginia describe Virginia Beach as much bigger, with an entertainment scene many times this one. One client put it this way: nobody here parties like Miami, but people here are enjoying their money.</p></li><li><p class="q"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span>If you run a business that bills by the hour</span></p><p class="a">Expect to charge less. Business owners who move here tell us they cannot charge as much for their services as they did up north.</p></li></ul></div></section><section style="background:var(--ivory)" id="moving-to-myrtle-beach-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Moving to Myrtle Beach FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is Myrtle Beach the fastest growing city in America?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Myrtle Beach metro area, which is all of Horry County, grew the second fastest in the country from mid-2024 to mid-2025, behind Ocala, Florida. The City of Myrtle Beach itself has about 41,000 people, and most of the growth is outside city limits.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Are people leaving Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, about 9,100 households a year, while about 15,000 move in. The top places they go are Georgetown and Charleston counties in South Carolina and Brunswick County, North Carolina.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Where do most people moving to Myrtle Beach come from?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Outside South Carolina, the most households come from Suffolk County on Long Island, then Brunswick, Mecklenburg and Wake counties in North Carolina. About six in ten Horry County residents were born in another state.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is it cheaper to live in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Homes and property tax usually cost less than where most movers come from. A typical home in Horry County is valued at about $320,000, and an owner who lives in the home typically pays about $944 a year in property tax. Pay is lower too.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does South Carolina tax Social Security?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. South Carolina does not tax Social Security, and military retirement pay is not taxed either.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.irs.gov/statistics/soi-tax-stats-migration-data" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">IRS migration data</a>, <a href="https://www.census.gov/newsroom/press-releases/2026/2025-popest-metro-micro-counties.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Census Bureau estimates</a>, <a href="https://data.census.gov/table/ACSDT1Y2024.B05002?g=050XX00US45051" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Census ACS</a>, <a href="https://rfa.sc.gov/programs/census-state-liaison-and-data-center/search-and-download-population-data/rfa-population-projections" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC RFA projections</a>, <a href="https://www.bls.gov/cew/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">BLS QCEW</a>, <a href="https://www.zillow.com/research/data/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Zillow research data</a>, <a href="https://tidesandcurrents.noaa.gov/stationhome.html?id=8661070" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NOAA Springmaid Pier</a>, <a href="https://www.scstatehouse.gov/code/t12c006.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-6</a>, <a href="https://www.scstatehouse.gov/code/t12c037.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">12-37</a>. Households are IRS tax returns that changed county, the latest year published. Home values: Zillow, all homes, by county. Listings: aggregate counts from our MLS feed. Not tax advice.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">The wide sand beach, the dunes and the ocean in Myrtle Beach, seen from a high floor. Photo: 28bytes, <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a>, via <a href="https://commons.wikimedia.org/wiki/File:Myrtle_Beach,_South_Carolina,_Thanksgiving_2018.jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>.</div><div role="listitem">Woods cleared for new streets and house lots outside the city limits, between Conway and North Myrtle Beach. U.S. government aerial photo, 2023, by the USDA Farm Service Agency, <a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://imagery.nationalmap.gov/arcgis/rest/services/USGSNAIPImagery/ImageServer" target="_blank" rel="noopener noreferrer">The National Map (USGS)</a>.</div><div role="listitem">Chapter3 Realty resized these photos and cropped some of them. Each photo keeps the license listed with it.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/55-plus/del-webb-grande-dunes/myrtle-beach-beach-from-above-1200w.webp","url":"https://chapter3realty.com/images/55-plus/del-webb-grande-dunes/myrtle-beach-beach-from-above-1200w.webp","width":1200,"height":900,"encodingFormat":"image/webp","name":"The wide sand beach, the dunes and the ocean in Myrtle Beach, seen from a high floor","caption":"The beach in Myrtle Beach in late November, seen from a high floor.","description":"The wide sand beach, the dunes and the ocean in Myrtle Beach, seen from a high floor","creator":{"@type":"Person","name":"28bytes"},"creditText":"28bytes, CC BY-SA 4.0, via Wikimedia Commons","copyrightNotice":"© 28bytes, CC BY-SA 4.0","license":"https://creativecommons.org/licenses/by-sa/4.0/","acquireLicensePage":"https://commons.wikimedia.org/wiki/File:Myrtle_Beach,_S