+const DATA = path.join(__dirname, "..", "data", "2026-11-a", "buyers-relocating-why-myrtle-beach");
+const read = (f) => JSON.parse(fs.readFileSync(path.join(DATA, f), "utf8"));
+const PEP = read("census-pep.json"), RFA = read("rfa-projection.json").horry, IRS = read("irs-migration.json");
+const ZHVI = read("zhvi-origins.json").counties.filter((c) => !c.missing), LIST = read("listings-counts.json");
+const ACS_ORIG = JSON.parse(fs.readFileSync(path.join(__dirname, "..", "data", "2026-10-d", "sell-out-of-state-buyers", "acs-origin-counties.json"), "utf8"));
+const ACS_EXTRA = read("acs.json").extra_origins;
+
+/* Photos: this page's new aerial (photos.json here) and the site's records (the beach in late November). */
+const PHOTOS = read("photos.json").photos.concat(JSON.parse(fs.readFileSync(path.join(__dirname, "..", "data", "photos.json"), "utf8")).photos);
