+#!/bin/sh
+# Google search suggestions for /buyers/relocating/why-myrtle-beach/. Run: sh pull-suggestions.sh > raw/google-suggestions.txt
+for q in "why is everyone moving to myrtle beach" "why are people moving to myrtle beach" "why move to myrtle beach" "moving to myrtle beach" "moving to myrtle beach pros and cons" "is myrtle beach a good place to live" "is myrtle beach a good place to retire" "why is myrtle beach growing so fast" "is myrtle beach growing" "myrtle beach population growth" "fastest growing city in south carolina" "fastest growing metro" "where are people moving to myrtle beach from" "who is moving to myrtle beach" "why do people leave myrtle beach" "people leaving myrtle beach" "why are people moving to south carolina" "moving to south carolina" "why is everyone moving to south carolina" "is horry county growing" "horry county population" "moving to horry county" "living in myrtle beach" "living in myrtle beach pros and cons" "is it worth moving to myrtle beach" "is myrtle beach overcrowded" "is myrtle beach expensive to live" "cost of living myrtle beach vs" "moving from new york to myrtle beach" "moving from ohio to myrtle beach" "moving to myrtle beach from" "should i move to myrtle beach" "why myrtle beach" "grand strand growth" "moving to the grand strand" "myrtle beach retirees moving" "half back myrtle beach" "myrtle beach vs florida retirement" "myrtle beach jobs moving" "is myrtle beach a good place to live year round" "downsides of living in myrtle beach" "what is it like living in myrtle beach"; do
+  printf '== %s\n' "$q"
+  curl -sS -m 20 -A "Mozilla/5.0" "https://suggestqueries.google.com/complete/search?client=firefox&hl=en&gl=us&q=$(python3 -c "import urllib.parse,sys;print(urllib.parse.quote(sys.argv[1]))" "$q")"; echo
+done
diff --git a/data/2026-11-a/buyers-relocating-why-myrtle-beach/pull_listings.py b/data/2026-11-a/buyers-relocating-why-myrtle-beach/pull_listings.py
new file mode 100644
index 00000000..0807e79b
--- /dev/null
+++ b/data/2026-11-a/buyers-relocating-why-myrtle-beach/pull_listings.py
@@ -0,0 +1,26 @@
+"""Counts of homes for sale now from the CRM's public map API (aggregate totals only; no address or price of any single home is kept).
+Houses, and all homes (any type), at or under a list of price lines: every $50,000 from $200,000 to $900,000 and each origin county's
+typical value (zhvi-origins.json). The feed is the Coastal Carolinas MLS area (Horry, Georgetown and the NC border towns).
+Run: python3 -I pull_listings.py <this dir>. Writes listings-counts.json."""
+import json, sys, time, subprocess, urllib.parse, datetime
+D = sys.argv[1]
+BASE = "https://chapter3realty.com/homes/api/map?"
+def total(p):
+    url = BASE + urllib.parse.urlencode(p)
+    for i in range(3):
+        try:
+            d = json.loads(subprocess.run(["curl", "-sS", "-m", "60", "-A", "Mozilla/5.0", url], capture_output=True, text=True).stdout)
+            return d.get("total"), d.get("params"), d["meta"]["refreshedAt"], url
+        except Exception: time.sleep(2)
+    return None, None, None, url
+rows = []
+def add(label, p):
+    n, echo, ref, url = total(p); rows.append({"label": label, "params": p, "echo": echo, "total": n, "refreshedAt": ref, "url": url}); print(label, n, echo, flush=True)
+add("all homes for sale", {})
+add("all houses for sale", {"type": "house"})
+z = json.load(open(f"{D}/zhvi-origins.json"))
+lines = sorted(set(list(range(200000, 900001, 50000)) + [round(c["zhvi"], -3) for c in z["counties"] if c.get("zhvi")]))
+for m in lines:
+    add(f"houses at or under {m}", {"type": "house", "max": m})
+    add(f"all homes at or under {m}", {"max": m})
+json.dump({"pulled": datetime.datetime.utcnow().isoformat() + "Z", "rows": rows}, open(f"{D}/listings-counts.json", "w"), indent=1)
