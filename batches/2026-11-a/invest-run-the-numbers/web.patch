+			<td align="left" style>Mortgage interest</td>
+			<td align="right" style valign="bottom">$8,000</td>
+			<td align="right" style valign="bottom">&nbsp;</td>
+		</tr>
+		<tr>
+			<td align="left" style>Fire insurance</td>
+			<td align="right" style valign="bottom">250</td>
+			<td align="right" style valign="bottom">&nbsp;</td>
+		</tr>
+		<tr>
+			<td align="left" style>Miscellaneous repairs</td>
+			<td align="right" style valign="bottom">400</td>
+			<td align="right" style valign="bottom">&nbsp;</td>
+		</tr>
+		<tr>
+			<td align="left" style>Real estate taxes</td>
+			<td align="right" style valign="bottom">500</td>
+			<td align="right" style valign="bottom">&nbsp;</td>
+		</tr>
+		<tr>
+			<td align="left" style>Maintenance</td>
+			<td align="right" style valign="bottom"><u>200</u></td>
+			<td align="right" style valign="bottom">&nbsp;</td>
+		</tr>
+		<tr>
+			<td align="left" colspan="2" style>Total expenses</td>
+			<td align="right" style valign="bottom"><u>9,350</u></td>
+		</tr>
