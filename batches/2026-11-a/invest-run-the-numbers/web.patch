+	<div class="inner col col24 first last iddfd6401b-5f5c-421b-b1fe-c40262edfd18" style="" data-widgetcontainerid="dfd6401b-5f5c-421b-b1fe-c40262edfd18">	
+<div class="widget editor pageStyles narrow" id="divEditor0db4457f-a461-45a9-a9ce-1ca3a50c62c2" data-elementqueryclasses='{"wide-narrow":"min-width:25em"}'>
