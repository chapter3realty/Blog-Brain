+		<tr>
+			<td style><span class="inlinep">&nbsp;</span></td>
+			<td align="right" style><span class="inlinep">10.</span></td>
+			<td style><span class="inlinep"><span class="bold"><strong>Excess real estate taxes reported on line 4c.</strong></span> Subtract line 9 from line 6</span></td>
