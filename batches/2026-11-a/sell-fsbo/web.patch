+#!/bin/sh
+# Google search suggestions for /sell/fsbo/. Run: sh pull-suggestions.sh > raw/google-suggestions.txt
+for q in "for sale by owner" "for sale by owner sc" "for sale by owner south carolina" "for sale by owner myrtle beach" "for sale by owner horry county" "for sale by owner conway sc" "fsbo" "fsbo sc" "fsbo south carolina" "fsbo myrtle beach" "fsbo vs realtor" "fsbo pros and cons" "fsbo paperwork" "fsbo closing" "fsbo how to" "how to sell your house by owner" "how to sell your house by owner in sc" "how to sell a house without a realtor" "how to sell a house without a realtor in south carolina" "selling a house without a realtor" "selling a house without a realtor in sc" "can i sell my house without a realtor" "do i need a lawyer to sell my house" "do i need a lawyer to sell my house in sc" "south carolina real estate attorney closing fee" "sc seller disclosure form" "south carolina residential property condition disclosure statement" "sc disclosure statement no representation" "flat fee mls sc" "flat fee mls myrtle beach" "list on mls without realtor" "do i have to pay buyers agent" "for sale by owner contract sc" "south carolina real estate purchase agreement" "deed stamps sc" "who pays deed stamps in sc" "seller closing costs sc" "how much does it cost to sell a house in sc" "realtor commission sc" "realtor commission myrtle beach" "zillow for sale by owner" "for sale by owner sign" "sell house to family member sc" "fsbo earnest money" "who holds earnest money fsbo"; do
+  printf '== %s\n' "$q"
+  curl -sS -A "Mozilla/5.0" "https://suggestqueries.google.com/complete/search?client=firefox&hl=en&gl=us&q=$(python3 -c "import urllib.parse,sys;print(urllib.parse.quote(sys.argv[1]))" "$q")"; echo
+done
diff --git a/data/2026-11-a/sell-fsbo/pull_listing_counts.py b/data/2026-11-a/sell-fsbo/pull_listing_counts.py
new file mode 100644
index 00000000..16a90c40
--- /dev/null
+++ b/data/2026-11-a/sell-fsbo/pull_listing_counts.py
@@ -0,0 +1,22 @@
+"""Active for-sale listing COUNTS from the CRM's public map API (aggregate only; no addresses, firms or photos saved).
+For each home type: all active, active with a price cut (has=price_reduced), and listed in the last 30 and 7 days (domMax).
+Run: python3 -I pull_listing_counts.py <outdir>. Writes <outdir>/listing-counts.json."""
+import json, sys, os, time, urllib.request, urllib.parse, datetime
+out = sys.argv[1]
+BASE = "https://chapter3realty.com/homes/api/map?"
+def total(p):
+    url = BASE + urllib.parse.urlencode(p)
+    for i in range(4):
+        try:
+            d = json.load(urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"}), timeout=60))
+            return {"url": url, "total": d["total"], "labels": d.get("labels"), "refreshedAt": (d.get("meta") or {}).get("refreshedAt")}
+        except Exception: time.sleep(3)
+    raise SystemExit("failed " + url)
+res = {"pulled": datetime.datetime.utcnow().isoformat() + "Z", "rows": {}}
+for t in ["", "house", "townhouse", "condo", "manufactured"]:
+    base = {"type": t} if t else {}
+    r = {"all": total(base), "price_reduced": total(dict(base, has="price_reduced")),
+         "listed_30d": total(dict(base, domMax="30")), "listed_7d": total(dict(base, domMax="7"))}
+    res["rows"][t or "any"] = r
+    print(t or "any", {k: v["total"] for k, v in r.items()}, flush=True)
+json.dump(res, open(os.path.join(out, "listing-counts.json"), "w"), indent=1)
