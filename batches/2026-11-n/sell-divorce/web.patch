+        // ---- court closing banner cache ----
+        function fetchCountyData() {
+          var isCourtClosingsActive = "True";
+          if (isCourtClosingsActive === "False") {
+            $("#alert-bar").hide();
+            return;
+          }
+
+          const cachedData = JSON.parse(localStorage.getItem("countyData"));
+          const lastFetchTime = localStorage.getItem("countyDataFetchTime");
+          const currentTime = new Date().getTime();
+
+          const cacheDuration = Number("1800000") || 0;
+
+          if (cachedData && lastFetchTime && currentTime - Number(lastFetchTime) < cacheDuration) {
+            updateBanner(cachedData);
+            return;
+          }
+
+          $.ajax({
+            url: "/umbraco/surface/reporterdetail/GetClosedCounties",
+            method: "GET",
+            success: function (data) {
+              localStorage.setItem("countyData", JSON.stringify(data));
+              localStorage.setItem("countyDataFetchTime", currentTime.toString());
+              updateBanner(data);
+            },
+            error: function () {
+              console.error("Error fetching county data.");
+            },
+          });
+        }
+
+        function updateBanner(data) {
+          if (data && data.count > 0) {
+            const countyText = data.count === 1 ? "1 county is" : `${data.count} counties are`;
+            $("#county-message").text(
+              `${countyText} currently reporting courthouse closings and/or advisories`
+            );
+            $("#alert-bar").show();
+          } else {
+            $("#alert-bar").hide();
+          }
+        }
