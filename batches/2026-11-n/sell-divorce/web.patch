+          if (cachedData && lastFetchTime && currentTime - Number(lastFetchTime) < cacheDuration) {
+            updateBanner(cachedData);
+            return;
+          }
+
+          $.ajax({
+            url: "/umbraco/surface/reporterdetail/GetClosedCounties",
+            method: "GET",
+            success: function (data) {
+              localStorage.setItem("countyData", JSON.stringify(data));
+              localStorage.setItem("countyDataFetchTime", currentTime.toString());
+              updateBanner(data);
+            },
+            error: function () {
+              console.error("Error fetching county data.");
+            },
+          });
+        }
+
+        function updateBanner(data) {
+          if (data && data.count > 0) {
+            const countyText = data.count === 1 ? "1 county is" : `${data.count} counties are`;
+            $("#county-message").text(
+              `${countyText} currently reporting courthouse closings and/or advisories`
+            );
+            $("#alert-bar").show();
+          } else {
+            $("#alert-bar").hide();
+          }
+        }
+
+        // ---- accordion behavior ----
+        function wireAccordion() {
+          const accordionCustom = document.getElementById("accordiancustom");
+          if (!accordionCustom) return;
+
+          const accordionTitles = document.querySelectorAll(".result-title");
+          accordionTitles.forEach((title) => {
+            title.classList.add("teal-text");
+
+            title.addEventListener("click", function () {
+              const parentItem = this.closest(".accordion-item");
+              if (!parentItem) return;
+
+              document.querySelectorAll(".accordion-item").forEach((item) => {
+                if (item !== parentItem) {
+                  item.classList.remove("active");
+
+                  const info = item.querySelector(".result-info");
+                  if (info) info.style.display = "none";
+
+                  const arrow = item.querySelector(".accordion-arrow");
+                  if (arrow && arrow.classList.contains("fa-chevron-up")) {
+                    arrow.classList.replace("fa-chevron-up", "fa-chevron-down");
+                  }
+                }
+              });
+            });
+          });
+        }
+
+        // ---- alert bar open/close persistence ----
+        function wireAlertBarPersistence() {
+          const alertItem = document.getElementById("alertAccordion");
+          if (!alertItem) return;
+
+          // Save open/closed state whenever the title is clicked
+          alertItem.querySelector(".result-title").addEventListener("click", function () {
+            // Use a microtask so we read the state AFTER accordion.js has toggled it
+            setTimeout(function () {
+              if (alertItem.classList.contains("active")) {
+                Cookies.remove("alertBarOpen");
+              } else {
+                // No 'expires' = session cookie — cleared when browser closes
+                Cookies.set("alertBarOpen", "false", { sameSite: "Lax" });
+              }
+            }, 0);
+          });
+        }
+
+        // ---- single init point ----
+        document.addEventListener("DOMContentLoaded", function () {
+          loadGoogleTranslate();
+          wireTranslateButtons();
+          restoreTranslationIfAny();
+
+          fetchCountyData();
+          wireSkipLinkFocus();
+          wireExternalLinkConfirm();
+          wireAccordion();
+          wireAlertBarPersistence();
+        });
+
+        function logoutMember() {
+            const token = $('#logoutContainer input[name="__RequestVerificationToken"]').val();
+            const returnUrl = $('#logoutButton').data('logout-url') || window.location.pathname + window.location.search;
+
+            $('#logoutButton').prop('disabled', true).text('Logging out...');
