+
+        const rawHref = (link.getAttribute("href") || "").trim();
+        if (!rawHref) return;
+
+        if (rawHref.startsWith("#")) return;
+        if (rawHref.startsWith("/")) return;
+
+        if (allowedSchemes.some(s => rawHref.toLowerCase().startsWith(s)))
+            return;
+
+        let url;
+        try {
+            url = new URL(rawHref, window.location.origin);
+        } catch {
+            return;
+        }
+
+        const host = url.hostname.toLowerCase();
+
+        // Only these hosts are considered internal
+        const isInternal = internalDomains.some(domain =>
+            host === domain.toLowerCase()
+        );
+
+        if (isInternal)
+            return;
+
+        const proceed = confirm(
+            "You are navigating to a different website. Do you want to proceed?"
+        );
+
+        if (!proceed) {
+            event.preventDefault();
+        }
+    });
