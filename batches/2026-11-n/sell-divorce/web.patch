+#!/bin/sh
+# Google search suggestions for /sell/divorce/. Run: sh pull-suggestions.sh > raw/google-suggestions.txt
+for q in "selling house during divorce" "selling a house during divorce in sc" "selling house during divorce south carolina" "divorce and house south carolina" "who gets the house in a divorce in sc" "who gets the house in a divorce" "marital home south carolina divorce" "marital property south carolina" "is south carolina a 50/50 divorce state" "equitable distribution south carolina" "south carolina divorce house" "divorce myrtle beach" "divorce horry county" "horry county family court" "myrtle beach divorce house" "selling house divorce myrtle beach" "can i sell my house during divorce" "can my spouse sell the house without my permission" "can my husband sell the house without my signature" "can my wife sell the house" "do both spouses have to sign to sell a house" "do both spouses have to sign to sell a house in sc" "buying out spouse in divorce" "buy out spouse house" "how to buy out spouse" "how to calculate buyout of house in divorce" "house buyout divorce calculator" "refinance to buy out spouse" "remove spouse from mortgage" "remove ex from mortgage" "quit claim deed divorce sc" "quitclaim deed divorce" "keep the house after divorce" "who pays the mortgage during divorce" "who pays mortgage during separation sc" "capital gains divorce house" "capital gains tax on house sale divorce" "250000 capital gains exclusion divorce" "sell house before or after divorce" "selling house before divorce final" "divorce sale proceeds escrow" "proceeds from sale of house during divorce" "how are proceeds split divorce" "spouse refuses to sell house" "ex won't sell house" "court ordered sale of marital home" "partition sc" "real estate agent divorce" "divorce realtor" "listing house during divorce" "house appraisal divorce" "deferred sale divorce" "nesting divorce house" "lis pendens divorce sc" "how long does a divorce take in sc" "separation agreement sc house" "marital home exclusive use sc" "home equity divorce"; do
+  printf '== %s\n' "$q"
+  curl -sS -A "Mozilla/5.0" "https://suggestqueries.google.com/complete/search?client=firefox&hl=en&gl=us&q=$(python3 -c "import urllib.parse,sys;print(urllib.parse.quote(sys.argv[1]))" "$q")"; echo
+done
