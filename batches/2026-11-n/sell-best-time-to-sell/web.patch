:--c3ph-p2 inline}.c3ph-row>figure:nth-child(3){view-timeline:--c3ph-p3 inline}.c3ph-dots i{animation:c3ph-dot linear both;animation-range:cover}.c3ph-dots i:nth-child(1){animation-timeline:--c3ph-p1}.c3ph-dots i:nth-child(2){animation-timeline:--c3ph-p2}.c3ph-dots i:nth-child(3){animation-timeline:--c3ph-p3}@keyframes c3ph-dot{0%,36%{background:transparent}42%,60%{background:var(--navy)}66%,100%{background:transparent}}}@media (min-width:700px){.c3ph-swipe{display:none}}.c3ph-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:1.4rem 0 1.8rem;padding:0;list-style:none}@media (min-width:700px){.c3ph-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}}@media (min-width:1000px){.c3ph-cards.c3ph-4{grid-template-columns:repeat(4,minmax(0,1fr))}}.c3ph-card{margin:0;background:var(--ivory);border:1px solid var(--rule);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}.c3ph-card .c3ph-f{border-radius:0}.c3ph-card img,.c3ph-card svg{display:block;width:100%;height:auto;aspect-ratio:var(--c3ph-r,4/3);object-fit:cover}.c3ph-card .c3ph-cr{font-size:.56rem;padding:1.2rem .45rem .25rem 1.6rem}.c3ph-card strong{display:block;color:var(--navy);font-size:.98rem;font-weight:500;line-height:1.3;padding:.7rem .8rem 0}.c3ph-card span.c3ph-t{display:block;color:var(--muted);font-size:.86rem;line-height:1.45;padding:.2rem .8rem .85rem}.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:720px}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Spring and early summer are the busiest months for home sales in Horry County. We read the county's index of every deed recorded since 2019 and counted 65,664 home resales from 2021 to 2025. About 38 percent were recorded in March through June, more than in any other four months in a row. An even spread would be 33 percent.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="Home sales recorded in Horry County each month, 2021 to 2025 added together"><span class="cap" aria-hidden="true">Home sales recorded in Horry County each month, 2021 to 2025 added together</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Month</span><span role="columnheader">home sales recorded</span></div></div><div role="rowgroup"><div role="row" class="ref"><span role="rowheader"><span class="n">January</span></span><span role="cell"><span class="b" style="--f:0.684" aria-hidden="true"></span><span class="v">4,363</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">February</span></span><span role="cell"><span class="b" style="--f:0.689" aria-hidden="true"></span><span class="v">4,397</span></span></div><div role="row"><span role="rowheader"><span class="n">March</span></span><span role="cell"><span class="b" style="--f:0.991" aria-hidden="true"></span><span class="v">6,324</span></span></div><div role="row"><span role="rowheader"><span class="n">April</span></span><span role="cell"><span class="b" style="--f:0.96" aria-hidden="true"></span><span class="v">6,130</span></span></div><div role="row"><span role="rowheader"><span class="n">May</span></span><span role="cell"><span class="b" style="--f:0.992" aria-hidden="true"></span><span class="v">6,333</span></span></div><div role="row"><span role="rowheader"><span class="n">June</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">6,383</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">July</span></span><span role="cell"><span class="b" style="--f:0.859" aria-hidden="true"></span><span class="v">5,486</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">August</span></span><span role="cell"><span class="b" style="--f:0.915" aria-hidden="true"></span><span class="v">5,838</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">September</span></span><span role="cell"><span class="b" style="--f:0.855" aria-hidden="true"></span><span class="v">5,458</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">October</span></span><span role="cell"><span class="b" style="--f:0.843" aria-hidden="true"></span><span class="v">5,380</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">November</span></span><span role="cell"><span class="b" style="--f:0.749" aria-hidden="true"></span><span class="v">4,778</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">December</span></span><span role="cell"><span class="b" style="--f:0.751" aria-hidden="true"></span><span class="v">4,794</span></span></div></div></div><figcaption>Our count of county deeds. Resales only: builders' sales of new homes are left out. March to June, the four busiest months, are in color.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">January and February are the slowest months, with 12 to 16 percent of each year's sales. June had about half again as many sales as January.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The pattern is not the same every year. The last of the five years was flatter, and October was its busiest month.</p><h3 id="price-by-month" style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Which month brings the highest price?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">June. A home that closed in June sold for a middle price about 6 percent higher than one that closed in February, the lowest month. Half of the homes sold for more than the middle price, and half for less.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">February was lower than the months around it in all five years. May and June were higher in four of the five.</p><figure class="bt-fig bt-div"><p class="cap" id="btDivCap">Middle sale price by month, compared with the months around it</p><div role="table" aria-labelledby="btDivCap"><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Month</span><span role="columnheader">Middle price against the 13 months around it</span></div></div><div role="rowgroup"><div role="row" class="neg"><span role="rowheader">Jan</span><span role="cell"><span class="tr" aria-hidden="true"><span class="b" style="width:10.6%"></span></span><span class="v">1.1% lower</span></span></div><div role="row" class="neg"><span role="rowheader">Feb</span><span role="cell"><span class="tr" aria-hidden="true"><span class="b" style="width:43.3%"></span></span><span class="v">4.3% lower</span></span></div><div role="row" class="neg"><span role="rowheader">Mar</span><span role="cell"><span class="tr" aria-hidden="true"><span class="b" style="width:14.5%"></span></span><span class="v">1.4% lower</span></span></div><div role="row" class="pos"><span role="rowheader">Apr</span><span role="cell"><span class="tr" aria-hidden="true"><span class="b" style="width:3.6%"></span></span><span class="v">0.4% higher</span></span></div><div role="row" class="pos"><span role="rowheader">May</span><span role="cell"><span class="tr" aria-hidden="true"><span class="b" style="width:19.6%"></span></span><span class="v">2.0% higher</span></span></div><div role="row" class="pos"><span role="rowheader">Jun</span><span role="cell"><span class="tr" aria-hidden="true"><span class="b" style="width:22.1%"></span></span><span class="v">2.2% higher</span></span></div><div role="row" class="pos"><span role="rowheader">Jul</span><span role="cell"><span class="tr" aria-hidden="true"><span class="b" style="width:15.5%"></span></span><span class="v">1.6% higher</span></span></div><div role="row" class="pos"><span role="rowheader">Aug</span><span role="cell"><span class="tr" aria-hidden="true"><span class="b" style="width:12.9%"></span></span><span class="v">1.3% higher</span></span></div><div role="row" class="pos"><span role="rowheader">Sep</span><span role="cell"><span class="tr" aria-hidden="true"><span class="b" style="width:16.6%"></span></span><span class="v">1.7% higher</span></span></div><div role="row" class="neg"><span role="rowheader">Oct</span><span role="cell"><span class="tr" aria-hidden="true"><span class="b" style="width:1.7%"></span></span><span class="v">0.2% lower</span></span></div><div role="row" class="neg"><span role="rowheader">Nov</span><span role="cell"><span class="tr" aria-hidden="true"><span class="b" style="width:2.9%"></span></span><span class="v">0.3% lower</span></span></div><div role="row" class="neg"><span role="rowheader">Dec</span><span role="cell"><span class="tr" aria-hidden="true"><span class="b" style="width:9.5%"></span></span><span class="v">0.9% lower</span></span></div></div></div><figcaption>Each bar compares one month's middle sale price with the 13 months around it: six before and six after. That leaves out the rise in prices from year to year. Averages for 2021 to 2025, from county deeds.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On a home at the county's middle resale price of about $305,000, 6 percent is about $20,000. Part of that difference comes from which homes sell in each month. One house should not expect $20,000 more in June.</p></div></section><section style="background:var(--ivory)" id="when-to-list"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="When to list">When should you list to close in the best months?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">List about two months before the month you want to close. A home is under contract, which agents call pending, once the buyer and the seller have both signed the purchase contract.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Homes go under contract fastest in March, April and May. The middle home that went under contract in March had been on the market about 26 days. In December it took about 53 days.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">After a buyer signs, closing took about five weeks here. The monthly average from contract to sale was 36 to 42 days.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The table counts back about 9 weeks from a closing in the middle of each month, longer in winter. The four busiest months for sales are in bold.</p><div style="overflow-x:auto;margin:1.2rem 0;max-width:760px"><table style="width:100%;border-collapse:collapse;font-size:.92rem"><thead><tr><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">To close in the middle of</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Put the home on the market in</th></tr></thead><tbody><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">January</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">mid October</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">February</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">late November</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><b>March</b></td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><b>early January</b></td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><b>April</b></td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><b>mid February</b></td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><b>May</b></td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><b>early March</b></td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><b>June</b></td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><b>early April</b></td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">July</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">early May</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">August</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">early June</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">September</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">early July</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">October</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">late July</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">November</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">late August</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">December</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">late September</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A worked example: to close in early June, count back about 5 weeks to a signed contract at the end of April. Count back about 4 weeks more, and the house goes on the market around the end of March.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A buyer who pays cash has no lender to wait for. Our page on <a href="/sell/cash-offer/" style="color:var(--navy);text-decoration:underline">cash offers</a> covers that kind of sale.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Have us set a listing date for a May or June closing</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us when you need to be out, and we will work back to the day your home should go on the market.</p><a class="btn btn-brass" href="/contact/">Have us work back from my date</a></div></div></section><section style="background:var(--ivory-2)" id="condo-or-house"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Condo or house">Is the best month different for a condo?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. Condos here sell for the most in April and May, a little earlier in the year than houses, which sell for the most in June. We checked each sale against the county's parcel records to tell a condo from a house.</p><ul class="bt-cards" aria-label="When a condo and a house sell for the most"><li><span class="k">A condo</span><b>Close in April or May. List in February or March.</b><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Condos that closed in April and May sold for a middle price about 4 percent above the months around them, in four of five years. Condos that closed in February sold about 5 percent below, in all five years.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In all eight towns in our rental data, nightly rentals earn the most in July. A condo that closes in April or May is sold before that month.</p></li><li><span class="k">A house or townhome</span><b>Close in June. List in March or April.</b><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Houses that closed in June sold for a middle price about 3 percent above the months around them, in all five years. July and September were higher in all five years too.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">February was about 2 percent below on average, below in three of five years.</p></li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our page on <a href="/sell/sell-my-condo/" style="color:var(--navy);text-decoration:underline">selling a condo</a> covers the rest of a condo sale: the HOA papers, rental programs and buyers' loans.</p></div></section><section style="background:var(--ivory)" id="winter"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Winter">Is winter a bad time to sell a house in Myrtle Beach?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Winter has fewer sales and lower prices. It also has fewer homes for sale to compete with yours.</p><ul class="bt-plain" aria-label="What winter means for a seller"><li><b>Fewer sales, lower prices</b>January and February have the fewest sales of the year. February closings sold for the lowest middle price of the year.</li><li><b>Fewer homes for sale</b>In the Myrtle Beach area, December has the fewest new listings of the year, less than half of April's. Buyers still signed about 640 contracts in a typical December and about 1,110 in January.</li><li><b>Out-of-state buyers buy all year</b>About 3 in 10 buyers in every month get their tax bill outside South Carolina, counting buyers who still own the home. The share is 28 percent for July buyers and 33 percent for April buyers. Our page on <a href="/sell/out-of-state-buyers/" style="color:var(--navy);text-decoration:underline">out-of-state buyers</a> says where they come from.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A home that goes under contract in February closes about five weeks later, in March or early April, when the busy months begin. If you list in winter, our page on <a href="/sell/repairs-before-selling/" style="color:var(--navy);text-decoration:underline">repairs before selling</a> lists what to fix first.</p></div></section><section style="background:var(--ivory-2)" id="hurricane-season"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Hurricane season">Does hurricane season hurt a home sale here?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not as a season. Atlantic <a href="https://www.nhc.noaa.gov/climo/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">hurricane season</a> is June 1 to November 30. Most of the season's activity comes between mid-August and mid-October, with the peak on September 10.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Those months are not a slow season for home sales. August, September and October each had about 8 to 9 percent of a year's home resales. August and September closings sold a little above the months around them on average.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What happened to home sales the week Hurricane Ian came?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Hurricane Ian came ashore near Georgetown on Friday, September 30, 2022. The county recorded 97 home resales the day before and none that Friday. The next Monday and Tuesday it recorded 64 and 94, and the week after the storm had more (317) than the week before (258).</p><figure class="bt-fig bt-ian"><p class="cap">Home sales recorded each working day around Hurricane Ian, 2022</p><div class="wks" role="img" aria-label="Home sales recorded each working day from September 19 to October 14, 2022. 97 on Thursday, September 29, none on Friday, September 30, the day Ian came ashore, then 64 and 94 the next Monday and Tuesday. Week totals: 258, 239, 317, 228."><div class="wk"><div class="bars"><span class="bar" style="height:49%"></span><span class="bar" style="height:53%"></span><span class="bar" style="height:47%"></span><span class="bar" style="height:56%"></span><span class="bar" style="height:61%"></span></div><p class="t"><span>Sep 19 to Sep 23</span><b>258</b></p></div><div class="wk"><div class="bars"><span class="bar" style="height:25%"></span><span class="bar" style="height:80%"></span><span class="bar" style="height:41%"></span><span class="bar" style="height:100%"></span><span class="bar zero"><b class="lb">Ian</b></span></div><p class="t"><span>Sep 26 to Sep 30</span><b>239</b></p></div><div class="wk"><div class="bars"><span class="bar" style="height:66%"></span><span class="bar" style="height:97%"></span><span class="bar" style="height:48%"></span><span class="bar" style="height:51%"></span><span class="bar" style="height:65%"></span></div><p class="t"><span>Oct 3 to Oct 7</span><b>317</b></p></div><div class="wk"><div class="bars"><span class="bar" style="height:30%"></span><span class="bar" style="height:40%"></span><span class="bar" style="height:47%"></span><span class="bar" style="height:60%"></span><span class="bar" style="height:58%"></span></div><p class="t"><span>Oct 10 to Oct 14</span><b>228</b></p></div></div><figcaption>Resales recorded by Horry County, Monday to Friday. The dashed line is Friday, September 30, when Ian came ashore and the county recorded none. The number under each week is that week's total.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The storm Debby came ashore near Bulls Bay early on Thursday, August 8, 2024. The county recorded no sales that day, and that week had fewer than the week before or the week after.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Both times, the county recorded sales again on the next working day. What a storm means for a buyer's insurance is on our <a href="/buyers/coastal-insurance/" style="color:var(--navy);text-decoration:underline">coastal insurance page</a>.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Have us check your closing date against storm season</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the month you hope to close. We plan the listing and the closing day with the storm months in mind.</p><a class="btn btn-brass" href="/contact/">Have us plan around storm season</a></div></div></section><section style="background:var(--ivory)" id="tourists-and-school"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Tourists and school">Do tourist season and the school year change the best month?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Tourist season peaks in July, and school lets out in early June. Both come after the busiest months for home sales.</p><div class="bt-side"><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-n/sell-best-time-to-sell/myrtle-beach-beach-in-june-1200w.webp" srcset="/images/2026-11-n/sell-best-time-to-sell/myrtle-beach-beach-in-june-600w.webp 600w, /images/2026-11-n/sell-best-time-to-sell/myrtle-beach-beach-in-june-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="675" alt="A crowded beach in Myrtle Beach in June, with rental umbrellas, rows of blue beach chairs and oceanfront towers" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: Loadmaster. License: CC BY-SA 3.0" title="License: CC BY-SA 3.0">Photo: Loadmaster</a></span></div><figcaption>Myrtle Beach on a June day. Tourist season peaks in July, the month after houses here sell highest.</figcaption></figure></div><ul class="bt-plain" aria-label="Tourist season and the school year"><li><b>Tourist season</b>Horry County had about 32,300 hotel, restaurant and other leisure jobs in January, and about 45,600 in July. July has fewer home sales than June: about 8.4 percent of a year's sales.</li><li><b>The school year</b>Horry County public schools let out in early June and start again in mid-August. This school year ends on June 8, and the next one starts on August 18. Make-up days can move the last day.</li><li><b>Moving while school is out</b>June is one of the two busiest months for home sales. To close in June, list in March or April.</li></ul></div></div></section><section style="background:var(--ivory-2)" id="what-matters-more"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What matters more">What matters more than the month you sell?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Prices changed far more from year to year than from month to month. The middle price rose about 20 percent from 2021 to 2022, against about 6 percent between February and June.</p><ul class="bt-plain" aria-label="What matters more than the month"><li><b>The year</b>The middle resale price rose from about $230,000 in 2021 to $275,000 in 2022. It has been about $305,000 since 2024. From January to October this year it was $305,000, against $304,000 a year earlier, with about the same number of sales. Our <a href="/sell/home-value/" style="color:var(--navy);text-decoration:underline">home value page</a> gives middle prices by area.</li><li><b>The market now</b>In September 2026, about 8,000 homes were for sale in the Myrtle Beach area, about the same as a year earlier. The middle home went under contract in about 53 days, against 61 a year earlier. About 3 in 10 listings had cut their asking price.</li><li><b>The asking price</b>Buyers pay about the same share of the asking price in every month. The middle home sold for about 97.9 percent of its last asking price in June and 97.1 percent in December. The <a href="/homes/map/?domMax=30" style="color:var(--navy);text-decoration:underline">homes listed in the last 30 days</a> are on our map.</li><li><b>Tax on your main home</b>You may be able to leave up to $250,000 of the gain out of your income. On a joint return it is $500,000 when both spouses lived there 2 years. You must have owned the home and lived in it as your main home for at least 2 of the 5 years before the sale. The rule generally does not apply if you used it on another home in the 2 years before. <a href="https://www.irs.gov/taxtopics/tc701" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Selling a few months early</a> can cost that.</li><li><b>A rental or second home</b>For a rental or second home you bought, the gain is generally long-term only if you held it <a href="https://www.irs.gov/taxtopics/tc409" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">more than one year</a>. A gift or an inherited home follows other rules. Our <a href="/sell/capital-gains/" style="color:var(--navy);text-decoration:underline">capital gains page</a> explains both rules. Ask a tax pro about your own sale.</li><li><b>Your own dates</b>You may have a date you must move by: a lease that ends, a new job, or a home you are buying. Work back from that date with the weeks above. Our pages on <a href="/sell/sell-or-buy-first/" style="color:var(--navy);text-decoration:underline">whether to sell or buy first</a> and <a href="/sell/rental-property/" style="color:var(--navy);text-decoration:underline">selling a rented home</a> cover those cases.</li></ul><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Have us price it for the month you list</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We price your home from recorded sales near you and the homes you would compete with that month.</p><a class="btn btn-brass" href="/contact/">Send us your address</a></div></div></section><section style="background:var(--ivory)" id="best-time-to-sell-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Best time to sell FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What is the worst month to sell a house in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">February, for price. Homes that closed in February sold for a middle price about 4 percent below the months around them, below in all five years from 2021 to 2025. January and February also have the fewest sales.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do houses sell in December in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. Buyers signed about 640 contracts in a typical December in the Myrtle Beach area. December also has the fewest new listings of the year, so fewer homes compete with yours.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How long does it take from contract to closing in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About five weeks. The monthly average from a signed contract to the sale was 36 to 42 days in the Myrtle Beach area.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is now a good time to sell a house in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Prices are level. The county's middle resale price from January to October this year was $305,000, against $304,000 a year earlier. In September 2026, about 3 in 10 listings had cut their asking price.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">When is the best time to sell a beach condo in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Spring. Condos that closed in April and May sold for a middle price about 4 percent above the months around them, in four of five years. To close then, list in February or March.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeDocType" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">County deeds</a>, <a href="https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer/24" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">County parcels</a>, <a href="https://www.zillow.com/research/data/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Zillow Research</a>, <a href="https://www.nhc.noaa.gov/climo/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NOAA hurricane climatology</a>, <a href="https://www.nhc.noaa.gov/data/tcr/AL092022_Ian.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NHC Ian report</a>, <a href="https://www.nhc.noaa.gov/data/tcr/AL042024_Debby.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NHC Debby report</a>, <a href="https://www.horrycountyschools.net/about-hcs/hcs-calendars" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County Schools calendars</a>, <a href="https://download.bls.gov/pub/time.series/sm/sm.data.42.SouthCarolina" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">BLS jobs</a>, <a href="https://www.irs.gov/taxtopics/tc701" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">IRS Topic 701</a>, <a href="https://www.irs.gov/taxtopics/tc409" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">IRS Topic 409</a>. Sales by month and middle prices: our count of county deeds, 2021 to 2025. Rental months: AirROI, in our rental data.</p><div class="bt-notes"><p class="bt-small"><strong>How we counted.</strong> A resale is a deed of $10,000 or more for one home that the county lists today as residential, with a building on it. We left out 21,968 sales by builders, whose closings are spread more evenly over the year. We also left out tax sales, foreclosures, corrective deeds and sales under 30 percent of the county's value.</p><p class="bt-small">Of the 65,664 resales, about 37,400 were houses and townhomes and 28,300 condos. Each sale is counted in the month the county recorded its deed, which comes after the closing. The county's index carries a parcel number on nearly every deed only from July 2020, so our count starts in 2021. Days to a contract and to closing, new listings and price cuts are Zillow's figures for the Myrtle Beach area.</p><p class="bt-small"><strong>Legal notice.</strong> Chapter3 Realty Corp is a licensed South Carolina real estate brokerage. We are not tax advisers, and nothing on this page is tax or legal advice.</p></div><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Myrtle Beach on a June day. Photo: Loadmaster (David R. Tribble), <a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 3.0</a>, via <a href="https://commons.wikimedia.org/wiki/File:Atlantic_Ocean_shoreline_in_Myrtle_Beach,_South_Carolina.jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>. Chapter3 Realty cropped and resized the photo.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-11-n/sell-best-time-to-sell/myrtle-beach-beach-in-june-1200w.webp","url":"https://chapter3realty.com/images/2026-11-n/sell-best-time-to-sell/myrtle-beach-beach-in-june-1200w.webp","width":1200,"height":675,"encodingFormat":"image/webp","name":"Myrtle Beach on a June day","caption":"Myrtle Beach on a June day. Tourist season peaks in July, the month after houses here sell highest.","description":"A crowded beach in Myrtle Beach in June, with rental umbrellas, rows of blue beach chairs and oceanfront towers","creator":{"@type":"Person","name":"Loadmaster (David R. Tribble)"},"creditText":"Loadmaster (David R","copyrightNotice":"© Loadmaster (David R. Tribble), CC BY-SA 3.0","license":"https://creativecommons.org/licenses/by-sa/3.0/","acquireLicensePage":"https://commons.wikimedia.org/wiki/File:Atlantic_Ocean_shoreline_in_Myrtle_Beach,_South_Carolina.jpg","isBasedOn":"https://commons.wikimedia.org/wiki/File:Atlantic_Ocean_shoreline_in_Myrtle_Beach,_South_Carolina.jpg","contentLocation":{"@type":"Place","name":"Oceanfront, south Myrtle Beach, Myrtle Beach, South Carolina"},"representativeOfPage":true}]}</script></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Have us plan your sale from listing day to closing</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">Tell us when you need to move. We work out the week to list and price your home from recorded sales near it.</p><a class="btn btn-brass btn-lg" href="/contact/">Have us plan my sale</a></div></section></main>
