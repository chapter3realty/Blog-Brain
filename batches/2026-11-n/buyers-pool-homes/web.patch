+++ b/specs/buyers-pool-homes.js
@@ -0,0 +1,365 @@
+/* /buyers/pool-homes/ - homes with a pool in Myrtle Beach: how many houses for sale have their own pool and at what
+ * prices, where they are by town (our count of the site's listings), how the chance of a pool climbs with price, your own
+ * pool or a neighborhood pool, Horry County's pool fence rule as our own drawing, what a home inspection leaves out, and
+ * what a pool adds to insurance, property tax and the swimming season. A landing page: the live search is its main offer.
+ *
+ * Batch 2026-11-n, Lane N (a new page). Version 1, 2026-11-08. Design: the approved pilots of batch 2026-11-a
+ * (sell-fsbo, submarkets-pawleys-island, hoa-liens-and-foreclosure, invest-condos): a two-line headline with the italic
+ * sub line at about half the H1 size, the answer first, one card style used once (own pool or neighborhood pool, the one
+ * place the reader chooses), plain lists and a plain table under thin rules elsewhere, one block width of 720 px, and on
+ * wide screens the photo beside the paragraphs on where pool homes are. DESIGN.md in the batch folder says why.
+ * Facts: Blog-Brain batches/2026-11-n/buyers-pool-homes/facts.md, VERIFIED rows, and CORRECTED rows only in the
+ * verifier's wording (VERIFY.md). Struck wording: struck.json in the same folder (no "every pool must be enclosed", no
+ * "so a child cannot climb them", no "unless the pool has a safety cover or the doors close", no "the state does not
+ * regulate it", no "by the hour or day", no "valued as of the sale", no "taxable value", no 358 or 81 percent, no
+ * "June to September are the wettest", no "in Horry and Georgetown counties" for the live search).
+ * Data, never typed (website working copy, data/2026-11-n/buyers-pool-homes/):
+ *   findings.json   rows 1 to 7 and 20 (shares, price bands, size bands, traits, by town, the shared-pool group),
+ *                   row 19 (NOAA normals); built by analyze.py from listings.json and listings-extra.json
+ *   photos.json     the one photo: oceanfront houses with pools in Surfside Beach, USGS 2011, public domain
+ *                   (frame 2011_0824_175720d, used on no other page; VERIFY.md Photos)
+ * Typed and checked: the law and guidance (rows 8 to 18), each in the verifier's wording.
+ * Our own drawing: the county's fence rule (rows 10, 11), numbered, with its key beside it.
+ * Owner questions open (OWNER-QUESTIONS.md): Q1 upkeep a month (left off, no "it depends"), Q2 who inspects the pool for
+ * our buyers (left off; the second offer asks only for the house), Q3 a real story (none), Q4 screen enclosures (left off).
+ * Built by tools/mkpage.js. */
+const fs = require("fs"), path = require("path");
+const { h, BB } = require("./_kit.js");
+const G = require(path.join(BB, "tools", "glass.js"));
+const PK = require(path.join(BB, "tools", "page-kit.js"));
+
+const SELF = "/buyers/pool-homes/";
+const DATA = path.join(__dirname, "..", "data", "2026-11-n", "buyers-pool-homes");
+const read = (f) => JSON.parse(fs.readFileSync(path.join(DATA, f), "utf8"));
+const F = read("findings.json");
+const money = (v) => "$" + Math.round(v).toLocaleString("en-US");
+const n0 = (v) => Math.round(v).toLocaleString("en-US");
+const about50 = (v) => n0(Math.round(v / 50) * 50);
+const about10 = (v) => n0(Math.round(v / 10) * 10);
+const oneIn = (part, whole) => Math.round(whole / part);
+const DAY = new Date(F.pulled).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
+const CTA = "/contact/";
+const MAP = "/homes/map/?q=house%20with%20a%20pool";
+
+/* ---- Rows 1, 2: the share and the middle asking prices. ---- */
+const SH = F.share_with_pool, MED = F.medians;
+if (SH.pool !== 257 || SH.houses !== 2950 || oneIn(SH.pool, SH.houses) !== 11) throw new Error("row 1 moved");
+if (MED.ask.pool !== 955000 || MED.ask.not_pool !== 400000) throw new Error("row 2 moved");
+
