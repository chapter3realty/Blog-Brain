+  + `<td class="txt" data-l="Builders that sold the most">${lead(t)}</td>`
+  + `<td class="num" data-l="Middle price">${r1k(t.median_price)}</td></tr>`;
+const TOWN_TABLE = `<table class="bd-t bd-towns"><caption>New homes builders sold, by mailing town</caption>`
+  + `<thead><tr><th scope="col">Town</th><th scope="col" class="num">New homes sold</th><th scope="col">Builders that sold the most there</th><th scope="col" class="num">Middle price</th></tr></thead><tbody>`
+  + TOWNS.map(townRow).join("") + `</tbody></table>`
+  + `<p class="bd-note">Our count of county deeds for the same 12 months, with the number each builder sold in that town. A town here is the mailing address, not city limits. A Myrtle Beach address includes Carolina Forest and Socastee. Towns with 40 or more new homes sold.</p>`;
+
+/* ---- Row 4, as a picture: the dot map. Every kept builder sale at its parcel's centre, rounded to about 100 m
