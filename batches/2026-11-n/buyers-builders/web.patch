+/* ---- Row 10: companies that bought from builders (146: the file's 147 less one person, VERIFY.md 8). ---- */
+must(F.builder_sales_bought_by_a_company === 147, "row 10 moved");
+const CO = F.builder_sales_bought_by_a_company - 1;
+const CO_BY = Object.fromEntries(F.builder_sales_bought_by_a_company_by_builder);
+must(CO_BY["Lennar"] === 65 && CO_BY["D.R. Horton"] === 57, "row 10: by builder moved");
+const CO_DRH = CO_BY["D.R. Horton"] - 1;
