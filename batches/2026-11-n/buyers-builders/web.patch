+must(B16.map((b) => `${nm(b.builder)}:${b.sales}`).join() === "D.R. Horton:1397,Lennar:967,Ryan Homes:477,Pulte Homes:382,Meritage Homes:313,Five community companies:239,Mungo Homes:206,Great Southern Homes:182,Beverly Homes:182,Beazer Homes:156,Dream Finders Homes:149,Starlight Homes:148,Toll Brothers:100,Ashton Woods:94,DRB Homes:61,Howell Homes:52", "row 2: the counts moved");
+const BY = Object.fromEntries(F.by_builder.map((b) => [b.builder, b]));
