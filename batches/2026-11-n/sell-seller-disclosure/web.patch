in-left:auto!important;margin-right:auto!important}@media (max-width:699px){main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2)>.wrap{padding:1.6rem 1.2rem 1.7rem!important;border-radius:24px!important}}</style><style>.c3-glance{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(var(--n),minmax(0,1fr));gap:.75rem;max-width:760px}.c3-glance li{display:flex;align-items:center;gap:.55rem;margin:0;padding:.5rem .6rem;background:rgba(255,255,255,.55);border:1px solid var(--rule);border-radius:6px;line-height:1.25}.c3-glance .i{flex:0 0 auto;display:flex;width:2rem;height:2rem;border-radius:50%;background:var(--ivory-2);color:var(--brass-ink);align-items:center;justify-content:center}.c3-glance strong{display:block;color:var(--navy);font-size:.9rem;font-weight:500}.c3-glance span.t{display:block;color:var(--muted);font-size:1rem}@media (max-width:699px){.c3-glance{gap:.3rem}.c3-glance li{flex-direction:column;justify-content:flex-start;text-align:center;gap:.2rem;padding:.4rem .1rem}.c3-glance .i{width:1.6rem;height:1.6rem}.c3-glance strong{font-size:.875rem}.c3-glance span.t{font-size:1rem;line-height:1.2}}</style><ul role="list" class="c3-glance" style="--n:3"><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5.5 7h8A1.5 1.5 0 0 1 15 8.5v11a1.5 1.5 0 0 1-1.5 1.5h-8A1.5 1.5 0 0 1 4 19.5v-11A1.5 1.5 0 0 1 5.5 7zM8 7V4.5A1.5 1.5 0 0 1 9.5 3h9A1.5 1.5 0 0 1 20 4.5v11a1.5 1.5 0 0 1-1.5 1.5H15M9.5 17.5l-2.3-2.4a1.4 1.4 0 0 1 2.3-1.6 1.4 1.4 0 0 1 2.3 1.6z"/></svg></span><span><strong>28 questions</strong><span class="t">on the state form, each Yes, No or No Representation</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 5h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM3 10h18M8 3v4M16 3v4M8 14h.01M12 14h.01M16 14h.01M8 17.5h.01M12 17.5h.01"/></svg></span><span><strong>8 items</strong><span class="t">ask about the years you owned the home</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span><strong>15 kinds of sale</strong><span class="t">need no form</span></span></li></ul></div><p style="color:var(--muted);font-size:.9rem;margin-bottom:1rem">By <strong style="color:var(--navy);font-weight:600">Devin Day</strong>, Operations Officer &middot; Reviewed by <strong style="color:var(--navy);font-weight:600">Tim Nash</strong>, Broker-in-Charge &middot; <span style="white-space:nowrap">Updated November 8, 2026</span></p><p class="detail-sub">Who must fill in the state form, what its 28 numbered questions mean, and what happens if a seller leaves something out.</p></div></div><section style="background:var(--ivory)"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">The short answer</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A South Carolina seller must give the buyer the state's disclosure form, filled in and signed, before both sign the contract. The form asks what you know about the home, and a seller who knowingly leaves a problem off can owe the buyer their losses.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Fifteen kinds of sale need no form. Two things touch many Grand Strand sales. One is the flood questions about the years you owned the home. The other is a beachfront statement for homes on lots past the state's setback line, about 10,700 in Horry County.</p></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><p style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Selling soon? Start with your flood zone.</p><a class="btn btn-brass btn-lg" href="/contact/">Have us look up your flood zone</a></div></section><section style="background:var(--ivory);padding-top:2.5rem"><div class="wrap"><nav aria-label="On this page" style="margin-top:0;max-width:720px"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.3rem;font-weight:600">On this page</p><ul style="list-style:none;margin:0;padding:0"><li><a href="#who" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Who must fill it in</a></li><li><a href="#exempt" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Sales that need no form</a></li><li><a href="#when" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">When it is due</a></li><li><a href="#answers" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">How to answer</a></li><li><a href="#checklist" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Every question on the form</a></li><li><a href="#flooding" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Flooding</a></li><li><a href="#beachfront" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Beachfront homes</a></li><li><a href="#lead" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Lead paint</a></li><li><a href="#not-required" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">What you do not have to say</a></li><li><a href="#left-out" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">If something is left out</a></li><li><a href="#steps" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Step by step</a></li><li><a href="#seller-disclosure-faq" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Seller disclosure FAQ</a></li></ul></nav></div></section><section style="background:var(--ivory-2)" id="who"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Who must fill it in">Who has to fill out a seller disclosure in South Carolina?</h2><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);letter-spacing:.01em;color:#fff;text-align:right;background:radial-gradient(farthest-side at 100% 100%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.c3ph-cr a{color:#fff;text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);text-underline-offset:2px;pointer-events:auto;padding:10px 0 6px}.c3ph-hero{margin:1.6rem 0 2rem}.c3ph-hero .c3ph-f{border-radius:8px}.c3ph-hero img{aspect-ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}.c3ph-gal{display:grid;grid-template-columns:minmax(0,1fr);gap:1.5rem;margin:1.6rem 0;padding:0;list-style:none}.c3ph-gal>figure{margin:0;min-width:0}.c3ph-gal img{aspect-ratio:var(--c3ph-r,4/3)}.c3ph-gal figcaption{color:var(--muted);font-size:.85rem;line-height:1.45;margin-top:.5rem}@media (min-width:700px){.c3ph-gal{display:grid;grid-template-columns:repeat(var(--c3ph-n,3),minmax(0,1fr));gap:1rem;overflow:visible;padding:0}.c3ph-gal>figure{min-width:0}}@media (max-width:699px){.c3ph-gal.c3ph-row{display:flex;gap:.75rem;padding:0 var(--c3ph-bleed,1.4rem) .4rem;margin:1.6rem calc(-1*var(--c3ph-bleed,1.4rem)) 0;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding:0 var(--c3ph-bleed,1.4rem);-webkit-overflow-scrolling:touch;scrollbar-width:none}.c3ph-row::-webkit-scrollbar{display:none}.c3ph-row>figure{flex:0 0 82%;scroll-snap-align:start}}.c3ph-swipe{display:flex;align-items:center;gap:.75rem;margin:.5rem 0 1.6rem;color:var(--navy);font:500 .95rem/1.3 var(--sans)}.c3ph-dots{display:inline-flex;gap:.45rem}.c3ph-dots i{display:block;width:10px;height:10px;border-radius:50%;border:1.5px solid var(--navy);box-sizing:border-box}.c3ph-dots i:first-child{background:var(--navy)}@supports (animation-timeline:view()){.c3ph-rowbox{timeline-scope:--c3ph-p1,--c3ph-p2,--c3ph-p3}.c3ph-row>figure:nth-child(1){view-timeline:--c3ph-p1 inline}.c3ph-row>figure:nth-child(2){view-timeline:--c3ph-p2 inline}.c3ph-row>figure:nth-child(3){view-timeline:--c3ph-p3 inline}.c3ph-dots i{animation:c3ph-dot linear both;animation-range:cover}.c3ph-dots i:nth-child(1){animation-timeline:--c3ph-p1}.c3ph-dots i:nth-child(2){animation-timeline:--c3ph-p2}.c3ph-dots i:nth-child(3){animation-timeline:--c3ph-p3}@keyframes c3ph-dot{0%,36%{background:transparent}42%,60%{background:var(--navy)}66%,100%{background:transparent}}}@media (min-width:700px){.c3ph-swipe{display:none}}.c3ph-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:1.4rem 0 1.8rem;padding:0;list-style:none}@media (min-width:700px){.c3ph-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}}@media (min-width:1000px){.c3ph-cards.c3ph-4{grid-template-columns:repeat(4,minmax(0,1fr))}}.c3ph-card{margin:0;background:var(--ivory);border:1px solid var(--rule);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}.c3ph-card .c3ph-f{border-radius:0}.c3ph-card img,.c3ph-card svg{display:block;width:100%;height:auto;aspect-ratio:var(--c3ph-r,4/3);object-fit:cover}.c3ph-card .c3ph-cr{font-size:.56rem;padding:1.2rem .45rem .25rem 1.6rem}.c3ph-card strong{display:block;color:var(--navy);font-size:.98rem;font-weight:500;line-height:1.3;padding:.7rem .8rem 0}.c3ph-card span.c3ph-t{display:block;color:var(--muted);font-size:.86rem;line-height:1.45;padding:.2rem .8rem .85rem}.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:720px}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The owner of a home with one to four units who sells it. The <a href="https://www.scstatehouse.gov/code/statmast.php?title=27&amp;chapter=50" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">state law</a> applies to a house, a condo, a townhouse or a building of up to four homes. It applies to a sale, a trade, a land contract, where the buyer pays you over time, and a lease with an option to buy.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The law's duty falls on each owner named in the contract. The form has signature lines for the owners.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The form covers the home itself, not shared areas you have no direct responsibility for, such as a condo's common areas. The condo addendum still asks about problems you know of in the shared areas.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The law lists no exemption for an investor, a landlord, a second-home owner or a company. The "never lived in" exemption covers only the first sale of a home no one has ever lived in. A rental you never lived in still needs the form, unless the sale is one of the 15 exempt kinds. Our page on <a href="/sell/rental-property/" style="color:var(--navy);text-decoration:underline">selling a rental property</a> covers the rest of that sale.</p></div></section><section style="background:var(--ivory)" id="exempt"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Sales that need no form">Which sales do not need the disclosure form?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">South Carolina lists 15 kinds of sale that need no form. Find yours:</p><ul class="sd-cards" aria-label="Sales that need no disclosure form in South Carolina"><li><b>Only to close family</b>A sale only to your spouse, or only to your children, grandchildren, parents or grandparents. If your child's spouse is also a buyer, the sale needs the form.</li><li><b>Only between co-owners</b>One owner sells to the other owners, and no one else is a buyer.</li><li><b>An executor, trustee or court</b>A sale by an executor or trustee settling an estate or a trust, or a sale under a court order. Our page on <a href="/sell/inherited-house/" style="color:var(--navy);text-decoration:underline">selling an inherited house</a> covers the rest.</li><li><b>The foreclosure, and the lender's sale after it</b>The foreclosure sale itself, and a sale by a lender that took the home at a foreclosure sale.</li><li><b>A transfer between spouses</b>A transfer between spouses under a divorce decree or a court's property order. A sale to a buyer outside the marriage needs the form, unless it is another exempt kind. See <a href="/sell/divorce/" style="color:var(--navy);text-decoration:underline">selling in a divorce</a>.</li><li><b>The first sale of a new home</b>A home no one has ever lived in, sold for the first time. Our <a href="/buyers/new-construction/" style="color:var(--navy);text-decoration:underline">new construction page</a> covers buying one.</li><li><b>A tax sale</b>A transfer because an owner did not pay federal, state or local taxes.</li><li><b>A public auction</b>A home sold at a public auction.</li><li><b>A timeshare</b>A vacation time share, or a share in a vacation home owned by many people.</li><li><b>Both sides agree in writing</b>Buyer and seller both agree in writing not to complete the form. Neither side has to agree.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The other three are a sale to or from the federal government, a sale to the State, and a transfer to a residential trust. If you are not sure your sale fits one of the 15, the closing attorney can say.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Selling "as is", which means without repairs, still needs the form, unless the sale is one of the 15 kinds. Our pages on <a href="/sell/repairs-before-selling/" style="color:var(--navy);text-decoration:underline">repairs before selling</a> and <a href="/sell/cash-offer/" style="color:var(--navy);text-decoration:underline">cash offers</a> cover those choices.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Not sure your sale needs the form?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us who you are selling to and how. An agent checks your sale against the state's list and marks anything the closing attorney should decide.</p><a class="btn btn-brass" href="/contact/">Ask us about your sale</a></div></div></section><section style="background:var(--ivory-2)" id="when"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="When it is due">When do you give the buyer the seller disclosure?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Before the buyer signs the contract, unless your contract names another time.</p><ol class="sd-when" aria-label="When the disclosure form is due"><li><span class="k">When you list</span><b>Fill it in and sign it</b>Answer from what you know and the records you have.</li><li><span class="k">Before the contract</span><b>The buyer gets it and signs for it</b>The buyer's signature says they received it.</li><li><span class="k">Until closing</span><b>Keep it true</b>If the roof starts to leak after you hand it over, correct the form or make the repair before closing.</li></ol><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A missing form does not cancel the contract or stop the closing, and it does not put a defect on the title. A seller who knowingly skips it still breaks a duty under the same law.</p></div></section><section style="background:var(--ivory)" id="answers"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="How to answer">What do Yes, No and No Representation mean on the form?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Each answer is about what you know. The form asks about problems, which it says include present defects, malfunctions, damage, conditions or characteristics.</p><dl class="sd-ans" aria-label="What each answer on the form means"><div><dt>Yes</dt><dd>You know of a problem. Explain it on the form, or attach a report from an engineer, a contractor, a pest control company or another expert.</dd></div><div><dt>No</dt><dd>You have no actual knowledge of a problem.</dd></div><div><dt>No Representation</dt><dd>You do not know enough to answer Yes or No. It is not a way to skip a question. It does not protect you if you know of the problem, or learn of it later.</dd></div></dl><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For questions 15 to 28, the form asks what you know or were told in a notice, such as a letter from the county. The law does not define "actual knowledge" beyond the form's words. A question about what you should have known goes to a South Carolina attorney.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The form says that if you attach an expert's report, you are not liable for its mistakes. The exception is if you were grossly negligent, meaning careless in a serious way, in getting it or passing it on.</p></div></section><section style="background:var(--ivory-2)" id="checklist"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Every question on the form">What does the South Carolina disclosure form ask?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The <a href="https://llr.sc.gov/re/recpdf/Property-Condition-Disclosure-Statement-06.2025.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">state form</a> has nine parts of questions, one for each subject the law names, and a last part for explaining your Yes answers. It asks 28 numbered questions, each answered Yes, No or No Representation.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">It also has lines where you describe things such as where the water comes from, the roof's age, termite treatment, leases and contamination. A home in a homeowners association (HOA), a property owners association or a condo association also needs the addendum.</p><div class="sd-cl-wrap"><div class="sd-cl" id="sd-checklist"><p class="sd-cl-head"><span>The South Carolina disclosure form, every question</span><button type="button" class="sd-print" onclick="sdPrint()">Print this checklist</button></p><p class="sd-legend"><span class="no own" aria-hidden="true">5</span>The brown numbers mark the 8 items that ask only about the years you owned the home. Letters mark lines where you describe something.</p><div class="sd-part" id="part-i" role="group" aria-label="Part I"><h3 data-toc="I Water and sewer"><span class="pn">Part I</span> Water and sewer</h3><ul><li><label><input type="checkbox"><span class="no" aria-label="Question 1">1</span><span class="t">Problems with the water supply</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 2">2</span><span class="t">Problems with water quality</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 3">3</span><span class="t">Problems with water pressure</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 4">4</span><span class="t">Problems with the sewer or septic system</span></label></li><li><label><input type="checkbox"><span class="no ds" aria-label="Describe line A">A</span><span class="t">Where the water comes from: city, county, well or other</span></label></li><li><label><input type="checkbox"><span class="no ds" aria-label="Describe line B">B</span><span class="t">Where waste water goes: septic, sewer or other</span></label></li><li><label><input type="checkbox"><span class="no ds" aria-label="Describe line C">C</span><span class="t">What the water pipes are made of, such as PEX, PVC, copper, polybutylene or steel</span></label></li></ul></div><div class="sd-part" id="part-ii" role="group" aria-label="Part II"><h3 data-toc="II Roof and structure"><span class="pn">Part II</span> Roof and structure</h3><ul><li><label><input type="checkbox"><span class="no own" aria-label="Question 5, asks about the years you owned the home">5</span><span class="t">Problems with the roof, the year it was put on, and any leaks or repairs while you owned it</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 6">6</span><span class="t">Problems with the gutters</span></label></li><li><label><input type="checkbox"><span class="no own" aria-label="Question 7, asks about the years you owned the home">7</span><span class="t">Problems with the foundation, floors, walls, windows, doors, decks or other structure, the year the house was built, and repairs while you owned it</span></label></li></ul></div><div class="sd-part" id="part-iii" role="group" aria-label="Part III"><h3 data-toc="III Plumbing, electrical, heating and cooling"><span class="pn">Part III</span> Plumbing, electrical, heating and cooling</h3><ul><li><label><input type="checkbox"><span class="no" aria-label="Question 8">8</span><span class="t">Problems with the plumbing or water heater</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 9">9</span><span class="t">Problems with the wiring or electrical panel</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 10">10</span><span class="t">Problems with the appliances</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 11">11</span><span class="t">Problems with built-in systems such as fans, irrigation, a pool or security</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 12">12</span><span class="t">Problems with pumps, the garage door opener or other equipment</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 13">13</span><span class="t">Problems with the heating</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 14">14</span><span class="t">Problems with the air conditioning, and its type and age</span></label></li></ul></div><div class="sd-part" id="part-iv" role="group" aria-label="Part IV"><h3 data-toc="IV Termites and pests"><span class="pn">Part IV</span> Termites and pests</h3><ul><li><label><input type="checkbox"><span class="no ds" aria-label="Describe line A">A</span><span class="t">Wood damage from termites, rot or fungus you know of now</span></label></li><li><label><input type="checkbox"><span class="no ds" aria-label="Describe line B">B</span><span class="t">Any termite treatment, or a termite bond, which is a contract with a pest control company, and who provides it</span></label></li><li><label><input type="checkbox"><span class="no ds" aria-label="Describe line C">C</span><span class="t">Any pests in the house now</span></label></li></ul></div><div class="sd-part" id="part-v" role="group" aria-label="Part V"><h3 data-toc="V Rules, permits, title and water"><span class="pn">Part V</span> Rules, permits, title and water</h3><ul><li><label><input type="checkbox"><span class="no" aria-label="Question 15">15</span><span class="t">Work done without a permit, or that breaks zoning or the neighborhood rules</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 16">16</span><span class="t">Whether the house is in a historic district</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 17">17</span><span class="t">Shared driveways, private roads, a fence or building over the line, or easements, which give someone else a right to use part of your land</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 18">18</span><span class="t">Lawsuits, liens, foreclosure, bankruptcy, insurance issues or government actions that could affect the title</span></label></li><li><label><input type="checkbox"><span class="no own" aria-label="Question 19, asks about the years you owned the home">19</span><span class="t">Rooms added or structure changed while you owned it</span></label></li><li><label><input type="checkbox"><span class="no own" aria-label="Question 20, asks about the years you owned the home">20</span><span class="t">Fire, smoke or water damage while you owned it, including any flooding</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 21">21</span><span class="t">Drainage or soil problems</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 22">22</span><span class="t">Erosion, or a seawall, bulkhead or sandbags</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 23">23</span><span class="t">Flood zone, wetlands or flood risk</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 24">24</span><span class="t">Whether the home has flood insurance now</span></label></li><li><label><input type="checkbox"><span class="no own" aria-label="Question 25, asks about the years you owned the home">25</span><span class="t">Flood insurance claims while you owned it, with dates and amounts</span></label></li><li><label><input type="checkbox"><span class="no own" aria-label="Question 26, asks about the years you owned the home">26</span><span class="t">Flood repairs you paid for without a claim while you owned it</span></label></li><li><label><input type="checkbox"><span class="no own" aria-label="Question 27, asks about the years you owned the home">27</span><span class="t">Federal flood aid from FEMA, the SBA or HUD that you received while you owned it</span></label></li><li><label><input type="checkbox"><span class="no own" aria-label="Question 28, asks about the years you owned the home">28</span><span class="t">A charge for beach renourishment, which is sand added back to the beach, while you owned it</span></label></li><li><label><input type="checkbox"><span class="no ds" aria-label="Describe line A">A</span><span class="t">Solar, energy or accessibility features</span></label></li><li><label><input type="checkbox"><span class="no ds" aria-label="Describe line B">B</span><span class="t">A manufactured home with a vehicle title on the land</span></label></li></ul></div><div class="sd-part" id="part-vi" role="group" aria-label="Part VI"><h3 data-toc="VI Lead, mold and other hazards"><span class="pn">Part VI</span> Lead, mold and other hazards</h3><ul><li><label><input type="checkbox"><span class="no ds" aria-label="Describe line A">A</span><span class="t">Lead paint, asbestos, radon, mold, storage tanks or other contamination you know of</span></label></li></ul></div><div class="sd-part" id="part-vii" role="group" aria-label="Part VII"><h3 data-toc="VII Leases and vacation rentals"><span class="pn">Part VII</span> Leases and vacation rentals</h3><ul><li><label><input type="checkbox"><span class="no ds" aria-label="Describe line A">A</span><span class="t">Leases and vacation rental bookings that will still be in place at closing</span></label></li><li><label><input type="checkbox"><span class="no ds" aria-label="Describe line B">B</span><span class="t">The rental manager, if any</span></label></li><li><label><input type="checkbox"><span class="no ds" aria-label="Describe line C">C</span><span class="t">Utility bills a tenant still owes</span></label></li></ul></div><div class="sd-part" id="part-viii" role="group" aria-label="Part VIII"><h3 data-toc="VIII Utility charges"><span class="pn">Part VIII</span> Utility charges</h3><ul><li><label><input type="checkbox"><span class="no ds" aria-label="Describe line A">A</span><span class="t">Equipment a utility company financed or leases on the property</span></label></li><li><label><input type="checkbox"><span class="no ds" aria-label="Describe line B">B</span><span class="t">Unpaid utility bills</span></label></li></ul></div><div class="sd-part" id="part-ix" role="group" aria-label="Part IX"><h3 data-toc="IX Homeowners association (HOA)"><span class="pn">Part IX</span> Homeowners association (HOA)</h3><ul><li><label><input type="checkbox"><span class="no ds" aria-label="Describe line IX">IX</span><span class="t">Whether an HOA or condo association governs the home. If Yes, fill in the addendum</span></label></li></ul></div><div class="sd-part" id="part-addendum" role="group" aria-label="The HOA addendum"><h3 data-toc="+ The HOA addendum"><span class="pn">Addendum</span> For a home in an HOA or condo association</h3><ul><li><label><input type="checkbox"><span class="no" aria-label="Question 1">1</span><span class="t">Association dues or shared costs</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 2">2</span><span class="t">Rules on resale or renting</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 3">3</span><span class="t">Special assessments, which are charges the association adds on top of the regular dues</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 4">4</span><span class="t">Rules on guests</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 5">5</span><span class="t">Rules on pets</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 6">6</span><span class="t">Assigned parking, storage or garages</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 7">7</span><span class="t">Keys, fobs or codes for shared areas</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 8">8</span><span class="t">Other memberships that go with the home</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 9">9</span><span class="t">Problems in the shared areas</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 10">10</span><span class="t">Whether the state's coastal zone law applies to the home or shared buildings</span></label></li><li><label><input type="checkbox"><span class="no" aria-label="Question 11">11</span><span class="t">A transfer fee</span></label></li><li class="sd-note">The addendum also asks the dues, what period they cover, and how to reach the association.</li></ul></div><p class="sd-src">Our short wording of the state form, updated June 2025. <a href="https://llr.sc.gov/re/recpdf/Property-Condition-Disclosure-Statement-06.2025.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Download the form</a> for the full wording of each question.</p></div><nav class="sd-idx" aria-label="Parts of the form"><p>Parts of the form</p><ol><li><a href="#part-i"><span>I</span> Water and sewer</a></li><li><a href="#part-ii"><span>II</span> Roof and structure</a></li><li><a href="#part-iii"><span>III</span> Plumbing, electrical, heating and cooling</a></li><li><a href="#part-iv"><span>IV</span> Termites and pests</a></li><li><a href="#part-v"><span>V</span> Rules, permits, title and water</a></li><li><a href="#part-vi"><span>VI</span> Lead, mold and other hazards</a></li><li><a href="#part-vii"><span>VII</span> Leases and vacation rentals</a></li><li><a href="#part-viii"><span>VIII</span> Utility charges</a></li><li><a href="#part-ix"><span>IX</span> Homeowners association (HOA)</a></li><li><a href="#part-addendum"><span>+</span> The HOA addendum</a></li></ol></nav></div><script>function sdPrint(){document.body.classList.add('sd-printing');window.print();setTimeout(function(){document.body.classList.remove('sd-printing')},500)}</script><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our <a href="/hoa/documents/" style="color:var(--navy);text-decoration:underline">HOA documents page</a> lists the association papers a buyer asks for. If you are selling without an agent, our <a href="/sell/fsbo/" style="color:var(--navy);text-decoration:underline">for-sale-by-owner page</a> covers the rest of that sale.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do you have to disclose a problem you already fixed?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, for the roof, the structure and flood damage. The form asks you to describe roof leaks and repairs, and structural repairs, made while you owned the home, with dates. It also asks for flood claims, and for flood repairs you paid for without a claim.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Leases and vacation rentals</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Leases and vacation rentals in place at closing go on the form. Under the state's Vacation Rental Act, the seller lists every future rental period in writing before the contract. The buyer takes the home subject to rentals under that act that begin within 90 days after the deed is recorded.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">That act does not cover a condo rented through a hotel-style front desk. The closing attorney can say which rules apply to yours. Our pages on <a href="/sell/sell-my-condo/" style="color:var(--navy);text-decoration:underline">selling a condo</a> and <a href="/sell/rental-property/" style="color:var(--navy);text-decoration:underline">selling a rental</a> cover the bookings.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Want your answers read before a buyer sees them?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the form once it is filled in. An agent reads it and marks any Yes that still needs an explanation or a report.</p><a class="btn btn-brass" href="/contact/">Send us your form to read</a></div></div></section><section style="background:var(--ivory)" id="flooding"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Flooding">Do you have to disclose flooding when you sell a house in South Carolina?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. Every seller answers the form's flood questions, wherever the home is. Nearly 1 in 4 of the flood insurance claims FEMA has paid in Horry County were on buildings rated outside the high-risk flood zone.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Question 20 asks whether the house flooded while you owned it. Questions 22 to 28 ask about erosion, flood zones and flood risk, and whether the home has flood insurance now.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">They also ask about flood claims, flood repairs without a claim, federal flood aid and charges for beach renourishment, which is sand added back to the beach. Five of these questions, 20 and 25 to 28, ask only about the years you owned the home.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">The storms your answers can cover</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We checked the last recorded sale of every home in Horry County. More than 1 in 3 (37 percent) last sold before Hurricane Florence in September 2018. About 3 in 10 (29 percent) last sold before Hurricane Matthew in October 2016.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If you have owned your home since before those storms, the form's questions about "your ownership" cover them. FEMA paid more than 1,000 flood claims in the county for Matthew and nearly 900 for Florence.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Your home's flood claim record</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="https://agents.floodsmart.gov/flood-maps-and-data/faqs-about-nfip-data" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FEMA gives the owner</a> the flood insurance claims and payments on the home, including those from before you owned it. A buyer cannot get them. To ask for yours:</p><ul class="sd-plain" aria-label="How to ask FEMA for your home's flood claim record"><li><b>Where to send it</b>In writing to FEMA's records office, or online at <a href="https://www.dhs.gov/foia" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">dhs.gov/foia</a>. Mark it "Privacy Act Request".</li><li><b>What to put in it</b>Your full name, current address, date and place of birth and country of citizenship, and the home's address.</li><li><b>How to sign it</b>Before a notary, or with a statement that it is true under penalty of perjury, as the <a href="https://www.ecfr.gov/current/title-6/chapter-I/part-5/subpart-B/section-5.21" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">federal rule</a> allows.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Question 25 asks only about claims while you owned the home. Question 23 asks about any flood risk you know of, and the form says you must disclose what you know when you fill it in. A South Carolina attorney can say whether an older claim belongs in your answer to question 23.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">The CLUE report</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The insurance industry's claims report on a home is called a CLUE report. Only the owner, an insurer or a lender can order it. It covers recent years of roof, wind and water claims.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You order it from LexisNexis Risk Solutions, online, by phone or by mail. Our page on <a href="/buyers/undisclosed-flooding/" style="color:var(--navy);text-decoration:underline">undisclosed flooding</a> shows what a buyer can find out about a home's flood past. Flood insurance costs are on our <a href="/buyers/coastal-insurance/" style="color:var(--navy);text-decoration:underline">coastal insurance page</a>.</p></div></section><section style="background:var(--ivory-2)" id="beachfront"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Beachfront homes">What extra disclosure does a beachfront home need?</h2><div class="sd-side"><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The state draws a beachfront setback line a set distance inland from the top of the main sand dune. A home on a lot that reaches past that line, toward the ocean, needs a second statement in the sale contract.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-n/sell-seller-disclosure/oceanfront-condos-north-of-myrtle-beach-1200w.webp" srcset="/images/2026-11-n/sell-seller-disclosure/oceanfront-condos-north-of-myrtle-beach-600w.webp 600w, /images/2026-11-n/sell-seller-disclosure/oceanfront-condos-north-of-myrtle-beach-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="675" alt="A long oceanfront condo building and part of a taller tower at the back of a wide beach with umbrellas, a grassy dune and a tidal creek to the left, a golf course behind, seen from over the ocean" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="USGS photo, 2011. License: Public domain" title="License: Public domain">USGS photo, 2011</a></span></div><figcaption>Oceanfront condo buildings north of Myrtle Beach in 2011. Most of the homes we counted on lots past the setback line are condo units like these.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="https://www.scstatehouse.gov/code/statmast.php?title=48&amp;chapter=39" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">State law</a> says the contract must state that the property is or may be affected by the state's beach lines. Leaving the statement out does not make the contract invalid.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We checked every home parcel in Horry County against the state's setback line map. About 10,700 homes are on lots that reach past that line. Nearly 9 in 10 are condo units, and about 500 are houses.</p></div><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="Homes on lots that reach past the beach setback line, by beach"><span class="cap" aria-hidden="true">Homes on lots that reach past the beach setback line, by beach</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Beach</span><span role="columnheader">homes</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">North Myrtle Beach</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">4,181</span></span></div><div role="row"><span role="rowheader"><span class="n">Myrtle Beach</span></span><span role="cell"><span class="b" style="--f:0.706" aria-hidden="true"></span><span class="v">2,952</span></span></div><div role="row"><span role="rowheader"><span class="n">Arcadian Shores</span></span><span role="cell"><span class="b" style="--f:0.422" aria-hidden="true"></span><span class="v">1,766</span></span></div><div role="row"><span role="rowheader"><span class="n">Garden City</span></span><span role="cell"><span class="b" style="--f:0.327" aria-hidden="true"></span><span class="v">1,368</span></span></div><div role="row"><span role="rowheader"><span class="n">Surfside</span></span><span role="cell"><span class="b" style="--f:0.085" aria-hidden="true"></span><span class="v">356</span></span></div><div role="row"><span role="rowheader"><span class="n">Briarcliffe Acres</span></span><span role="cell"><span class="b" style="--f:0.028" aria-hidden="true"></span><span class="v">117</span></span></div></div></div><figcaption>Each condo unit counts once, so one oceanfront building counts many times.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A survey settles where the line falls on a given lot.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Selling an oceanfront condo or house?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us the address. We raise the beachfront statement with the closing attorney at the start, so it is in the contract when you sign.</p><a class="btn btn-brass" href="/contact/">Ask us about an oceanfront sale</a></div></div></section><section style="background:var(--ivory)" id="lead"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Lead paint">Do you need a lead paint disclosure in South Carolina?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, for most homes built before 1978. <a href="https://www.epa.gov/lead/real-estate-disclosures-about-potential-lead-hazards" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Federal law</a> adds four steps to the sale:</p><ul class="sd-plain" aria-label="The federal lead rule for a home built before 1978"><li><b>The pamphlet</b>Give the buyer the federal lead pamphlet.</li><li><b>What you know</b>Say what you know about lead paint in the home, and hand over any lead reports.</li><li><b>The warning</b>The contract must include a lead warning statement.</li><li><b>The test period</b>The buyer gets 10 days to test for lead, unless you both agree in writing to a different period or the buyer waives it.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Keep the signed form for three years. Four cases are not covered. One is a unit with no bedroom, such as a studio, where no child under six lives.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Another is housing for older people or people with disabilities where no child under six lives. The other two are a home a certified inspector found free of lead paint, and a foreclosure sale.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About 1 in 6 homes in Horry County (16 percent) was built before 1980. The share changes a lot by town: about 1 in 3 in Conway and Surfside Beach, and about 1 percent in Carolina Forest.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="Share of homes built before 1980, by town"><span class="cap" aria-hidden="true">Share of homes built before 1980, by town</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Town</span><span role="columnheader">built before 1980</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Surfside Beach</span></span><span role="cell"><span class="b" style="--f:0.885" aria-hidden="true"></span><span class="v">35%</span></span></div><div role="row"><span role="rowheader"><span class="n">Conway</span></span><span role="cell"><span class="b" style="--f:0.807" aria-hidden="true"></span><span class="v">32%</span></span></div><div role="row"><span role="rowheader"><span class="n">Myrtle Beach</span></span><span role="cell"><span class="b" style="--f:0.695" aria-hidden="true"></span><span class="v">28%</span></span></div><div role="row"><span role="rowheader"><span class="n">North Myrtle Beach</span></span><span role="cell"><span class="b" style="--f:0.483" aria-hidden="true"></span><span class="v">19%</span></span></div><div role="row"><span role="rowheader"><span class="n">Socastee</span></span><span role="cell"><span class="b" style="--f:0.345" aria-hidden="true"></span><span class="v">14%</span></span></div><div role="row"><span role="rowheader"><span class="n">Garden City</span></span><span role="cell"><span class="b" style="--f:0.275" aria-hidden="true"></span><span class="v">11%</span></span></div><div role="row"><span role="rowheader"><span class="n">Red Hill</span></span><span role="cell"><span class="b" style="--f:0.245" aria-hidden="true"></span><span class="v">10%</span></span></div><div role="row"><span role="rowheader"><span class="n">Murrells Inlet</span></span><span role="cell"><span class="b" style="--f:0.198" aria-hidden="true"></span><span class="v">8%</span></span></div><div role="row"><span role="rowheader"><span class="n">Little River</span></span><span role="cell"><span class="b" style="--f:0.16" aria-hidden="true"></span><span class="v">6%</span></span></div><div role="row"><span role="rowheader"><span class="n">Carolina Forest</span></span><span role="cell"><span class="b" style="--f:0.028" aria-hidden="true"></span><span class="v">1%</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Horry County</span></span><span role="cell"><span class="b" style="--f:0.4" aria-hidden="true"></span><span class="v">16%</span></span></div></div></div><figcaption>Census estimates for 2020 to 2024, for homes of every kind, lived in or not. Towns with fewer than 4,000 homes are left off, because the estimates for them are rough. Garden City and Murrells Inlet reach into Georgetown County.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Census counts homes by decade, so the chart shows homes built before 1980. The share built before 1978 is a little lower.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Selling a house built in the 1970s or before?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the address. We confirm the year built in the county's records and add the lead form and pamphlet to your papers before you list.</p><a class="btn btn-brass" href="/contact/">Have us check the year built</a></div></div></section><section style="background:var(--ivory-2)" id="not-required"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What you do not have to say">What do you not have to disclose in South Carolina?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="https://www.scstatehouse.gov/code/statmast.php?title=27&amp;chapter=50" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">South Carolina law</a> names three things a seller does not have to disclose:</p><ul class="sd-plain" aria-label="What a South Carolina seller does not have to disclose"><li><b>A death in the home</b>That someone died in the home, or how they died.</li><li><b>An illness</b>That someone who lived there had a disease that medical evidence shows is highly unlikely to spread through living in the home.</li><li><b>The sex offender registry</b>Public information from the state's sex offender registry.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If a buyer asks you directly about any of them, you may not lie.</p></div></section><section style="background:var(--ivory)" id="left-out"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="If something is left out">What happens if a seller does not disclose something?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A seller who knowingly leaves a problem off the form, or answers falsely, can owe the buyer their actual losses and court costs. A court may add the winner's attorney fees.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Under the disclosure law, the buyer keeps every other legal right. Many claims in South Carolina must be filed within three years (<a href="https://www.scstatehouse.gov/code/statmast.php?title=15&amp;chapter=3" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 15-3-530</a>). When the clock starts depends on the claim; an attorney can say which applies.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Your agent cannot hide what they know</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The form says a real estate agent must disclose material adverse facts they know of about the home, whatever the owner answers. A <a href="https://www.scstatehouse.gov/code/statmast.php?title=40&amp;chapter=57" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">material adverse fact</a> is a problem that significantly lowers the home's value or soundness, or is a significant health risk to the people who live there.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A listing agent must tell you in writing what the law requires of you. An agent is not liable for your false answers if they did not know or have reason to suspect they were false.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The form is not a warranty, and it does not replace the buyer's inspection. The law keeps the buyer's duty to inspect, and agents have no duty to inspect.</p></div></section><section style="background:var(--ivory-2)" id="steps"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Step by step">How do you fill out a seller disclosure, step by step?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Seven steps, from the first look at the form to closing day:</p><ol class="sd-steps" aria-label="How to fill out the South Carolina seller disclosure, in order"><li><span class="n" aria-hidden="true">1</span><span class="c"><b>Check whether your sale needs it</b>Compare your sale with the 15 exempt kinds above.</span></li><li><span class="n" aria-hidden="true">2</span><span class="c"><b>Gather your records</b>The roof's year and repair bills, permits for any work, your termite contract, the HOA dues and contact, and any lease or rental booking.</span></li><li><span class="n" aria-hidden="true">3</span><span class="c"><b>Get your flood and insurance history</b>Ask FEMA for your home's flood claim record, and order its CLUE report. The <a href="#flooding" style="color:var(--navy);text-decoration:underline">flooding section</a> says how to ask for each.</span></li><li><span class="n" aria-hidden="true">4</span><span class="c"><b>Answer every question</b>Yes means you explain it or attach a report.</span></li><li><span class="n" aria-hidden="true">5</span><span class="c"><b>Built before 1978? Add the lead papers</b>The federal lead form and the pamphlet.</span></li><li><span class="n" aria-hidden="true">6</span><span class="c"><b>On the beach? Add the setback statement</b>Your agent raises it with the closing attorney before the contract.</span></li><li><span class="n" aria-hidden="true">7</span><span class="c"><b>Give it to the buyer before the contract</b>Keep a copy the buyer signed, and keep it true until closing.</span></li></ol></div></section><section style="background:var(--ivory)" id="seller-disclosure-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Seller disclosure FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is a seller disclosure required for new construction in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not for the first sale of a home no one has ever lived in. Every later sale of that home needs the form, unless it is another of the 15 exempt kinds.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can a buyer and seller agree to skip the disclosure form?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. Both must agree in writing not to complete it, and neither side has to agree.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How long is a seller's disclosure good for?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Until closing. If anything changes before then, the seller corrects the form or makes the repair.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does an investor who never lived in the house have to fill it in?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, unless the sale is one of the 15 exempt kinds. The law lists no exemption for an investor, a landlord or a company.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do you have to disclose a death in a house in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. If a buyer asks you directly, you may not lie about it.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.scstatehouse.gov/code/statmast.php?title=27&amp;chapter=50" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 27-50</a>, <a href="https://llr.sc.gov/re/recpdf/Property-Condition-Disclosure-Statement-06.2025.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC disclosure form</a>, <a href="https://www.scstatehouse.gov/code/statmast.php?title=48&amp;chapter=39" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 48-39</a>, <a href="https://www.scstatehouse.gov/code/statmast.php?title=15&amp;chapter=3" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 15-3</a>, <a href="https://www.scstatehouse.gov/code/statmast.php?title=40&amp;chapter=57" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 40-57</a>, <a href="https://www.epa.gov/lead/real-estate-disclosures-about-potential-lead-hazards" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">EPA lead rule</a>, <a href="https://agents.floodsmart.gov/flood-maps-and-data/faqs-about-nfip-data" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FEMA NFIP data FAQ</a>, <a href="https://www.fema.gov/openfema-data-page/fima-nfip-redacted-claims-v2" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">OpenFEMA claims</a>, <a href="https://www.ecfr.gov/current/title-6/chapter-I/part-5/subpart-B/section-5.21" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">6 CFR 5.21</a>, <a href="https://insurance.utah.gov/consumers/clue/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Utah CLUE</a>, <a href="https://www.tn.gov/commerce/insurance/consumer-resources/clue.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Tennessee CLUE</a>, <a href="