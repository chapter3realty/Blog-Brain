--- /dev/null
+++ b/data/2026-11-n/sell-seller-disclosure/analyze_acs.py
@@ -0,0 +1,25 @@
+#!/usr/bin/env python3
+"""Share of homes built before 1980 in Horry County and its towns (the federal lead rule covers most homes built before 1978).
+Run: python3 -I analyze_acs.py. Inputs (raw/, pulled 2026-11-08 by pull-acs.sh): Census ACS 2020-2024 5-year table B25034
+(year structure built) for every SC place and for Horry County, and ACS 2025 1-year B25034 for Horry County.
+The Census groups years by decade, so "before 1980" includes 1978 and 1979 and "before 1970" leaves out 1970 to 1977:
+the pre-1978 share lies between the two. Counts are housing units (owned, rented and vacant). Writes acs-findings.json."""
+import json, os
+HERE = os.path.dirname(os.path.abspath(__file__)); RAW = os.path.join(HERE, 'raw')
+def rows(f):
+    d = json.load(open(os.path.join(RAW, f)))['response']['data']; return [dict(zip(d[0], r)) for r in d[1:]]
+def calc(x):
+    v = lambda i: int(x['B25034_%03dE' % i]); t = v(1); p80 = sum(v(i) for i in range(7, 12)); p70 = sum(v(i) for i in range(8, 12))
+    return {'name': x['NAME'].replace(', South Carolina', ''), 'geo': x['GEO_ID'], 'units': t, 'built_before_1970': p70, 'built_before_1980': p80,
+            'built_1970s': v(7), 'built_1970s_moe': int(x['B25034_007M']), 'pct_before_1970': round(100 * p70 / t, 1), 'pct_before_1980': round(100 * p80 / t, 1)}
+# Places in Horry County (Murrells Inlet and Garden City CDPs reach into Georgetown County; Georgetown and Pawleys Island are shown for comparison)
+HORRY = ['Atlantic Beach town', 'Aynor town', 'Briarcliffe Acres town', 'Conway city', 'Loris city', 'Myrtle Beach city', 'North Myrtle Beach city',
+         'Surfside Beach town', 'Carolina Forest CDP', 'Forestbrook CDP', 'Garden City CDP', 'Little River CDP', 'Murrells Inlet CDP', 'Red Hill CDP', 'Socastee CDP']
+P = {r['NAME'].replace(', South Carolina', ''): r for r in rows('acs5-2024-B25034-sc-places.json')}
+out = {'source': 'U.S. Census Bureau, ACS 2020-2024 5-year, B25034; ACS 2025 1-year, B25034',
+       'horry_5yr': calc(rows('acs5-2024-B25034-horry.json')[0]), 'horry_1yr_2025': calc(rows('acs1-2025-B25034-horry.json')[0]),
+       'places': sorted((calc(P[n]) for n in HORRY), key=lambda r: -r['pct_before_1980']),
+       'compare': [calc(P[n]) for n in ('Georgetown city', 'Pawleys Island town')]}
+json.dump(out, open(os.path.join(HERE, 'acs-findings.json'), 'w'), indent=1)
+for k in ('horry_5yr', 'horry_1yr_2025'): print(out[k])
+for r in out['places']: print(r['name'], r['units'], r['pct_before_1970'], r['pct_before_1980'])
diff --git a/data/2026-11-n/sell-seller-disclosure/analyze_ownership.py b/data/2026-11-n/sell-seller-disclosure/analyze_ownership.py
new file mode 100644
index 00000000..93589cf9
--- /dev/null
+++ b/data/2026-11-n/sell-seller-disclosure/analyze_ownership.py
@@ -0,0 +1,54 @@
+#!/usr/bin/env python3
+"""How many Horry County homes have had the same owner since before Hurricane Matthew (2016) or Florence (2018).
+Why: the state form's flood questions 20 and 25 to 27 ask about the seller's own years of ownership, so an owner who bought
+before a storm must answer for that storm.
+Run: RAW=<dir with the sibling's big raw files> python3 -I analyze_ownership.py   (needs shapely 2)
+Inputs from RAW (made by data/2026-10-d/buyers-undisclosed-flooding/fetch_county.py, pulled 2026-11-01):
+res-parcels.json (residential parcels with a building: PIN, LandUseCode, SaleDate = last recorded sale), addresses-points.json,
+flood-sfha.json (FEMA high-risk zone, SFHA_TF = 'T').
+Kind of home by land use code, as in the sibling ledger (sell-out-of-state-buyers row 1). A parcel with no sale date is counted apart.
+Writes ownership-findings.json (counts only)."""
+import json, os, datetime, collections as C
+import numpy as np, shapely
+from shapely.geometry import Polygon
+from shapely.ops import unary_union
+HERE = os.path.dirname(os.path.abspath(__file__)); RAW = os.environ['RAW']
+L = lambda f: json.load(open(os.path.join(RAW, f)))
+def esri(feat):
+    g = None
+    for r in feat['geometry']['rings']:
+        if len(r) < 4: continue
+        p = Polygon(r).buffer(0); g = p if g is None else g.symmetric_difference(p)
+    return g
+sfha = unary_union([esri(f) for f in L('flood-sfha.json')]); shapely.prepare(sfha)
+res = {str(int(r['PIN'])): r for r in L('res-parcels.json') if r.get('PIN')}
+pt = {}
+for a in L('addresses-points.json'):
+    if a.get('x') is not None and a.get('PIN'):
+        p = str(int(a['PIN']))
+        if p in res and p not in pt: pt[p] = (a['x'], a['y'])
+ks = list(pt); x = np.array([pt[k][0] for k in ks]); y = np.array([pt[k][1] for k in ks])
+insf = dict(zip(ks, shapely.contains_xy(sfha, x, y)))
+def kind(lu):
+    lu = str(lu or '')
+    if lu in ('107', '135'): return 'condo'
+    if lu == '109': return 'townhouse'
+    if lu in ('100', '101', '102', '110', '126'): return 'house'
+    if lu in ('120', '121'): return 'manufactured'
