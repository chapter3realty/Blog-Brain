+<script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is a seller disclosure required for new construction in South Carolina?","acceptedAnswer":{"@type":"Answer","text":"Not for the first sale of a home no one has ever lived in. Every later sale of that home needs the form, unless it is another of the 15 exempt kinds."}},{"@type":"Question","name":"Can a buyer and seller agree to skip the disclosure form?","acceptedAnswer":{"@type":"Answer","text":"Yes. Both must agree in writing not to complete it, and neither side has to agree."}},{"@type":"Question","name":"How long is a seller's disclosure good for?","acceptedAnswer":{"@type":"Answer","text":"Until closing. If anything changes before then, the seller corrects the form or makes the repair."}},{"@type":"Question","name":"Does an investor who never lived in the house have to fill it in?","acceptedAnswer":{"@type":"Answer","text":"Yes, unless the sale is one of the 15 exempt kinds. The law lists no exemption for an investor, a landlord or a company."}},{"@type":"Question","name":"Do you have to disclose a death in a house in South Carolina?","acceptedAnswer":{"@type":"Answer","text":"No. If a buyer asks you directly, you may not lie about it."}}]}</script>
