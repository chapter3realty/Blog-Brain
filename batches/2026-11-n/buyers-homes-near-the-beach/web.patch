 4" stroke-opacity=".55"/><line x1="774.7" y1="157.4" x2="774.7" y2="101.4" stroke="#1c2028" stroke-width="2" stroke-dasharray="4 4" stroke-opacity=".55"/><line x1="879.1" y1="138.5" x2="879.1" y2="174.5" stroke="#1c2028" stroke-width="2"/><circle class="mk" cx="879.1" cy="118.5" r="22"/><text class="mn" x="879.1" y="126.5" text-anchor="middle">1</text><line x1="618.4" y1="72.6" x2="618.4" y2="108.6" stroke="#1c2028" stroke-width="2"/><circle class="mk" cx="618.4" cy="52.6" r="22"/><text class="mn" x="618.4" y="60.6" text-anchor="middle">2</text><line x1="403.1" y1="80.9" x2="403.1" y2="116.9" stroke="#1c2028" stroke-width="2"/><circle class="mk" cx="403.1" cy="60.9" r="22"/><text class="mn" x="403.1" y="68.9" text-anchor="middle">3</text><line x1="177.3" y1="115.2" x2="177.3" y2="151.2" stroke="#1c2028" stroke-width="2"/><circle class="mk" cx="177.3" cy="95.2" r="22"/><text class="mn" x="177.3" y="103.2" text-anchor="middle">4</text><text class="oc" x="552.6" y="176.5" text-anchor="middle">Atlantic Ocean</text><g transform="translate(60 52) rotate(-43.9)"><path d="M0 -24L9 10L0 4L-9 10Z" fill="#1c2028"/></g><text class="sm" x="34" y="38" text-anchor="middle">N</text><path d="M870.5 40h89.5" stroke="#1c2028" stroke-width="3"/><path d="M870.5 33v14M960 33v14" stroke="#1c2028" stroke-width="2"/><text class="sm" x="915.3" y="28" text-anchor="middle">5 miles</text></svg></div><ol class="nb-key" aria-label="The four stretches on the map"><li><span class="n" aria-hidden="true">1</span><a href="#north-myrtle-beach">North Myrtle Beach and Cherry Grove</a></li><li><span class="n" aria-hidden="true">2</span><a href="#myrtle-beach">Myrtle Beach, east of Kings Highway</a></li><li><span class="n" aria-hidden="true">3</span><a href="#surfside-to-murrells-inlet">Surfside Beach, Garden City and Murrells Inlet</a></li><li><span class="n" aria-hidden="true">4</span><a href="#litchfield-and-pawleys-island">Litchfield and Pawleys Island</a></li></ol><figcaption>The tan strip is the land within half a mile of the ocean. Each dot is a public beach access on the state's map. Shoreline: U.S. Census Bureau TIGER/Line, public domain. Accesses: SC Department of Environmental Services. Map: Chapter3 Realty.</figcaption></figure><h3 id="north-myrtle-beach" class="nb-place"><span class="nb-n" aria-hidden="true">1</span>North Myrtle Beach and Cherry Grove<span class="nb-line">The most public paths to the sand, and most of the houses under $400,000</span></h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">North Myrtle Beach has more public paths to the sand per mile than any other beach town here. The city manages over 240 beach accesses, about one every 250 feet on the state's map.</p><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);letter-spacing:.01em;color:#fff;text-align:right;background:radial-gradient(farthest-side at 100% 100%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.c3ph-cr a{color:#fff;text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);text-underline-offset:2px;pointer-events:auto;padding:10px 0 6px}.c3ph-hero{margin:1.6rem 0 2rem}.c3ph-hero .c3ph-f{border-radius:8px}.c3ph-hero img{aspect-ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}</style><figure class="c3ph-hero nb-side-ph" style="max-width:720px;"><div class="c3ph-f"><img src="/images/2026-11-a/submarkets-north-myrtle-beach/cherry-grove-from-above-2012-1200w.webp" srcset="/images/2026-11-a/submarkets-north-myrtle-beach/cherry-grove-from-above-2012-600w.webp 600w, /images/2026-11-a/submarkets-north-myrtle-beach/cherry-grove-from-above-2012-1200w.webp 1200w" sizes="(max-width: 700px) 100vw, (max-width: 1099px) 720px, 380px" width="1200" height="900" alt="Looking up the beach in Cherry Grove from a height: low beach houses and mid-rise condo buildings along the road, the marsh behind them, and a long fishing pier reaching into the ocean" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: Melikamp. License: CC BY-SA 3.0" title="License: CC BY-SA 3.0">Photo: Melikamp</a></span></div><figcaption>Cherry Grove from a height: the beach and the pier on the right, and streets of beach houses behind Ocean Boulevard on the left.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Cherry Grove, at the north end, is the quieter beach. It has the Heritage Shores nature preserve trails and the walk out to the point.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Houses within half a mile of the ocean here sold for about $625,000 at the middle in the last year, against about $350,000 two to 5 miles inland. About 143 are for sale within half a mile today. Our <a href="/submarkets/north-myrtle-beach/" style="color:var(--navy);text-decoration:underline">North Myrtle Beach page</a> covers each part of the city, and our map shows <a href="/homes/map/?type=house&amp;has=walk_to_beach&amp;city=North%20Myrtle%20Beach" style="color:var(--navy);text-decoration:underline">the houses marked walk to the beach there</a>.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=North%20Myrtle%20Beach">Have us find a house in North Myrtle Beach<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p><h3 id="myrtle-beach" class="nb-place"><span class="nb-n" aria-hidden="true">2</span>Myrtle Beach, east of Kings Highway<span class="nb-line">The busy beach, and the fewest houses in the flood zone</span></h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In Myrtle Beach, Kings Highway is the road to know. It is US 17 Business, and it is about half a mile from the ocean at the middle. East of Kings Highway means the streets between it and the sand.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Kings Highway is about 0.2 mile from the ocean at its closest. At the north end of the city, near Briarcliffe Acres, it is about 1.3 miles inland.</p><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);letter-spacing:.01em;color:#fff;text-align:right;background:radial-gradient(farthest-side at 100% 100%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.c3ph-cr a{color:#fff;text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);text-underline-offset:2px;pointer-events:auto;padding:10px 0 6px}.c3ph-hero{margin:1.6rem 0 2rem}.c3ph-hero .c3ph-f{border-radius:8px}.c3ph-hero img{aspect-ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}</style><figure class="c3ph-hero nb-side-ph" style="max-width:720px;"><div class="c3ph-f"><img src="/images/2026-11-a/submarkets-myrtle-beach/oceanfront-houses-from-the-ocean-1200w.webp" srcset="/images/2026-11-a/submarkets-myrtle-beach/oceanfront-houses-from-the-ocean-600w.webp 600w, /images/2026-11-a/submarkets-myrtle-beach/oceanfront-houses-from-the-ocean-1200w.webp 1200w" sizes="(max-width: 700px) 100vw, (max-width: 1099px) 720px, 380px" width="1200" height="782" alt="Two-story houses on wide green lawns behind the dunes, with wooden walkways to the beach and oak trees behind, seen from a plane over the ocean in Myrtle Beach" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: U.S. Geological Survey. License: Public domain" title="License: Public domain">Photo: U.S. Geological Survey</a></span></div><figcaption>Houses on wide lawns facing the beach north of downtown Myrtle Beach, with Ocean Boulevard and streets of houses under oaks behind them.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The city counts 143 public beach access points: street ends, parks and others. Downtown is the busy beach, with the boardwalk and volleyball.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">This stretch is the coast from Briarcliffe Acres south to Surfside Beach. It includes Arcadian Shores and Myrtle Beach State Park. Houses within half a mile of the ocean on it sold for about $670,000 at the middle, against about $405,000 two to 5 miles inland. About 101 are for sale within half a mile today.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our <a href="/submarkets/myrtle-beach/" style="color:var(--navy);text-decoration:underline">Myrtle Beach page</a> covers the city's neighborhoods and its rental rules.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Myrtle%20Beach">Get the houses near the beach in Myrtle Beach<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p><h3 id="surfside-to-murrells-inlet" class="nb-place"><span class="nb-n" aria-hidden="true">3</span>Surfside Beach, Garden City and Murrells Inlet<span class="nb-line">The shortest drive to the sand, and free parking at the county's Garden City accesses</span></h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">From the middle house in Surfside Beach, the beach is about a 3-minute drive with no traffic. That is the shortest of the towns we measured. Surfside Beach has 36 public beach accesses, about one every 350 feet on the state's map.</p><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);letter-spacing:.01em;color:#fff;text-align:right;background:radial-gradient(farthest-side at 100% 100%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.c3ph-cr a{color:#fff;text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);text-underline-offset:2px;pointer-events:auto;padding:10px 0 6px}.c3ph-hero{margin:1.6rem 0 2rem}.c3ph-hero .c3ph-f{border-radius:8px}.c3ph-hero img{aspect-ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}</style><figure class="c3ph-hero nb-side-ph" style="max-width:720px;"><div class="c3ph-f"><img src="/images/buyers/no-hoa/surfside-beach-houses-from-the-sand-1200w.webp" srcset="/images/buyers/no-hoa/surfside-beach-houses-from-the-sand-600w.webp 600w, /images/buyers/no-hoa/surfside-beach-houses-from-the-sand-1200w.webp 1200w" sizes="(max-width: 700px) 100vw, (max-width: 1099px) 720px, 380px" width="1200" height="900" alt="A row of two- and three-story beach houses in blue, yellow and gray behind low dunes, seen across a wide sand beach under a blue sky at Surfside Beach" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: BullDawg2021. License: CC BY-SA 4.0" title="License: CC BY-SA 4.0">Photo: BullDawg2021</a></span></div><figcaption>The oceanfront row of beach houses at Surfside Beach, seen from the sand.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Horry County's oceanfront beach accesses in Garden City have free parking all year. On the state's map, Garden City Beach has about 13 public accesses a mile, counting both counties. From the middle house, the beach is about a 5-minute drive in Garden City and about 10 in Murrells Inlet.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On this stretch, houses within half a mile of the ocean sold for about $775,000 at the middle. Houses half a mile to 2 miles back sold for about $395,000, a little less than houses 2 to 5 miles inland, at about $420,000.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About 71 houses are for sale within half a mile of the ocean here, asking about $990,000 at the middle. That is the highest of the three Horry County stretches. Our pages on <a href="/submarkets/surfside-beach/" style="color:var(--navy);text-decoration:underline">Surfside Beach</a>, <a href="/submarkets/garden-city/" style="color:var(--navy);text-decoration:underline">Garden City</a> and <a href="/submarkets/murrells-inlet/" style="color:var(--navy);text-decoration:underline">Murrells Inlet</a> cover each town.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Surfside%20Beach">Ask about houses in Surfside Beach and Garden City<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p><h3 id="litchfield-and-pawleys-island" class="nb-place"><span class="nb-n" aria-hidden="true">4</span>Litchfield and Pawleys Island<span class="nb-line">The highest prices on the coast, and fewer public paths</span></h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Houses for sale within half a mile of the ocean here ask about $2.1 million at the middle, the highest on the coast. Two to 5 miles inland, they ask about $900,000.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Pawleys Island has the largest free public beach access lot in Georgetown County, at the south end of the island, and 8 other public accesses. On the state's map, that is about one every 2,400 feet.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A house near the ocean here can still be a long walk from a public path. Of the 27 houses for sale within half a mile of the ocean that are over a mile on foot from a public access, 18 are on this coast.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our <a href="/submarkets/pawleys-island/" style="color:var(--navy);text-decoration:underline">Pawleys Island page</a> has the island's own sales and flood zones.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Pawleys%20Island">Ask about houses on Pawleys Island<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></section><section style="background:var(--ivory)" id="pros-cons"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Pros and cons">What are the pros and cons of living near the beach?</h2><div class="nb-pc"><div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">The good</h3><ul class="nb-plain" aria-label="The good"><li><b>You walk to the beach</b>From the middle house in Carolina Forest, the beach is about a 20-minute drive with no traffic, and about 30 minutes from Conway.</li><li><b>About 3 in 4 have no HOA fee</b>About 3 in 4 houses for sale within a quarter mile of the ocean report no homeowners association (HOA) fee, against about 1 in 10 two to 5 miles inland. Our <a href="/buyers/no-hoa-homes/" style="color:var(--navy);text-decoration:underline">homes with no HOA page</a> covers what that allows.</li><li><b>A few streets back costs much less</b>Past the first quarter mile, houses sold for about a third less at the middle. Half a mile from the ocean is still about a 10-minute walk.</li></ul></div><div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">The hard</h3><ul class="nb-plain" aria-label="The hard"><li><b>It costs more</b>A house within half a mile of the ocean sold for about 1.7 times as much as one 2 to 5 miles inland.</li><li><b>Flood insurance is more likely</b>About half the houses within a quarter mile of the ocean are in the high-risk flood zone. We look up the zone and the policy cost before you make an offer.</li><li><b>Fewer houses to choose from</b>Only about 1 in 16 house sales in Horry County was within half a mile of the ocean.</li></ul></div></div></div></section><section style="background:var(--ivory-2)" id="houses-near-the-beach-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Houses near the beach FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How much is a house near the beach in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the last year, a Horry County house within half a mile of the ocean sold for about $675,000 at the middle. Two to 5 miles inland, the middle sale was about $390,000.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is Myrtle Beach in a flood zone?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Parts of it. Within half a mile of the ocean, about 1 in 11 houses on the Myrtle Beach stretch is in FEMA's high-risk flood zone. In North Myrtle Beach and Cherry Grove it is about 4 in 10, and from Surfside Beach to Murrells Inlet about half.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What does east of 17 mean in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">It means the streets between the highway and the ocean. In Myrtle Beach, Kings Highway, which is US 17 Business, is about half a mile from the ocean at the middle. Houses marked East of 17 in our home search are about 0.45 mile from the ocean at the middle.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What is a second-row house at the beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A house in the row just behind the oceanfront row.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How far is the beach from Carolina Forest or Conway?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">From the middle house, about 20 minutes by car from Carolina Forest and about 30 from Conway, with no traffic. Summer traffic adds time.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is there free parking at the beach in Garden City?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. Horry County's oceanfront beach accesses in Garden City have free parking all year.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeDocType" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County deeds</a>, <a href="https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County GIS</a>, <a href="https://www.census.gov/geographies/mapping-files/time-series/geo/tiger-line-file.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Census TIGER/Line</a>, <a href="https://gis.des.sc.gov/beachaccess/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SCDES beach access map</a>, <a href="https://www.cityofmyrtlebeach.com/services/accessibility_information/index.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Myrtle Beach</a>, <a href="https://parks.nmb.us/339/Beach-Accesses-Amenities" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">North Myrtle Beach</a>, <a href="https://www.surfsidebeach.org/200/Beaches" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Surfside Beach</a>, <a href="https://www.townofpawleysisland.com/beach-access-parking/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Pawleys Island</a>, <a href="https://horrycountysc.gov/departments/parksandrecreation/beach-accesses/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County beach accesses</a>, <a href="https://projectportal.scdot.org/US17Bus-RSA" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SCDOT</a>, <a href="https://routing.openstreetmap.de/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">OpenStreetMap foot router</a>, <a href="https://www.fema.gov/openfema-data-page/nfip-redacted-policies-v3" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">OpenFEMA policies</a>, <a href="https://www.law.cornell.edu/uscode/text/42/4012a" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">42 U.S.C. 4012a</a>. Houses for sale: our count of the listings on our site, November 8, 2026, asking prices, in aggregate, from CCMLS. Distances: straight line to the ocean, except the walk.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1rem"><strong style="color:var(--navy)">Legal notice.</strong> Chapter3 Realty Corp is a licensed South Carolina real estate brokerage. We are not insurers or attorneys, and nothing on this page is insurance or legal advice. The flood zone and the cost of a policy depend on the one house; an insurance agent quotes the policy.</p><style>.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Garden City Beach from over the ocean. Photo: U.S. Geological Survey, <a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://doi.org/10.5066/F7N877XX" target="_blank" rel="noopener noreferrer">U.S. Geological Survey</a>.</div><div role="listitem">Cherry Grove from a height. Photo: Melikamp, <a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 3.0</a>, via <a href="https://commons.wikimedia.org/wiki/File:Cherry_Grove_Pier.jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>. Chapter3 Realty resized the photo and cut square, 4:3 and 16:9 crops from its center.</div><div role="listitem">Oceanfront houses in Myrtle Beach. Photo: U.S. Geological Survey, <a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://doi.org/10.5066/F7N877XX" target="_blank" rel="noopener noreferrer">U.S. Geological Survey</a>. Chapter3 Realty resized the photo.</div><div role="listitem">Beach houses at Surfside Beach. Photo: BullDawg2021, <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a>, via <a href="https://commons.wikimedia.org/wiki/File:Surfside_Beach_Shoreline.jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>.</div><div role="listitem">Chapter3 Realty resized these photos and cropped some of them. Each photo keeps the license listed with it.</div></div></div><script 