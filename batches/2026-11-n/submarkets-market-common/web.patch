@@ -0,0 +1,22 @@
+"""Export USDA NAIP 2023 aerial frames (public domain) from the USGS National Map image service
+for /submarkets/myrtle-beach/market-common/. Same request as data/2026-11-a/submarkets-pawleys-island/images/naip.py.
+Usage: python3 -I naip.py <out dir> <frame> ...   (frames: area, noise)"""
+import math, json, sys, os, urllib.parse, subprocess
+R=6378137
+mx=lambda lo: R*math.radians(lo)
+my=lambda la: R*math.log(math.tan(math.pi/4+math.radians(la)/2))
+FRAMES={
+ # name: (west, south, east, north, width px)
+ 'area':(-78.981,33.6505,-78.907,33.6905,2000),
+ 'noise':(-78.950,33.6475,-78.912,33.6795,1600),
+}
+out_dir=sys.argv[1]; here=os.path.dirname(os.path.abspath(__file__))
+rec_f=os.path.join(here,'naip-frames.json'); rec=json.load(open(rec_f)) if os.path.exists(rec_f) else {}
+for k in sys.argv[2:]:
+  w,s,e,n,W=FRAMES[k]; bb=[mx(w),my(s),mx(e),my(n)]; H=round(W*(bb[3]-bb[1])/(bb[2]-bb[0]))
+  mr=json.dumps({"mosaicMethod":"esriMosaicAttribute","sortField":"Year","sortValue":"2050","ascending":True,"where":"Year=2023"})
+  q={'bbox':','.join(str(v) for v in bb),'bboxSR':3857,'imageSR':3857,'size':f'{W},{H}','format':'jpg','pixelType':'U8','interpolation':'RSP_CubicConvolution','mosaicRule':mr,'f':'image','renderingRule':json.dumps({"rasterFunction":"None"}),'bandIds':'0,1,2'}
+  url='https://imagery.nationalmap.gov/arcgis/rest/services/USGSNAIPImagery/ImageServer/exportImage?'+urllib.parse.urlencode(q)
+  r=subprocess.run(['curl','-sS','-m','240','--retry','3','-o',os.path.join(out_dir,k+'-raw.jpg'),'-w','%{http_code} %{size_download}',url],capture_output=True,text=True); print(k,W,H,r.stdout,r.stderr)
+  rec[k]={'url':url,'bbox_wgs84':[w,s,e,n],'bbox3857':bb,'size':[W,H]}
+json.dump(rec,open(rec_f,'w'),indent=1)
diff --git a/data/2026-11-n/submarkets-market-common/images/prep.py b/data/2026-11-n/submarkets-market-common/images/prep.py
new file mode 100644
index 00000000..59cb694a
--- /dev/null
+++ b/data/2026-11-n/submarkets-market-common/images/prep.py
@@ -0,0 +1,33 @@
+"""Make the two aerial map backgrounds for /submarkets/myrtle-beach/market-common/ from the NAIP exports
+(naip.py), and a check image of every layer drawn on each, for the writer to look at full size.
+Usage: python3 -I prep.py <dir with area-raw.jpg, noise-raw.jpg> <website chapter3realty dir> <check dir>"""
+import json, math, os, sys
+from PIL import Image, ImageDraw
+src, site, chk = sys.argv[1:4]
+here = os.path.dirname(os.path.abspath(__file__)); data = os.path.dirname(here)
+B = 'images/2026-11-n/submarkets-market-common/'
+FR = json.load(open(os.path.join(here, 'naip-frames.json')))
+LAY = json.load(open(os.path.join(data, 'map-layers.geojson')))['features']
+NOI = json.load(open(os.path.join(data, 'map-noise.geojson')))['features']
+R = 6378137; mx = lambda lo: R*math.radians(lo); my = lambda la: R*math.log(math.tan(math.pi/4+math.radians(la)/2))
+def rings(g):
+    if g['type'] == 'Polygon': return [g['coordinates'][0]]
+    return [p[0] for p in g['coordinates']]
+out = {}
+for k, width in (('area', 1600), ('noise', 1200)):
+    w, s, e, n = FR[k]['bbox_wgs84']; W, H = FR[k]['size']
+    P = lambda lo, la: ((mx(lo)-mx(w))/(mx(e)-mx(w))*W, (my(n)-my(la))/(my(n)-my(s))*H)
+    im = Image.open(os.path.join(src, f'{k}-raw.jpg')).convert('RGB')
+    h = round(width*H/W)
+    im.resize((width, h), Image.LANCZOS).save(os.path.join(site, B, f'market-common-{k}-aerial.webp'), quality=78, method=6)
+    out[k] = {'file': f'market-common-{k}-aerial.webp', 'frame_px': [W, H], 'bbox_wgs84': [w, s, e, n], 'file_px': [width, h]}
+    c = im.copy(); d = ImageDraw.Draw(c)
+    for f in LAY:
+        col = {'district': (255, 255, 0), 'hood': (255, 255, 255)}[f['properties']['layer']]
+        for r in rings(f['geometry']): d.line([P(*p) for p in r], fill=col, width=3)
+    for f in NOI:
+        for r in rings(f['geometry']): d.line([P(*p) for p in r], fill=(255, 80, 0), width=4)
+    for lo, la in ((-78.931514, 33.692522), (-78.925131, 33.666958)): x, y = P(lo, la); d.ellipse([x-8, y-8, x+8, y+8], outline=(255, 0, 255), width=4)
+    c.save(os.path.join(chk, f'check-{k}.jpg'), quality=85)
+json.dump(out, open(os.path.join(here, 'images.json'), 'w'), indent=1)
+print(json.dumps(out))
