+must(SB[TCS].homes === 502 && SB[TCS].by_kind.townhouse === 237 && SB["Emmens Preserve"].homes === 732 && SB["Belle Harbor"].homes === 483 && SB["Cresswind"].homes === 400, "row 8 changed");
