+/* ---------------------------------------------------------------------------- */
+/* Web Mercator placement, shared by the two maps.                                */
+
+const RM = 6378137, mx = (lo) => RM * lo * Math.PI / 180, my = (la) => RM * Math.log(Math.tan(Math.PI / 4 + la * Math.PI / 360));
+const f1 = (v) => Math.round(v * 10) / 10;
