+const rings = (g) => g.type === "Polygon" ? [g.coordinates[0]] : g.type === "MultiPolygon" ? g.coordinates.map((p) => p[0]) : [];
+const feat = (layer, name) => LAYERS.features.filter((f) => f.properties.layer === layer && (!name || f.properties.name === name));
