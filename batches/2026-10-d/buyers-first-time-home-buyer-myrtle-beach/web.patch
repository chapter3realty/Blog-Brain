5,255,.8),rgba(255,255,255,.56));border:1px solid rgba(255,255,255,.92);box-shadow:inset 0 1px 0 rgba(255,255,255,.85),0 18px 40px -28px rgba(28,32,40,.45);border-radius:20px;counter-increment:s;margin:0;padding:.95rem 1.1rem .95rem 4rem;position:relative;color:var(--muted);font-size:var(--read,1.0625rem);line-height:1.55}.c3-ft-steps>li::before{content:counter(s);position:absolute;left:1rem;top:.9rem;width:2.1rem;height:2.1rem;border-radius:50%;background:var(--navy);color:#f4efe8;font-family:var(--sans);font-weight:700;display:flex;align-items:center;justify-content:center}.c3-ft-steps strong{display:block;color:var(--navy);font-family:var(--sans);font-size:1.05rem;margin-bottom:.1rem}.c3-ft-note{color:var(--muted);font-size:.95rem;line-height:1.55;margin:-.6rem 0 1.4rem;max-width:760px}main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2)>.wrap{background:linear-gradient(160deg,rgba(42,48,64,.95),rgba(28,32,40,.97));border:1px solid rgba(255,255,255,.14);box-shadow:inset 0 1px 0 rgba(255,255,255,.14),0 26px 60px -30px rgba(28,32,40,.6);display:block;text-align:center!important;border-radius:28px;padding:2.2rem 1.6rem;margin-left:auto!important;margin-right:auto!important;max-width:720px}@media (max-width:699px){main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2)>.wrap{padding:1.6rem 1.2rem 1.7rem;border-radius:24px}}@supports not ((-webkit-backdrop-filter:blur(1px)) or (backdrop-filter:blur(1px))){main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2)>.wrap{background:#2a3040!important}}@media (prefers-reduced-transparency:reduce){main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2)>.wrap{background:#2a3040!important}}main#main>section[style^="background:var(--navy)"]:not(:has(>.wrap>h2))>.wrap{margin-left:max(2rem,calc((100% - 1200px) / 2 + 2rem))!important;width:calc(100% - 4rem)}@media (max-width:768px){main#main>section[style^="background:var(--navy)"]:not(:has(>.wrap>h2))>.wrap{margin-left:1.25rem!important;width:calc(100% - 2.5rem)}}@media (max-width:480px){main#main>section[style^="background:var(--navy)"]:not(:has(>.wrap>h2))>.wrap{margin-left:1.4rem!important;width:calc(100% - 2.8rem)}}main .hx-fb,main .hx-fb>*{min-width:0;max-width:100%}main .hx-fb-ai>.hx-fb-q{align-self:stretch;width:100%;max-width:100%;min-width:0;box-sizing:border-box}main .hx-fb-q textarea{width:0;min-width:0}@media (min-width:1000px) and (max-width:1100px){.header-ctas{gap:8px}}main#main nav[aria-label="On this page"]{max-width:760px!important}@media (min-width:700px){main#main nav[aria-label="On this page"] ul{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));column-gap:1.2rem}}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The closing costs are the fees to make the loan and close the sale. Six things can lower what you bring.</p><ul class="c3-ft-ways" role="list" aria-label="Six ways the cash to buy a first home comes down"><li><span class="c3-ft-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span class="k">No down payment on a VA loan</span><span class="d">A loan backed by the Department of Veterans Affairs (VA) often needs no down payment, as long as the price is not above the appraised value. Our <a href="/buyers/va-loans/" style="color:var(--navy);text-decoration:underline">VA loan guide</a> covers who can use one.</span></li><li><span class="c3-ft-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span><span class="k">No down payment on a USDA loan</span><span class="d">A USDA loan, backed by the U.S. Department of Agriculture, can cover the full price, with no down payment, when the home appraises at the price or more. It is for low- and moderate-income buyers in USDA's area. On our map, about 6 in 10 houses listed at or under $450,000 in Horry County are inside that area, nearly all with a Conway, Loris, Aynor or Longs address.</span></li><li><span class="c3-ft-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 9.4c-.4-1-1.5-1.8-3-1.8-1.8 0-3 1-3 2.2 0 3 6 1.6 6 4.4 0 1.3-1.3 2.2-3 2.2-1.6 0-2.7-.7-3.1-1.8M12 5.8v1.8M12 16.4v1.8"/><circle cx="12" cy="12" r="9"/></svg></span><span class="k">The seller pays your closing costs</span><span class="d">On an FHA loan, insured by the Federal Housing Administration, the seller, a builder or the agents can pay up to 6 percent of the price in all toward your closing costs. On a $270,000 house, the middle one listed now at or under $300,000, that is up to $16,200. It can cover only your actual closing costs, and the seller has to agree to it in your offer.</span></li><li><span class="c3-ft-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h8l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v4h4M9 17l6-6"/><circle cx="9.5" cy="11.5" r="1"/><circle cx="14.5" cy="16.5" r="1"/></svg></span><span class="k">$10,000 from SC Housing</span><span class="d">SC Housing, the South Carolina State Housing Finance and Development Authority, gives an eligible buyer $10,000 toward the down payment and closing costs. It comes only with SC Housing's own home loan, which can be an FHA, VA, USDA or conventional loan. It is forgiven after 15 years in the home. If you sell, refinance or move out before then, you repay all of it. Our <a href="/buyers/programs/" style="color:var(--navy);text-decoration:underline">SC down payment help guide</a> has the steps.</span></li><li><span class="c3-ft-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.5 20.5v-1a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v1M16 14.5h1a4 4 0 0 1 4 4v2"/><circle cx="8.5" cy="7" r="3.2"/><circle cx="17" cy="8.8" r="2.5"/></svg></span><span class="k">A gift toward the purchase</span><span class="d">On an FHA loan, the money can be a gift from family, an employer or labor union, a charity or a government homebuyer program. The lender needs a gift letter signed by the giver.</span></li><li><span class="c3-ft-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 5h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM3 10h18M8 3v4M16 3v4M8 14h.01M12 14h.01M16 14h.01M8 17.5h.01M12 17.5h.01"/></svg></span><span class="k">Up to $10,000 from an IRA</span><span class="d">You can take up to $10,000 out of an IRA for a first home without the 10 percent penalty. You, and your spouse if you are married, must not have owned a main home in the last two years. The money must be spent within 120 days.</span></li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our <a href="/buyers/closing-costs/" style="color:var(--navy);text-decoration:underline">closing cost calculator</a> adds up each closing cost for your price.</p></div></section><section style="background:var(--ivory)" id="what-it-buys"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What it buys">What does a first home cost in Myrtle Beach, and what do you get?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Almost half the homes sold in Horry County in the past year sold for under $300,000. Under $200,000, most were condos. From $250,000, most were houses.</p><figure class="c3-ft-chart"><span class="cap">What sold in Horry County in the past year, by price</span><div class="c3-ft-key" aria-hidden="true"><span><i style="background:#56636e"></i>Condos</span><span><i style="background:#4e6440"></i>Townhouses</span><span><i style="background:#8a5226"></i>Houses</span><span><i style="background:#d8d0c3"></i>Manufactured</span></div><div class="c3-ft-row"><span>Under $150,000</span><span class="c3-ft-stack" role="img" aria-label="Under $150,000: condos 79 percent, townhouses 2 percent, houses 13 percent"><i class="" style="width:79.4%;background:#56636e">79%</i><i class="" style="width:2.4%;background:#4e6440"></i><i class="" style="width:12.6%;background:#8a5226">13%</i><i class="lt" style="width:5.7%;background:#d8d0c3"></i></span></div><div class="c3-ft-row"><span>$150,000 to $200,000</span><span class="c3-ft-stack" role="img" aria-label="$150,000 to $200,000: condos 77 percent, townhouses 8 percent, houses 13 percent"><i class="" style="width:76.8%;background:#56636e">77%</i><i class="" style="width:8.0%;background:#4e6440"></i><i class="" style="width:12.7%;background:#8a5226">13%</i><i class="lt" style="width:2.6%;background:#d8d0c3"></i></span></div><div class="c3-ft-row"><span>$200,000 to $250,000</span><span class="c3-ft-stack" role="img" aria-label="$200,000 to $250,000: condos 47 percent, townhouses 13 percent, houses 38 percent"><i class="" style="width:47.2%;background:#56636e">47%</i><i class="" style="width:13.2%;background:#4e6440">13%</i><i class="" style="width:37.8%;background:#8a5226">38%</i><i class="lt" style="width:1.8%;background:#d8d0c3"></i></span></div><div class="c3-ft-row"><span>$250,000 to $300,000</span><span class="c3-ft-stack" role="img" aria-label="$250,000 to $300,000: condos 27 percent, townhouses 6 percent, houses 66 percent"><i class="" style="width:27.4%;background:#56636e">27%</i><i class="" style="width:5.6%;background:#4e6440"></i><i class="" style="width:66.1%;background:#8a5226">66%</i><i class="lt" style="width:0.8%;background:#d8d0c3"></i></span></div><div class="c3-ft-row"><span>$300,000 to $350,000</span><span class="c3-ft-stack" role="img" aria-label="$300,000 to $350,000: condos 18 percent, townhouses 5 percent, houses 76 percent"><i class="" style="width:18.0%;background:#56636e">18%</i><i class="" style="width:5.4%;background:#4e6440"></i><i class="" style="width:76.5%;background:#8a5226">76%</i></span></div><div class="c3-ft-row"><span>$350,000 to $400,000</span><span class="c3-ft-stack" role="img" aria-label="$350,000 to $400,000: condos 19 percent, townhouses 6 percent, houses 75 percent"><i class="" style="width:19.2%;background:#56636e">19%</i><i class="" style="width:5.6%;background:#4e6440"></i><i class="" style="width:75.2%;background:#8a5226">75%</i></span></div><figcaption style="color:var(--muted);font-size:.95rem;line-height:1.55;margin-top:.9rem">Each bar is the homes that sold in that price range. Homes over $400,000 are not shown.</figcaption></figure><div class="c3-ft-ex"><span class="cap">For sale now: the middle home in each group</span><ul class="c3-ft-tiles three" role="list"><li><span class="ic"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 21h18M5 21V9.5l5-3V21M10 21V4h9v17M13 8h3M13 12h3M13 16h3M7.5 13h.01M7.5 16.5h.01"/></svg></span>Condos, $250,000 or less</span><b>About 1,700</b><span class="d">listed. The middle one has 1 bedroom and about 740 square feet.</span></li><li><span class="ic"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span>Townhouses, $300,000 or less</span><b>About 200</b><span class="d">listed. The middle one has 3 bedrooms and about 1,430 square feet.</span></li><li><span class="ic"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span>Houses, $300,000 or less</span><b>576</b><span class="d">listed. The middle one has 3 bedrooms and about 1,470 square feet on a fifth of an acre, at $270,000.</span></li></ul></div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">New houses often cost less than resales</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the middle, a new house from a builder sold for about $350,000, against about $375,000 for a resale.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In our experience, most builders here offer incentives to buyers using FHA, VA and conventional loans. A conventional loan is one that no government agency backs. Our <a href="/buyers/new-construction/" style="color:var(--navy);text-decoration:underline">new construction guide</a> covers buying from a builder.</p></div></section><section style="background:var(--ivory-2)" id="where"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Where">Where are the starter houses around Myrtle Beach?</h2><style>main#main .hx-strip:empty{display:none}main#main .hx-strip:not(:empty)+.hx-fallback{display:none}</style><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);letter-spacing:.01em;color:#fff;text-align:right;background:radial-gradient(farthest-side at 100% 100%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.c3ph-cr a{color:#fff;text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);text-underline-offset:2px;pointer-events:auto;padding:10px 0 6px}.c3ph-hero{margin:1.6rem 0 2rem}.c3ph-hero .c3ph-f{border-radius:8px}.c3ph-hero img{aspect-ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}.c3ph-gal{display:grid;grid-template-columns:minmax(0,1fr);gap:1.5rem;margin:1.6rem 0;padding:0;list-style:none}.c3ph-gal>figure{margin:0;min-width:0}.c3ph-gal img{aspect-ratio:var(--c3ph-r,4/3)}.c3ph-gal figcaption{color:var(--muted);font-size:.85rem;line-height:1.45;margin-top:.5rem}@media (min-width:700px){.c3ph-gal{display:grid;grid-template-columns:repeat(var(--c3ph-n,3),minmax(0,1fr));gap:1rem;overflow:visible;padding:0}.c3ph-gal>figure{min-width:0}}@media (max-width:699px){.c3ph-gal.c3ph-row{display:flex;gap:.75rem;padding:0 var(--c3ph-bleed,1.4rem) .4rem;margin:1.6rem calc(-1*var(--c3ph-bleed,1.4rem)) 0;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding:0 v