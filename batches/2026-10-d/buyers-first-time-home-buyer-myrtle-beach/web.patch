,60%{background:var(--navy)}66%,100%{background:transparent}}}@media (min-width:700px){.c3ph-swipe{display:none}}.c3ph-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:1.4rem 0 1.8rem;padding:0;list-style:none}@media (min-width:700px){.c3ph-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}}@media (min-width:1000px){.c3ph-cards.c3ph-4{grid-template-columns:repeat(4,minmax(0,1fr))}}.c3ph-card{margin:0;background:var(--ivory);border:1px solid var(--rule);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}.c3ph-card .c3ph-f{border-radius:0}.c3ph-card img,.c3ph-card svg{display:block;width:100%;height:auto;aspect-ratio:var(--c3ph-r,4/3);object-fit:cover}.c3ph-card .c3ph-cr{font-size:.56rem;padding:1.2rem .45rem .25rem 1.6rem}.c3ph-card strong{display:block;color:var(--navy);font-size:.98rem;font-weight:500;line-height:1.3;padding:.7rem .8rem 0}.c3ph-card span.c3ph-t{display:block;color:var(--muted);font-size:.86rem;line-height:1.45;padding:.2rem .8rem .85rem}.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:720px}</style><figure class="c3-ft-chart"><span class="cap">What sold in Horry County in the past year, by price</span><div class="c3-ft-key" aria-hidden="true"><span><i style="background:#56636e"></i>Condos</span><span><i style="background:#4e6440"></i>Townhouses</span><span><i style="background:#8a5226"></i>Houses</span><span><i style="background:#d8d0c3"></i>Manufactured</span></div><div class="c3-ft-row"><span>Under $150,000</span><span class="c3-ft-stack" role="img" aria-label="Under $150,000: condos 79 percent, townhouses 2 percent, houses 13 percent"><i class="" style="width:79.4%;background:#56636e">79%</i><i class="" style="width:2.4%;background:#4e6440"></i><i class="" style="width:12.6%;background:#8a5226">13%</i><i class="lt" style="width:5.7%;background:#d8d0c3"></i></span></div><div class="c3-ft-row"><span>$150,000 to $200,000</span><span class="c3-ft-stack" role="img" aria-label="$150,000 to $200,000: condos 77 percent, townhouses 8 percent, houses 13 percent"><i class="" style="width:76.8%;background:#56636e">77%</i><i class="" style="width:8.0%;background:#4e6440"></i><i class="" style="width:12.7%;background:#8a5226">13%</i><i class="lt" style="width:2.6%;background:#d8d0c3"></i></span></div><div class="c3-ft-row"><span>$200,000 to $250,000</span><span class="c3-ft-stack" role="img" aria-label="$200,000 to $250,000: condos 47 percent, townhouses 13 percent, houses 38 percent"><i class="" style="width:47.2%;background:#56636e">47%</i><i class="" style="width:13.2%;background:#4e6440">13%</i><i class="" style="width:37.8%;background:#8a5226">38%</i><i class="lt" style="width:1.8%;background:#d8d0c3"></i></span></div><div class="c3-ft-row"><span>$250,000 to $300,000</span><span class="c3-ft-stack" role="img" aria-label="$250,000 to $300,000: condos 27 percent, townhouses 6 percent, houses 66 percent"><i class="" style="width:27.4%;background:#56636e">27%</i><i class="" style="width:5.6%;background:#4e6440"></i><i class="" style="width:66.1%;background:#8a5226">66%</i><i class="lt" style="width:0.8%;background:#d8d0c3"></i></span></div><div class="c3-ft-row"><span>$300,000 to $350,000</span><span class="c3-ft-stack" role="img" aria-label="$300,000 to $350,000: condos 18 percent, townhouses 5 percent, houses 76 percent"><i class="" style="width:18.0%;background:#56636e">18%</i><i class="" style="width:5.4%;background:#4e6440"></i><i class="" style="width:76.5%;background:#8a5226">76%</i></span></div><div class="c3-ft-row"><span>$350,000 to $400,000</span><span class="c3-ft-stack" role="img" aria-label="$350,000 to $400,000: condos 19 percent, townhouses 6 percent, houses 75 percent"><i class="" style="width:19.2%;background:#56636e">19%</i><i class="" style="width:5.6%;background:#4e6440"></i><i class="" style="width:75.2%;background:#8a5226">75%</i></span></div><figcaption style="color:var(--muted);font-size:.95rem;line-height:1.55;margin-top:.9rem">Each bar is the homes that sold in that price range. Homes over $400,000 are not shown.</figcaption></figure><div class="c3-ft-ex"><span class="cap">For sale now: the middle home in each group</span><ul class="c3-ft-tiles three" role="list"><li><span class="ic"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 21h18M5 21V9.5l5-3V21M10 21V4h9v17M13 8h3M13 12h3M13 16h3M7.5 13h.01M7.5 16.5h.01"/></svg></span>Condos, $250,000 or less</span><b>About 1,700</b><span class="d">listed. The middle one has 1 bedroom and about 740 square feet.</span></li><li><span class="ic"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span>Townhouses, $300,000 or less</span><b>About 200</b><span class="d">listed. The middle one has 3 bedrooms and about 1,430 square feet.</span></li><li><span class="ic"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span>Houses, $300,000 or less</span><b>576</b><span class="d">listed. The middle one has 3 bedrooms and about 1,470 square feet on a fifth of an acre, at $270,000.</span></li></ul></div><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-10-d/buyers-first-time-home-buyer-myrtle-beach/bent-oak-estates-houses-from-above-1200w.webp" srcset="/images/2026-10-d/buyers-first-time-home-buyer-myrtle-beach/bent-oak-estates-houses-from-above-600w.webp 600w, /images/2026-10-d/buyers-first-time-home-buyer-myrtle-beach/bent-oak-estates-houses-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Rows of small one-story houses with gray and brown roofs, short driveways and small yards along three streets, seen from above" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.govinfo.gov/content/pkg/USCODE-2023-title17/html/USCODE-2023-title17-chap1-sec105.htm" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo. License: Public domain" title="License: Public domain">U.S. government aerial photo</a></span></div><figcaption>Houses in Bent Oak Estates, in the City of Myrtle Beach, from above in January 2026. Nine of the 10 houses that sold in this view in the past year went for under $300,000.</figcaption></figure></div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">New houses often cost less than resales</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the middle, a new house from a builder sold for about $350,000, against about $375,000 for a resale.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In our experience, most builders here offer incentives to buyers using FHA, VA and conventional loans. A conventional loan is one that no government agency backs. Our <a href="/buyers/new-construction/" style="color:var(--navy);text-decoration:underline">new construction guide</a> covers buying from a builder.</p></div></section><section style="background:var(--ivory-2)" id="where"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Where">Where are the starter houses around Myrtle Beach?</h2><style>main#main .hx-strip:empty{display:none}main#main .hx-strip:not(:empty)+.hx-fallback{display:none}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Mostly inland. The most sold around Conway and Longs, then in Socastee, southwest of Myrtle Beach. In one of Conway's ZIP codes, about 7 in 10 houses and townhouses that sold went for under $300,000. In North Myrtle Beach it was about 1 in 12.</p><figure class="c3-ft-map" style="margin:1.6rem 0 1.8rem;max-width:560px"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 440 430" role="img" aria-label="Map of Horry County with a dot for each house or townhouse that sold for under $300,000 in the past year. The dots crowd around Conway, Longs and Loris, along the roads between them, and in Socastee southwest of Myrtle Beach. Few are near the beach in North Myrtle Beach."><defs><clipPath id="c3-ft-frame"><rect width="440" height="430"/></clipPath></defs><g clip-path="url(#c3-ft-frame)"><rect width="440" height="430" fill="#e9e3d8"/><path d="M288.7,337.4L289.1,337.1L296.8,331.4L301.1,328.6L304.0,326.7L308.7,323.2L312.5,321.0L323.2,315.7L328.8,313.3L333.6,311.2L336.6,309.9L341.8,308.1L343.4,307.7L348.3,305.3L355.7,302.8L364.7,300.1L376.6,298.2L389.1,295.6L398.0,290.0L400.0,289.6L399.9,289.4L390.8,279.4L387.8,276.0L383.8,271.6L380.2,267.7L378.9,266.4L377.7,265.1L377.2,264.6L376.1,263.4L372.6,259.8L372.4,259.6L372.1,259.3L370.7,257.8L369.3,256.4L369.1,256.2L367.0,254.0L366.7,253.7L366.5,253.5L366.3,253.3L365.7,252.7L365.6,252.6L365.2,252.2L364.8,251.7L364.1,251.0L362.3,249.1L360.0,246.8L359.3,246.1L356.8,243.5L355.6,242.3L352.5,239.1L346.6,233.1L341.5,227.9L339.9,226.2L339.5,225.7L338.3,224.6L335.1,221.3L329.9,216.0L322.7,208.7L313.8,199.5L309.0,194.6L301.5,187.0L299.3,184.7L293.1,178.3L291.6,176.9L290.7,176.0L290.1,175.4L287.6,172.8L285.0,170.2L283.2,168.3L276.3,161.3L271.6,156.5L270.6,155.5L268.7,153.6L266.0,150.8L263.4,148.2L262.6,147.4L261.3,146.0L258.1,142.7L256.3,141.0L255.1,139.7L254.2,138.8L253.2,137.7L252.9,137.5L251.3,135.9L250.8,135.3L247.0,131.5L241.8,126.2L239.8,124.1L235.7,119.9L234.5,118.8L232.6,116.8L231.8,116.0L230.5,114.7L228.3,112.4L227.3,111.4L