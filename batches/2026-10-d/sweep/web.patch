 <script type="application/ld+json">{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Does a long-term rental owe accommodations tax?", "acceptedAnswer": {"@type": "Answer", "text": "No. A lease of 90 days or more owes no accommodations tax and no hospitality fee. In Georgetown County the county tax stops at 30 days. A long-term rental still needs a business license."}}, {"@type": "Question", "name": "Does Airbnb pay the accommodations tax for me?", "acceptedAnswer": {"@type": "Answer", "text": "Partly. Airbnb sends in the state taxes, the Horry County hospitality fee, and the Myrtle Beach, North Myrtle Beach and Surfside city taxes. It sends in nothing for Pawleys Island or Georgetown County. Bookings you take directly are yours to file."}}, {"@type": "Question", "name": "How long does a guest have to stay before the tax stops?", "acceptedAnswer": {"@type": "Answer", "text": "90 continuous days for the state tax, the Horry County hospitality fee and Conway. 30 continuous days in Georgetown County."}}, {"@type": "Question", "name": "What happens if I miss the business license renewal?", "acceptedAnswer": {"@type": "Answer", "text": "Myrtle Beach charges 5 percent of the license fee for each month or part of a month. North Myrtle Beach starts at 5 percent and adds 5 percent every month after."}}, {"@type": "Question", "name": "Is the license fee based on my profit?", "acceptedAnswer": {"@type": "Answer", "text": "No. It is based on gross rent. An owner who lost money for the year still owes it."}}]}</script>
