 <script type="application/ld+json">{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Is the rule 14 days, or 10 percent?", "acceptedAnswer": {"@type": "Answer", "text": "Both. The larger number applies. A unit rented 100 days allows 14 personal days. A unit rented 200 days allows 20, because 10 percent of 200 is more than 14."}}, {"@type": "Question", "name": "Do days I spend fixing the unit count as personal use?", "acceptedAnswer": {"@type": "Answer", "text": "No. A day spent mainly on repairs and maintenance is not a personal use day, even if you sleep there. Keep the dates and receipts."}}, {"@type": "Question", "name": "Does letting family stay count as personal use?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. A day a family member uses the unit is personal use. A day anyone uses it for less than a fair rent is also personal use."}}, {"@type": "Question", "name": "What if I rent it for fewer than 15 days?", "acceptedAnswer": {"@type": "Answer", "text": "If the unit counts as a home and is rented fewer than 15 days in the year, the rent is not reported as income. The expenses are not rental expenses."}}, {"@type": "Question", "name": "Can the unit show a loss if it counts as a home?", "acceptedAnswer": {"@type": "Answer", "text": "No. In a year the unit counts as a home, rental expenses cannot exceed rental income. The excess carries forward. Depreciation is the last deduction taken."}}]}</script>
