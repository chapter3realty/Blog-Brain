 <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is Seasons at Prince Creek West a gated community?","acceptedAnswer":{"@type":"Answer","text":"Yes. There is a gate at the main entrance, with a call box for visitors."}},{"@type":"Question","name":"How much is the HOA fee in Seasons at Prince Creek West?","acceptedAnswer":{"@type":"Answer","text":"The HOA fee is about $340 a month. It includes internet, weekly trash pickup and lawn care."}},{"@type":"Question","name":"Are there new homes for sale in Seasons at Prince Creek West?","acceptedAnswer":{"@type":"Answer","text":"No. The builder has finished, so every home for sale in Seasons is a resale."}},{"@type":"Question","name":"Can someone under 55 live in Seasons at Prince Creek West?","acceptedAnswer":{"@type":"Answer","text":"Yes, if a resident 55 or older also lives in the home. No one under 18 can live there."}},{"@type":"Question","name":"How old are the homes in Seasons at Prince Creek West?","acceptedAnswer":{"@type":"Answer","text":"The homes were built from 2006 to 2016. Most are on one level, with 3 bedrooms."}},{"@type":"Question","name":"How far is Seasons at Prince Creek West from the beach?","acceptedAnswer":{"@type":"Answer","text":"About 13 minutes by car without traffic, to the nearest public beach access with parking, in Garden City."}}]}</script>
