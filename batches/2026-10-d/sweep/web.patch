land?", "acceptedAnswer": {"@type": "Answer", "text": "Public schools fall within the Georgetown County School District, generally the Waccamaw schools for the Litchfield and Pawleys area. Chapter3 will confirm the exact assignment on the district boundary map."}}]}</script>
