+  (() => {
+    // The bar sits under the site header, whose height changes with the screen.
+    const root = document.querySelector('.mg');
+    const header = document.getElementById('header');
+    const setTop = () => {
+      if (!root || !header) return;
+      const { position } = getComputedStyle(header);
+      const sticky = position === 'sticky' || position === 'fixed';
+      root.style.setProperty('--mg-top', `${sticky ? header.getBoundingClientRect().height : 0}px`);
+    };
+    setTop();
+    addEventListener('resize', setTop);
+    // The header changes height once the page scrolls (its "scroll" class); watching its size catches that without
+    // measuring the layout on every scroll event.
+    if (header && 'ResizeObserver' in window) new ResizeObserver(setTop).observe(header);
+
+    // Mark the section in view in the bar.
+    const links = [...document.querySelectorAll('.mg [data-spy]')];
+    const ids = [...new Set(links.map((link) => link.getAttribute('href').slice(1)))];
+    const sections = ids.map((id) => document.getElementById(id)).filter(Boolean);
+    if (!sections.length) return;
+    let current = null;
+    const mark = (id) => {
+      if (id === current) return;
+      current = id;
+      for (const link of links) {
+        const on = id !== null && link.getAttribute('href') === `#${id}`;
+        link.toggleAttribute('data-active', on);
+        const row = on && link.closest('ul');
+        if (row)
+          row.scrollTo({ left: link.offsetLeft - row.clientWidth / 2 + link.clientWidth / 2, behavior: 'smooth' });
+      }
+    };
+    // The section in view is the last one whose top has passed 40% of the screen; above the first, none. Read from
+    // the layout on each frame, so a jump (a reload that restores the scroll, a link to a section) never leaves a
+    // stale tab marked.
+    let queued = false;
+    const update = () => {
+      queued = false;
+      const line = window.innerHeight * 0.4;
+      let id = null;
