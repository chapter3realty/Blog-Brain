tax rate here depends on the address, so the tax is blank. Send us the address and we work it out.";else if(d.key==="surfside-beach")said+=" The tax is at the rate for most condos with a Surfside Beach address, which sit outside the town; inside the town it is a little higher.";o("stFill",said);pressed();calc()}function calc(){var d=D[$("stTown").value],price=g("stPrice"),miss=$("stPrice").value===""||$("stFee").value==="";if(!taxSet)$("stTax").value=d.mills&&price?Math.round(price*0.06*d.mills/1000):"";var i={rate:g("stNightly"),nights:Math.min(g("stNights"),365),clean:d.clean,run:d.run,util:$("stUtil").checked,mgr:Math.min(g("stMgr"),100),fee:g("stFee"),tax:g("stTax"),ins:g("stIns"),price:price};var c=run(i);o("stGross",m(c.gross));o("stClean",m(-c.clean));o("stAir",m(-c.airbnb));o("stUt",i.util?"in the HOA fee":m(-c.util));o("stSup",m(-c.supRep));o("stMg",m(-c.mgr));o("stBefore",m(c.before));o("stIn",m(-c.ins));if(miss){o("stHoa","--");o("stTx","--");o("stKept","--");o("stNeed","--");o("stSay","Put in the listing's price and HOA fee to see what you keep.");return}o("stHoa",m(-c.fee));o("stTx",c.tax?m(-c.tax):"not counted");o("stKept",m(c.kept));o("stNeed",c.need===null?"--":c.need>365?"more than 365":String(c.need));var s=!i.nights||!i.rate?"Enter a nightly rate and the nights booked.":Math.abs(c.kept)<250?"At "+i.nights+" nights the money from guests about pays the bills.":c.kept>0?"At "+i.nights+" nights you pay the bills and keep about "+m(c.kept)+" a year, before any loan.":"At "+i.nights+" nights you are about "+m(-c.kept)+" a year short of the bills, before any loan.";if(c.share!==null&&c.kept>=250&&i.nights&&i.rate)s+=" That is "+(Math.round(c.share*10)/10)+" percent of the price a year.";if(!c.tax&&i.nights&&i.rate)s+=" Property tax is not counted.";o("stSay",s)}function tips(){Array.prototype.forEach.call(document.querySelectorAll(".st-calc .q"),function(b){var t=$(b.getAttribute("aria-controls"));var set=function(on){b.setAttribute("aria-expanded",String(on));t.classList.toggle("on",on)};var pinned=false;b.addEventListener("click",function(){pinned=!pinned;set(pinned)});b.addEventListener("mouseenter",function(){set(true)});b.addEventListener("mouseleave",function(){if(!pinned)set(false)});b.addEventListener("focus",function(){set(true)});b.addEventListener("blur",function(){if(!pinned)set(false)})})}function start(){if(!$("stTown"))return;$("stTown").addEventListener("change",fill);$("stBeds").addEventListener("change",fill);Array.prototype.forEach.call(document.querySelectorAll(".st-pick button"),function(b){b.addEventListener("click",function(){$("stTown").value=b.getAttribute("data-t");$("stBeds").value="2";fill()})});["stPrice","stFee","stNightly","stNights","stIns","stMgr"].forEach(function(id){$(id).addEventListener("input",calc)});$("stUtil").addEventListener("change",calc);$("stTax").addEventListener("input",function(){taxSet=true;calc()});tips();fill()}if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",start);else start()})();</script><div class="st-ex"><p class="k">The worked example</p><p>The calculator starts on a typical two-bedroom for sale in an oceanfront building inside Myrtle Beach that allows nightly rentals. It asks about $327,000, and its HOA fee is about $1,225 a month.</p><p>The average two-bedroom Airbnb in Myrtle Beach books about 87 nights a year. At that count the owner falls about $4,200 short of the bills, before any loan.</p><p>The average listing is open to guests only part of the year. Open all year and booked at the same rate, it books about 135 nights and keeps about $4,600 over the bills, before any loan. If you will rent it all year, your result is likely closer to this line. Put 135 in the nights booked to see it.</p><p>The calculator starts with no manager. With a manager at 15 percent of the bookings, the same condo needs about 139 nights, so it falls about $600 short even when open all year.</p></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Thinking of a yearly lease instead? Our page on <a href="/invest/str-vs-ltr/" style="color:var(--navy);text-decoration:underline">Airbnb or a long-term rental</a> runs the same home both ways, and our <a href="/invest/long-term-rental/" style="color:var(--navy);text-decoration:underline">rental analyzer</a> prices the lease.</p></div></section><section style="background:var(--ivory)" id="condo-fee"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The HOA fee">Why does the HOA fee matter so much for a Myrtle Beach Airbnb?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In an oceanfront tower the HOA fee is the biggest bill, nearly three quarters of the worked condo's bills. It is due every month, in January as well as July. Where the fee is lower, the bills take far fewer booked nights to pay.</p><figure class="st-mo st-need"><p class="cap" id="stNeedCap">Nights needed to pay the bills, against nights booked</p><div class="st-key" aria-hidden="true"><span><i></i><span><b>Needed</b> for the HOA fee, tax and rental insurance</span></span><span><i class="mi"></i><span><b>Booked</b> by the town's average two-bedroom</span></span></div><table role="table" aria-labelledby="stNeedCap"><thead role="rowgroup" class="sr"><tr role="row"><th role="columnheader" scope="col">Where, and the HOA fee</th><th role="columnheader" scope="col">Bars</th><th role="columnheader" scope="col">Nights needed, nights booked</th></tr></thead><tbody role="rowgroup"><tr role="row"><th role="rowheader" scope="row"><a href="/submarkets/myrtle-beach/">Myrtle Beach, oceanfront</a><small>HOA fee $1,225 a month</small></th><td role="cell" class="bars"><span class="b" style="--f:1" aria-hidden="true"></span><span class="b mi" style="--f:0.791" aria-hidden="true"></span></td><td role="cell" class="v"><span>110 needed</span><span>87 booked</span></td></tr><tr role="row"><th role="rowheader" scope="row"><a href="/submarkets/north-myrtle-beach/">North Myrtle Beach, oceanfront</a><small>HOA fee $1,075 a month</small></th><td role="cell" class="bars"><span class="b" style="--f:0.945" aria-hidden="true"></span><span class="b mi" style="--f:0.655" aria-hidden="true"></span></td><td role="cell" class="v"><span>104 needed</span><span>72 booked</span></td></tr><tr role="row"><th role="rowheader" scope="row"><a href="/submarkets/garden-city/">Garden City Beach</a><small>HOA fee $575 a month</small></th><td role="cell" class="bars"><span class="b" style="--f:0.6" aria-hidden="true"></span><span class="b mi" style="--f:0.864" aria-hidden="true"></span></td><td role="cell" class="v"><span>66 needed</span><span>95 booked</span></td></tr><tr role="row"><th role="rowheader" scope="row"><a href="/submarkets/surfside-beach/">Surfside Beach</a><small>HOA fee $375 a month</small></th><td role="cell" class="bars"><span class="b" style="--f:0.382" aria-hidden="true"></span><span class="b mi" style="--f:0.727" aria-hidden="true"></span></td><td role="cell" class="v"><span>42 needed</span><span>80 booked</span></td></tr></tbody></table><figcaption>A typical two-bedroom condo for sale that allows nightly rentals, run by its owner, before any loan. Booked: AirROI, 12 months to September 2026.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The low fees are in two kinds of places: on the beach in Garden City Beach, and inland in Surfside Beach.</p><ul class="st-cost st-where"><li><b>Garden City Beach, on the beach</b><span class="why">Nearly all are on Waccamaw Drive, the street along the beach. Beach House, Sea Watch and Garden Sands are among those with fees of $600 a month or less.</span></li><li><b>Surfside Beach, mostly inland</b><span class="why">Most are at Retreat at Glenns Bay, Golf Colony at Deerfield and Grand Palms Resort, a mile or more from the beach, with fees of $600 or less. The few on the oceanfront, at Sea Shadow, have fees over $1,000. An inland condo may book fewer nights than the town's average of 80, which counts the beach condos too. It pays its bills at about 42, about half that average.</span></li><li><b>Myrtle Beach, oceanfront</b><span class="why">The fees under $800 a month are at places like Ocean Forest Villas and Beach Colony. The fee pays the electric on every unit listed at Sand Dunes, the Caribbean, Dunes Village, Carolinian Beach Resort and Grande Shores.</span></li><li><b>North Myrtle Beach, oceanfront</b><span class="why">The fee pays the electric on most of the units listed at Bay Watch and Beach Cove.</span></li></ul><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-10-d/invest-str-tools/myrtle-beach-oceanfront-towers-and-houses-2011-1200w.webp" srcset="/images/2026-10-d/invest-str-tools/myrtle-beach-oceanfront-towers-and-houses-2011-600w.webp 600w, /images/2026-10-d/invest-str-tools/myrtle-beach-oceanfront-towers-and-houses-2011-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="675" alt="Four oceanfront towers with balconies and pools behind the dune in Myrtle Beach, with streets of houses and woods behind them, seen from a plane over the ocean" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: U.S. Geological Survey. License: Public domain" title="License: Public domain">Photo: U.S. Geological Survey</a></span></div><figcaption>Oceanfront towers in Myrtle Beach, with streets of houses behind them, seen from over the ocean.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Tick the box in the calculator when the fee pays the electric, and the utilities line goes. Most oceanfront units are in the building's own rental program, which takes its own share. Our page on <a href="/invest/rental-program-vs-airbnb/" style="color:var(--navy);text-decoration:underline">a rental program or Airbnb</a> compares the two.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Send us the listing you are looking at</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We read the building's budget and what its fee pays for, at no cost.</p><a class="btn btn-brass" href="/contact/">Send us a listing</a></div></div></section><section style="background:var(--ivory-2)" id="towns"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Town by town">Which Grand Strand town does an Airbnb do best in?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For the same size of home, the towns are close. In seven of the eight, the average two-bedroom took in about $21,000 to $28,000 a year. Little River took in far less, and Murrells Inlet and Garden City Beach did best.</p><figure style="margin:1.8rem 0;max-width:760px"><svg xmlns="http://www.w3.org/2000/svg" id="c3r-grand-strand-airbnb-town" viewBox="0 0 360 418" width="360" height="418" role="img" aria-label="Grand Strand Airbnb towns: a map of 8 places, numbered 1, North Myrtle Beach; 2, Myrtle Beach; 3, Surfside Beach; 4, Garden City Beach; 5, Murrells Inlet; 6, Pawleys Island; 7, Little River; and 8, Conway." style="display:block;width:100%;height:auto;max-width:760px;background:#f7f3ec;border:1px solid rgba(28,32,40,.15)"><style>#c3r-grand-strand-airbnb-town text{font-family:'DM Sans',system-ui,-apple-system,'Segoe UI',sans-serif;paint-order:stroke;stroke:#f7f3ec;stroke-width:3px;stroke-linejoin:round;fill:#1c2028}#c3r-grand-strand-airbnb-town .h{font:500 17px 'Fraunces',Georgia,serif}#c3r-grand-strand-airbnb-town .l{