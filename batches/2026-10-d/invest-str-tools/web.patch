+
+    // Mark the section in view in the bar.
+    const links = [...document.querySelectorAll('.mg [data-spy]')];
+    const ids = [...new Set(links.map((link) => link.getAttribute('href').slice(1)))];
+    const sections = ids.map((id) => document.getElementById(id)).filter(Boolean);
+    if (!sections.length) return;
+    let current = null;
+    const mark = (id) => {
+      if (id === current) return;
+      current = id;
+      for (const link of links) {
+        const on = id !== null && link.getAttribute('href') === `#${id}`;
+        link.toggleAttribute('data-active', on);
+        const row = on && link.closest('ul');
+        if (row)
