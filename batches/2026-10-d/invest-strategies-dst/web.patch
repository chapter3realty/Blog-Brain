.4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:760px}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On a $400,000 rental sale on the Grand Strand, the Myrtle Beach area, you choose between paying the tax now, keeping the work of a rental, or giving up control of the money. The numbers are our example, worked through below.</p><style>.c3-cc{margin:1.4rem 0 1.8rem;max-width:960px}.c3-cc table{width:100%;border-collapse:collapse;font-size:var(--read,1.0625rem);line-height:1.45;color:var(--muted)}.c3-cc caption{caption-side:top;text-align:left;color:var(--navy);font-weight:600;font-size:1em;line-height:1.4;padding:0 0 .7rem}.c3-cc th,.c3-cc td{padding:.6rem .7rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule);overflow-wrap:break-word}.c3-cc thead th{color:var(--navy);font-weight:600;font-size:1em;border-bottom:2px solid var(--navy);vertical-align:bottom}.c3-cc tbody th{color:var(--navy);font-weight:600}.c3-cc .n{text-align:right;font-variant-numeric:tabular-nums}.c3-cc .i{display:inline-flex;vertical-align:-4px;margin-right:.45rem;color:var(--brass-ink)}.c3-cc tr.c3-self>*{background:#fff}@media (max-width:39.999em){.c3-cc table,.c3-cc tbody,.c3-cc tr,.c3-cc th,.c3-cc td{display:block;width:auto}.c3-cc caption{display:block}.c3-cc thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.c3-cc tbody tr{background:var(--ivory-2);border-top:3px solid var(--brass);margin:0 0 .8rem;padding:.5rem 0 .6rem}section[style*="background:var(--ivory-2)"] .c3-cc tbody tr{background:var(--ivory)}.c3-cc tr.c3-self{background:#fff!important;border:2px solid var(--brass)}.c3-cc tr.c3-self>*{background:transparent}.c3-cc th,.c3-cc td{border:0;padding:.2rem 1rem}.c3-cc tbody th{display:flex;align-items:center;font-size:1.1em;padding-bottom:.35rem}.c3-cc tbody th .i{flex:none;vertical-align:0}.c3-cc tbody th a{display:inline-block;padding:.5rem 0}.c3-cc .n{text-align:left}.c3-cc td[data-label]::before{content:attr(data-label) ": ";color:var(--navy);font-weight:500}}</style><div class="c3-cc"><table><caption>Three choices for our $400,000 example sale</caption><thead><tr><th scope="col">What changes</th><th scope="col">Sell and pay the tax</th><th scope="col">1031 into another rental</th><th scope="col">1031 into a DST</th></tr></thead><tbody><tr><th scope="row">Tax this year</th><td data-label="Sell and pay the tax">about $39,000, or more at higher incomes</td><td data-label="1031 into another rental">None yet</td><td data-label="1031 into a DST">None yet</td></tr><tr><th scope="row">Income</th><td data-label="Sell and pay the tax">None from this rental</td><td data-label="1031 into another rental">The rent, less your costs</td><td data-label="1031 into a DST">A share of leftover cash, not fixed</td></tr><tr><th scope="row">Work each month</th><td data-label="Sell and pay the tax">None</td><td data-label="1031 into another rental">Yours, or a manager's</td><td data-label="1031 into a DST">None</td></tr><tr><th scope="row">When you get the money</th><td data-label="Sell and pay the tax">At closing</td><td data-label="1031 into another rental">When you sell that rental</td><td data-label="1031 into a DST">When the trust sells</td></tr></tbody></table></div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Which one fits</h3><ul class="c3d-fits"><li><strong>A DST,</strong> if you would rather own a share of a large property someone else runs than a rental of your own.</li><li><strong>Another rental here,</strong> if you want to pick the property, set the rent and decide when to sell. Our <a href="/invest/strategies/1031-exchange/" style="color:var(--navy);text-decoration:underline">1031 exchange guide</a> covers the deadlines and how we find a replacement on the Grand Strand.</li><li><strong>Paying the tax,</strong> if you want the cash now, or the tax is small next to what a DST would cost you to enter.</li><li><strong>Keeping the rental,</strong> if the work is the only problem. A <a href="/invest/property-management/" style="color:var(--navy);text-decoration:underline">property manager</a> takes the calls, and our page on <a href="/invest/how-long-to-hold/" style="color:var(--navy);text-decoration:underline">how long to hold a rental</a> shows what waiting has meant here.</li></ul></div></section><section style="background:var(--ivory)" id="what-a-dst-is"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="How a DST works">Why does the IRS allow a DST in a 1031 exchange, and who sells one?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The IRS, in <a href="https://www.irs.gov/irb/2004-33_IRB" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Revenue Ruling 2004-86</a>, has ruled that you may trade a rental for a share of a Delaware statutory trust with no tax on the gain yet. The trust must follow the ruling's limits, and the other 1031 rules must be met.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You buy the share through a securities firm or broker, called the DST broker on this page. Anyone who sells you a DST share must be registered with the Financial Industry Regulatory Authority (FINRA), the SEC or the state before they can sell you anything. <a href="https://www.finra.org/investors/protect-your-money/check-registration" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FINRA's BrokerCheck</a> lists each securities firm and broker, with their licenses and record.</p></div></section><section style="background:var(--ivory-2)" id="what-you-give-up"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What you give up">What do you give up in a DST, and can you lose money?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The ruling requires these limits on the trust:</p><ol class="c3d-limits"><li><strong>The trust cannot take in new money from anyone.</strong><span class="m">A large repair has to be paid from the trust's own cash. That cash is not paid out to you.</span></li><li><strong>It cannot refinance its loan or sign a new lease.</strong><span class="m">In the ruling, the trust may sign a new lease only if its tenant goes bankrupt or insolvent. A DST with many tenants, such as an apartment community, can lease the whole property to one master tenant. In <a href="https://www.sec.gov/Archives/edgar/data/1314152/000131415226000030/jllipt-20251231.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">one large sponsor's program</a>, the master tenant is a company the sponsor owns. It signs the tenants, pays the costs of running the property and pays the trust its rent. Either way, the trust depends on one tenant's rent.</span></li><li><strong>You have no say in when the property sells.</strong><span class="m">The trust's manager decides.</span></li></ol><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What does a DST pay you?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The trust pays out the cash the property has left, less reserves, on a set schedule. In the IRS ruling, that is every quarter. The amount moves with the rent and with the cash held back for repairs.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The SEC filings we checked have no payout figure. If the sponsor projects a payout, the projection is in its offering document, often called a private placement memorandum (PPM).</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">To compare a DST with your rental, set the PPM's projected payout for a year on your share next to what your rental leaves you in a year: the rent, less every cost you pay, the mortgage included. Ask the DST broker for the PPM before you name a DST in your exchange, and look for four things in it:</p><ul class="c3d-ask"><li>Every fee, with its amount.</li><li>The projected payout, and what it rests on.</li><li>How long the sponsor plans to hold the property.</li><li>Who the tenants are, and how long their leases run.</li></ul><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can you get back less than you put in?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. You get back your share of what is left of the sale price after the trust's loan is paid off. The sales commissions and the sponsor's fees were paid out of the money first, so the property has to gain value before your share is worth what you paid. If it sells for less than the trust paid, you get back less still.</p></div></section><section style="background:var(--ivory)" id="who-can-buy"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Who can buy">Who can buy a DST?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most DSTs are sold only to buyers who pass the SEC's wealth test, called <a href="https://www.sec.gov/resources-small-businesses/capital-raising-building-blocks/accredited-investors" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">accredited investors</a>. For a person, you pass with either of these:</p><div class="c3d-grid"><div class="c3d-card"><h3>Net worth</h3><p><span class="c3d-big">Over $1 million</span>Alone or with a spouse or partner, not counting your home.</p></div><div class="c3d-card"><h3>Income</h3><p><span class="c3d-big">Over $200,000</span>Or $300,000 with a spouse or partner, in each of the last two years, with the same expected this year.</p></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Holders of certain securities licenses also pass. Plan on needing to pass. Of the 160 DST real estate offerings we checked in the last year's SEC Form D filings, 159 had sold only to buyers who pass, as of the filing.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most of them were filed under <a href="https://www.sec.gov/resources-small-businesses/exempt-offerings/general-solicitation-rule-506c" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SEC Rule 506(c)</a>, part of the SEC's Regulation D. Under it, the sponsor must check that you pass. <a href="https://www.law.cornell.edu/cfr/text/17/230.506" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">The rule</a> lists ways to check:</p><ul style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem"><strong>Income:</strong> your IRS forms for the last two years, such as W-2s, 1099s, K-1s or your Form 1040.</li><li style="margin-bottom:.5rem"><strong>Net worth:</strong> bank and brokerage statements from the last three months, and a credit report.</li><li style="margin-bottom:.5rem"><strong>A letter</strong> from your CPA, your lawyer, a registered broker-dealer or an SEC-registered investment adviser that says they checked.</li></ul></div></section><section style="background:var(--ivory-2)" id="minimums-and-fees"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Cost and minimum">What does a DST cost, and what is the minimum investment?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The usual minimum is $100,000. Sales commissions are about 6 percent of the money, and the sponsor's other fees come on top. The Form D filings show only the sales commissions. The other fees are in the PPM.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="The smallest amount each DST offering accepts, 156 offerings"><span class="cap" aria-hidden="true">The smallest amount each DST offering accepts, 156 offerings</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Minimum, note</span><span role="columnheader">Offerings</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">$1,000</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">20 from one sponsor, wealth test only</span></span><span role="cell"><span class="b" style="--f:0.368" aria-hidden="true"></span><span class="v">21 offerings</span></span></div><div role="row"><span role="rowheader"><span class="n">$25,000 to $99,999</span></span><span role="cell"><span class="b" style="--f:0.737" aria-hidden="true"></span><span class="v">42 offerings</span></span></div><div role="row"><span role="rowheader"><span class="n">$100,000</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">the most common minimum</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">57 offerings</span></span></div><div role="row"><span role="rowheader"><span class="n">$100,001 to $499,999</span></span><span role="cell"><span class="b" style="--f:0.333" aria-hidden="true"></span><span class="v">19 offerings</span></span></div><div role="row"><span role="rowheader"><span class="n">$500,000 or more</span></span><span role="cell"><span class="b" style="--f:0.298" aria-hidden="true"></span><span class="v">17 offerings</span></span></div></div></div><figcaption>Of the 160 DST offerings we checked, 156 named a minimum.</figcaption></figure><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What the commission means on a $400,000 sale</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our example is the same as on our <a href="/sell/capital-gains/" style="color:var(--navy);text-decoration:underline">capital gains page</a>: a Grand Strand rental bought for $250,000 and sold for $400,000, with $60,000 of depreciation taken, a gain of $186,000. A 1031 exchange into a rental or a DST puts off all of the tax. A higher-income seller owes up to about $7,100 more than the chart shows, the 3.8 percent <a href="https://www.irs.gov/taxtopics/tc559" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">net investment income tax</a>.</p><figure class="c3-gchart"><div role="table" aria-label="Our $400,000 example sale, put into a DST"><span class="cap" aria-hidden="true">Our $400,000 example sale, put into a DST</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">What, detail</span><span role="columnheader">Dollars</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Tax the exchange puts off</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">federal and South Carolina, before the 3.8% tax</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">$39,000</span></span></div><div role="row"><span role="rowheader"><span class="n">DST sales commissions on the same money</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about 6% of $376,000</span></span><span role="cell"><span class="b" style="--f:0.574" aria-hidden="true"></span><span class="v">$23,000</span></span></div></div></div><figcaption>What is left after selling costs, $376,000, goes into the DST. The DST's commissions come on top of those selling costs.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The sales commissions alone come to about half the tax the exchange puts off, or more, before the sponsor's other fees. You do not get the commissions back. The tax is still owed later, unless you exchange again or still own the share at your death.</p></div></section><section style="background:var(--ivory)" id="getting-out"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Getting out">How do you get your money out of a DST?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Mostly when the trust sells its property. The sponsor's planned hold is in the PPM. The SEC filings we checked do not show it. The trust in Revenue Ruling 2004-86 was set up to end after 10 years or when its building sold, whichever came first. A DST can end for you in four ways:</p><div class="c3d-grid"><div class="c3d-card"><h3>You want out early</h3><p>Plan to stay in until the trust sells. DST shares cannot be resold on a public market unless the conditions of <a href="https://www.sec.gov/reports/rule-144-selling-restricted-control-securities" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SEC Rule 144</a> are met. A private buyer, if you find one, decides what to pay.</p></div><div class="c3d-card"><h3>The trust sells the property</h3><p>You get your share of the money. Put it into a new 1031 exchange, with new deadlines, or pay the tax.</p></div><div class="c3d-card"><h3>A REIT buys back your shares</h3><p>Some DSTs are sold by large real estate companies called REITs (real estate investment trusts). After two years, the REIT may take back your shares, for cash or for units that cannot go into a later 1031 exchange, at the REIT's choice. If you get the units, your exchanges stop there. At least 13 REITs described this kind of buy-back in their latest annual reports.</p></div><div class="c3d-card"><h3>You still own it at your death</h3><p>Your heirs generally take it at its value on the date of death, so the gain you put off is not taxed to them. A rental you keep until death gets the same <a href="https://www.law.cornell.edu/uscode/text/26/1014" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">rule, 26 U.S.C. 1014</a>.</p></div></div></div></section><section style="background:var(--ivory-2)" id="backup"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="As a 1031 backup">Can a DST rescue a 1031 exchange that is going wrong?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Only if the DST is on the list you name by day 45. A <a href="https://www.law.cornell.edu/uscode/text/26/1031" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">1031 exchange</a> trades real property only for other real property. Every replacement, a DST share included, must be named in writing within 45 days of the sale. A DST named as a backup can still be bought if the rental you wanted falls through.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The exchange covers less of the tax if you keep cash or the sale pays off a mortgage:</p><ul style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem"><strong>Cash you keep.</strong> You can put part of the money into the exchange and keep the rest. The cash you keep is taxed, up to the amount of your gain.</li><li style="margin-bottom:.5rem"><strong>A mortgage the sale paid off.</strong> It counts as cash you received and is taxed the same way, unless the replacement carries as much debt or you add cash. A DST can help: your share of <a href="https://www.irs.gov/instructions/i8824" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">its loan can count</a> toward that debt. If your rental has a mortgage, raise it with your intermediary and tax adviser before you choose a DST. We give them the closing figures.</li></ul></div></section><section style="background:var(--ivory)" id="grand-strand"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="DSTs here">Do DSTs own property on the Grand Strand?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. We checked <a href="https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer/24" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County's parcel file</a> for owners with DST in the name:</p><div class="c3d-stats" role="list" aria-label="DSTs in Horry County's parcel file"><div role="listitem"><b>10</b>DSTs as owners</div><div role="listitem"><b>11</b>parcels they own</div><div role="listitem"><b>$200 million</b>county value for tax, all 11</div></div><figure style="margin:1.8rem 0;max-width:760px"><svg xmlns="http://www.w3.org/2000/svg" id="c3r-where-dsts-own-homes-for" viewBox="0 0 360 288" width="360" height="288" role="img" aria-label="Where DSTs own homes for rent in Horry County: a map of 3 places, numbered 1, Apartments near Carolina Forest Blvd; 2, Apartments in the Clear Pond area; and 3, Rental-home community near the US 17 Bypass." style="display:block;width:100%;height:auto;max-width:760px;background:#f7f3ec;border:1px solid rgba(28,32,40,.15)"><style>#c3r-where-dsts-own-homes-for text{font-family:'DM Sans',system-ui,-apple-system,'Segoe UI',sans-serif