lock;width:10px;height:10px;border-radius:50%;border:1.5px solid var(--navy);box-sizing:border-box}.c3ph-dots i:first-child{background:var(--navy)}@supports (animation-timeline:view()){.c3ph-rowbox{timeline-scope:--c3ph-p1,--c3ph-p2,--c3ph-p3}.c3ph-row>figure:nth-child(1){view-timeline:--c3ph-p1 inline}.c3ph-row>figure:nth-child(2){view-timeline:--c3ph-p2 inline}.c3ph-row>figure:nth-child(3){view-timeline:--c3ph-p3 inline}.c3ph-dots i{animation:c3ph-dot linear both;animation-range:cover}.c3ph-dots i:nth-child(1){animation-timeline:--c3ph-p1}.c3ph-dots i:nth-child(2){animation-timeline:--c3ph-p2}.c3ph-dots i:nth-child(3){animation-timeline:--c3ph-p3}@keyframes c3ph-dot{0%,36%{background:transparent}42%,60%{background:var(--navy)}66%,100%{background:transparent}}}@media (min-width:700px){.c3ph-swipe{display:none}}.c3ph-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:1.4rem 0 1.8rem;padding:0;list-style:none}@media (min-width:700px){.c3ph-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}}@media (min-width:1000px){.c3ph-cards.c3ph-4{grid-template-columns:repeat(4,minmax(0,1fr))}}.c3ph-card{margin:0;background:var(--ivory);border:1px solid var(--rule);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}.c3ph-card .c3ph-f{border-radius:0}.c3ph-card img,.c3ph-card svg{display:block;width:100%;height:auto;aspect-ratio:var(--c3ph-r,4/3);object-fit:cover}.c3ph-card .c3ph-cr{font-size:.56rem;padding:1.2rem .45rem .25rem 1.6rem}.c3ph-card strong{display:block;color:var(--navy);font-size:.98rem;font-weight:500;line-height:1.3;padding:.7rem .8rem 0}.c3ph-card span.c3ph-t{display:block;color:var(--muted);font-size:.86rem;line-height:1.45;padding:.2rem .8rem .85rem}.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On a typical rental sale, the choice is between paying about $39,000 of tax now, keeping the work of a rental, or giving up control of the money.</p><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-10-d/invest-strategies-dst/myrtle-beach-oceanfront-condo-buildings-2011-1200w.webp" srcset="/images/2026-10-d/invest-strategies-dst/myrtle-beach-oceanfront-condo-buildings-2011-600w.webp 600w, /images/2026-10-d/invest-strategies-dst/myrtle-beach-oceanfront-condo-buildings-2011-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="782" alt="Three mid-rise condo buildings and three condo towers behind the beach in Myrtle Beach, seen from a plane over the ocean" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: U.S. Geological Survey. License: Public domain" title="License: Public domain">Photo: U.S. Geological Survey</a></span></div><figcaption>Oceanfront condo buildings in Myrtle Beach, seen from over the ocean in 2011. More than half of Horry County's condo units have an owner whose tax-bill address is outside South Carolina.</figcaption></figure></div><style>.c3-cc{margin:1.4rem 0 1.8rem;max-width:960px}.c3-cc table{width:100%;border-collapse:collapse;font-size:var(--read,1.0625rem);line-height:1.45;color:var(--muted)}.c3-cc caption{caption-side:top;text-align:left;color:var(--navy);font-weight:600;font-size:1em;line-height:1.4;padding:0 0 .7rem}.c3-cc th,.c3-cc td{padding:.6rem .7rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule);overflow-wrap:break-word}.c3-cc thead th{color:var(--navy);font-weight:600;font-size:1em;border-bottom:2px solid var(--navy);vertical-align:bottom}.c3-cc tbody th{color:var(--navy);font-weight:600}.c3-cc .n{text-align:right;font-variant-numeric:tabular-nums}.c3-cc .i{display:inline-flex;vertical-align:-4px;margin-right:.45rem;color:var(--brass-ink)}.c3-cc tr.c3-self>*{background:#fff}@media (max-width:39.999em){.c3-cc table,.c3-cc tbody,.c3-cc tr,.c3-cc th,.c3-cc td{display:block;width:auto}.c3-cc caption{display:block}.c3-cc thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.c3-cc tbody tr{background:var(--ivory-2);border-top:3px solid var(--brass);margin:0 0 .8rem;padding:.5rem 0 .6rem}section[style*="background:var(--ivory-2)"] .c3-cc tbody tr{background:var(--ivory)}.c3-cc tr.c3-self{background:#fff!important;border:2px solid var(--brass)}.c3-cc tr.c3-self>*{background:transparent}.c3-cc th,.c3-cc td{border:0;padding:.2rem 1rem}.c3-cc tbody th{display:flex;align-items:center;font-size:1.1em;padding-bottom:.35rem}.c3-cc tbody th .i{flex:none;vertical-align:0}.c3-cc tbody th a{display:inline-block;padding:.5rem 0}.c3-cc .n{text-align:left}.c3-cc td[data-label]::before{content:attr(data-label) ": ";color:var(--navy);font-weight:500}}</style><div class="c3-cc"><table><caption>Three choices for one rental sale</caption><thead><tr><th scope="col">What changes</th><th scope="col">Sell and pay the tax</th><th scope="col">1031 into another rental</th><th scope="col">1031 into a DST</th></tr></thead><tbody><tr><th scope="row">Tax this year</th><td data-label="Sell and pay the tax">about $39,000</td><td data-label="1031 into another rental">None, put off</td><td data-label="1031 into a DST">None, put off</td></tr><tr><th scope="row">Income</th><td data-label="Sell and pay the tax">None from this rental</td><td data-label="1031 into another rental">The rent, less your costs</td><td data-label="1031 into a DST">A share of leftover cash; not fixed</td></tr><tr><th scope="row">Work each month</th><td data-label="Sell and pay the tax">None</td><td data-label="1031 into another rental">Yours, or a manager's</td><td data-label="1031 into a DST">None</td></tr><tr><th scope="row">Who decides when to sell</th><td data-label="Sell and pay the tax">Nothing left to sell</td><td data-label="1031 into another rental">You</td><td data-label="1031 into a DST">The trust's manager</td></tr><tr><th scope="row">When you get the money</th><td data-label="Sell and pay the tax">At closing</td><td data-label="1031 into another rental">When you sell</td><td data-label="1031 into a DST">When the trust sells</td></tr><tr><th scope="row">Who can do it</th><td data-label="Sell and pay the tax">Anyone</td><td data-label="1031 into another rental">Anyone</td><td data-label="1031 into a DST">Only those who pass the SEC wealth test</td></tr><tr><th scope="row">What you pay to get in</th><td data-label="Sell and pay the tax">Your selling costs only</td><td data-label="1031 into another rental">Closing costs on the new rental</td><td data-label="1031 into a DST">Commissions, then the sponsor's fees</td></tr><tr><th scope="row">At the end</th><td data-label="Sell and pay the tax">Nothing more owed</td><td data-label="1031 into another rental">Exchange again, or pay the tax</td><td data-label="1031 into a DST">Exchange again, or pay the tax</td></tr></tbody></table></div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Which one fits</h3><ul class="c3d-fits"><li><strong>A DST,</strong> if you are done managing, you pass the SEC's wealth test, and you will not need the money for years.</li><li><strong>Another rental here,</strong> if you want to pick the property, set the rent and decide when to sell. Our <a href="/invest/strategies/1031-exchange/" style="color:var(--navy);text-decoration:underline">1031 exchange guide</a> covers the deadlines and how we find a replacement on the Grand Strand.</li><li><strong>Paying the tax,</strong> if you want the cash now, or the tax is small next to what a DST would cost you to enter.</li><li><strong>Keeping the rental,</strong> if the work is the only problem. A <a href="/invest/property-management/" style="color:var(--navy);text-decoration:underline">property manager</a> takes the calls, and our page on <a href="/invest/how-long-to-hold/" style="color:var(--navy);text-decoration:underline">how long to hold a rental</a> shows what waiting has meant here.</li></ul></div></section><section style="background:var(--ivory)" id="what-a-dst-is"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What a DST is">What is a DST, and why does the IRS allow it in a 1031 exchange?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A Delaware statutory trust is a trust that owns a building, and you buy a share of it. In <a href="https://www.irs.gov/irb/2004-33_IRB" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Revenue Ruling 2004-86</a>, the IRS said you may trade real property for a share of a trust of this kind with no tax on the gain. The trust must follow the ruling's limits, and the other 1031 rules must be met.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For federal income tax, you are treated as owning a share of the building itself. Your share of the rent and of the depreciation goes on your own return. In the IRS ruling, no owner is personally liable on the building's loan.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is a DST a REIT?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. A REIT, a real estate investment trust, is a company that owns many buildings. A DST share counts, for federal income tax, as a share of one building, and that is what lets it be the real property a 1031 exchange needs. Some large REITs sell DST shares, and that can end your exchanges, as the section on getting your money out explains.</p></div></section><section style="background:var(--ivory-2)" id="what-you-give-up"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What you give up">What do you give up in a DST, and can you lose money?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The IRS ruling lists limits the trust must follow. They protect the tax treatment, and they take choices away from you. Three matter most to a seller:</p><ol class="c3d-limits"><li><strong>The trust cannot take in new money from anyone.</strong><span class="m">A large repair has to be paid from the trust's own cash, and that is cash that is not paid out to you.</span></li><li><strong>It cannot refinance its loan or sign a new tenant.</strong><span class="m">A new tenant is allowed only if the old one goes bankrupt or insolvent. A building with one tenant depends on that tenant's rent.</span></li><li><strong>You have no say in when the building sells.</strong><span class="m">The trust's manager decides, so your money comes back on the trust's schedule, not yours.</span></li></ol><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If the manager is given more power than the ruling allows, the IRS treats the trust as a partnership, and a partnership share cannot be used in a 1031 exchange.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What does a DST pay you?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The trust pays out the cash the building has left, less reserves, on a set schedule. In the IRS ruling, that is every quarter. The payout is not a fixed amount. It falls when the rent falls or the trust holds back cash for a repair.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can you get back less than you put in?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. When the trust sells, you get your share of the sale. The sales commissions and the sponsor's fees were paid out of the money first, so the building has to gain value before your share is worth what you paid. If it sells for less than the trust paid, you get back less still.</p></div></section><section style="background:var(--ivory)" id="who-can-buy"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Who can buy">Who can buy a DST?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most DSTs are sold only to buyers who pass the SEC's wealth test, called <a href="https://www.sec.gov/resources-small-businesses/capital-raising-building-blocks/accredited-investors" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">accredited investors</a>. For a person, you pass with any one of three:</p><div class="c3d-grid c3d-3"><div class="c3d-card"><h3>Net worth</h3><p><span class="c3d-big">Over $1 million</span>Alone or with a spouse or partner, not counting your home.</p></div><div class="c3d-card"><h3>Income</h3><p><span class="c3d-big">Over $200,000</span>Or $300,000 with a spouse or partner, in each of the last two years, with the same expected this year.</p></div><div class="c3d-card"><h3>A securities license</h3><p><span class="c3d-big">Series 7, 65 or 82</span>Held and in good standing.</p></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Of the 160 DST offerings we counted in SEC filings, 159 reported no buyer outside the test when they were filed. In most of them, <a href="https://www.sec.gov/resources-small-businesses/exempt-offerings/general-solicitation-rule-506c" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">the seller must also check</a> that you qualify.</p></div></section><section style="background:var(--ivory-2)" id="minimums-and-fees"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Cost and minimum">What does a DST cost, and what is the minimum investment?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The usual minimum is $100,000. Sales commissions take about 6 percent of the money, and the sponsor's other fees come on top. We read every new DST real estate offering filed with the SEC in the year to September 2026, at least 160 of them.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="The smallest amount each DST offering accepts, 156 offerings"><span class="cap" aria-hidden="true">The smallest amount each DST offering accepts, 156 offerings</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Minimum, note</span><span role="columnheader">Offerings</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">$1,000</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">20 of the 21 from one sponsor's series</span></span><span role="cell"><span class="b" style="--f:0.368" aria-hidden="true"></span><span class="v">21 offerings</span></span></div><div role="row"><span role="rowheader"><span class="n">$25,000 to $99,999</span></span><span role="cell"><span class="b" style="--f:0.737" aria-hidden="true"></span><span class="v">42 offerings</span></span></div><div role="row"><span role="rowheader"><span class="n">$100,000</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">the most common minimum</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">57 offerings</span></span></div><div role="row"><span role="rowheader"><span class="n">$100,001 to $499,999</span></span><span role="cell"><span class="b" style="--f:0.333" aria-hidden="true"></span><span class="v">19 offerings</span></span></div><div role="row"><span role="rowheader"><span class="n">$500,000 or more</span></span><span role="cell"><span class="b" style="--f:0.298" aria-hidden="true"></span><span class="v">17 offerings</span></span></div></div></div><figcaption>DST real estate offerings filed with the SEC in the year to September 2026 that named a minimum. Four more gave none.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most asked $100,000 or more.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What the commission means on a $400,000 sale</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Take a Grand Strand rental sold for $400,000, the same example as on our <a href="/sell/capital-gains/" style="color:var(--navy);text-decoration:underline">capital gains page</a>. The gain is $186,000. Selling and paying the tax costs about $39,000 in federal and South Carolina tax. A 1031 exchange into a rental or a DST puts all of it off.</p><figure class="c3-gchart"><div role="table" aria-label="One $400,000 rental sale put into a DST"><span class="cap" aria-hidden="true">One $400,000 rental sale put into a DST</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">What, detail</span><span role="columnheader">Dollars</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Tax you put off</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">federal and South Carolina</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">$39,000</span></span></div><div role="row"><span role="rowheader"><span class="n">DST sales commissions on the same money</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about 6% of $376,000</span></span><span role="cell"><span class="b" style="--f:0.574" aria-hidden="true"></span><span class="v">$23,000</span></span></div></div></div><figcaption>Our example: bought for $250,000, $60,000 of depreciation taken, $24,000 of selling costs, no mortgage, so all $376,000 goes into the DST. The DST's commissions come on top of those selling costs. A seller whose income is over $200,000, or $250,000 married filing jointly, would put off up to about $7,100 more, for the 3.8 percent tax on investment income.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Put the $376,000 into a DST, and about $23,000 of it pays the DST's sales commissions. That is more than half the tax you put off, before the sponsor's other fees. The tax is put off, not forgiven; the commission is spent.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Selling a rental to fund an exchange?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us the address and your deadline. An agent plans the listing and the closing around your 45 and 180 days.</p><a class="btn btn-brass" href="/contact/">Plan my rental sale</a></div><div class="c3d-callout"><p>The SEC form shows only the commissions, so they are the least that comes out of your money, not the total. In 2005 the <a href="https://www.finra.org/rules-guidance/notices/05-18" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">securities regulator now called FINRA</a> warned about a similar product, tenant-in-common shares sold for 1031 exchanges: as the fees rise, they offset the money saved by putting off the tax.</p></div></div></section><section style="background:var(--ivory)" id="getting-out"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Getting out">How do you get your money out of a DST?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Mostly when the trust sells its building. We found no public record of how long DSTs usually hold. The trust in the IRS ruling was set up to end after 10 years or when its building sold, whichever came first. A DST can end for you in four ways:</p><div class="c3d-grid"><div class="c3d-card"><h3>You want out early</h3><p>DST shares cannot be resold on a public market unless <a href="https://www.sec.gov/reports/rule-144-selling-restricted-control-securities" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">the SEC's conditions</a> are met. Plan to hold them until the trust sells.</p></div><div class="c3d-card"><h3>The trust sells the building</h3><p>You get your share of the money. Put it into a new 1031 exchange, with new deadlines, or pay the tax.</p></div><div class="c3d-card"><h3>A REIT buys back your shares</h3><p>Some DSTs sold by large REITs let the REIT take back your shares after two years, for cash or for units in its partnership, at the REIT's choice. Units cannot go into a later 1031 exchange, so your exchanges stop there. At least 13 REITs described this kind of buy-back in their latest annual reports.</p></div><div class="c3d-card"><h3>You still own it at your death</h3><p>Your heirs generally take it at its value on the date of death, so the gain you put off is not taxed to them. A rental you keep until death gets the same <a href="https://www.law.cornell.edu/uscode/text/26/1014" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">rule</a>.</p></div></div></div></section><section style="background:var(--ivory-2)" id="backup"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="As a 1031 backup">Can a DST rescue a 1031 exchange that is going wrong?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Only if the DST is on your day-45 list. A <a href="https://www.law.cornell.edu/uscode/text/26/1031" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">1031 exchange</a> trades real property only for other real property. Every replacement, a DST share included, must be named in writing within 45 days of the sale. A DST named as a backup can still be bought if the rental you wanted falls through.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Two things change how much of the tax stays put off:</p><ul style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem"><strong>Cash you keep.</strong> You can put part of the money into the exchange and keep the rest. The cash you keep is taxed, up to the amount of your gain.</li><li style="margin-bottom:.5rem"><strong>A mortgage the sale paid off.</strong> The debt counts like cash you received, unless the replacement carries as much debt or you add cash. A share of a DST's <a href="https://www.irs.gov/instructions/i8824" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">loan can count</a> toward that. Your intermediary and tax adviser size it for your sale, and we give them the closing figures.</li></ul></div></section><section style="background:var(--ivory)" id="grand-strand"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="DSTs here">Do DSTs own property on the Grand Strand?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. We checked <a href="https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer/24" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County's parcel file</a> for owners with DST in the name. The values are the county's own:</p><div class="c3d-stats" role="list" aria-label="DSTs in Horry County's parcel file"><div role="listitem"><b>10</b>DSTs as owners</div><div role="listitem"><b>11</b>parcels they own</div><div role="listitem"><b>$200 million</b>county value, rounded</div></div><figure style="margin:1.8rem 0;max-width:760px"><svg xmlns="http://www.w3.org/2000/svg" id="c3r-where-dsts-own-homes-for" viewBox="0 0 360 432" width="360" height="432" role="img" aria-label="Where DSTs own homes for rent in Horry County: a map of 3 places, numbered 1, Apartments near Carolina Forest Blvd; 2, Apartments in the Clear Pond area; and 3, Homes near the US 17 Bypass." style="display:block;width:100%;height:auto;max-width:760px;background:#f7f3ec;border:1px solid rgba(28,32,40,.15)"><style>#c3r-where-dsts-own-homes-for text{font-family:'DM Sans',system-ui,-apple-system,'Segoe UI',sans-serif;paint-order:stroke;stroke:#f7f3ec;stroke-width:3px;stroke-linejoin:round;fill:#1c2028}#c3r-where-dsts-own-homes-for .h{font:500 17px 'Fraunces',Georgia,serif}#c3r-where-dsts-own-homes-for .l{font-size:14px;font-weight:500}#c3r-where-dsts-own-homes-for .m{font-size:13px;font-weight:500;fill:#91592b}#c3r-where-dsts-own-homes-for .t{font-size:14px;font-weight:500;letter-spacing:.1em;fill:#5c6b78}#c3r-where-dsts-own-homes-for .T{font-size:14px;font-weight:500;letter-spacing:.1em;fill:#3b4450}#c3r-where-dsts-own-homes-for .o{font:italic 400 15px 'Fraunces',Georgia,serif;letter-spacing:.06em;fill:#3f6275;stroke:#c9dde6}#c3r-where-dsts-own-homes-for .p{font-size:14px;font-weight:500;fill:#4a6640}#c3r-where-dsts-own-homes-for .f{font-size:11px;font-weight:500;letter-spacing:.1e