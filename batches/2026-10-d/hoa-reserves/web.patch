+<td><font face="Verdana" ><center><b>
+    <a href="index.cfm?App_mode=Display_Index&Title_Request=XL#TitleXL">Title XL</a></b><br>REAL AND PERSONAL PROPERTY</center></font></td>
+<td><font face="Verdana" ><center><b>
+    
+        <a href="index.cfm?App_mode=Display_Statute&URL=0700-0799/0718/0718ContentsIndex.html">Chapter 718</a>
+    
+    </b><br>CONDOMINIUMS</center></font></td>
