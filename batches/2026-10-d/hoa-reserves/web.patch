+const PF_WEAK = Math.round(W.balance / WX.fully_funded_balance * 100), PF_STRONG = Math.round(S.balance / WX.fully_funded_balance * 100);
+const SHARE = Math.round(B.reserve_line / B.assessment_income_year * 1000) / 10;
