.4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:760px}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">An Airbnb earns more when it books often, and a lease earns more when it does not. Here is one Myrtle Beach two-bedroom run both ways, by its owner, with the same utilities on each side.</p><style>.c3-cc{margin:1.4rem 0 1.8rem;max-width:960px}.c3-cc table{width:100%;border-collapse:collapse;font-size:var(--read,1.0625rem);line-height:1.45;color:var(--muted)}.c3-cc caption{caption-side:top;text-align:left;color:var(--navy);font-weight:600;font-size:1em;line-height:1.4;padding:0 0 .7rem}.c3-cc th,.c3-cc td{padding:.6rem .7rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule);overflow-wrap:break-word}.c3-cc thead th{color:var(--navy);font-weight:600;font-size:1em;border-bottom:2px solid var(--navy);vertical-align:bottom}.c3-cc tbody th{color:var(--navy);font-weight:600}.c3-cc .n{text-align:right;font-variant-numeric:tabular-nums}.c3-cc .i{display:inline-flex;vertical-align:-4px;margin-right:.45rem;color:var(--brass-ink)}.c3-cc tr.c3-self>*{background:#fff}@media (max-width:39.999em){.c3-cc table,.c3-cc tbody,.c3-cc tr,.c3-cc th,.c3-cc td{display:block;width:auto}.c3-cc caption{display:block}.c3-cc thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.c3-cc tbody tr{background:var(--ivory-2);border-top:3px solid var(--brass);margin:0 0 .8rem;padding:.5rem 0 .6rem}section[style*="background:var(--ivory-2)"] .c3-cc tbody tr{background:var(--ivory)}.c3-cc tr.c3-self{background:#fff!important;border:2px solid var(--brass)}.c3-cc tr.c3-self>*{background:transparent}.c3-cc th,.c3-cc td{border:0;padding:.2rem 1rem}.c3-cc tbody th{display:flex;align-items:center;font-size:1.1em;padding-bottom:.35rem}.c3-cc tbody th .i{flex:none;vertical-align:0}.c3-cc tbody th a{display:inline-block;padding:.5rem 0}.c3-cc .n{text-align:left}.c3-cc td[data-label]::before{content:attr(data-label) ": ";color:var(--navy);font-weight:500}}</style><div class="c3-cc"><table><caption>One Myrtle Beach two-bedroom, run both ways, before the loan, tax and HOA fee</caption><thead><tr><th scope="col">In a year</th><th scope="col" class="n">Airbnb, middle listing</th><th scope="col" class="n">Airbnb, top-quarter mark</th><th scope="col" class="n">Yearly lease</th></tr></thead><tbody><tr><th scope="row">Money in a year</th><td class="n" data-label="Airbnb, middle listing">$20,100</td><td class="n" data-label="Airbnb, top-quarter mark">$44,250</td><td class="n" data-label="Yearly lease">$18,048</td></tr><tr><th scope="row">Running costs</th><td class="n" data-label="Airbnb, middle listing">$7,700</td><td class="n" data-label="Airbnb, top-quarter mark">$16,600</td><td class="n" data-label="Yearly lease">$2,800</td></tr><tr><th scope="row">Kept a year</th><td class="n" data-label="Airbnb, middle listing">$12,400</td><td class="n" data-label="Airbnb, top-quarter mark">$27,700</td><td class="n" data-label="Yearly lease">$15,250</td></tr><tr><th scope="row">Against the lease</th><td class="n" data-label="Airbnb, middle listing">About $3,000 less</td><td class="n" data-label="Airbnb, top-quarter mark">About $12,000 more</td><td class="n" data-label="Yearly lease">The base line</td></tr></tbody></table></div><p style="color:var(--muted);font-size:1rem;line-height:1.6;max-width:640px;margin:-.4rem 0 1.2rem">Airbnb: AirROI's Myrtle Beach market, two-bedroom listings, at AirROI's cost shares for an owner who runs the listing. The middle listing counts listings open only part of the year. The top-quarter mark is a listing of any size run all year. Lease: HUD's two-bedroom standard rent of $1,504 a month. Airbnb's costs also include insurance and a permit; the guest's cleaning fee pays the cleaner. The 13 percent lodging tax is inside Myrtle Beach city limits.</p><style>.c3-cc{margin:1.4rem 0 1.8rem;max-width:960px}.c3-cc table{width:100%;border-collapse:collapse;font-size:var(--read,1.0625rem);line-height:1.45;color:var(--muted)}.c3-cc caption{caption-side:top;text-align:left;color:var(--navy);font-weight:600;font-size:1em;line-height:1.4;padding:0 0 .7rem}.c3-cc th,.c3-cc td{padding:.6rem .7rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule);overflow-wrap:break-word}.c3-cc thead th{color:var(--navy);font-weight:600;font-size:1em;border-bottom:2px solid var(--navy);vertical-align:bottom}.c3-cc tbody th{color:var(--navy);font-weight:600}.c3-cc .n{text-align:right;font-variant-numeric:tabular-nums}.c3-cc .i{display:inline-flex;vertical-align:-4px;margin-right:.45rem;color:var(--brass-ink)}.c3-cc tr.c3-self>*{background:#fff}@media (max-width:39.999em){.c3-cc table,.c3-cc tbody,.c3-cc tr,.c3-cc th,.c3-cc td{display:block;width:auto}.c3-cc caption{display:block}.c3-cc thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.c3-cc tbody tr{background:var(--ivory-2);border-top:3px solid var(--brass);margin:0 0 .8rem;padding:.5rem 0 .6rem}section[style*="background:var(--ivory-2)"] .c3-cc tbody tr{background:var(--ivory)}.c3-cc tr.c3-self{background:#fff!important;border:2px solid var(--brass)}.c3-cc tr.c3-self>*{background:transparent}.c3-cc th,.c3-cc td{border:0;padding:.2rem 1rem}.c3-cc tbody th{display:flex;align-items:center;font-size:1.1em;padding-bottom:.35rem}.c3-cc tbody th .i{flex:none;vertical-align:0}.c3-cc tbody th a{display:inline-block;padding:.5rem 0}.c3-cc .n{text-align:left}.c3-cc td[data-label]::before{content:attr(data-label) ": ";color:var(--navy);font-weight:500}}</style><div class="c3-cc"><table><caption>What else changes between the two</caption><thead><tr><th scope="col">What changes</th><th scope="col">Airbnb</th><th scope="col">Yearly lease</th></tr></thead><tbody><tr><th scope="row">Running costs</th><td data-label="Airbnb">Airbnb's fee, utilities, upkeep</td><td data-label="Yearly lease">Utilities, one month empty</td></tr><tr><th scope="row">Work</th><td data-label="Airbnb">About 19 check-outs a year</td><td data-label="Yearly lease">One move-in a year</td></tr><tr><th scope="row">Lodging tax</th><td data-label="Airbnb">The guest pays about 13% on top</td><td data-label="Yearly lease">None on 90 days or more</td></tr><tr><th scope="row">Slow months</th><td data-label="Airbnb">Less than a lease, November to February</td><td data-label="Yearly lease">The same rent every month</td></tr></tbody></table></div><div class="sl-fit"><div><h3>An Airbnb fits when</h3><ul><li>The zoning and the building allow stays under 90 days.</li><li>The home can book more nights than the break-even below.</li><li>You can handle about 19 check-outs a year, or pay a manager.</li><li>You want some weeks in the home yourself.</li></ul></div><div class="sl-lease"><h3>A yearly lease fits when</h3><ul><li>The home is in a city neighborhood zoned against short stays.</li><li>It would book fewer nights than that break-even.</li><li>You want one move-in a year and the same rent every month.</li><li>You want no lodging tax and no cleaning to schedule.</li></ul></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Some costs do not change with the choice. Of the condos for sale in oceanfront buildings inside Myrtle Beach city limits that the listing marks for short-term rentals, 48 have two bedrooms, at a middle list price of about $325,000. A rental there pays about $5,000 a year in property tax either way, and the HOA fee and the loan are the same too.</p><div class="sl-story"><p>One friend of ours shows the top of the range. He ran a hotel in Boston, retired, and bought three condos in one oceanfront building. They gross about $120,000 a year, roughly half of it profit.</p><p>Those are his own numbers, and they are not a promise.</p></div></div></section><section style="background:var(--ivory)" id="is-it-allowed"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Is it allowed">Can you Airbnb a home in Myrtle Beach?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In an oceanfront condo building, almost always; in a house in a city neighborhood, usually not. Inside Myrtle Beach city limits, a stay under 90 days counts as short-term, and <a href="https://www.cityofmyrtlebeach.com/news_detail_T6_R1468.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">no zoning district that begins with R allows it</a> except RMV, the Residential Multifamily Visitor zone. Most traditional neighborhoods in the city are not zoned for short-term rentals.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The homes for sale show the same split:</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}@media (max-width:699px){main#main .c3-gchart.c3-gchart-list [role=row]{grid-template-columns:minmax(0,1fr) auto;column-gap:.8rem;align-items:start}main#main .c3-gchart.c3-gchart-list .b{display:none}main#main .c3-gchart.c3-gchart-list .dot{display:none}main#main .c3-gchart.c3-gchart-list .f{display:block}main#main .c3-gchart.c3-gchart-list [role=cell]{justify-content:flex-end}}</style><figure class="c3-gchart c3-gchart-compact c3-gchart-list"><div role="table" aria-label="Homes for sale that the listing marks as allowing short-term rentals"><span class="cap" aria-hidden="true">Homes for sale that the listing marks as allowing short-term rentals</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Homes for sale, how many</span><span role="columnheader">share marked</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Condos in oceanfront buildings, Myrtle Beach city</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">402 of 422 for sale</span></span><span role="cell"><span class="b" style="--f:0.953" aria-hidden="true"></span><span class="v">95%</span></span></div><div role="row"><span role="rowheader"><span class="n">Condos in oceanfront buildings, North Myrtle Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">209 of 226 for sale</span></span><span role="cell"><span class="b" style="--f:0.925" aria-hidden="true"></span><span class="v">92%</span></span></div><div role="row"><span role="rowheader"><span class="n">Houses, North Myrtle Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">112 of 258 for sale</span></span><span role="cell"><span class="b" style="--f:0.434" aria-hidden="true"></span><span class="v">43%</span></span></div><div role="row"><span role="rowheader"><span class="n">Houses, Myrtle Beach city limits</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">18 of 201 for sale</span></span><span role="cell"><span class="b" style="--f:0.09" aria-hidden="true"></span><span class="v">9%</span></span></div><div role="row"><span role="rowheader"><span class="n">Houses with a Conway address</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">34 of 675 for sale</span></span><span role="cell"><span class="b" style="--f:0.05" aria-hidden="true"></span><span class="v">5%</span></span></div><div role="row"><span role="rowheader"><span class="n">Houses in Carolina Forest</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">1 of 294 for sale</span></span><span role="cell"><span class="b" style="--f:0.003" aria-hidden="true"></span><span class="v">under 1%</span></span></div></div></div><figcaption>Our count of the homes for sale in our search, by what the listing agent entered. North Myrtle Beach and Conway are by the home's address.</figcaption></figure><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-10-d/invest-str-vs-ltr/myrtle-beach-oceanfront-towers-from-the-beach-1200w.webp" srcset="/images/2026-10-d/invest-str-vs-ltr/myrtle-beach-oceanfront-towers-from-the-beach-600w.webp 600w, /images/2026-10-d/invest-str-vs-ltr/myrtle-beach-oceanfront-towers-from-the-beach-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Tall oceanfront towers with rows of balconies behind the dune in Myrtle Beach, with more towers lined up along the beach into the distance under a blue sky" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: DiscoA340. License: CC BY-SA 4.0" title="License: CC BY-SA 4.0">Photo: DiscoA340</a></span></div><figcaption>Oceanfront towers along the beach in Myrtle Beach.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Every rental in the City of Myrtle Beach, short-term or long-term, needs a <a href="https://www.cityofmyrtlebeach.com/careers/business/business_faq.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">city business license</a>, and the fee is figured on the rent collected. The city also adopted a short-term rental conversion overlay, Ordinance 2024-69. Our page on <a href="/invest/str-rules/" style="color:var(--navy);text-decoration:underline">short-term rental rules</a> covers it, with the rules town by town.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A listing's mark is the listing agent's word, not the city's. Before you offer, we read the zoning for the address and the building's founding rules.</p></div></section><section style="background:var(--ivory-2)" id="break-even"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Nights to break even">How many nights does a Myrtle Beach Airbnb need to beat a lease?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About 82 booked nights, if the owner runs it. Each booked night of a Myrtle Beach two-bedroom at the average $252 keeps about $190 after Airbnb's fee, utilities, supplies and repairs. 82 nights is 22 percent of the year, or about 17 stays of 4.7 nights.</p><div class="sl-calc" role="group" aria-labelledby="slCalcT"><p class="t" id="slCalcT">Your own break-even</p><label for="slNight">Nightly rate, $<input id="slNight" type="number" min="0" step="1" value="252" inputmode="decimal" oninput="slCalc()"></label><label for="slRent">Monthly rent on a lease, $<input id="slRent" type="number" min="0" step="1" value="1504" inputmode="decimal" oninput="slCalc()"></label><label for="slNights">Nights booked a year<input id="slNights" type="number" min="0" step="1" value="82" inputmode="decimal" oninput="slCalc()"></label><div class="out" aria-live="polite"><div class="big"><span>Nights a year to match the lease</span><strong id="slBe">82</strong></div><div class="row"><span>Bookings, at 4.7 nights each</span><strong id="slBk">18</strong></div><div class="row"><span>Airbnb keeps a year</span><strong id="slA">$15,315</strong></div><div class="row"><span>Lease keeps a year</span><strong id="slL">$15,254</strong></div><p class="say" id="slSay">At 82 nights the two keep about the same.</p></div><p class="note">Self-run, before the loan, property tax and HOA fee, which are the same either way. Each night keeps the rate less Airbnb's fee and running costs; the Airbnb also pays for insurance and a permit. The lease keeps the rent for all but one month, less utilities.</p></div><script>function slCalc(){var g=function(i){var e=document.getElementById(i);var v=e?parseFloat(e.value):NaN;return isFinite(v)&&v>0?v:0};var m=function(x){return (x<0?"-$":"$")+Math.round(Math.abs(x)).toLocaleString("en-US")};var o=function(i,t){var e=document.getElementById(i);if(e)e.textContent=t};var r=g("slNight"),rent=g("slRent"),nt=Math.min(g("slNights"),365);var per=r*0.76;var lk=rent*11-1290;var ak=per*nt-390;o("slL",m(lk));o("slA",m(ak));if(!per){o("slBe","--");o("slBk","--");o("slSay","Enter a nightly rate.");return}var be=Math.ceil((lk+390)/per);o("slBe",be>365?"more than 365":String(Math.max(be,0)));o("slBk",be>365?"--":String(Math.ceil(Math.max(be,0)/4.7)));var d=ak-lk;o("slSay",Math.abs(d)<250?"At "+nt+" nights the two keep about the same.":d>0?"At "+nt+" nights the Airbnb keeps about "+m(d)+" more a year than the lease.":"At "+nt+" nights the lease keeps about "+m(-d)+" more a year than the Airbnb.")}document.addEventListener("DOMContentLoaded",slCalc);</script><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Many listings book less than that. More than half of Myrtle Beach Airbnbs were booked or blocked 90 days or fewer in the year. The middle listing fills about 34 percent of the nights it is open; the top quarter fill 56 percent or more.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What does a manager cost, and what is the work?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The average listing took about 19 bookings in the year: 19 check-outs, each a cleaning and a turnover, against one move-in on a yearly lease.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A full-service manager, who handles marketing, guest messages, accounting, taxes, maintenance and repairs, takes about 40 to 60 percent in what we have seen on the Grand Strand. A basic plan of marketing, guest messages and basic accounting costs about 12.6 to 17.5 percent. Either share comes out of every booking, so a managed Airbnb needs more nights to match the lease.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The worst short-term rental mistake our team sees is self-managing with the cheapest cleaner; theft and damage followed. Chapter3 does not manage rentals.</p></div></section><section style="background:var(--ivory)" id="month-by-month"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Month by month">Which months does a lease win in Myrtle Beach?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Winter. The average Myrtle Beach Airbnb keeps less than a lease from November through February and about the same in October. June, July and August bring in 47 percent of the year's income.</p><figure class="sl-mo"><p class="cap" id="slMoCap">What the average Myrtle Beach Airbnb keeps each month, against a two-bedroom lease</p><div class="sl-key" aria-hidden="true"><span><i></i>Airbnb keeps more</span><span><i class="lo"></i>Airbnb keeps less</span><span><i class="ln"></i>Lease, about $1,270 every month</span></div><div role="table" aria-labelledby="slMoCap"><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Month</span><span role="columnheader">Airbnb keeps</span></div></div><div role="rowgroup"><div role="row" class="lo"><span role="rowheader">Jan<span class="sr">uary</span></span><span role="cell"><span class="trk" aria-hidden="true"><span class="b" style="--f:0.197"></span><span class="ln" style="--l:0.302"></span></span><span class="sr">$830, less than the lease</span></span><span class="v" aria-hidden="true">$830</span></div><div role="row" class="lo"><span role="rowheader">Feb<span class="sr">ruary</span></span><span role="cell"><span class="trk" aria-hidden="true"><span class="b" style="--f:0.247"></span><span class="ln" style="--l:0.302"></span></span><span class="sr">$1,040, less than the lease</span></span><span class="v" aria-hidden="true">$1,040</span></div><div role="row"><span role="rowheader">Mar<span class="sr">ch</span></span><span role="cell"><span class="trk" aria-hidden="true"><span class="b" style="--f:0.373"></span><span class="ln" style="--l:0.302"></span></span><span class="sr">$1,570</span></span><span class="v" aria-hidden="true">$1,570</span></div><div role="row"><span role="rowheader">Apr<span class="sr">il</span></span><span role="cell"><span class="trk" aria-hidden="true"><span class="b" style="--f:0.411"></span><span class="ln" style="--l:0.302"></span></span><span class="sr">$1,730</span></span><span class="v" aria-hidden="true">$1,730</span></div><div role="row"><span role="rowheader">May<span class="sr"></span></span><span role="cell"><span class="trk" aria-hidden="true"><span class="b" style="--f:0.48"></span><span class="ln" style="--l:0.302"></span></span><span class="sr">$2,020</span></span><span class="v" aria-hidden="true">$2,020</span></div><div role="row"><span role="rowheader">Jun<span class="sr">e</span></span><span role="cell"><span class="trk" aria-hidden="true"><span class="b" style="--f:0.893"></span><span class="ln" style="--l:0.302"></span></span><span class="sr">$3,760</span></span><span class="v" aria-hidden="true">$3,760</span></div><div role="row"><span role="rowheader">Jul<span class="sr">y</span></span><span role="cell"><span class="trk" aria-hidden="true"><span class="b" style="--f:1"></span><span class="ln" style="--l:0.302"></span></span><span class="sr">$4,210</span></span><span class="v" aria-hidden="true">$4,210</span></div><div role="row"><span role="rowheader">Aug<span class="sr">ust</span></span><span role="cell"><span class="trk" aria-hidden="true"><span class="b" style="--f:0.646"></span><span class="ln" style="--l:0.302"></span></span><span class="sr">$2,720</span></span><span class="v" aria-hidden="true">$2,720</span></div><div role="row"><span role="rowheader">Sep<span class="sr">tember</span></span><span role="cell"><span class="trk" aria-hidden="true"><span class="b" style="--f:0.375"></span><span class="ln" style="--l:0.302"></span></span><span class="sr">$1,580</span></span><span class="v" aria-hidden="true">$1,580</span></div><div role="row"><span role="rowheader">Oct<span class="sr">ober</span></span><span role="cell"><span class="trk" aria-hidden="true"><span class="b" style="--f:0.316"></span><span class="ln" style="--l:0.302"></span></span><span class="sr">$1,330</span></span><span class="v" aria-hidden="true">$1,330</span></div><div role="row" class="lo"><span role="rowheader">Nov<span class="sr">ember</span></span><span role="cell"><span class="trk" aria-hidden="true"><span class="b" style="--f:0.238"></span><span class="ln" style="--l:0.302"></span></span><span class="sr">$1,000, less than the lease</span></span><span class="v" aria-hidden="true">$1,000</span></div><div role="row" class="lo"><span role="rowheader">Dec<span class="sr">ember</span></span><span role="cell"><span class="trk" aria-hidden="true"><span class="b" style="--f:0.233"></span><span class="ln" style="--l:0.302"></span></span><span class="sr">$980, less than the lease</span></span><span class="v" aria-hidden="true">$980</span></div></div></div><figcaption>Airbnb: AirROI's average income per active Myrtle Beach listing in each calendar month, all sizes, less running costs at AirROI's shares for an owner who runs it. Lease: a year's two-bedroom lease at HUD's standard rent, less utilities and one month empty, spread over 12 months.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Some owners fill the winter with one long stay, the snowbird rental. A stay by the same person for 90 continuous days is not taxed as lodging. Our page on <a href="/invest/mid-term-rentals/" style="color:var(--navy);text-decoration:underline">mid-term rentals</a> covers renting by the month.</p></div></section><section style="background:var(--ivory-2)" id="year-round"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Who rents all year">Who rents all year in Myrtle Beach?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">People who work here all year. Even in January, about four in five of Horry County's jobs are outside leisure and hospitality. The summer adds leisure and hospitality jobs on top of that base.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="Jobs in Horry County in 2026"><span class="cap" aria-hidden="true">Jobs in Horry County in 2026</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Jobs</span><span role="columnheader">Count</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Jobs outside leisure and hospitality, January</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">119,400</span></span></div><div role="row"><span role="rowheader"><span class="n">Leisure and hospitality jobs, January</span></span><span role="cell"><span class="b" style="--f:0.271" aria-hidden="true"></span><span class="v">32,300</span></span></div><div role="row"><span role="rowheader"><span class="n">Leisure and hospitality jobs, July</span></span><span role="cell"><span class="b" style="--f:0.382" aria-hidden="true"></span><span class="v">45,600</span></span></div></div></div><figcaption>U.S. Bureau of Labor Statistics, jobs by place of work, not seasonally adjusted. Recent months are preliminary.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Leases have empty months too. South Carolina's rental vacancy rate was 11 to 12 percent in each quarter of 2026 reported so far, give or take about 3 points. Our comparison allows one month a year empty, a little below that rate. Our <a href="/invest/rent-prices/" style="color:var(--navy);text-decoration:underline">rent prices page</a> gives rents by area.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Inland, the two come closer. In AirROI's Conway market, a small one with 106 listings, the middle three-bedroom, counting listings open only part of the year, keeps about $1,500 a year less than a lease, a smaller gap than on the coast.</p><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/buyers/no-hoa/conway-older-house-and-oak-1200w.webp" srcset="/images/buyers/no-hoa/conway-older-house-and-oak-600w.webp 600w, /images/buyers/no-hoa/conway-older-house-and-oak-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="An older white wood house with black shutters behind a large oak tree, with a paved driveway, a low brick planter and thick shrubs, on a shaded street in Conway" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/publicdomain/mark/1.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: Pubdog. License: Public domain" title="License: Public domain">Photo: Pubdog</a></span></div><figcaption>An older house with a driveway and a big oak, in the residential historic district of Conway.</figcaption></figure></div></div></section><section style="background:var(--ivory)" id="pros-and-cons"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Pros and cons">What are the pros and cons of an Airbnb and a long-term rental?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">An Airbnb trades work and slow winters for summer income. A lease trades the summer for the same rent every month.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">An Airbnb</h3><style>.c3-pc{display:grid;gap:1rem;max-width:960px;margin:1.2rem 0 1.6rem}@media (min-width:760px){.c3-pc{grid-template-columns:1fr 1fr;align-items:start}}.c3-pc>div{padding:1.1rem 1.2rem .6rem}.c3-pc h3{font-family:var(--sans);font-size:1.15rem;font-weight:600;color:var(--navy);margin:0 0 .8rem;display:flex;align-items:center;gap:.55rem}.c3-pc,.c3-pc ul{font-size:1em}.c3-pc ul{list-style:none;margin:0;padding:0}.c3-pc li{display:flex;gap:.7rem;align-items:flex-start;color:var(--muted);font-size:var(--read,1.0625rem);line-height:1.7;margin:0 0 .9rem}.c3-pc li svg{flex:none;margin-top:.3rem}.c3-pc .c3-pc-do{display:block;color:var(--navy);font-weight:500;margin-top:.2rem}</style><div class="c3-pc"><div style="background:var(--ivory-2);border-top:3px solid var(--brass)"><h3>Pros</h3><ul><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="11" fill="var(--brass)"/><path d="M6.2 11.4l3.1 3.1 6.5-6.7" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Summer pays: the average Myrtle Beach listing takes in about $6,800 in July.</span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="11" fill="var(--brass)"/><path d="M6.2 11.4l3.1 3.1 6.5-6.7" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>A home that books often keeps much more than a lease.</span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="11" fill="var(--brass)"/><path d="M6.2 11.4l3.1 3.1 6.5-6.7" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>You can use the home yourself in the weeks it is not booked.</span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="11" fill="var(--brass)"/><path d="M6.2 11.4l3.1 3.1 6.5-6.7" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>The guest pays the lodging taxes, on top of the price.</span></li></ul></div><div style="background:var(--ivory-2);border-top:3px solid var(--muted)"><h3>Cons</h3><ul><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="10" fill="none" stroke="var(--muted)" stroke-width="1.6"/><path d="M6.8 11h8.4" stroke="var(--muted)" stroke-width="2.2" stroke-linecap="round"/></svg><span>Four winter months keep less than a lease. <span class="c3-pc-do">Plan the year on the summer, or fill the winter with one stay of 90 days or more.</span></span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="10" fill="none" stroke="var(--muted)" stroke-width="1.6"/><path d="M6.8 11h8.4" stroke="var(--muted)" stroke-width="2.2" stroke-linecap="round"/></svg><span>About 19 check-outs a year, each a cleaning. <span class="c3-pc-do">Pay for a reliable cleaner, or a manager.</span></span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="10" fill="none" stroke="var(--muted)" stroke-width="1.6"/><path d="M6.8 11h8.4" stroke="var(--muted)" stroke-width="2.2" stroke-linecap="round"/></svg><span>Investor lenders count only about 75 percent of a short-term rental estimate, a loan officer at our preferred lender tells us. <span class="c3-pc-do">We run the numbers at 75 percent before you offer.</span></span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="10" fill="none" stroke="var(--muted)" stroke-width="1.6"/><path d="M6.8 11h8.4" stroke="var(--muted)" stroke-width="2.2" stroke-linecap="round"/></svg><span>Standard (Fannie Mae) loans are not made on a condo in a project that requires a rental pool, or offers hotel services such as a front desk or daily cleaning. <span class="c3-pc-do">We read the building's papers first. Our <a href="/invest/condotel-financing/" style="color:var(--navy);text-decoration:underline">condotel financing</a> page covers the other loans.</span></span></li></ul></div></div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">A long-term rental</h3><style>.c3-pc{display:grid;gap:1rem;max-width:960px;margin:1.2rem 0 1.6rem}@media (min-width:760px){.c3-pc{grid-template-columns:1fr 1fr;align-items:start}}.c3-pc>div{padding:1.1rem 1.2rem .6rem}.c3-pc h3{font-family:var(--sans);font-size:1.15rem;font-weight:600;color:var(--navy);margin:0 0 .8rem;display:flex;align-items:center;gap:.55rem}.c3-pc,.c3-pc ul{font-size:1em}.c3-pc ul{list-style:none;margin:0;padding:0}.c3-pc li{display:flex;gap:.7rem;align-items:flex-start;color:var(--muted);font-size:var(--read,1.0625rem);line-height:1.7;margin:0 0 .9rem}.c3-pc li svg{flex:none;margin-top:.3rem}.c3-pc .c3-pc-do{display:block;color:var(--navy);font-weight:500;margin-top:.2rem}</style><div class="c3-pc"><div style="background:var(--ivory-2);border-top:3px solid var(--brass)"><h3>Pros</h3><ul><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="11" fill="var(--brass)"/><path d="M6.2 11.4l3.1 3.1 6.5-6.7" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>One move-in a year, not 19 check-outs.</span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="11" fill="var(--brass)"/><path d="M6.2 11.4l3.1 3.1 6.5-6.7" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>The same rent every month, winter included.</span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="11" fill="var(--brass)"/><path d="M6.2 11.4l3.1 3.1 6.5-6.7" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>No lodging tax on a stay of 90 days or more.</span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="11" fill="var(--brass)"/><path d="M6.2 11.4l3.1 3.1 6.5-6.7" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Allowed in the city neighborhoods where nightly stays are not.</span></li></ul></div><div style="background:var(--ivory-2);border-top:3px solid var(--muted)"><h3>Cons</h3><ul><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="10" fill="none" stroke="var(--muted)" stroke-width="1.6"/><path d="M6.8 11h8.4" stroke="var(--muted)" stroke-width="2.2" stroke-linecap="round"/></svg><span>The rent is the same in July as in January, so a lease misses the summer. <span class="c3-pc-do">Price the home both ways before you choose.</span></span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="10" fill="none" stroke="var(--muted)" stroke-width="1.6"/><path d="M6.8 11h8.4" stroke="var(--muted)" stroke-width="2.2" stroke-linecap="round"/></svg><span>Each new tenant can mean an empty month. <span class="c3-pc-do">Our comparison counts one empty month a year.</span></span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="10" fill="none" stroke="var(--muted)" stroke-width="1.6"/><path d="M6.8 11h8.4" stroke="var(--muted)" stroke-width="2.2" stroke-linecap="round"/></svg><span>The home is the tenant's for the year, so you cannot use it yourself. <span class="c3-pc-do">If you want summer weeks in it, an Airbnb fits better.</span></span></li></ul></div></div></div></section><section style="background:var(--ivory-2)" id="what-we-do"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What we do">What does Chapter3 do before you choose?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We run one address both ways before you make an offer. Our <a href="/invest/long-term-rental/" style="color:var(--navy);text-decoration:underline">long-term rental analyzer</a> prices the lease, and our <a href="/invest/str-tools/" style="color:var(--navy);text-decoration:underline">short-term rental atlas</a> shows what Airbnbs around the building take in. We also read the building's founding rules and the zoning, and work out the property tax for that home.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For income across the whole market, our <a href="/invest/airbnb-income/" style="color:var(--navy);text-decoration:underline">Airbnb income report</a> has it town by town.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Send us one address</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We run the lease and the Airbnb side, read the building's rules, and send you both numbers before you write an offer, at no cost.</p><a class="btn btn-brass" href="/contact/">Get both numbers</a></div></div></section><section style="background:var(--ivory)" id="airbnb-vs-long-term-rental-questions"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Airbnb vs long-term rental questions</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is Airbnb or a long-term rental more profitable in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">An Airbnb earns more once it books often enough. Run by its owner, a Myrtle Beach two-bedroom Airbnb keeps more than a yearly lease once it books about 82 nights a year at the area's average two-bedroom rate. At the top-quarter mark, run all year, an Airbnb keeps about $12,000 a year more than a lease.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can you Airbnb a house in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not in most of the city's traditional neighborhoods. The City of Myrtle Beach allows stays under 90 days in no zoning district that begins with R, except RMV, the Residential Multifamily Visitor zone. We check the zoning on any address before you offer.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How many nights does a Myrtle Beach Airbnb need to book?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About 82 a year to match a yearly lease on a two-bedroom, run by its owner: roughly 17 stays at the average length of 4.7 nights.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do I pay lodging tax on a long-term lease?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No, not on a stay of 90 days or more. South Carolina charges a 7 percent state tax on a stay of under 90 days, plus local taxes. A tenant who stays 90 continuous days or more pays no lodging tax. Two exceptions to the tax: a home rented out 14 days or fewer in a year, and rooms in the owner's own home with fewer than six rented.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is a short-term or long-term rental easier to finance?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A short-term rental meets two limits. A loan officer at our preferred lender tells us investor lenders count only about 75 percent of an Airbnb estimate, and standard Fannie Mae loans are not made in a condo project with a required rental pool or hotel services.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does Chapter3 manage rentals?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. Chapter3 is a brokerage and does not manage rentals. We run the address both ways and read the building's rules before you offer.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.airroi.com/airbnb-data/united-states/south-carolina/myrtle-beach" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">AirROI, Myrtle Beach</a>, <a href="https://www.airroi.com/airbnb-data/united-states/south-carolina/conway" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">AirROI, Conway</a>, <a href="https://www.huduser.gov/portal/datasets/fmr/fmr2027/FY27_FMRs.xlsx" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">HUD Fair Market Rents</a>, <a href="https://www.census.gov/housing/hvs/data/rates/tab1_state05_2026_rvr.xlsx" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Census vacancy</a>, <a href="https://download.bls.gov/pub/time.series/sm/sm.data.42.SouthCarolina" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">BLS jobs</a>, <a href="https://www.scstatehouse.gov/code/t12c036.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">S.C. Code 12-36-920</a>, <a href="https://www.horrycountysc.gov/media/kufln4qp/tax-levy-2026_2.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County 2026 tax levy</a>, <a href="https://www.cityofmyrtlebeach.com/news_detail_T6_R1468.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">City zoning</a>, <a href="https://www.cityofmyrtlebeach.com/careers/business/business_faq.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">City business license</a>, <a href="https://www.airbnb.com/help/article/2328" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Airbnb taxes</a>, <a href="https://selling-guide.fanniemae.com/sel/b4-2.1-03/ineligible-projects" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Fannie Mae B4-2.1-03</a>. Airbnb: AirROI, 12 months to September 2026, owner-run; our arithmetic. Homes for sale: our count of active listings. Not legal or tax advice.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Tall oceanfront towers with rows of balconies behind the dune in Myrtle Beach, with more towers lined up along the beach into the distance under a blue sky. Photo: DiscoA340, <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a>, via <a href="https://commons.wikimedia.org/wiki/File:Hotels_along_the_Grand_Strand_Beachfront.jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>. Chapter3 Realty resized the photo and cut 1x1, 4x3 and 16x9 crops from its lower part.</div><div role="listitem">An older house with a driveway and a big oak, in the residential historic district of Conway. Photo: Pubdog, <a href="https://creativecommons.org/publicdomain/mark/1.0/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://commons.wikimedia.org/wiki/File:Conway_Residential_Historic_District_Jun_10.JPG" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>. Chapter3 Realty blurred the house number and resized the photo.</div><div role="listitem">Chapter3 Realty resized these photos and cropped some of them. Each photo keeps the license listed with it.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-10-d/invest-str-vs-ltr/myrtle-beach-oceanfront-towers-from-the-beach-1200w.webp","url":"https://chapter3realty.com/images/2026-10-d/invest-str-vs-ltr/myrtle-beach-oceanfront-towers-from-the-beach-1200w.webp","width":1200,"height":900,"encodingFormat":"image/webp","name":"Tall oceanfront towers with rows of balconies behind the dune in Myrtle Beach, with more towers lined up along the beach into the distance under a blue sky","caption":"Oceanfront towers along the beach in Myrtle Beach.","description":"Tall oceanfront towers with rows of balconies behind the dune in Myrtle Beach, with more towers lined up along the beach into the distance under a blue sky","creator":{"@type":"Person","name":"DiscoA340"},"creditText":"DiscoA340, CC BY-SA 4.0, via Wikimedia Commons","copyrightNotice":"© DiscoA340, CC BY-SA 4.0","license":"https://creativecommons.org/licenses/by-sa/4.0/","acquireLicensePage":"https://commons.wikimedia.org/wiki/File:Hotels_along_the_Grand_