diff --git a/data/2026-10-d/hoa-hoa-vs-poa/pull_fees.py b/data/2026-10-d/hoa-hoa-vs-poa/pull_fees.py
new file mode 100644
index 0000000..58afcd3
--- /dev/null
+++ b/data/2026-10-d/hoa-hoa-vs-poa/pull_fees.py
@@ -0,0 +1,44 @@
+"""Monthly association fee and what it pays for, by kind of home, from the CRM's public map API.
+Aggregate counts only: no address, MLS number, price or firm is kept.
+The API's hoaMax filter is the listing's association fee per month, as the site's filter labels it
+("Up to $X a month"). hoa=0 is "No HOA, as listed by the listing agent".
+Run: python3 -I pull_fees.py <outdir>. Writes <outdir>/fees-by-type.json."""
+import json, sys, time, urllib.request, urllib.parse, datetime
+out = sys.argv[1] if len(sys.argv) > 1 else "."
+BASE = "https://chapter3realty.com/homes/api/map?"
+TYPES = ["condo", "townhouse", "house"]
+STEPS = list(range(0, 500, 25)) + list(range(500, 1500, 50)) + [1500, 2000, 3000, 100000]
+HAS = ["hoa_includes_insurance", "lawn_care_included", "hoa_includes_water_sewer", "hoa_includes_trash",
+       "hoa_includes_internet", "hoa_includes_cable", "hoa_includes_pest", "hoa_includes_electric", "community_amenities", "gated"]
+def total(params):
+    params = dict(params, limit=1)
+    url = BASE + urllib.parse.urlencode(params)
+    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (research; chapter3realty.com)"})
+    for i in range(4):
+        try:
+            return json.load(urllib.request.urlopen(req, timeout=60)).get("total")
+        except Exception as e:
+            time.sleep(3)
+    return None
+res = {"pulled": datetime.datetime.utcnow().isoformat() + "Z", "source": BASE + "type=<type>&hoaMax=<n> | hoa=0 | has=<key>",
+       "status": "for sale (the API's default)", "types": {}}
+for t in TYPES:
+    r = {"total": total({"type": t}), "listed_no_hoa": total({"type": t, "hoa": "0"}), "cdf": {}, "has": {}}
+    for s in STEPS:
+        r["cdf"][s] = total({"type": t, "hoaMax": s}); time.sleep(0.2)
+    zero = r["cdf"][0]
+    r["fee_zero_or_blank"] = zero
+    r["with_fee"] = r["total"] - zero
+    half = zero + r["with_fee"] / 2
+    med = next((s for s in STEPS if r["cdf"][s] is not None and r["cdf"][s] >= half), None)
+    prev = max([s for s in STEPS if s < (med or 0)] or [0])
+    r["median_fee_band_among_with_fee"] = [prev, med]
+    for q in (0.25, 0.75):
+        k = zero + r["with_fee"] * q
+        hi = next((s for s in STEPS if r["cdf"][s] >= k), None)
+        r[f"p{int(q*100)}_band"] = [max([s for s in STEPS if s < hi] or [0]), hi]
+    for h in HAS:
+        r["has"][h] = total({"type": t, "has": h}); time.sleep(0.2)
+    res["types"][t] = r
+    print(t, r["total"], r["listed_no_hoa"], zero, r["with_fee"], r["median_fee_band_among_with_fee"], r["p25_band"], r["p75_band"], r["has"], flush=True)
+json.dump(res, open(f"{out}/fees-by-type.json", "w"), indent=1)
diff --git a/data/2026-10-d/hoa-hoa-vs-poa/pull_has_with_fee.py b/data/2026-10-d/hoa-hoa-vs-poa/pull_has_with_fee.py
new file mode 100644
index 0000000..0c3c9ee
--- /dev/null
+++ b/data/2026-10-d/hoa-hoa-vs-poa/pull_has_with_fee.py
@@ -0,0 +1,20 @@
+"""For houses and townhouses, the "what the fee pays for" counts with no-fee listings taken out:
+count(type, has=X) minus count(type, has=X, hoaMax=0). Same API as pull_fees.py. Counts only.
+Run: python3 -I pull_has_with_fee.py <this dir>. Writes has-with-fee.json."""
+import json, sys, time, urllib.request, urllib.parse, datetime
+d = sys.argv[1]
+HAS = ["hoa_includes_insurance", "lawn_care_included", "hoa_includes_water_sewer", "hoa_includes_trash", "hoa_includes_internet", "community_amenities", "gated"]
+def total(p):
+    url = "https://chapter3realty.com/homes/api/map?" + urllib.parse.urlencode(dict(p, limit=1))
+    for i in range(4):
+        try: return json.load(urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"}), timeout=60))["total"]
+        except Exception: time.sleep(3)
+out = {"pulled": datetime.datetime.utcnow().isoformat() + "Z", "types": {}}
+for t in ["condo", "townhouse", "house"]:
+    tot, zero = total({"type": t}), total({"type": t, "hoaMax": 0})
+    r = {"total": tot, "fee_zero_or_blank": zero, "with_fee": tot - zero, "has": {}}
+    for h in HAS:
+        a, z = total({"type": t, "has": h}), total({"type": t, "has": h, "hoaMax": 0})
+        r["has"][h] = {"all": a, "no_fee": z, "with_fee": a - z, "pct_of_with_fee": round(100 * (a - z) / (tot - zero), 1)}
+    out["types"][t] = r; print(t, tot, zero, {k: (v["with_fee"], v["pct_of_with_fee"]) for k, v in r["has"].items()}, flush=True)
+json.dump(out, open(f"{d}/has-with-fee.json", "w"), indent=1)
diff --git a/data/2026-10-d/hoa-hoa-vs-poa/pull_layer_rows.py b/data/2026-10-d/hoa-hoa-vs-poa/pull_layer_rows.py
new file mode 100644
index 0000000..cb85de2
--- /dev/null
+++ b/data/2026-10-d/hoa-hoa-vs-poa/pull_layer_rows.py
@@ -0,0 +1,44 @@
+"""Index rows (date, document type, parties, book/page, the index's description) for named associations, from the
+Horry County Register of Deeds (AcclaimWeb "Search by name"). A party that is not a business or association is
+written as "(person)". The county index is online; the document images are not (see raw/acclaim-no-images.txt).
+Usage: python3 -I pull_layer_rows.py <outdir>. Writes <outdir>/raw/layer-rows.json."""
+import sys, json, re, time, datetime, http.cookiejar, urllib.request, urllib.parse
+out = sys.argv[1] if len(sys.argv) > 1 else "."
+B = "https://acclaimweb.horrycounty.org/AcclaimWeb"
+cj = http.cookiejar.CookieJar()
+op = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cj))
+op.addheaders = [("User-Agent", "Mozilla/5.0 (research; chapter3realty.com)")]
+def post(url, data):
+    req = urllib.request.Request(url, data=urllib.parse.urlencode(data).encode()); req.add_header("X-Requested-With", "XMLHttpRequest")
+    for i in range(4):
+        try: return op.open(req, timeout=120).read().decode("utf-8", "replace")
+        except Exception: time.sleep(4)
+    return ""
+post(B + "/Search/Disclaimer?st=/AcclaimWeb/search/SearchTypeName", {"disclaimer": "true"})
+BIZ = re.compile(r"ASSOC|ASSN|REGIME|\bHPR\b|COUNCIL|CONDO|OWNERS|CLUB|COMMUNITY|MASTER|\bLLC\b|\bINC\b|COMPANY|\bCO\b|CORP|\bLP\b|PARTNERS|DEVELOPMENT|HOMES|GRANDE DUNES|COUNTY|CITY OF|BANK|TRUST", re.I)
+Q = [("GRANDE DUNES MASTER", ["GRANDE DUNES MASTER ASSOCIATION"]),
+     ("PRINCE CREEK MASTER", ["PRINCE CREEK MASTER COMMUNITY ASSOCIATION INC", "PRINCE CREEK MASTER COMMUNITY ASSOCIATION", "PRINCE CREEK MASTER COMMUNITY ASSOC INC"]),
+     ("PRINCE CREEK WEST ROAD", ["PRINCE CREEK WEST ROAD AND PARK DISTRICTS ASSOCIATION INC", "PRINCE CREEK WEST ROAD AND PARK DISTRICTS ASSOCIATION"]),
+     ("KINGSTON PLANTATION MASTER", ["KINGSTON PLANTATION MASTER ASSOCIATION", "KINGSTON PLANTATION MASTER ASSOCIATION INC", "KINGSTON PLANTATION MASTER ASSN"]),
+     ("WILD WING PLANTATION ROAD", ["WILD WING PLANTATION ROAD MAINTENANCE ASSOCIATION INC"]),
+     ("BAREFOOT RESORT RESIDENTIAL", ["BAREFOOT RESORT RESIDENTIAL OWNERS ASSOCIATION INC", "BAREFOOT RESORT RESIDENTIAL OWNERS ASSOCIATION"]),
+     ("BAREFOOT RESORT NONRESIDENTIAL", ["BAREFOOT RESORT NONRESIDENTIAL OWNERS ASSOCIATION INC"])]
+res = {"source": B + "/search/SearchTypeName", "doc_type": "RESTRICTIONS (082), value 170", "pulled": datetime.date.today().isoformat(), "queries": {}}
+for search, names in Q:
+    base = {"PartyType": "Both", "BookTypes": "1,2,3,4,5,6,7,8", "DocTypes": "170"}
+    rows, total = [], 0
+    for nm in names:  # one name per search; a list of names returns nothing
+        post(B + "/search/SearchTypeName?Length=6", dict(base, SearchOnName=search, RecordDateFrom="1/1/1960", RecordDateTo="11/1/2026", DateRangeList=""))
+        post(B + "/Search/SearchTypePreName", dict(base, NameList=nm, SearchOnName=search, RecordDateFrom="1/1/1960 12:00:00 AM",
+             RecordDateTo="11/1/2026 12:00:00 AM", SearchOnLastOrBusinessName="", SearchOnFirstName="", ShowAllNames="", ShowAllLegals=""))
+        g = json.loads(post(B + "/Search/GridResults", {"page": 1, "size": 1000}) or '{"Data":[]}')
+        total += g.get("Total") or 0
+        for r in g["Data"]:
+            cp = r.get("CrossPartyName") or ""
+            rows.append({"date": r["RecordDate"], "type": r["DocTypeDescription"], "name": r.get("Name"), "cross_party": cp if BIZ.search(cp) else "(person)",
+                         "book_page": r["BookPage"], "index_description": r.get("Comments")})
+        time.sleep(1)
+    rows.sort(key=lambda r: r["date"])
+    res["queries"][search] = {"names": names, "total": total, "rows": rows}
+    print(search, total, len(rows), flush=True)
+json.dump(res, open(f"{out}/raw/layer-rows.json", "w"), indent=1)
diff --git a/data/2026-10-d/hoa-hoa-vs-poa/pull_layers.py b/data/2026-10-d/hoa-hoa-vs-poa/pull_layers.py
new file mode 100644
index 0000000..c0b1fa7
--- /dev/null
+++ b/data/2026-10-d/hoa-hoa-vs-poa/pull_layers.py
@@ -0,0 +1,35 @@
+"""Which associations are recorded under one master-planned community's name, from the Horry County Register of
+Deeds name index (AcclaimWeb, "Search by name", the list of matching party names it shows before results).
+Only association names are kept (names with ASSOC, REGIME, HPR, HORIZONTAL, COUNCIL, CONDO, OWNERS, CLUB,
+COMMUNITY or MASTER). Person names are dropped. Doc types searched: RESTRICTIONS (082, value 170),
+MASTER DEED (022, value 213), ARTICLES OF ASSOCIATION (023, value 144), CONDO LIEN (064, value 189).
+Usage: python3 -I pull_layers.py <outdir>. Writes <outdir>/layers.json."""
+import sys, json, re, time, datetime, http.cookiejar, urllib.request, urllib.parse
+out = sys.argv[1] if len(sys.argv) > 1 else "."
+B = "https://acclaimweb.horrycounty.org/AcclaimWeb"
+cj = http.cookiejar.CookieJar()
+op = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cj))
+op.addheaders = [("User-Agent", "Mozilla/5.0 (research; chapter3realty.com)")]
+def post(url, data):
+    req = urllib.request.Request(url, data=urllib.parse.urlencode(data).encode())
+    req.add_header("X-Requested-With", "XMLHttpRequest")
+    for i in range(4):
+        try: return op.open(req, timeout=120).read().decode("utf-8", "replace")
+        except Exception as e: time.sleep(4)
+    return ""
+post(B + "/Search/Disclaimer?st=/AcclaimWeb/search/SearchTypeName", {"disclaimer": "true"})
+DOC = {"170": "RESTRICTIONS", "213": "MASTER DEED", "144": "ARTICLES OF ASSOCIATION", "189": "CONDO LIEN"}
+ASSOC = re.compile(r"ASSOC|REGIME|\bHPR\b|HORIZONTAL|COUNCIL|CONDO|OWNERS|CLUB|COMMUNITY|MASTER", re.I)
+PLACES = ["BAREFOOT RESORT", "GRANDE DUNES", "MARKET COMMON", "KINGSTON PLANTATION", "PRINCE CREEK", "WILD WING", "CAROLINA FOREST", "PAWLEYS PLANTATION", "LITCHFIELD"]
+res = {"source": B + "/search/SearchTypeName", "pulled": datetime.date.today().isoformat(), "doc_types": DOC, "places": {}}
+for place in PLACES:
+    r = {}
+    for code, name in DOC.items():
+        s = post(B + "/search/SearchTypeName?Length=6", {"SearchOnName": place, "PartyType": "Both", "BookTypes": "1,2,3,4,5,6,7,8",
+                 "DocTypes": code, "RecordDateFrom": "1/1/1960", "RecordDateTo": "11/1/2026", "DateRangeList": ""})
+        names = re.findall(r'"text":"([^"]+?) \((\d+)\)"', s)
+        r[name] = sorted({n: int(c) for n, c in names if ASSOC.search(n) and n != place}.items())
+        time.sleep(1)
+    res["places"][place] = r
+    print(place, {k: len(v) for k, v in r.items()}, flush=True)
+json.dump(res, open(f"{out}/layers.json", "w"), indent=1)
