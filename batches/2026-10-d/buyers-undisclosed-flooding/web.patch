+        <div class="newsImageCol">
+       
+            <div>  <img loading="lazy" src="/sites/scor/files/styles/full_content_news/public/Documents/Images/Photos%20on%20walls%20w%20logo%202_NEWS%20ARTICLE%20HEADER_11.jpg?itok=R5onH8zL" width="930" height="320" alt="Photo of pictures of houses hung on walls of an office" typeof="foaf:Image" />
