new file mode 100644
index 0000000..8eab79c
--- /dev/null
+++ b/data/2026-10-d/buyers-undisclosed-flooding/fetch_county.py
@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+"""Horry County GIS layers for the flood-history page. Run: python3 -I fetch_county.py
+Writes raw/:
+  sfz.json          HazardsMap layer 17, Regulated Supplemental Flood Zone (Hurricane Florence flood extent, WCU), WGS84
+  flood-sfha.json   parcelapp layer 19, FEMA flood zones with SFHA_TF = 'T' (high-risk), WGS84
+  addresses-points.json every address point (layer 22): PIN and point only (no street names kept)
+  res-parcels.json  layer 24 residential parcels with a building: PIN, LandUseCode, PARCELTYPE, SaleDate (no owner fields)
+  county.json       layer 33 county boundary, WGS84
+The server refuses spatial queries with the large SFZ polygons, so the point-in-polygon tests run locally (analyze_gis.py)."""
+import sys, json, os, time, urllib.request, urllib.parse
+HERE = os.path.dirname(os.path.abspath(__file__)); RAW = os.environ.get('RAW', os.path.join(HERE, 'raw'))  # big raw files live outside the repo; set RAW to a scratch folder
+HZ = "https://www.horrycounty.org/gisweb/rest/services/Public/HazardsMap/MapServer/%d/query"
+PA = "https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer/%d/query"
+def q(url, params):
+    data = urllib.parse.urlencode(dict(params, f="json")).encode()
+    for i in range(6):
+        try:
+            d = json.loads(urllib.request.urlopen(urllib.request.Request(url, data=data), timeout=300).read())
+            if "error" in d: raise Exception(d["error"])
+            return d
+        except Exception as e:
+            print("retry", url, e, file=sys.stderr); time.sleep(5)
+    raise SystemExit("failed")
+def save(name, obj): json.dump(obj, open(os.path.join(RAW, name), "w"))
+def have(name): return os.path.exists(os.path.join(RAW, name))
+if not have("sfz.json"):
+    feats = []
+    for oid in range(1, 42):
+        d = q(HZ % 17, {"objectIds": oid, "outFields": "*", "returnGeometry": "true", "outSR": "4326", "maxAllowableOffset": "0.00002"})
+        feats += d["features"]; print("sfz", oid, flush=True)
+    save("sfz.json", feats)
+if not have("flood-sfha.json"):
+    ids = q(PA % 19, {"where": "SFHA_TF='T'", "returnIdsOnly": "true"})["objectIds"]
+    feats = []
+    for i in range(0, len(ids), 50):
+        feats += q(PA % 19, {"objectIds": ",".join(map(str, ids[i:i+50])), "outFields": "FLD_ZONE,SFHA_TF,STATIC_BFE", "returnGeometry": "true", "outSR": "4326", "maxAllowableOffset": "0.00002"})["features"]
+        print("sfha", i, len(feats), flush=True)
+    save("flood-sfha.json", feats)
+def page_all(url, where, fields, geom, name):
+    ids = sorted(q(url, {"where": where, "returnIdsOnly": "true"})["objectIds"])
+    rows = []
+    for i in range(0, len(ids), 2000):
+        d = q(url, {"where": "OBJECTID >= %d AND OBJECTID <= %d AND (%s)" % (ids[i], ids[min(i + 1999, len(ids) - 1)], where),
+                    "outFields": fields, "returnGeometry": "true" if geom else "false", "outSR": "4326"})
+        for x in d["features"]:
+            r = x["attributes"]
+            if geom:
+                g = x.get("geometry") or {}
+                try: r["x"] = round(float(g["x"]), 6); r["y"] = round(float(g["y"]), 6)
+                except Exception: r["x"] = r["y"] = None
+            rows.append(r)
+        if i % 20000 == 0: print(name, i, len(rows), flush=True)
+    return rows
+if not have("addresses-points.json"):
+    # Every address point: PIN and point only. No street names are kept.
+    save("addresses-points.json", page_all(PA % 22, "1=1", "PIN", True, "addr"))
+if not have("res-parcels.json"):
+    # Residential parcels with a building (LandUseCode 1xx, MarketImprv > 0): PIN, use code, last sale date. No owner fields.
+    save("res-parcels.json", page_all(PA % 24, "LandUseCode LIKE '1%' AND MarketImprv > 0", "PIN,LandUseCode,PARCELTYPE,SaleDate", False, "parcels"))
+if not have("county.json"):
+    save("county.json", q(PA % 33, {"where": "1=1", "outFields": "*", "returnGeometry": "true", "outSR": "4326", "maxAllowableOffset": "0.0002"})["features"])
diff --git a/data/2026-10-d/buyers-undisclosed-flooding/fetch_fema.py b/data/2026-10-d/buyers-undisclosed-flooding/fetch_fema.py
new file mode 100644
index 0000000..6e3ae3d
--- /dev/null
+++ b/data/2026-10-d/buyers-undisclosed-flooding/fetch_fema.py
@@ -0,0 +1,39 @@
+#!/usr/bin/env python3
+"""Pull Horry County (FIPS 45051) rows from OpenFEMA. Run: python3 -I fetch_fema.py
+Writes raw/nfip-claims-horry.json, raw/nfip-multiple-loss-horry.json, raw/hma-sites-horry.json (+ metadata).
+'python3 -I fetch_fema.py small' also writes raw/hma-subapps-horry.json (HMA subapplications benefiting Horry),
+raw/nfip-penetration-horry.json (residential NFIP take-up, Horry and Georgetown) and raw/nfip-claims-fields.json (data dictionary)."""
+import json, os, sys, time, urllib.parse, urllib.request
+HERE = os.path.dirname(os.path.abspath(__file__))
+RAW = os.environ.get('RAW', os.path.join(HERE, 'raw'))  # big raw files live outside the repo; set RAW to a scratch folder
+BASE = 'https://www.fema.gov/api/open'
+
+def pull(path, flt, out, key):
+    rows, skip = [], 0
+    meta = None
+    while True:
+        q = urllib.parse.urlencode({'$filter': flt, '$top': 10000, '$skip': skip, '$inlinecount': 'allpages'}, quote_via=urllib.parse.quote)
+        url = f'{BASE}/{path}?{q}'
+        for i in range(4):
+            try:
+                with urllib.request.urlopen(urllib.request.Request(url, headers={'User-Agent': 'chapter3-research'}), timeout=180) as r:
+                    d = json.load(r); break
+            except Exception as e:
+                print('retry', e, file=sys.stderr); time.sleep(5)
+        meta = d['metadata']; batch = d[key]
+        rows += batch; skip += len(batch)
+        print(path, skip, '/', meta.get('count'), file=sys.stderr)
+        if not batch or skip >= meta.get('count', 0): break
+    json.dump({'source': f'{BASE}/{path}', 'filter': flt, 'pulled': meta['rundate'], 'count': meta.get('count'), 'rows': rows}, open(os.path.join(RAW, out), 'w'))
+
+if __name__ == '__main__':
+    if 'claims' in sys.argv[1:] or len(sys.argv)==1: pull('v3/NfipClaims', "countyCode eq '45051'", 'nfip-claims-horry.json', 'NfipClaims')
+    if len(sys.argv)==1 or 'other' in sys.argv[1:]: pull('v1/NfipMultipleLossProperties', "fipsCountyCode eq '45051'", 'nfip-multiple-loss-horry.json', 'NfipMultipleLossProperties')
+    if len(sys.argv)==1 or 'other' in sys.argv[1:]: pull('v1/HmaSubapplicationsProjectSiteInventories', "stateAbbreviation eq 'SC' and county eq 'Horry'", 'hma-sites-horry.json', 'HmaSubapplicationsProjectSiteInventories')
+    if 'small' in sys.argv[1:]:
+        for path, q, out in [('v2/HmaSubapplications', {'$filter': "subapplicantStateAbbreviation eq 'SC' and substringof('Horry',benefitingCounties)", '$top': 1000}, 'hma-subapps-horry.json'),
+                             ('v1/NfipResidentialPenetrationRates', {'$filter': "fipsCode eq '45051' or fipsCode eq '45043'"}, 'nfip-penetration-horry.json'),
+                             ('v1/OpenFemaDataSetFields', {'$filter': "openFemaDataSet eq 'NfipClaims' and datasetVersion eq 3", '$top': 200}, 'nfip-claims-fields.json')]:
+            url = f'{BASE}/{path}?' + urllib.parse.urlencode(q, quote_via=urllib.parse.quote)
+            open(os.path.join(RAW, out), 'wb').write(urllib.request.urlopen(urllib.request.Request(url, headers={'User-Agent': 'chapter3-research'}), timeout=180).read())
+            print(out, file=sys.stderr)
diff --git a/data/2026-10-d/buyers-undisclosed-flooding/fetch_tracts.py b/data/2026-10-d/buyers-undisclosed-flooding/fetch_tracts.py
new file mode 100644
index 0000000..110b40f
--- /dev/null
+++ b/data/2026-10-d/buyers-undisclosed-flooding/fetch_tracts.py
@@ -0,0 +1,13 @@
+#!/usr/bin/env python3
+"""Census tract outlines for Horry County from TIGERweb: current (2020) tracts and 2010 tracts.
+The NFIP claims file mixes both vintages in censusGeoid. Run: python3 -I fetch_tracts.py
+Writes raw/tracts-horry.json (2020) and raw/tracts-horry-2010.json (GEOID, NAME, geometry WGS84)."""
+import json, os, urllib.request, urllib.parse
+HERE = os.path.dirname(os.path.abspath(__file__))
+P = urllib.parse.urlencode(
+    {"where": "STATE='45' AND COUNTY='051'", "outFields": "GEOID,NAME,BASENAME,AREALAND", "returnGeometry": "true", "outSR": "4326", "maxAllowableOffset": "0.0005", "f": "json"})
+for url, name in [("https://tigerweb.geo.census.gov/arcgis/rest/services/TIGERweb/Tracts_Blocks/MapServer/0/query?", "tracts-horry.json"),
+                  ("https://tigerweb.geo.census.gov/arcgis/rest/services/TIGERweb/tigerWMS_Census2010/MapServer/14/query?", "tracts-horry-2010.json")]:
+    d = json.load(urllib.request.urlopen(url + P, timeout=300))
+    json.dump(d["features"], open(os.path.join(HERE, "raw", name), "w"))
+    print(name, len(d["features"]))
