trong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:820px}</style><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-10-d/sell-out-of-state-buyers/north-myrtle-beach-oceanfront-condo-towers-2011-1200w.webp" srcset="/images/2026-10-d/sell-out-of-state-buyers/north-myrtle-beach-oceanfront-condo-towers-2011-600w.webp 600w, /images/2026-10-d/sell-out-of-state-buyers/north-myrtle-beach-oceanfront-condo-towers-2011-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="782" alt="Three tall oceanfront condo towers with pools behind the dunes in North Myrtle Beach, seen from a plane over the ocean, with houses and a water tower behind them" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: U.S. Geological Survey. License: Public domain" title="License: Public domain">Photo: U.S. Geological Survey</a></span></div><figcaption>Oceanfront condo towers in North Myrtle Beach, where more than half of buyers are from another state.</figcaption></figure></div></div></section><section style="background:var(--ivory)" id="selling-from-out-of-state-questions"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Selling from out of state: questions</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is anything held back if I sell at a loss?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not if you sign Form I‑295. The hold-back is figured on your gain, and a home sold for less than it cost you has no gain. Without the form, it is figured on the whole price.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does the notary have to be from South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. A notary in the state where you live can notarize the deed, and the act counts the same as a South Carolina notary's. The notary writes in their state and the date their commission ends.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do I pay unpaid HOA dues at closing?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Usually, yes. Unpaid dues are put as a lien on the home and taken out of the seller's money at closing. Our agents check for them before closing, so they do not surprise you.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is fall a bad time to sell to out-of-state buyers?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. More buyers from other states closed in October than in any other month. Even in January, the slowest month, about 1 in 4 buyers came from another state.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeDocType" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Deeds</a>, <a href="https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer/24" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Parcels</a>, <a href="https://www.sccourts.org/media/opinions/HTMLFiles/SC/25508.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Doe v. McMaster</a>, <a href="https://www.scstatehouse.gov/code/t30c005.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 30-5</a>, <a href="https://www.scstatehouse.gov/code/t26c003.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">26-3</a>, <a href="https://www.scstatehouse.gov/code/t26c006.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">26-6</a>, <a href="https://www.scstatehouse.gov/code/t62c008.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">62-8</a>, <a href="https://www.scstatehouse.gov/code/t12c008.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">12-8-580</a>, <a href="https://www.scstatehouse.gov/code/t12c024.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">12-24</a>, <a href="https://www.scstatehouse.gov/code/t27c050.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">27-50</a>, <a href="https://www.scstatehouse.gov/code/t37c010.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">37-10-102</a>, <a href="https://www.scstatehouse.gov/code/t40c057.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">40-57-350</a>, <a href="https://www.scstatehouse.gov/code/t26c001.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">26-1-5</a>, <a href="https://www.scbar.org/for-lawyers/quicklinks/legal-resources/ethics-advisory-opinions/ethics-advisory-opinion-05-16/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Bar 05-16</a>, <a href="https://www.scbar.org/for-lawyers/quicklinks/legal-resources/ethics-advisory-opinions/ethics-advisory-opinion-06-11/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">06-11</a>, <a href="https://www.scbar.org/for-lawyers/quicklinks/legal-resources/ethics-advisory-opinions/ethics-advisory-opinion-00-17/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">00-17</a>, <a href="https://dor.sc.gov/news/information-about-h-4216" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC tax rate</a>, <a href="https://dor.sc.gov/sites/dor/files/forms/I295.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Form I-295</a>, <a href="https://dor.sc.gov/sites/dor/files/forms/I290.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Form I-290</a>, <a href="https://www.horrycountysc.gov/media/404mgbzc/prereqs.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry deeds office</a>, <a href="https://www.irs.gov/taxtopics/tc701" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">IRS 701</a>, <a href="https://www.irs.gov/taxtopics/tc409" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">IRS 409</a>, <a href="https://www.irs.gov/individuals/international-taxpayers/firpta-withholding" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">IRS FIRPTA</a>, <a href="https://www.consumerfinance.gov/about-us/blog/mortgage-closing-scams-how-protect-yourself-and-your-closing-funds/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">CFPB</a>. Buyers: a year of county sales matched to tax-bill addresses. Not legal or tax advice.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Oceanfront condo towers in North Myrtle Beach, where more than half of buyers are from another state. Photo: U.S. Geological Survey, <a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://doi.org/10.5066/F7N877XX" target="_blank" rel="noopener noreferrer">U.S. Geological Survey</a>. Chapter3 Realty resized the photo and cut 1x1, 4x3 and 16x9 crops from its center for the page's share image.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-10-d/sell-out-of-state-buyers/north-myrtle-beach-oceanfront-condo-towers-2011-1200w.webp","url":"https://chapter3realty.com/images/2026-10-d/sell-out-of-state-buyers/north-myrtle-beach-oceanfront-condo-towers-2011-1200w.webp","width":1200,"height":782,"encodingFormat":"image/webp","name":"Oceanfront condo towers in North Myrtle Beach, where more than half of buyers are from another state","caption":"Oceanfront condo towers in North Myrtle Beach, where more than half of buyers are from another state.","description":"Three tall oceanfront condo towers with pools behind the dunes in North Myrtle Beach, seen from a plane over the ocean, with houses and a water tower behind them","creator":{"@type":"Organization","name":"U.S. Geological Survey"},"creditText":"U.S. Geological Survey","copyrightNotice":"Public domain (U.S. Geological Survey)","license":"https://www.usa.gov/publicdomain/label/1.0/","acquireLicensePage":"https://doi.org/10.5066/F7N877XX","isBasedOn":"https://doi.org/10.5066/F7N877XX","contentLocation":{"@type":"Place","name":"oceanfront, between Windy Hill and Crescent Beach, North Myrtle Beach, South Carolina"},"representativeOfPage":true}]}</script></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Get a price and a plan for your home</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">Tell us the address and where you live. We send what similar homes sold for and how the sale would close from your state.</p><a class="btn btn-brass btn-lg" href="/contact/">Send me a price and plan</a></div></section></main>
