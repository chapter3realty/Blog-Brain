inear-gradient(180deg,#fff,rgba(232,201,154,.35))}main#main .c3-offer a.c3-offer-pill:focus-visible{outline:3px solid var(--navy);outline-offset:3px}main#main .c3-offer-ar{flex:none;display:inline-flex;width:2rem;height:2rem;border-radius:50%;align-items:center;justify-content:center;background:linear-gradient(180deg,#d4894a,#c4783a);color:#fff;box-shadow:inset 0 1px 0 rgba(255,255,255,.4)}@media (prefers-reduced-motion:reduce){main#main .c3-offer a.c3-offer-pill{transition:none}}.c3-gchart{margin:1.6rem 0 2rem;max-width:820px;padding:1.2rem 1.25rem 1rem;box-sizing:border-box}.c3-gchart [role=table]{display:block;width:100%}.c3-gchart .cap{display:block;color:var(--navy);font-weight:600;font-size:1.1em;line-height:1.35;margin:0 0 1rem}.c3-gchart .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.c3-gchart [role=rowgroup]{display:grid;gap:1rem}.c3-gchart [role=row]{display:grid;grid-template-columns:minmax(0,1fr);gap:.4rem;align-items:center}@media (min-width:700px){.c3-gchart [role=row]{grid-template-columns:minmax(0,22rem) minmax(0,1fr);column-gap:1.4rem}}.c3-gchart [role=rowheader]{display:block;color:var(--muted);font-size:var(--read,1.0625rem);line-height:1.4}.c3-gchart .n,.c3-gchart .n a{color:var(--navy);font-weight:600}.c3-gchart .n a{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.18em}.c3-gchart .dot{color:var(--g-ink,#8a5226);padding:0 .35rem}.c3-gchart [role=cell]{display:flex;align-items:center;gap:.6rem;min-width:0}.c3-gchart .b{flex:none;height:.85rem;min-width:.85rem;width:calc((100% - 7rem) * var(--f));border-radius:999px;background:linear-gradient(90deg,#c4783a,#d4894a);box-shadow:inset 0 1px 0 rgba(255,255,255,.35)}.c3-gchart .ref .b{background:#5c6b78}.c3-gchart .v{color:var(--navy);font-weight:600;font-size:var(--read,1.0625rem);font-variant-numeric:tabular-nums;white-space:nowrap}.c3-gchart .ref .n{font-weight:500}.c3-gchart figcaption{color:var(--muted);font-size:.95rem;line-height:1.55;margin:1.1rem 0 0;padding:0}@media (max-width:699px){.c3-gchart{padding:1rem .95rem .9rem}.c3-gchart .b{width:calc((100% - 6.2rem) * var(--f))}}</style><style>main#main>section[style^="background:var(--navy)"]:not(:has(~section))>.wrap{background:linear-gradient(160deg,rgba(42,48,64,.95),rgba(28,32,40,.97))!important;border:1px solid rgba(255,255,255,.14)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.14),0 26px 60px -30px rgba(28,32,40,.6)!important;display:block!important;text-align:center!important;padding:2.2rem 1.6rem!important;margin-left:auto!important;margin-right:auto!important;border-radius:28px!important}main#main>section[style^="background:var(--navy)"]:not(:has(~section))>.wrap>h2{color:var(--ivory)!important}main#main>section[style^="background:var(--navy)"]:not(:has(~section))>.wrap>p{color:rgba(244,239,232,.86)!important}@media (max-width:699px){main#main>section[style^="background:var(--navy)"]:not(:has(~section))>.wrap{padding:1.6rem 1.2rem 1.7rem!important;border-radius:24px!important}}main#main .hx-fb-ai,main#main .hx-fb-q{min-width:0!important;max-width:100%!important}main#main .hx-fb-q textarea{min-width:0;max-width:100%}@media (min-width:1000px) and (max-width:1120px){header .hdr-phone-num{display:none}}main#main h1.detail-h1{text-wrap:balance}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. About 1 in 4 homes in Horry County has its tax bill mailed outside South Carolina. Each step below says where you are for it.</p><style>main#main .c3-steps{list-style:none;counter-reset:s;margin:1.2rem 0 1.4rem;padding:0;max-width:760px;display:grid;gap:.7rem}main#main .c3-steps>li{counter-increment:s;position:relative;margin:0;padding:.95rem 1.1rem .9rem 3.6rem;border-radius:16px;background:linear-gradient(180deg,rgba(255,255,255,.76),rgba(255,255,255,.52));border:1px solid rgba(255,255,255,.8);box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 10px 26px -20px rgba(28,32,40,.35);color:var(--muted);line-height:1.65;font-size:var(--read,1.0625rem)}main#main .c3-steps>li::before{content:counter(s);position:absolute;left:1rem;top:.95rem;width:1.9rem;height:1.9rem;border-radius:50%;background:linear-gradient(135deg,#c4783a,#d4894a);color:#fff;font-weight:700;font-size:1rem;display:flex;align-items:center;justify-content:center;font-family:var(--sans)}main#main .c3-steps strong{display:flex;gap:.5rem;align-items:flex-start;color:var(--navy);font-weight:600;margin-bottom:.2rem}main#main .c3-steps strong svg{flex:none;color:#91592b;margin-top:.15rem}main#main .c3-steps .who{display:inline-block;margin-top:.35rem;font-size:.9rem;color:#8a5226;font-weight:600}@media (max-width:699px){main#main .c3-steps>li{padding:.85rem .9rem .85rem 3.2rem}main#main .c3-steps>li::before{left:.8rem;top:.85rem;width:1.75rem;height:1.75rem}}</style><ol class="c3-steps"><li><strong><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg><span>We price the home and show it to buyers.</span></strong>Our agent prices it to what sold near it and shows it to buyers and their agents.<br><span class="who">Where you are: at home</span></li><li><strong><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 20h4L19 9l-4-4L4 16zM13.5 6.5l4 4M14 20h6"/></svg><span>You sign the offer and the contract from home.</span></strong>You sign them by e-signature on your phone or computer. In South Carolina that counts the same as ink.<br><span class="who">Where you are: at home</span></li><li><strong><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg><span>The buyer's inspector and appraiser visit the home.</span></strong>They work for the buyer. Someone with a key lets them in, and you choose that person. See <a href="#key" style="color:var(--navy);text-decoration:underline">who holds the key</a>. Low appraisals are rare here. When one comes in low, one of our agents sends recent sales nearby with a request to reconsider the value.<br><span class="who">Where you are: at home</span></li><li><strong><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v16M8 20h8M5 7h14M7 7l-3 6.5a3 3 0 0 0 6 0zM17 7l-3 6.5a3 3 0 0 0 6 0z"/><circle cx="12" cy="4" r="1"/></svg><span>A South Carolina attorney supervises the closing.</span></strong>Only a lawyer may prepare a deed for someone else, so a lawyer here draws up yours. The contract can name the attorney and who pays. See <a href="#attorney" style="color:var(--navy);text-decoration:underline">who picks the attorney</a>.<br><span class="who">Where you are: at home</span></li><li><strong><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9.5 3.5h5l-.8 6h3.8a2 2 0 0 1 2 2V14h-15v-2.5a2 2 0 0 1 2-2h3.8zM4.5 17.5h15M7 20.5h10"/></svg><span>You sign the deed where you live.</span></strong>The closing attorney's office sends you the deed. You sign it before a notary near you and send it back. See <a href="#papers" style="color:var(--navy);text-decoration:underline">how the papers travel</a>.<br><span class="who">Where you are: a notary near you</span></li><li><strong><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6.5 3h8l4 4v14h-12zM14.5 3v4h4M9.5 12h6M9.5 15.5h6"/></svg><span>The deed is recorded in Horry County.</span></strong>The recording date starts the 90-day count for any guest stays you have booked. The guest bookings section below gives each date.<br><span class="who">Where you are: at home</span></li></ol><h3 id="papers" data-toc="how the papers travel" style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How the deed gets to you and back</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The closing attorney's office sends you the deed and the other closing papers. You sign them before a notary where you live and send them back to that office.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The South Carolina Bar's ethics committee calls this a closing by mail. No law requires you to attend the closing. For the attorney's own client, the attorney must review every paper and answer questions by phone, fax or email.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Send the signed papers back with a carrier that tracks the package. The office then records the deed in Horry County.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Who must be there when you sign the deed</h3><style>main#main .c3-sign{max-width:760px;margin:1rem 0 1.4rem;padding:1rem;border-radius:18px;background:linear-gradient(180deg,rgba(255,255,255,.76),rgba(255,255,255,.52));border:1px solid rgba(255,255,255,.8);box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 10px 26px -20px rgba(28,32,40,.35)}main#main .c3-sign ol{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.6rem}main#main .c3-sign li{margin:0;padding:.9rem .8rem;border-radius:14px;background:rgba(255,255,255,.7);text-align:center;color:var(--muted);font-size:.95rem;line-height:1.5}main#main .c3-sign .face{display:flex;width:3.4rem;height:3.4rem;margin:0 auto .5rem;border-radius:50%;align-items:center;justify-content:center;color:#91592b;background:rgba(196,120,58,.12)}main#main .c3-sign li.you .face{color:#fff;background:linear-gradient(135deg,#c4783a,#d4894a)}main#main .c3-sign strong{display:block;color:var(--navy);font-weight:600;font-size:1rem;margin-bottom:.2rem}main#main .c3-sign figcaption{margin-top:.75rem;color:var(--navy);font-size:.95rem;line-height:1.5;text-align:center}@media (max-width:599px){main#main .c3-sign ol{grid-template-columns:1fr}main#main .c3-sign li{display:grid;grid-template-columns:3.4rem 1fr;gap:.2rem .8rem;text-align:left;align-items:center}main#main .c3-sign .face{grid-row:span 2;margin:0}}</style><figure class="c3-sign" aria-label="Who must be in the room when you sign the deed"><ol><li class="you"><span class="face"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4.5 21v-.8A6.2 6.2 0 0 1 10.7 14h2.6a6.2 6.2 0 0 1 6.2 6.2v.8"/><circle cx="12" cy="7.5" r="3.8"/></svg></span><strong>You</strong><span>Sign the deed, and Form I‑295 if you use it.</span></li><li><span class="face"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4.5 21v-.8A6.2 6.2 0 0 1 10.7 14h2.6a6.2 6.2 0 0 1 6.2 6.2v.8"/><circle cx="12" cy="7.5" r="3.8"/></svg></span><strong>The notary</strong><span>Watches you sign and stamps the deed. Can also sign as your first witness.</span></li><li><span class="face"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4.5 21v-.8A6.2 6.2 0 0 1 10.7 14h2.6a6.2 6.2 0 0 1 6.2 6.2v.8"/><circle cx="12" cy="7.5" r="3.8"/></svg></span><strong>One more adult</strong><span>Signs as your second witness. Bring someone who is not on the deed.</span></li></ol><figcaption>The notary and both witnesses watch you sign. The notary may be one of the two witnesses.</figcaption></figure><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can you use an online notary from your state?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Do not plan on it. South Carolina law defines appearing before a notary as being in each other's <a href="https://www.scstatehouse.gov/code/t26c001.php" style="color:var(--navy);text-decoration:underline">physical presence</a>. The state has no video notarization of its own, so sign in person.</p><h3 id="attorney" data-toc="who picks the attorney" style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Who picks and pays the closing attorney</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The sales contract can name the closing attorney and say who pays the attorney's fees. You and the buyer agree on both. When the buyer has a home loan, the lender must ask the buyer which attorney to use and follow that choice.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">That attorney works for the buyer. An attorney who works for one side should not advise the other side, except to get a lawyer. For advice of your own, hire your own South Carolina attorney. We work with plenty of attorneys here and can recommend some.</p><h3 id="key" data-toc="who holds the key" style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Who holds the key</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You decide. Someone must let in the buyer's inspector and appraiser and the agents who show the home. Name that person in your listing agreement with us. South Carolina law requires our agent to carry out the terms of that agreement.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">If you would rather someone sign for you</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You can name a person you trust to sign for you, with a power of attorney. One made under South Carolina law is witnessed and notarized, and one made under your own state's law can also be valid. Recording it in Horry County costs $25.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">A closing plan for your state</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us where you live, where the home is and who has a key. We send the steps for signing from your state and what similar homes near yours sold for.</p><a class="btn btn-brass" href="/contact/">Send me a closing plan</a></div></div></section><section style="background:var(--ivory)" id="agent"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What our agent does">What does our agent do once your home is listed?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Once you sign the listing agreement, South Carolina law lists what a seller's agent must do. Our agent must:</p><ul style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem">carry out the terms of the listing agreement;</li><li style="margin-bottom:.5rem">seek a sale at your price and terms, or at a price and terms you accept;</li><li style="margin-bottom:.5rem">bring you every written offer and counteroffer promptly, even after you are under contract;</li><li style="margin-bottom:.5rem">tell you every material problem with the sale that the agent knows about;</li><li style="margin-bottom:.5rem">tell you to get expert advice on anything beyond an agent's expertise;</li><li style="margin-bottom:.5rem">account promptly for any money or property received for you;</li><li style="margin-bottom:.5rem">keep private what you tell us that could hurt your sale, unless you agree in writing or the law requires it.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Each step above says what we add to that, from pricing to the appraisal. None of it needs you in South Carolina.</p></div></section><section style="background:var(--ivory-2)" id="withholding"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What the state holds back">What does South Carolina hold back at closing when you live out of state?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">When your permanent home is in another state, the buyer must hold back part of the price for South Carolina income tax, unless the sale is exempt. A main home whose gain is inside the federal exclusion is exempt. The buyer, usually through the closing attorney's office, sends it to the South Carolina Department of Revenue.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For a sale closed in 2026, the rate is 5.21 percent. It is the state's top income tax rate for the year of the sale, so a sale that closes in a later year may use a different rate. We can tell you the rate for the year your sale will close.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Your gain is what you get from the sale less what the home cost you.</p><style>.c3-cc{margin:1.4rem 0 1.8rem;max-width:960px}.c3-cc table{width:100%;border-collapse:collapse;font-size:var(--read,1.0625rem);line-height:1.45;color:var(--muted)}.c3-cc caption{caption-side:top;text-align:left;color:var(--navy);font-weight:600;font-size:1em;line-height:1.4;padding:0 0 .7rem}.c3-cc th,.c3-cc td{padding:.6rem .7rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule);overflow-wrap:break-word}.c3-cc thead th{color:var(--navy);font-weight:600;font-size:1em;border-bottom:2px solid var(--navy);vertical-align:bottom}.c3-cc tbody th{color:var(--navy);font-weight:600}.c3-cc .n{text-align:right;font-variant-numeric:tabular-nums}.c3-cc .i{display:inline-flex;vertical-align:-4px;margin-right:.45rem;color:var(--brass-ink)}.c3-cc tr.c3-self>*{background:#fff}@media (max-width:39.999em){.c3-cc table,.c3-cc tbody,.c3-cc tr,.c3-cc th,.c3-cc td{display:block;width:auto}.c3-cc caption{display:block}.c3-cc thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.c3-cc tbody tr{background:var(--ivory-2);border-top:3px solid var(--brass);margin:0 0 .8rem;padding:.5rem 0 .6rem}section[style*="background:var(--ivory-2)"] .c3-cc tbody tr{background:var(--ivory)}.c3-cc tr.c3-self{background:#fff!important;border:2px solid var(--brass)}.c3-cc tr.c3-self>*{background:transparent}.c3-cc th,.c3-cc td{border:0;padding:.2rem 1rem}.c3-cc tbody th{display:flex;align-items:center;font-size:1.1em;padding-bottom:.35rem}.c3-cc tbody th .i{flex:none;vertical-align:0}.c3-cc tbody th a{display:inline-block;padding:.5rem 0}.c3-cc .n{text-align:left}.c3-cc td[data-label]::before{content:attr(data-label) ": ";color:var(--navy);font-weight:500}}</style><div class="c3-cc"><table><caption>The hold-back when the seller lives in another state</caption><thead><tr><th scope="col">Your sale</th><th scope="col">What the buyer holds back</th><th scope="col" class="n">On a $400,000 sale with a $100,000 gain</th></tr></thead><tbody><tr><th scope="row">Your main home, with the gain inside the federal exclusion</th><td data-label="What the buyer holds back">Nothing</td><td class="n" data-label="On a $400,000 sale with a $100,000 gain">$0</td></tr><tr><th scope="row">Not your main home (or a gain above the exclusion), and you sign Form I‑295</th><td data-label="What the buyer holds back">5.21% of your gain</td><td class="n" data-label="On a $400,000 sale with a $100,000 gain">$5,210</td></tr><tr><th scope="row">You do not sign Form I‑295</th><td data-label="What the buyer holds back">5.21% of the whole price</td><td class="n" data-label="On a $400,000 sale with a $100,000 gain">$20,840</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The amount held back is never more than the cash you would get at closing.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does the main-home exclusion cover you?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Only if it was your main home. The federal main-home exclusion leaves up to $250,000 of gain out of your income, or $500,000 for a married couple filing jointly. You must have owned and lived there 2 of the last 5 years, with no exclusion used on another home in the 2 years before the sale. On a joint return, both of you must have lived there. A rental or a second home does not get it.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Form I‑295: your sworn statement</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Form I‑295 is a sworn statement on a South Carolina tax form. On it you state your gain, or that the home was your main home. You sign it before a notary, so you can sign it at the same visit as the deed. You give it to the buyer and keep a copy with your tax records.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do you get back what was held back?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You file a South Carolina return for the year of the sale, and the amount held back counts toward the tax you owe there. If more was held back than you owe, you can ask the state for the difference as a refund. To run your own numbers, use the calculator in our <a href="/sell/capital-gains/" style="color:var(--navy);text-decoration:underline">capital gains and withholding guide</a>.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A Canadian owner who is not a U.S. citizen or resident also faces a separate federal hold-back under FIRPTA, generally 15 percent of the price. Our page for <a href="/invest/canadian-buyers/" style="color:var(--navy);text-decoration:underline">Canadian owners</a> covers it. Selling a house you inherited from far away? Our <a href="/sell/inherited-house/" style="color:var(--navy);text-decoration:underline">inherited house guide</a> covers that sale.</p></div></section><section style="background:var(--ivory)" id="price"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Where the price goes">Where does the price go at closing?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The deed recording fee and, unless it was your main home, the state hold-back come out of the price at closing. The example below is the same sale as in the table.</p><style>main#main .c3-path{max-width:760px;margin:1rem 0 1.4rem;padding:.4rem 1rem;border-radius:18px;background:linear-gradient(180deg,rgba(255,255,255,.76),rgba(255,255,255,.52));border:1px solid rgba(255,255,255,.8);box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 10px 26px -20px rgba(28,32,40,.35)}main#main .c3-path ol{list-style:none;margin:0;padding:0}main#main .c3-path li{display:grid;grid-template-columns:2.4rem 1fr auto;gap:.2rem .8rem;align-items:center;margin:0;padding:.85rem 0;border-bottom:1px solid rgba(28,32,40,.1);color:var(--muted);line-height:1.5}main#main .c3-path li:last-child{border-bottom:0}main#main .c3-path .ic{display:flex;width:2.4rem;height:2.4rem;border-radius:50%;align-items:center;justify-content:center;color:#91592b;background:rgba(196,120,58,.12)}main#main .c3-path strong{display:block;color:var(--navy);font-weight:600}main#main .c3-path .amt{font-weight:700;color:var(--navy);white-space:nowrap;font-variant-numeric:tabular-nums;text-align:right}main#main .c3-path li.end .ic{color:#fff;background:linear-gradient(135deg,#c4783a,#d4894a)}main#main .c3-path figcaption{padding:.8rem 0 .4rem;color:var(--navy);font-weight:600}@media (max-width:479px){main#main .c3-path li{grid-template-columns:2.4rem 1fr}main#main .c3-path .amt{grid-column:2;text-align:left}}</style><figure class="c3-path"><figcaption>A $400,000 sale of a rental with a $100,000 gain</figcaption><ol><li><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span><span><strong>The price</strong>What the buyer pays.</span><span class="amt">$400,000</span></li><li><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6.5 3h8l4 4v14h-12zM14.5 3v4h4M9.5 12h6M9.5 15.5h6"/></svg></span><span><strong>Deed recording fee</strong>The seller owes it: $1.85 for each $500 of the price.</span><span class="amt">&minus;$1,480</span></li><li><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h8l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v4h4M9 17l6-6"/><circle cx="9.5" cy="11.5" r="1"/><circle cx="14.5" cy="16.5" r="1"/></svg></span><span><strong>State hold-back</strong>5.21% of the gain, with Form I‑295 signed. It counts toward your South Carolina tax.</span><span class="amt">&minus;$5,210</span></li><li><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 9.4c-.4-1-1.5-1.8-3-1.8-1.8 0-3 1-3 2.2 0 3 6 1.6 6 4.4 0 1.3-1.3 2.2-3 2.2-1.6 0-2.7-.7-3.1-1.8M12 5.8v1.8M12 16.4v1.8"/><circle cx="12" cy="12" r="9"/></svg></span><span><strong>Your loan payoff, the commission and other closing costs</strong>Your own figures.</span></li><li class="end"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span><span><strong>The rest is yours</strong>Confirm the account it goes to by phone first (below).</span></li></ol></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our <a href="/sell/net-proceeds/" style="color:var(--navy);text-decoration:underline">net proceeds calculator</a> adds your loan payoff and the rest of your closing costs. Real estate commissions are negotiable between you and the brokerage.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Keep your money safe</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Confirm the account your money goes to with the closing attorney's office by phone, on a number you agreed on in advance. Never follow wire or bank instructions in an email.</p></div></section><section style="background:var(--ivory-2)" id="disclosure"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Your disclosure">What must you tell a buyer about a home you rarely see?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Tell the buyer what you know. You do not have to report what you do not know. You give the buyer South Carolina's written disclosure statement, the same as an owner who lives next door. On any item you do not know, you can mark that you make no representation, which means you are not saying either way.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">What you do know, you must tell. An owner who knowingly gives false, incomplete or misleading information is liable to the buyer for the damage. For a condo, the statement covers your unit, not the parts of the building everyone shares. As your listing agent, we must tell you in writing what this law asks of you.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Sales that need no statement</h3><ul style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem">a sale by the person settling an estate, or by a trustee for a trust;</li><li style="margin-bottom:.5rem">a sale to a spouse, a child or another direct relative;</li><li style="margin-bottom:.5rem">the first sale of a home no one has lived in;</li><li style="margin-bottom:.5rem">a sale where both sides agree in writing to skip it.</li></ul></div></section><section style="background:var(--ivory)" id="bookings"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Guest bookings">What happens to your guest bookings when you sell?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If you rent the home to guests, South Carolina law says what happens to each booking, and when the buyer and your rental company must hear about it. Your disclosure statement must also say if a lease or a contract with a rental company will still be in place at closing.</p><style>main#main .c3-time{list-style:none;max-width:760px;margin:1rem 0 1.4rem;padding:0;display:grid;gap:.55rem}main#main .c3-time li{display:grid;grid-template-columns:12rem 1fr;gap:.3rem 1rem;align-items:start;margin:0;padding:.85rem 1rem;border-radius:14px;background:linear-gradient(180deg,rgba(255,255,255,.76),rgba(255,255,255,.52));border:1px solid rgba(255,255,255,.8);box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 10px 26px -20px rgba(28,32,40,.35);color:var(--muted);line-height:1.55}main#main .c3-time .when{color:#8a5226;font-weight:700;font-size:.95rem}@media (max-width:599px){main#main .c3-time li{grid-template-columns:1fr}}</style><ol class="c3-time" aria-label="Guest bookings when a rental home is sold"><li><span class="when">Before the contract is signed</span><span>The buyer gets, in writing, every future date the home is booked.</span></li><li><span class="when">Within 14 days of the contract</span><span>The rental company gets the buyer's name and address in writing.</span></li><li><span class="when">Within 14 days after the sale</span><span>The rental company gets the buyer's name, address and the date the deed was recorded.</span></li><li><span class="when">Up to 90 days after recording</span><span>Guest stays that begin in this time go ahead. The buyer must honor them.</span></li><li><span class="when">Stays that begin later</span><span>They cannot be enforced, and the guest is due a refund within 45 days after the recording.</span></li></ol><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Selling a home with a long-term tenant in it? Our <a href="/sell/rental-property/" style="color:var(--navy);text-decoration:underline">rental property guide</a> covers the lease.</p></div></section><section style="background:var(--ivory-2)" id="who-buys"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Who buys">Do out-of-state buyers pay more for Grand Strand homes?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Buyers from other states paid what their neighbors paid. In the same building or subdivision, they and buyers from South Carolina paid the same typical price. About half of each group paid more than that price, and half paid less.</p><figure class="c3-gchart"><div role="table" aria-label="Paid more than the typical price in their building or subdivision"><span class="cap" aria-hidden="true">Paid more than the typical price in their building or subdivision</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Buyer</span><span role="columnheader">share who paid more</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Buyers from other states</span></span><span role="cell"><span class="b" style="--f:0.477" aria-hidden="true"></span><span class="v">48%</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Buyers from South Carolina</span></span><span role="cell"><span class="b" style="--f:0.497" aria-hidden="true"></span><span class="v">50%</span></span></div></div></div><figcaption>Homes sold by their owners, not by builders.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Some sellers expect a buyer from a pricier state to pay more. We price your home to what sold near it, the same as for a local buyer.</p><figure class="c3-gchart"><div role="table" aria-label="Buyers from another state, Horry County"><span class="cap" aria-hidden="true">Buyers from another state, Horry County</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Kind of home</span><span role="columnheader">share of buyers</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Condos</span></span><span role="cell"><span class="b" style="--f:0.544" aria-hidden="true"></span><span class="v">54%</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Every home sold</span></span><span role="cell"><span class="b" style="--f:0.297" aria-hidden="true"></span><span class="v">30%</span></span></div><div role="row"><span role="rowheader"><span class="n">Other homes</span></span><span role="cell"><span class="b" style="--f:0.236" aria-hidden="true"></span><span class="v">24%</span></span></div></div></div><figcaption>A year of Horry County deeds, matched to the county's tax records: buyers whose tax bill goes to another state or country.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Condos draw the most buyers from other states: more than half, against about 1 in 4 buyers of other homes. Near the ocean the share is higher. In the city of North Myrtle Beach it was more than half; inland in Conway, about 1 in 10. These buyers close here all year, so list your home when it is ready.</p><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);lette