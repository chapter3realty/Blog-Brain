14.0" y2="14.0" stroke="#1c2028" stroke-opacity=".1"/><text x="44" y="19.3" text-anchor="end" font-size="15" fill="#4a4f5c">+60%</text><text x="50.0" y="364.5" text-anchor="middle" font-size="15" fill="#4a4f5c">2016</text><text x="155.4" y="364.5" text-anchor="middle" font-size="15" fill="#4a4f5c">2018</text><text x="260.7" y="364.5" text-anchor="middle" font-size="15" fill="#4a4f5c">2020</text><text x="366.1" y="364.5" text-anchor="middle" font-size="15" fill="#4a4f5c">2022</text><text x="471.5" y="364.5" text-anchor="middle" font-size="15" fill="#4a4f5c">2024</text><text x="576.8" y="364.5" text-anchor="middle" font-size="15" fill="#4a4f5c">2026</text><path d="M50.0 299.4L63.2 297.7L76.3 290.7L89.5 294.7L102.7 290.7L115.9 285.2L129.0 282.2L142.2 281.2L155.4 274.8L168.5 275.8L181.7 270.8L194.9 266.6L208.0 265.4L221.2 257.8L234.4 255.8L247.6 253.2L260.7 245.9L273.9 245.8L287.1 242.7L300.2 233.9L313.4 227.4L326.6 209.0L339.8 187.2L352.9 169.1L366.1 150.0L379.3 125.6L392.4 99.6L405.6 101.8L418.8 106.5L432.0 85.9L445.1 77.4L458.3 65.0L471.5 70.4L484.6 67.9L497.8 66.7L511.0 59.8L524.1 50.3L537.3 43.7L550.5 39.2L563.7 45.7L576.8 39.4L590.0 39.6L590 339.0L50 339.0Z" fill="url(#hvFillhv-w)"/><path d="M50.0 299.4L63.2 297.7L76.3 290.7L89.5 294.7L102.7 290.7L115.9 285.2L129.0 282.2L142.2 281.2L155.4 274.8L168.5 275.8L181.7 270.8L194.9 266.6L208.0 265.4L221.2 257.8L234.4 255.8L247.6 253.2L260.7 245.9L273.9 245.8L287.1 242.7L300.2 233.9L313.4 227.4L326.6 209.0L339.8 187.2L352.9 169.1L366.1 150.0L379.3 125.6L392.4 99.6L405.6 101.8L418.8 106.5L432.0 85.9L445.1 77.4L458.3 65.0L471.5 70.4L484.6 67.9L497.8 66.7L511.0 59.8L524.1 50.3L537.3 43.7L550.5 39.2L563.7 45.7L576.8 39.4L590.0 39.6" fill="none" stroke="#c4783a" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/><circle cx="326.6" cy="209.0" r="4.5" fill="#1c2028"/><text x="318.6" y="200.0" text-anchor="end" font-size="15" font-weight="600" fill="#1c2028" stroke="#fbf8f3" stroke-width="4" stroke-linejoin="round" paint-order="stroke">mid-2021</text><circle cx="590.0" cy="39.6" r="4.5" fill="#1c2028"/><text x="586.0" y="27.6" text-anchor="end" font-size="15" font-weight="600" fill="#1c2028" stroke="#fbf8f3" stroke-width="4" stroke-linejoin="round" paint-order="stroke">now: up 52%</text></svg><figcaption style="color:var(--muted);font-size:.85rem;line-height:1.6;margin-top:.6rem">Change in house prices in Horry County since mid‑2021, by quarter: up about half by mid‑2025, then about flat for a year. Federal Housing Finance Agency house price index; houses only.</figcaption></figure></div></section><section style="background:var(--ivory-2)" id="online-estimates"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Online estimates">How accurate are online home estimates in Myrtle Beach?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Redfin publishes how close its own estimate comes in Horry County. For homes that were not for sale, the middle miss was 6.6 percent: about $23,000 on a $350,000 house. Half of the homes were further off, and about 1 in 7 was off by more than 20 percent.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No online estimate, Zillow's Zestimate included, tells you whether your home is one of the close ones or one of the far ones.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Once a home is listed for sale, Redfin's middle miss here falls to 1.65 percent. It is closer then because there is more data about a home for sale. A listing adds what the county's records do not show: the rooms, the updates, the photos and an asking price. Our agent looks at those things with you before you list, and sends the number with the sales behind it.</p></div></section><section style="background:var(--ivory)" id="county-value"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Quick numbers">Is the county's value or the nearest sales a good guess at my price?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Two quick numbers are often used as a price: the middle price of the six nearest sales, and the county's value, which is the market value on the home's county property record. We checked both against the prices of houses sold this year.</p><figure class="c3-gchart"><div role="table" aria-label="How far off two quick numbers were on a typical house"><span class="cap" aria-hidden="true">How far off two quick numbers were on a typical house</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Quick number</span><span role="columnheader">how far off</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Middle price of the six nearest sales</span></span><span role="cell"><span class="b" style="--f:0.805" aria-hidden="true"></span><span class="v">16% off</span></span></div><div role="row"><span role="rowheader"><span class="n">The county's value</span></span><span role="cell"><span class="b" style="--f:0.44" aria-hidden="true"></span><span class="v">9% off</span></span></div></div></div></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The county's value was closer, but it is a mass estimate, made for every home at once, for tax. It is above the price on most condos and below it on most houses: about 7 in 10 condos sold for less than it, and 6 in 10 houses sold for more.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Your tax bill is a worse guide. About 2 in 3 Horry County homes are taxed on less than the county's value. A sale resets the value as of December 31 of the year the home sold, so <a href="/buyers/property-taxes/" style="color:var(--navy);text-decoration:underline">your buyer's tax bill</a> can be higher than yours.</p></div></section><section style="background:var(--ivory-2)" id="how-we-price-it"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="How we price it">How is a home's value worked out in Myrtle Beach?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We start from the sales most like your home. The nearest sales, or the sales on your street, can be far off. Here is one Carolina Forest house from the county's records.</p><figure style="margin:1.8rem 0;max-width:760px"><svg class="hv-n" viewBox="0 0 300 218" role="img" aria-label="Dot chart on one price line from $250,000 to $750,000. The six nearest sales are dots from $270,000 to $720,000, with their middle at $556,000. The other sales in the house's own neighborhood are dots from $356,000 to $425,000. The house sold for $482,000, more than any of them."><line x1="39.6" x2="39.6" y1="21.7" y2="214" stroke="#1c2028" stroke-opacity=".08"/><text x="39.6" y="15.5" text-anchor="middle" font-size="15.5" fill="#4a4f5c">$300k</text><line x1="150.0" x2="150.0" y1="21.7" y2="214" stroke="#1c2028" stroke-opacity=".08"/><text x="150.0" y="15.5" text-anchor="middle" font-size="15.5" fill="#4a4f5c">$500k</text><line x1="260.4" x2="260.4" y1="21.7" y2="214" stroke="#1c2028" stroke-opacity=".08"/><text x="260.4" y="15.5" text-anchor="middle" font-size="15.5" fill="#4a4f5c">$700k</text><line x1="140.1" x2="140.1" y1="47.1" y2="69.1" stroke="#c4783a" stroke-width="2" stroke-dasharray="4 4"/><line x1="140.1" x2="140.1" y1="137.8" y2="159.8" stroke="#c4783a" stroke-width="2" stroke-dasharray="4 4"/><line x1="140.1" x2="140.1" y1="189.7" y2="211.7" stroke="#c4783a" stroke-width="2" stroke-dasharray="4 4"/><text x="12" y="40.3" font-size="15.5" font-weight="600" fill="#1c2028" stroke="#fbf8f3" stroke-width="5" stroke-linejoin="round" paint-order="stroke">The six nearest sales</text><circle cx="90.9" cy="58.1" r="7" fill="#7d8291" fill-opacity=".75" stroke="#fff" stroke-width="1.5"/><circle cx="271.4" cy="58.1" r="7" fill="#7d8291" fill-opacity=".75" stroke="#fff" stroke-width="1.5"/><circle cx="204.6" cy="58.1" r="7" fill="#7d8291" fill-opacity=".75" stroke="#fff" stroke-width="1.5"/><circle cx="232.8" cy="58.1" r="7" fill="#7d8291" fill-opacity=".75" stroke="#fff" stroke-width="1.5"/><circle cx="23.0" cy="58.1" r="7" fill="#7d8291" fill-opacity=".75" stroke="#fff" stroke-width="1.5"/><circle cx="157.7" cy="58.1" r="7" fill="#7d8291" fill-opacity=".75" stroke="#fff" stroke-width="1.5"/><line x1="180.9" x2="180.9" y1="46.1" y2="70.1" stroke="#1c2028" stroke-width="3"/><text x="180.9" text-anchor="middle" font-size="15.5" fill="#1c2028" stroke="#fbf8f3" stroke-width="4" stroke-linejoin="round" paint-order="stroke"><tspan x="180.9" y="86.8">middle</tspan><tspan x="180.9" y="104.6" font-weight="600">$556,000</tspan></text><text x="12" y="131.0" font-size="15.5" font-weight="600" fill="#1c2028" stroke="#fbf8f3" stroke-width="5" stroke-linejoin="round" paint-order="stroke">Other sales in its neighborhood</text><circle cx="70.5" cy="148.8" r="7" fill="#7d8291" fill-opacity=".75" stroke="#fff" stroke-width="1.5"/><circle cx="90.9" cy="148.8" r="7" fill="#7d8291" fill-opacity=".75" stroke="#fff" stroke-width="1.5"/><circle cx="94.8" cy="148.8" r="7" fill="#7d8291" fill-opacity=".75" stroke="#fff" stroke-width="1.5"/><circle cx="108.6" cy="148.8" r="7" fill="#7d8291" fill-opacity=".75" stroke="#fff" stroke-width="1.5"/><text x="12" y="182.9" font-size="15.5" font-weight="600" fill="#1c2028" stroke="#fbf8f3" stroke-width="5" stroke-linejoin="round" paint-order="stroke">What it sold for</text><circle cx="140.1" cy="200.7" r="8" fill="#c4783a"/><text x="152.1" y="206.2" text-anchor="start" font-size="15.5" font-weight="600" fill="#1c2028" stroke="#fbf8f3" stroke-width="4" stroke-linejoin="round" paint-order="stroke">$482,000</text></svg><svg class="hv-w" viewBox="0 0 600 211" role="img" aria-label="Dot chart on one price line from $250,000 to $750,000. The six nearest sales are dots from $270,000 to $720,000, with their middle at $556,000. The other sales in the house's own neighborhood are dots from $356,000 to $425,000. The house sold for $482,000, more than any of them."><line x1="69.6" x2="69.6" y1="21" y2="207" stroke="#1c2028" stroke-opacity=".08"/><text x="69.6" y="15" text-anchor="middle" font-size="15" fill="#4a4f5c">$300k</text><line x1="300.0" x2="300.0" y1="21" y2="207" stroke="#1c2028" stroke-opacity=".08"/><text x="300.0" y="15" text-anchor="middle" font-size="15" fill="#4a4f5c">$500k</text><line x1="530.4" x2="530.4" y1="21" y2="207" stroke="#1c2028" stroke-opacity=".08"/><text x="530.4" y="15" text-anchor="middle" font-size="15" fill="#4a4f5c">$700k</text><line x1="279.3" x2="279.3" y1="45.3" y2="67.3" stroke="#c4783a" stroke-width="2" stroke-dasharray="4 4"/><line x1="279.3" x2="279.3" y1="133.0" y2="155.0" stroke="#c4783a" stroke-width="2" stroke-dasharray="4 4"/><line x1="279.3" x2="279.3" y1="183.3" y2="205.3" stroke="#c4783a" stroke-width="2" stroke-dasharray="4 4"/><text x="12" y="39.0" font-size="15" font-weight="600" fill="#1c2028" stroke="#fbf8f3" stroke-width="5" stroke-linejoin="round" paint-order="stroke">The six nearest sales</text><circle cx="176.7" cy="56.3" r="7" fill="#7d8291" fill-opacity=".75" stroke="#fff" stroke-width="1.5"/><circle cx="553.4" cy="56.3" r="7" fill="#7d8291" fill-opacity=".75" stroke="#fff" stroke-width="1.5"/><circle cx="414.0" cy="56.3" r="7" fill="#7d8291" fill-opacity=".75" stroke="#fff" stroke-width="1.5"/><circle cx="472.8" cy="56.3" r="7" fill="#7d8291" fill-opacity=".75" stroke="#fff" stroke-width="1.5"/><circle cx="35.0" cy="56.3" r="7" fill="#7d8291" fill-opacity=".75" stroke="#fff" stroke-width="1.5"/><circle cx="316.1" cy="56.3" r="7" fill="#7d8291" fill-opacity=".75" stroke="#fff" stroke-width="1.5"/><line x1="364.5" x2="364.5" y1="44.3" y2="68.3" stroke="#1c2028" stroke-width="3"/><text x="364.5" text-anchor="middle" font-size="15" fill="#1c2028" stroke="#fbf8f3" stroke-width="4" stroke-linejoin="round" paint-order="stroke"><tspan x="364.5" y="84.0">middle</tspan><tspan x="364.5" y="101.3" font-weight="600">$556,000</tspan></text><text x="12" y="126.8" font-size="15" font-weight="600" fill="#1c2028" stroke="#fbf8f3" stroke-width="5" stroke-linejoin="round" paint-order="stroke">Other sales in its neighborhood</text><circle cx="134.1" cy="144.0" r="7" fill="#7d8291" fill-opacity=".75" stroke="#fff" stroke-width="1.5"/><circle cx="176.7" cy="144.0" r="7" fill="#7d8291" fill-opacity=".75" stroke="#fff" stroke-width="1.5"/><circle cx="184.8" cy="144.0" r="7" fill="#7d8291" fill-opacity=".75" stroke="#fff" stroke-width="1.5"/><circle cx="213.6" cy="144.0" r="7" fill="#7d8291" fill-opacity=".75" stroke="#fff" stroke-width="1.5"/><text x="12" y="177.0" font-size="15" font-weight="600" fill="#1c2028" stroke="#fbf8f3" stroke-width="5" stroke-linejoin="round" paint-order="stroke">What it sold for</text><circle cx="279.3" cy="194.3" r="8" fill="#c4783a"/><text x="291.3" y="199.5" text-anchor="start" font-size="15" font-weight="600" fill="#1c2028" stroke="#fbf8f3" stroke-width="4" stroke-linejoin="round" paint-order="stroke">$482,000</text></svg><figcaption style="color:var(--muted);font-size:.85rem;line-height:1.6;margin-top:.6rem">One Carolina Forest house, from county records. Gray dots are sales. The black line is the middle of the six nearest. The dashed line is what the house sold for.</figcaption></figure><ol style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem"><strong>The six nearest sales</strong> had a middle price of about $556,000, about $74,000 more than the house sold for. Only one of the six was in its neighborhood.</li><li style="margin-bottom:.5rem"><strong>The other 4 house sales in its own neighborhood</strong> in the year went for $356,000 to $425,000.</li><li style="margin-bottom:.5rem"><strong>The house sold</strong> for about $482,000, more than any of them.</li></ol><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The county's records do not say why this house sold for more than its neighbors. A comparative market analysis, or CMA, finds out. It does five things the quick numbers cannot:</p><ul style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem">It keeps only sales like the home in size, age, lot and condition, from the same neighborhood or the next one over. For a condo, that means sales in the same building. For a home on the water or a golf course, sales on the same water or course.</li><li style="margin-bottom:.5rem">It adjusts each of those sales for what differs from the home.</li><li style="margin-bottom:.5rem">It looks at the home's condition, updates and view, with the owner.</li><li style="margin-bottom:.5rem">It compares the home with the homes for sale near it now.</li><li style="margin-bottom:.5rem">It ends in a price range and a list price.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A condo's price also depends on whether lenders will lend in its building. Where many will not, fewer buyers can get a loan. Our <a href="/invest/non-warrantable-condos/" style="color:var(--navy);text-decoration:underline">guide to condos most lenders will not lend on</a> explains which buildings and why.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our agents do a CMA for your home, free.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Have an agent price your home</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Usually in a day or two.</p><a class="btn btn-brass" href="#lead-form">Get my home value</a></div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is a CMA the same as an appraisal?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. An appraisal is a licensed appraiser's opinion of value. In South Carolina, appraisal work and the title of appraiser need an appraiser's license, and an agent's valuation may not be called an appraisal.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our agents see low appraisals only rarely here. When a buyer's appraisal comes in low, our agents ask the appraiser to look again, and send recent sales of homes like yours. Once, the value went up, and the buyer brought less cash to closing.</p></div></section><section style="background:var(--ivory)" id="what-changes-price"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What changes price">What changes a home's price in Myrtle Beach?</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How close it is to the ocean</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Condos within 0.1 mile of the ocean ask about twice as much per square foot as condos more than 2 miles away.</p><figure class="c3-gchart"><div role="table" aria-label="Asking price per square foot of condos for sale, by distance from the ocean"><span class="cap" aria-hidden="true">Asking price per square foot of condos for sale, by distance from the ocean</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Distance from the ocean, middle size</span><span role="columnheader">asking price per square foot</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Within 0.1 mile</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">middle size 640 sq ft</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">$322 a sq ft</span></span></div><div role="row"><span role="rowheader"><span class="n">0.1 to 0.5 mile</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">middle size 1,015 sq ft</span></span><span role="cell"><span class="b" style="--f:0.839" aria-hidden="true"></span><span class="v">$270 a sq ft</span></span></div><div role="row"><span role="rowheader"><span class="n">0.5 to 2 miles</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">middle size 1,100 sq ft</span></span><span role="cell"><span class="b" style="--f:0.634" aria-hidden="true"></span><span class="v">$204 a sq ft</span></span></div><div role="row"><span role="rowheader"><span class="n">Over 2 miles</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">middle size 1,110 sq ft</span></span><span role="cell"><span class="b" style="--f:0.522" aria-hidden="true"></span><span class="v">$168 a sq ft</span></span></div></div></div><figcaption>Condos for sale in Horry County, about 2,700 in all, counted in aggregate from our listings feed. Asking prices, not sale prices. Distance in a straight line to the ocean.</figcaption></figure><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/buyers/no-hoa/crescent-beach-streets-from-the-ocean-2011-1200w.webp" srcset="/images/buyers/no-hoa/crescent-beach-streets-from-the-ocean-2011-600w.webp 600w, /images/buyers/no-hoa/crescent-beach-streets-from-the-ocean-2011-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="782" alt="Streets of two-story beach houses among trees behind the oceanfront at Crescent Beach in North Myrtle Beach, seen from a plane over the ocean" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: U.S. Geological Survey. License: Public domain" title="License: Public domain">Photo: U.S. Geological Survey</a></span></div><figcaption>Crescent Beach in North Myrtle Beach from over the ocean in 2011: buildings on the beach, then streets of houses. Houses for sale within 0.1 mile of the ocean ask about 2.5 times as much a square foot as houses more than 2 miles away.</figcaption></figure></div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">New houses for sale near you</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Your house competes with <a href="/buyers/new-construction/" style="color:var(--navy);text-decoration:underline">new ones</a>. Builders sold new houses in the same 12 months for a middle price close to the resale one. More than 2 miles from the ocean, new houses for sale ask about $194 a square foot, and older ones about $200. A buyer at your price may also be touring new houses.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">The time of year</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">More houses sell in the warm months. From May to October the county recorded about 1.5 times as many house resales a month as in January and February. The price moved less: the middle stayed within about 5 percent of $350,000 in every month.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">The flood line</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About 13 percent of the county's resales were inside <a href="/buyers/coastal-insurance/" style="color:var(--navy);text-decoration:underline">FEMA's high-risk flood zone</a>, most of them condos. Being inside it did not lower the price. In neighborhoods with house sales on both sides of the line, the houses inside it did not sell for less than the others.</p></div></section><section style="background:var(--ivory-2)" id="what-you-keep"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What you keep">How much will I keep when I sell in Myrtle Beach?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Here is what comes off a $350,000 sale:</p><ul style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem"><strong>The deed fee, $1,295.</strong> It is a state fee, and the seller pays it.</li><li style="margin-bottom:.5rem"><strong>The commission</strong> you agree with your broker.</li><li style="margin-bottom:.5rem"><strong>What you still owe on your loan.</strong></li><li style="margin-bottom:.5rem"><strong>Tax on your gain, often none.</strong> If you owned the home and lived in it for 2 of the last 5 years, up to $250,000 of gain can be left out of your income, or $500,000 for a married couple filing jointly who both lived there. It does not apply if you used it on another home in the 2 years before. Bought for $200,000 and sold for $350,000, your gain is less than $150,000, inside the limit.</li><li style="margin-bottom:.5rem"><strong>A hold-back if you live in another state.</strong> The buyer must hold back part of the price at closing for South Carolina income tax, unless the sale is exempt, for example a main home whose gain is inside that limit. With your signed statement of the gain, it is figured on the gain, not the whole price.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our <a href="/sell/net-proceeds/" style="color:var(--navy);text-decoration:underline">net proceeds calculator</a> works out what you keep at your own price. Thinking of selling it yourself? We will price your home either way.</p></div></section><section style="background:var(--ivory)" id="lead-form"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Get your number">Get the number for your home</h2><style>main#main .hv-form{max-width:760px;margin:1.4rem 0 1rem;padding:1.4rem 1.3rem;border-radius:20px;box-sizing:border-box;background:linear-gradient(160deg,rgba(42,48,64,.96),rgba(28,32,40,.98));border:1px solid rgba(255,255,255,.14);box-shadow:inset 0 1px 0 rgba(255,255,255,.14),0 26px 60px -30px rgba(28,32,40,.6)}main#main .hv-form .idx-lead{margin-bottom:.7rem}main#main .hv-form .idx-input{min-height:48px;font-size:1.0625rem}main#main .hv-form .hv-consent{display:flex;gap:.6rem;align-items:flex-start;font-family:var(--sans);font-size:.875rem;color:rgba(244,239,232,.86);line-height:1.5;margin:.3rem 0 1rem;cursor:pointer}main#main .hv-form .hv-consent input{margin-top:.2rem;accent-color:#c4783a;flex-shrink:0;width:20px;height:20px}main#main .hv-form .btn{width:100%;justify-content:center;min-height:50px}main#main .hv-form .hv-err{display:none;color:#ffb4a8;font-family:var(--sans);font-size:1rem;margin:0 0 .8rem}main#main .hv-ok{display:none;max-width:760px;margin:1.4rem 0 1rem;padding:1.3rem;border-radius:20px;background:var(--navy);color:var(--ivory);font-family:var(--sans);font-size:1.0625rem;line-height:1.6}main#main>section[style^="background:var(--navy)"]:last-of-type{padding:2.5rem 0 3rem!important}main#main>section[style^="background:var(--navy)"]:last-of-type>.wrap{display:block!important;text-align:center!important;max-width:720px!important;margin:0 auto!important;padding:2.2rem 1.4rem!important;width:calc(100% - 32px);box-sizing:border-box;border-radius:22px;background:linear-gradient(160deg,rgba(42,48,64,.96),rgba(28,32,40,.98))!important;border:1px solid rgba(255,255,255,.14)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.14),0 26px 60px -30px rgba(28,32,40,.6)!important}@media (max-width:699px){main#main #lead-form .c3-glance{grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem}main#main #lead-form .c3-glance li{flex-direction:row;text-align:left;gap:.6rem;padding:.6rem .7rem}}main#main .hv-disc{font-family:var(--sans);font-size:1rem;line-height:1.6;color:var(--navy);max-width:760px;margin:0 0 1rem;padding:.8rem 1rem;border-left:3px solid var(--brass);background:rgba(255,255,255,.5);border-radius:0 12px 12px 0}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Send the address and an agent calls you, evenings included. You can ask before you are ready to sell: for insurance, an estate, or to decide when to sell. Prefer to talk? Call <a href="tel:+18543332135" style="color:var(--navy);text-decoration:underline">854.333.2135</a>.</p><style>.c3-glance{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(var(--n),minmax(0,1fr));gap:.75rem;max-width:760px}.c3-glance li{display:flex;align-items:center;gap:.55rem;margin:0;padding:.5rem .6rem;background:rgba(255,255,255,.55);border:1px solid var(--rule);border-radius:6px;line-height:1.25}.c3-glance .i{flex:0 0 auto;display:flex;width:2rem;height:2rem;border-radius:50%;background:var(--ivory-2);color:var(--brass-ink);align-items:center;justify-content:center}.c3-glance strong{display:block;color:var(--navy);font-size:.9rem;font-weight:500}.c3-glance span.t{display:block;color:var(--muted);font-size:1rem}@media (max-width:699px){.c3-glance{gap:.3rem}.c3-glance li{flex-direction:column;justify-content:flex-start;text-align:center;gap:.2rem;padding:.4rem .1rem}.c3-glance .i{width:1.6rem;height:1.6rem}.c3-glance strong{font-size:.875rem}.c3-glance span.t{font-size:1rem;line-height:1.2}}</style><ul role="list" class="c3-glance" style="--n:4"><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 5h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM3 10h18M8 3v4M16 3v4M8 14h.01M12 14h.01M16 14h.01M8 17.5h.01M12 17.5h.01"/></svg></span><span><strong>A call</strong><span class="t">Same day</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span><span><strong>Your analysis</strong><span class="t">Usually a day or two</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 9.4c-.4-1-1.5-1.8-3-1.8-1.8 0-3 1-3 2.2 0 3 6 1.6 6 4.4 0 1.3-1.3 2.2-3 2.2-1.6 0-2.7-.7-3.1-1.8M12 5.8v1.8M12 16.4v1.8"/><circle cx="12" cy="12" r="9"/></svg></span><span><strong>Cost</strong><span class="t">Free</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span><strong>Listing with us</strong><span class="t">Not required</span></span></li></ul><div id="ldWrap" class="hv-form"><div class="idx-lead" style="grid-template-columns:1fr"><input class="idx-input" id="ldCtx" placeholder="Property address" aria-label="Property address" autocomplete="street-address"></div><div class="idx-lead"><input class="idx-input" id="ldName" placeholder="Your name" aria-label="Your name" autocomplete="name"><input class="idx-input" id="ldPhone" placeholder="Phone" aria-label="Phone" type="tel" autocomplete="tel"></div><div class="idx-lead" style="grid-template-columns:1fr"><input class="idx-input" id="ldEmail" placeholder="Email" aria-label="Email" type="email" autocomplete="email"></div><label class="hv-consent"><input type="checkbox" id="ldConsent"><span>I consent to receive calls and text messages from Chapter 3 Realty about my property inquiry, showing appointments, and listing information I requested, at the phone number provided, including calls placed using an automated system or an artificial or prerecorded voice. Message frequency varies. Message and data rates may apply. Reply HELP for help, STOP to opt out. Consent is not a condition of any purchase.</span></label><p id="ldErr" class="hv-err" role="alert"></p><button type="button" class="btn btn-brass btn-lg" onclick="ldSubmit()">Get my home value</button></div><div id="ldOk" class="hv-ok">Thanks. Tim Nash and the team will reach out the same day to talk through your home and start your market analysis. If it is evening, we still call.</div><p class="hv-disc">This valuation service may not be used for the purposes of obtaining financing in a federally related transaction.</p><script>function ldSubmit(){var cx=document.getElementById('ldCtx').value.trim(),n=document.getElementById('ldName').value.trim(),ph=document.getElementById('ldPhone').value.trim(),em=document.getElementById('ldEmail').value.trim(),c=document.getElementById('ldConsent').checked,err=document.getElementById('ldErr');function fail(m){err.textContent=m;err.style.display='block';}err.style.display='none';if(!cx||!n){fail('Add the property address and your name.');return;}if(!ph&&!em){fail('Add a phone number or an email so we can reach you.');return;}if(!c){fail('Check the consent box to send the request.');return;}c3SendForm({property_address:cx,name:n,phone:ph,email:em,consent:c?'yes':'no'},'home-value');document.getElementById('ldWrap').style.display='none';document.getElementById('ldOk').style.display='block';}</script></div></section><section style="background:var(--ivory-2)" id="home-value-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Home value FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What is my home worth in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Across Horry County, houses and other homes resold for a middle price of about $350,000 in the latest 12 months of county deeds, and condos for about $215,000. In the city of Conway the middle house sold for about $265,000, and inside North Myrtle Beach for about $535,000.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How accurate are online home estimates in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Close on some homes and far off on others. Redfin's figures for Horry County put its middle miss at 6.6 percent on homes not for sale, and 1.65 percent once a home is listed.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What is the difference between a CMA and an appraisal?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A CMA, a comparative market analysis, is an agent's pricing of your home from the sales most like it. An appraisal is a licensed appraiser's opinion of value. In South Carolina an agent's valuation must not be called an appraisal.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Why is my county assessed value different from my market value?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The county values every home at once, for tax, so it cannot see what one home has. The taxable value is often lower still: under state law it can rise only so far between sales. A sale resets it.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Are Myrtle Beach home prices dropping?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. By the Federal Housing Finance Agency's house price index, house prices in Horry County were about flat in the year to mid-2026, after rising about half from mid-2021 to mid-2025.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does a home valuation cost anything?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. Our valuation is free, and you do not have to list your home with us.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County deed index</a>, <a href="https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County parcels and flood zones</a>, <a href="https://www.fhfa.gov/data/hpi" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FHFA house price index</a>, <a href="https://www.redfin.com/redfin-estimate" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Redfin Estimate accuracy</a>, <a href="https://www.irs.gov/taxtopics/tc701" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">IRS Topic 701</a>, <a href="https://www.scstatehouse.gov/code/t12c037.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-37</a>, <a href="https://www.scstatehouse.gov/code/t12c024.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-24</a>, <a href="https://www.scstatehouse.gov/code/t12c008.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-8-580</a>, <a href="https://www.scstatehouse.gov/code/t40c060.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 40-60</a>. Sale prices: resale deeds recorded in the 12 months to September 2026, builders left out. "Near" a town means its mailing address, outside its limits. Houses include townhouses and a few condo-hotel units. Test: 4,919 house resales, January to September 2026. Not legal or tax advice.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Streets of two-story beach houses among trees behind the oceanfront at Crescent Beach in North Myrtle Beach, seen from a plane over the ocean. Photo: U.S. Geological Survey, <a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://doi.org/10.5066/F7N877XX" target="_blank" rel="noopener noreferrer">U.S. Geological Survey</a>.</div><div role="listitem">Chapter3 Realty resized these photos and cropped some of them.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/buyers/no-hoa/crescent-beach-streets-from-the-ocean-2011-1200w.webp","url":"https://chapter3realty.com/images/buyers/no-hoa/crescent-beach-streets-from-the-ocean-2011-1200w.webp","width":1200,"height":782,"encodingFormat":"image/webp","name":"Streets of two-story beach houses among trees behind the oceanfront at Crescent Beach in North Myrtle Beach, seen from a plane over the ocean","caption":"Crescent Beach in North Myrtle Beach from over the ocean in 2011: buildings on the beach, then streets of houses. Houses for sale within 0.1 mile of the ocean ask about 2.5 times as much a square foot as houses more than 2 miles away.","description":"Streets of two-story beach houses among trees behind the oceanfront at Crescent Beach in North Myrtle Beach, seen from a plane over the ocean","creator":{"@type":"Organization","name":"U.S. Geological Survey"},"creditText":"U.S","copyrightNotice":"Public domain (U.S. Geological Survey)","license":"https://www.usa.gov/publicdomain/label/1.0/","acquireLicensePage":"https://doi.org/10.5066/F7N877XX","isBasedOn":"https://doi.org/10.5066/F7N877XX","contentLocation":{"@type":"Place","name":"Crescent Beach, North Myrtle Beach, South Carolina"}}]}</script></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Ask what your home is worth.</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">Send the address. An agent calls you, and listing with us is your choice.</p><a class="btn btn-brass btn-lg" href="#lead-form">Get my home value</a></div></section></main>
