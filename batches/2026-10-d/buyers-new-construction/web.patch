index 0000000..bd304b1
--- /dev/null
+++ b/data/2026-10-d/buyers-new-construction/build_communities.py
@@ -0,0 +1,129 @@
+"""Where builders sold the most homes, community by community (fixer, review round 1, 2026-11-01).
+Builder sales are the verified set from verify_build_deeds.py (5,108 deeds, company names only). The community is the
+subdivision name written in each deed's memo ("LOT 12 SUB AUBERON WOODS PH 2"), with the phase, section and lot cut off.
+That is the plat name in the county's records; a builder may sell the community under a longer or different name.
+For each of the 10 communities with the most builder sales:
+  sales, the builders that recorded them, the middle deed price (county deeds, not MLS), the middle point of the parcels,
+  inside a city or not (county GIS layer 31 Municipalities, point in polygon on every parcel),
+  the nearest numbered highway or parkway (county GIS layer 17 Highways),
+  straight-line miles to the ocean (the coastline in Blog-Brain tools/geo/grand-strand-v2.json, Census TIGER/Line),
+  open space, common area and amenity sites on the plat (county GIS layer 24, LegalDescr starting with the name).
+Usage: python3 -I build_communities.py <this dir> [--fetch]   (--fetch reads layer 24 again; layers 17 and 31 are in raw/)
+Writes findings-communities.json."""
+import json, sys, os, re, math, statistics as st, collections, urllib.request, urllib.parse
+DOC = __doc__
+D = sys.argv[1]
+src = open(os.path.join(D, "verify_build_deeds.py")).read().split("out = {")[0]
+exec(src)  # defines b (builder deeds), P (parcels), k (all kept home sales)
+NORM = [("HORTON", "D.R. Horton"), ("LENNAR", "Lennar"), (r"\bNVR\b", "NVR (Ryan Homes)"), ("PULTE", "Pulte"), ("MERITAGE", "Meritage"),
+        ("CLAYTON PROPERTIES", "Clayton Properties"), ("GREAT SOUTHERN", "Great Southern Homes"), ("BEVERLY", "Beverly Homes"),
+        ("BEAZER", "Beazer"), ("STARLIGHT", "Starlight Homes"), ("TOLL", "Toll Brothers"), ("DREAM FINDERS", "Dream Finders"),
+        ("CHRIS MANNING", "Chris Manning"), ("CAROLINA COTTAGE", "Carolina Cottage Homes"), ("HOWELL", "Howell Homes")]
+def builder(n):
+    for pat, lab in NORM:
+        if re.search(pat, n or ""): return lab
+    return "other"
+def sub(m):
+    m = m or ""
+    s = re.search(r"\bSUB (.+)$", m)
+    if s: name = s.group(1)
+    else:
+        name = re.sub(r"^(LOT|UNIT|L)\s*[\w-]+\s*", "", m); name = re.sub(r"^TS [A-Z ]+", "", name).strip() or None
+    if not name: return None
+    name = re.sub(r"\b(PH(ASE)?|SEC(TION)?|SF|TR(ACT)?|BLK|BLOCK|POD|UNIT)\s*[\w-]*.*$", "", name).strip()
+    name = re.sub(r"\s+(\d+[A-Z]?|[IVX]+)$", "", name).strip()
+    return name.replace("CRESCENT COVE HAGUE MARINA", "CRESCENT COVE") or None
+G = collections.defaultdict(list)
+for d in b:
+    nm = sub(d["Comments"])
+    if nm: G[nm].append(d)
+top = sorted(G.items(), key=lambda kv: -len(kv[1]))[:10]
+
+# geometry helpers
+def pip(x, y, ring):
+    c = False; j = len(ring) - 1
+    for i in range(len(ring)):
+        xi, yi = ring[i]; xj, yj = ring[j]
+        if (yi > y) != (yj > y) and x < (xj - xi) * (y - yi) / (yj - yi) + xi: c = not c
+        j = i
+    return c
+def km(a, b):
+    R = 6371; t = math.pi / 180; dl = (b[1] - a[1]) * t; do = (b[0] - a[0]) * t
+    h = math.sin(dl / 2) ** 2 + math.cos(a[1] * t) * math.cos(b[1] * t) * math.sin(do / 2) ** 2
+    return 2 * R * math.asin(math.sqrt(h))
+def seg_km(p, a, b):
+    cx = math.cos(p[1] * math.pi / 180); ax, ay, bx, by, px, py = a[0] * cx, a[1], b[0] * cx, b[1], p[0] * cx, p[1]
+    dx, dy = bx - ax, by - ay; L = dx * dx + dy * dy
+    t = 0 if L == 0 else max(0, min(1, ((px - ax) * dx + (py - ay) * dy) / L))
+    return km(p, ((ax + t * dx) / cx, ay + t * dy))
+MUNI = json.load(open(os.path.join(D, "raw", "county-municipalities.json")))["features"]
+HWY = json.load(open(os.path.join(D, "raw", "county-highways.json")))["features"]
+flat = json.load(open(os.path.join(os.environ.get("BB", "/home/user/Blog-Brain"), "tools", "geo", "grand-strand-v2.json")))["region"]["coast"]
+coast = []; x = y = 0
+for i in range(0, len(flat), 2):
+    x += flat[i]; y += flat[i + 1]; coast.append((x / 1e4 - 80, y / 1e4 + 33))
+def muni(lon, lat):
+    for f in MUNI:
+        nm = f["attributes"]["NAME"]
+        if nm and any(pip(lon, lat, r) for r in f["geometry"]["rings"]): return nm
+    return None
+def highways(p):
+    best = {}
+    for f in HWY:
+        a = f["attributes"]; nm = a["NAME"]
+        if not nm: continue
+        for path in f["geometry"]["paths"]:
+            for i in range(len(path) - 1):
+                dkm = seg_km(p, path[i], path[i + 1])
+                if dkm < best.get(nm, 1e9): best[nm] = dkm
+    return sorted(([n, round(v / 1.609, 1)] for n, v in best.items()), key=lambda r: r[1])[:3]
+
+common_file = os.path.join(D, "raw", "community-plat-parcels.json")
+if "--fetch" in sys.argv or not os.path.exists(common_file):
+    CP = {}
+    for name, _ in top:
+        q = {"where": f"LegalDescr LIKE '{name}%'", "outFields": "PIN,LegalDescr,LandUseCode,Acreage", "returnGeometry": "false", "f": "json"}
+        u = "https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer/24/query?" + urllib.parse.urlencode(q)
+        feats = json.load(urllib.request.urlopen(u, timeout=90)).get("features", [])
+        CP[name] = [f["attributes"] for f in feats if re.search(r"OPEN SPACE|COMMON AREA|AMENIT|POOL|CLUB ?HOUSE|RECREATION|PARK\b|LAKE|POND", f["attributes"]["LegalDescr"] or "")]
+    json.dump({"source": "Horry County GIS MapServer layer 24 (Parcels), LegalDescr starting with the community name", "communities": CP}, open(common_file, "w"), indent=1)
+CP = json.load(open(common_file))["communities"]
+# postal city of each builder-sold parcel (county GIS layer 22 Addresses; only the postal city is kept, no street or number)
+addr_file = os.path.join(D, "raw", "community-postal-city.json")
+if "--fetch" in sys.argv or not os.path.exists(addr_file):
+    AC = {}
+    for name, ds in top:
+        pins = sorted(set(d["ParcelNumber"] for d in ds)); got = {}
+        for i in range(0, len(pins), 100):
+            q = {"where": "PIN IN (" + ",".join(pins[i:i + 100]) + ")", "outFields": "PIN,POSTAL_CITY", "returnGeometry": "false", "f": "json"}
+            req = urllib.request.Request("https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer/22/query", data=urllib.parse.urlencode(q).encode())
+            for f in json.load(urllib.request.urlopen(req, timeout=90)).get("features", []):
+                got[str(int(f["attributes"]["PIN"]))] = (f["attributes"]["POSTAL_CITY"] or "").strip().title()
+        AC[name] = got
+    json.dump({"source": "Horry County GIS MapServer layer 22 (Addresses), POSTAL_CITY by PIN", "communities": AC}, open(addr_file, "w"), indent=1)
+AC = json.load(open(addr_file))["communities"]
+
+out = {"note": DOC.split("\n")[0], "builder_sales": len(b), "with_a_community_name": sum(len(v) for v in G.values()),
+       "communities_named": len(G), "top10_sales": sum(len(v) for _, v in top), "communities": []}
+for name, ds in top:
+    ps = [P[d["ParcelNumber"]] for d in ds if P[d["ParcelNumber"]].get("lat")]
+    pts = [(p["lng"], p["lat"]) for p in ps]
+    mid = (st.median(p[0] for p in pts), st.median(p[1] for p in pts))
+    mc = collections.Counter(muni(*p) or "unincorporated" for p in pts)
+    oc = min(km(mid, c) for c in coast) / 1.609
+    cp = CP.get(name, [])
+    out["communities"].append({
+        "name": name, "sales": len(ds), "builders": collections.Counter(builder(d["DirectName"]) for d in ds).most_common(),
+        "median_price": st.median(d["Consideration"] for d in ds),
+        "price_quartiles": st.quantiles([d["Consideration"] for d in ds], n=4, method="inclusive"),
+        "mid": [round(mid[0], 4), round(mid[1], 4)], "municipality": mc.most_common(),
+        "nearest_highways_miles": highways(mid), "ocean_miles": round(oc, 1),
+        "plat_open_space_common_acres": round(sum((a["Acreage"] or 0) for a in cp if re.search(r"OPEN SPACE|COMMON AREA", a["LegalDescr"] or "")), 1),
+        "plat_amenity": [a["LegalDescr"] for a in cp if re.search(r"AMENIT|POOL|CLUB ?HOUSE|RECREATION", a["LegalDescr"] or "")],
+        "postal_city": collections.Counter(AC.get(name, {}).get(d["ParcelNumber"]) or "no address yet" for d in ds).most_common(),
+        "months": [min(d["mo"] for d in ds), max(d["mo"] for d in ds)],
+    })
+json.dump(out, open(os.path.join(D, "findings-communities.json"), "w"), indent=1)
+for c in out["communities"]:
+    print(c["sales"], c["name"], c["builders"][:3], c["median_price"], c["municipality"], c["nearest_highways_miles"], c["ocean_miles"], c["plat_open_space_common_acres"], c["plat_amenity"][:3], c["postal_city"][:3])
+print({k: v for k, v in out.items() if k != "communities"})
diff --git a/data/2026-10-d/buyers-new-construction/build_deeds.py b/data/2026-10-d/buyers-new-construction/build_deeds.py
new file mode 100644
index 0000000..53b9215
--- /dev/null
+++ b/data/2026-10-d/buyers-new-construction/build_deeds.py
@@ -0,0 +1,66 @@
+"""Deed findings from raw/deeds.json and raw/parcels.json.
+Kept deed: consideration over $10,000; exactly one 11-digit parcel; no tax-sale or court party ('DELINQUENT TAX', 'SHERIFF',
+'MASTER IN EQUITY'); memo without 'CORRECT' or 'RE-RECORD' and not naming several parcels, lots or tracts; parcel in the county
+layer with a residential land use code (starting with 1).
+Builder sale: grantor matches BUILDER (home builders that sell finished houses here) and the grantee does not (no builder-to-builder lot sales).
+Usage: python3 -I build_deeds.py <this dir> -> findings-deeds.json"""
+import json, sys, os, re, statistics as st, collections
+D = sys.argv[1]
+R = json.load(open(os.path.join(D, "raw", "deeds-slim.json" if os.path.exists(os.path.join(D, "raw", "deeds-slim.json")) else "deeds.json"))); P = json.load(open(os.path.join(D, "raw", "parcels.json")))["parcels"]
+BUILDER = re.compile(r"HORTON|LENNAR|\bNVR\b|PULTE|MERITAGE|CLAYTON PROPERTIES|GREAT SOUTHERN HOMES|BEVERLY HOMES|STARLIGHT HOMES|BEAZER|ASHTON CHARLESTON|TOLL SOUTHEAST|H & H CONSTRUCTORS|DRB GROUP|DREAM FINDERS|RS PARKER HOMES|HOWELL HOMES|MILLROSE|LEWIS CONSTRUCTION|CHRIS MANNING|CAROLINA COTTAGE|HUNTER QUINN|OCEAN PALMS BUILDERS|SANDS BUILDING|BRADLEY JONES|INFINITY CUSTOM|ALMOND QUALITY|CMH HOMES|AMERI BUILT|MUNGO|CPG INC|STANLEY MARTIN|CHESAPEAKE HOMES|ADAMS HOMES|ASHTON WOODS")
+OTHER_DEV = re.compile(r"BUILDERS?\b|CONSTRUCTION|CONSTRUCTORS|HOMES (INC|LLC)|HOMES OF|HOME BUILDERS|DEVELOPMENT")
+TAX = re.compile(r"DELINQUENT TAX|SHERIFF|MASTER IN EQUITY"); MEMO = re.compile(r"CORRECT|RE-RECORD|SEVERAL|PARCELS|TRACTS|\bLOTS\b|\d+ UNITS")
+deeds = R["deeds"]; steps = collections.OrderedDict(); steps["all deeds"] = len(deeds)
+k = [d for d in deeds if (d["Consideration"] or 0) > 10000]; steps["over $10,000"] = len(k)
+k = [d for d in k if re.fullmatch(r"\d{11}", d["ParcelNumber"] or "")]; steps["one parcel number"] = len(k)
+k = [d for d in k if not TAX.search((d["DirectName"] or "") + " " + (d["IndirectName"] or "")) and not MEMO.search(d["Comments"] or "")]; steps["not tax sale, corrective or multi-parcel memo"] = len(k)
+k = [d for d in k if d["ParcelNumber"] in P]; steps["parcel in county layer"] = len(k)
+k = [d for d in k if (P[d["ParcelNumber"]]["LandUseCode"] or "").startswith("1")]; steps["residential land use code"] = len(k)
+for d in k:
+    d["b"] = bool(BUILDER.search(d["DirectName"] or "")) and not BUILDER.search(d["IndirectName"] or "") and not OTHER_DEV.search(d["IndirectName"] or "")
+    d["dev"] = (not d["b"]) and bool(BUILDER.search(d["DirectName"] or "") or OTHER_DEV.search(d["DirectName"] or ""))
+    p = P[d["ParcelNumber"]]; d["imp0"] = (p["MarketImprv"] or 0) == 0; d["mo"] = d["RecordDate"][:7].replace("/", "-")
+b = [d for d in k if d["b"]]; nb = [d for d in k if not d["b"] and not d["dev"]]
+out = {"source": R["source"], "pulled": R["pulled"], "parcels_read": P and "raw/parcels.json", "steps": steps,
+       "builder_sales": len(b), "other_sales_not_builder_or_developer": len(nb), "developer_or_builder_to_builder": len([d for d in k if d["dev"]]),
+       "builder_share_pct": round(100 * len(b) / len(k), 1),
+       "builder_median_price": st.median([d["Consideration"] for d in b]), "other_median_price": st.median([d["Consideration"] for d in nb]),
+       "builder_price_quartiles": st.quantiles([d["Consideration"] for d in b], n=4, method="inclusive")}
+# by builder (grantor name normalized)
+def norm(n):
+    for pat, lab in [("HORTON", "D.R. Horton"), ("LENNAR", "Lennar"), (r"\bNVR\b", "NVR (Ryan Homes)"), ("PULTE", "Pulte"), ("MERITAGE", "Meritage"),
+                     ("CLAYTON PROPERTIES", "Clayton Properties"), ("GREAT SOUTHERN", "Great Southern Homes"), ("BEVERLY", "Beverly Homes"),
+                     ("BEAZER", "Beazer"), ("STARLIGHT", "Starlight Homes"), ("ASHTON CHARLESTON", "Ashton Woods"), ("TOLL", "Toll Brothers"),
+                     ("H & H", "H & H Constructors"), ("DRB", "DRB Group"), ("DREAM FINDERS", "Dream Finders"), ("RS PARKER", "RS Parker Homes")]:
+        if re.search(pat, n): return lab
+    return "other listed builders"
+c = collections.Counter(norm(d["DirectName"]) for d in b); out["by_builder"] = c.most_common()
+out["top5_share_of_builder_sales_pct"] = round(100 * sum(v for n, v in c.most_common(6) if n != "other listed builders") / len(b), 1)
+# county building value zero, by month of deed
+months = sorted(set(d["mo"] for d in b))
+out["builder_imp0_by_month"] = [{"month": m, "sales": len([d for d in b if d["mo"] == m]), "no_building_value": len([d for d in b if d["mo"] == m and d["imp0"]])} for m in months]
+q4 = [d for d in b if d["mo"] <= "2025-12"]; y26 = [d for d in b if d["mo"] >= "2026-01"]
+out["builder_imp0"] = {"all": [len([d for d in b if d["imp0"]]), len(b)], "deeds_oct_dec_2025": [len([d for d in q4 if d["imp0"]]), len(q4)],
+                       "deeds_jan_sep_2026": [len([d for d in y26 if d["imp0"]]), len(y26)]}
+z = [P[d["ParcelNumber"]] for d in y26 if d["imp0"]]
+out["builder_2026_imp0_land"] = {"n": len(z), "median_market_land": st.median([p["MarketLand"] or 0 for p in z]),
+                                 "median_price_of_those_deeds": st.median([d["Consideration"] for d in y26 if d["imp0"]])}
+# owner mailing state on builder-sold parcels (current owner; no names)
+sc = collections.Counter((P[d["ParcelNumber"]]["OwnerState"] or "").strip().upper() for d in b)
+out["builder_owner_state"] = {"SC": sc.get("SC", 0), "total": len(b), "top_other": [x for x in sc.most_common(8) if x[0] != "SC"]}
+# assessment ratio on builder-sold parcels with a building value (assessed / market)
+rat = collections.Counter()
+for d in b:
+    p = P[d["ParcelNumber"]]
+    if p["MarketImprv"] and p["MarketProp"]:
+        r = (p["AssessedProp"] or 0) / p["MarketProp"]; rat["4%" if abs(r - 0.04) < 0.004 else "6%" if abs(r - 0.06) < 0.004 else "other"] += 1
+out["builder_valued_assessment_ratio"] = dict(rat)
+# builder sales by tax district (ties a sale to a city or the unincorporated county)
+out["builder_by_taxdistrict"] = collections.Counter(P[d["ParcelNumber"]]["TaxDistrict"] for d in b).most_common(15)
+# how the county valued homes builders sold in Oct-Dec 2025 (first valued for tax year 2026): county market value / deed price
+v = [(P[d["ParcelNumber"]]["MarketProp"] or 0) / d["Consideration"] for d in q4 if not d["imp0"] and d["Consideration"] > 100000]
+out["q4_2025_builder_value_to_price"] = {"n": len(v), "median": round(st.median(v), 3), "quartiles": [round(x, 3) for x in st.quantiles(v, n=4, method="inclusive")]}
+out["q4_2025_builder_median_price"] = st.median([d["Consideration"] for d in q4])
+out["q4_2025_builder_median_county_value"] = st.median([P[d["ParcelNumber"]]["MarketProp"] or 0 for d in q4])
+json.dump(out, open(os.path.join(D, "findings-deeds.json"), "w"), indent=1)
