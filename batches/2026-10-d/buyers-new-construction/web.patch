+#!/bin/sh
+# HOA fee of new-construction houses for sale, counted in aggregate (fixer, review round 1). The CRM map API's hoa=0 is
+# "no HOA fee" and hoaMax=N is "HOA fee up to N dollars a month" (idx-lib/filters.js labels it "Up to $N a month"; hoaMax
+# includes the houses with no fee). Whole MLS feed, not cut to Horry County. Usage: sh pull_hoa.sh <this dir>
+OUT="$1/raw/listings-hoa-totals.txt"; date -u +%Y-%m-%dT%H:%MZ > "$OUT"
+for q in "type=house&has=new_construction" "type=house&has=new_construction&hoa=0" "type=house&has=new_construction&hoaMax=50" "type=house&has=new_construction&hoaMax=100" "type=house&has=new_construction&hoaMax=150" "type=house&has=new_construction&hoaMax=200" "type=house&has=new_construction&hoaMax=300"; do
+  echo "$q $(curl -sS -m 30 "https://chapter3realty.com/homes/api/map?$q" | python3 -c 'import json,sys;print(json.load(sys.stdin)["total"])')" >> "$OUT"
+done
+cat "$OUT"
diff --git a/data/2026-10-d/buyers-new-construction/pull_listings.py b/data/2026-10-d/buyers-new-construction/pull_listings.py
new file mode 100644
index 0000000..91d1082
--- /dev/null
+++ b/data/2026-10-d/buyers-new-construction/pull_listings.py
@@ -0,0 +1,58 @@
+"""Active for-sale listings from the CRM's public map API (CCMLS feed), counted in aggregate only.
+Pulls (1) every house and townhouse flagged new construction, (2) every house built 2016 to 2023
+that is not flagged new construction (the nearly-new resale comparison), (3) every house for sale, for the share, (4) totals for counts
+(all houses, new-never-occupied, each builder filter). Splits price bands until every pin comes back
+(the API returns at most 144 pins per search).
+Saved per listing: MLS number (to drop duplicates), type, price, beds, sqft, acres, year (from the "Built YYYY" tag),
+city (the mailing city in the address, no street), lat, lng. No street, photo or firm is saved.
+Usage: python3 -I pull_listings.py <this dir>  -> raw/listings.json"""
+import json, sys, os, time, urllib.request, urllib.parse, datetime, re
+D = sys.argv[1]
+BASE = "https://chapter3realty.com/homes/api/map?"
+calls = 0
+def get(p):
+    global calls; calls += 1
+    url = BASE + urllib.parse.urlencode(p)
+    for i in range(5):
+        try:
+            d = json.load(urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"}), timeout=60))
+            if d.get("ok"): return d
+        except Exception: pass
+        time.sleep(4)
+    raise SystemExit("failed " + url)
+def num(s):
+    try: return float(str(s).replace("$", "").replace(",", ""))
+    except Exception: return None
+def city(addr):
+    parts = [x.strip() for x in (addr or "").split(",")]
+    return parts[-3] if len(parts) >= 3 else None
+def band(q, lo, hi, acc, trunc):
+    d = get(dict(q, min=lo, max=hi))
+    if d["total"] > len(d["pins"]) and hi - lo > 500:
+        mid = (lo + hi) // 2; band(q, lo, mid, acc, trunc); band(q, mid + 1, hi, acc, trunc); return
+    if d["total"] > len(d["pins"]): trunc.append([q, lo, hi, d["total"], len(d["pins"])])
+    for p in d["pins"]:
+        m = re.search(r"Built (\d{4})", p.get("tag") or "")
+        acc[p["mls"]] = {"type": q["type"], "price": num(p["price"]), "beds": p.get("beds"), "sqft": p.get("sqft"),
+                         "acres": num(p.get("acres")), "year": int(m.group(1)) if m else None, "city": city(p.get("addr")),
+                         "lat": p.get("lat"), "lng": p.get("lng")}
+out = {"pulled": datetime.datetime.utcnow().isoformat() + "Z", "api": BASE, "sets": {}, "totals": {}, "truncated": []}
+SETS = {
+  "new_house": {"type": "house", "has": "new_construction"},
+  "new_townhouse": {"type": "townhouse", "has": "new_construction"},
+  "nearlynew_house": {"type": "house", "not": "new_construction", "yearMin": "2016", "yearMax": "2023"},
+  "all_house": {"type": "house"},
+}
+for k, q in SETS.items():
+    acc = {}; band(q, 0, 6000000, acc, out["truncated"]); out["sets"][k] = {"query": q, "total_reported": get(q)["total"], "homes": acc}
+    print(k, len(acc), out["sets"][k]["total_reported"], flush=True)
+T = {"house_all": {"type": "house"}, "townhouse_all": {"type": "townhouse"}, "condo_all": {"type": "condo"}, "all_types": {},
+     "new_all_types": {"has": "new_construction"}, "new_never_occupied_all": {"has": "quick_move_in"},
+     "new_never_occupied_house": {"type": "house", "has": "quick_move_in"}, "new_condo": {"type": "condo", "has": "new_construction"}}
+for b in ["dr_horton", "lennar", "bradley_jones", "beverly", "mungo", "beazer", "meritage", "stanley_martin", "pulte", "ryan", "chesapeake",
+          "dream_finders", "clayton", "adams", "starlight", "great_southern", "ashton_woods"]:
+    T["builder_" + b] = {"has": "new_construction,builder_" + b}
+for k, q in T.items(): out["totals"][k] = {"query": q, "total": get(q)["total"]}
+out["calls"] = calls
+json.dump(out, open(os.path.join(D, "raw", "listings.json"), "w"))
+print(json.dumps(out["totals"]), "calls", calls, "trunc", out["truncated"])
diff --git a/data/2026-10-d/buyers-new-construction/pull_parcels.py b/data/2026-10-d/buyers-new-construction/pull_parcels.py
new file mode 100644
index 0000000..a43d3a9
--- /dev/null
+++ b/data/2026-10-d/buyers-new-construction/pull_parcels.py
@@ -0,0 +1,34 @@
+"""County parcel record (Horry County GIS MapServer layer 24, Parcels) for every parcel on a priced deed in raw/deeds.json.
+Saves land use code, county market land and building values, assessed and taxable value, legal description,
+tax district, owner mailing state (no owner name or street) and a center point.
+Usage: python3 -I pull_parcels.py <this dir> -> raw/parcels.json"""
+import json, sys, os, time, re, urllib.request, urllib.parse, datetime
+D = sys.argv[1]
+Q = "https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer/24/query"
+deeds = json.load(open(os.path.join(D, "raw", "deeds.json")))["deeds"]
+pins = sorted(set(d["ParcelNumber"] for d in deeds if (d["Consideration"] or 0) > 10000 and re.fullmatch(r"\d{11}", d["ParcelNumber"] or "")))
+print("pins", len(pins), flush=True)
+F = "PIN,PINtext,LandUseCode,MarketLand,MarketImprv,MarketProp,AssessedProp,TaxableProp,LegalDescr,TaxDistrict,OwnerState,SaleDate,Acreage,MarketArea,MarketSubArea"
+out = {}
+def post(p):
+    for k in range(6):
+        try:
+            d = json.loads(urllib.request.urlopen(urllib.request.Request(Q, data=urllib.parse.urlencode(p).encode(), headers={"User-Agent": "Mozilla/5.0"}), timeout=120).read())
+            if "error" in d: raise Exception(d["error"])
+            return d
+        except Exception as e:
+            print("retry", e, file=sys.stderr); time.sleep(5)
+    raise SystemExit("failed")
+for i in range(0, len(pins), 150):
+    chunk = pins[i:i + 150]
+    d = post({"where": "PIN IN (" + ",".join(chunk) + ")", "outFields": F, "returnGeometry": "true", "outSR": "4326",
+              "maxAllowableOffset": "0.0002", "geometryPrecision": "5", "f": "json"})
+    for f in d["features"]:
+        a = f["attributes"]; g = f.get("geometry") or {}
+        pts = [p for r in g.get("rings", []) for p in r]
+        a["lng"] = round(sum(p[0] for p in pts) / len(pts), 5) if pts else None
+        a["lat"] = round(sum(p[1] for p in pts) / len(pts), 5) if pts else None
+        out["%011d" % int(a["PIN"])] = a
+    if i % 3000 == 0: print(i, len(out), flush=True)
+json.dump({"source": Q, "read": datetime.datetime.utcnow().isoformat() + "Z", "fields": F, "parcels": out}, open(os.path.join(D, "raw", "parcels.json"), "w"))
+print("parcels", len(out))
