@@ -0,0 +1,21 @@
+"""Review round 2: the search each community card links to (/homes/map/?<q>), checked against the CRM's public
+map API (active listings, counted in aggregate) so that every house it finds is within 1.5 miles of the
+community's middle point (findings-communities.json). Usage: python3 -I pull_community_links.py <this dir>"""
+import json, math, sys, os, urllib.request
+D = sys.argv[1]
+C = {c["name"]: c for c in json.load(open(os.path.join(D, "findings-communities.json")))["communities"]}
+Q = {"AUBERON WOODS": "subdivision=Auberon+Woods", "GRANDE DUNES NORTH": "subdivision=Grande+Dunes&city=Longs",
+     "ARCADIA": "subdivision=Arcadia&near=33.709%2C-79.0044&miles=1.5", "WATERSIDE NEIGHBORHOOD": "subdivision=Waterside&city=Longs",
+     "INDIGO GROVE": "subdivision=The+Overlook", "CHESTNUT GREENS": "subdivision=Del+Webb&city=North+Myrtle+Beach",
+     "CYPRESS RIDGE": "subdivision=Cypress+Ridge", "KINGSTON OAKS": "subdivision=Kingston+Oaks", "CRESCENT COVE": "subdivision=Crescent+Cove",
+     "EDEN SPRINGS": "subdivision=Eden+Springs"}
+mi = lambda a, b, c, d: math.hypot((a - c) * 69 * math.cos(math.radians(34)), (b - d) * 69)
+out = {}
+for name, q in Q.items():
+    u = "https://chapter3realty.com/homes/api/map?type=house&" + q
+    d = json.load(urllib.request.urlopen(urllib.request.Request(u, headers={"User-Agent": "Mozilla/5.0"}), timeout=40))
+    lo, la = C[name]["mid"]
+    far = max([mi(p["lng"], p["lat"], lo, la) for p in d["pins"]] or [0])
+    out[name] = {"q": q, "total": d["total"], "farthest_miles": round(far, 2)}
+    print(name, out[name])
+json.dump({"pulled": "2026-11-01", "source": "https://chapter3realty.com/homes/api/map", "links": out}, open(os.path.join(D, "raw", "community-links.json"), "w"), indent=1)
diff --git a/data/2026-10-d/buyers-new-construction/pull_deeds.py b/data/2026-10-d/buyers-new-construction/pull_deeds.py
new file mode 100644
index 0000000..9e8e79d
--- /dev/null
+++ b/data/2026-10-d/buyers-new-construction/pull_deeds.py
@@ -0,0 +1,33 @@
+"""Every deed (Doc Type DEED (001), value 138) recorded in Horry County from 2025-10-01 to 2026-09-30,
+from the Register of Deeds' public index (AcclaimWeb), searched week by week, results read from the grid JSON.
+Then the county parcel record (GIS MapServer layer 24) for every parcel on a priced deed.
+Usage: python3 -I pull_deeds.py <this dir> -> raw/deeds.json, raw/parcels.json"""
+import json, sys, os, time, datetime, urllib.request, urllib.parse, http.cookiejar
+D = sys.argv[1]
+B = "https://acclaimweb.horrycounty.org/AcclaimWeb"
+cj = http.cookiejar.CookieJar(); op = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cj))
+UA = {"User-Agent": "Mozilla/5.0", "X-Requested-With": "XMLHttpRequest"}
+def req(url, data=None, tries=5):
+    for i in range(tries):
+        try:
+            r = op.open(urllib.request.Request(url, data=urllib.parse.urlencode(data).encode() if data else None, headers=UA), timeout=120)
+            return r.read()
+        except Exception as e:
+            print("retry", url, e, file=sys.stderr); time.sleep(5)
+    raise SystemExit("failed " + url)
+req(B + "/Search/Disclaimer?st=/AcclaimWeb/search/SearchTypeDocType", {"disclaimer": "true"})
+start, end = datetime.date(2025, 10, 1), datetime.date(2026, 9, 30)
+deeds, weeks = [], []
+d0 = start
+while d0 <= end:
+    d1 = min(d0 + datetime.timedelta(days=6), end)
+    f = lambda d: f"{d.month}/{d.day}/{d.year}"
+    req(B + "/search/SearchTypeDocType?Length=6", {"DocTypes": "138", "DocTypesDisplay": "DEED (001)", "DateRangeList": " ", "RecordDateFrom": f(d0), "RecordDateTo": f(d1)})
+    g = json.loads(req(B + "/Search/GridResults", {"page": "1", "size": "5000"}))
+    if g["Total"] != len(g["Data"]): raise SystemExit(f"short page {d0} {g['Total']} {len(g['Data'])}")
+    for r in g["Data"]:
+        deeds.append({k: r.get(k) for k in ["BookPage", "RecordDate", "Consideration", "DirectName", "IndirectName", "Comments", "ParcelNumber"]})
+    weeks.append([str(d0), str(d1), g["Total"]]); print(d0, g["Total"], len(deeds), flush=True)
+    d0 = d1 + datetime.timedelta(days=1); time.sleep(1)
+json.dump({"source": B + "/search/SearchTypeDocType", "doc_type": "DEED (001)", "from": str(start), "to": str(end),
+           "pulled": datetime.datetime.utcnow().isoformat() + "Z", "weeks": weeks, "deeds": deeds}, open(os.path.join(D, "raw", "deeds.json"), "w"))
