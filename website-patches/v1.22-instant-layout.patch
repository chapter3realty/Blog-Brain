+  }
+  function show(k) {
+    if (!shapes[k]) return;
+    sk = document.createElement('div'); sk.className = 'c3-sk' + (k === 'map' ? ' c3-sk-full' : ''); sk.setAttribute('aria-hidden', 'true');
+    var h = document.querySelector('header'); sk.style.top = (h ? Math.max(0, Math.round(h.getBoundingClientRect().bottom)) : 0) + 'px';
+    sk.innerHTML = shapes[k]; document.body.appendChild(sk);
+    requestAnimationFrame(function () { if (sk) sk.classList.add('c3-sk-on'); });
+  }
+  /* go(url): start the bar, and the layout of the page at url if it is slow. Also used by the map. */
+  function go(href) {
+    clear();
+    var u; try { u = new URL(href || location.href, location.href); } catch (x) { u = null; }
+    var k = u ? kind(u) : '';
+    if (!bar) { bar = document.createElement('div'); bar.className = 'c3-go'; document.body.appendChild(bar); }
+    void bar.offsetWidth; bar.classList.add('c3-go-on');
+    // Our own pages come in quickly; the home search asks the MLS, so its layout shows sooner.
+    if (k) timer = setTimeout(function () { show(k); }, k === 'page' ? 260 : 90);
+    gone = setTimeout(clear, 15000);
+  }
+  window.hxGo = go;
+  function ours(u) { return u.origin === location.origin && !(u.pathname === location.pathname && u.search === location.search); }
+  document.addEventListener('click', function (e) {
+    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+    var a = e.target.closest && e.target.closest('a[href]');
+    if (!a || (a.target && a.target !== '_self') || a.hasAttribute('download')) return;
+    var u; try { u = new URL(a.href, location.href); } catch (x) { return; }
+    if (!/^https?:$/.test(u.protocol) || !ours(u)) return;
+    // After the page's own handlers: a click one of them cancels (a heart, a popup) shows nothing.
+    setTimeout(function () { if (!e.defaultPrevented) go(u.href); }, 0);
+  });
+  document.addEventListener('submit', function (e) {
+    var f = e.target;
+    if (e.defaultPrevented || !f || (f.method || 'get').toLowerCase() !== 'get' || (f.target && f.target !== '_self')) return;
+    var u; try { u = new URL(f.action || location.href, location.href); } catch (x) { return; }
+    if (u.origin === location.origin) setTimeout(function () { if (!e.defaultPrevented) go(u.href); }, 0);
+  });
+  addEventListener('pageshow', clear);
+})();
+</script>
