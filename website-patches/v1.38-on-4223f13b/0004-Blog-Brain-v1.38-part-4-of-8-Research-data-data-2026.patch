+			<td style valign="bottom">&nbsp;</td>
+			<td align="left" style valign="bottom">New roof</td>
+			<td align="right" style valign="bottom">1,600</td>
+			<td align="right" style valign="bottom">&nbsp;</td>
+		</tr>
+		<tr valign="top">
+			<td style valign="bottom">&nbsp;</td>
+			<td align="left" style valign="bottom">Patio and deck</td>
+			<td align="right" style valign="bottom"><u>2,400</u></td>
+			<td align="right" style valign="bottom">&nbsp;</td>
+		</tr>
+		<tr valign="bottom">
+			<td style valign="bottom">&nbsp;</td>
+			<td align="left" style valign="bottom"><span class="bold"><strong>Adjusted basis</strong></span></td>
+			<td align="right" style valign="bottom">$39,000</td>
