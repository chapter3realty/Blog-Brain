+  </div>
+    </div>
+  </div>
+      
+        </div>
+        <div class="col-lg-6">
+         
+            <div class="field field--name-field-column-two field--type-entity-reference-revisions field--label-hidden field__item">      <div id="column-container-14261" class="paragraph paragraph--id--14261 paragraph--type--column-container paragraph--view-mode--default column-container">
