+	/**
+	 * Push apply_occupancy_options event to dataLayer (with debounce per category)
+	 */
+	function pushOccupancyEvent(category, value) {
+		if (!category || value === null || value === undefined || value === '') {
+			return;
+		}
+		
+		// Debounce per category to prevent duplicates
+		var now = Date.now();
+		var lastTime = lastEventTime[category] || 0;
+		if (now - lastTime < debounceMs) {
+			return;
+		}
+		lastEventTime[category] = now;
