+			<td align="left" style valign="bottom"><span class="bold"><strong>Net rental income for house</strong></span></td>
+			<td align="right" style valign="bottom">&nbsp;</td>
+			<td align="right" style valign="bottom">$3,694</td>
+		</tr>
+		<tr>
