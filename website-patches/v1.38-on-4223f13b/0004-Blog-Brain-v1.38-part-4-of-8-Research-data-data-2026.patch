@@ -0,0 +1,38 @@
+# Data for /buyers/waterfront-homes/ (batch 2026-11-a)
+
+Every number on the page comes from these files. Ledger: Blog-Brain `batches/2026-11-a/buyers-waterfront-homes/facts.md`.
+
+| File | What | Made by |
+|---|---|---|
+| findings.json | Every derived number: homes whose lot touches each county water outline, by stretch and kind; vacant house lots on the water; house sales on the water against house sales within 1 km not on it (deeds 2025-10-01 to 2026-09-30); active listings on the water in aggregate (counts, middle asking price, price per square foot, dock share, no-HOA count); NFIP policy cost by zone for single-family homes in 11 waterfront ZIPs; tide ranges; bridge counts | analyze.py |
+| chart-sales.json | Middle sale price on the water and nearby, by water and stretch | analyze.py |
+| chart-tides.json | Mean tide range in 2026 at nine NOAA stations, by kind of water | analyze.py |
+| chart-listings.json | Waterfront houses for sale by the water each listing names; the dock comparison on tidal water and rivers | analyze.py |
+| map-water.geojson | County water outlines (waterway, Waccamaw, House Creek with the Cherry Grove channels, Little River, Dunn Sound), the crossings, the tide stations, two inlet label points | analyze.py |
+| bridges.json | Every crossing of the waterway from the state line to Socastee: mile, kind, closed clearance, the Coast Pilot quote, a map position | typed from NOAA Coast Pilot 4 ch. 12 (each row carries its quote); positions from county road lines |
+| raw/tides-2026.json | NOAA CO-OPS high and low predictions for 2026, summarised per station | pull_tides.py |
+| raw/google-suggestions.txt | Google search suggestions for 66 queries | pull-suggestions.sh |
+| raw/coastpilot4-*.txt | Text of the Coast Pilot paragraphs used (ch. 12 channels and Little River to the Waccamaw; ch. 6 inlets) | pypdf from the NOAA PDFs |
+| raw/ecfr-117911.txt, raw/cfr117911-2025.txt, raw/cfr1175.txt | 33 CFR 117.911 as of 2026-11-01 (eCFR versioner API) and the July 2025 edition; 33 CFR 117.5 | curl |
+| raw/scdes-*.txt | SCDES Bureau of Coastal Management pages: FAQ, minor activities, general permits, amendments, dock master plans, extensions and transfers | curl |
+| raw/sc-regs-30-12A-docks.txt | S.C. Code of Regulations R.30-12(A), docks and piers | pypdf from scstatehouse.gov Chapter 30 |
+| raw/sc-code-48-39-excerpts.txt | S.C. Code 48-39-10, -130, -140, -145, -150 | curl scstatehouse.gov |
+| raw/dph-restructuring.txt | SC DPH page on the DHEC split of July 1, 2024 | curl |
+
+Inputs from other folders: kept home sales `data/2026-10-d/sell-out-of-state-buyers/out-of-state-buyers.json` (Horry County deeds recorded 2025-10-01 to 2026-09-30). Figures reused from sibling ledgers (not recomputed here): Cherry Grove channel houses and sales (North Myrtle Beach rows 13, 14), deeded slips (Little River rows 12 to 14), flood policy cost countywide (Common Mistakes row 28).
+
+Kept out of the repo (PINs, legal descriptions, MLS numbers or size), in RAW: hydro.json (county layer 21), water-parcels.json (layer 24 parcels within 15 m of the tidal and river water polygons), sale-shapes.json (layer 24 outlines for house sales within 600 m of the water), roads-icw.json (county road lines that touch the waterway and Waccamaw polygons), listings-water.json (CRM pull, aggregate use only) and nfip-policies-sf.json (OpenFEMA rows).
+
+To rerun:
+
+```
+export RAW=<scratch dir>
+python3 -I fetch_county.py          # SALES defaults to ../../2026-10-d/sell-out-of-state-buyers/out-of-state-buyers.json
+python3 -I pull_listings.py
+python3 -I pull_fema.py
+python3 -I pull_tides.py .
+sh pull-suggestions.sh > raw/google-suggestions.txt
+python3 -I analyze.py .
+```
+
+analyze.py needs shapely 2. findings.json carries no names, addresses, PINs, deed book and page, or MLS numbers.
diff --git a/data/2026-11-b/buyers-waterfront-homes/from-2026-11-a/analyze.py b/data/2026-11-b/buyers-waterfront-homes/from-2026-11-a/analyze.py
new file mode 100644
index 00000000..9b355d07
--- /dev/null
+++ b/data/2026-11-b/buyers-waterfront-homes/from-2026-11-a/analyze.py
@@ -0,0 +1,192 @@
+#!/usr/bin/env python3
+"""Every derived number for /buyers/waterfront-homes/. Run: RAW=<scratch> SALES=<out-of-state-buyers.json> python3 -I analyze.py <datadir>
+Reads RAW/water-parcels.json, RAW/sale-shapes.json, RAW/hydro.json (fetch_county.py), RAW/listings-water.json (pull_listings.py),
+RAW/nfip-policies-sf.json (pull_fema.py), <datadir>/raw/tides-2026.json (pull_tides.py), <datadir>/bridges.json.
+Writes <datadir>/findings.json and the chart files chart-*.json. No addresses, PINs, owner names or MLS numbers are written."""
+import json, os, sys, math, statistics, collections, datetime
+from shapely.geometry import Polygon, Point
+from shapely.ops import unary_union
+from shapely import affinity
+D = sys.argv[1]; RAW = os.environ["RAW"]
+SALES = os.environ.get("SALES", os.path.join(D, "..", "..", "2026-10-d", "sell-out-of-state-buyers", "out-of-state-buyers.json"))
+J = lambda n: json.load(open(os.path.join(RAW, n)))
+K = math.cos(math.radians(33.75))
+proj = lambda g: affinity.scale(g, xfact=111320 * K, yfact=110950, origin=(0, 0))   # metres, good to about 1 percent here
+med = lambda a: statistics.median(a) if a else None
+def q(a):
+    a = sorted(a)
+    if len(a) < 4: return {"n": len(a), "median": med(a)}
+    qq = statistics.quantiles(a, n=4); return {"n": len(a), "median": med(a), "q1": qq[0], "q3": qq[2]}
+HOUSE_LU = {"100", "101", "102", "110", "126"}
+def kind(a):
+    lu = str(a.get("LandUseCode")); ld = (a.get("LegalDescr") or "").upper()
+    if lu in ("107", "135") or "HPR" in ld or " UNIT" in ld: return "condo"
+    if lu in ("120", "121", "122", "130"): return "manufactured"
+    if lu == "109": return "townhouse"
+    if lu in HOUSE_LU: return "house"
+    return "other"
+LABEL = {"Intracoastal Waterway": "Intracoastal Waterway", "HOUSE CREEK": "Cherry Grove channels (House Creek)", "Waccamaw River": "Waccamaw River"}
+def stretch(y, x, water):
+    if water != "Intracoastal Waterway": return LABEL.get(water, water)
+    if y >= 33.81: return "Waterway: Little River and North Myrtle Beach"
+    if y >= 33.725: return "Waterway: Myrtle Beach and Carolina Forest"
+    return "Waterway: Socastee"
+out = {"made": datetime.datetime.now(datetime.timezone.utc).isoformat()}
+
+# 1. Homes whose lot touches the county's water outline (layer 21), countywide
+hydro = J("hydro.json")
+W = collections.defaultdict(list)
+for h in hydro:
+    n = h["attributes"]["NAME"]
+    if n.strip(): W[n].append(unary_union([Polygon(r).buffer(0) for r in h["geometry"]["rings"]]))
+W = {n: unary_union(v) for n, v in W.items()}
+WP = {n: proj(g) for n, g in W.items()}
+wp = J("water-parcels.json")
+homes = [x for x in wp if str(x["LandUseCode"]).startswith("1") and (x.get("MarketImprv") or 0) > 0]
+def centre(x):
+    try: c = unary_union([Polygon(r).buffer(0) for r in x["g"]["rings"]]).centroid; return c.y, c.x
+    except Exception: return None, None
+cnt = collections.Counter(); lots = collections.Counter()
+for x in homes:
+    y, xx = centre(x)
+    if y is None: continue
+    cnt[(stretch(y, xx, x["water"][0]), kind(x))] += 1
+for x in wp:
+    if str(x["LandUseCode"]).startswith("1") and not (x.get("MarketImprv") or 0) > 0:
+        y, xx = centre(x)
+        if y is not None: lots[stretch(y, xx, x["water"][0])] += 1
+by = collections.defaultdict(dict)
+for (s, k), n in cnt.items(): by[s][k] = n
+out["homes_on_water"] = {"rule": "a parcel with a county land-use code starting with 1 and a building value above 0 whose outline comes within 15 m of a polygon in the county's hydrography layer (parcelapp layer 21). Murrells Inlet's creeks, the Garden City and Pawleys marsh creeks and the lakes are not in that layer, so their homes are not counted.",
+    "by_stretch": dict(by), "houses_total": sum(n for (s, k), n in cnt.items() if k == "house"), "all_homes_total": sum(cnt.values()),
+    "vacant_residential_lots_by_stretch": dict(lots), "water_bodies_in_layer": sorted({h["attributes"]["NAME"] for h in hydro})}
+
+# 2. House sales on the water vs. nearby, county deeds 2025-10-01 to 2026-09-30 (2026-10-d kept sales)
+sales = json.load(open(SALES))["sales"]
+shapes = {int(x["PIN"]): x for x in J("sale-shapes.json")}
+rows = []
+for s in sales:
+    if s.get("condo") or not s.get("lat"): continue
+    p = int(s["pin"]); sh = shapes.get(p)
+    if not sh or str(sh["LandUseCode"]) not in HOUSE_LU or not sh.get("g"): continue
+    g = proj(unary_union([Polygon(r).buffer(0) for r in sh["g"]["rings"]]))
+    d = {n: g.distance(w) for n, w in WP.items() if n in LABEL}
+    n = min(d, key=d.get)
+    rows.append({"price": s["cons"], "builder": s["builder"], "lat": s["lat"], "lon": s["lon"], "water": n if d[n] <= 15 else None, "near": n, "dist": d[n], "pt": proj(Point(s["lon"], s["lat"]))})
+sale_out = {}
+for n in LABEL:
+    on = [r for r in rows if r["water"] == n and r["price"] >= 10000]
+    off = [r for r in rows if r["water"] is None and r["price"] >= 10000 and any(r["pt"].distance(o["pt"]) <= 1000 for o in on)]
+    sale_out[LABEL[n]] = {"on_water": q([r["price"] for r in on]), "on_water_builder": sum(r["builder"] for r in on), "on_water_under_10000_dropped": sum(1 for r in rows if r["water"] == n and r["price"] < 10000),
+                          "within_1km_not_on_water": q([r["price"] for r in off]),
