+</div>
+              <div class="field__item">  <div class="paragraph paragraph--type--accordion-container paragraph--view-mode--default">
+          
+            <div class="clearfix text-formatted field field--name-field-paragraph-title field--type-text field--label-hidden field__item">Frequently asked questions</div>
+      
+      <div class="accordion field field--name-field-accordions field--type-entity-reference-revisions field--label-hidden field__items" id="adhoc-html-accordion-paragraph-23731-field-accordions">
