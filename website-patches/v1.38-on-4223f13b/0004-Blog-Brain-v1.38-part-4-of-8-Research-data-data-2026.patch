+                  <h2 class="accordion-header accordion-header-hover my-0" id="heading-23721">
+          <button class="accordion-button py-4 collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-23721" aria-expanded="false" aria-controls="collapse-23721">
+            <span class="text-holder">
+            Filing returns (directly or â€‹through a property â€‹management company)â€‹
+            </span>
+            <span class="icon-holder">
+                <svg height="12" width="12" aria-hidden="true" focusable="false">
+                <line y1="0" y2="12" x1="6" x2="6"  stroke-width="3" class="accordion_icon vertical-line collapsed" />
+                <line  x1="0" x2="12" y1="6" y2="6"  stroke-width="3" class="accordion_icon"  />
