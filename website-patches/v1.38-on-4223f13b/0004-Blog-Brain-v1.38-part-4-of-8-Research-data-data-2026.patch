+			<td align="right" style valign="bottom">92</td>
+			<td align="right" style valign="bottom">&nbsp;</td>
+		</tr>
+		<tr valign="top">
+			<td align="left" style valign="top">Miscellaneous repairs</td>
+			<td align="right" style valign="bottom">297</td>
+			<td align="right" style valign="bottom">&nbsp;</td>
+		</tr>
+		<tr valign="top">
+			<td align="left" style valign="top">Real estate taxes ($1,200 Ã— <sup>11</sup>/<sub>12</sub>)</td>
+			<td align="right" style valign="bottom"><u>1,100</u></td>
+			<td align="right" style valign="bottom">&nbsp;</td>
+		</tr>
+		<tr valign="top">
+			<td align="left" colspan="2" style valign="top">Total expenses</td>
+			<td align="right" style valign="bottom"><u>3,139</u></td>
+		</tr>
+		<tr valign="top">
+			<td align="left" colspan="2" style valign="top">Balance</td>
+			<td align="right" style valign="bottom">$5,111</td>
+		</tr>
+		<tr valign="top">
+			<td align="left" style valign="top">Minus: Depreciation</td>
+			<td align="right" style valign="bottom">&nbsp;</td>
+			<td align="right" style valign="bottom">&nbsp;</td>
+		</tr>
+		<tr valign="top">
+			<td align="left" style valign="top">House ($39,000 Ã— 0.03182)</td>
+			<td align="right" style valign="bottom">$1,241</td>
+			<td align="right" style valign="bottom">&nbsp;</td>
+		</tr>
+		<tr valign="top">
+			<td align="left" style valign="top">Dishwasher ($425 Ã— 0.20)</td>
+			<td align="right" style valign="bottom">85</td>
+			<td align="right" style valign="bottom">&nbsp;</td>
+		</tr>
+		<tr valign="top">
+			<td align="left" style valign="top">Furnace ($4,000 Ã— 0.02273)</td>
+			<td align="right" style valign="bottom"><u>91</u></td>
