+    x, y = (s.get("lon"), s.get("lat")) if s.get("lon") else pinpt.get(s["pin"], (None, None))
+    a = area_of(x, y)
+    if not a: continue
+    if s["builder"]: hb[a + "|" + k] += 1; continue
