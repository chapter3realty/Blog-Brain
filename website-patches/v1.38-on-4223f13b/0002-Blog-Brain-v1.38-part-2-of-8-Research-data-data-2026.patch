index 00000000..53b92159
--- /dev/null
+++ b/data/2026-10-d/buyers-new-construction/build_deeds.py
@@ -0,0 +1,66 @@
+"""Deed findings from raw/deeds.json and raw/parcels.json.
+Kept deed: consideration over $10,000; exactly one 11-digit parcel; no tax-sale or court party ('DELINQUENT TAX', 'SHERIFF',
+'MASTER IN EQUITY'); memo without 'CORRECT' or 'RE-RECORD' and not naming several parcels, lots or tracts; parcel in the county
+layer with a residential land use code (starting with 1).
+Builder sale: grantor matches BUILDER (home builders that sell finished houses here) and the grantee does not (no builder-to-builder lot sales).
+Usage: python3 -I build_deeds.py <this dir> -> findings-deeds.json"""
+import json, sys, os, re, statistics as st, collections
+D = sys.argv[1]
+R = json.load(open(os.path.join(D, "raw", "deeds-slim.json" if os.path.exists(os.path.join(D, "raw", "deeds-slim.json")) else "deeds.json"))); P = json.load(open(os.path.join(D, "raw", "parcels.json")))["parcels"]
+BUILDER = re.compile(r"HORTON|LENNAR|\bNVR\b|PULTE|MERITAGE|CLAYTON PROPERTIES|GREAT SOUTHERN HOMES|BEVERLY HOMES|STARLIGHT HOMES|BEAZER|ASHTON CHARLESTON|TOLL SOUTHEAST|H & H CONSTRUCTORS|DRB GROUP|DREAM FINDERS|RS PARKER HOMES|HOWELL HOMES|MILLROSE|LEWIS CONSTRUCTION|CHRIS MANNING|CAROLINA COTTAGE|HUNTER QUINN|OCEAN PALMS BUILDERS|SANDS BUILDING|BRADLEY JONES|INFINITY CUSTOM|ALMOND QUALITY|CMH HOMES|AMERI BUILT|MUNGO|CPG INC|STANLEY MARTIN|CHESAPEAKE HOMES|ADAMS HOMES|ASHTON WOODS")
+OTHER_DEV = re.compile(r"BUILDERS?\b|CONSTRUCTION|CONSTRUCTORS|HOMES (INC|LLC)|HOMES OF|HOME BUILDERS|DEVELOPMENT")
+TAX = re.compile(r"DELINQUENT TAX|SHERIFF|MASTER IN EQUITY"); MEMO = re.compile(r"CORRECT|RE-RECORD|SEVERAL|PARCELS|TRACTS|\bLOTS\b|\d+ UNITS")
+deeds = R["deeds"]; steps = collections.OrderedDict(); steps["all deeds"] = len(deeds)
+k = [d for d in deeds if (d["Consideration"] or 0) > 10000]; steps["over $10,000"] = len(k)
+k = [d for d in k if re.fullmatch(r"\d{11}", d["ParcelNumber"] or "")]; steps["one parcel number"] = len(k)
+k = [d for d in k if not TAX.search((d["DirectName"] or "") + " " + (d["IndirectName"] or "")) and not MEMO.search(d["Comments"] or "")]; steps["not tax sale, corrective or multi-parcel memo"] = len(k)
+k = [d for d in k if d["ParcelNumber"] in P]; steps["parcel in county layer"] = len(k)
+k = [d for d in k if (P[d["ParcelNumber"]]["LandUseCode"] or "").startswith("1")]; steps["residential land use code"] = len(k)
+for d in k:
+    d["b"] = bool(BUILDER.search(d["DirectName"] or "")) and not BUILDER.search(d["IndirectName"] or "") and not OTHER_DEV.search(d["IndirectName"] or "")
+    d["dev"] = (not d["b"]) and bool(BUILDER.search(d["DirectName"] or "") or OTHER_DEV.search(d["DirectName"] or ""))
+    p = P[d["ParcelNumber"]]; d["imp0"] = (p["MarketImprv"] or 0) == 0; d["mo"] = d["RecordDate"][:7].replace("/", "-")
+b = [d for d in k if d["b"]]; nb = [d for d in k if not d["b"] and not d["dev"]]
+out = {"source": R["source"], "pulled": R["pulled"], "parcels_read": P and "raw/parcels.json", "steps": steps,
+       "builder_sales": len(b), "other_sales_not_builder_or_developer": len(nb), "developer_or_builder_to_builder": len([d for d in k if d["dev"]]),
+       "builder_share_pct": round(100 * len(b) / len(k), 1),
+       "builder_median_price": st.median([d["Consideration"] for d in b]), "other_median_price": st.median([d["Consideration"] for d in nb]),
+       "builder_price_quartiles": st.quantiles([d["Consideration"] for d in b], n=4, method="inclusive")}
+# by builder (grantor name normalized)
+def norm(n):
+    for pat, lab in [("HORTON", "D.R. Horton"), ("LENNAR", "Lennar"), (r"\bNVR\b", "NVR (Ryan Homes)"), ("PULTE", "Pulte"), ("MERITAGE", "Meritage"),
+                     ("CLAYTON PROPERTIES", "Clayton Properties"), ("GREAT SOUTHERN", "Great Southern Homes"), ("BEVERLY", "Beverly Homes"),
+                     ("BEAZER", "Beazer"), ("STARLIGHT", "Starlight Homes"), ("ASHTON CHARLESTON", "Ashton Woods"), ("TOLL", "Toll Brothers"),
+                     ("H & H", "H & H Constructors"), ("DRB", "DRB Group"), ("DREAM FINDERS", "Dream Finders"), ("RS PARKER", "RS Parker Homes")]:
+        if re.search(pat, n): return lab
+    return "other listed builders"
+c = collections.Counter(norm(d["DirectName"]) for d in b); out["by_builder"] = c.most_common()
+out["top5_share_of_builder_sales_pct"] = round(100 * sum(v for n, v in c.most_common(6) if n != "other listed builders") / len(b), 1)
+# county building value zero, by month of deed
+months = sorted(set(d["mo"] for d in b))
+out["builder_imp0_by_month"] = [{"month": m, "sales": len([d for d in b if d["mo"] == m]), "no_building_value": len([d for d in b if d["mo"] == m and d["imp0"]])} for m in months]
+q4 = [d for d in b if d["mo"] <= "2025-12"]; y26 = [d for d in b if d["mo"] >= "2026-01"]
+out["builder_imp0"] = {"all": [len([d for d in b if d["imp0"]]), len(b)], "deeds_oct_dec_2025": [len([d for d in q4 if d["imp0"]]), len(q4)],
+                       "deeds_jan_sep_2026": [len([d for d in y26 if d["imp0"]]), len(y26)]}
+z = [P[d["ParcelNumber"]] for d in y26 if d["imp0"]]
+out["builder_2026_imp0_land"] = {"n": len(z), "median_market_land": st.median([p["MarketLand"] or 0 for p in z]),
+                                 "median_price_of_those_deeds": st.median([d["Consideration"] for d in y26 if d["imp0"]])}
+# owner mailing state on builder-sold parcels (current owner; no names)
+sc = collections.Counter((P[d["ParcelNumber"]]["OwnerState"] or "").strip().upper() for d in b)
+out["builder_owner_state"] = {"SC": sc.get("SC", 0), "total": len(b), "top_other": [x for x in sc.most_common(8) if x[0] != "SC"]}
+# assessment ratio on builder-sold parcels with a building value (assessed / market)
+rat = collections.Counter()
+for d in b:
+    p = P[d["ParcelNumber"]]
+    if p["MarketImprv"] and p["MarketProp"]:
+        r = (p["AssessedProp"] or 0) / p["MarketProp"]; rat["4%" if abs(r - 0.04) < 0.004 else "6%" if abs(r - 0.06) < 0.004 else "other"] += 1
+out["builder_valued_assessment_ratio"] = dict(rat)
+# builder sales by tax district (ties a sale to a city or the unincorporated county)
+out["builder_by_taxdistrict"] = collections.Counter(P[d["ParcelNumber"]]["TaxDistrict"] for d in b).most_common(15)
+# how the county valued homes builders sold in Oct-Dec 2025 (first valued for tax year 2026): county market value / deed price
+v = [(P[d["ParcelNumber"]]["MarketProp"] or 0) / d["Consideration"] for d in q4 if not d["imp0"] and d["Consideration"] > 100000]
+out["q4_2025_builder_value_to_price"] = {"n": len(v), "median": round(st.median(v), 3), "quartiles": [round(x, 3) for x in st.quantiles(v, n=4, method="inclusive")]}
+out["q4_2025_builder_median_price"] = st.median([d["Consideration"] for d in q4])
+out["q4_2025_builder_median_county_value"] = st.median([P[d["ParcelNumber"]]["MarketProp"] or 0 for d in q4])
+json.dump(out, open(os.path.join(D, "findings-deeds.json"), "w"), indent=1)
+print(json.dumps({x: out[x] for x in out if x not in ("builder_imp0_by_month",)}, indent=1)); print(out["builder_imp0_by_month"])
diff --git a/data/2026-10-d/buyers-new-construction/build_flood.py b/data/2026-10-d/buyers-new-construction/build_flood.py
new file mode 100644
index 00000000..49b6b326
--- /dev/null
+++ b/data/2026-10-d/buyers-new-construction/build_flood.py
@@ -0,0 +1,31 @@
+"""How many new-construction houses for sale (Horry County, from raw/listings.json) sit inside a FEMA high-risk flood zone
+(SFHA, zones A, AE, VE) on the county's flood layer, against houses built 2016-2023 and all houses for sale.
+A listing point is the CRM's map point for the home. Usage: python3 -I fetch_flood.py <this dir>; python3 -I build_flood.py <this dir> [path to flood-sfha.json] -> findings-flood.json (raw/flood-sfha.json is 5.6 MB and not kept; rerun fetch_flood.py)"""
+import json, sys, os
+D = sys.argv[1]
+L = json.load(open(os.path.join(D, "raw", "listings.json"))); F = json.load(open(sys.argv[2] if len(sys.argv) > 2 else os.path.join(D, "raw", "flood-sfha.json")))
+ring = json.load(open(os.path.join(D, "raw", "horry-county-boundary.json")))["features"][0]["geometry"]["rings"][0]
+def pip(x, y, r):
+    c = False; j = len(r) - 1
+    for i in range(len(r)):
+        xi, yi = r[i]; xj, yj = r[j]
+        if (yi > y) != (yj > y) and x < (xj - xi) * (y - yi) / (yj - yi) + xi: c = not c
+        j = i
+    return c
+polys = []
+for f in F["features"]:
+    rs = f["geometry"]["rings"]; xs = [p[0] for r in rs for p in r]; ys = [p[1] for r in rs for p in r]
+    polys.append((min(xs), max(xs), min(ys), max(ys), rs, f["attributes"]["FLD_ZONE"]))
+def zone(x, y):
+    for a, b, c, d, rs, z in polys:
+        if a <= x <= b and c <= y <= d:
+            n = sum(1 for r in rs if pip(x, y, r))
+            if n % 2 == 1: return z
+    return None
+out = {"flood_source": F["source"], "flood_read": F["read"], "listings_pulled": L["pulled"]}
+for k in ["new_house", "nearlynew_house", "all_house"]:
+    hs = [h for h in L["sets"][k]["homes"].values() if h["lat"] and pip(h["lng"], h["lat"], ring)]
+    zs = [zone(h["lng"], h["lat"]) for h in hs]
+    out[k] = {"in_horry": len(hs), "in_sfha": sum(1 for z in zs if z), "by_zone": {z: zs.count(z) for z in set(zs) if z}}
+    print(k, out[k], flush=True)
+json.dump(out, open(os.path.join(D, "findings-flood.json"), "w"), indent=1)
diff --git a/data/2026-10-d/buyers-new-construction/build_listings.py b/data/2026-10-d/buyers-new-construction/build_listings.py
new file mode 100644
index 00000000..47063bf9
--- /dev/null
+++ b/data/2026-10-d/buyers-new-construction/build_listings.py
@@ -0,0 +1,76 @@
+"""Builds the listing findings from raw/listings.json, kept inside the Horry County line (Census TIGERweb).
+Usage: python3 -I build_listings.py <this dir> -> findings-listings.json"""
+import json, sys, os, statistics as st
+D = sys.argv[1]
+L = json.load(open(os.path.join(D, "raw", "listings.json")))
+ring = json.load(open(os.path.join(D, "raw", "horry-county-boundary.json")))["features"][0]["geometry"]["rings"][0]
+def inside(x, y):
+    c = False; j = len(ring) - 1
+    for i in range(len(ring)):
+        xi, yi = ring[i]; xj, yj = ring[j]
+        if (yi > y) != (yj > y) and x < (xj - xi) * (y - yi) / (yj - yi) + xi: c = not c
+        j = i
+    return c
+def med(a): return st.median(a) if a else None
+def summ(hs):
+    ppsf = [h["price"] / h["sqft"] for h in hs if h["price"] and h["sqft"] and h["sqft"] > 400]
+    return {"count": len(hs), "median_price": med([h["price"] for h in hs if h["price"]]), "median_sqft": med([h["sqft"] for h in hs if h["sqft"]]),
+            "median_ppsf": round(med(ppsf), 1) if ppsf else None, "n_ppsf": len(ppsf), "median_acres": med([h["acres"] for h in hs if h["acres"]]),
+            "n_acres": len([h for h in hs if h["acres"]])}
+out = {"pulled": L["pulled"], "totals": L["totals"], "sets": {}}
+H = {}
+for k, s in L["sets"].items():
+    hs = list(s["homes"].values())
+    ins = [h for h in hs if h["lat"] and h["lng"] and inside(h["lng"], h["lat"])]
+    H[k] = ins
+    out["sets"][k] = {"pulled": len(hs), "no_point": len([h for h in hs if not h["lat"]]), "in_horry": len(ins), "all": summ(ins),
+                      "years": {str(y): len([h for h in ins if h["year"] == y]) for y in sorted(set(h["year"] for h in ins if h["year"]))}}
+# by mailing city, houses
+cities = sorted(set(h["city"] for h in H["new_house"] + H["nearlynew_house"]))
+by = []
+for c in cities:
+    n = [h for h in H["new_house"] if h["city"] == c]; o = [h for h in H["nearlynew_house"] if h["city"] == c]
+    if len(n) + len(o) < 10: continue
+    sn, so = summ(n), summ(o)
+    by.append({"city": c, "new": sn, "nearly_new_2016_2023": so,
+               "ppsf_premium_pct": round(100 * (sn["median_ppsf"] / so["median_ppsf"] - 1), 1) if sn["median_ppsf"] and so["median_ppsf"] and sn["n_ppsf"] >= 10 and so["n_ppsf"] >= 10 else None})
+out["by_city_house"] = sorted(by, key=lambda r: -r["new"]["count"])
+# price bands for new houses
+bands = [(0, 300000), (300001, 400000), (400001, 500000), (500001, 750000), (750001, 99e9)]
+out["new_house_price_bands"] = [{"band": [a, b], "count": len([h for h in H["new_house"] if h["price"] and a <= h["price"] <= b])} for a, b in bands]
+json.dump(out, open(os.path.join(D, "findings-listings.json"), "w"), indent=1)
+print(json.dumps({k: v for k, v in out["sets"].items()}, indent=1))
+for r in out["by_city_house"]: print(r["city"], r["new"]["count"], r["new"]["median_price"], r["new"]["median_ppsf"], r["new"]["median_sqft"], r["new"]["median_acres"], "|", r["nearly_new_2016_2023"]["count"], r["nearly_new_2016_2023"]["median_price"], r["nearly_new_2016_2023"]["median_ppsf"], r["nearly_new_2016_2023"]["median_sqft"], r["nearly_new_2016_2023"]["median_acres"], "|", r["ppsf_premium_pct"])
+print(out["new_house_price_bands"])
+# --- share of houses for sale that are new, by mailing city (Horry only)
+import math
+allh = H["all_house"]; newids = set(L["sets"]["new_house"]["homes"].keys())
+allmls = {m: h for m, h in L["sets"]["all_house"]["homes"].items() if h["lat"] and inside(h["lng"], h["lat"])}
+share = {"houses_in_horry": len(allmls), "new_in_horry_all_set": len([m for m in allmls if m in newids])}
+sc = []
+for c in sorted(set(h["city"] for h in allmls.values())):
+    ms = [m for m, h in allmls.items() if h["city"] == c]
+    if len(ms) < 30: continue
+    k = len([m for m in ms if m in newids]); sc.append({"city": c, "houses": len(ms), "new": k, "pct": round(100 * k / len(ms))})
+share["by_city"] = sorted(sc, key=lambda r: -r["pct"])
+out["share_new"] = share
+# --- matched comparison: each new house against houses built 2016-2023 within 1 mile and within 20% of its size
+def mi(a, b):
+    R = 3958.8; p1, p2 = math.radians(a["lat"]), math.radians(b["lat"]); dl = math.radians(b["lng"] - a["lng"]); dp = p2 - p1
+    return 2 * R * math.asin(math.sqrt(math.sin(dp / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dl / 2) ** 2))
+old = [h for h in H["nearlynew_house"] if h["sqft"] and h["price"]]
+ratios, pairs_n, rows = [], 0, []
+for h in H["new_house"]:
+    if not (h["sqft"] and h["price"]): continue
+    m = [o for o in old if abs(o["sqft"] - h["sqft"]) <= 0.2 * h["sqft"] and mi(h, o) <= 1.0]
+    if len(m) < 3: continue
+    r = (h["price"] / h["sqft"]) / st.median([o["price"] / o["sqft"] for o in m]); ratios.append(r)
+    rows.append({"city": h["city"], "ratio": r, "n": len(m)})
+out["matched"] = {"rule": "new house vs houses built 2016-2023 (not flagged new) within 1 mile and within 20% of its square feet; at least 3 matches",
+                  "new_houses_matched": len(ratios), "median_ratio": round(st.median(ratios), 3),
+                  "share_new_cheaper_per_sqft": round(sum(1 for r in ratios if r < 1) / len(ratios), 3),
+                  "quartiles": [round(x, 3) for x in st.quantiles(ratios, n=4, method="inclusive")],
+                  "by_city": {c: {"n": len([r for r in rows if r["city"] == c]), "median_ratio": round(st.median([r["ratio"] for r in rows if r["city"] == c]), 3)}
+                              for c in sorted(set(r["city"] for r in rows)) if len([r for r in rows if r["city"] == c]) >= 15}}
+json.dump(out, open(os.path.join(D, "findings-listings.json"), "w"), indent=1)
+print(json.dumps(out["share_new"], indent=0)); print(json.dumps(out["matched"], indent=0))
