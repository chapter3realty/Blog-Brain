s with a Surfside Beach address, which sit outside the town; inside the town it is a little higher.";o("stFill",said);seg();calc()}function calc(){var d=D[$("stTown").value],two=beds==="2",price=g("stPrice"),miss=$("stPrice").value===""||$("stFee").value==="";if(!taxSet)$("stTax").value=d.mills&&price?Math.round(price*0.06*d.mills/1000):"";var i={rate:g("stNightly"),nights:Math.min(g("stNights"),365),clean:d.clean,run:d.run,util:$("stUtil").checked,mgr:Math.min(g("stMgr"),100),fee:g("stFee"),tax:g("stTax"),ins:g("stIns"),price:price};var c=run(i);o("stClean",m(-c.clean));o("stAir",m(-c.airbnb));o("stUt",i.util?"in the HOA fee":m(-c.util));o("stSup",m(-c.supRep));o("stMg",m(-c.mgr));o("stIn",m(-c.ins));var kind=(two?"two":"three")+"-bedroom",subj=custom?"This listing":"A typical "+(d.ocean?"oceanfront ":"")+kind+" condo in "+d.name;if(i.mgr>0)subj+=", run by a manager"+(i.mgr===MGR?"":" at "+i.mgr+" percent")+",";o("stBk",custom?"You put in "+i.nights+" booked":"The average one here books "+i.nights);var say=$("stSay");var blank=function(t){say.textContent=t;o("stTake","--");o("stKept","--");o("stNeed","--");o("stKeptL","You keep")};if(miss){o("stGross",m(h(c.gross)));o("stHoa","--");o("stTx","--");blank("Put in the listing's price and HOA fee under \u201cChange the numbers\u201d to see what a "+kind+" in "+d.name+" keeps.");return}if(!i.nights||!i.rate){o("stGross","--");blank("Put in a nightly rate and the nights booked under \u201cChange the numbers\u201d.");return}o("stHoa",m(-c.fee));o("stTx",c.tax?m(-c.tax):"not counted");var gr=h(c.gross),k=h(c.kept);o("stGross",m(gr));o("stTake",m(-(gr-k)));if(k<0){o("stKeptL","Short of the bills");o("stKept",m(-k))}else{o("stKeptL","You keep");o("stKept",m(k))}o("stNeed",c.need===null?"--":c.need>365?"more than 365":String(c.need));var s=Math.abs(c.kept)<250?subj+" about pays its bills, with little left over, before any loan.":c.kept>0?subj+" keeps about <strong>"+r(c.kept)+" a year</strong> after its bills, before any loan.":subj+" falls about <strong>"+r(-c.kept)+" a year</strong> short of its bills, before any loan.";if(!c.tax)s+=" Property tax is not counted.";say.innerHTML=s}function tips(){all(".st-calc .q",function(b){var t=$(b.getAttribute("aria-controls"));var set=function(on){b.setAttribute("aria-expanded",String(on));t.classList.toggle("on",on)};var pinned=false;b.addEventListener("click",function(){pinned=!pinned;set(pinned)});b.addEventListener("mouseenter",function(){set(true)});b.addEventListener("mouseleave",function(){if(!pinned)set(false)});b.addEventListener("focus",function(){set(true)});b.addEventListener("blur",function(){if(!pinned)set(false)})})}function start(){if(!$("stTown"))return;$("stTown").addEventListener("change",fill);all(".st-calc button[data-b]",function(b){b.addEventListener("click",function(){beds=b.getAttribute("data-b");fill()})});all(".st-calc button[data-m]",function(b){b.addEventListener("click",function(){$("stMgr").value=b.getAttribute("data-m");seg();calc()})});["stPrice","stFee","stNightly","stNights","stIns"].forEach(function(id){$(id).addEventListener("input",function(){custom=true;calc()})});$("stMgr").addEventListener("input",function(){seg();calc()});$("stUtil").addEventListener("change",function(){custom=true;calc()});$("stTax").addEventListener("input",function(){taxSet=true;custom=true;calc()});tips();fill()}if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",start);else start()})();</script><div class="st-ex"><p class="k">The worked example</p><p>The calculator starts on a typical two-bedroom beach condo for sale in Garden City Beach that allows nightly rentals. It asks about $345,000, and its HOA fee is about $575 a month. The average two-bedroom Airbnb there books about 95 nights a year, and this condo pays its bills at about 66. With a manager at 15 percent of the bookings, it needs about 83 nights and keeps under $2,000.</p><p>The oceanfront towers in Myrtle Beach are the hard case. A typical two-bedroom there has a fee of about $1,200 a month and needs about 110 booked nights. The average listing books about 87, counting listings open only part of the year, so it falls about $4,000 short. Open all year, it keeps about $4,500, or falls a little short with a manager.</p></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">What to tell a guest about Garden City Beach:</p><ul style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem">Parking is free all year at every oceanfront beach access Horry County runs in Garden City.</li><li style="margin-bottom:.5rem">At the inlet end of Waccamaw Drive, people go up to the rooftop deck of Gulfstream Cafe to watch the sun set over the water.</li><li style="margin-bottom:.5rem">From a dock on the marsh, you can tie a chicken neck to a string and pull up blue crabs for dinner, and with three or fewer drop nets, fold-up traps or hand lines you need no license.</li><li style="margin-bottom:.5rem">Every Fourth of July afternoon, decorated golf carts drive the "wet" parade while people along the route soak them with water guns.</li></ul><div class="hx-strip" data-place="str-garden-city-beach-condos" data-name="Garden City Beach" data-head="Garden City Beach condos, where the typical one pays its bills"></div><div class="hx-fallback"><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Garden%20City%20Beach">Get the Garden City Beach condos for sale<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Thinking of a yearly lease instead? Our page on <a href="/invest/str-vs-ltr/" style="color:var(--navy);text-decoration:underline">Airbnb or a long-term rental</a> runs the same home both ways, and our <a href="/invest/long-term-rental/" style="color:var(--navy);text-decoration:underline">rental analyzer</a> prices the lease.</p></div></section><section style="background:var(--ivory)" id="condo-fee"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The HOA fee">Why does the HOA fee matter so much for a Myrtle Beach Airbnb?</h2><div class="st-side"><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In an oceanfront tower the HOA fee is the biggest bill. On the typical Myrtle Beach oceanfront two-bedroom it is nearly three quarters of the bills. It is due every month, in January as well as July. Where the fee is lower, the bills take far fewer booked nights to pay.</p><figure class="st-mo st-need"><p class="cap" id="stNeedCap">The lower the HOA fee, the fewer nights a condo must book to pay its bills</p><table class="st-nd" aria-labelledby="stNeedCap"><thead class="sr"><tr><th scope="col">Where, its HOA fee, and whether it pays its bills</th><th scope="col">Nights it needs to pay its bills</th><th scope="col">Nights the average one books</th></tr></thead><tbody><tr><th scope="row" class="hd"><a href="/submarkets/surfside-beach/">Surfside Beach</a><span class="fee">HOA fee $375 a month</span><span class="vd ok">Pays its bills</span></th><td class="br"><span class="lb" aria-hidden="true">Needs</span><span class="tr" aria-hidden="true"><span class="b" style="--f:0.382"></span></span><span class="v">42 nights</span></td><td class="br"><span class="lb" aria-hidden="true">Books</span><span class="tr" aria-hidden="true"><span class="b mi" style="--f:0.727"></span></span><span class="v">80 nights</span></td></tr><tr><th scope="row" class="hd"><a href="/submarkets/garden-city/">Garden City Beach</a><span class="fee">HOA fee $575 a month</span><span class="vd ok">Pays its bills</span></th><td class="br"><span class="lb" aria-hidden="true">Needs</span><span class="tr" aria-hidden="true"><span class="b" style="--f:0.6"></span></span><span class="v">66 nights</span></td><td class="br"><span class="lb" aria-hidden="true">Books</span><span class="tr" aria-hidden="true"><span class="b mi" style="--f:0.864"></span></span><span class="v">95 nights</span></td></tr><tr><th scope="row" class="hd"><a href="/submarkets/north-myrtle-beach/">North Myrtle Beach, oceanfront</a><span class="fee">HOA fee $1,075 a month</span><span class="vd no">Falls short</span></th><td class="br"><span class="lb" aria-hidden="true">Needs</span><span class="tr" aria-hidden="true"><span class="b" style="--f:0.945"></span></span><span class="v">104 nights</span></td><td class="br"><span class="lb" aria-hidden="true">Books</span><span class="tr" aria-hidden="true"><span class="b mi" style="--f:0.655"></span></span><span class="v">72 nights</span></td></tr><tr><th scope="row" class="hd"><a href="/submarkets/myrtle-beach/">Myrtle Beach, oceanfront</a><span class="fee">HOA fee $1,225 a month</span><span class="vd no">Falls short</span></th><td class="br"><span class="lb" aria-hidden="true">Needs</span><span class="tr" aria-hidden="true"><span class="b" style="--f:1"></span></span><span class="v">110 nights</span></td><td class="br"><span class="lb" aria-hidden="true">Books</span><span class="tr" aria-hidden="true"><span class="b mi" style="--f:0.791"></span></span><span class="v">87 nights</span></td></tr></tbody></table><figcaption>A typical two-bedroom condo for sale that allows nightly rentals, run by its owner, before any loan. The bills are the HOA fee, the property tax and rental insurance. Books: the average two-bedroom Airbnb in the town, AirROI, 12 months to September 2026.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The low fees are in two kinds of places: on the beach in Garden City Beach, and inland in Surfside Beach.</p><ul class="st-cost st-where"><li><b>Garden City Beach, on the beach</b><span class="why">Nearly all are on Waccamaw Drive, the street along the beach. Beach House, Sea Watch and Garden Sands are among those with fees of $600 a month or less.</span></li><li><b>Surfside Beach, mostly inland</b><span class="why">Most are at Retreat at Glenns Bay, Golf Colony at Deerfield and Grand Palms Resort, a mile or more from the beach, with fees of $600 or less. On the oceanfront, the units listed at Sea Shadow have fees over $1,000, and the few others listed there have fees of $1,000 or less. An inland condo may book fewer nights than the town's average of 80, which counts the beach condos too. It pays its bills at about 42, about half that average.</span></li><li><b>Myrtle Beach, oceanfront</b><span class="why">The fees of $800 a month or less are at places like Ocean Forest Villas and Beach Colony. The fee pays the electric on every unit listed at Sand Dunes, the Caribbean, Dunes Village, Carolinian Beach Resort and Grande Shores.</span></li><li><b>North Myrtle Beach, oceanfront</b><span class="why">The fee pays the electric on most of the units listed at Bay Watch and Beach Cove.</span></li></ul><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-10-d/invest-str-tools/myrtle-beach-oceanfront-towers-and-houses-2011-1200w.webp" srcset="/images/2026-10-d/invest-str-tools/myrtle-beach-oceanfront-towers-and-houses-2011-600w.webp 600w, /images/2026-10-d/invest-str-tools/myrtle-beach-oceanfront-towers-and-houses-2011-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="675" alt="Four oceanfront towers with balconies and pools behind the dune in Myrtle Beach, with streets of houses and woods behind them, seen from a plane over the ocean" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: U.S. Geological Survey. License: Public domain" title="License: Public domain">Photo: U.S. Geological Survey</a></span></div><figcaption>Oceanfront towers in Myrtle Beach, with streets of houses behind them, seen from over the ocean.</figcaption></figure></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">When the fee pays the electric, tick the box under "Change the numbers" in the calculator, and the utilities cost goes. Most oceanfront units are in the building's own rental program, which takes its own share. Our page on <a href="/invest/rental-program-vs-airbnb/" style="color:var(--navy);text-decoration:underline">a rental program or Airbnb</a> compares the two.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Send us the listing you are looking at</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We read the building's budget and what its fee pays for, at no cost.</p><a class="btn btn-brass" href="/contact/">Have us read the building's budget</a></div></div></section><section style="background:var(--ivory-2)" id="towns"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Town by town">Which Grand Strand town does an Airbnb do best in?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For the same size of home, the towns are close. In seven of the eight, the average two-bedroom took in about $21,000 to $28,000 a year. Little River took in far less, and Murrells Inlet and Garden City Beach did best.</p><figure style="margin:1.8rem 0;max-width:760px"><svg xmlns="http://www.w3.org/2000/svg" id="c3r-grand-strand-airbnb-town" viewBox="0 0 360 418" width="360" height="418" role="img" aria-label