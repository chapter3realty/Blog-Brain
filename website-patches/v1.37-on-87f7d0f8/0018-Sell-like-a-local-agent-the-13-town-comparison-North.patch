n><button type="button" data-t="surfside-beach" aria-pressed="false">Surfside Beach</button><button type="button" data-t="myrtle-beach" aria-pressed="false">Myrtle Beach oceanfront</button><button type="button" data-t="north-myrtle-beach" aria-pressed="false">North Myrtle Beach oceanfront</button></div><div class="st-pick st-who" role="group" aria-label="Who runs it"><span>Who runs it:</span><button type="button" data-m="0" aria-pressed="true">You</button><button type="button" data-m="15" aria-pressed="false">A manager at 15%</button></div><div class="cols"><div><label for="stTown">Town<select id="stTown"><option value="north-myrtle-beach">North Myrtle Beach</option><option value="myrtle-beach">Myrtle Beach</option><option value="surfside-beach">Surfside Beach</option><option value="garden-city-beach" selected>Garden City Beach</option><option value="murrells-inlet">Murrells Inlet</option><option value="pawleys-island">Pawleys Island</option><option value="little-river">Little River</option><option value="conway">Conway</option></select></label><label for="stBeds">Bedrooms<select id="stBeds"><option value="2" selected>2</option><option value="3">3</option></select></label><p class="st-note" id="stFill" aria-live="polite"></p><label for="stPrice">Price, $<input id="stPrice" type="number" min="0" step="1000" value="343500" inputmode="decimal"></label><label for="stFee">HOA fee a month, $<input id="stFee" type="number" min="0" step="25" value="575" inputmode="decimal"></label><label for="stNightly">Nightly rate, $<input id="stNightly" type="number" min="0" step="1" value="243" inputmode="decimal"></label><label for="stNights">Nights booked a year<input id="stNights" type="number" min="0" step="1" value="95" inputmode="decimal" max="365"></label><div class="row"><span><label for="stTax">Property tax a year, $</label><button type="button" class="q" aria-expanded="false" aria-controls="stTaxQ" aria-label="What the property tax means">?</button></span><input id="stTax" type="number" min="0" step="1" value="4272" inputmode="decimal"></div><p class="tip" id="stTaxQ">The county taxes a rental you do not live in on 6 percent of its value, at the tax rate for its address. On the Garden City Beach condo that is about $4,300 a year, about 1.2 percent of the price. The calculator fills it in from the price where we know the rate.</p><label for="stIns">Rental insurance and permit a year, $<input id="stIns" type="number" min="0" step="10" value="620" inputmode="decimal"></label><label for="stMgr">Manager, % of nightly bookings<input id="stMgr" type="number" min="0" step="0.5" value="0" inputmode="decimal" max="100"></label><label class="ck" for="stUtil"><input id="stUtil" type="checkbox"><span>The HOA fee pays the electric and internet</span></label></div><div class="out" aria-live="polite"><div class="ln"><span>Guests pay, with cleaning fees</span><strong id="stGross">$26,843</strong></div><div class="ln"><span>Cleaner, paid by the cleaning fee</span><strong id="stClean">-$3,758</strong></div><div class="ln"><span>Airbnb's fee</span><strong id="stAir">-$3,490</strong></div><div class="ln"><span>Utilities and internet</span><strong id="stUt">-$1,342</strong></div><div class="ln"><span>Supplies and repairs</span><strong id="stSup">-$1,342</strong></div><div class="ln"><span>Manager</span><strong id="stMg">$0</strong></div><div class="ln sum"><span>Kept before the home's bills</span><strong id="stBefore">$16,911</strong></div><div class="ln"><span>HOA fee</span><strong id="stHoa">-$6,900</strong></div><div class="ln"><span>Property tax</span><strong id="stTx">-$4,272</strong></div><div class="ln"><span>Insurance and permit</span><strong id="stIn">-$620</strong></div><div class="big"><span>You keep a year<button type="button" class="q" aria-expanded="false" aria-controls="stKeptQ" aria-label="What you keep a year means">?</button></span><strong id="stKept">$5,119</strong></div><p class="tip" id="stKeptQ">The rate and nights are town averages, so one unit can do better or worse. Costs are AirROI's shares for the town, the low end of what owners pay. Your own condo insurance policy is extra, and no loan is counted. Chapter3 does not manage rentals.</p><div class="big"><span>Nights needed to pay the bills</span><strong id="stNeed">66</strong></div><p class="say" id="stSay"></p></div></div></div><script>(function(){var D={"north-myrtle-beach":{"key":"north-myrtle-beach","name":"North Myrtle Beach","clean":15,"run":24,"ins":510,"adr2":246,"n2":72,"adr3":348,"n3":73,"mills":221.2,"price":369900,"fee":1075},"myrtle-beach":{"key":"myrtle-beach","name":"Myrtle Beach","clean":13,"run":24,"ins":390,"adr2":252,"n2":87,"adr3":339,"n3":95,"mills":254.6,"price":327000,"fee":1225},"surfside-beach":{"key":"surfside-beach","name":"Surfside Beach","clean":14,"run":23,"ins":640,"adr2":245,"n2":80,"adr3":315,"n3":92,"mills":201,"price":192000,"fee":375},"garden-city-beach":{"key":"garden-city-beach","name":"Garden City Beach","clean":14,"run":23,"ins":620,"adr2":243,"n2":95,"adr3":352,"n3":95,"mills":207.3,"price":343500,"fee":575},"murrells-inlet":{"key":"murrells-inlet","name":"Murrells Inlet","clean":14,"run":24,"ins":720,"adr2":230,"n2":104,"adr3":304,"n3":93,"mills":null,"price":null,"fee":null},"pawleys-island":{"key":"pawleys-island","name":"Pawleys Island","clean":17,"run":24,"ins":470,"adr2":253,"n2":75,"adr3":325,"n3":71,"mills":null,"price":null,"fee":null},"little-river":{"key":"little-river","name":"Little River","clean":16,"run":24,"ins":220,"adr2":177,"n2":56,"adr3":249,"n3":64,"mills":null,"price":null,"fee":null},"conway":{"key":"conway","name":"Conway","clean":12,"run":24,"ins":350,"adr2":185,"n2":114,"adr3":257,"n3":108,"mills":null,"price":null,"fee":null}};var run=function(i){var cl=i.clean/100,gross=i.nights>0&&cl<1?i.rate*i.nights/(1-cl):0;var c={gross:gross,clean:gross*cl,airbnb:gross*(i.run-10)/100,util:i.util?0:gross*0.05,supRep:gross*0.05,mgr:i.rate*i.nights*i.mgr/100};c.before=c.gross-c.clean-c.airbnb-c.util-c.supRep-c.mgr;c.fee=i.fee*12;c.tax=i.tax;c.ins=i.ins;c.bills=c.fee+c.tax+c.ins;c.kept=c.before-c.bills;var per=i.rate*(1-cl-(i.run-(i.util?5:0))/100)/(1-cl)-i.rate*i.mgr/100;c.per=per;c.need=per>0?Math.round(c.bills/per):null;c.share=i.price>0?c.kept/i.price*100:null;return c};var $=function(i){return document.getElementById(i)};var g=function(i){var e=$(i);var v=e?parseFloat(e.value):NaN;return isFinite(v)&&v>0?v:0};var m=function(x){return (x<-0.5?"-$":"$")+Math.round(Math.abs(x)).toLocaleString("en-US")};var r=function(x){return "$"+(Math.round(Math.abs(x)/100)*100).toLocaleString("en-US")};var o=function(i,t){var e=$(i);if(e)e.textContent=t};var taxSet=false;function pressed(){var k=$("stTown").value,two=$("stBeds").value==="2";Array.prototype.forEach.call(document.querySelectorAll(".st-pick button[data-t]"),function(b){b.setAttribute("aria-pressed",String(two&&b.getAttribute("data-t")===k))});var mg=String(g("stMgr"));Array.prototype.forEach.call(document.querySelectorAll(".st-who button"),function(b){b.setAttribute("aria-pressed",String(b.getAttribute("data-m")===mg))})}function fill(){var d=D[$("stTown").value],two=$("stBeds").value==="2";$("stNightly").value=two?d.adr2:d.adr3;$("stNights").value=two?d.n2:d.n3;$("stIns").value=d.ins;var said="Filled in: the average "+(two?"two":"three")+"-bedroom Airbnb's rate and nights in "+d.name+", and AirROI's rental insurance and permit cost there";var own=!(two&&d.price);if(own){$("stPrice").value="";$("stFee").value=""}else{$("stPrice").value=d.price;$("stFee").value=d.fee;said+=", and a typical two-bedroom condo for sale there that allows nightly rentals"+(d.key==="surfside-beach"?", most of them a mile or more from the beach":"")}said+=".";if(own)said+=" Put in the listing's price and HOA fee.";taxSet=false;if(!d.mills)said+=" The tax rate here depends on the address, so the tax is blank. Send us the address and we work it out.";else if(d.key==="surfside-beach")said+=" The tax is at the rate for most condos with a Surfside Beach address, which sit outside the town; inside the town it is a little higher.";o("stFill",said);pressed();calc()}function calc(){var d=D[$("stTown").value],price=g("stPrice"),miss=$("stPrice").value===""||$("stFee").value==="";if(!taxSet)$("stTax").value=d.mills&&price?Math.round(price*0.06*d.mills/1000):"";var i={rate:g("stNightly"),nights:Math.min(g("stNights"),365),clean:d.clean,run:d.run,util:$("stUtil").checked,mgr:Math.min(g("stMgr"),100),fee:g("stFee"),tax:g("stTax"),ins:g("stIns"),price:price};var c=run(i);o("stGross",m(c.gross));o("stClean",m(-c.clean));o("stAir",m(-c.airbnb));o("stUt",i.util?"in the HOA fee":m(-c.util));o("stSup",m(-c.supRep));o("stMg",m(-c.mgr));o("stBefore",m(c.before));o("stIn",m(-c.ins));if(miss){o("stHoa","--");o("stTx","--");o("stKept","--");o("stNeed","--");o("stSay","Put in the listing's price and HOA fee to see what you keep.");return}o("stHoa",m(-c.fee));o("stTx",c.tax?m(-c.tax):"not counted");o("stKept",m(c.kept));o("stNeed",c.need===null?"--":c.need>365?"more than 365":String(c.need));var s=!i.nights||!i.rate?"Enter a nightly rate and the nights booked.":Math.abs(c.kept)<250?"At "+i.nights+" nights the money from guests about pays the bills.":c.kept>0?"At "+i.nights+" nights you pay the bills and keep about "+r(c.kept)+" a year, before any loan.":"At "+i.nights+" nights you are about "+r(-c.kept)+" a year short of the bills, before any loan.";if(c.share!==null&&c.kept>=250&&i.nights&&i.rate)s+=" That is "+(Math.round(c.share*10)/10)+" percent of the price a year.";if(!c.tax&&i.nights&&i.rate)s+=" Property tax is not counted.";o("stSay",s)}function tips(){Array.prototype.forEach.call(document.querySelectorAll(".st-calc .q"),function(b){var t=$(b.getAttribute("aria-controls"));var set=function(on){b.setAttribute("aria-expanded",String(on));t.classList.toggle("on",on)};var pinned=false;b.addEventListener("click",function(){pinned=!pinned;set(pinned)});b.addEventListener("mouseenter",function(){set(true)});b.addEventListener("mouseleave",function(){if(!pinned)set(false)});b.addEventListener("focus",function(){set(true)});b.addEventListener("blur",function(){if(!pinned)set(false)})})}function start(){if(!$("stTown"))return;$("stTown").addEventListener("change",fill);$("stBeds").addEventListener("change",fill);Array.prototype.forEach.call(document.querySelectorAll(".st-pick button[data-t]"),function(b){b.addEventListener("click",function(){$("stTown").value=b.getAttribute("data-t");$("stBeds").value="2";fill()})});Array.prototype.forEach.call(document.querySelectorAll(".st-who button"),function(b){b.addEventListener("click",function(){$("stMgr").value=b.getAttribute("data-m");pressed();calc()})});["stPrice","stFee","stNightly","stNights","stIns"].forEach(function(id){$(id).addEventListener("input",calc)});$("stMgr").addEventListener("input",function(){pressed();calc()});$("stUtil").addEventListener("change",calc);$("stTax").addEventListener("input",function(){taxSet=true;calc()});tips();fill()}if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",start);else start()})();</script><div class="st-ex"><p class="k">The worked example</p><p>The calculator starts on a typical two-bedroom beach condo for sale in Garden City Beach that allows nightly rentals. It asks about $345,000, and its HOA fee is about $575 a month.</p><p>The average two-bedroom Airbnb there books about 95 nights a year. This condo needs about 66 to pay its bills, so its owner keeps about $5,000 a year, before any loan.</p><p>With a manager at 15 percent of the bookings, it needs about 83 nights and keeps under $2,000. Pick the manager above to see it.</p><p>The oceanfront towers in Myrtle Beach are the hard case. A typical two-bedroom there has a fee of about $1,200 a month and needs about 110 booked nights. The average listing books about 87, counting listings open only part of the year, so it falls about $4,000 short. Open all year, it keeps about $4,500, or falls a little short with a manager.</p></div><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">What is the property tax on a condo you like?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">The rate depends on the address. Send it to us, and we work out the yearly tax on it as a rental.</p><a class="btn btn-brass" href="/contact/">Have us work out the tax</a></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Thinking of a yearly lease instead? Our page on <a href="/invest/str-vs-ltr/" style="color:var(--navy);text-decoration:underline">Airbnb or a long-term rental</a> runs the same home both ways, and our <a href="/invest/long-term-rental/" style="color:var(--navy);text-decoration:underline">rental analyzer</a> prices the lease.</p></div></section><section style="background:var(--ivory)" id="condo-fee"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The HOA fee">Why does the HOA fee matter so much for a Myrtle Beach Airbnb?</h2><div class="st-side"><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In an oceanfront tower the HOA fee is the biggest bill. On the typical Myrtle Beach oceanfront two-bedroom it is nearly three quarters of the bills. It is due every month, in January as well as July. Where the fee is lower, the bills take far fewer booked nights to pay.</p><figure class="st-mo st-need"><p class="cap" id="stNeedCap">Nights needed to pay the bills, and nights the average one books</p><div class="st-key" aria-hidden="true"><span><i></i><span><b>Needed</b>, run by its owner</span></span><span><i class="mg"></i><span><b>Needed</b>, with a manager</span></span><span><i class="mi"></i><span><b>Booked</b> by the average two-bedroom Airbnb in the town</span></span></div><table role="table" aria-labelledby="stNeedCap"><thead role="rowgroup" class="sr"><tr role="row"><th role="columnheader" scope="col">Where, and the HOA fee</th><th role="columnheader" scope="col">Bars</th><th role="columnheader" scope="col">Nights needed run by its owner, needed with a manager, and booked</th></tr></thead><tbody role="rowgroup"><tr role="row"><th role="rowheader" scope="row"><a href="/submarkets/myrtle-beach/">Myrtle Beach, oceanfront</a><small>HOA fee $1,225 a month</small></th><td role="cell" class="bars"><span class="b" style="--f:0.791" aria-hidden="true"></span><span class="b mg" style="--f:1" aria-hidden="true"></span><span class="b mi" style="--f:0.626" aria-hidden="true"></span></td><td role="cell" class="v"><span>110 needed</span><span class="mg">139 managed</span><span>87 booked</span></td></tr><tr role="row"><th role="rowheader" scope="row"><a href="/submarkets/north-myrtle-beach/">North Myrtle Beach, oceanfront</a><small>HOA fee $1,075 a month</small></th><td role="cell" class="bars"><span class="b" style="--f:0.748" aria-hidden="true"></span><span class="b mg" style="--f:0.942" aria-hidden="true"></span><span class="b mi" style="--f:0.518" aria-hidden="true"></span></td><td role="cell" class="v"><span>104 needed</span><span class="mg">131 managed</span><span>72 booked</span></td></tr><tr role="row"><th role="rowheader" scope="row"><a href="/submarkets/garden-city/">Garden City Beach</a><small>HOA fee $575 a month</small></th><td role="cell" class="bars"><span class="b" style="--f:0.475" aria-hidden="true"></span><span class="b mg" style="--f:0.597" aria-hidden="true"></span><span class="b mi" style="--f:0.683" aria-hidden="true"></span></td><td role="cell" class="v"><span>66 needed</span><span class="mg">83 managed</span><span>95 booked</span></td></tr><tr role="row"><th role="rowheader" scope="row"><a href="/submarkets/surfside-beach/">Surfside Beach</a><small>HOA fee $375 a month</small></th><td role="cell" class="bars"><span class="b" style="--f:0.302" aria-hidden="true"></span><span class="b mg" style="--f:0.374" aria-hidden="true"></span><span class="b mi" style="--f:0.576" aria-hidden="true"></span></td><td role="cell" class="v"><span>42 needed</span><span class="mg">52 managed</span><span>80 booked</span></td></tr></tbody></table><figcaption>A typical two-bedroom condo for sale that allows nightly rentals, before any loan. The bills are the HOA fee, the property tax and rental insurance. A manager takes 15 percent of the bookings. Nights booked: AirROI, 12 months to September 2026.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The low fees are in two kinds of places: on the beach in Garden City Beach, and inland in Surfside Beach.</p><ul class="st-cost st-where"><li><b>Garden City Beach, on the beach</b><span class="why">Nearly all are on Waccamaw Drive, the street along the beach. Beach House, Sea Watch and Garden Sands are among those with fees of $600 a month or less.</span></li><li><b>Surfside Beach, mostly inland</b><span class="why">Most are at Retreat at Glenns Bay, Golf Colony at Deerfield and Grand Palms Resort, a mile or more from the beach, with fees of $600 or less. On the oceanfront, the units listed at Sea Shadow have fees over $1,000, and the few others listed there have fees of $1,000 or less. An inland condo may book fewer nights than the town's average of 80, which counts the beach condos too. It pays its bills at about 42, about half that average.</span></li><li><b>Myrtle Beach, oceanfront</b><span class="why">The fees of $800 a month or less are at places like Ocean Forest Villas and Beach Colony. The fee pays the electric on every unit listed at Sand Dunes, the Caribbean, Dunes Village, Carolinian Beach Resort and Grande Shores.</span></li><li><b>North Myrtle Beach, oceanfront</b><span class="why">The fee pays the electric on most of the units listed at Bay Watch and Beach Cove.</span></li></ul><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-10-d/invest-str-tools/myrtle-beach-oceanfront-towers-and-houses-2011-1200w.webp" srcset="/images/2026-10-d/invest-str-tools/myrtle-beach-oceanfront-towers-and-houses-2011-600w.webp 600w, /images/2026-10-d/invest-str-tools/myrtle-beach-oceanfront-towers-and-houses-2011-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="675" alt="Four oceanfront towers with balconies and pools behind the dune in Myrtle Beach, with streets of houses and woods behind them, seen from a plane over the ocean" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: U.S. Geological Survey. License: Public domain" title="License: Public domain">Photo: U.S. Geological Survey</a></span></div><figcaption>Oceanfront towers in Myrtle Beach, with streets of houses behind them, seen from over the ocean.</figcaption></figure></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Tick the box in the calculator when the fee pays the electric, and the utilities line goes. Most oceanfront units are in the building's own rental program, which takes its own share. Our page on <a href="/invest/rental-program-vs-airbnb/" style="color:var(--navy);text-decoration:underline">a rental program or Airbnb</a> compares the two.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Send us the listing you are looking at</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We read the building's budget and what its fee pays for, at no cost.</p><a class="btn btn-brass" href="/contact/">Have us read the building's budget</a></div></div></section><section style="background:var(--ivory-2)" id="towns"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Town by town">Which Grand Strand town does an Airbnb do best in?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For the same size of home, the towns are close. In seven of the eight, the average two-bedroom took in about $21,000 to $28,000 a year. Little River took in far less, and Murrells Inlet and Garden City Beach did best.</p><figure style="margin:1.8rem 0;max-width:760px"><svg xmlns="http://www.w3.org/2000/svg" id="c3r-grand-strand-airbnb-town" viewBox="0 0 360 418" width="360" height="418" role="img" aria-label="Grand Strand Airbnb towns: a map of 8 places, numbered 1, North Myrtle Beach; 2, Myrtle Beach; 3, Surfside Beach; 4, Garden City Beach; 5, Murrells Inlet; 6, Pawleys Island; 7, Little River; and 8, Conway." style="display:block;width:100%;height:auto;max-width:760px;background:#f7f3ec;border:1px solid rgba(28,32,40,.15)"><style>#c3r-grand-strand-airbnb-town text{font-family:'DM Sans',system-ui,-apple-system,'Segoe UI',sans-serif;paint-order:stroke;stroke:#f7f3ec;stroke-width:3px;stroke-linejoin:round;fill:#1c2028}#c3r-grand-strand-airbnb-town .h{font:500 17px 'Fraunces',Georgia,serif}#c3r-grand-strand-airbnb-town .l{font-size:14px;font-weight:500}#c3r-grand-strand-airbnb-town .m{font-size:13px;font-weight:500;fill:#91592b}#c3r-grand-strand-airbnb-town .t{font-size:14px;font-weight:500;letter-spacing:.1em;fill:#5c6b78}#c3r-grand-strand-airbnb-town .T{font-size:14px;font-weight:500;letter-spacing:.1em;fill:#3b4450}#c3r-grand-strand-airbnb-town .o{font:italic 400 15px 'Fraunces',Georgia,serif;letter-spacing:.06em;fill:#3f6275;stroke:#c9dde6}#c3r-grand-strand-airbnb-town .p{font-size:14px;font-weight:500;fill:#4a6640}#c3r-grand-strand-airbnb-town .f{font-size:11px;font-weight:500;letter-spacing:.1em;fill:#1c2028}#c3r-grand-strand-airbnb-town .r{font-size:11px;font-weight:500;stroke:none;fill:#1c2