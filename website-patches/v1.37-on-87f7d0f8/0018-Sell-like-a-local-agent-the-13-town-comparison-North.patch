-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:760px}</style><style>main#main .hx-strip:empty{display:none}main#main .hx-strip:not(:empty)+.hx-fallback{display:none}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Pick a town, the bedrooms and who runs it. The calculator fills in what Airbnbs like it there charge and book on average, from AirROI, a company that publishes Airbnb data town by town.</p><div class="st-calc" role="group" aria-labelledby="stCalcT"><p class="t" id="stCalcT">Your rental, before any loan</p><div class="st-ask"><label class="st-f" for="stTown"><span>Town</span><select id="stTown"><option value="north-myrtle-beach">North Myrtle Beach</option><option value="myrtle-beach">Myrtle Beach</option><option value="surfside-beach">Surfside Beach</option><option value="garden-city-beach" selected>Garden City Beach</option><option value="murrells-inlet">Murrells Inlet</option><option value="pawleys-island">Pawleys Island</option><option value="little-river">Little River</option><option value="conway">Conway</option></select></label><div class="st-f" role="group" aria-label="Bedrooms"><span aria-hidden="true">Bedrooms</span><div class="st-seg"><button type="button" data-b="2" aria-pressed="true">2</button><button type="button" data-b="3" aria-pressed="false">3</button></div></div><div class="st-f" role="group" aria-label="Who runs it"><span aria-hidden="true">Who runs it</span><div class="st-seg"><button type="button" data-m="0" aria-pressed="true">You</button><button type="button" data-m="15" aria-pressed="false">A manager</button></div></div></div><p class="st-ans" id="stSay" aria-live="polite">A typical two-bedroom condo in Garden City Beach keeps about <strong>$5,100 a year</strong> after its bills, before any loan.</p><div class="st-res"><div class="ln"><span>Guests pay a year</span><strong id="stGross">$26,800</strong></div><div class="ln"><span>Costs and bills take</span><strong id="stTake">-$21,700</strong></div><div class="ln keep"><span id="stKeptL">You keep</span><strong id="stKept">$5,100</strong></div><div class="ln"><span>Nights to break even<small id="stBk">The average one here books 95</small></span><strong id="stNeed">66</strong></div></div><p class="st-fine">A rough estimate from town averages, not a forecast for one condo. Your own listing can do better or worse.</p><details class="st-more" id="stMore"><summary>Change the numbers</summary><p class="st-note" id="stFill"></p><div class="st-grid"><div><label for="stPrice">Price, $<input id="stPrice" type="number" min="0" step="1000" value="343500" inputmode="decimal"></label><label for="stFee">HOA fee a month, $<input id="stFee" type="number" min="0" step="25" value="575" inputmode="decimal"></label><label for="stNightly">Nightly rate, $<input id="stNightly" type="number" min="0" step="1" value="243" inputmode="decimal"></label><label for="stNights">Nights booked a year<input id="stNights" type="number" min="0" step="1" value="95" inputmode="decimal" max="365"></label></div><div><div class="row"><span><label for="stTax">Property tax a year, $</label><button type="button" class="q" aria-expanded="false" aria-controls="stTaxQ" aria-label="What the property tax means">?</button></span><input id="stTax" type="number" min="0" step="1" value="4272" inputmode="decimal"></div><p class="tip" id="stTaxQ">The county taxes a rental you do not live in on 6 percent of its value, at the tax rate for its address. On the Garden City Beach condo that is about $4,300 a year, about 1.2 percent of the price. The calculator fills it in from the price where we know the rate.</p><label for="stIns">Rental insurance and permit a year, $<input id="stIns" type="number" min="0" step="10" value="620" inputmode="decimal"></label><label for="stMgr">Manager, % of nightly bookings<input id="stMgr" type="number" min="0" step="0.5" value="0" inputmode="decimal" max="100"></label><label class="ck" for="stUtil"><input id="stUtil" type="checkbox"><span>The HOA fee pays the electric and internet</span></label></div></div><div class="st-break"><p class="k">Where the money goes</p><div class="ln"><span>Cleaner, paid by the guest's cleaning fee</span><strong id="stClean">-$3,758</strong></div><div class="ln"><span>Airbnb's fee</span><strong id="stAir">-$3,490</strong></div><div class="ln"><span>Utilities and internet</span><strong id="stUt">-$1,342</strong></div><div class="ln"><span>Supplies and repairs</span><strong id="stSup">-$1,342</strong></div><div class="ln"><span>Manager</span><strong id="stMg">$0</strong></div><div class="ln"><span>HOA fee</span><strong id="stHoa">-$6,900</strong></div><div class="ln"><span>Property tax</span><strong id="stTx">-$4,272</strong></div><div class="ln"><span>Insurance and permit</span><strong id="stIn">-$620</strong></div></div><p class="st-note">The rate and nights are town averages, so one unit can do better or worse. Costs are AirROI's shares for the town, the low end of what owners pay. Your own condo insurance policy is extra, and no loan is counted. Chapter3 does not manage rentals.</p></details></div><script>(function(){var D={"north-myrtle-beach":{"key":"north-myrtle-beach","name":"North Myrtle Beach","clean":15,"run":24,"ins":510,"adr2":246,"n2":72,"adr3":348,"n3":73,"mills":221.2,"price":369900,"fee":1075,"ocean":1},"myrtle-beach":{"key":"myrtle-beach","name":"Myrtle Beach","clean":13,"run":24,"ins":390,"adr2":252,"n2":87,"adr3":339,"n3":95,"mills":254.6,"price":327000,"fee":1225,"ocean":1},"surfside-beach":{"key":"surfside-beach","name":"Surfside Beach","clean":14,"run":23,"ins":640,"adr2":245,"n2":80,"adr3":315,"n3":92,"mills":201,"price":192000,"fee":375},"garden-city-beach":{"key":"garden-city-beach","name":"Garden City Beach","clean":14,"run":23,"ins":620,"adr2":243,"n2":95,"adr3":352,"n3":95,"mills":207.3,"price":343500,"fee":575},"murrells-inlet":{"key":"murrells-inlet","name":"Murrells Inlet","clean":14,"run":24,"ins":720,"adr2":230,"n2":104,"adr3":304,"n3":93,"mills":null,"price":null,"fee":null},"pawleys-island":{"key":"pawleys-island","name":"Pawleys Island","clean":17,"run":24,"ins":470,"adr2":253,"n2":75,"adr3":325,"n3":71,"mills":null,"price":null,"fee":null},"little-river":{"key":"little-river","name":"Little River","clean":16,"run":24,"ins":220,"adr2":177,"n2":56,"adr3":249,"n3":64,"mills":null,"price":null,"fee":null},"conway":{"key":"conway","name":"Conway","clean":12,"run":24,"ins":350,"adr2":185,"n2":114,"adr3":257,"n3":108,"mills":null,"price":null,"fee":null}};var run=function(i){var cl=i.clean/100,gross=i.nights>0&&cl<1?i.rate*i.nights/(1-cl):0;var c={gross:gross,clean:gross*cl,airbnb:gross*(i.run-10)/100,util:i.util?0:gross*0.05,supRep:gross*0.05,mgr:i.rate*i.nights*i.mgr/100};c.before=c.gross-c.clean-c.airbnb-c.util-c.supR