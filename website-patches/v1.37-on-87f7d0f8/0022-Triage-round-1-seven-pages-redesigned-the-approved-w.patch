y)}66%,100%{background:transparent}}}@media (min-width:700px){.c3ph-swipe{display:none}}.c3ph-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:1.4rem 0 1.8rem;padding:0;list-style:none}@media (min-width:700px){.c3ph-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}}@media (min-width:1000px){.c3ph-cards.c3ph-4{grid-template-columns:repeat(4,minmax(0,1fr))}}.c3ph-card{margin:0;background:var(--ivory);border:1px solid var(--rule);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}.c3ph-card .c3ph-f{border-radius:0}.c3ph-card img,.c3ph-card svg{display:block;width:100%;height:auto;aspect-ratio:var(--c3ph-r,4/3);object-fit:cover}.c3ph-card .c3ph-cr{font-size:.56rem;padding:1.2rem .45rem .25rem 1.6rem}.c3ph-card strong{display:block;color:var(--navy);font-size:.98rem;font-weight:500;line-height:1.3;padding:.7rem .8rem 0}.c3ph-card span.c3ph-t{display:block;color:var(--muted);font-size:.86rem;line-height:1.45;padding:.2rem .8rem .85rem}.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:760px}</style><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-e/act-388-changes/surfside-beach-houses-on-the-dunes-1200w.webp" srcset="/images/2026-11-e/act-388-changes/surfside-beach-houses-on-the-dunes-600w.webp 600w, /images/2026-11-e/act-388-changes/surfside-beach-houses-on-the-dunes-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="675" alt="A row of two-story beach houses behind the dunes in Surfside Beach, seen from the sand under a blue sky" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: BullDawg2021. License: CC BY-SA 4.0" title="License: CC BY-SA 4.0">Photo: BullDawg2021</a></span></div><figcaption>Beach houses behind the dunes in Surfside Beach. A house here that is not the owner's home is taxed on 6% of its value.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The example house pays about 0.6% of its value a year as a home you live in, and about 1.5% as a second home. A statewide study by the Lincoln Institute found about the same: half a percent for homeowners, a little over one and a half for apartments.</p></div></section><section style="background:var(--ivory-2)" id="the-15-cap"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The 15% cap and a sale">How does the 15% cap work, and when does it reset?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The 15% cap limits how much a reassessment can raise your taxable value while you own the home. A sale or an addition ends the limit for that property.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">From late 2019 to late 2024, home prices in the Myrtle Beach metro rose 69% on the federal housing agency's index. An owner who did not sell or add on saw a taxable value rise of 15% at most.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The buyer starts at market value. The 2011 law reduces that for a second home or rental. A quarter of the value at the sale is exempt. It still cannot go below what the seller paid tax on.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">One house, four owners</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Take a house on the roll at $200,000 at one reassessment. At the next, the cap lets it rise to $230,000 at most. It sells for $350,000. The chart gives the 2026 bill for each kind of owner.</p><figure style="margin:1.8rem 0;max-width:760px"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 262 260" role="img" aria-label="Yearly tax on one $350,000 Myrtle Beach house: lives there, long-time owner, about $1,300; lives there, new buyer, about $2,000; rents it out, owned before 2011, about $3,500; second home or rental, new buyer, about $4,000." style="display:block;width:100%;max-width:380px;height:auto"><title>Yearly tax on one $350,000 Myrtle Beach house: lives there, long-time owner, about $1,300; lives there, new buyer, about $2,000; rents it out, owned before 2011, about $3,500; second home or rental, new buyer, about $4,000.</title><text x="0" y="24" font-family="system-ui,-apple-system,Segoe UI,sans-serif" font-size="15" fill="#1c2028">Lives there, long-time owner</text><rect x="0" y="33" width="50" height="18" rx="9" fill="#1c2028"/><text x="57" y="47" font-family="system-ui,-apple-system,Segoe UI,sans-serif" font-size="15" font-weight="600" fill="#1c2028">about $1,300</text><text x="0" y="86" font-family="system-ui,-apple-system,Segoe UI,sans-serif" font-size="15" fill="#1c2028">Lives there, new buyer</text><rect x="0" y="95" width="76" height="18" rx="9" fill="#1c2028"/><text x="83" y="109" font-family="system-ui,-apple-system,Segoe UI,sans-serif" font-size="15" font-weight="600" fill="#1c2028">about $2,000</text><text x="0" y="148" font-family="system-ui,-apple-system,Segoe UI,sans-serif" font-size="15" fill="#1c2028">Rents it out, owned before 2011</text><rect x="0" y="157" width="131" height="18" rx="9" fill="#c4783a"/><text x="138" y="171" font-family="system-ui,-apple-system,Segoe UI,sans-serif" font-size="15" font-weight="600" fill="#1c2028">about $3,500</text><text x="0" y="210" font-family="system-ui,-apple-system,Segoe UI,sans-serif" font-size="15" fill="#1c2028">Second home or rental, new buyer</text><rect x="0" y="219" width="150" height="18" rx="9" fill="#c4783a"/><text x="157" y="233" font-family="system-ui,-apple-system,Segoe UI,sans-serif" font-size="15" font-weight="600" fill="#1c2028">about $4,000</text></svg><figcaption style="color:var(--muted);font-size:.85rem;line-height:1.6;margin-top:.6rem">One $350,000 house inside Myrtle Beach, four owners, the 2026 bill. Dark bars are taxed at 4%, brass bars at 6%. Our example, before credits, fees and any special district.</figcaption></figure><style>.c3-cc{margin:1.4rem 0 1.8rem;max-width:960px}.c3-cc table{width:100%;border-collapse:collapse;font-size:var(--read,1.0625rem);line-height:1.45;color:var(--muted)}.c3-cc caption{caption-side:top;text-align:left;color:var(--navy);font-weight:600;font-size:1em;line-height:1.4;padding:0 0 .7rem}.c3-cc th,.c3-cc td{padding:.6rem .7rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule);overflow-wrap:break-word}.c3-cc thead th{color:var(--navy);font-weight:600;font-size:1em;border-bottom:2px solid var(--navy);vertical-align:bottom}.c3-cc tbody th{color:var(--navy);font-weight:600}.c3-cc .n{text-align:right;font-variant-numeric:tabular-nums}.c3-cc .i{display:inline-flex;vertical-align:-4px;margin-right:.45rem;color:var(--brass-ink)}.c3-cc tr.c3-self>*{background:#fff}@media (max-width:39.999em){.c3-cc table,.c3-cc tbody,.c3-cc tr,.c3-cc th,.c3-cc td{display:block;width:auto}.c3-cc caption{display:block}.c3-cc thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.c3-cc tbody tr{background:var(--ivory-2);border-top:3px solid var(--brass);margin:0 0 .8rem;padding:.5rem 0 .6rem}section[style*="background:var(--ivory-2)"] .c3-cc tbody tr{background:var(--ivory)}.c3-cc tr.c3-self{background:#fff!important;border:2px solid var(--brass)}.c3-cc tr.c3-self>*{background:transparent}.c3-cc th,.c3-cc td{border:0;padding:.2rem 1rem}.c3-cc tbody th{display:flex;align-items:center;font-size:1.1em;padding-bottom:.35rem}.c3-cc tbody th .i{flex:none;vertical-align:0}.c3-cc tbody th a{display:inline-block;padding:.5rem 0}.c3-cc .n{text-align:left}.c3-cc td[data-label]::before{content:attr(data-label) ": ";color:var(--navy);font-weight:500}}</style><div class="c3-cc"><table><caption>The four bills, worked out</caption><thead><tr><th scope="col">Owner</th><th scope="col" class="n">Taxable value</th><th scope="col">Rate</th><th scope="col" class="n">Yearly tax</th></tr></thead><tbody><tr><th scope="row">Lives there, long-time owner</th><td class="n" data-label="Taxable value">$230,000</td><td data-label="Rate">4%, no school operating tax</td><td class="n" data-label="Yearly tax">$1,338.60</td></tr><tr><th scope="row">Lives there, new buyer</th><td class="n" data-label="Taxable value">$350,000</td><td data-label="Rate">4%, no school operating tax</td><td class="n" data-label="Yearly tax">$2,037.00</td></tr><tr><th scope="row">Rents it out, owned before 2011</th><td class="n" data-label="Taxable value">$230,000</td><td data-label="Rate">6%, with school operating tax</td><td class="n" data-label="Yearly tax">$3,513.48</td></tr><tr><th scope="row">Second home or rental, new buyer</th><td class="n" data-label="Taxable value">$262,500</td><td data-label="Rate">6%, with school operating tax</td><td class="n" data-label="Yearly tax">$4,009.95</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The new second-home buyer pays about 3 times what the long-time owner who lives there pays, on the same house. The buyer who moves in pays more than the long-time owner too, but at the lower rate.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Before you make an offer on a Grand Strand home</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We work out its tax bill as a home you live in and as a second home, from the county's own record.</p><a class="btn btn-brass" href="/contact/">Get the tax on a home</a></div></div></section><section style="background:var(--ivory)" id="candidates"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What the candidates said">What did Alan Wilson and Jermaine Johnson say about Act 388?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Alan Wilson plans to look at reforming Act 388 so rentals are not taxed at a higher rate. Jermaine Johnson's platform, as WMBF summed it up, called for lower property taxes. Neither named a rate, a bill or a cost.</p><style>.c3-cc{margin:1.4rem 0 1.8rem;max-width:960px}.c3-cc table{width:100%;border-collapse:collapse;font-size:var(--read,1.0625rem);line-height:1.45;color:var(--muted)}.c3-cc caption{caption-side:top;text-align:left;color:var(--navy);font-weight:600;font-size:1em;line-height:1.4;padding:0 0 .7rem}.c3-cc th,.c3-cc td{padding:.6rem .7rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule);overflow-wrap:break-word}.c3-cc thead th{color:var(--navy);font-weight:600;font-size:1em;border-bottom:2px solid var(--navy);vertical-align:bottom}.c3-cc tbody th{color:var(--navy);font-weight:600}.c3-cc .n{text-align:right;font-variant-numeric:tabular-nums}.c3-cc .i{display:inline-flex;vertical-align:-4px;margin-right:.45rem;color:var(--brass-ink)}.c3-cc tr.c3-self>*{background:#fff}@media (max-width:39.999em){.c3-cc table,.c3-cc tbody,.c3-cc tr,.c3-cc th,.c3-cc td{display:block;width:auto}.c3-cc caption{display:block}.c3-cc thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.c3-cc tbody tr{background:var(--ivory-2);border-top:3px solid var(--brass);margin:0 0 .8rem;padding:.5rem 0 .6rem}section[style*="background:var(--ivory-2)"] .c3-cc tbody tr{background:var(--ivory)}.c3-cc tr.c3-self{background:#fff!important;border:2px solid var(--brass)}.c3-cc tr.c3-self>*{background:transparent}.c3-cc th,.c3-cc td{border:0;padding:.2rem 1rem}.c3-cc tbody th{display:flex;align-items:center;font-size:1.1em;padding-bottom:.35rem}.c3-cc tbody th .i{flex:none;vertical-align:0}.c3-cc tbody th a{display:inline-block;padding:.5rem 0}.c3-cc .n{text-align:left}.c3-cc td[data-label]::before{content:attr(data-label) ": ";color:var(--navy);font-weight:500}}</style><div class="c3-cc"><table><caption>The same tests for both candidates for governor</caption><thead><tr><th scope="col">Test</th><th scope="col">Alan Wilson (R)</th><th scope="col">Jermaine Johnson (D)</th></tr></thead><tbody><tr><th scope="row">In their words</th><td data-label="Alan Wilson (R)">Reform how rentals are assessed</td><td data-label="Jermaine Johnson (D)">Lower property taxes</td></tr><tr><th scope="row">A bill filed</th><td data-label="Alan Wilson (R)">None named</td><td data-label="Jermaine Johnson (D)">None named</td></tr><tr><th scope="row">A rate or dollar amount</th><td data-label="Alan Wilson (R)">None named</td><td data-label="Jermaine Johnson (D)">None named</td></tr><tr><th scope="row">Who pays the difference</th><td data-label="Alan Wilson (R)">Not named</td><td data-label="Jermaine Johnson (D)">Not named</td></tr><tr><th scope="row">Other property tax plans</th><td data-label="Alan Wilson (R)">Homestead exemption changes</td><td data-label="Jermaine Johnson (D)">None in the summary</td></tr></tbody></table></div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What Wilson said</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In a WIS interview, Wilson said he is "looking at Act 388 and reforming how we assess property taxes on those types of properties," meaning rentals. Owner-occupied homes "are taxed at a much lower rate," he said. "Second, third, and fourth homes, which are usually rental properties, are taxed at a higher rate," he added.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What his agenda lists</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">His agenda lists "Reforming Act 388 to remove higher property taxes for rental properties," as Fox Carolina reported it. The agenda also lists automatic sign-up for the senior exemption, a larger exemption for disabled veterans, and lower personal property taxes for businesses.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What Johnson's platform lists</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">WMBF's summary also lists income tax relief for lower-income families and more affordable housing. Johnson conceded on election night.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The U.S. Senate race, won by Annie Andrews, does not change this tax. The rates are in the state constitution. Our <a href="/market-reports/2026-election/" style="color:var(--navy);text-decoration:underline">guide to what the 2026 election means for Myrtle Beach buyers and sellers</a> shows which office can change what.</p></div></section><section style="background:var(--ivory-2)" id="bills"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Bills and their status">Which Act 388 bills are in the South Carolina legislature now?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">One became law and the rest are in committee. We read each bill's page at the Statehouse, and none of them lowers the 6% rate.</p><div class="a388-bills"><div style="overflow-x:auto;margin:1.2rem 0;max-width:760px"><table style="width:100%;border-collapse:collapse;font-size:.92rem"><thead><tr><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Bill</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">What it does</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Where it stands</th></tr></thead><tbody><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/3841.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">H. 3841, now Act 140</a></td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">A home keeps the 4% rate after the owner dies, until the estate closes, a deed out of the estate is recorded, or Dec. 31 of the year after the death. It ends if the home is rented more than 72 days.</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Signed into law. House 107-0 and 109-0, Senate 43-0.</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/815.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">S. 815</a></td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">A change to the constitution: the legislature could choose the classes of property and their rates by law.</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Senate Finance Committee.</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/768.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">S. 768</a></td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Raises the senior homestead exemption from $50,000 of value to $150,000 for those who qualified in 2025 and residents of 10 years, and to $75,000 for residents of five years.</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Passed the Senate 44-0. House Ways and Means Committee.</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/3445.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">H. 3445</a></td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">A spouse may claim the 4% rate.</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">House Ways and Means Committee.</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/3352.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">H. 3352</a></td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">The assessor may not demand confidential tax records for the 4% rate.</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">House Ways and Means Committee.</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/4608.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">H. 4608</a></td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">The 4% rate for family dwellings on the same lot.</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">House Ways and Means Committee.</td></tr></tbody></table></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Two Horry County representatives, Kevin Hardee and William Bailey, were among the sponsors of Act 140. No one voted against it in either house.</p></div></section><section style="background:var(--ivory)" id="what-it-would-take"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What it would take">What would it take to lower the 6% rate on second homes and rentals?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Two-thirds of the members of each house must vote for it. The governor can propose a change, but the vote is the legislature's.</p><div class="a388-stats" role="list" aria-label="Votes needed against seats won"><div role="listitem"><b>83</b>House votes needed, of 124</div><div role="listitem"><b>79</b>House seats Republicans won, unofficial</div><div role="listitem"><b>31</b>Senate votes needed, of 46</div><div role="listitem"><b>34</b>Senate seats Republicans have</div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Senate was not on the ballot this year, except one special race. In the House, Republicans would need at least four Democratic votes. Two close House races go to a recount by law. Whichever way they go, Republicans would have 78 to 80 seats.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The House districts on Horry County ballots elected eight Republicans and three Democrats. Cutting the school tax break for the home you live in also takes a two-thirds roll-call vote in each house.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">The longer route: S. 815</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">S. 815 would change the constitution itself. That takes two-thirds of each house and then a majority of voters at the next general election, in November 2028. The next legislature must then ratify it.</p></div></section><section style="background:var(--ivory-2)" id="next-reassessment"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Next reassessment">When is Horry County's next reassessment?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Tax year 2029 is our estimate, or 2030 if the county postpones. State law requires a reassessment every fifth year, and a county may put one off by a year.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The county reassessed for tax year 2019 and scheduled the next for 2024. We checked the county's assessor guide: it gives no date for the one after.</p><ul style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem"><strong>If you have not sold or added on,</strong> the 15% cap limits your rise in taxable value at that reassessment.</li><li style="margin-bottom:.5rem"><strong>If you bought after the last one,</strong> your value already started at the price you paid.</li><li style="margin-bottom:.5rem"><strong>If voters approved the amendment in 2028,</strong> the next legislature would ratify it about when the reassessment is due. Any new rates would still need a law.</li></ul></div></section><section style="background:var(--ivory)" id="who-pays"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Who pays more or less">Who would pay more or less under each change?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A lower rate for rentals would cut their bills by about a third or more, and no plan names who would make up the money. The bills already passed or pending help homeowners and heirs.</p><style>.c3-cc{margin:1.4rem 0 1.8rem;max-width:960px}.c3-cc table{width:100%;border-collapse:collapse;font-size:var(--read,1.0625rem);line-height:1.45;color:var(--muted)}.c3-cc caption{caption-side:top;text-align:left;color:var(--navy);font-weight:600;font-size:1em;line-height:1.4;padding:0 0 .7rem}.c3-cc th,.c3-cc td{padding:.6rem .7rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule);overflow-wrap:break-word}.c3-cc thead th{color:var(--navy);font-weight:600;font-size:1em;border-bottom:2px solid var(--navy);vertical-align:bottom}.c3-cc tbody th{color:var(--navy);font-weight:600}.c3-cc .n{text-align:right;font-variant-numeric:tabular-nums}.c3-cc .i{display:inline-flex;vertical-align:-4px;margin-right:.45rem;color:var(--brass-ink)}.c3-cc tr.c3-self>*{background:#fff}@media (max-width:49.999em){.c3-cc table,.c3-cc tbody,.c3-cc tr,.c3-cc th,.c3-cc td{display:block;width:auto}.c3-cc caption{display:block}.c3-cc thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.c3-cc tbody tr{background:var(--ivory-2);border-top:3px solid var(--brass);margin:0 0 .8rem;padding:.5rem 0 .6rem}section[style*="background:var(--ivory-2)"] .c3-cc tbody tr{background:var(--ivory)}.c3-cc tr.c3-self{background:#fff!important;border:2px solid var(--brass)}.c3-cc tr.c3-self>*{background:transparent}.c3-cc th,.c3-cc td{border:0;padding:.2rem 1rem}.c3-cc tbody th{display:flex;align-items:center;font-size:1.1em;padding-bottom:.35rem}.c3-cc tbody th .i{flex:none;vertical-align:0}.c3-cc tbody th a{display:inline-block;padding:.5rem 0}.c3-cc .n{text-align:left}.c3-cc td[data-label]::before{content:attr(data-label) ": ";color:var(--navy);font-weight:500}}</style><div class="c3-cc"><table><caption>Each change, by kind of owner</caption><thead><tr><th scope="col">Change</th><th scope="col">Home you live in</th><th scope="col">Second home</th><th scope="col">Rental</th><th scope="col">Business</th></tr></thead><tbody><tr><th scope="row">Rentals taxed at 4% (Wilson's idea)</th><td data-label="Home you live in">Larger share if money not replaced</td><td data-label="Second home">Unknown until a bill is written</td><td data-label="Rental">About a third off, or more</td><td data-label="Business">Larger share if money not replaced</td></tr><tr><th scope="row">S. 815 (rates chosen by law)</th><td data-label="Home you live in">No change by itself</td><td data-label="Second home">No change by itself</td><td data-label="Rental">No change by itself</td><td data-label="Business">No change by itself</td></tr><tr><th scope="row">Act 140 (law now)</th><td data-label="Home you live in">Heirs keep 4% for a time</td><td data-label="Second home">No change</td><td data-label="Rental">Heirs lose 4% if rented over 72 days</td><td data-label="Business">No change</td></tr><tr><th scope="row">S. 768 (larger homestead exemption)</th><td data-label="Home you live in">Larger exemption, if you qualify</td><td data-label="Second home">No change</td><td data-label="Rental">No change</td><td data-label="Business">No change</td></tr><tr><th scope="row">Business personal property cut</th><td data-label="Home you live in">No change</td><td data-label="Second home">No change</td><td data-label="Rental">No change</td><td data-label="Business">Lower, if a bill passes</td></tr></tbody></table></div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Who would make up the money?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In 2006 the state named a new source, the extra sales tax, for the money homeowners stopped paying. No plan to lower the rental rate names one.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If none were named, the same dollars would have to come from the rest of the tax roll. For a tax every kind of property pays, such as the county's own tax, each kind pays its share of taxable value.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Of the real property the county assessor values, homes their owners live in were taxed on 30.8% in 2018. With every 6% home moved to 4% and the same dollars raised, that would rise to about 37%.</p><style>.c3-cc{margin:1.4rem 0 1.8rem;max-width:960px}.c3-cc table{width:100%;border-collapse:collapse;font-size:var(--read,1.0625rem);line-height:1.45;color:var(--muted)}.c3-cc caption{caption-side:top;text-align:left;color:var(--navy);font-weight:600;font-size:1em;line-height:1.4;padding:0 0 .7rem}.c3-cc th,.c3-cc td{padding:.6rem .7rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule);overflow-wrap:break-word}.c3-cc thead th{color:var(--navy);font-weight:600;font-size:1em;border-bottom:2px solid var(--navy);vertical-align:bottom}.c3-cc tbody th{color:var(--navy);font-weight:600}.c3-cc .n{text-align:right;font-variant-numeric:tabular-nums}.c3-cc .i{display:inline-flex;vertical-align:-4px;margin-right:.45rem;color:var(--brass-ink)}.c3-cc tr.c3-self>*{background:#fff}@media (max-width:39.999em){.c3-cc table,.c3-cc tbody,.c3-cc tr,.c3-cc th,.c3-cc td{display:block;width:auto}.c3-cc caption{display:block}.c3-cc thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.c3-cc tbody tr{background:var(--ivory-2);border-top:3px solid var(--brass);margin:0 0 .8rem;padding:.5rem 0 .6rem}section[style*="background:var(--ivory-2)"] .c3-cc tbody tr{background:var(--ivory)}.c3-cc tr.c3-self{background:#fff!important;border:2px solid var(--brass)}.c3-cc tr.c3-self>*{background:transparent}.c3-cc th,.c3-cc td{border:0;padding:.2rem 1rem}.c3-cc tbody th{display:flex;align-items:center;font-size:1.1em;padding-bottom:.35rem}.c3-cc tbody th .i{flex:none;vertical-align:0}.c3-cc tbody th a{display:inline-block;padding:.5rem 0}.c3-cc .n{text-align:left}.c3-cc td[data-label]::before{content:attr(data-label) ": ";color:var(--navy);font-weight:500}}</style><div class="c3-cc"><table><caption>Share of taxable value, property the Horry County assessor values</caption><thead><tr><th scope="col">Kind of property</th><th scope="col" class="n">Share, 2018</th><th scope="col" class="n">With 6% homes at 4%</th></tr></thead><tbody><tr><th scope="row">Homes their owners live in</th><td class="n" data-label="Share, 2018">30.8%</td><td class="n" data-label="With 6% homes at 4%">about 37%</td></tr><tr><th scope="row">Other homes, mostly rentals</th><td class="n" data-label="Share, 2018">47.2%</td><td class="n" data-label="With 6% homes at 4%">about 37%</td></tr><tr><th scope="row">Commercial property</th><td class="n" data-label="Share, 2018">21.1%</td><td class="n" data-label="With 6% homes at 4%">about 25%</td></tr></tbody></table></div><ul style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem"><strong>Every 6% home moves.</strong> The calculation moves the whole higher-rate class to the lower rate, second homes included. If only rentals moved, the shift would be smaller.</li><li style="margin-bottom:.5rem"><strong>The rest is held fixed.</strong> The rest of the roll, under one percent, is held as it was.</li><li style="margin-bottom:.5rem"><strong>What is not counted.</strong> Property the state values, such as factories and utilities, and vehicles are not in these figures.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The figures are a calculation, not a forecast. The school operating tax works differently: homes their owners live in do not pay it, so that part would fall on second homes, rentals and businesses.</p></div></section><section style="background:var(--ivory-2)" id="evidence"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Evidence on both sides">What does the evidence say about Act 388, for and against?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The main study says the state's system moved the tax off homes their owners live in and onto other property. Lawmakers have kept widening the homeowner side, with no votes against.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">The case that it shifted the tax</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The <a href="https://www.lincolninst.edu/app/uploads/legacy-files/pubfiles/sc_volume_2_chapter_2.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Lincoln Institute of Land Policy</a> wrote the study in 2020. The South Carolina Chamber Foundation and South Carolina Realtors picked the ten counties it studied, Horry among them. Its subtitle calls the system "Complex, Inequitable and Uncompetitive."</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">It found the burden has shifted "from owner-occupied residential properties to non-owner-occupied residential properties." It names commercial, manufacturing and utility property too. In Horry County the figures look like this:</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="Horry County, 2018: who owns the value, and who is taxed on it"><span class="cap" aria-hidden="true">Horry County, 2018: who owns the value, and who is taxed on it</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Kind of property</span><span role="columnheader">Share</span></div></div><div role="rowgroup"><div role="row" class="ref"><span role="rowheader"><span class="n">Homes their owners live in, share of market value</span></span><span role="cell"><span class="b" style="--f:0.71" aria-hidden="true"></span><span class="v">35.5%</span></span></div><div role="row"><span role="rowheader"><span class="n">Homes their owners live in, share of taxable value</span></span><span role="cell"><span class="b" style="--f:0.616" aria-hidden="true"></span><span class="v">30.8%</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Other homes, mostly rentals, share of market value</span></span><span role="cell"><span class="b" style="--f:0.728" aria-hidden="true"></span><span class="v">36.4%</span></span></div><div role="row"><span role="rowheader"><span class="n">Other homes, mostly rentals, share of taxable value</span></span><span role="cell"><span class="b" style="--f:0.944" aria-hidden="true"></span><span class="v">47.2%</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Commercial property, share of market value</span></span><span role="cell"><span class="b" style="--f:0.428" aria-hidden="true"></span><span class="v">21.4%</span></span></div><div role="row"><span role="rowheader"><span class="n">Commercial property, share of taxable value</span></span><span role="cell"><span class="b" style="--f:0.422" aria-hidden="true"></span><span class="v">21.1%</span></span></div></div></div><figcaption>Gray bars: share of market value. Brass bars: share of taxable value. Real property the county assessor values only; property the state values and vehicles are not in it. Taxable value is the assessed value, after the 4% or 6% rate. Other homes are, in the study's words, typically rental property at the 6% rate.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A 2025 student note in a University of South Carolina law journal adds two claims. It says the rental rate has led to "rising rent costs" in South Carolina. It says the rate "can also prevent the development of affordable housing" as well. The note cites other sources and is not a measured study.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">The case for keeping it</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A group at nohometax.org publishes a page titled "We Support Act 388." The legislature's own votes point the same way.</p><ul style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem"><strong>Act 140</strong> passed the House twice and the Senate with no votes against.</li><li style="margin-bottom:.5rem"><strong>S. 768</strong>, the larger senior exemption, passed the Senate with no votes against.</li><li style="margin-bottom:.5rem"><strong>The school tax break</strong> for the home you live in can be cut only by a two-thirds roll-call vote of each house.</li></ul></div></section><section style="background:var(--ivory)" id="short-and-long-run"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Short and long run">What could happen to each kind of owner in the short run and the long run?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For homeowners, little changes in the first two years. For second homes and rentals, the range is from no change to about a third off a city bill, and only after a two-thirds vote.</p><div class="a388-grid two"><div class="a388-card"><h3>Home you live in</h3><span class="k">First 1 to 2 years</span><p>Nothing pending raises your 4% assessment. If every second home and rental moved to the lower rate with no new money, homes like yours would pay a larger share. The table under "Who would make up the money?" gives it.</p><span class="k">Five years and more</span><p>The 15% cap keeps your taxable value under the market while you own the home. It applies again at the next reassessment.</p><span class="k">Where this was tried before</span><p>In 2006 lawmakers paired the homeowner cut with a new sales tax, so school districts were paid back.</p></div><div class="a388-card"><h3>Second home</h3><span class="k">First 1 to 2 years</span><p>Wilson named "second, third, and fourth homes." Whether a cut would include a second home you never rent depends on a bill no one has written.</p><span class="k">Five years and more</span><p>When you sell, your buyer's value starts at the price, less the 25% exemption.</p><span class="k">Where this was tried before</span><p>That exemption came five years after Act 388. It applies at each sale of a home taxed at 6%.</p></div><div class="a388-card"><h3>Rental</h3><span class="k">First 1 to 2 years</span><p>No change until both houses pass a lower rate by two-thirds. Our <a href="/invest/short-term-rental-rules-statehouse/" style="color:var(--navy);text-decoration:underline">short-term rental rules guide</a> covers what else the Statehouse can change.</p><span class="k">Five years and more</span><p>Florida chose a different rule. It limits the yearly rise in assessment on a home that is not the owner's residence to 10%. The limit leaves out school taxes and buildings over nine units. We found no measured study of what that did to Florida rents or prices.</p><span class="k">Rents</span><p>Whether a lower tax would reach tenants is not known. The student note says the high rate has raised rents, without measuring it.</p></div><div class="a388-card"><h3>Business property</h3><span class="k">First 1 to 2 years</span><p>Wilson's agenda, as reported, lists lower personal property taxes for businesses. No bill was published.</p><span class="k">Five years and more</span><p>Commercial property was about a fifth of the taxable value of property the county assessor values. If every second home and rental moved to the lower rate with the same dollars raised, that share would rise toward a quarter.</p><span class="k">Where this was tried before</span><p>The Lincoln study found the shift fell partly on business property.</p></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Buying a second home now? Our <a href="/buyers/second-home/" style="color:var(--navy);text-decoration:underline">second home guide</a> and our <a href="/buyers/cost-to-own/" style="color:var(--navy);text-decoration:underline">cost to own a home here</a> give the rest of the yearly cost.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Thinking about a second home or a rental on the Grand Strand?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We work out the tax bill on the homes you like, at today's rates, before you make an offer.</p><a class="btn btn-brass" href="/contact/">Get the tax on a home</a></div></div></section><section style="background:var(--ivory-2)" id="act-388-questions"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Act 388 questions</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does a Myrtle Beach home get the 4% rate automatically?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. The owner must apply to the county for the 4% rate before the first penalty date. Without the application, the home is taxed at 6%, like a second home.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I get the 25% exemption on a second home I buy?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, if the home is taxed as a second home or rental and changed hands after 2010. The owner must notify the assessor before Jan. 31 of the first tax year claimed. The taxable value cannot fall below the seller's value on the roll.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does a home keep the 4% rate after the owner dies?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, for a time, under Act 140. The rate stays until the estate closes, a deed out of the estate is recorded, or Dec. 31 of the year after the death, whichever comes first. It ends if the home is rented more than 72 days.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Did Annie Andrews' win change property taxes in Horry County?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. The two rates are in the South Carolina Constitution. Only the state legislature, or the legislature and the state's voters together, can change them. A U.S. senator has no vote on them.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Will my property tax go up at the next Horry County reassessment?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If you have not sold or added on, your taxable value can rise no more than 15% at that reassessment. The tax rate can still change. We expect the next one for tax year 2029, from the state's five-year rule.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.scstatehouse.gov/scconstitution/A10.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">S.C. Const. Art. X</a>, <a href="https://www.scstatehouse.gov/scconstitution/A16.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Art. XVI</a>, <a href="https://www.scstatehouse.gov/code/t12c043.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">S.C. Code 12-43</a>, <a href="https://www.scstatehouse.gov/code/t12c037.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">12-37</a>, <a href="https://www.scstatehouse.gov/code/t12c036.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">12-36-1110</a>, <a href="https://www.scstatehouse.gov/code/t11c011.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">11-11-155</a>, <a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/815.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">S. 815</a>, <a href="https://www.horrycountysc.gov/media/kufln4qp/tax-levy-2026_2.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry 2026 levy</a>, <a href="https://www.horrycountysc.gov/departments/assessor/guide-to-assessment" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry assessor</a>, <a href="https://www.lincolninst.edu/app/uploads/legacy-files/pubfiles/sc_volume_2_chapter_2.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Lincoln Institute 2020</a>, <a href="https://sc.edu/study/colleges_schools/law/student_life/journals/jled/editions/_documents/2025_54_1/boyette_jled54.1_.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">USC law note 2025</a>, <a href="https://www.wistv.com/2026/10/28/full-interview-alan-wilson-shares-priorities-governor-ahead-election-day/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">WIS</a>, <a href="https://www.foxcarolina.com/2026/10/15/republican-nominee-sc-governor-alan-wilson-announces-affordability-agenda/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Fox Carolina</a>, <a href="https://www.wmbfnews.com/2026/09/30/sc-governor-candidates-split-taxes-infrastructure-ahead-registration-deadlines/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">WMBF</a>, <a href="https://wilsonforsc.com/priorities/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Wilson priorities</a>, <a href="https://scvotes.gov/2026-general-election-results/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Election Commission</a>, <a href="https://www.fhfa.gov/hpi/download/quarterly_datasets/hpi_at_metro.csv" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FHFA index</a>, <a href="https://www.flsenate.gov/Laws/Constitution" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Florida Const. Art. VII</a>. Election results are unofficial until certified. The four-owner example and the shares are our arithmetic. Not legal or tax advice.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Beach houses behind the dunes in Surfside Beach. Photo: BullDawg2021, <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a>, via <a href="https://commons.wikimedia.org/wiki/File:Surfside_Beach_Shoreline.jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-11-e/act-388-changes/surfside-beach-houses-on-the-dunes-1200w.webp","url":"https://chapter3realty.com/images/2026-11-e/act-388-changes/surfside-beach-houses-on-the-dunes-1200w.webp","width":1200,"height":675,"encodingFormat":"image/webp","name":"Beach houses behind the dunes in Surfside Beach","caption":"Beach houses behind the dunes in Surfside Beach. A house here that is not the owner's home is taxed on 6% of its value.","description":"A row of two-story beach houses behind the dunes in Surfside Beach, seen from the sand under a blue sky","creator":{"@type":"Person","name":"BullDawg2021"},"creditText":"BullDawg2021, CC BY-SA 4.0, via Wikimedia Commons","copyrightNotice":"© BullDawg2021, CC BY-SA 4.0","license":"https://creativecommons.org/licenses/by-sa/4.0/","acquireLicensePage":"https://commons.wikimedia.org/wiki/File:Surfside_Beach_Shoreline.jpg","isBasedOn":"https://commons.wikimedia.org/wiki/File:Surfside_Beach_Shoreline.jpg","contentLocation":{"@type":"Place","name":"Oceanfront, Surfside Beach, South Carolina"}}]}</script></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Buying or owning on the Grand Strand?</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">Send us the address. We work out the tax bill as a home you live in and as a second home, and what changes when it sells.</p><a class="btn btn-brass btn-lg" href="/contact/">Get the tax on a home</a></div></section></main>
