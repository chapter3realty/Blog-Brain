 <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is Surfside Beach part of Myrtle Beach?","acceptedAnswer":{"@type":"Answer","text":"No. Surfside Beach is its own town in Horry County, incorporated in 1964, with the ZIP code 29575."}},{"@type":"Question","name":"Can you Airbnb in Surfside Beach?","acceptedAnswer":{"@type":"Answer","text":"Only on the blocks near the ocean, in the town's R3 and C3 zoning districts. Rentals under 30 days are not allowed in the inland R1 and R2 districts."}},{"@type":"Question","name":"Can you drive a golf cart in Surfside Beach?","acceptedAnswer":{"@type":"Answer","text":"Yes, on town streets posted at 35 mph or less, with a state permit decal, insurance and a licensed driver 16 or older. Never on the beach."}},{"@type":"Question","name":"Are dogs allowed on Surfside Beach?","acceptedAnswer":{"@type":"Answer","text":"Not from 10 a.m. to 5 p.m., May 1 through Labor Day. At other times, leashed dogs are welcome."}},{"@type":"Question","name":"Is parking free in Surfside Beach?","acceptedAnswer":{"@type":"Answer","text":"Town lots charge from March 1 to October 31, 8 a.m. to 6 p.m. An owner who lives elsewhere gets two free passes per household."}},{"@type":"Question","name":"What is the property tax rate in Surfside Beach?","acceptedAnswer":{"@type":"Answer","text":"On a home the county values at $500,000, the town and county tax is about $2,100 a year as your main home. As a second home or rental, it is about $6,400."}},{"@type":"Question","name":"What schools serve Surfside Beach?","acceptedAnswer":{"@type":"Answer","text":"Horry County Schools, which assigns schools by address. We look up the assigned schools for any home you like."}},{"@type":"Question","name":"What about crime in Surfside Beach?","acceptedAnswer":{"@type":"Answer","text":"We do not rate places for crime. The town has its own police department, and the FBI publishes the crime each police agency reports."}}]}</script>
