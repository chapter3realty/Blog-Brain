th-child(1){animation-timeline:--c3ph-p1}.c3ph-dots i:nth-child(2){animation-timeline:--c3ph-p2}.c3ph-dots i:nth-child(3){animation-timeline:--c3ph-p3}@keyframes c3ph-dot{0%,36%{background:transparent}42%,60%{background:var(--navy)}66%,100%{background:transparent}}}@media (min-width:700px){.c3ph-swipe{display:none}}.c3ph-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:1.4rem 0 1.8rem;padding:0;list-style:none}@media (min-width:700px){.c3ph-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}}@media (min-width:1000px){.c3ph-cards.c3ph-4{grid-template-columns:repeat(4,minmax(0,1fr))}}.c3ph-card{margin:0;background:var(--ivory);border:1px solid var(--rule);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}.c3ph-card .c3ph-f{border-radius:0}.c3ph-card img,.c3ph-card svg{display:block;width:100%;height:auto;aspect-ratio:var(--c3ph-r,4/3);object-fit:cover}.c3ph-card .c3ph-cr{font-size:.56rem;padding:1.2rem .45rem .25rem 1.6rem}.c3ph-card strong{display:block;color:var(--navy);font-size:.98rem;font-weight:500;line-height:1.3;padding:.7rem .8rem 0}.c3ph-card span.c3ph-t{display:block;color:var(--muted);font-size:.86rem;line-height:1.45;padding:.2rem .8rem .85rem}.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:760px}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">An owner who opens the Airbnb all year and gets a third of its nights booked keeps the most. The chart below follows one Myrtle Beach two-bedroom, run by its owner.</p><figure class="c3-gchart"><div role="table" aria-label="What the owner of a Myrtle Beach two-bedroom keeps in a year, before the loan, tax and HOA fee"><span class="cap" aria-hidden="true">What the owner of a Myrtle Beach two-bedroom keeps in a year, before the loan, tax and HOA fee</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Rented as, what comes in</span><span role="columnheader">owner keeps</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Airbnb booked a third of the nights in the year</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about 124 nights at $252</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">$23,400</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Yearly lease</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">11 months at $1,504</span></span><span role="cell"><span class="b" style="--f:0.653" aria-hidden="true"></span><span class="v">$15,300</span></span></div><div role="row"><span role="rowheader"><span class="n">Airbnb, the middle two-bedroom listing</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">$20,100 of bookings and fees</span></span><span role="cell"><span class="b" style="--f:0.531" aria-hidden="true"></span><span class="v">$12,400</span></span></div></div></div><figcaption>Sources: AirROI's Myrtle Beach market, for an owner who runs it, and HUD's standard two-bedroom rent for the metro area, less utilities. Guests' cleaning fees are in the $20,100 and pay the cleaner.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Some costs are the same either way: the loan, the HOA fee, and the property tax, about $5,000 a year on an oceanfront condo listed near $325,000.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The lease figure uses the standard two-bedroom rent from HUD, the federal housing department, for the whole metro area. For an oceanfront unit, put its own rent in the calculator below.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our lease figure allows one empty month a year. South Carolina's rental vacancy rate is the share of rental homes empty and up for rent. It was 11 to 12 percent in each quarter the Census has reported this year, give or take about 3 points. Each extra empty month costs you about $1,500 of rent.</p></div></section><section style="background:var(--ivory)" id="is-it-allowed"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Is it allowed">Can you Airbnb a home in Myrtle Beach?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Inside Myrtle Beach city limits, a stay under 90 days counts as short-term. <a href="https://www.cityofmyrtlebeach.com/news_detail_T6_R1468.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">The city's residential zones do not allow it</a>, except one, the Residential Multifamily Visitor zone. Most of the city's traditional neighborhoods are not zoned for it.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Carolina Forest is outside city limits, in unincorporated Horry County. There the <a href="https://www.horrycountysc.gov/media/i0pfcm2o/appendix-b-zoning-ordinance-upated-912026.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">county's zoning code</a> has no short-term rental rule. A home's HOA rules may still not allow nightly stays. North Myrtle Beach and Conway have their own rules; our page on <a href="/invest/str-rules/" style="color:var(--navy);text-decoration:underline">short-term rental rules</a> gives them town by town.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The homes for sale show the split:</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}@media (max-width:699px){main#main .c3-gchart.c3-gchart-list [role=row]{grid-template-columns:minmax(0,1fr) auto;column-gap:.8rem;align-items:start}main#main .c3-gchart.c3-gchart-list .b{display:none}main#main .c3-gchart.c3-gchart-list .dot{display:none}main#main .c3-gchart.c3-gchart-list .f{display:block}main#main .c3-gchart.c3-gchart-list [role=cell]{justify-content:flex-end}}</style><figure class="c3-gchart c3-gchart-compact c3-gchart-list"><div role="table" aria-label="Homes for sale that the listing marks as allowing short-term rentals"><span class="cap" aria-hidden="true">Homes for sale that the listing marks as allowing short-term rentals</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Homes for sale, how many</span><span role="columnheader">share marked</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Myrtle Beach oceanfront condos</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">402 of 422 for sale</span></span><span role="cell"><span class="b" style="--f:0.953" aria-hidden="true"></span><span class="v">95%</span></span></div><div role="row"><span role="rowheader"><span class="n">North Myrtle Beach oceanfront condos</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">209 of 226 for sale</span></span><span role="cell"><span class="b" style="--f:0.925" aria-hidden="true"></span><span class="v">92%</span></span></div><div role="row"><span role="rowheader"><span class="n">North Myrtle Beach houses</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">112 of 258 for sale</span></span><span role="cell"><span class="b" style="--f:0.434" aria-hidden="true"></span><span class="v">43%</span></span></div><div role="row"><span role="rowheader"><span class="n">Myrtle Beach houses</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">18 of 201 for sale</span></span><span role="cell"><span class="b" style="--f:0.09" aria-hidden="true"></span><span class="v">9%</span></span></div><div role="row"><span role="rowheader"><span class="n">Houses with a Conway address</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">34 of 675 for sale</span></span><span role="cell"><span class="b" style="--f:0.05" aria-hidden="true"></span><span class="v">5%</span></span></div><div role="row"><span role="rowheader"><span class="n">Carolina Forest houses</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">1 of 294 for sale</span></span><span role="cell"><span class="b" style="--f:0.003" aria-hidden="true"></span><span class="v">under 1%</span></span></div></div></div><figcaption>Our count of the homes for sale in our search, by what the listing agent entered. Myrtle Beach means inside city limits. North Myrtle Beach and Conway are by the home's address.</figcaption></figure><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-10-d/invest-str-vs-ltr/myrtle-beach-oceanfront-towers-from-the-beach-1200w.webp" srcset="/images/2026-10-d/invest-str-vs-ltr/myrtle-beach-oceanfront-towers-from-the-beach-600w.webp 600w, /images/2026-10-d/invest-str-vs-ltr/myrtle-beach-oceanfront-towers-from-the-beach-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Tall oceanfront towers with rows of balconies behind the dune in Myrtle Beach, with more towers lined up along the beach into the distance under a blue sky" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: DiscoA340. License: CC BY-SA 4.0" title="License: CC BY-SA 4.0">Photo: DiscoA340</a></span></div><figcaption>Oceanfront towers along the beach in Myrtle Beach.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Every rental in the City of Myrtle Beach, short-term or long-term, needs a <a href="https://www.cityofmyrtlebeach.com/careers/business/business_faq.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">city business license</a>.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A listing's mark is what the listing agent entered.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Can the home you like take nightly guests?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Before you offer, we tell you what its zoning, the city's rules and the building's own rules allow.</p><a class="btn btn-brass" href="/contact/">Have us read its rental rules</a></div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What taxes apply to each?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On a stay under 90 days, the guest pays the lodging taxes on top of the price. South Carolina's <a href="https://www.scstatehouse.gov/code/t12c036.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">state tax on the stay</a> is 7 percent. Inside Myrtle Beach, the <a href="https://dor.sc.gov/sites/dor/files/forms/ST575.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">state and local sales tax on a room</a> comes to 10 percent, and the city and county add their own taxes. <a href="https://www.airbnb.com/help/article/2328" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Airbnb collects the state taxes and Horry County's</a>.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our page on <a href="/invest/str-rules/" style="color:var(--navy);text-decoration:underline">short-term rental rules</a> lists the filing an owner may still make. A home rented out 14 days or fewer a year is not taxed as lodging; our page on the <a href="/invest/14-day-rule/" style="color:var(--navy);text-decoration:underline">14-day rule</a> explains it.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How does federal income tax treat each?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Federal income tax treats the two differently. Under <a href="https://www.ecfr.gov/current/title-26/section-1.469-1T" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">federal tax rules</a>, a lease is a rental activity, so for most owners its losses are passive. A home whose average guest stays seven days or less is not a rental activity, and the average Myrtle Beach stay is under five nights. Our page on <a href="/invest/str-tax-treatment/" style="color:var(--navy);text-decoration:underline">rental losses and W-2 income</a> explains when those losses can lower the tax on a salary.</p></div></section><section style="background:var(--ivory-2)" id="break-even"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Nights to break even">How many nights does a Myrtle Beach Airbnb need to match a lease?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About 82 booked nights a year, if you run it yourself. On each night booked at the average two-bedroom rate of $252, you keep about $190 after Airbnb's fee, utilities, supplies and repairs. That is about 17 stays of four or five nights.</p><style>.c3-cc{margin:1.4rem 0 1.8rem;max-width:960px}.c3-cc table{width:100%;border-collapse:collapse;font-size:var(--read,1.0625rem);line-height:1.45;color:var(--muted)}.c3-cc caption{caption-side:top;text-align:left;color:var(--navy);font-weight:600;font-size:1em;line-height:1.4;padding:0 0 .7rem}.c3-cc th,.c3-cc td{padding:.6rem .7rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule);overflow-wrap:break-word}.c3-cc thead th{color:var(--navy);font-weight:600;font-size:1em;border-bottom:2px solid var(--navy);vertical-align:bottom}.c3-cc tbody th{color:var(--navy);font-weight:600}.c3-cc .n{text-align:right;font-variant-numeric:tabular-nums}.c3-cc .i{display:inline-flex;vertical-align:-4px;margin-right:.45rem;color:var(--brass-ink)}.c3-cc tr.c3-self>*{background:#fff}@media (max-width:39.999em){.c3-cc table,.c3-cc tbody,.c3-cc tr,.c3-cc th,.c3-cc td{display:block;width:auto}.c3-cc caption{display:block}.c3-cc thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.c3-cc tbody tr{background:var(--ivory-2);border-top:3px solid var(--brass);margin:0 0 .8rem;padding:.5rem 0 .6rem}section[style*="background:var(--ivory-2)"] .c3-cc tbody tr{background:var(--ivory)}.c3-cc tr.c3-self{background:#fff!important;border:2px solid var(--brass)}.c3-cc tr.c3-self>*{background:transparent}.c3-cc th,.c3-cc td{border:0;padding:.2rem 1rem}.c3-cc tbody th{display:flex;align-items:center;font-size:1.1em;padding-bottom:.35rem}.c3-cc tbody th .i{flex:none;vertical-align:0}.c3-cc tbody th a{display:inline-block;padding:.5rem 0}.c3-cc .n{text-align:left}.c3-cc td[data-label]::before{content:attr(data-label) ": ";color:var(--navy);font-weight:500}}</style><div class="c3-cc"><table><caption>What you keep in a year from a Myrtle Beach two-bedroom at $252 a night, run by you</caption><thead><tr><th scope="col">Booked a year</th><th scope="col">You keep with the Airbnb</th><th scope="col">Against $15,300 from the lease</th></tr></thead><tbody><tr><th scope="row">60 nights</th><td data-label="You keep with the Airbnb">$11,100</td><td data-label="Against $15,300 from the lease">about $4,000 less</td></tr><tr><th scope="row">82 nights</th><td data-label="You keep with the Airbnb">$15,300</td><td data-label="Against $15,300 from the lease">about the same</td></tr><tr><th scope="row">100 nights</th><td data-label="You keep with the Airbnb">$18,800</td><td data-label="Against $15,300 from the lease">about $4,000 more</td></tr><tr><th scope="row">124 nights</th><td data-label="You keep with the Airbnb">$23,400</td><td data-label="Against $15,300 from the lease">about $8,000 more</td></tr><tr><th scope="row">150 nights</th><td data-label="You keep with the Airbnb">$28,300</td><td data-label="Against $15,300 from the lease">about $13,000 more</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Running it yourself means you, or people you hire for each job, take the bookings, answer guests, send the cleaner and arrange repairs.</p><div class="sl-calc" role="group" aria-labelledby="slCalcT"><p class="t" id="slCalcT">Your own break-even</p><label for="slNight">Nightly rate, $<input id="slNight" type="number" min="0" step="1" value="252" inputmode="decimal" oninput="slCalc()"></label><label for="slRent">Monthly rent on a lease, $<input id="slRent" type="number" min="0" step="1" value="1504" inputmode="decimal" oninput="slCalc()"></label><label for="slNights">Nights booked a year<input id="slNights" type="number" min="0" step="1" value="82" inputmode="decimal" oninput="slCalc()"></label><label for="slMgr">Manager's share of the nightly rate, %<input id="slMgr" type="number" min="0" step="1" value="0" inputmode="decimal" oninput="slCalc()"></label><div class="out" aria-live="polite"><div class="big"><span>Nights a year to match the lease</span><strong id="slBe">82</strong></div><div class="row"><span>Stays of average length</span><strong id="slBk">17</strong></div><div class="row"><span>You keep with the Airbnb</span><strong id="slA">$15,300</strong></div><div class="row"><span>You keep with the lease</span><strong id="slL">$15,300</strong></div><p class="say" id="slSay">At 82 nights you keep about the same either way.</p></div><p class="note">A year, before the loan, property tax and HOA fee, which are the same either way. On each booked night you keep the rate less Airbnb's fee, running costs and any manager's share. Guests pay the cleaning fee, and it pays the cleaner. You also pay for a short-term rental insurance policy and a permit. On the lease you keep 11 months of rent, less utilities.</p></div><script>function slCalc(){var g=function(i){var e=document.getElementById(i);var v=e?parseFloat(e.value):NaN;return isFinite(v)&&v>0?v:0};var m=function(x){return (x<0?"-$":"$")+(Math.round(Math.abs(x)/100)*100).toLocaleString("en-US")};var o=function(i,t){var e=document.getElementById(i);if(e)e.textContent=t};var r=g("slNight"),rent=g("slRent"),nt=Math.min(g("slNights"),365),mg=Math.min(g("slMgr"),100);var per=r*(0.76-mg/100);var lk=rent*11-1290;var ak=per*nt-390;o("slL",m(lk));o("slA",m(ak));if(!r){o("slBe","--");o("slBk","--");o("slSay","Enter a nightly rate.");return}var be=per>0?Math.ceil((lk+390)/per):Infinity;o("slBe",be>365?"more than 365":String(Math.max(be,0)));o("slBk",be>365?"--":String(Math.round(Math.max(be,0)/4.7)));var d=ak-lk;o("slSay",Math.abs(d)<250?"At "+nt+" nights you keep about the same either way.":d>0?"At "+nt+" nights you keep about "+m(d)+" more a year with the Airbnb.":"At "+nt+" nights you keep about "+m(-d)+" more a year with the lease.")}document.addEventListener("DOMContentLoaded",slCalc);</script><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How many nights do Myrtle Beach listings book?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A two-bedroom open all year and booked as often as the middle Myrtle Beach listing, a third of its open nights, gets about 124 nights. Many do not get there. About four listings in ten are open to guests nine months a year or less, and about one in five was booked 30 nights or fewer.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Some listings are booked far more. The owner of a listing that takes in more than three in four others, of any size, keeps about $27,700 a year, $12,000 more than with the lease.</p><div class="sl-story"><p>An example from a friend of ours. He ran a hotel in Boston, retired, and bought three condos in one oceanfront building. They gross about $120,000 a year, roughly half of it profit. He now helps manage fourteen units.</p><p>His real numbers, not a promise.</p></div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What does an Airbnb manager cost in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The average listing took about 19 bookings in the year. Each one ends in a check-out, a cleaning and a turnover.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A full-service manager, who handles marketing, guest messages, accounting, taxes, maintenance and repairs, takes about 40 to 60 percent in what we have seen on the Grand Strand. A basic plan of marketing, guest messages and basic accounting costs about 13 to 17 percent, and you still arrange the cleaning and repairs.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">With a full-service manager at 40 percent, the owner of the two-bedroom booked 124 nights keeps less than with a lease. To keep as much as with a lease, guests have to book it at least about 135 nights a year. The calculator above takes a manager's share.</p></div></section><section style="background:var(--ivory)" id="month-by-month"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Month by month">How much does a Myrtle Beach Airbnb make each month?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most of it in summer. June, July and August bring in 47 percent of the year's income. In July, the best month, the average listing takes in about $6,800, and its owner keeps about $4,200 of it. From November through February the owner keeps less than with a lease, and about the same in October.</p><figure class="sl-mo"><p class="cap" id="slMoCap">What the owner of the average Myrtle Beach Airbnb keeps each month, against a two-bedroom lease</p><div class="sl-key" aria-hidden="true"><span><i></i>More than the lease</span><span><i class="lo"></i>Less than the lease</span><span><svg width="4" height="18" viewBox="0 0 4 18" aria-hidden="true"><path d="M2 0v18" stroke="#1c2028" stroke-width="2" stroke-dasharray="3 3"/></svg>Lease: about $1,270 a month to the owner</span></div><div role="table" aria-labelledby="slMoCap"><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Month</span><span role="columnheader">Owner keeps</span></div></div><div role="rowgroup"><div role="row" class="lo"><span role="rowheader">Jan<span class="sr">uary</span></span><span role="cell"><span class="trk" aria-hidden="true"><span class="b" style="--f:0.197"></span><span class="ln" style="--l:0.302"></span></span><span class="sr">$830, less than the lease</span></span><span class="v" aria-hidden="true">$830</span></div><div role="row" class="lo"><span role="rowheader">Feb<span class="sr">ruary</span></span><span role="cell"><span class="trk" aria-hidden="true"><span class="b" style="--f:0.247"></span><span class="ln" style="--l:0.302"></span></span><span class="sr">$1,040, less than the lease</span></span><span class="v" aria-hidden="true">$1,040</span></div><div role="row"><span role="rowheader">Mar<span class="sr">ch</span></span><span role="cell"><span class="trk" aria-hidden="true"><span class="b" style="--f:0.373"></span><span class="ln" style="--l:0.302"></span></span><span class="sr">$1,570</span></span><span class="v" aria-hidden="true">$1,570</span></div><div role="row"><span role="rowheader">Apr<span class="sr">il</span></span><span role="cell"><span class="trk" aria-hidden="true"><span class="b" style="--f:0.411"></span><span class="ln" style="--l:0.302"></span></span><span class="sr">$1,730</span></span><span class="v" aria-hidden="true">$1,730</span></div><div role="row"><span role="rowheader">May<span class="sr"></span></span><span role="cell"><span class="trk" aria-hidden="true"><span class="b" style="--f:0.48"></span><span class="ln" style="--l:0.302"></span></span><span class="sr">$2,020</span></span><span class="v" aria-hidden="true">$2,020</span></div><div role="row"><span role="rowheader">Jun<span class="sr">e</span></span><span role="cell"><span class="trk" aria-hidden="true"><span class="b" style="--f:0.893"></span><span class="ln" style="--l:0.302"></span></span><span class="sr">$3,760</span></span><span class="v" aria-hidden="true">$3,760</span></div><div role="row"><span role="rowheader">Jul<span class="sr">y</span></span><span role="cell"><span class="trk" aria-hidden="true"><span class="b" style="--f:1"></span><span class="ln" style="--l:0.302"></span></span><span class="sr">$4,210</span></span><span class="v" aria-hidden="true">$4,210</span></div><div role="row"><span role="rowheader">Aug<span class="sr">ust</span></span><span role="cell"><span class="trk" aria-hidden="true"><span class="b" style="--f:0.646"></span><span class="ln" style="--l:0.302"></span></span><span class="sr">$2,720</span></span><span class="v" aria-hidden="true">$2,720</span></div><div role="row"><span role="rowheader">Sep<span class="sr">tember</span></span><span role="cell"><span class="trk" aria-hidden="true"><span class="b" style="--f:0.375"></span><span class="ln" style="--l:0.302"></span></span><span class="sr">$1,580</span></span><span class="v" aria-hidden="true">$1,580</span></div><div role="row"><span role="rowheader">Oct<span class="sr">ober</span></span><span role="cell"><span class="trk" aria-hidden="true"><span class="b" style="--f:0.316"></span><span class="ln" style="--l:0.302"></span></span><span class="sr">$1,330</span></span><span class="v" aria-hidden="true">$1,330</span></div><div role="row" class="lo"><span role="rowheader">Nov<span class="sr">ember</span></span><span role="cell"><span class="trk" aria-hidden="true"><span class="b" style="--f:0.238"></span><span class="ln" style="--l:0.302"></span></span><span class="sr">$1,000, less than the lease</span></span><span class="v" aria-hidden="true">$1,000</span></div><div role="row" class="lo"><span role="rowheader">Dec<span class="sr">ember</span></span><span role="cell"><span class="trk" aria-hidden="true"><span class="b" style="--f:0.233"></span><span class="ln" style="--l:0.302"></span></span><span class="sr">$980, less than the lease</span></span><span class="v" aria-hidden="true">$980</span></div></div></div><figcaption>Source: AirROI, the average Myrtle Beach listing of any size open in that month, after running costs. The lease line is the $1,504 rent less utilities and one empty month, spread over the year.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Some owners rent the winter as one stay of 90 days or more. A stay by the same person for 90 continuous days is not taxed as lodging. Our page on <a href="/invest/mid-term-rentals/" style="color:var(--navy);text-decoration:underline">mid-term rentals</a> covers renting by the month.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">What do the Airbnbs near one building take in?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Name a building you like. We send what the Airbnbs around it take in, at no cost.</p><a class="btn btn-brass" href="/contact/">Send me the Airbnb income near it</a></div></div></section><section style="background:var(--ivory-2)" id="pros-and-cons"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Pros and cons">What are the pros and cons of an Airbnb and a long-term rental in Myrtle Beach?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">With an Airbnb you get summer prices and weeks in the home yourself. With a lease you get the same rent every month, in more neighborhoods.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">An Airbnb</h3><style>.c3-pc{display:grid;gap:1rem;max-width:960px;margin:1.2rem 0 1.6rem}@media (min-width:760px){.c3-pc{grid-template-columns:1fr 1fr;align-items:start}}.c3-pc>div{padding:1.1rem 1.2rem .6rem}.c3-pc h3{font-family:var(--sans);font-size:1.15rem;font-weight:600;color:var(--navy);margin:0 0 .8rem;display:flex;align-items:center;gap:.55rem}.c3-pc,.c3-pc ul{font-size:1em}.c3-pc ul{list-style:none;margin:0;padding:0}.c3-pc li{display:flex;gap:.7rem;align-items:flex-start;color:var(--muted);font-size:var(--read,1.0625rem);line-height:1.7;margin:0 0 .9rem}.c3-pc li svg{flex:none;margin-top:.3rem}.c3-pc .c3-pc-do{display:block;color:var(--navy);font-weight:500;margin-top:.2rem}</style><div class="c3-pc"><div style="background:var(--ivory);border-top:3px solid var(--brass)"><h3>Pros</h3><ul><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="11" fill="var(--brass)"/><path d="M6.2 11.4l3.1 3.1 6.5-6.7" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>You can price each night for its week. On a lease the rent is the same all year.</span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="11" fill="var(--brass)"/><path d="M6.2 11.4l3.1 3.1 6.5-6.7" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>You can use the home yourself in any week it is not booked.</span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="11" fill="var(--brass)"/><path d="M6.2 11.4l3.1 3.1 6.5-6.7" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Guests pay the cleaning fee, and it pays the cleaner.</span></li></ul></div><div style="background:var(--ivory);border-top:3px solid var(--muted)"><h3>Cons</h3><ul><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="10" fill="none" stroke="var(--muted)" stroke-width="1.6"/><path d="M6.8 11h8.4" stroke="var(--muted)" stroke-width="2.2" stroke-linecap="round"/></svg><span>In four winter months you keep less than with a lease. <span class="c3-pc-do">Rent the winter as one stay of 90 days or more.</span></span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="10" fill="none" stroke="var(--muted)" stroke-width="1.6"/><path d="M6.8 11h8.4" stroke="var(--muted)" stroke-width="2.2" stroke-linecap="round"/></svg><span>You furnish it, with photos, before the first guest, and you buy a short-term rental insurance policy. <span class="c3-pc-do">We price the furniture and photos for the unit you pick.</span></span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="10" fill="none" stroke="var(--muted)" stroke-width="1.6"/><path d="M6.8 11h8.4" stroke="var(--muted)" stroke-width="2.2" stroke-linecap="round"/></svg><span>Investor lenders count only about 75 percent of an appraiser's estimate of a nightly rental's income, a loan officer at our preferred lender tells us. <span class="c3-pc-do">Only that 75 percent counts toward the income the loan is based on.</span></span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="10" fill="none" stroke="var(--muted)" stroke-width="1.6"/><path d="M6.8 11h8.4" stroke="var(--muted)" stroke-width="2.2" stroke-linecap="round"/></svg><span>Standard loans are not made in a condo building that requires owners to rent through a shared rental pool. Nor are they made where the building offers hotel services, such as a front desk. <span class="c3-pc-do">We check the building first. Our page on <a href="/invest/condotel-financing/" style="color:var(--navy);text-decoration:underline">loans for hotel-style condos</a> covers other loans.</span></span></li></ul></div></div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">A long-term rental</h3><style>.c3-pc{display:grid;gap:1rem;max-width:960px;margin:1.2rem 0 1.6rem}@media (min-width:760px){.c3-pc{grid-template-columns:1fr 1fr;align-items:start}}.c3-pc>div{padding:1.1rem 1.2rem .6rem}.c3-pc h3{font-family:var(--sans);font-size:1.15rem;font-weight:600;color:var(--navy);margin:0 0 .8rem;display:flex;align-items:center;gap:.55rem}.c3-pc,.c3-pc ul{font-size:1em}.c3-pc ul{list-style:none;margin:0;padding:0}.c3-pc li{display:flex;gap:.7rem;align-items:flex-start;color:var(--muted);font-size:var(--read,1.0625rem);line-height:1.7;margin:0 0 .9rem}.c3-pc li svg{flex:none;margin-top:.3rem}.c3-pc .c3-pc-do{display:block;color:var(--navy);font-weight:500;margin-top:.2rem}</style><div class="c3-pc"><div style="background:var(--ivory);border-top:3px solid var(--brass)"><h3>Pros</h3><ul><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="11" fill="var(--brass)"/><path d="M6.2 11.4l3.1 3.1 6.5-6.7" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>One tenant moves in once a year.</span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="11" fill="var(--brass)"/><path d="M6.2 11.4l3.1 3.1 6.5-6.7" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>The same rent every month, winter included.</span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="11" fill="var(--brass)"/><path d="M6.2 11.4l3.1 3.1 6.5-6.7" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Allowed in the city neighborhoods where nightly stays are not.</span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="11" fill="var(--brass)"/><path d="M6.2 11.4l3.1 3.1 6.5-6.7" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>You can rent it unfurnished, so there is no setup to buy.</span></li></ul></div><div style="background:var(--ivory);border-top:3px solid var(--muted)"><h3>Cons</h3><ul><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="10" fill="none" stroke="var(--muted)" stroke-width="1.6"/><path d="M6.8 11h8.4" stroke="var(--muted)" stroke-width="2.2" stroke-linecap="round"/></svg><span>The rent is the same in July as in January, so you get none of the summer prices.</span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="10" fill="none" stroke="var(--muted)" stroke-width="1.6"/><path d="M6.8 11h8.4" stroke="var(--muted)" stroke-width="2.2" stroke-linecap="round"/></svg><span>Each new tenant can mean an empty month.</span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="10" fill="none" stroke="var(--muted)" stroke-width="1.6"/><path d="M6.8 11h8.4" stroke="var(--muted)" stroke-width="2.2" stroke-linecap="round"/></svg><span>The tenant has the home for the year, so you cannot use it yourself.</span></li></ul></div></div></div></section><section style="background:var(--ivory)" id="what-we-do"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What we do">What does Chapter3 do before you choose?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Send us one address and we price it as a lease and as an Airbnb. Our <a href="/invest/long-term-rental/" style="color:var(--navy);text-decoration:underline">long-term rental analyzer</a> prices the lease, and our <a href="/invest/str-tools/" style="color:var(--navy);text-decoration:underline">short-term rental atlas</a> shows what Airbnbs around the building take in. We also read the building's rules and the zoning, and work out the property tax for that home.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For income across the whole market, our <a href="/invest/airbnb-income/" style="color:var(--navy);text-decoration:underline">Airbnb income report</a> has it town by town.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Both numbers for one home</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We run the lease and the Airbnb side and send you both numbers before you write an offer, at no cost.</p><a class="btn btn-brass" href="/contact/">Have us price one home both ways</a></div></div></section><section style="background:var(--ivory-2)" id="airbnb-vs-long-term-rental-questions"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Airbnb vs long-term rental questions</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is Airbnb or a long-term rental more profitable in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Airbnb, once guests book a two-bedroom about 82 nights a year and you run it yourself. Below that, you keep more with a lease at HUD's standard rent, and many listings book fewer nights.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can you Airbnb a house in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Inside city limits, only in the Residential Multifamily Visitor zone; the other residential zones allow only stays of 90 days or more. In Carolina Forest and the rest of unincorporated Horry County, the county's zoning has no short-term rental rule. A home's HOA rules may still not allow nightly stays.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How many nights does a Myrtle Beach Airbnb need to book?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About 82 a year on a two-bedroom at $252 a night, if you run it yourself. With a full-service manager at 40 percent, at least about 135.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do I pay lodging tax on a long-term lease?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. South Carolina charges its 7 percent state tax only on stays under 90 days, plus local taxes. Two exceptions to the tax: a home rented out 14 days or fewer in a year, and rooms in the owner's own home with fewer than six rented.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is a short-term or long-term rental easier to finance?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A lease. A loan officer at our preferred lender tells us investor lenders count only about 75 percent of the appraiser's estimate of a nightly rental's income.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does Chapter3 manage rentals?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. Chapter3 is a brokerage and does not manage rentals. A full-service manager here takes about 40 to 60 percent, in what we have seen.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.airroi.com/airbnb-data/united-states/south-carolina/myrtle-beach" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">AirROI, Myrtle Beach</a>, <a href="https://www.huduser.gov/portal/datasets/fmr/fmr2027/FY27_FMRs.xlsx" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">HUD Fair Market Rents</a>, <a href="https://www.census.gov/housing/hvs/data/rates/tab1_state05_2026_rvr.xlsx" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Census vacancy</a>, <a href="https://www.scstatehouse.gov/code/t12c036.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">S.C. Code 12-36-920</a>, <a href="https://www.horrycountysc.gov/media/kufln4qp/tax-levy-2026_2.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County 2026 tax levy</a>, <a href="https://www.cityofmyrtlebeach.com/news_detail_T6_R1468.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">City zoning</a>, <a href="https://www.horrycountysc.gov/media/i0pfcm2o/appendix-b-zoning-ordinance-upated-912026.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County zoning</a>, <a href="https://www.cityofmyrtlebeach.com/careers/business/business_faq.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">City business license</a>, <a href="https://dor.sc.gov/sites/dor/files/forms/ST575.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SCDOR ST-575 tax rates</a>, <a href="https://www.airbnb.com/help/article/2328" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Airbnb taxes</a>, <a href="https://www.ecfr.gov/current/title-26/section-1.469-1T" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">26 CFR 1.469-1T</a>, <a href="https://selling-guide.fanniemae.com/sel/b4-2.1-03/ineligible-projects" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Fannie Mae B4-2.1-03</a>. Airbnb: AirROI, 12 months to September 2026, with guests' cleaning fees in the income; run by the owner, at the low end of AirROI's costs; our arithmetic. Homes for sale: our count of active listings. Not legal or tax advice.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Tall oceanfront towers with rows of balconies behind the dune in Myrtle Beach, with more towers lined up along the beach into the distance under a blue sky. Photo: DiscoA340, <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a>, via <a href="https://commons.wikimedia.org/wiki/File:Hotels_along_the_Grand_Strand_Beachfront.jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>. Chapter3 Realty resized the photo and cut 1x1, 4x3 and 16x9 crops from its lower part.</div><div role="listitem">Our crops keep the photo's CC BY-SA 4.0 license.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-10-d/invest-str-vs-ltr/myrtle-beach-oceanfront-towers-from-the-beach-1200w.webp","url":"https://chapter3realty.com/images/2026-10-d/invest-str-vs-ltr/myrtle-beach-oceanfront-towers-from-the-beach-1200w.webp","width":1200,"height":900,"encodingFormat":"image/webp","name":"Tall oceanfront towers with rows of balconies behind the dune in Myrtle Beach, with more towers lined up along the beach into the distance under a blue sky","caption":"Oceanfront towers along the beach in Myrtle Beach.","description":"Tall oceanfront towers with rows of balconies behind the dune in Myrtle Beach, with more towers lined up along the beach into the distance under a blue sky","creator":{"@type":"Person","name":"DiscoA340"},"creditText":"DiscoA340, CC BY-SA 4.0, via Wikimedia Commons","copyrightNotice":"© DiscoA340, CC BY-SA 4.0","license":"https://creativecommons.org/licenses/by-sa/4.0/","acquireLicensePage":"https://commons.wikimedia.org/wiki/File:Hotels_along_the_Grand_Strand_Beachfront.jpg","isBasedOn":"https://commons.wikimedia.org/wiki/File:Hotels_along_the_Grand_Strand_Beachfront.jpg","contentLocation":{"@type":"Place","name":"oceanfront, seen from the beach, Myrtle Beach, South Carolina"},"representativeOfPage":true}]}</script></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Should your home be an Airbnb or a lease?</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">Tell us the home. An agent sends what you would keep as a lease and as an Airbnb, at no cost. Call 854.333.2135. We answer evenings.</p><a class="btn btn-brass btn-lg" href="/contact/">Ask us which pays more</a></div></section></main>
