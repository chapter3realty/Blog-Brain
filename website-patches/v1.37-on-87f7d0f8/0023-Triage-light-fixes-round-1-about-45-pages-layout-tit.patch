(--navy);font-family:var(--sans);font-size:1.05rem;margin-bottom:.1rem}.c3-pg-tbl{background:linear-gradient(180deg,rgba(255,255,255,.8),rgba(255,255,255,.56));border:1px solid rgba(255,255,255,.92);box-shadow:inset 0 1px 0 rgba(255,255,255,.85),0 18px 40px -28px rgba(28,32,40,.45);border-radius:20px;width:100%;border-collapse:separate;border-spacing:0;overflow:hidden;font-family:var(--sans);font-size:1rem;color:var(--navy)}.c3-pg-tbl caption{caption-side:top;text-align:left;font-weight:600;font-size:1rem;color:var(--navy);padding:0 .2rem .6rem;line-height:1.35}.c3-pg-tbl th,.c3-pg-tbl td{padding:.6rem .9rem;text-align:left;border-bottom:1px solid rgba(28,32,40,.08);line-height:1.35}.c3-pg-tbl thead th{font-size:.9rem;color:var(--muted);font-weight:600}.c3-pg-tbl tbody th{font-weight:600;width:52%}.c3-pg-tbl td{color:#8a5226;font-weight:600}.c3-pg-tbl tbody tr:last-child th,.c3-pg-tbl tbody tr:last-child td{border-bottom:0}.c3-pg-map{margin:0;padding:0;max-width:540px}.c3-pg-map svg{display:block;width:100%;height:auto}.c3-pg-key{display:flex;flex-wrap:wrap;gap:.4rem 1.2rem;margin:.6rem .2rem .1rem;font-family:var(--sans);font-size:1rem;color:var(--navy)}.c3-pg-key span{display:inline-flex;align-items:center;gap:.45rem}.c3-pg-key i{display:inline-block;width:1.2rem;height:.9rem;border-radius:3px}.c3-pg-photo img{display:block;width:100%;height:auto;border-radius:16px}main#main>section[style^="background:var(--navy)"]:last-of-type:not(:first-child)>.wrap{background:linear-gradient(160deg,rgba(42,48,64,.95),rgba(28,32,40,.97))!important;border:1px solid rgba(255,255,255,.14)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.14),0 26px 60px -30px rgba(28,32,40,.6)!important;display:block!important;text-align:center!important;border-radius:28px!important;padding:2.2rem 1.6rem!important;width:calc(100% - 32px)!important;max-width:720px!important;margin:0 auto!important;box-sizing:border-box}@media (max-width:699px){main#main>section[style^="background:var(--navy)"]:last-of-type:not(:first-child)>.wrap{padding:1.6rem 1.2rem 1.7rem!important;border-radius:24px!important}}@supports not ((-webkit-backdrop-filter:blur(1px)) or (backdrop-filter:blur(1px))){main#main>section[style^="background:var(--navy)"]:last-of-type:not(:first-child)>.wrap{background:#2a3040!important}}.hx-fb,.hx-fb-ai,.hx-fb-q{max-width:100%;min-width:0;box-sizing:border-box}.hx-fb-q textarea{min-width:0}.hx-fb-pills{flex-wrap:wrap;max-width:100%}@media (min-width:1000px) and (max-width:1100px){header .header-inner{gap:2rem}}@media (min-width:700px){main#main .detail-h1{text-wrap:balance}}main#main .detail-h1 em{display:block;font-size:clamp(1.3rem,2.5vw,2.25rem);line-height:1.25;margin-top:.55rem;text-wrap:balance}@media (max-width:959px){main#main .detail-h1 em{color:#8a5226!important}}main#main .c3-pg-part figure.c3ph-hero{background:none!important;border:0!important;box-shadow:none!important;border-radius:0!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important;padding:0!important}main#main .c3-pg-part figure.c3ph-hero figcaption{padding:0!important}@media (min-width:1100px){main#main .c3-pg-part{display:grid;grid-template-columns:minmax(0,1fr) 400px;grid-template-rows:auto auto 1fr;column-gap:2.5rem;align-items:start}main#main .c3-pg-part>*{grid-column:1}main#main .c3-pg-part>figure.c3ph-hero{grid-column:2;grid-row:1/-1;margin:.3rem 0 0!important;max-width:none!important}}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You qualify for SC Housing's Homebuyer Program if you pass the seven tests below.</p><ul class="c3-pg-rules" role="list" aria-label="SC Housing Homebuyer Program rules in Horry County"><li><span class="c3-pg-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 9.4c-.4-1-1.5-1.8-3-1.8-1.8 0-3 1-3 2.2 0 3 6 1.6 6 4.4 0 1.3-1.3 2.2-3 2.2-1.6 0-2.7-.7-3.1-1.8M12 5.8v1.8M12 16.4v1.8"/><circle cx="12" cy="12" r="9"/></svg></span><span class="k">Household income</span><span class="v">Up to $114,960 for 1 or 2 people, $134,120 for 3 or more</span><span class="d">The income of everyone on the loan or the deed counts together.</span></li><li><span class="c3-pg-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span><span class="k">Home price</span><span class="v">Up to $450,000</span><span class="d">The lot can be 5 acres at most.</span></li><li><span class="c3-pg-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span class="k">What you own now</span><span class="v">No other property when the loan closes</span><span class="d">Owning bare land is allowed.</span></li><li><span class="c3-pg-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h8l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v4h4M9 17l6-6"/><circle cx="9.5" cy="11.5" r="1"/><circle cx="14.5" cy="16.5" r="1"/></svg></span><span class="k">Credit and debts</span><span class="v">A credit score of 640 or more</span><span class="d">If the FHA, VA, USDA or conventional loan's own rules ask for a higher score, the higher score applies. All your monthly debt payments together can be at most 45 percent of your income.</span></li><li><span class="c3-pg-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span><span class="k">Citizenship</span><span class="v">A U.S. citizen or a permanent resident</span><span class="d">A permanent resident needs a green card. A visa of any kind does not qualify.</span></li><li><span class="c3-pg-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.5 20.5v-1a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v1M16 14.5h1a4 4 0 0 1 4 4v2"/><circle cx="8.5" cy="7" r="3.2"/><circle cx="17" cy="8.8" r="2.5"/></svg></span><span class="k">Who is on the loan</span><span class="v">Only buyers who will live in the home</span><span class="d">The Homebuyer Program allows no cosigner. A gift toward the purchase can come from a relative, a domestic partner or a fiancé.</span></li><li><span class="c3-pg-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 5h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM3 10h18M8 3v4M16 3v4M8 14h.01M12 14h.01M16 14h.01M8 17.5h.01M12 17.5h.01"/></svg></span><span class="k">The homebuyer course</span><span class="v">One buyer takes it before loan approval</span><span class="d">Online or in a classroom, within 12 months of closing, even if you have owned a home before. The lender arranges it.</span></li></ul><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do you earn too much?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Probably not. SC Housing's limit for one or two people is about 1.7 times the median, or middle, household income in Horry County.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="SC Housing's income limits beside what households here earn"><span class="cap" aria-hidden="true">SC Housing's income limits beside what households here earn</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Income, what it is</span><span role="columnheader">yearly income</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">SC Housing limit, 3 or more people</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">Homebuyer Program</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">$134,120</span></span></div><div role="row"><span role="rowheader"><span class="n">SC Housing limit, 1 or 2 people</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">Homebuyer Program</span></span><span role="cell"><span class="b" style="--f:0.857" aria-hidden="true"></span><span class="v">$114,960</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Middle household income, Horry County</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">all household sizes</span></span><span role="cell"><span class="b" style="--f:0.511" aria-hidden="true"></span><span class="v">about $68,500</span></span></div></div></div><figcaption>The median (middle) household income is the U.S. Census Bureau's latest one-year figure for Horry County, for households of every size.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About four in five renter households in the county earn under $100,000, below the limit for any household size.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How much of your own money do you still need?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">With a VA or USDA loan, the $10,000 can cover most or all of the cash you bring to closing. Those loans need no down payment, so all of it goes to closing costs and prepaid items. Prepaid items are the first property taxes, homeowners insurance and loan interest paid at closing.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">With an FHA or conventional loan, you also need a down payment, and the $10,000 goes toward both.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The $10,000 comes only with SC Housing's own first mortgage, which can be any of these four loans:</p><ul class="c3-pg-loans"><li><strong>FHA:</strong> insured by the Federal Housing Administration, part of HUD.</li><li><strong>VA:</strong> backed by the U.S. Department of Veterans Affairs, for veterans and service members.</li><li><strong>USDA:</strong> backed by the U.S. Department of Agriculture, for homes inside its area on our map below.</li><li><strong>Conventional:</strong> a loan no government agency backs.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our <a href="/buyers/closing-costs/" style="color:var(--navy);text-decoration:underline">closing cost guide</a> adds up the costs at closing for a home at your price. Before you make an offer, we get the lender's figure for that home, so you know your number first.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Know the cash you need for a home you like</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Pick a home, and we ask the lender how much cash you would bring to closing on it, before you make an offer.</p><a class="btn btn-brass" href="/contact/">Have us find my cash to close</a></div></div></section><section style="background:var(--ivory)" id="paying-it-back"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Paying it back">Do you have to pay back SC Housing's $10,000?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Only if you sell, refinance or stop living in the home before 15 years are up. It does not shrink a little each year: until year 15, you owe all of it.</p><figure class="c3-pg-time" role="img" aria-label="Timeline: from the day you move in until year 15 you owe the full $10,000. If you sell, refinance or move out in year 10, the full $10,000 is repaid. After year 15 SC Housing forgives all of it and you owe nothing."><span class="cap" aria-hidden="true">What you owe on SC Housing's $10,000, year by year</span><p class="owe" aria-hidden="true"><i></i>You owe the full $10,000 in every one of years 1 to 15</p><div class="bar" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span class="y10"></span><span></span><span></span><span></span><span></span><span></span><span class="free">$0</span></div><div class="ticks" aria-hidden="true"><span style="left:0">Move in</span><span style="left:calc(9.5 / 16.6 * 100%);transform:translateX(-50%)">Year 10</span><span class="end" style="right:0">After year 15</span></div><div class="two" aria-hidden="true"><p><strong>Sell, refinance or move out in year 10</strong>The full $10,000 is repaid from the sale or the new loan.</p><p><strong>Still living there after year 15</strong>SC Housing forgives all of it. You repay nothing.</p></div></figure><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is there a tax if you sell early?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Only if three things are all true: you sell within nine years, you sell at a gain, and your income has risen above the levels in the recapture notice from your lender. Then you may owe a federal recapture tax, an increase in your federal income tax for the year you sell. SC Housing pays it back if you ask in writing by June 30 of the next year; the refund is reported to the IRS as income.</p></div></section><section style="background:var(--ivory-2)" id="which-homes"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Which homes">Which homes count in Horry County, and where are they under $450,000?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Houses, townhomes, condos in an approved building, and modular homes count, up to $450,000. A modular home is built in sections in a factory and set on a foundation, not on a steel frame.</p><div class="c3-pg-part"><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Conway has more houses for sale at or under $450,000 than any other town, Myrtle Beach included.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="Share of houses for sale listed at or under $450,000, by town"><span class="cap" aria-hidden="true">Share of houses for sale listed at or under $450,000, by town</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Town, where</span><span role="columnheader">share</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Aynor</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">inland</span></span><span role="cell"><span class="b" style="--f:0.841" aria-hidden="true"></span><span class="v">84%</span></span></div><div role="row"><span role="rowheader"><span class="n">Conway</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">inland</span></span><span role="cell"><span class="b" style="--f:0.809" aria-hidden="true"></span><span class="v">81%</span></span></div><div role="row"><span role="rowheader"><span class="n">Loris</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">inland</span></span><span role="cell"><span class="b" style="--f:0.806" aria-hidden="true"></span><span class="v">81%</span></span></div><div role="row"><span role="rowheader"><span class="n">Longs</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">inland</span></span><span role="cell"><span class="b" style="--f:0.798" aria-hidden="true"></span><span class="v">80%</span></span></div><div role="row"><span role="rowheader"><span class="n">Little River</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">coast</span></span><span role="cell"><span class="b" style="--f:0.658" aria-hidden="true"></span><span class="v">66%</span></span></div><div role="row"><span role="rowheader"><span class="n">Myrtle Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">beach</span></span><span role="cell"><span class="b" style="--f:0.438" aria-hidden="true"></span><span class="v">44%</span></span></div><div role="row"><span role="rowheader"><span class="n">Surfside Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">beach</span></span><span role="cell"><span class="b" style="--f:0.286" aria-hidden="true"></span><span class="v">29%</span></span></div><div role="row"><span role="rowheader"><span class="n">Murrells Inlet</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">beach</span></span><span role="cell"><span class="b" style="--f:0.189" aria-hidden="true"></span><span class="v">19%</span></span></div><div role="row"><span role="rowheader"><span class="n">North Myrtle Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">beach</span></span><span role="cell"><span class="b" style="--f:0.178" aria-hidden="true"></span><span class="v">18%</span></span></div></div></div><figcaption>Houses for sale on the Coastal Carolinas MLS (CCMLS), counted by Chapter3 in aggregate, at list price. Towns are mailing addresses, so Conway includes country land outside the city and Myrtle Beach includes Carolina Forest and Socastee. Murrells Inlet includes some homes in Georgetown County.</figcaption></figure><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);letter-spacing:.01em;color:#fff;text-align:right;background:radial-gradient(farthest-side at 100% 100%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.c3ph-cr a{color:#fff;text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);text-underline-offset:2px;pointer-events:auto;padding:10px 0 6px}.c3ph-hero{margin:1.6rem 0 2rem}.c3ph-hero .c3ph-f{border-radius:8px}.c3ph-hero img{aspect-ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}</style><figure class="c3ph-hero" style="margin:1.6rem 0 1.8rem;max-width:760px;"><div class="c3ph-f"><img src="/images/2026-10-d/buyers-programs/conway-historic-home-1200w.webp" srcset="/images/2026-10-d/buyers-programs/conway-historic-home-600w.webp 600w, /images/2026-10-d/buyers-programs/conway-historic-home-1200w.webp 1200w" sizes="(max-width: 800px) 100vw, 760px" width="1200" height="800" alt="A white two-story house with green shutters under live oaks in Conway's historic district" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: Pollinator. License: CC BY-SA 3.0" title="License: CC BY-SA 3.0">Photo: Pollinator</a></span></div><figcaption>A house under live oaks in Conway's historic district.</figcaption></figure></div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Condos: under the price limit, but the building must be approved</h3><ul class="c3-pg-tiles" role="list"><li><b>89%</b><span>of condos for sale in the same towns are listed at or under $450,000.</span></li><li><b>9</b><span>condo projects in all of Horry County are approved for FHA loans. HUD, the U.S. Department of Housing and Urban Development, keeps the list.</span></li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Several of those nine are approved only for some phases or buildings. An FHA loan on a condo in any other building needs a separate approval for that one unit.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In Chapter3's experience, a building with a rental program usually fails the rules for a conventional loan, because so many owners are investors. Our <a href="/invest/non-warrantable-condos/" style="color:var(--navy);text-decoration:underline">guide to condos most lenders will not lend on</a> explains why. We check the building's approval before you make an offer on a condo.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Manufactured homes</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A manufactured home, once called a mobile home, is built on a permanent steel frame to HUD's code. The Homebuyer Program does not take it. Palmetto Home Advantage takes doublewide or larger manufactured homes on a permanent foundation, usually with a credit score of at least 660. A doublewide is built in two sections; a single-wide does not qualify.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Houses and condos under $450,000</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Name the towns you like. An agent sends the houses and condos for sale there under SC Housing's price limit.</p><a class="btn btn-brass" href="/contact/">Send me homes under $450,000</a></div></div></section><section style="background:var(--ivory)" id="no-money-down"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="No money down">Can you buy with no money down in Horry County?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, with a USDA or VA loan. SC Housing offers both with no down payment. A USDA loan needs a home inside USDA's area, and that area leaves out the coast.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The part left out is the coastal strip from Little River through Myrtle Beach to Murrells Inlet, and inland past Carolina Forest and Socastee. It is less than a fifth of the county's land.</p><figure style="margin:1.6rem 0 1.8rem;max-width:560px"><div class="c3-pg-map"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 410 392" role="img" aria-label="Map of Horry County. The coastal strip from Little River through North Myrtle Beach, Myrtle Beach and Surfside Beach to Murrells Inlet, and inland past Carolina Forest and Socastee, is shaded: it is outside USDA's area. Conway, Aynor, Loris and Longs are inside it."><defs><clipPath id="c3-pg-frame"><rect width="410" height="392"/></clipPath></defs><g clip-path="url(#c3-pg-frame)"><rect width="410" height="392" fill="#e9e3d8"/><path d="M213.8,305.4L264.7,265.4L286.4,255.4L314.1,246.0L330.4,243.4L339.7,238.4L116.6,9.7L113.9,10.7L113.8,12.8L110.9,11.6L109.4,14.4L110.6,16.6L108.7,16.1L107.5,20.1L103.3,20.7L97.1,30.5L95.0,29.5L94.9,33.7L91.6,36.7L95.0,39.5L94.3,42.0L92.5,40.8L91.4,42.7L91.5,45.7L93.3,46.0L91.6,46.9L92.1,49.1L88.8,49.9L87.9,53.6L84.3,53.0L79.5,58.7L76.8,65.9L75.6,63.5L69.6,67.5L67.4,75.8L65.2,78.4L63.4,77.6L64.3,87.0L62.6,90.4L60.7,89.0L58.8,90.9L58.2,99.8L54.6,99.3L52.7,103.3L49.5,104.6L50.1,106.7L46.6,