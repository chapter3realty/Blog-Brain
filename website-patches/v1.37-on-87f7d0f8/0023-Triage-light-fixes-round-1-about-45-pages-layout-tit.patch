;border-bottom:1px solid var(--rule);color:var(--muted)">3.1%</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Carolina Forest</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$234,000</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$359,000</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><strong>5.0%</strong></td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">2.8%</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">North Myrtle Beach</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$247,000</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$400,000</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><strong>4.5%</strong></td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">2.3%</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Murrells Inlet and Garden City</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$264,000</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$401,000</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><strong>4.2%</strong></td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">2.4%</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Pawleys Island</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$320,000</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$550,000</td><td styl