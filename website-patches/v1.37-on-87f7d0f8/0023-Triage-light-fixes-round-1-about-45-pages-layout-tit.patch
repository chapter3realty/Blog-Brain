 var(--rule);color:var(--muted)"><strong>8.7%</strong></td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">18.8%</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Murrells Inlet</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">478</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">42%</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$47,603 a year</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">5.3%</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><strong>7.6%</strong></td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">18.5%</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Garden City</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">374</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">40%</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$41,223 a year</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">4.6%</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><strong>7.0%</strong></td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">20.2%</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Myrtle Beach</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">8,698</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">36%</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$2