e.textContent=dc?v.toFixed(dc):Math.round(v).toLocaleString("en-US");if(k<1)requestAnimationFrame(st)};requestAnimationFrame(st)};[].forEach.call(d.querySelectorAll("[data-ev-count]"),cnt);var tl=d.querySelector(".ev-time");if(tl){var tf=d.createElement("span");tf.className="ev-tf";tf.setAttribute("aria-hidden","true");tl.insertBefore(tf,tl.firstChild);var lis=tl.querySelectorAll("li");var tick=function(){var r=tl.getBoundingClientRect(),y=innerHeight*0.6-r.top,h=Math.max(0,Math.min(r.height-26,y));tf.style.height=h+"px";[].forEach.call(lis,function(li){li.classList.toggle("on",li.offsetTop+10<=h)})};addEventListener("scroll",tick,{passive:true});tick()}var jn=d.querySelector(".ev-jump");if(jn){var bar=d.createElement("div");bar.className="ev-stick";bar.innerHTML="<ul>"+[].map.call(jn.querySelectorAll("a"),function(a){return '<li><a href="'+a.getAttribute("href")+'">'+a.textContent+"</a></li>"}).join("")+"</ul>";root.appendChild(bar);var hd=d.querySelector("header"),bl=bar.querySelectorAll("a"),ids=[].map.call(bl,function(a){return a.getAttribute("href").slice(1)});var spy=function(){var top=hd?Math.max(0,hd.getBoundingClientRect().bottom):0;bar.style.top=top+"px";var an=jn.offsetParent?jn:d.querySelector(".ev-dash");bar.classList.toggle("on",!!an&&an.getBoundingClientRect().bottom<top);var cur=-1;ids.forEach(function(id,i){var el=d.getElementById(id);if(el&&el.getBoundingClientRect().top<top+140)cur=i});[].forEach.call(bl,function(a,i){var on=i===cur;if(on&&!a.classList.contains("cur")){var u=bar.firstChild;u.scrollLeft=a.offsetLeft-u.clientWidth/2+a.clientWidth/2}a.classList.toggle("cur",on)})};addEventListener("scroll",spy,{passive:true});addEventListener("resize",spy);spy()}var els=root.querySelectorAll(".ev-hb,.ev-rise");if(!("IntersectionObserver" in window)){[].forEach.call(els,function(e){e.classList.add("ev-on")});return}var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add("ev-on");io.unobserve(e.target)}})},{rootMargin:"0px 0px -8% 0px"});[].forEach.call(els,function(e){io.observe(e)});setTimeout(function(){[].forEach.call(els,function(e){var r=e.getBoundingClientRect();if(r.top<innerHeight)e.classList.add("ev-on")})},60)})();</script></div></section><section style="background:var(--ivory-2)" id="election-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Election FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Will Myrtle Beach home prices go down after the election?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Past elections do not say. In the year after each election from 2016 to 2024, Myrtle Beach-area prices rose 3 to 22 percent. In the latest year they were about flat, up 0.8 percent.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can Alan Wilson cut the property tax on rentals by himself?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. Changing the 6 percent rate needs 83 House votes and 31 Senate votes. Republicans won 79 House seats in the unofficial count, so it needs Democratic votes too.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is there a $50,000 first-time buyer tax credit now?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. Annie Andrews backs one, but it has had no vote in Congress. Plan a purchase this winter without it.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What happens to a closing if flood insurance lapses on Dec. 11?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A loan on a house in a high-risk flood zone can wait until Congress restores the program or the lender accepts a private policy that meets federal rules. Houses outside those zones are not held up.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://scvotes.gov/2026-general-election-results/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Election Commission results</a>, <a href="https://www.scstatehouse.gov/scconstitution/A10.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Constitution Art. X</a>, <a href="https://www.scstatehouse.gov/scconstitution/A16.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Art. XVI</a>, <a href="https://drannieandrews.com/wp-content/uploads/2026/08/Web-file.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Andrews plan</a>, <a href="https://www.foxcarolina.com/2026/10/15/republican-nominee-sc-governor-alan-wilson-announces-affordability-agenda/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Wilson agenda (Fox Carolina)</a>, <a href="https://www.wistv.com/2026/10/28/full-interview-alan-wilson-shares-priorities-governor-ahead-election-day/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Wilson interview (WIS)</a>, <a href="https://www.fhfa.gov/data/hpi" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FHFA house price index</a>, <a href="https://www.congress.gov/crs_external_products/IN/HTML/IN10835.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">CRS on flood insurance</a>, <a href="https://www.govinfo.gov/content/pkg/PLAW-119publ101/html/PLAW-119publ101.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Public Law 119-101</a>. Results are the unofficial count, not certified. Educational only, not legal or tax advice.</p><style>.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">The U.S. Capitol, where a buyer credit and the flood insurance deadline are decided. Photo: Architect of the Capitol, <a href="https://commons.wikimedia.org/wiki/Template:PD-USGov-Congress-AOC" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://commons.wikimedia.org/wiki/File:United_States_Capitol_-_west_front.jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>. Chapter3 Realty resized the photo and cut 1x1, 4x3 and 16x9 center crops.</div><div role="listitem">Horry County's government center in Conway. County Council decides impact fees on new homes and zoning outside the cities. Photo: Pollinator at English Wikipedia, <a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 3.0</a>, via <a href="https://commons.wikimedia.org/wiki/File:New_Horry_County_Courthouse_and_county_office_complex,_Conway,_South_Carolina_(18_November_2006).jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>. Chapter3 Realty cropped and resized the photo.</div><div role="listitem">Chapter3 Realty resized these photos and cropped some of them. Each photo keeps the license listed with it.</div></div></div></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Ask what the election changes for your house.</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">Send us a house you are buying or selling. An agent tells you what is set now and what is still a proposal.</p><a class="btn btn-brass btn-lg" href="/contact/">Ask about your house</a></div></section></main>
