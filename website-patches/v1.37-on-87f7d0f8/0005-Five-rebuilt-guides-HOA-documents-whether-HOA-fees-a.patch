diff --git a/data/2026-11-a/invest-property-management/fetch_bulk_addresses.py b/data/2026-11-a/invest-property-management/fetch_bulk_addresses.py
new file mode 100644
index 00000000..ab80a96c
--- /dev/null
+++ b/data/2026-11-a/invest-property-management/fetch_bulk_addresses.py
@@ -0,0 +1,21 @@
+"""Mailing addresses that receive the tax bills of 10 or more Horry County homes taxed at the 6 percent ratio
+(timeshare and resort companies, builders holding new homes, large landlords, managers). Same base filter as
+fetch_owner_distance.py. Groups by OwnerStreet + OwnerZip + OwnerState, kept only where the group has 10 or more.
+Run: python3 -I fetch_bulk_addresses.py <datadir>. Writes raw/bulk-addresses.json (street lines are business
+mailing addresses; owner names are not read)."""
+import json, sys, time, urllib.request, urllib.parse
+D = sys.argv[1]; Q = "https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer/24/query?"
+BASE = "LandUseCode LIKE '1%' AND MarketImprv > 0 AND AssessedProp >= TaxableProp*0.05"
+STAT = json.dumps([{"statisticType": "count", "onStatisticField": "OBJECTID", "outStatisticFieldName": "n"}])
+out = {"read": time.strftime("%Y-%m-%d"), "min": 10, "q": {}}
+for k, kw in {"condo": "LegalDescr LIKE '%HPR%'", "house_other": "LegalDescr NOT LIKE '%HPR%'"}.items():
+    w = f"{BASE} AND {kw}"
+    p = {"where": w, "outStatistics": STAT, "groupByFieldsForStatistics": "OwnerStreet,OwnerZip,OwnerState",
+         "having": "COUNT(OBJECTID) >= 10", "orderByFields": "n DESC", "f": "json"}
+    url = Q + urllib.parse.urlencode(p)
+    d = json.load(urllib.request.urlopen(url, timeout=300))
+    if "error" in d: raise SystemExit(json.dumps(d))
+    rows = [[f["attributes"]["OwnerStreet"], f["attributes"]["OwnerZip"], f["attributes"]["OwnerState"], f["attributes"]["n"]] for f in d["features"]]
+    out["q"][k] = {"where": w, "url": url, "groups": rows, "exceeded": d.get("exceededTransferLimit")}
+    print(k, len(rows), sum(r[3] for r in rows), d.get("exceededTransferLimit"))
+json.dump(out, open(D + "/raw/bulk-addresses.json", "w"), indent=1)
diff --git a/data/2026-11-a/invest-property-management/fetch_fee_pages.py b/data/2026-11-a/invest-property-management/fetch_fee_pages.py
new file mode 100644
index 00000000..bdf55359
--- /dev/null
+++ b/data/2026-11-a/invest-property-management/fetch_fee_pages.py
@@ -0,0 +1,21 @@
+"""Save the published fee pages of property managers that serve Horry County, as HTML and as plain text.
+Run: python3 -I fetch_fee_pages.py <datadir> . Writes raw/fees/<id>.html, raw/fees/<id>.txt and raw/fees/index.json."""
+import json, sys, time, re, html, urllib.request
+D = sys.argv[1]
+PAGES = json.load(open(D + "/fee-pages.json"))
+idx = []
+for p in PAGES:
+    req = urllib.request.Request(p["url"], headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124 Safari/537.36"})
+    try:
+        r = urllib.request.urlopen(req, timeout=60); b = r.read().decode("utf-8", "replace"); code = r.status
+    except Exception as e:
+        b = ""; code = str(e)[:80]
+    open(f"{D}/raw/fees/{p['id']}.html", "w").write(b)
+    t = re.sub(r"(?is)<(script|style|noscript|svg).*?</\1>", " ", b)
+    t = re.sub(r"(?i)<br\s*/?>|</(p|li|tr|h\d|div|td|th)>", "\n", t)
+    t = html.unescape(re.sub(r"<[^>]+>", " ", t))
+    t = "\n".join(re.sub(r"[ \t\xa0]+", " ", l).strip() for l in t.splitlines() if l.strip())
+    open(f"{D}/raw/fees/{p['id']}.txt", "w").write(t)
+    idx.append({"id": p["id"], "url": p["url"], "status": code, "chars": len(t), "read": time.strftime("%Y-%m-%d")})
+    print(p["id"], code, len(t))
+json.dump(idx, open(D + "/raw/fees/index.json", "w"), indent=1)
diff --git a/data/2026-11-a/invest-property-management/fetch_owner_distance.py b/data/2026-11-a/invest-property-management/fetch_owner_distance.py
new file mode 100644
index 00000000..d1cc8683
--- /dev/null
+++ b/data/2026-11-a/invest-property-management/fetch_owner_distance.py
@@ -0,0 +1,31 @@
+"""Where the owners of Horry County homes that are not taxed as the owner's legal residence get their tax bill.
+Horry County GIS parcel layer 24 (same base filter as data/2026-10-d/sell-out-of-state-buyers row 6 and
+data/2026-11-a/invest-condos/count_ratio.py): residential land use (LandUseCode LIKE '1%') with a building (MarketImprv > 0).
+Legal-residence (4 percent) homes: AssessedProp < TaxableProp*0.05. Every other home (6 percent): AssessedProp >= TaxableProp*0.05.
+Condo = legal description contains 'HPR' (horizontal property regime). Groups by OwnerState, and for SC by OwnerZip.
+Run: python3 -I fetch_owner_distance.py <datadir>. Writes raw/owner-distance.json with every URL. No owner names are read."""
+import json, sys, time, urllib.request, urllib.parse
+D = sys.argv[1]; Q = "https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer/24/query?"
+BASE = "LandUseCode LIKE '1%' AND MarketImprv > 0"
+RATIO = {"res4": "AssessedProp < TaxableProp*0.05", "other6": "AssessedProp >= TaxableProp*0.05"}
+KIND = {"condo": "LegalDescr LIKE '%HPR%'", "house_other": "LegalDescr NOT LIKE '%HPR%'"}
+STAT = json.dumps([{"statisticType": "count", "onStatisticField": "OBJECTID", "outStatisticFieldName": "n"}])
+def get(params):
+    url = Q + urllib.parse.urlencode(params)
+    for t in range(4):
+        try: return url, json.load(urllib.request.urlopen(url, timeout=180))
+        except Exception as e: time.sleep(5)
+    raise SystemExit("failed " + url)
+out = {"read": time.strftime("%Y-%m-%d"), "base": BASE, "ratio": RATIO, "kind": KIND, "q": {}}
+for r, rw in RATIO.items():
+    for k, kw in KIND.items():
+        w = f"{BASE} AND {rw} AND {kw}"
+        u0, c = get({"where": w, "returnCountOnly": "true", "f": "json"})
+        u1, s = get({"where": w, "outStatistics": STAT, "groupByFieldsForStatistics": "OwnerState", "f": "json"})
+        u2, z = get({"where": w + " AND OwnerState = 'SC'", "outStatistics": STAT, "groupByFieldsForStatistics": "OwnerZip", "f": "json"})
+        out["q"][f"{r}_{k}"] = {"where": w, "count": c["count"], "count_url": u0, "state_url": u1, "zip_url": u2,
+            "by_state": {(f["attributes"]["OwnerState"] or ""): f["attributes"]["n"] for f in s["features"]},
+            "sc_by_zip": {(f["attributes"]["OwnerZip"] or ""): f["attributes"]["n"] for f in z["features"]},
+            "exceeded": [s.get("exceededTransferLimit"), z.get("exceededTransferLimit")]}
+        print(r, k, c["count"], len(s["features"]), len(z["features"]))
+json.dump(out, open(D + "/raw/owner-distance.json", "w"), indent=1)
