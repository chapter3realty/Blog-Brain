@@ -0,0 +1,6 @@
+#!/bin/sh
+# Google search suggestions for /invest/property-management/. Run: sh pull-suggestions.sh > raw/google-suggestions.txt
+for q in "property management myrtle beach" "property management myrtle beach fees" "property management fees myrtle beach" "myrtle beach property management cost" "how much do property managers charge in myrtle beach" "how much do property managers charge in south carolina" "property management fees south carolina" "average property management fees sc" "property management horry county" "property management conway sc" "property management north myrtle beach" "property management surfside beach" "property management murrells inlet" "property management carolina forest" "vacation rental management myrtle beach" "vacation rental management fees myrtle beach" "airbnb management myrtle beach" "short term rental management myrtle beach" "condo rental management myrtle beach" "long term rental management myrtle beach" "is property management worth it" "is a property manager worth it" "property manager leasing fee" "property management leasing fee south carolina" "property management lease renewal fee" "south carolina property manager license" "property manager license sc" "do you need a license to be a property manager in sc" "how to fire a property manager" "how to break a property management contract" "property management contract south carolina" "property management agreement sc" "self manage rental property" "self managing rental property out of state" "property manager vs self manage" "what does a property manager do" "property management fees tax deductible" "property management trust account sc" "best property management myrtle beach" "property management companies grand strand" "grand strand property management" "myrtle beach property manager" "vacation rental management fees" "what percentage do vacation rental managers take" "property management percentage"; do
+  printf '== %s\n' "$q"
+  curl -sS -A "Mozilla/5.0" "https://suggestqueries.google.com/complete/search?client=firefox&hl=en&gl=us&q=$(python3 -c "import urllib.parse,sys;print(urllib.parse.quote(sys.argv[1]))" "$q")"; echo
+done
