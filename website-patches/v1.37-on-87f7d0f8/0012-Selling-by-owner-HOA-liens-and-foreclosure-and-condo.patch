type:x mandatory;scroll-padding:0 var(--c3ph-bleed,1.4rem);-webkit-overflow-scrolling:touch;scrollbar-width:none}.c3ph-row::-webkit-scrollbar{display:none}.c3ph-row>figure{flex:0 0 82%;scroll-snap-align:start}}.c3ph-swipe{display:flex;align-items:center;gap:.75rem;margin:.5rem 0 1.6rem;color:var(--navy);font:500 .95rem/1.3 var(--sans)}.c3ph-dots{display:inline-flex;gap:.45rem}.c3ph-dots i{display:block;width:10px;height:10px;border-radius:50%;border:1.5px solid var(--navy);box-sizing:border-box}.c3ph-dots i:first-child{background:var(--navy)}@supports (animation-timeline:view()){.c3ph-rowbox{timeline-scope:--c3ph-p1,--c3ph-p2,--c3ph-p3}.c3ph-row>figure:nth-child(1){view-timeline:--c3ph-p1 inline}.c3ph-row>figure:nth-child(2){view-timeline:--c3ph-p2 inline}.c3ph-row>figure:nth-child(3){view-timeline:--c3ph-p3 inline}.c3ph-dots i{animation:c3ph-dot linear both;animation-range:cover}.c3ph-dots i:nth-child(1){animation-timeline:--c3ph-p1}.c3ph-dots i:nth-child(2){animation-timeline:--c3ph-p2}.c3ph-dots i:nth-child(3){animation-timeline:--c3ph-p3}@keyframes c3ph-dot{0%,36%{background:transparent}42%,60%{background:var(--navy)}66%,100%{background:transparent}}}@media (min-width:700px){.c3ph-swipe{display:none}}.c3ph-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:1.4rem 0 1.8rem;padding:0;list-style:none}@media (min-width:700px){.c3ph-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}}@media (min-width:1000px){.c3ph-cards.c3ph-4{grid-template-columns:repeat(4,minmax(0,1fr))}}.c3ph-card{margin:0;background:var(--ivory);border:1px solid var(--rule);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}.c3ph-card .c3ph-f{border-radius:0}.c3ph-card img,.c3ph-card svg{display:block;width:100%;height:auto;aspect-ratio:var(--c3ph-r,4/3);object-fit:cover}.c3ph-card .c3ph-cr{font-size:.56rem;padding:1.2rem .45rem .25rem 1.6rem}.c3ph-card strong{display:block;color:var(--navy);font-size:.98rem;font-weight:500;line-height:1.3;padding:.7rem .8rem 0}.c3ph-card span.c3ph-t{display:block;color:var(--muted);font-size:.86rem;line-height:1.45;padding:.2rem .8rem .85rem}.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:760px}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, for a house or a condo, through the court. An association cannot sell your home on its own. It files a lawsuit, and a judge orders the sale. It can also sue you for the money alone, without asking to sell the home.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The power comes from one of two places:</p><ul class="lf-cards" aria-label="Where an association's power to foreclose comes from"><li><span class="k">Condo association</span><b>South Carolina's condo law</b>Unpaid dues are a lien on the unit by law, and the association can foreclose it in court.</li><li><span class="k">HOA that is not a condo</span><b>The community's recorded rules</b>These are the rules filed with the county. Courts enforce them like a contract. A lien under them is enforced through the court too.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In a <a href="#how-the-bill-grows" style="color:var(--navy);text-decoration:underline">2019 case</a>, the community's rules allowed foreclosure, and the South Carolina Supreme Court said the HOA had the legal right to foreclose. It still set that sale aside.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For an HOA that is not a condo, <a href="https://www.scstatehouse.gov/code/t27c030.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">the state's HOA law</a> says nothing about late fees, interest, liens or foreclosure. Those rules are in your community's own papers. Our guide to <a href="/hoa/south-carolina-hoa-laws/" style="color:var(--navy);text-decoration:underline">South Carolina HOA law</a> has what the state does say. Our guide to <a href="/hoa/violations-and-fines/" style="color:var(--navy);text-decoration:underline">HOA violations and fines</a> covers whether a fine can become part of the lien.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Your community's papers, marked for you</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the community's name. We get its recorded papers and mark the parts on late fees, liens and foreclosure, so you can take them to a lawyer.</p><a class="btn btn-brass" href="/contact/">Have us get the HOA papers</a></div></div></section><section style="background:var(--ivory)" id="how-often"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="How often here">How often do HOAs foreclose in Horry County?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Associations bring a real share of the county's foreclosures, mostly against condo units. We read every case on <a href="https://www.horrycountysc.gov/departments/master-in-equity/principal-sales/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County's sale list</a> for one month.</p><figure class="lf-fig"><p class="cap">Foreclosures on Horry County's list for one month's sale</p><ul class="lf-waffle" role="img" aria-label="19 squares, one for each foreclosure on the list. 4 are brought by an HOA or condo association, 15 by a mortgage."><li class="a"></li><li class="a"></li><li class="a"></li><li class="a"></li><li></li><li></li><li></li><li></li><li></li><li></li><li></li><li></li><li></li><li></li><li></li><li></li><li></li><li></li><li></li></ul><ul class="lf-key"><li><i class="a" aria-hidden="true"></i><span><b>4 brought by an HOA or condo association.</b> 3 condo units and one other home.</span></li><li><i aria-hidden="true"></i><span><b>15 brought on a mortgage.</b></span></li></ul><figcaption>Our count of the cases on the sale list of the county's Master in Equity, the court officer who holds its foreclosure sales. One square is one case.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The association debts were small next to the homes. The largest was about $36,000, and the court sells the whole home to pay the debt.</p><figure class="lf-fig"><p class="cap">The association's debt, against what the county values the home at</p><div class="lf-share" role="img" aria-label="A bar for the home's full county value, with about 5 to 10 percent of it shaded for the association's debt"><i class="hi"></i><i class="lo"></i><span>The whole home</span></div><p class="lf-sharekey"><span><b>About 5 to 10%:</b> the association's debt</span><span>100%: the home the court sells</span></p><figcaption>The four association cases on the list. The county's value is its figure for property tax.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">More of the complaints in the <a href="https://consumer.sc.gov/sites/consumer/files/Documents/HOA/2026_HOA_Complaint_Report.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">state's 2026 HOA report</a> came from Horry County than from any other county, almost a third of them.</p></div></section><section style="background:var(--ivory-2)" id="step-by-step"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Step by step">What happens if you stop paying HOA dues?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The bill grows, a lien goes on the home, and the association can sue to have it sold. The months below are from one South Carolina case, Winrose, in Richland County.</p><ol class="lf-steps" aria-label="What happens when HOA dues go unpaid, in order"><li><span class="n" aria-hidden="true">1</span><span class="c"><span class="t">The start</span><b>Dues go unpaid</b>Your community's rules say what is added. In the Winrose case, dues unpaid for 30 days began to earn interest, and a court judgment would add a reasonable attorney's fee and the court costs.</span></li><li><span class="n" aria-hidden="true">2</span><span class="c"><span class="t">Winrose: 3 months in</span><b>A lien goes on the home</b>In Winrose, the HOA filed the lien three months after the owners fell behind.</span></li><li><span class="n" aria-hidden="true">3</span><span class="c"><span class="t">Winrose: about 3 years in</span><b>The lawsuit</b>The association sues to foreclose. A notice of the lawsuit, called a lis pendens, may be filed with the county clerk, so it shows on the home's title.</span></li><li class="hot"><span class="n" aria-hidden="true">4</span><span class="c"><span class="t">Usually 30 days</span><b>Your answer is due</b>You usually have 30 days from the day you are served to answer the lawsuit in writing. The time is in <a href="https://www.sccourts.org/resources/judicial-community/court-rules/civil/rule-12/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">the court's rules</a>, and the summons states it.</span></li><li class="hot"><span class="n" aria-hidden="true">5</span><span class="c"><b>No answer: no notice of the rest</b>An owner who does not answer usually gets no <a href="https://www.sccourts.org/resources/judicial-community/court-rules/civil/rule-71/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">notice of the hearings</a> that follow. In the Winrose case, one owner put the lawsuit papers in a drawer and forgot them. The owners got no further notice of the judgment or the sale. In Horry County, a sale notice still runs in the newspaper three times over three weeks.</span></li><li><span class="n" aria-hidden="true">6</span><span class="c"><span class="t">Winrose: 5 months after the suit</span><b>The judgment</b>The judge enters a judgment for the bill and orders the home sold.</span></li><li class="hot"><span class="n" aria-hidden="true">7</span><span class="c"><span class="t">Winrose: 2 weeks later</span><b>The auction</b>In Horry County, the <a href="https://www.horrycountysc.gov/departments/master-in-equity/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Master in Equity</a> holds the sale at 11 a.m. on the first Monday of each month, or on the Tuesday when that Monday is a holiday. The sale is on the third floor of the Government and Justice Center in Conway.</span></li><li><span class="n" aria-hidden="true">8</span><span class="c"><b>The buyer's deed</b>The highest bidder gets a deed to the home. What happens to a mortgage on it is <a href="#your-mortgage" style="color:var(--navy);text-decoration:underline">below</a>.</span></li></ol><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/hoa-liens-and-foreclosure/horry-government-justice-center-1200w.webp" srcset="/images/2026-11-a/hoa-liens-and-foreclosure/horry-government-justice-center-600w.webp 600w, /images/2026-11-a/hoa-liens-and-foreclosure/horry-government-justice-center-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="675" alt="The Horry County Government and Justice Center in Conway: brick wings on each side of a white columned entrance, seen across the parking lot" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: Pollinator at English Wikipedia. License: CC BY-SA 3.0" title="License: CC BY-SA 3.0">Photo: Pollinator at English Wikipedia</a></span></div><figcaption>Horry County's Government and Justice Center in Conway, where the county's foreclosure cases are heard and its foreclosure sales are held.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In all 4 association cases on the county's list, <a href="https://www.scstatehouse.gov/code/t15c039.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">the bidding closes at the auction</a>. It does not stay open 30 days for higher bids. Plan to settle or sell before that day.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">What your home could sell for, before the auction</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us your address. We give you a value with the recent sales behind it, so you know what a sale would bring.</p><a class="btn btn-brass" href="/contact/">Have us value your home</a></div></div></section><section style="background:var(--ivory)" id="how-the-bill-grows"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="How the bill grows">How does a small HOA bill turn into thousands?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Mostly through lawyers' fees and court costs. In the <a href="https://cases.justia.com/south-carolina/supreme-court/2019-27934.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Winrose case</a>, the court's judgment was almost $2,900 on $250 of unpaid dues, about 12 times the dues.</p><figure class="lf-fig"><p class="cap" id="lf-bill-cap">The Winrose judgment: $250 of unpaid dues, and what the court added</p><table class="lf-bill" aria-labelledby="lf-bill-cap"><thead><tr><th scope="col">Part of the bill</th><th scope="col" class="num">Amount</th></tr></thead><tbody><tr><th scope="row">Unpaid dues in the judgment<span class="bar" aria-hidden="true"><i style="width:12.3%"></i></span></th><td class="num">$250</td></tr><tr><th scope="row">Interest<span class="bar" aria-hidden="true"><i style="width:4.0%"></i></span></th><td class="num">$80.87</td></tr><tr><th scope="row">Court costs<span class="bar" aria-hidden="true"><i style="width:26.8%"></i></span></th><td class="num">$542.80</td></tr><tr><th scope="row">Attorney's fees<span class="bar" aria-hidden="true"><i style="width:100.0%"></i></span></th><td class="num">$2,025</td></tr></tbody><tfoot><tr><th scope="row">The judgment</th><td class="num">$2,898.67</td></tr></tfoot></table><figcaption>One South Carolina case, Winrose, in Richland County. The cents are the court's.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Then the house was sold.</p><div class="lf-sold"><p class="k">The Winrose house, after the judgment</p><ol><li><strong>$128,000</strong><span>What the house was worth, with about $66,000 left on its mortgage.</span></li><li><strong>$3,036</strong><span>What a company paid for it at the auction, with the mortgage still on it.</span></li><li><strong>$35,000</strong><span>What the company then asked the owners to pay to keep their home.</span></li></ol></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Five years later, the South Carolina Supreme Court set the sale aside. The winning bid was about 5 cents for each dollar of the owners' equity in the house, and the court called the price grossly inadequate. It wrote:</p><blockquote class="lf-quote"><p>"A foreclosure proceeding is a last resort, not a business model to be swiftly invoked for the purpose of exploiting property owners."</p><cite>South Carolina Supreme Court, Winrose Homeowners' Association v. Hale</cite></blockquote></div></section><section style="background:var(--ivory-2)" id="your-mortgage"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Your mortgage">Does an HOA lien come before your mortgage?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No, not before a mortgage that was recorded first. South Carolina has no law that puts an association's lien ahead of a first mortgage, the rule called a super lien.</p><figure class="lf-fig"><p class="cap">Who is paid first, in a South Carolina condo</p><ol class="lf-ladder"><li>Property taxes</li><li>Recorded mortgages and other recorded liens</li><li class="us">The condo association's unpaid dues<small>Then ahead of any other lien on the unit</small></li></ol><figcaption>From South Carolina's condo law, for the lien and for the money from a sale.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For an HOA that is not a condo, no law ranks the HOA's lien. In a <a href="https://hallapproved.com/sc/cases/appeals/1994/8325603" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">1994 case</a>, a mortgage recorded before the dues fell due came first. That HOA's papers did not say the HOA came first.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The order works both ways:</p><ul class="lf-cards lf-one" aria-label="What the order means in each kind of foreclosure"><li><span class="k">The association forecloses</span><b>The mortgage stays</b>The buyer at the sale takes the home with the first mortgage still on it, when that mortgage ranks ahead. If you are bidding, read our guide to <a href="/invest/foreclosures/" style="color:var(--navy);text-decoration:underline">buying at the courthouse sale</a>.</li><li><span class="k">The bank forecloses a condo</span><b>Your neighbors pay the gap</b>When a bank forecloses on a condo, the new owner does not pay the dues the last owner left unpaid after the mortgage was recorded. Every owner in the building pays that share instead.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Buying a condo the usual way? You are liable with the seller for unpaid dues only up to the amount in <a href="/hoa/estoppel-and-transfer-fees/" style="color:var(--navy);text-decoration:underline">the statement the association must issue</a> on request. Our agents check for unpaid fees before closing. Our guide to <a href="/hoa/documents/" style="color:var(--navy);text-decoration:underline">HOA documents</a> covers what else to check.</p></div></section><section style="background:var(--ivory)" id="behind-now"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Behind now">Behind on HOA dues? What to do before the sale</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Start with the lawsuit papers.</p><ol class="lf-acts" aria-label="What to do if you are behind on HOA dues"><li class="hot"><b>Answer the lawsuit in time.</b>An answer is your written reply to the association's complaint. Serve it on the association's lawyer, who is named on the summons, and file it with the clerk of court.</li><li><b>Have the case dismissed when you pay.</b>In Winrose, the owners paid $250 and got a letter that the lien was satisfied. The HOA did not withdraw its suit. Ask the association's lawyer to dismiss the lawsuit and to cancel the lawsuit notice, as <a href="https://www.scstatehouse.gov/code/t15c011.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">state law</a> allows once the case is settled or dismissed.</li><li><b>A fight over the amount can go to small claims.</b>A money dispute with your HOA of $7,500 or less can go to magistrate court. A foreclosure goes to the circuit court.</li><li><b>A lawyer for $50.</b>The <a href="https://www.scbar.org/for-the-public/quicklinks/get-legal-help/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Bar's Lawyer Referral Service</a>, (803) 799-7100, connects you with a local lawyer. The first 30 minutes cost no more than $50.</li><li><b>Sell before the auction.</b>The lawsuit notice on your title does not stop a sale. It warns any buyer, and a buyer who closes while the case is open is bound by it. Plan for the sale to pay the association and end the case.</li></ol><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Selling to pay the association</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">A Chapter3 agent finds out before closing what the association says is owed, so it is paid from the sale. The agent also tells you what would be left for you after the association and the mortgage.</p><a class="btn btn-brass" href="/contact/">Ask us to plan a sale</a></div></div></section><section style="background:var(--ivory-2)" id="new-bills"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="New bills">Is South Carolina changing its HOA foreclosure law?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not yet. Three bills before the legislature would limit HOA foreclosure. None has become law.</p><ul class="lf-cards lf-one" aria-label="Bills before the South Carolina legislature on HOA foreclosure"><li><span class="k"><a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/366.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">S. 366</a></span><b>No HOA foreclosure clauses</b>Any clause in an HOA's papers that allows foreclosure could not be enforced. A primary home would be protected from a court sale brought only by an HOA. The HOA could still place a lien.<span class="w">In the Senate Judiciary Committee</span></li><li><span class="k"><a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/3447.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">H. 3447</a></span><b>A hearing first</b>An HOA would need a court hearing before it could advertise a foreclosure sale against an owner who did not answer.<span class="w">Passed the House 110 to 2; now in the Senate Judiciary Committee</span></li><li><span class="k"><a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/5204.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">H. 5204</a></span><b>A minimum debt</b>No foreclosure for less than $10,000 in dues, or $1,000 per home in the association if that is less.<span class="w">In a House committee</span></li></ul></div></section><section style="background:var(--ivory)" id="hoa-liens-and-foreclosure-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">HOA liens and foreclosure FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does an HOA have to agree to a payment plan?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. South Carolina's HOA and condo laws do not make an association offer one. If it agrees to a plan, get the plan in writing, including what happens to the lawsuit.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can you get your house back after an HOA foreclosure sale?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not by paying the association afterward. In a Murrells Inlet case, the owner offered the full fees as soon as he learned of the sale, and the association's lawyers turned it down because someone had already bid.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I stop paying HOA dues if the HOA is not doing its job?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. A condo owner cannot avoid the dues by not using the shared areas or by leaving the unit. In an HOA, paying the dues is a duty in the community's recorded rules. Holding them back starts the late charges, the lien and the lawsuit.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does bankruptcy wipe out HOA dues?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not the dues that fall due after you file. Those stay owed for as long as you still own the home.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.scstatehouse.gov/code/t27c031.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 27-31</a>, <a href="https://www.scstatehouse.gov/code/t27c030.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 27-30</a>, <a href="https://www.scstatehouse.gov/code/t15c039.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 15-39</a>, <a href="https://www.scstatehouse.gov/code/t15c011.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 15-11</a>, <a href="https://www.sccourts.org/resources/judicial-community/court-rules/civil/rule-12/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SCRCP Rule 12</a>, <a href="https://www.sccourts.org/resources/judicial-community/court-rules/civil/rule-71/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SCRCP Rule 71</a>, <a href="https://www.scstatehouse.gov/code/t22c003.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 22-3</a>, <a href="https://cases.justia.com/south-carolina/supreme-court/2019-27934.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Winrose v. Hale (2019)</a>, <a href="https://cases.justia.com/south-carolina/supreme-court/2015-27585.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Wachesaw v. Alexander (2015)</a>, <a href="https://hallapproved.com/sc/cases/appeals/1994/8325603" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Bailey (1994)</a>, <a href="https://www.horrycountysc.gov/departments/master-in-equity/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County Master in Equity</a>, <a href="https://consumer.sc.gov/sites/consumer/files/Documents/HOA/2026_HOA_Complaint_Report.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SCDCA 2026 HOA report</a>, <a href="https://selling-guide.fanniemae.com/sel/b4-2.2-02/full-review-process" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Fannie Mae B4-2.2-02</a>, <a href="https://www.law.cornell.edu/uscode/text/11/523" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">11 U.S.C. 523</a>, <a href="https://www.scbar.org/for-the-public/quicklinks/get-legal-help/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Bar referral</a>. Our count: every case on the county's sale list for one month, with each association case matched to the county's parcel records and values.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1rem"><strong style="color:var(--navy)">Legal notice.</strong> Chapter3 Realty Corp is a licensed South Carolina real estate brokerage. We are not attorneys, and nothing on this page is legal advice. For advice on your own case, talk to a South Carolina attorney.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Horry County's Government and Justice Center in Conway, where the county's foreclosure cases are heard and its foreclosure sales are held. Photo: Pollinator at English Wikipedia, <a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 3.0</a>, via <a href="https://commons.wikimedia.org/wiki/File:New_Horry_County_Courthouse_and_county_office_complex,_Conway,_South_Carolina_(18_November_2006).jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>. Chapter3 Realty cropped and resized the photo.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-11-a/hoa-liens-and-foreclosure/horry-government-justice-center-1200w.webp","url":"https://chapter3realty.com/images/2026-11-a/hoa-liens-and-foreclosure/horry-government-justice-center-1200w.webp","width":1200,"height":675,"encodingFormat":"image/webp","name":"Horry County's Government and Justice Center in Conway, where the county's foreclosure cases are heard and its foreclosure sales are held","caption":"Horry County's Government and Justice Center in Conway, where the county's foreclosure cases are heard and its foreclosure sales are held.","description":"The Horry County Government and Justice Center in Conway: brick wings on each side of a white columned entrance, seen across the parking lot","creator":{"@type":"Person","name":"Pollinator at English Wikipedia"},"creditText":"Pollinator at English Wikipedia, CC BY-SA 3.0, via Wikimedia Commons","copyrightNotice":"© Pollinator at English Wikipedia, CC BY-SA 3.0","license":"https://creativecommons.org/licenses/by-sa/3.0/","acquireLicensePage":"https://commons.wikimedia.org/wiki/File:New_Horry_County_Courthouse_and_county_office_complex,_Conway,_South_Carolina_(18_November_2006).jpg","isBasedOn":"https://commons.wikimedia.org/wiki/File:New_Horry_County_Courthouse_and_county_office_complex,_Conway,_South_Carolina_(18_November_2006).jpg","contentLocation":{"@type":"Place","name":"Horry County Government and Justice Center, 1301 Second Avenue, Conway, South Carolina"},"representativeOfPage":true}]}</script></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Behind on dues, or buying into an HOA?</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">If you are behind, an agent can time your sale so the association is paid before the court sells the home. If you are buying, we check the unit for unpaid dues before you close.</p><a class="btn btn-brass btn-lg" href="/contact/">Ask an agent about selling or buying</a></div></section></main>
+<main id="main"><div class="detail-hero bg-grid"><div class="wrap"><div class="breadcrumb"><a href="/">Home</a><span>/</span><a href="/hoa/">HOA Guide</a><span>/</span><span style="color:var(--muted)">Liens and Foreclosure</span></div><p class="eyebrow" style="margin-bottom:1rem">HOA Guide</p><h1 class="detail-h1">Can an HOA take your house in South Carolina over unpaid dues?<br/><em style="font-style:italic;color:var(--brass)">Yes, through the court, and the bill that starts it can be small.</em></h1><div class="detail-media" style="margin:0 0 1.2rem;max-width:760px"><style id="c3-glass">main#main{--g-ink:#8a5226;--g-ink-lg:#a8612c;--g-edge:rgba(255,255,255,.8);--g-hi:inset 0 1px 0 rgba(255,255,255,.95);--g-sh:0 1px 2px rgba(28,32,40,.05),0 14px 36px -20px rgba(28,32,40,.3);--g-r:20px;--g-blur:saturate(150%) blur(16px);background-color:#f8f4ee;background-image:radial-gradient(44rem 26rem at 4% 460px,rgba(232,201,154,.30),rgba(232,201,154,0) 70%),radial-gradient(40rem 26rem at 98% 1000px,rgba(196,120,58,.08),rgba(196,120,58,0) 70%),radial-gradient(46rem 26rem at 16% 1500px,rgba(232,201,154,.22),rgba(232,201,154,0) 70%),radial-gradient(40rem 24rem at 94% 1960px,rgba(42,48,64,.045),rgba(42,48,64,0) 70%);background-size:100% 2400px;background-repeat:repeat-y}main#main>section[style*="background:var(--ivory"],main#main .detail-hero{background:transparent!important}main#main .detail-hero{border-bottom:0}main#main .detail-hero.bg-grid{background-image:none}main#main>section[style*="background:var(--ivory"]+section[style*="background:var(--ivory"]{border-top:1px solid rgba(255,255,255,.7)}main#main>section[style*="background:var(--ivory"]{padding-bottom:2.25rem}main#main>section[style*="background:var(--ivory"]:not(.detail-hero+section){padding-top:2.25rem}@media (min-width:700px){main#main>section[style*="background:var(--ivory"]{padding-bottom:3.5rem}main#main>section[style*="background:var(--ivory"]:not(.detail-hero+section){padding-top:3.5rem}}main#main .eyebrow,main#