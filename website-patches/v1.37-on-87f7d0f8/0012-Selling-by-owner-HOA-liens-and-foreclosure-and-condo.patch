20.5V15h4v5.5"/></svg></span><span><strong>Middle HOA fee</strong><span class="t">$650 a month</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span><strong>Typical two-bedroom nightly rental, before costs</strong><span class="t">About $20,000 a year</span></span></li></ul></div><p style="color:var(--muted);font-size:.9rem;margin-bottom:1rem">By <strong style="color:var(--navy);font-weight:600">Devin Day</strong>, Operations Officer &middot; Reviewed by <strong style="color:var(--navy);font-weight:600">Tim Nash</strong>, Broker-in-Charge &middot; <span style="white-space:nowrap">Updated November 7, 2026</span></p><p class="detail-sub">What you can expect a condo to earn and cost here, from about 2,600 condo sales, 25 years of home values and a year of rental data.</p></div></div><section style="background:var(--ivory)"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">The short answer</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Only if it rents like the busier listings here. On a typical oceanfront two-bedroom condo, the HOA fee and the tax come to about $18,000 a year. The HOA fee is what owners pay the homeowners association to run the building.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A rental-data company estimates the average nightly rental in the Myrtle Beach market keeps about $16,000 after running costs, so it falls short. A rental that takes in as much as the top quarter here, more than 3 in 4 rentals, keeps about $28,000 if rented all year.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">As a bet on the price, a house has done better. Since 2001 the typical condo here has about doubled in value, and the typical house has grown about 2.5 times.</p></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><p style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Buying a condo to rent out? Talk it through with an agent who works with investors.</p><a class="btn btn-brass btn-lg" href="/contact/">Talk to a specialized agent</a></div></section><section style="background:var(--ivory);padding-top:2.5rem"><div class="wrap"><nav aria-label="On this page" style="margin-top:0;max-width:720px"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.3rem;font-weight:600">On this page</p><ul style="list-style:none;margin:0;padding:0"><li><a href="#condo-or-house" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Condo or house</a></li><li><a href="#prices-over-time" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Prices over time</a></li><li><a href="#prices-to-buy" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Prices to buy</a></li><li><a href="#yearly-cost" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Yearly cost</a></li><li><a href="#what-it-earns" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">What it earns</a></li><li><a href="#renting-it" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Renting it</a></li><li><a href="#loans" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Loans</a></li><li><a href="#bargains" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Bargains</a></li><li><a href="#the-building" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">The building</a></li><li><a href="#myrtle-beach-condo-investing-faq" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Myrtle Beach condo investing FAQ</a></li></ul></nav></div></section><section style="background:var(--ivory-2)" id="condo-or-house"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Condo or house">Is a condo or a house the better investment in Myrtle Beach?</h2><style>main#main .c3-cd-fig{max-width:640px}main#main figure.c3-cd-fig2{max-width:640px}main#main svg.c3-cd-chart{display:block;max-width:600px;height:auto}main#main svg.c3-cd-chart text.ct{font-family:var(--sans),system-ui,sans-serif;font-size:15px;fill:#4a5763}main#main svg.c3-cd-chart text.cl{font-family:var(--sans),system-ui,sans-serif;font-size:15px;font-weight:700;stroke:#fff;stroke-width:6px;stroke-linejoin:round;paint-order:stroke}@media (min-width:700px){main#main svg.c3-cd-chart text.ct,main#main svg.c3-cd-chart text.cl{font-size:11px}}.c3-cd-legend{display:flex;flex-wrap:wrap;gap:.35rem 1.1rem;margin:.5rem 0 .4rem;padding:0;list-style:none}.c3-cd-legend li{display:flex;align-items:center;gap:.5rem;color:var(--muted);font-size:1rem;line-height:1.35;margin:0}.c3-cd-line{display:inline-block;width:26px;height:4px;border-radius:2px}main#main .c3-cd-bill