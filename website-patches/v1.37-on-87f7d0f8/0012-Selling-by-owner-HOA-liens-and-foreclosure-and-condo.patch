ht:600;font-size:1em;border-bottom:2px solid var(--navy);vertical-align:bottom}.c3-cc tbody th{color:var(--navy);font-weight:600}.c3-cc .n{text-align:right;font-variant-numeric:tabular-nums}.c3-cc .i{display:inline-flex;vertical-align:-4px;margin-right:.45rem;color:var(--brass-ink)}.c3-cc tr.c3-self>*{background:#fff}@media (max-width:39.999em){.c3-cc table,.c3-cc tbody,.c3-cc tr,.c3-cc th,.c3-cc td{display:block;width:auto}.c3-cc caption{display:block}.c3-cc thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.c3-cc tbody tr{background:var(--ivory-2);border-top:3px solid var(--brass);margin:0 0 .8rem;padding:.5rem 0 .6rem}section[style*="background:var(--ivory-2)"] .c3-cc tbody tr{background:var(--ivory)}.c3-cc tr.c3-self{background:#fff!important;border:2px solid var(--brass)}.c3-cc tr.c3-self>*{background:transparent}.c3-cc th,.c3-cc td{border:0;padding:.2rem 1rem}.c3-cc tbody th{display:flex;align-items:center;font-size:1.1em;padding-bottom:.35rem}.c3-cc tbody th .i{flex:none;vertical-align:0}.c3-cc tbody th a{display:inline-block;padding:.5rem 0}.c3-cc .n{text-align:left}.c3-cc td[data-label]::before{content:attr(data-label) ": ";color:var(--navy);font-weight:500}}</style><div class="c3-cc"><table><caption>Condo or house: which suits each kind of investor</caption><thead><tr><th scope="col">If this is you</th><th scope="col">The better choice</th><th scope="col">Why</th></tr></thead><tbody><tr><th scope="row">You want the lowest price into a beach rental</th><td data-label="The better choice">A condo</td><td data-label="Why">Oceanfront: half ask under $200,000</td></tr><tr><th scope="row">You are counting on the price to rise</th><td data-label="The better choice">A house</td><td data-label="Why">Houses fell less and grew more</td></tr><tr><th scope="row">You want short-term rentals near the ocean</th><td data-label="The better choice">An oceanfront condo</td><td data-label="Why">Oceanfront: 94 in 100 say they allow it</td></tr><tr><th scope="row">You need an FHA or VA loan</th><td data-label="The better choice">Most likely a house</td><td data-label="Why">Horry County has 9 FHA-approved ones</td></tr><tr><th scope="row">You may need to sell within a few years</th><td data-label="The better choice">A house</td><td data-label="Why">Condos sit longer; houses sell sooner</td></tr><tr><th scope="row">You do not want to manage a roof, a pool or the building's insurance</th><td data-label="The better choice">A condo</td><td data-label="Why">The HOA takes care of the building</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The rest depends on the building: its fee, its rules and whether a lender will finance it. The <a href="#the-building" style="color:var(--navy);text-decoration:underline">building section</a> below lists what decides one.</p></div></section><section style="background:var(--ivory)" id="prices-over-time"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Prices over time">How have Myrtle Beach condo prices done compared with houses?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">From its 2006 high to early 2012, the typical metro condo lost about 43 percent of its value. The typical house lost about 30 percent.</p><figure class="c3-gchart c3-cd-fig"><span class="cap" style="display:block;color:var(--navy);font-weight:600;font-size:1.1em;line-height:1.35;margin:0 0 .5rem">Typical condo and house value, Myrtle Beach metro</span><ul class="c3-cd-legend"><li><span class="c3-cd-line" style="background:#2f6f8f"></span>Houses</li><li><span class="c3-cd-line" style="background:#c4783a"></span>Condos</li></ul><svg class="c3-cd-chart" viewBox="0 0 360 262" width="100%" role="img" aria-label="Line chart of the typical home value in the Myrtle Beach metro, monthly from late 2001 to September 2