5a5346" text-anchor="middle">47%</text><text x="537.3" y="284.0" font-family="DM Sans,sans-serif" font-size="10" fill="#8a8276" text-anchor="middle">Oct</text></g><g class="bar"><rect x="572.3" y="202.1" width="31.4" height="65.9" rx="3" fill="var(--brass)"><title>Nov: 27% occupancy</title></rect><text x="588.0" y="197.1" font-family="DM Sans,sans-serif" font-size="10" fill="#5a5346" text-anchor="middle">27%</text><text x="588.0" y="284.0" font-family="DM Sans,sans-serif" font-size="10" fill="#8a8276" text-anchor="middle">Nov</text></g><g class="bar"><rect x="622.9" y="216.8" width="31.4" height="51.2" rx="3" fill="var(--brass)"><title>Dec: 21% occupancy</title></rect><text x="638.6" y="211.8" font-family="DM Sans,sans-serif" font-size="10" fill="#5a5346" text-anchor="middle">21%</text><text x="638.6" y="284.0" font-family="DM Sans,sans-serif" font-size="10" fill="#8a8276" text-anchor="middle">Dec</text></g></svg><table style="width:100%;border-collapse:collapse;margin-top:.75rem;font-family:var(--sans);font-size:.8rem"><caption style="text-align:left;font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:#6d675d;margin-bottom:.4rem">Typical short-term rental occupancy by month (illustrative)</caption><thead><tr><th scope="col" style="text-align:left;padding:.3rem .5rem;border-bottom:1px solid var(--rule);color:var(--navy)">Month</th><th scope="col" style="text-align:right;padding:.3rem .5rem;border-bottom:1px solid var(--rule);color:var(--navy)">Occupancy</th></tr></thead><tbody><tr><td style="padding:.3rem .5rem;border-bottom:1px solid rgba(28,32,40,.05)">Jan</td><td style="padding:.3rem .5rem;text-align:right;border-bottom:1px solid rgba(28,32,40,.05)">18%</td></tr><tr><td style="padding:.3rem .5rem;border-bottom:1px solid rgba(28,32,40,.05)">Feb</td><td style="padding:.3rem .5rem;text-align:right;border-bottom:1px solid rgba(28,32,40,.05)">23%</td></tr><tr><td style="padding:.3rem .5rem;border-bottom:1px solid rgba(28,32,40,.05)">Mar</td><td style="padding:.3rem .5rem;text-align:right;border-bottom:1px solid rgba(28,32,40,.05)">37%</td></tr><tr><td style="padding:.3rem .5rem;border-bottom:1px solid rgba(28,32,40,.05)">Apr</td><td style="padding:.3rem .5rem;text-align:right;border-bottom:1px solid rgba(28,32,40,.05)">52%</td></tr><tr><td style="padding:.3rem .5rem;border-bottom:1px solid rgba(28,32,40,.05)">May</td><td style="padding:.3rem .5rem;text-align:right;border-bottom:1px solid rgba(28,32,40,.05)">67%</td></tr><tr><td style="padding:.3rem .5rem;border-bottom:1px solid rgba(28,32,40,.05)">Jun</td><td style="padding:.3rem .5rem;text-align:right;border-bottom:1px solid rgba(28,32,40,.05)">85%</td></tr><tr><td style="padding:.3rem .5rem;border-bottom:1px solid rgba(28,32,40,.05)">Jul</td><td style="padding:.3rem .5rem;text-align:right;border-bottom:1px solid rgba(28,32,40,.05)">91%</td></tr><tr><td style="padding:.3rem .5rem;border-bottom:1px solid rgba(28,32,40,.05)">Aug</td><td style="padding:.3rem .5rem;text-align:right;border-bottom:1px solid rgba(28,32,40,.05)">83%</td></tr><tr><td style="padding:.3rem .5rem;border-bottom:1px solid rgba(28,32,40,.05)">Sep</td><td style="padding:.3rem .5rem;text-align:right;border-bottom:1px solid rgba(28,32,40,.05)">59%</td></tr><tr><td style="padding:.3rem .5rem;border-bottom:1px solid rgba(28,32,40,.05)">Oct</td><td style="padding:.3rem .5rem;text-align:right;border-bottom:1px solid rgba(28,32,40,.05)">47%</td></tr><tr><td style="padding:.3rem .5rem;border-bottom:1px solid rgba(28,32,40,.05)">Nov</td><td style="padding:.3rem .5rem;text-align:right;border-bottom:1px solid rgba(28,32,40,.05)">27%</td></tr><tr><td style="padding:.3rem .5rem;border-bottom:1px solid rgba(28,32,40,.05)">Dec</td><td style="padding:.3rem .5rem;text-align:right;border-bottom:1px solid rgba(28,32,40,.05)">21%</td></tr></tbody></table><p style="font-family:var(--sans);font-size:.74rem;color:#6d675d;line-height:1.5;margin-top:.5rem">Illustrative seasonal pattern for Grand Strand short-term rentals. Surfside's family base supports steady summer occupancy for well-maintained cottages.</p></figure><div style="background:#fff;border:1px solid var(--rule);border-radius:8px;padding:1.5rem 1.6rem;margin:2rem 0"><p style="font-family:var(--sans);font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;color:var(--brass);font-weight:600;margin-bottom:1rem">Short-term rental data &middot; Surfside Beach</p><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(112px,1fr));gap:1.2rem 1rem;margin-bottom:1.15rem"><div><div style="font-family:var(--serif);font-size:1.55rem;color:var(--navy);line-height:1.1">$35,482</div><div style="font-size:.7rem;letter-spacing:.05em;color:var(--muted);margin-top:.15rem">average annual revenue</div></div><div><div style="font-family:var(--serif);font-size:1.55rem;color:var(--navy);line-height:1.1">34.2%</div><div style="font-size:.7rem;letter-spacing:.05em;color:var(--muted);margin-top:.15rem">occupancy</div></div><div><div style="font-family:var(--serif);font-size:1.55rem;color:var(--navy);line-height:1.1">$415</div><div style="font-size:.7rem;letter-spacing:.05em;color:var(--muted);margin-top:.15rem">average nightly rate</div></div><div><div style="font-family:var(--serif);font-size:1.55rem;color:var(--navy);line-height:1.1">538</div><div style="font-size:.7rem;letter-spacing:.05em;color:var(--muted);margin-top:.15rem">active listings</div></div></div><p style="color:var(--muted);font-size:.87rem;line-height:1.65;margin:0">The strongest tenth of listings here gross $11,379 a month or more; the median listing makes $3,221. June is the strongest month and December the weakest. Averages cover every listing in the market, including part-time ones, so a well-run property can sit well above them. <a href="/invest/airbnb-income/" style="color:var(--brass);font-weight:600;text-decoration:none">Compare all nine submarkets</a>. <span style="font-size:.78rem">AirROI, data through 2026-08-08.</span></p></div><h2>How rental returns work in Surfside Beach</h2><p>Because Surfside supports both strategies, the return math splits two ways. Near the beach, model it like a vacation rental: gross revenue less cleaning, management, and seasonal vacancy. Set back from the water, model it like a long-term hold: monthly rent less the 35 to 45 percent that taxes, insurance, maintenance, and management typically absorb. The more approachable entry pricing here means cash-on-cash returns can pencil even on conservative rent assumptions.</p><h2>Financing an investment property in Surfside Beach</h2><p>Conventional single-family homes here finance straightforwardly, while condos depend on the project's warrantability and HOA health. For the long-term-rental side, DSCR loans that qualify on rent are a clean fit. Confirm condo-project approval early if you are buying in a building, since a non-warrantable project narrows your lender options considerably.</p><h2>Surfside Beach rules and costs that move the numbers</h2><p>A few local costs shape the math. Non-owner-occupied property is assessed at South Carolina's 6 percent ratio rather than the 4 percent primary-residence ratio, and Chapter3 will verify the tax line for the address. If you run the property as a short-term rental, the town requires licensing and the usual state and local accommodations taxes apply. Near-beach cottages also need a genuine flood-insurance quote. None of these are deal-killers, but they separate a pro forma that holds up from one that looks good only until the first tax bill.</p><h2>The Surfside Beach investor thesis</h2><ol class="thesis-list"><li><span class="thesis-num">01</span><span class="thesis-text">Balanced demand lets you choose strategy by property: vacation rental near the beach, long-term hold further back.</span></li><li><span class="thesis-num">02</span><span class="thesis-text">More approachable entry pricing than prime oceanfront makes Surfside a sensible first investment market.</span></li><li><span class="thesis-num">03</span><span class="thesis-text">The family brand drives loyal repeat bookings, which favors well-kept, well-reviewed properties.</span></li><li><span class="thesis-num">04</span><span class="thesis-text">The snowbird monthly-rental hybrid smooths winter vacancy without committing to year-round leasing.</span></li></ol><h2>What a first Surfside Beach deal looks like</h2><p>A sensible first Surfside deal often means choosing strategy by location. Near the beach, a cottage or condo run as a vacation rental; set back from the water, a single-family home held for a local long-term tenant. Either way, Chapter3 will confirm the town's licensing rules, verify condo-project warrantability if you are buying in a building, and run conservative rent or occupancy numbers with you. The more approachable entry pricing means a first deal here can cash-flow without heroic assumptions, which is exactly what a first investment should do.</p><h2>What to watch before you buy in Surfside Beach</h2><ul style="padding-left:1.1rem;margin-top:.5rem"><li style="margin-bottom:.7rem;color:var(--muted);line-height:1.7"><strong>Older cottage condition.</strong> Many beach cottages are older raised structures. Budget for roof, HVAC, and elevation-related maintenance.</li><li style="margin-bottom:.7rem;color:var(--muted);line-height:1.7"><strong>Town rules.</strong> Surfside is incorporated and sets its own short-term-rental and licensing rules. Chapter3 will verify them for the exact address.</li><li style="margin-bottom:.7rem;color:var(--muted);line-height:1.7"><strong>Flood insurance.</strong> Near-beach properties need a real flood quote in your numbers, not a guess.</li></ul><h2>Where Surfside Beach sits, and how it is governed</h2><p>Surfside Beach is a small incorporated Horry County town just south of Myrtle Beach. It brands itself "The Family Beach" and runs on golf carts as much as cars. South Carolina allows registered carts on secondary roads in daylight within a few miles of home. Because it is its own town, it sets its own short-term-rental zoning, which is stricter than unincorporated areas nearby.</p><h2>The Surfside Beach market right now</h2><p>Surfside is a two-tier market, so read the numbers carefully. A blended median can look high because it mixes small inland condos with oceanfront homes. Redfin, for example, reported around $530,000 in early 2026. Detached single-family homes carry a much higher median (into the $800,000s), and the typical home-value index is closer to the $347,000 to $360,000 range. Price per square foot averages around $322 town-wide but climbs toward $540 in ocean-adjacent corridors, and days on market have run near 108. Always separate the oceanfront tier from the inland tier. <!-- TIMMY: current CCAR MLS median and DOM for Surfside oceanfront vs inland, by month. --></p><h2>Short-term rental rules in Surfside Beach</h2><p>Surfside Beach permits short-term rentals (under 30 days) only in specific zoning districts: the R3 high-density residential zone closer to the ocean and the C3 commercial zone. In the inland R1 low-density zones, transient rentals are restricted or prohibited. Operators need a town short-term-rental permit and must pass a safety inspection, and long-term rentals (a year or longer) are allowed in all residential zones. Verifying R3 versus R1 for a specific address before you write an offer is the single most expensive mistake buyers avoid here. Confirm current rules with the <a href="https://www.surfsidebeach.org" target="_blank" rel="noopener noreferrer">Town of Surfside Beach</a>. <!-- TIMMY: which streets fall in R3 vs R1, and any HOA rental limits. --> Every jurisdiction's licenses and taxes: <a href="/invest/str-rules/" style="color:var(--brass);font-weight:600;text-decoration:none">short-term rental rules by city</a>.</p><h2>Owning in Surfside Beach: the 4 percent versus 6 percent property tax rule</h2><p>South Carolina assesses an owner-occupied primary residence at a 4 percent ratio, and it does not pay the school operating tax. A second home or investment is assessed at 6 percent and pays the school operating tax. In Surfside Beach that makes a second home's tax bill about 3.1 times a primary home's on the same house. See the <a href="https://dor.sc.gov" target="_blank" rel="noopener noreferrer">South Carolina Department of Revenue</a> for the assessment-ratio rules. Full county math, with a calculator: <a href="/buyers/property-taxes/" style="color:var(--brass);font-weight:600;text-decoration:none">Horry County property taxes</a>.</p><h2>Flood zones and insurance in Surfside Beach</h2><p>Surfside enforces elevation requirements and participates in the FEMA Community Rating System, which can lower flood-insurance costs for compliant properties. Oceanfront and low-lying lots still carry meaningful flood and wind exposure. Review the FEMA flood map and, on ocean-adjacent lots, the elevation certificate before you buy, and on condos ask for the reserve study, since regime (HOA) fees have risen with coastal insurance costs. <!-- TIMMY: which sections flood, typical premiums, and condo regimes with thin reserves or recent special assessments. --> What the three coastal policies cost: <a href="/buyers/coastal-insurance/" style="color:var(--brass);font-weight:600;text-decoration:none">coastal home insurance costs</a>.</p><h2>Surfside Beach lifestyle and amenities</h2><p>Surfside is deliberately low-key: a walkable downtown, the Surfside Pier, golf-cart access throughout, and a quieter, residential feel than Myrtle Beach. South Strand Medical Center is close by, and the Murrells Inlet MarshWalk dining scene is a short drive south, so residents get restaurants and nightlife without hosting the crowds themselves.</p><h2>Schools serving Surfside Beach</h2><p>Public schools fall within <a href="https://www.horrycountyschools.net/about-hcs/our-schools" target="_blank" rel="noopener noreferrer">Horry County Schools</a>, with the area generally served by Lakewood Elementary, St. James Intermediate, and St. James High. Assignment is by address, and Chapter3 will confirm the exact schools on the district boundary map.</p><h2>What it is like to live in Surfside Beach</h2><p>Surfside Beach is deliberately low-key: a small incorporated town that runs on golf carts, with a walkable downtown, the Surfside Pier, and a quieter, more residential feel than Myrtle Beach. South Carolina allows registered golf carts on secondary roads in daylight within a few miles of home, and residents get the Murrells Inlet MarshWalk dining scene a short drive south without hosting the crowds themselves.</p><p>For a live-in buyer, the inland R1 zones are quieter and more year-round, while the R3 zone near the ocean is busier in season. Short-term rentals are restricted in R1 anyway. South Strand Medical Center is close, and the key checks are the flood zone and elevation for the exact lot and, on a condo, the regime fees and reserve study.</p><h2>Buying in Surfside Beach as a primary residence</h2><p>Surfside brands itself "The Family Beach," and many buyers want a primary residence or a quiet second home rather than a rental. If that is you, an inland R1 property fits, and the short-term-rental restriction there is a plus for a residential street. A primary residence is taxed at 4% with the owner-occupant credit; a second home at 6% without it.</p><h2>Read the Surfside Beach HOA rules before you commit to a house</h2><p>In a market with this many associations, the covenants matter as much as the house. Before you make an offer, read the HOA bylaws and rules, because they can restrict short-term and long-term rentals, pets, parking, golf carts, fences, and exterior changes. The classic trap: you have spent years training your dog to walk off leash, then buy into a community with a strict leash rule and lose the thing you valued most. Read the documents before you make an offer, not after.</p><p>Ask us and we will get you the governing documents for any Surfside Beach community, from our own files if we already have them or by requesting them for you if we do not. It is also why a Chapter3 agent asks a lot of questions about how you live. We would rather spend the time up front than match you to a home with a rule or an HOA that blocks what you enjoy or turns out to be a poor investment.</p><h2>Surfside Beach community stats</h2><p>Official figures from government sources, with no interpretation added. Each links to its source so you can read the full data yourself.</p><div style="background:#fff;border:1px solid var(--rule);border-radius:12px;padding:1.25rem 1.4rem;margin:1rem 0"><p style="font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--navy);font-weight:600;margin-bottom:.5rem">Population &amp; income &middot; <a href="https://www.census.gov/quickfacts/fact/table/surfsidebeachtownsouthcarolina" target="_blank" rel="noopener noreferrer">U.S. Census Bureau</a></p><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Population (2020 Census)</span><span style="color:var(--muted);text-align:right">4,160</span></div><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Median household income (ACS)</span><span style="color:var(--muted);text-align:right">about $74,202</span></div><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Persons in poverty (ACS)</span><span style="color:var(--muted);text-align:right">about 9.8%</span></div><p style="font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--navy);font-weight:600;margin:1.25rem 0 .5rem">Cost, taxes &amp; risk &middot; government sources</p><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Property assessment ratio</span><span style="color:var(--muted);text-align:right">4% primary / 6% second home &nbsp;<a href="https://dor.sc.gov" target="_blank" rel="noopener noreferrer">SC DOR</a></span></div><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Median home value</span><span style="color:var(--muted);text-align:right"><a href="https://www.census.gov/quickfacts/fact/table/surfsidebeachtownsouthcarolina" target="_blank" rel="noopener noreferrer">U.S. Census Bureau</a></span></div><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Flood hazard by address</span><span style="color:var(--muted);text-align:right"><a href="https://msc.fema.gov" target="_blank" rel="noopener noreferrer">FEMA Flood Map Service Center</a></span></div><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Crime statistics</span><span style="color:var(--muted);text-align:right"><a href="https://cde.ucr.cjis.gov" target="_blank" rel="noopener noreferrer">FBI Crime Data Explorer</a> &middot; <a href="https://www.sled.sc.gov" target="_blank" rel="noopener noreferrer">SLED</a></span></div><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">School performance</span><span style="color:var(--muted);text-align:right"><a href="https://screportcards.ed.sc.gov" target="_blank" rel="noopener noreferrer">SC Dept. of Education report cards</a></span></div></div><p style="color:var(--muted);font-size:.85rem;line-height:1.7">How to pull the crime numbers yourself: on the <a href="https://cde.ucr.cjis.gov" target="_blank" rel="noopener noreferrer">FBI Crime Data Explorer</a>, choose South Carolina, then select the local agency to see reported offenses by year. The local agency is the county sheriff's office or the city police department. On <a href="https://www.sled.sc.gov" target="_blank" rel="noopener noreferrer">SLED</a>, open the current "Crime in South Carolina" report and find the county and agency tables. Chapter3 will pull the current figures for a specific address with you.</p><h2>Surfside Beach school stats</h2><p>Surfside Beach is served by Horry County Schools, generally Lakewood Elementary, St. James Intermediate, and St. James High School. Figures are from the South Carolina Department of Education report card and federal education data, with no interpretation added.</p><div style="background:#fff;border:1px solid var(--rule);border-radius:12px;padding:1.25rem 1.4rem;margin:1rem 0"><p style="font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--navy);font-weight:600;margin-bottom:.5rem">St. James High School &middot; <a href="https://screportcards.ed.sc.gov" target="_blank" rel="noopener noreferrer">SC report card</a></p><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Grades served</span><span style="color:var(--muted);text-align:right">9-12</span></div><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Enrollment</span><span style="color:var(--muted);text-align:right">about 1,880</span></div><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Four-year graduation rate</span><span style="color:var(--muted);text-align:right">about 87% (state average about 84%)</span></div><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Math proficiency</span><span style="color:var(--muted);text-align:right">89% (state average 43%)</span></div><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Reading and writing proficiency</span><span style="color:var(--muted);text-align:right">88% (state average 52%)</span></div><div style="display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(28,32,40,.06)"><span style="color:var(--navy)">Student-to-teacher ratio</span><span style="color:var(--muted);text-align:right">18 to 1</span></div></div><p>For the elementary and middle schools that feed it, and for any exact address, read the full report cards at the <a href="https://screportcards.ed.sc.gov" target="_blank" rel="noopener noreferrer">South Carolina Department of Education</a>. The report card also publishes SAT and ACT averages, Advanced Placement and dual-enrollment participation, college-and-career readiness, dropout rate, and chronic absenteeism. Ask your Chapter3 agent and we will pull the report card for the school an address is zoned to.</p><h2>Who Surfside Beach suits</h2><p>Surfside fits STR investors who buy specifically in the R3 or C3 zones near the ocean, and primary or second-home buyers who want a quiet, walkable, golf-cart beach town and are buying inland where nightly rentals are restricted anyway. The two goals map to two different parts of town, so the zone you buy in matters more than the town you pick.</p></div>
