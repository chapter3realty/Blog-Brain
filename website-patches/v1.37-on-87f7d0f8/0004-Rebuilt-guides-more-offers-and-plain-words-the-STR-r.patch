rtant;padding:2.2rem 1.6rem!important}main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2)>.wrap>h2{color:var(--ivory)!important}main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2)>.wrap>p{color:rgba(244,239,232,.82)!important}@media (max-width:699px){main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2)>.wrap{padding:1.6rem 1.2rem 1.7rem!important;border-radius:24px!important}main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2)>.wrap>h2{font-size:1.5rem!important;line-height:1.25}}main#main .hx-feed .hx-fb,main#main .hx-feed .hx-fb-ai,main#main .hx-feed .hx-fb-q{min-width:0!important;max-width:100%!important;box-sizing:border-box}@media (min-width:1000px) and (max-width:1120px){.header-ctas .hdr-phone-num{display:none}}</style><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);letter-spacing:.01em;color:#fff;text-align:right;background:radial-gradient(farthest-side at 100% 100%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.c3ph-cr a{color:#fff;text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);text-underline-offset:2px;pointer-events:auto;padding:10px 0 6px}.c3ph-hero{margin:1.6rem 0 2rem}.c3ph-hero .c3ph-f{border-radius:8px}.c3ph-hero img{aspect-ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}.c3ph-gal{display:grid;grid-template-columns:minmax(0,1fr);gap:1.5rem;margin:1.6rem 0;padding:0;list-style:none}.c3ph-gal>figure{margin:0;min-width:0}.c3ph-gal img{aspect-ratio:var(--c3ph-r,4/3)}.c3ph-gal figcaption{color:var(--muted);font-size:.85rem;line-height:1.45;margin-top:.5rem}@media (min-width:700px){.c3ph-gal{display:grid;grid-template-columns:repeat(var(--c3ph-n,3),minmax(0,1fr));gap:1rem;overflow:visible;padding:0}.c3ph-gal>figure{min-width:0}}@media (max-width:699px){.c3ph-gal.c3ph-row{display:flex;gap:.75rem;padding:0 var(--c3ph-bleed,1.4rem) .4rem;margin:1.6rem calc(-1*var(--c3ph-bleed,1.4rem)) 0;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding:0 var(--c3ph-bleed,1.4rem);-webkit-overflow-scrolling:touch;scrollbar-width:none}.c3ph-row::-webkit-scrollbar{display:none}.c3ph-row>figure{flex:0 0 82%;scroll-snap-align:start}}.c3ph-swipe{display:flex;align-items:center;gap:.75rem;margin:.5rem 0 1.6rem;color:var(--navy);font:500 .95rem/1.3 var(--sans)}.c3ph-dots{display:inline-flex;gap:.45rem}.c3ph-dots i{display:block;width:10px;height:10px;border-radius:50%;border:1.5px solid var(--navy);box-sizing:border-box}.c3ph-dots i:first-child{background:var(--navy)}@supports (animation-timeline:view()){.c3ph-rowbox{timeline-scope:--c3ph-p1,--c3ph-p2,--c3ph-p3}.c3ph-row>figure:nth-child(1){view-timeline:--c3ph-p1 inline}.c3ph-row>figure:nth-child(2){view-timeline:--c3ph-p2 inline}.c3ph-row>figure:nth-child(3){view-timeline:--c3ph-p3 inline}.c3ph-dots i{animation:c3ph-dot linear both;animation-range:cover}.c3ph-dots i:nth-child(1){animation-timeline:--c3ph-p1}.c3ph-dots i:nth-child(2){animation-timeline:--c3ph-p2}.c3ph-dots i:nth-child(3){animation-timeline:--c3ph-p3}@keyframes c3ph-dot{0%,36%{background:transparent}42%,60%{background:var(--navy)}66%,100%{background:transparent}}}@media (min-width:700px){.c3ph-swipe{display:none}}.c3ph-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:1.4rem 0 1.8rem;padding:0;list-style:none}@media (min-width:700px){.c3ph-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}}@media (min-width:1000px){.c3ph-cards.c3ph-4{grid-template-columns:repeat(4,minmax(0,1fr))}}.c3ph-card{margin:0;background:var(--ivory);border:1px solid var(--rule);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}.c3ph-card .c3ph-f{border-radius:0}.c3ph-card img,.c3ph-card svg{display:block;width:100%;height:auto;aspect-ratio:var(--c3ph-r,4/3);object-fit:cover}.c3ph-card .c3ph-cr{font-size:.56rem;padding:1.2rem .45rem .25rem 1.6rem}.c3ph-card strong{display:block;color:var(--navy);font-size:.98rem;font-weight:500;line-height:1.3;padding:.7rem .8rem 0}.c3ph-card span.c3ph-t{display:block;color:var(--muted);font-size:.86rem;line-height:1.45;padding:.2rem .8rem .85rem}.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:760px}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Each one says what it costs and when we check for it, and links to its section. If this is your first home, read our <a href="/buyers/first-time-home-buyer-myrtle-beach/" style="color:var(--navy);text-decoration:underline">first-time buyer guide</a> too.</p><ol class="c3m-rank" role="list"><li><span class="n" aria-hidden="true">1</span><span><a href="#six-percent-tax">Paying the 6 percent tax on a home you live in</a><span class="c"><strong>About $2,930 a year</strong> more than the 4 percent rate</span><span class="w"><b>We check:</b> before you offer</span></span></li><li><span class="n" aria-hidden="true">2</span><span><a href="#seller-tax-bill">Budgeting from the seller's tax bill</a><span class="c"><strong>About $3,400 a year</strong> over the seller's bill, for a second home</span><span class="w"><b>We check:</b> before you offer</span></span></li><li><span class="n" aria-hidden="true">3</span><span><a href="#flood-outside-the-zone">No flood insurance outside the high-risk zone</a><span class="c"><strong>About 48 years</strong> of flood insurance, paid out in one flood</span><span class="w"><b>We check:</b> after the seller accepts your offer</span></span></li><li><span class="n" aria-hidden="true">4</span><span><a href="#flood-zone-listing">A flood zone the listing does not mention</a><span class="c"><strong>About $1,070 a year</strong> of flood insurance the loan requires</span><span class="w"><b>We check:</b> before you offer</span></span></li><li><span class="n" aria-hidden="true">5</span><span><a href="#wind-insurance">A homeowners policy that leaves out wind</a><span class="c"><strong>The wind damage</strong> the policy does not pay</span><span class="w"><b>We check:</b> before you offer</span></span></li><li><span class="n" aria-hidden="true">6</span><span><a href="#condo-repair-savings">A condo building short on repair savings</a><span class="c"><strong>About $4,750 a unit</strong> in one bill, in our example</span><span class="w"><b>We check:</b> before you offer</span></span></li><li><span class="n" aria-hidden="true">7</span><span><a href="#weekly-rentals">Weekly rentals in a Myrtle Beach residential zone</a><span class="c"><strong>The rental income</strong>, and fines of up to $500 each time</span><span class="w"><b>We check:</b> before you offer</span></span></li><li><span class="n" aria-hidden="true">8</span><span><a href="#inspection">Skipping the inspection to win the house</a><span class="c"><strong>Any repair</strong> the inspection would have found</span><span class="w"><b>We check:</b> after the seller accepts your offer</span></span></li><li><span class="n" aria-hidden="true">9</span><span><a href="#hoa-rules">HOA rules that do not fit how you live</a><span class="c"><strong>The boat, the golf cart or the rental</strong> you bought for</span><span class="w"><b>We check:</b> before you offer</span></span></li><li><span class="n" aria-hidden="true">10</span><span><a href="#your-agent">Thinking the agent you called works for you</a><span class="c"><strong>Advice</strong> on your side of the deal</span><span class="w"><b>We check:</b> before you tour a home</span></span></li></ol></div></section><section style="background:var(--ivory)" id="six-percent-tax"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Paying the 6 percent tax on a home you live in">Are you paying the 6 percent tax on a home you live in?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, until you apply. A home you live in is taxed on 4 percent of its value once you apply and qualify, and it does not pay the part of the tax that runs the schools. Until then, the county bills it at 6 percent, the rate for second homes and rentals.</p><figure class="c3-gchart"><div role="table" aria-label="Property tax a year on a house the county values at $350,000, outside the city limits"><span class="cap" aria-hidden="true">Property tax a year on a house the county values at $350,000, outside the city limits</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">How the house is taxed, rate</span><span role="columnheader">tax a year</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Your home, after you apply</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">4 percent rate</span></span><span role="cell"><span class="b" style="--f:0.229" aria-hidden="true"></span><span class="v">about $1,290</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">The same house at 6 percent</span></span><span role="cell"><span class="b" style="--f:0.75" aria-hidden="true"></span><span class="v">about $4,220</span></span></div></div></div><figcaption>Horry County's 2026 tax rates. The county's stormwater fee and small special districts are left out.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Newer owners are the most likely to still pay it.</p><div class="c3m-stat c3m-stat3"><div><span class="big">1 in 5</span><span class="t">bought in 2025</span></div><div><span class="big">1 in 7</span><span class="t">bought in 2024</span></div><div><span class="big">1 in 17</span><span class="t">bought in 2018 or 2019, not sold since</span></div></div><p class="c3m-tnote">The share, rounded, of houses owned by a person who gets the tax bill at that same house, still taxed at 6 percent. The newest buyers can still apply for this year.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Why do people moving here miss it?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The county does not apply it for you. It asks for South Carolina papers that a new arrival does not have yet:</p><ul style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem">a South Carolina driver's license or ID at the home's address, for each owner who lives there and a spouse;</li><li style="margin-bottom:.5rem">South Carolina registration for every vehicle you own, at that address;</li><li style="margin-bottom:.5rem">your state and federal tax returns, or the Social Security 1099;</li><li style="margin-bottom:.5rem">if you own another home, its tax bill showing no exemption, or a letter that the exemption was removed.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You also certify that no one in the home claims the 4 percent rate on another home. That means you, a spouse or a child under 18 you support. None of you can claim to be a legal resident of another state.</p><ul class="c3m-cards" role="list" aria-label="Applying for the 4 percent rate"><li><p class="h"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span><span>You apply once</span></p><p>Unless the ownership or who lives there changes.</p></li><li><p class="h"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 5h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM3 10h18M8 3v4M16 3v4M8 14h.01M12 14h.01M16 14h.01M8 17.5h.01M12 17.5h.01"/></svg></span><span>Move in partway through a year</span></p><p>You get the 4 percent rate for that whole year.</p></li><li><p class="h"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h8l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v4h4M9 17l6-6"/><circle cx="9.5" cy="11.5" r="1"/><circle cx="14.5" cy="16.5" r="1"/></svg></span><span>Aim for the end of May</span></p><p>Apply by then, and the bill the county mails later that year comes at 4 percent. If you miss May, you can still apply for that year until its bill is due, usually January 15 of the next year.</p></li></ul><div class="c3m-callout"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.2 4.2L19 7"/></svg></span><p>We can price the tax at both rates while you choose a house, and give you the county's list of papers at closing. Our <a href="/buyers/property-taxes/" style="color:var(--navy);text-decoration:underline">property tax calculator</a> works out the bill in any town.</p></div></div></section><section style="background:var(--ivory-2)" id="seller-tax-bill"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Budgeting from the seller's tax bill">Why is my tax bill so much higher than the seller's?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The seller's bill shows what the seller pays, not what you will pay. A home owned for many years is often taxed on a value far below the county's own value of it. A sale resets that value, and the new value is first taxed the year after the sale.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Example: the seller has lived in a house since about 2010. The county taxes it on much less than its full value. You buy the house as a second home. Your bill is on the full value, at the second-home rate. You pay about five times the seller's bill.</p><figure class="c3-gchart"><div role="table" aria-label="Example: tax a year on one house the county values at $350,000"><span class="cap" aria-hidden="true">Example: tax a year on one house the county values at $350,000</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Whose bill, why</span><span role="columnheader">tax a year</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">The seller's bill</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">their home for many years</span></span><span role="cell"><span class="b" style="--f:0.143" aria-hidden="true"></span><span class="v">about $800</span></span></div><div role="row"><span role="rowheader"><span class="n">Your bill, as your home</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">after you apply</span></span><span role="cell"><span class="b" style="--f:0.229" aria-hidden="true"></span><span class="v">about $1,290</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Your bill, as a second home</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">6 percent rate</span></span><span role="cell"><span class="b" style="--f:0.75" aria-hidden="true"></span><span class="v">about $4,220</span></span></div></div></div><figcaption>Outside the city limits, at the county's 2026 rates. The seller's figure taxes about 63 percent of the value, the average share for homes whose last deed was in 2005 to 2014.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We can work out your bill at your price and your tax rate, not from the seller's bill. Our <a href="/buyers/property-taxes/" style="color:var(--navy);text-decoration:underline">property tax guide</a> explains how a sale resets the value.</p></div></section><section style="background:var(--ivory)" id="flood-outside-the-zone"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="No flood insurance outside the high-risk zone">Do I need flood insurance if the house is not in a flood zone?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Federal law does not require flood insurance outside FEMA's high-risk zone. But since 2015, 3 in 10 paid flood claims in Horry County were on buildings outside that zone, and those repairs cost more.</p><div class="c3m-stat"><div><span class="big">$26,400</span><span class="t">FEMA's middle repair payment when an insured house outside the high-risk zone flooded</span></div><div><span class="big">$15,700</span><span class="t">the same payment for a house inside the zone</span></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">One middle payment outside the zone equals about 48 years of the middle flood policy there.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-10-d/buyers-undisclosed-flooding/conway-florence-floodwater-street-1200w.webp" srcset="/images/2026-10-d/buyers-undisclosed-flooding/conway-florence-floodwater-street-600w.webp 600w, /images/2026-10-d/buyers-undisclosed-flooding/conway-florence-floodwater-street-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="844" alt="Floodwater covering a residential street and the yards of single-story houses, with road signs standing in the water, in the Conway area after Hurricane Florence" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://commons.wikimedia.org/wiki/Template:PD-USGov-Military-National_Guard" target="_blank" rel="noopener noreferrer" aria-label="Photo: SC National Guard. License: Public domain" title="License: Public domain">Photo: SC National Guard</a></span></div><figcaption>Floodwater on a street of houses in the Conway area after Hurricane Florence.</figcaption></figure></div><div class="c3m-callout"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.2 4.2L19 7"/></svg></span><p>We can get a flood insurance quote on any house you are about to buy, in the zone or out of it. Our <a href="/buyers/undisclosed-flooding/" style="color:var(--navy);text-decoration:underline">flood history page</a> shows how to learn whether a house has flooded before.</p></div></div></section><section style="background:var(--ivory-2)" id="flood-zone-listing"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="A flood zone the listing does not mention">Will the listing tell me the house is in a flood zone?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Usually not. Of the 245 houses for sale in Horry County inside FEMA's high-risk flood zone, 196 do not say "flood zone" in their listing's feature list.</p><figure class="c3m-stack"><span class="cap">Houses for sale in FEMA's high-risk flood zone, and whether the listing's feature list says so</span><div class="row"><span class="lab">Houses: 245 for sale in the zone</span><div class="bar" aria-hidden="true"><span class="no" style="width:80.0%"></span><span class="yes" style="width:20.0%"></span></div><div class="key"><span><span class="sw" style="background:#c4783a" aria-hidden="true"></span><b>196</b> do not say flood zone</span><span><span class="sw" style="background:#5c6b78" aria-hidden="true"></span><b>49</b> do</span></div></div><figcaption>Houses for sale in Horry County on the day this page was built, each tested against the county's copy of FEMA's flood map. The agent's own remarks may still mention it.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the zone, a loan from a federally regulated lender requires flood insurance, and you must be told in writing.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Flood insurance costs more in the zone, and more again on a house the owner does not live in.</p><div style="overflow-x:auto;margin:1.2rem 0;max-width:760px"><table style="width:100%;border-collapse:collapse;font-size:.92rem"><thead><tr><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">House with a FEMA flood policy</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Middle cost a year</th></tr></thead><tbody><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Outside the zone, lived in</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><span style="white-space:nowrap">about $550</span></td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">In the zone, lived in</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><span style="white-space:nowrap">about $1,070</span></td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">In the zone, not lived in</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><span style="white-space:nowrap">about $1,370</span></td></tr></tbody></table></div><div class="c3m-callout"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.2 4.2L19 7"/></svg></span><p>We can test any address against FEMA's flood map before you offer, so the insurance is in your budget before the lender asks for it.</p></div><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Found a house you like?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We can find its flood zone on FEMA's map, get a flood insurance quote and price the tax at both rates, before you make an offer.</p><p style="display:flex;flex-wrap:wrap;gap:.6rem;margin:0"><a class="btn btn-brass" href="/contact/">Have us check a house</a><a class="btn btn-brass" href="tel:+18543332135">Call 854.333.2135</a></p></div></div></section><section style="background:var(--ivory)" id="wind-insurance"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="A homeowners policy that leaves out wind">Does a homeowners policy cover wind near the beach?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not always. In Horry County east of U.S. 17 or Bypass 17, whichever is farther west, and in named coastal areas of other counties, South Carolina lets an insurer leave wind and hail out of a homeowners policy. In Myrtle Beach, that line is the Bypass. Outside those areas, an insurer needs the state insurance director's approval to do it.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If wind is left out, you need a separate wind policy. The state's backup insurer for wind sells one to owners in this coastal area who cannot get it from another insurer. Our <a href="/buyers/coastal-insurance/" style="color:var(--navy);text-decoration:underline">coastal insurance guide</a> explains the three policies a house here can need.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Before you offer, we can tell you which side of the line a house is on, and get a homeowners quote that shows whether wind is in it.</p></div></section><section style="background:var(--ivory-2)" id="condo-repair-savings"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="A condo building short on repair savings">How do I know a condo building has saved enough for repairs?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Only from the building's own budget and records. South Carolina does not require a condo to keep repair savings, called reserves, or to study what its repairs will need.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">More than half of the condos for sale on the Grand Strand are in buildings 30 years old or older.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-10-d/hoa-reserves/myrtle-beach-oceanfront-towers-2011-1200w.webp" srcset="/images/2026-10-d/hoa-reserves/myrtle-beach-oceanfront-towers-2011-600w.webp 600w, /images/2026-10-d/hoa-reserves/myrtle-beach-oceanfront-towers-2011-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="675" alt="A row of oceanfront towers in Myrtle Beach with flat roofs, stacked balconies and pools behind the dunes, seen from a plane over the ocean" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: U.S. Geological Survey. License: Public domain" title="License: Public domain">Photo: U.S. Geological Survey</a></span></div><figcaption>Oceanfront towers in Myrtle Beach. Roofs, balconies and pools like these are what a condo's repair savings pay for.</figcaption></figure></div><div class="c3m-ex"><span class="k">Example</span><p>An 80-unit building has saved 26 percent of what it should hold by now for its repairs. <a href="https://www.reservestudy.com/wp-content/uploads/2026/05/2026-04-29-100000-Industry-Insights-Report-FINAL.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Association Reserves</a>, a firm that studies condo savings, calls anything under 30 percent weak, with a high chance of a special bill to the owners.</p><p>In our example, the bill five years out is about $4,750 a unit, split evenly. It leaves out inflation and interest.</p></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="https://guide.freddiemac.com/app/guide/bulletin/2026-C" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Freddie Mac</a> buys home loans from lenders. For loan applications from January 4, 2027, it needs a building's budget to put at least 15 percent of its dues into savings. A buyer whose loan follows Freddie Mac's rules needs a building that meets it.</p><div class="c3m-callout"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.2 4.2L19 7"/></svg></span><p>Before you offer, we can get the building's budget, its savings figure and its recent board minutes. Our pages on <a href="/hoa/reserves/" style="color:var(--navy);text-decoration:underline">condo reserves</a>, <a href="/hoa/special-assessments/" style="color:var(--navy);text-decoration:underline">special assessments</a> and <a href="/buyers/condo-in-litigation/" style="color:var(--navy);text-decoration:underline">condos in a lawsuit</a> explain each one.</p></div></div></section><section style="background:var(--ivory)" id="weekly-rentals"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Weekly rentals in a Myrtle Beach residential zone">Can I rent my Myrtle Beach house by the week?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Inside the City of Myrtle Beach, only where the zoning allows rentals under 90 days. Most of the city's residential neighborhoods are not zoned for them.</p><ul class="c3m-cards" role="list" aria-label="The City of Myrtle Beach rule on rentals under 90 days"><li><p class="h"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span><span>Zoning districts starting with R</span></p><p>No rentals under 90 days.</p></li><li><p class="h"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span>The RMV district</span></p><p>The one R district where rentals under 90 days are allowed.</p></li><li><p class="h"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 21h18M5 21V9.5l5-3V21M10 21V4h9v17M13 8h3M13 12h3M13 16h3M7.5 13h.01M7.5 16.5h.01"/></svg></span><span>24 houses</span></p><p>In the whole city, only 24 houses in the traditional residential zones keep an older right to rent for under 90 days.</p></li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A violation is a misdemeanor, with a fine of up to $500, 30 days in jail, or both, each time. Where the zoning allows a short-term rental, the city requires a business license for it.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/buyers-common-mistakes/houses-and-towers-from-the-ocean-1200w.webp" srcset="/images/2026-11-a/buyers-common-mistakes/houses-and-towers-from-the-ocean-600w.webp 600w, /images/2026-11-a/buyers-common-mistakes/houses-and-towers-from-the-ocean-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="782" alt="Older two-story houses on lawns along the beach at left, and two tall condo towers on the beach at right, with streets of houses under oak trees behind, seen from a plane over the ocean in Myrtle Beach" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: U.S. Geological Survey. License: Public domain" title="License: Public domain">Photo: U.S. Geological Survey</a></span></div><figcaption>Houses and condo towers side by side in Myrtle Beach. Each lot has its own zoning district, and the district decides whether it can be rented for under 90 days.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The <a href="https://www.cityofmyrtlebeach.com/departments/planning_and_zoning_department.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">city is rewriting its zoning code</a>. The rules also differ in each other town and in the county outside the cities; our <a href="/invest/str-rules/" style="color:var(--navy);text-decoration:underline">short-term rental rules page</a> has each one. Before you make an offer, we can look up the zoning of any address in the city.</p></div></section><section style="background:var(--ivory-2)" id="inspection"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Skipping the inspection to win the house">Should I skip the inspection to win the house?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. Under South Carolina law, inspecting the house is the buyer's job, and the agents have no duty to inspect it.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The seller's disclosure form is not an inspection. On most resales of a house with one to four units, the seller must give you the state's form before you sign, unless the contract says otherwise. It tells you only what the seller knows.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The law exempts some sales from the form, such as a new home no one has lived in, a foreclosure, an estate sale and an auction.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Septic tanks are rare at the beach and more common inland. About 1 in 16 houses for sale on the Grand Strand list one, and 79 list well water.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}@media (max-width:699px){main#main .c3-gchart.c3-gchart-list [role=row]{grid-template-columns:minmax(0,1fr) auto;column-gap:.8rem;align-items:start}main#main .c3-gchart.c3-gchart-list .b{display:none}main#main .c3-gchart.c3-gchart-list .dot{display:none}main#main .c3-gchart.c3-gchart-list .f{display:block}main#main .c3-gchart.c3-gchart-list [role=cell]{justify-content:flex-end}}</style><figure class="c3-gchart c3-gchart-compact c3-gchart-list"><div role="table" aria-label="Houses for sale that list a septic tank, by mailing town"><span class="cap" aria-hidden="true">Houses for sale that list a septic tank, by mailing town</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Town, houses with septic of houses for sale</span><span role="columnheader">share</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Aynor</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">13 of 44 houses</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">about 1 in 3</span></span></div><div role="row"><span role="rowheader"><span class="n">Loris</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">40 of 154 houses</span></span><span role="cell"><span class="b" style="--f:0.879" aria-hidden="true"></span><span class="v">about 1 in 4</span></span></div><div role="row"><span role="rowheader"><span class="n">Conway</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">61 of 673 houses</span></span><span role="cell"><span class="b" style="--f:0.307" aria-hidden="true"></span><span class="v">about 1 in 11</span></span></div><div role="row"><span role="rowheader"><span class="n">North Myrtle Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">4 of 255 houses</span></span><span role="cell"><span class="b" style="--f:0.053" aria-hidden="true"></span><span class="v">about 1 in 64</span></span></div><div role="row"><span role="rowheader"><span class="n">Myrtle Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">13 of 1,036 houses</span></span><span role="cell"><span class="b" style="--f:0.042" aria-hidden="true"></span><span class="v">about 1 in 80</span></span></div><div role="row"><span role="rowheader"><span class="n">Surfside Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">0 of 82 houses</span></span><span role="cell"><span class="b" style="--f:0" aria-hidden="true"></span><span class="v">none</span></span></div></div></div><figcaption>Houses for sale on the MLS on the day this page was built, counted by the town in their mailing address, which can include land outside the town limits. Some listings do not say, so the true counts may be higher.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We can line up the inspection once the seller accepts your offer, with a septic and a well check where the house has them.</p></div></section><section style="background:var(--ivory)" id="hoa-rules"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="HOA rules that do not fit how you live">Will the HOA let me keep my boat, golf cart or rental?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Only if its recorded rules allow it. About 7 in 10 houses for sale on our MLS, which covers the Grand Strand and inland Horry County, have an HOA fee, so most houses here come with a homeowners association (HOA) and its rules.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In South Carolina, those rules bind you only if they are on file with the county. The HOA's papers are recorded at the county's Register of Deeds. A rule the board adds or changes must be recorded by January 10 of the next year to stay in force.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The biggest mistake we see from buyers moving from New York is not checking that a community's rules fit how they live: its rules on boats, golf carts, rentals and pools. The same check matters for any buyer with a boat, a cart or a rental plan.</p><div class="c3m-callout"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.2 4.2L19 7"/></svg></span><p>Many communities here ban renting the house out at all. When we search for you, we leave those out, and we read the HOA papers for any rule that would block your rental plan. We can read them for the boat, the cart and the pool too. If you would rather have no HOA, see our page on <a href="/buyers/no-hoa-homes/" style="color:var(--navy);text-decoration:underline">homes with no HOA</a>.</p></div></div></section><section style="background:var(--ivory-2)" id="your-agent"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Thinking the agent you called works for you">Does the agent I called work for me?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not until you both sign. In South Carolina, no brokerage firm represents you until you and the firm agree to it in writing.</p><ul class="c3m-cards" role="list" aria-label="Who the firm works for, before and after you sign"><li><p class="h"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5.5 7h8A1.5 1.5 0 0 1 15 8.5v11a1.5 1.5 0 0 1-1.5 1.5h-8A1.5 1.5 0 0 1 4 19.5v-11A1.5 1.5 0 0 1 5.5 7zM8 7V4.5A1.5 1.5 0 0 1 9.5 3h9A1.5 1.5 0 0 1 20 4.5v11a1.5 1.5 0 0 1-1.5 1.5H15M9.5 17.5l-2.3-2.4a1.4 1.4 0 0 1 2.3-1.6 1.4 1.4 0 0 1 2.3 1.6z"/></svg></span><span>Before you both sign</span></p><p>You are the firm's customer. Under the law, the firm can help the sale along without representing you or the seller.</p></li><li><p class="h"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span>After you both sign an agreement</span></p><p>The firm is your agent, on the terms the agreement states, including its pay.</p></li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Paying an agent does not by itself make the agent yours.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Since 2024, <a href="https://www.nar.realtor/the-facts/what-the-nar-settlement-means-for-home-buyers-and-sellers" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">agents who use the MLS</a>, the shared list of homes for sale, must sign a written agreement with you before you tour a home. It must state the agent's pay as an amount or a rate, and bar the agent from taking more from any source. It must also say that fees are fully negotiable and not fixed by law.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">An agent on your side also tells you when a house is not a good buy. One buyer spent over a year sending his agent Zillow links. Each time, he was told it was a good buy in an up and coming neighborhood. He came to us after that.</p><div class="c3m-callout"><span class="i" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.2 4.2L19 7"/></svg></span><p>Before we show you a home, we put in writing what we will do for you and what we are paid.</p></div></div></section><section style="background:var(--ivory)" id="buyer-mistakes-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Buyer mistakes FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How do I apply for the 4 percent rate in Horry County?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Online, on the county's Online Services page, under Legal Residence Application. If the county asks for a missing paper, you can send it by mail, fax or email, or bring it to the Assessor's Office. The office's phone number is 843-915-5040.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How far back can I get a refund of the 6 percent tax on my home?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If you qualified for the 4 percent rate and paid at 6 percent, you can claim the extra tax back from the county assessor. Under state law, you have two years from the day you paid that bill, and a county council may allow refunds of the county's own share for more past years.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does a condo's HOA fee show whether it has saved enough for repairs?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. In our count of condos for sale here, the middle HOA fee is about $640 a month, and about $690 in buildings built in 1986 or earlier. Older buildings do not charge much more, so the fee alone does not show what a building has saved for its age.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I change jobs while buying a house in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Wait until after closing if you can. On a loan that follows Fannie Mae's rules, the lender checks again that you still have your job no more than 10 business days before closing, or 15 in some cases. A loan officer at our preferred lender can tell you what your loan will need.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.scstatehouse.gov/code/t12c043.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-43</a>, <a href="https://www.scstatehouse.gov/code/t12c037.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">12-37</a>, <a href="https://www.scstatehouse.gov/code/t12c054.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">12-54</a>, <a href="https://www.scstatehouse.gov/code/t27c030.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">27-30</a>, <a href="https://www.scstatehouse.gov/code/t27c050.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">27-50</a>, <a href="https://www.scstatehouse.gov/code/t38c075.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">38-75</a>, <a href="https://www.scstatehouse.gov/code/t40c057.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">40-57</a>, <a href="https://www.horrycountysc.gov/media/oy0hxkmu/spa-required-docs-4252023.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County checklist</a>, <a href="https://www.horrycountysc.gov/media/kufln4qp/tax-levy-2026_2.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">2026 county levy</a>, <a href="https://www.fema.gov/openfema-data-page/fima-nfip-redacted-claims-v2" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FEMA flood claims</a>, <a href="https://www.law.cornell.edu/uscode/text/42/4012a" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">42 U.S.C. 4012a</a>, <a href="https://www.cityofmyrtlebeach.com/departments/planning_and_zoning_department.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Myrtle Beach zoning</a>, <a href="https://www.nar.realtor/the-facts/what-the-nar-settlement-means-for-home-buyers-and-sellers" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NAR</a>, <a href="https://www.reservestudy.com/wp-content/uploads/2026/05/2026-04-29-100000-Industry-Insights-Report-FINAL.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Association Reserves</a>, <a href="https://selling-guide.fanniemae.com/sel/b3-3.1-04/verbal-verification-employment" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Fannie Mae</a>, <a href="https://guide.freddiemac.com/app/guide/bulletin/2026-C" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Freddie Mac</a>. Our counts: Horry County parcel records, FEMA's flood policy and claim files, and homes for sale on the MLS, counted in total. Not legal, tax or insurance advice.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Floodwater on a street of houses in the Conway area after Hurricane Florence. Photo: Senior Master Sgt. Edward Snyder, 169th Fighter Wing, South Carolina National Guard, <a href="https://commons.wikimedia.org/wiki/Template:PD-USGov-Military-National_Guard" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://commons.wikimedia.org/wiki/File:Hurricane_Florence_-_South_Carolina_National_Guard_Responds_(44200296354).jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>. Chapter3 Realty cropped the left edge to hide a mailbox number.</div><div role="listitem">Oceanfront towers in Myrtle Beach. Photo: U.S. Geological Survey, <a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://doi.org/10.5066/F7N877XX" target="_blank" rel="noopener noreferrer">U.S. Geological Survey</a>. Chapter3 Realty cropped and resized the photo.</div><div role="listitem">Houses and condo towers side by side in Myrtle Beach. Photo: U.S. Geological Survey, <a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://doi.org/10.5066/F7N877XX" target="_blank" rel="noopener noreferrer">U.S. Geological Survey</a>. Chapter3 Realty resized the photo and cut 1x1, 4x3 and 16x9 crops.</div><div role="listitem">Chapter3 Realty resized these photos and cropped some of them.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-10-d/buyers-undisclosed-flooding/conway-florence-floodwater-street-1200w.webp","url":"https://chapter3realty.com/images/2026-10-d/buyers-undisclosed-flooding/conway-florence-floodwater-street-1200w.webp","width":1200,"height":844,"encodingFormat":"image/webp","name":"Floodwater on a street of houses in the Conway area after Hurricane Florence","caption":"Floodwater on a street of houses in the Conway area after Hurricane Florence.","description":"Floodwater covering a residential street and the yards of single-story houses, with road signs standing in the water, in the Conway area after Hurricane Florence","creator":{"@type":"Person","name":"Senior Master Sgt. Edward Snyder, 169th Fighter Wing, South Carolina National Guard"},"creditText":"South Carolina National Guard (Senior Master Sgt","copyrightNotice":"Public domain (Senior Master Sgt. Edward Snyder, 169th Fighter Wing, South Carolina National Guard)","license":"https://commons.wikimedia.org/wiki/Template:PD-USGov-Military-National_Guard","acquireLicensePage":"https://commons.wikimedia.org/wiki/File:Hurricane_Florence_-_South_Carolina_National_Guard_Responds_(44200296354).jpg","isBasedOn":"https://commons.wikimedia.org/wiki/File:Hurricane_Florence_-_South_Carolina_National_Guard_Responds_(44200296354).jpg","contentLocation":{"@type":"Place","name":"Conway area, South Carolina (the source does not name the street), Conway, South Carolina"},"representativeOfPage":true},{"@type":"ImageObject","contentUrl":"https://chapter3