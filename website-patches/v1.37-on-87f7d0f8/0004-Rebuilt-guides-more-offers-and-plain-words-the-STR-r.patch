1px solid rgba(255,255,255,.92);box-shadow:inset 0 1px 0 rgba(255,255,255,.85),0 18px 40px -28px rgba(28,32,40,.45);border-radius:20px;margin:0;padding:.9rem 1rem}.c3-uf-tiles b{display:block;font-family:var(--serif);font-weight:400;font-size:1.9rem;line-height:1.1;color:#8a5226;margin-bottom:.3rem}.c3-uf-tiles span{display:block;color:var(--muted);font-size:1rem;line-height:1.5}.c3-uf-photo img{display:block;width:100%;height:auto;border-radius:12px}.c3-uf-three{list-style:none;margin:1.2rem 0 1.6rem;padding:0;display:grid;gap:.8rem;max-width:960px}@media (min-width:860px){.c3-uf-three{grid-template-columns:repeat(3,minmax(0,1fr))}}.c3-uf-three>li{background:linear-gradient(180deg,rgba(255,255,255,.8),rgba(255,255,255,.56));border:1px solid rgba(255,255,255,.92);box-shadow:inset 0 1px 0 rgba(255,255,255,.85),0 18px 40px -28px rgba(28,32,40,.45);border-radius:20px;margin:0;padding:1rem 1.1rem .95rem}.c3-uf-three .hd{display:flex;align-items:center;gap:.65rem;margin:0 0 .5rem;font-family:var(--sans);font-weight:650;font-size:1.08rem;color:var(--navy);line-height:1.3}.c3-uf-ic{flex:none;display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:13px;color:var(--brass);background:rgba(255,255,255,.85);border:1px solid rgba(255,255,255,.95);box-shadow:0 6px 14px -10px rgba(28,32,40,.45)}.c3-uf-three p{margin:0 0 .5rem;color:var(--muted);font-size:var(--read,1.0625rem);line-height:1.6}.c3-uf-three p:last-child{margin-bottom:0}.c3-uf-three .we{color:var(--navy);font-weight:500}main#main>section[style^="background:var(--navy)"]:last-of-type>.wrap{background:linear-gradient(160deg,rgba(42,48,64,.95),rgba(28,32,40,.97))!important;border:1px solid rgba(255,255,255,.14);box-shadow:inset 0 1px 0 rgba(255,255,255,.14),0 26px 60px -30px rgba(28,32,40,.6);display:block;text-align:center!important;border-radius:28px;padding:2.2rem 1.6rem;margin:0 auto!important}@media (max-width:699px){main#main>section[style^="background:var(--navy)"]:last-o