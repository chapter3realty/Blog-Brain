28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:760px}</style><style>main#main .c3b-map{max-width:760px}main#main .c3b-map figure{margin:1.2rem 0 .5rem!important}main#main .c3b-key{list-style:none;margin:0 0 1.2rem;padding:0;display:flex;flex-wrap:wrap;gap:.3rem .9rem;font-family:var(--sans);font-size:1rem;line-height:1.4;color:var(--navy)}main#main .c3b-key li{margin:0;display:flex;align-items:center;gap:.35rem}main#main .c3b-key b{display:inline-flex;align-items:center;justify-content:center;width:1.5rem;height:1.5rem;border-radius:50%;background:#fff;border:1.5px solid var(--navy);font-size:.85rem}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For condos, yes. For most houses, not yet. The test is months of supply: how long it would take to sell every home for sale if sales kept the past year's pace.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Housing researchers count 5 to 7 months as balanced in a local market. Past 7, buyers have room to bargain; under 5, sellers have the edge.</p><style>main#main .bm{max-width:760px;margin:1.5rem 0 1.6rem;padding:1.1rem 1.1rem 1rem;border-radius:22px;background:rgba(255,255,255,.62);border:1px solid rgba(255,255,255,.8);box-shadow:0 18px 40px -26px rgba(28,32,40,.35);backdrop-filter:blur(16px) saturate(140%);-webkit-backdrop-filter:blur(16px) saturate(140%);box-sizing:border-box}main#main .bm .cap{display:block;font-family:var(--sans);font-weight:700;color:var(--navy);font-size:1.05rem;line-height:1.35;margin:0 0 .7rem}main#main .bm-key{list-style:none;margin:0 0 .9rem;padding:0;display:flex;flex-wrap:wrap;gap:.35rem 1rem;font-family:var(--sans);font-size:.95rem;line-height:1.35;color:var(--navy)}main#main .bm-key li{margin:0;display:flex;align-items:center;gap:.4rem}main#main .bm-key i{flex:0 0 auto;width:.95rem;height:.95rem;border-radius:4px}main#main .bm h3.bm-g{font-family:var(--sans)!important;font-size:.82rem!important;letter-spacing:.12em;text-transform:uppercase;color:#8a5226!important;font-weight:700;margin:.6rem 0 .35rem!important}main#main .bm ol{list-style:none;margin:0;padding:0;display:grid;gap:.55rem}main#main .bm-r{margin:0;display:grid;grid-template-columns:minmax(0,15rem) minmax(0,1fr);align-items:center;gap:.2rem .9rem;font-family:var(--sans);color:var(--navy)}main#main .bm-n{font-size:1rem;line-height:1.3}main#main .bm-all .bm-n{font-weight:700}main#main .bm-t{display:grid;grid-template-columns:minmax(0,1fr) 7.4rem;align-items:center;gap:.5rem}main#main .bm-k{position:relative;display:flex;align-items:center;min-height:1.6rem}main#main .bm-b{display:block;height:1.05rem;border-radius:999px;min-width:.6rem}main#main .bm-all .bm-b{height:1.35rem}main#main .bm-b.sell,main#main .bm-key i.sell{background:#3d6f93}main#main .bm-b.bal,main#main .bm-key i.bal{background:#b59a77}main#main .bm-b.buy,main#main .bm-key i.buy{background:#c4783a}main#main .bm-v{white-space:nowrap;font-size:1rem;font-weight:700}main#main .bm-v small{font-size:.9rem;font-weight:500;color:var(--muted)}main#main .bm figcaption{margin-top:.85rem;color:var(--muted);font-size:.95rem;line-height:1.55}@media (max-width:599px){main#main .bm{padding:1rem .85rem .9rem}main#main .bm-r{grid-template-columns:1fr;gap:.15rem}main#main .bm ol{gap:.7rem}}</style><figure class="bm" role="group" aria-label="Months of homes for sale at the past year's pace of sales, Horry County, condos and houses by price"><span class="cap">Horry County: how many months it would take to sell every home for sale</span><ul class="bm-key" role="list"><li><i class="sell"></i>Sellers have the edge (under 5)</li><li><i class="bal"></i>Balanced (5 to 7)</li><li><i class="buy"></i>Buyers have room (over 7)</li></ul><h3 class="bm-g">Condos</h3><ol><li class="bm-r bm-all"><span class="bm-n">All condos</span><span class="bm-t"><span class="bm-k"><i class="bm-b buy" style="width:75.0%"></i></span><b class="bm-v">7.5<small> months</small></b></span></li><li class="bm-r"><span class="bm-n">Condos under $150K</span><span class="bm-t"><span class="bm-k"><i class="bm-b bal" style="width:67.0%"></i></span><b class="bm-v">6.7<small> months</small></b></span></li><li class="bm-r"><span class="bm-n">Condos $150K to $250K</span><span class="bm-t"><span class="bm-k"><i class="bm-b buy" style="width:85.0%"></i></span><b class="bm-v">8.5<small> months</small></b></span></li><li class="bm-r"><span class="bm-n">Condos $250K to $400K</span><span class="bm-t"><span class="bm-k"><i class="bm-b bal" style="width:67.0%"></i></span><b class="bm-v">6.7<small> months</small></b></span></li><li class="bm-r"><span class="bm-n">Condos $400K and up</span><span class="bm-t"><span class="bm-k"><i class="bm-b buy" style="width:79.0%"></i></span><b class="bm-v">7.9<small> months</small></b></span></li></ol><h3 class="bm-g">Houses</h3><ol><li class="bm-r bm-all"><span class="bm-n">All houses</span><span class="bm-t"><span class="bm-k"><i class="bm-b sell" style="width:38.0%"></i></span><b class="bm-v">3.8<small> months</small></b></span></li><li class="bm-r"><span class="bm-n">Houses under $300K</span><span class="bm-t"><span class="bm-k"><i class="bm-b sell" style="width:33.0%"></i></span><b class="bm-v">3.3<small> months</small></b></span></li><li class="bm-r"><span class="bm-n">Houses $300K to $450K</span><span class="bm-t"><span class="bm-k"><i class="bm-b sell" style="width:32.0%"></i></span><b class="bm-v">3.2<small> months</small></b></span></li><li class="bm-r"><span class="bm-n">Houses $450K to $700K</span><span class="bm-t"><span class="bm-k"><i class="bm-b sell" style="width:44.0%"></i></span><b class="bm-v">4.4<small> months</small></b></span></li><li class="bm-r"><span class="bm-n">Houses $700K and up</span><span class="bm-t"><span class="bm-k"><i class="bm-b bal" style="width:72.0%"></i></span><b class="bm-v">about 7<small> months</small></b></span></li></ol><figcaption>Homes for sale today against homes sold in the past year across Horry County, builders' sales included. Houses include townhouses and manufactured homes.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Condos as a whole are past 7 months; two condo price ranges sit just under 7, at the top of balanced. On a condo there is room to ask for a lower price or for repairs. On a house under $700,000 there is less room: those houses would sell out in about half the time.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Sellers already feel it. More than half of the homes for sale have cut their asking price. About 4 in 10 houses and more than half of condos for sale have been listed more than 90 days.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/buyers-buying-in-myrtle-beach/myrtle-beach-skywheel-beach-1200w.webp" srcset="/images/2026-11-a/buyers-buying-in-myrtle-beach/myrtle-beach-skywheel-beach-600w.webp 600w, /images/2026-11-a/buyers-buying-in-myrtle-beach/myrtle-beach-skywheel-beach-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="675" alt="The wide beach in downtown Myrtle Beach at low tide, with the SkyWheel, rows of blue umbrellas and towers along the shore" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/licenses/by-sa/2.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: Tom Long, CC BY-SA 2.0. License: CC BY-SA 2.0" title="License: CC BY-SA 2.0">Photo: Tom Long, CC BY-SA 2.0</a></span></div><figcaption>The beach beside the SkyWheel in downtown Myrtle Beach, inside city limits.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="/market-reports/" style="color:var(--navy);text-decoration:underline">House prices</a> have stopped climbing. A federal index of Horry County house prices rose about 51 percent in four years, then was about flat in the latest year. It tracks houses, not condos.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Sales follow the season. Recorded resales were fewest in January and February, about 430 houses a month, and were about 620 to 670 a month from May to October.</p></div></section><section style="background:var(--ivory)" id="by-town"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Town by town">Where in Myrtle Beach do buyers have the most room to negotiate?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Condos in the City of Myrtle Beach have the most supply of any town here. Houses in Surfside Beach, Little River, Carolina Forest, Forestbrook and Red Hill have under 4 months.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Many buyers say "Myrtle Beach" for the whole coast. The map and the table split it into ten towns and communities, from Little River to Garden City and inland to Conway.</p><div class="c3b-map"><figure style="margin:1.8rem 0;max-width:760px"><svg style="display:block;width:100%;height:auto" xmlns="http://www.w3.org/2000/svg" id="c3r-ten-towns-and-communitie" viewBox="0 0 360 288" width="360" height="288" role="img" aria-label="Map of the Grand Strand from Little River to Garden City and inland to Conway, with ten towns and communities numbered as in the table below and shaded by their months of houses for sale: blue under 5 months, sand 5 to 7, brass over 7." style="display:block;width:100%;height:auto;max-width:760px;background:#f7f3ec;border:1px solid rgba(28,32,40,.15)"><style>#c3r-ten-towns-and-communitie text{font-family:'DM Sans',system-ui,-apple-system,'Segoe UI',sans-serif;paint-order:stroke;stroke:#f7f3ec;stroke-width:3px;stroke-linejoin:round;fill:#1c2028}#c3r-ten-towns-and-communitie .h{font:500 17px 'Fraunces',Georgia,serif}#c3r-ten-towns-and-communitie .l{font-size:14px;font-weight:500}#c3r-ten-towns-and-communitie .m{font-size:13px;font-weight:500;fill:#91592b}#c3r-ten-towns-and-communitie .t{font-size:14px;font-weight:500;letter-spacing:.1em;fill:#5c6b78}#c3r-ten-towns-and-communitie .T{font-size:14px;font-weight:500;letter-spacing:.1em;fill:#3b4450}#c3r-ten-towns-and-communitie .o{font:italic 400 15px 'Fraunces',Georgia,serif;letter-spacing:.06em;fill:#3f6275;stroke:#c9dde6}#c3r-ten-towns-and-communitie .p{font-size:14px;font-weight:500;fill:#4a6640}#c3r-ten-towns-and-communitie .f{font-size