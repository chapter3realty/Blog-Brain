96h0M235 269h0M282 225h0M108 236h0M286 262h0M137 259h0M123 268h0M190 327h0M222 267h0M208 153h0M324 258h0M239 148h0M142 381h0M103 226h0M212 189h0M211 234h0M106 255h0M254 274h0M260 267h0M284 260h0M301 261h0M170 236h0M126 261h0M211 239h0M67 197h0M87 271h0M213 189h0M318 277h0M212 153h0M238 149h0M87 272h0M133 288h0M240 150h0M104 227h0M305 251h0M280 182h0M86 272h0M255 275h0M107 236h0M198 286h0M232 278h0M141 380h0M173 358h0M286 175h0M151 391h0M137 260h0M285 176h0" stroke="#c4783a" stroke-opacity=".9" stroke-width="4.6" stroke-linecap="round" fill="none"/><text x="428" y="418" text-anchor="end" font-family="Inter,system-ui,sans-serif" font-size="17" font-style="italic" fill="#3f6275">Atlantic Ocean</text><circle cx="219.2" cy="152.6" r="4.5" fill="#fff" stroke="#1c2028" stroke-width="2"/><text x="231.2" y="158.6" text-anchor="start" font-family="Inter,system-ui,sans-serif" font-size="19.5" font-weight="600" fill="#1c2028" paint-order="stroke" stroke="#fbf8f3" stroke-width="5" stroke-linejoin="round"><tspan x="231.2" dy="0">Loris</tspan></text><circle cx="291.3" cy="219.0" r="4.5" fill="#fff" stroke="#1c2028" stroke-width="2"/><text x="303.3" y="213.0" text-anchor="start" font-family="Inter,system-ui,sans-serif" font-size="19.5" font-weight="600" fill="#1c2028" paint-order="stroke" stroke="#fbf8f3" stroke-width="5" stroke-linejoin="round"><tspan x="303.3" dy="0">Longs</tspan></text><circle cx="71.1" cy="184.7" r="4.5" fill="#fff" stroke="#1c2028" stroke-width="2"/><text x="71.1" y="170.7" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-size="19.5" font-weight="600" fill="#1c2028" paint-order="stroke" stroke="#fbf8f3" stroke-width="5" stroke-linejoin="round"><tspan x="71.1" dy="0">Aynor</tspan></text><circle cx="144.5" cy="277.5" r="4.5" fill="#fff" stroke="#1c2028" stroke-width="2"/><text x="132.5" y="283.5" text-anchor="end" font-family="Inter,system-ui,sans-serif" font-size="19.5" font-weight="600" fill="#1c2028" paint-order="stroke" stroke="#fbf8f3" stroke-width="5" stroke-linejoin="round"><tspan x="132.5" dy="0">Conway</tspan></text><circle cx="334.4" cy="251.7" r="4.5" fill="#fff" stroke="#1c2028" stroke-width="2"/><text x="326.4" y="239.7" text-anchor="end" font-family="Inter,system-ui,sans-serif" font-size="19.5" font-weight="600" fill="#1c2028" paint-order="stroke" stroke="#fbf8f3" stroke-width="5" stroke-linejoin="round"><tspan x="326.4" dy="0">Little River</tspan></text><circle cx="305.4" cy="284.5" r="4.5" fill="#fff" stroke="#1c2028" stroke-width="2"/><text x="312.4" y="304.5" text-anchor="start" font-family="Inter,system-ui,sans-serif" font-size="19.5" font-weight="600" fill="#1c2028" paint-order="stroke" stroke="#fbf8f3" stroke-width="5" stroke-linejoin="round"><tspan x="312.4" dy="0">North Myrtle</tspan><tspan x="312.4" dy="20">Beach</tspan></text><circle cx="207.5" cy="315.6" r="4.5" fill="#fff" stroke="#1c2028" stroke-width="2"/><text x="221.5" y="285.6" text-anchor="start" font-family="Inter,system-ui,sans-serif" font-size="19.5" font-weight="600" fill="#1c2028" paint-order="stroke" stroke="#fbf8f3" stroke-width="5" stroke-linejoin="round"><tspan x="221.5" dy="0">Carolina</tspan><tspan x="221.5" dy="20">Forest</tspan></text><circle cx="220.3" cy="347.0" r="4.5" fill="#fff" stroke="#1c2028" stroke-width="2"/><text x="232.3" y="363.0" text-anchor="start" font-family="Inter,system-ui,sans-serif" font-size="19.5" font-weight="600" fill="#1c2028" paint-order="stroke" stroke="#fbf8f3" stroke-width="5" stroke-linejoin="round"><tspan x="232.3" dy="0">Myrtle Beach</tspan></text><circle cx="163.2" cy="359.9" r="4.5" fill="#fff" stroke="#1c2028" stroke-width="2"/><text x="151.2" y="361.9" text-anchor="end" font-family="Inter,system-ui,sans-serif" font-size="19.5" font-weight="600" fill="#1c2028" paint-order="stroke" stroke="#fbf8f3" stroke-width="5" stroke-linejoin="round"><tspan x="151.2" dy="0">Socastee</tspan></text><circle cx="177.8" cy="403.4" r="4.5" fill="#fff" stroke="#1c2028" stroke-width="2"/><text x="166.8" y="411.4" text-anchor="end" font-family="Inter,system-ui,sans-serif" font-size="19.5" font-weight="600" fill="#1c2028" paint-order="stroke" stroke="#fbf8f3" stroke-width="5" stroke-linejoin="round"><tspan x="166.8" dy="0">Surfside Beach</tspan></text></g></svg><div class="c3-ft-mkey" aria-hidden="true"><span><i style="background:#5c6b78"></i>Resale house or townhouse</span><span><i style="background:#c4783a"></i>New from a builder</span></div><figcaption style="color:var(--muted);font-size:.95rem;line-height:1.55;margin-top:.6rem">Each dot is a house or townhouse that sold for under $300,000 in the past year. Map: Chapter3 Realty, from Horry County deed and parcel records and Census TIGER/Line county lines and coast.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Four neighborhoods with many sales under $300,000 last year, and the loans that fit each. Three are new from a builder and inside USDA's area on USDA's own map. There, a buyer who qualifies can use a USDA loan with no down payment. None of the lots sold in the four were in a high-risk flood zone.</p><ul class="c3-ft-hoods" role="list"><li><h3><a href="/buyers/affordable-places-to-live/#amber-bluff" style="color:var(--navy);text-decoration:underline">The Townes at Amber Bluff</a></h3><span class="w">Conway, off Savannah Bluff Road</span><p>New townhomes, at a middle price of about $238,000 last year. Inside USDA's area.</p><div class="hx-strip" data-place="amber-bluff" data-name="The Townes at Amber Bluff"></div></li><li><h3><a href="/buyers/affordable-places-to-live/#indigo-grove" style="color:var(--navy);text-decoration:underline">Indigo Grove</a></h3><span class="w">Near Longs, off SC 90</span><p>New houses, at a middle price of about $245,000 last year. Inside USDA's area.</p><div class="hx-strip" data-place="indigo-grove" data-name="Indigo Grove"></div></li><li><h3><a href="/buyers/affordable-places-to-live/#birchwood" style="color:var(--navy);text-decoration:underline">Birchwood</a></h3><span class="w">Southwest of Longs, off SC 905</span><p>New houses, at a middle price of about $226,000 last year, less than the new townhomes at Amber Bluff. Inside USDA's area.</p><div class="hx-strip" data-place="birchwood" data-name="Birchwood"></div></li><li><h3><a href="/buyers/affordable-places-to-live/#golf-and-yacht-club" style="color:var(--navy);text-decoration:underline">Myrtle Beach Golf and Yacht Club</a></h3><span class="w">Off Bay Road, from SC 707 near Socastee</span><p>Resale houses, at a middle price of about $225,000 last year. Outside USDA's area, so a USDA loan cannot be used here. An FHA or VA loan can, and on either the seller can pay your closing costs.</p><div class="hx-strip" data-place="golf-and-yacht-club" data-name="Myrtle Beach Golf and Yacht Club"></div></li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Other neighborhoods had many sales under $300,000 last year, nearly all new from a builder. They are Cypress Ridge and Tupelo Park near Longs, Warner Crossing and Andalusia near Loris, Kingston Oaks and Meadows Edge in Conway, and Spring Grove near Aynor. Our guide to the <a href="/buyers/affordable-places-to-live/" style="color:var(--navy);text-decoration:underline">most affordable places to live</a> says what life is like in each of the four, and has eight more, with prices and HOA fees.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/">Get houses for sale in Conway and Longs<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></section><section style="background:var(--ivory)" id="condo-or-house"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Condo or house">Should your first home in Myrtle Beach be a condo or a house?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A house, if your budget reaches about $250,000 and you can live inland. Below that, most homes that sell are condos, and a condo can be a good first home once we have checked the building.</p><ul class="c3-ft-vs" role="list" aria-label="A condo or a house for a first home in Horry County"><li class="c"><p class="hd"><span class="c3-ft-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 21h18M5 21V9.5l5-3V21M10 21V4h9v17M13 8h3M13 12h3M13 16h3M7.5 13h.01M7.5 16.5h.01"/></svg></span>A condo</p><p>A condo is the lowest price into a home of your own here. The loan is the hard part: the building has to be approved for it. HUD, the federal housing department, lists only 9 condo communities in all of Horry County that are approved for FHA loans.</p><p>About 1 in 6 condos that sold under $300,000 were in a high-risk flood zone, where the lender will require flood insurance. About half went to owners who get their tax bill in another state.</p></li><li class="c"><p class="hd"><span class="c3-ft-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span>A house</p><p>A house costs more, and the loan is simpler: there is no building to approve. The middle house listed at or under $300,000 has about twice the floor space of the middle condo, and a yard.</p><p>Only about 3 in 100 houses and townhouses that sold under $300,000 were in a high-risk flood zone. About 1 in 7 went to owners whose tax bill goes to another state.</p></li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In our experience, condo buildings with a rental program usually do not meet the rules most conventional loans follow, because so many owners are investors. An FHA loan in a building that is not on HUD's list needs an approval for that one unit.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A condo also has a monthly fee to its homeowners association (HOA), and the chance of a special assessment, a one-time bill for repairs. Our guide to <a href="/hoa/special-assessments/" style="color:var(--navy);text-decoration:underline">special assessments</a> explains them. Many houses have an HOA too; our <a href="/buyers/no-hoa-homes/" style="color:var(--navy);text-decoration:underline">guide to homes with no HOA</a> lists places without one.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What we check before you make an offer</h3><ul class="c3-ft-check" role="list" aria-label="What we check before you make an offer"><li><span><strong>The building's loan approval.</strong> For a condo, we find out whether the building is approved for your loan before you offer.</span></li><li><span><strong>The HOA papers.</strong> We read the rules, the budget, the money saved for repairs and the financial statements, so a fee rise or a one-time repair bill is no surprise.</span></li><li><span><strong>The flood zone.</strong> We look up every home you offer on, so you know whether the lender will require flood insurance.</span></li><li><span><strong>The insurance quote.</strong> If you buy with us, we get you one before you make an offer on a house.</span></li></ul><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Condos and houses in your budget</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us your budget and the towns you like. An agent sends homes that fit.</p><a class="btn btn-brass" href="/contact/">Send me condos and houses</a></div></div></section><section style="background:var(--ivory-2)" id="yearly-cost"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Yearly cost">What will your first home cost each year besides the loan?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Property tax is the yearly cost you can work out before you buy. On a $270,000 house you live in, outside the cities, the county tax is about $990 a year once you file for the 4 percent owner rate.</p><div style="overflow-x:auto;margin:1.2rem 0;max-width:760px"><table style="width:100%;border-collapse:collapse;font-size:.92rem"><thead><tr><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Cost besides the loan</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">What to plan for</th></tr></thead><tbody><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Property tax on your own home, after you file</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">About $990 a year on a $270,000 house</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Property tax if you do not file</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">About $3,260 a year on the same house</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Home insurance on a house</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">About $2,000 a year in the middle; half of owners pay $1,300 to $3,000</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">A condo owner's own insurance</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">About $800 a year; the condo fee may also pay the building's insurance</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Electric, one household's summer bill</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">About $130 a month</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Water, the same household</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">About $50 a month</td></tr></tbody></table></div><p class="c3-ft-note">Tax: county tax outside the cities, on the county's value, before special district and stormwater fees. Insurance: what Horry County owners who live in their home told the Census they paid in 2024 for fire, hazard and flood insurance, outside the Loris area. Electric and water: one of our team's own bills, on a 1,400 square foot two-story house; one household, not an average.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The 4 percent rate means your home is taxed on 4 percent of its value. Any home you do not file for is taxed on 6 percent, and pays school operating tax too. Filing saves more than $2,200 a year here, and it is not automatic: the last step below has the deadline. Our <a href="/buyers/property-taxes/" style="color:var(--navy);text-decoration:underline">property tax guide</a> has every town's rate.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Flood and wind</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A lender must require flood insurance when the building is in a high-risk flood zone. A policy bought while the mortgage is made starts with no wait; otherwise there is a 30‑day wait.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In Myrtle Beach, homes east of the U.S. 17 Bypass are in the state's coastal wind area, where insurers may leave wind and hail out of a homeowners policy. The insurance figures above include flood and wind policies where owners have them. Your own quote depends on the house. Our <a href="/buyers/coastal-insurance/" style="color:var(--navy);text-decoration:underline">coastal insurance guide</a> explains the policies, and our <a href="/buyers/cost-to-own/" style="color:var(--navy);text-decoration:underline">cost to own guide</a> adds up a year.</p></div></section><section style="background:var(--ivory)" id="qualify"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Qualify">Do you qualify as a first-time home buyer in South Carolina?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">These are the lines that decide whether the help above fits you.</p><ul class="c3-ft-ways" role="list" aria-label="Who qualifies as a first-time home buyer in Horry County"><li><span class="c3-ft-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span class="k">Have you owned a home before?</span><span class="d">SC Housing's main program in Horry County does not ask whether you owned a home in the past. It asks only that you own no other property, or a share of one, on the day the loan closes. Bare land is allowed. The IRA rule above is different: no main home in the last two years.</span></li><li><span class="c3-ft-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h8l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v4h4M9 17l6-6"/><circle cx="9.5" cy="11.5" r="1"/><circle cx="14.5" cy="16.5" r="1"/></svg></span><span class="k">Your credit score</span><span class="d">SC Housing needs at least a 640 credit score. FHA needs 500, and 580 for its smallest down payment.</span></li><li><span class="c3-ft-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 9.4c-.4-1-1.5-1.8-3-1.8-1.8 0-3 1-3 2.2 0 3 6 1.6 6 4.4 0 1.3-1.3 2.2-3 2.2-1.6 0-2.7-.7-3.1-1.8M12 5.8v1.8M12 16.4v1.8"/><circle cx="12" cy="12" r="9"/></svg></span><span class="k">Your income, for SC Housing</span><span class="d">In Horry County, SC Housing's household income limit is about $115,000 a year for one or two people and about $134,000 for three or more. The home's price can be up to $450,000.</span></li><li><span class="c3-ft-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 5h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM3 10h18M8 3v4M16 3v4M8 14h.01M12 14h.01M16 14h.01M8 17.5h.01M12 17.5h.01"/></svg></span><span class="k">Living in it</span><span class="d">On an FHA loan, one buyer moves in within 60 days of closing and plans to stay at least a year.</span></li></ul><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Could SC Housing's help fit you?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us your household size and your income. When an SC Housing program fits, an agent connects you with an SC Housing approved lender.</p><a class="btn btn-brass" href="/contact/">Have us connect you to an SC Housing lender</a></div></div></section><section style="background:var(--ivory-2)" id="steps"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Steps">What are the steps to buy your first home in South Carolina?</h2><ol class="c3-ft-steps"><li><strong>Get pre-approved by a lender.</strong>The lender checks your credit and income and gives you a price to shop under. When an SC Housing program fits, a Chapter3 agent connects you with an SC Housing approved lender.</li><li><strong>Choose a home.</strong>We send homes in your budget and run the checks above on each one you like.</li><li><strong>Make the offer.</strong>You can ask the seller to pay your closing costs in the offer. If a real estate broker holds your earnest money, it stays in the broker's trust account until the sale closes. In an ordinary sale it is credited to you at closing.</li><li><strong>Inspect the house.</strong>A home inspector looks over the house for you.</li><li><strong>The appraisal.</strong>The lender's appraiser gives the home a value. Low appraisals are rare here. When one comes in low, our agents gather recent sales of similar homes and ask for the value to be looked at again.</li><li><strong>Close with an attorney.</strong>Every South Carolina home closing must be supervised by a South Carolina attorney.</li><li><strong>Move in, then file for the 4 percent rate.</strong>Apply to the county assessor by January 15 after the year you move in.</li></ol><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our guide to <a href="/buyers/buying-in-myrtle-beach/" style="color:var(--navy);text-decoration:underline">buying a home in Myrtle Beach</a> covers the purchase in more detail, and our <a href="/buyers/common-mistakes/" style="color:var(--navy);text-decoration:underline">common buyer mistakes</a> page lists what goes wrong. Moving from another state? Our <a href="/buyers/relocating/" style="color:var(--navy);text-decoration:underline">relocation guide</a> covers the move.</p></div></section><section style="background:var(--ivory)" id="first-time-home-buyer-questions"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">First-time home buyer questions</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is there a first-time home buyer tax credit in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">SC Housing no longer offers its tax credit certificate. The tax break an owner gets here is the 4 percent rate on the home you live in, which needs an application to the county assessor.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is there a homestead exemption for first-time buyers in Horry County?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not for being a first-time buyer. In South Carolina the homestead exemption is for owners 65 or older who have lived in the state a year, or who are disabled or blind. It exempts the first $50,000 of the home's value.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is there help if I earn more than SC Housing's limit?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Palmetto Home Advantage, another SC Housing program, has an income limit of $140,000 in every county, counted on the buyers' own income, not the whole household. It is open to first-time and repeat buyers. Its help is forgiven after 10 years, and repaid in full on a sale, refinance or move before then.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What is the FHA loan limit in Horry County?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">FHA's 2026 loan limit for a one-unit home in Horry County is about $541,000. That is well above HUD's own estimate of the area's middle sale price, $340,000.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeDocType" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County deed index</a>, <a href="https://www.hud.gov/sites/default/files/Housing/documents/40001-hsgh-Update-18.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">HUD Handbook 4000.1</a>, <a href="https://entp.hud.gov/idapp/html/hicostlook.cfm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FHA loan limits</a>, <a href="https://www.va.gov/housing-assistance/home-loans/loan-types/purchase-loan/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">VA purchase loans</a>, <a href="https://www.ecfr.gov/current/title-7/subtitle-B/chapter-XXXV/part-3555" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">7 CFR 3555</a>, <a href="https://www.irs.gov/publications/p590b" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">IRS Publication 590-B</a>, <a href="https://www.scstatehouse.gov/code/t12c043.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-43</a>, <a href="https://www.horrycountysc.gov/media/kufln4qp/tax-levy-2026_2.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County 2026 tax levy</a>, <a href="https://www.floodsmart.gov/get-insured/buy-a-policy" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FloodSmart</a>, <a href="https://eligibility.sc.egov.usda.gov/eligibility/welcomeAction.do" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">USDA eligibility map</a>, <a href="https://www2.census.gov/programs-surveys/acs/data/pums/2024/1-Year/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Census microdata</a>. Sales: Horry County deeds of $10,000 or more, October 2025 to September 2026, with the county's maps. Listings: Chapter3's MLS count. Insurance: Census microdata for Horry County outside the Loris area. Chapter3 Realty is not a lender. Not loan or tax advice.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Houses in Bent Oak Estates, in the City of Myrtle Beach, from above. Photo: NOAA National Geodetic Survey, <a href="https://www.govinfo.gov/content/pkg/USCODE-2023-title17/html/USCODE-2023-title17-chap1-sec105.htm" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://noaa-eri-pds.s3.amazonaws.com/index.html#2026_Pre_Event/EC2601a_OB_N_RGB/" target="_blank" rel="noopener noreferrer">NOAA Emergency Response Imagery</a>. Chapter3 Realty cut a 1200 x 900 px view from one NOAA map tile and raised the contrast and color slightly.</div><div role="listitem">Chapter3 Realty resized these photos and cropped some of them.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-10-d/buyers-first-time-home-buyer-myrtle-beach/bent-oak-estates-houses-from-above-1200w.webp","url":"https://chapter3realty.com/images/2026-10-d/buyers-first-time-home-buyer-myrtle-beach/bent-oak-estates-houses-from-above-1200w.webp","width":1200,"height":900,"encodingFormat":"image/webp","name":"Houses in Bent Oak Estates, in the City of Myrtle Beach, from above","caption":"Houses in Bent Oak Estates, in the City of Myrtle Beach, from above in January 2026. Nine of the 10 houses that sold in this view in the past year went for under $300,000.","description":"Rows of small one-story houses with gray and brown roofs, short driveways and small yards along three streets, seen from above","creator":{"@type":"Organization","name":"NOAA National Geodetic Survey"},"creditText":"NOAA National Geodetic Survey, public domain","copyrightNotice":"Public domain (NOAA National Geodetic Survey)","license":"https://www.govinfo.gov/content/pkg/USCODE-2023-title17/html/USCODE-2023-title17-chap1-sec105.htm","acquireLicensePage":"https://noaa-eri-pds.s3.amazonaws.com/index.html#2026_Pre_Event/EC2601a_OB_N_RGB/","isBasedOn":"https://noaa-eri-pds.s3.amazonaws.com/index.html#2026_Pre_Event/EC2601a_OB_N_RGB/","contentLocation":{"@type":"Place","name":"Bent Oak Estates, Myrtle Beach, South Carolina"}}]}</script></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family