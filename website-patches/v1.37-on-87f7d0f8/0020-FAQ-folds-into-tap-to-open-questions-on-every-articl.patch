   addEventListener('pageshow', clear);
 })();
 </script>
+<style>/* FAQ questions open on a tap (owner, 2026-11-08: "make the FAQ a drop down box to make the scroll bar less intimidating while keeping SEO benefit"). The answers stay in the page's HTML for search engines; this script folds them for readers. */
+main .c3-faq{border-top:1px solid var(--rule,#d9d3c7);margin:0;max-width:760px}
+main .c3-faq:last-of-type{border-bottom:1px solid var(--rule,#d9d3c7)}
+main .c3-faq>summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.05rem 0;min-height:44px}
+main .c3-faq>summary::-webkit-details-marker{display:none}
+main .c3-faq>summary>h3{margin:0!important;font-size:1.12rem}
+main .c3-faq>summary::after{content:"+";flex:none;font:400 1.6rem/1 var(--sans,system-ui);color:var(--brass-ink,#91592b);transition:transform .15s}
+main .c3-faq[open]>summary::after{transform:rotate(45deg)}
+main .c3-faq>summary:focus-visible{outline:2px solid var(--brass-ink,#91592b);outline-offset:3px}
+main .c3-faq>.c3-faq-a{padding:0 0 1.1rem}
+main .c3-faq>.c3-faq-a>*:first-child{margin-top:0}
+@media (prefers-reduced-motion:reduce){main .c3-faq>summary::after{transition:none}}
+</style>
+<script>(function(){
+  function fold(){
+    var main=document.querySelector('main'); if(!main) return;
+    var h2=[].slice.call(main.querySelectorAll('h2')).filter(function(h){return /\bFAQ\b|questions/i.test(h.textContent)&&!h.closest('.c3-faq');});
+    h2.forEach(function(h){
+      var sec=h.closest('section')||h.parentElement; if(!sec) return;
+      var qs=[].slice.call(sec.querySelectorAll('h3')).filter(function(q){return !q.closest('.c3-faq')&&!q.closest('form');});
+      if(qs.length<2) return;
+      qs.forEach(function(q){
+        var parent=q.parentElement, ans=[], n=q.nextElementSibling;
+        while(n&&n.tagName!=='H3'&&n.tagName!=='H2'&&!/^\s*Sources?:/.test(n.textContent)&&!n.querySelector('h3')&&!(n.matches&&n.matches('form,.c3-offer,[class*="cta"],[class*="offer"]'))){ans.push(n);n=n.nextElementSibling;}
+        if(!ans.length) return;
+        var d=document.createElement('details'); d.className='c3-faq';
+        var sm=document.createElement('summary'); var box=document.createElement('div'); box.className='c3-faq-a';
+        parent.insertBefore(d,q); sm.appendChild(q); d.appendChild(sm); ans.forEach(function(a){box.appendChild(a);}); d.appendChild(box);
+        if(parent.children.length===1&&parent!==sec&&parent.tagName==='DIV'&&/border-top/.test(parent.getAttribute('style')||'')){parent.style.borderTop='0';parent.style.padding='0';}
+      });
+    });
+    if(location.hash){var t=document.getElementById(location.hash.slice(1)); var d=t&&t.closest&&t.closest('details.c3-faq'); if(d) d.open=true;}
+  }
+  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',fold); else fold();
+})();</script>
 </footer>
 
 
 
