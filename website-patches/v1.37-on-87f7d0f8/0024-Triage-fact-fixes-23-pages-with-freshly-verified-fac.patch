ercase">Change to September 2026</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">A year</th></tr></thead><tbody><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">2025 (1 year)</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$337,789</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">+0.6%</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">+0.6%</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">2023 (3 years)</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$347,009</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">−2.1%</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">−0.7%</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">2021 (5 years)</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$279,093</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">+21.7%</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">+4.0%</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">2016 (10 years)</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$188,698</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">+80.0%</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">+6.1%</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted