m="translate(170.0 143.1)"><g class="k"><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="ab" y="4.5" text-anchor="middle">7</text></g></g><g transform="translate(185.6 162.9)"><g class="k"><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="ab" y="4.5" text-anchor="middle">8</text></g></g><g transform="translate(154.6 171.3)"><g class="k"><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="ab" y="4.5" text-anchor="middle">9</text></g></g><path d="M162.3 192.9L186.3 221.9" stroke="#1c2028" stroke-width="1.2"/><g transform="translate(186.3 221.9)"><g class="k"><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="ab" y="4.5" text-anchor="middle">10</text></g></g><path d="M157.8 197.7L165.8 239.7" stroke="#1c2028" stroke-width="1.2"/><g transform="translate(165.8 239.7)"><g class="k"><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="ab" y="4.5" text-anchor="middle">11</text></g></g><g transform="translate(146.5 209.1)"><g class="k"><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="ab" y="4.5" text-anchor="middle">12</text></g></g><g transform="translate(119.1 211.9)"><g class="k"><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="ab" y="4.5" text-anchor="middle">13</text></g></g></g></svg><figcaption style="color:var(--muted);font-size:.85rem;line-height:1.6;margin-top:.6rem">The numbers match the list of places. Map data: U.S. Census Bureau TIGER/Line; Horry County GIS.</figcaption></figure></div><div class="c3t-find" id="find"><div class="c3t-chips" role="group" aria-label="What you want" hidden><button type="button" class="c3t-chip" data-k="b1" aria-pressed="false">Up to $300,000</button><button type="button" class="c3t-chip" data-k="b2" aria-pressed="false">$300,000 to $450,000</button><button type="button" class="c3t-chip" data-k="b3" aria-pressed="false">Over $450,000</button><button type="button" class="c3t-chip" data-k="sand" aria-pressed="false">Beach in 10 minutes</button><button type="button" class="c3t-chip" data-k="land" aria-pressed="false">Acre lots common</button><button type="button" class="c3t-chip" data-k="new" aria-pressed="false">Builders selling now</button><button type="button" class="c3t-chip" data-k="dry" aria-pressed="false">Few in a flood zone</button><button type="button" class="c3t-chip" data-k="nohoa" aria-pressed="false">Mostly no HOA fee</button><button type="button" class="c3t-chip" data-k="cost" aria-pressed="false">Lowest yearly cost</button></div><p class="c3t-count" aria-live="polite" hidden></p><ol class="c3t-list" role="list"><li data-tags="b1 land new dry nohoa cost"><b aria-hidden="true" data-n="1"></b><span class="t"><a class="nm" href="#loris">Loris</a><span class="bf">The most land for the money</span></span></li><li data-tags="b2 land new dry nohoa cost"><b aria-hidden="true" data-n="2"></b><span class="t"><a class="nm" href="#aynor">Aynor</a><span class="bf">An acre is the usual lot</span></span></li><li data-tags="b1 new dry cost"><b aria-hidden="true" data-n="3"></b><span class="t"><a class="nm" href="#longs">Longs</a><span class="bf">Where builders are selling</span></span></li><li data-tags="b2 dry"><b aria-hidden="true" data-n="4"></b><span class="t"><a class="nm" href="#little-river">Little River</a><span class="bf">Old gardens on the waterway, and boat slips</span></span></li><li data-tags="b1 new dry"><b aria-hidden="true" data-n="5"></b><span class="t"><a class="nm" href="#conway">Conway</a><span class="bf">A river city with its own services</span></span></li><li data-tags="b3 sand new"><b aria-hidden="true" data-n="6"></b><span class="t"><a class="nm" href="#north-myrtle-beach">North Myrtle Beach</a><span class="bf">Most houses for sale near the sand</span></span></li><li data-tags="b2 dry"><b aria-hidden="true" data-n="7"></b><span class="t"><a class="nm" href="#carolina-forest">Carolina Forest</a><span class="bf">The newest homes, almost no flood zone</span></span></li><li data-tags="b3 sand dry"><b aria-hidden="true" data-n="8"></b><span class="t"><a class="nm" href="#myrtle-beach">Myrtle Beach</a><span class="bf">The shortest drive to everything</span></span></li><li data-tags="b1 new cost"><b aria-hidden="true" data-n="9"></b><span class="t"><a class="nm" href="#socastee">Socastee</a><span class="bf">A historic village on the waterway</span></span></li><li data-tags="b3 sand nohoa"><b aria-hidden="true" data-n="10"></b><span class="t"><a class="nm" href="#surfside-beach">Surfside Beach</a><span class="bf">The sand at the end of the street</span></span></li><li data-tags="b2 sand nohoa"><b aria-hidden="true" data-n="11"></b><span class="t"><a class="nm" href="#garden-city">Garden City</a><span class="bf">Between the ocean and the marsh</span></span></li><li data-tags="b3 sand"><b aria-hidden="true" data-n="12"></b><span class="t"><a class="nm" href="#murrells-inlet">Murrells Inlet</a><span class="bf">The creek and the closest hospital</span></span></li><li data-tags="b3 sand"><b aria-hidden="true" data-n="13"></b><span class="t"><a class="nm" href="#pawleys-litchfield">Pawleys Island</a><span class="bf">An island town where houses rarely sell</span></span></li></ol><p class="c3t-none" hidden>No place has all of these. Remove one choice to see the closest.</p><nav class="c3t-jump" aria-label="Further down"><a href="#compare">Compare</a> &middot; <a href="#yearly-cost">Yearly cost</a> &middot; <a href="#city-or-county">City or county</a> &middot; <a href="#questions-about-the-towns">Questions about the towns</a></nav></div></div><script>(function(){var f=document.getElementById("find");if(!f)return;var cs=f.querySelector(".c3t-chips"),ct=f.querySelector(".c3t-count"),no=f.querySelector(".c3t-none"),li=f.querySelectorAll(".c3t-list li");cs.hidden=false;var B=["b1","b2","b3"];function run(){var on=[].slice.call(cs.querySelectorAll('[aria-pressed="true"]')).map(function(b){return b.getAttribute("data-k")}),n=0;[].forEach.call(li,function(l){var t=" "+l.getAttribute("data-tags")+" ",ok=on.every(function(k){return t.indexOf(" "+k+" ")>=0});l.hidden=!ok;if(ok)n++});no.hidden=n>0;ct.hidden=!on.length;ct.textContent=on.length?(n+(n===1?" place fits":" places fit")+" what you picked."):"";}cs.addEventListener("click",function(e){var b=e.target.closest(".c3t-chip");if(!b)return;var k=b.getAttribute("data-k"),p=b.getAttribute("aria-pressed")!=="true";if(p&&B.indexOf(k)>=0)B.forEach(function(x){var o=cs.querySelector('[data-k="'+x+'"]');if(o)o.setAttribute("aria-pressed","false")});b.setAttribute("aria-pressed",p?"true":"false");run()});})();</script></div></section><section style="background:var(--ivory)" id="loris"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Loris">1. Loris: the most land for the money</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Around Loris, a big yard is normal. More than 4 in 10 house lots are an acre or more, and the usual lot is about 0.8 acre. Near the beach, lots are closer to a sixth of an acre.</p><div class="c3t-pic" style="grid-row:2/span 2"><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/buyers-relocating-which-town/loris-houses-on-big-lots-from-above-1200w.webp" srcset="/images/2026-11-a/buyers-relocating-which-town/loris-houses-on-big-lots-from-above-600w.webp 600w, /images/2026-11-a/buyers-relocating-which-town/loris-houses-on-big-lots-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Aerial photo of houses and manufactured homes on wide grassy lots along two country roads outside Loris, with sheds, plowed farm fields and pine woods" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo, 2023. License: Public domain" title="License: Public domain">U.S. government aerial photo, 2023</a></span></div><figcaption>Outside Loris: houses on wide lots along two country roads, with sheds, gardens and farm fields across the road.</figcaption></figure></div></div><div class="c3t-rest"><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">More houses for sale here list parking for an RV or a boat than in any other place on this page. Most list no HOA fee. McLeod Health Loris is the nearest hospital for almost every house.</p><div class="c3t-money"><p>Houses around Loris sold for about $280,000, half for more and half for less. A house here also costs the least of any place on this page to keep each year. Our list of the <a href="/buyers/affordable-places-to-live/" style="color:var(--navy);text-decoration:underline">most affordable places near Myrtle Beach</a> goes street by street.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Loris">Send me houses in Loris<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></div></div></section><section style="background:var(--ivory-2)" id="aynor"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Aynor">2. Aynor: an acre is the usual lot</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Around Aynor, the usual house has about an acre of land, and more than half of house lots are an acre or more. Farm fields start at the edge of the town's grid of streets.</p><div class="c3t-pic" style="grid-row:2/span 2"><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/buyers-relocating-which-town/aynor-town-and-fields-from-above-1200w.webp" srcset="/images/2026-11-a/buyers-relocating-which-town/aynor-town-and-fields-from-above-600w.webp 600w, /images/2026-11-a/buyers-relocating-which-town/aynor-town-and-fields-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Aerial photo of Aynor with houses on large grassy lots along a grid of streets on the right, a highway in the middle and plowed farm fields and woods on the left" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo, 2023. License: Public domain" title="License: Public domain">U.S. government aerial photo, 2023</a></span></div><figcaption>Aynor from above: houses on big lots along the town's grid of streets, and farm fields and woods across the highway.</figcaption></figure></div></div><div class="c3t-rest"><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">State law names the third Saturday in September "Aynor Harvest Hoe-Down Festival Weekend". The Pilot Club of Aynor started the festival in 1979.</p><ul class="c3t-facts" role="list"><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11a9 7.5 0 0 1 18 0q-2.25-1.5-4.5 0t-4.5 0-4.5 0-4.5 0zM12 11v8M2.5 21.5c3-1.4 6.3-1.4 9.5 0s6.5 1.4 9.5 0"/></svg></span><span>The trade-off is distance. Aynor is the farthest of these places from the beach, and from a hospital.</span></li></ul><div class="c3t-money"><p>Expect about $350,000 for a house around Aynor, the middle of the past year's sales.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Aynor">Send me houses in Aynor<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></div></div></section><section style="background:var(--ivory)" id="longs"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Longs">3. Longs: where builders are selling</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Longs is where builders are selling at the north end. About half the houses sold here in the past year were new, and about half the houses for sale now are new too.</p><div class="c3t-pic" style="grid-row:2/span 2"><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/buyers-relocating-which-town/longs-new-subdivision-from-above-1200w.webp" srcset="/images/2026-11-a/buyers-relocating-which-town/longs-new-subdivision-from-above-600w.webp 600w, /images/2026-11-a/buyers-relocating-which-town/longs-new-subdivision-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Aerial photo of a new subdivision in Longs with streets and ponds cut into bare ground, a few rows of new houses, empty lots, and farm fields and woods around it" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo, 2023. License: Public domain" title="License: Public domain">U.S. government aerial photo, 2023</a></span></div><figcaption>A new subdivision going up beside farm fields in Longs: streets and ponds dug, some houses built or framed, and most lots still empty.</figcaption></figure></div></div><div class="c3t-rest"><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For houses for sale with a Longs address, a new house asks about the same price per square foot as one built three to ten years ago.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A Longs mailing address can be inside North Myrtle Beach. Two of the county's ten busiest new communities, Grande Dunes North and Waterside, have Longs addresses but sit inside the city. This page's Longs is the part outside the city.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our clients from North Carolina bought land in Longs and had a new house built on it.</p><div class="c3t-money"><p>In Longs, about $300,000 bought a typical house in the past year. The usual HOA fee is about $100 a month.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Longs">Send me houses in Longs<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></div></div></section><section style="background:var(--ivory-2)" id="little-river"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Little River">4. Little River: old gardens on the waterway, and boat slips</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="/submarkets/little-river/" style="color:var(--navy);text-decoration:underline">Little River</a> has a county park on the Intracoastal Waterway: Vereen Memorial Historical Gardens, more than 115 acres of forest and marsh with trails and boardwalks. A piece of the original Kings Highway, the colonial road between Boston and Charleston, is still at the front of the park.</p><div class="c3t-pic" style="grid-row:2/span 2"><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/submarkets-little-river/little-river-harbours-from-above-1200w.webp" srcset="/images/2026-11-a/submarkets-little-river/little-river-harbours-from-above-600w.webp 600w, /images/2026-11-a/submarkets-little-river/little-river-harbours-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="A marina basin full of boats off the Intracoastal Waterway, from above, with Coquina Harbour labelled at its upper end, Lightkeepers Village near its mouth, US 17 at the top left and a golf course at the upper right" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo, 2023. License: Public domain" title="License: Public domain">U.S. government aerial photo, 2023</a></span></div><figcaption>Two of Little River's marinas share one basin off the Intracoastal Waterway, with slips sold with their own deed.</figcaption></figure></div></div><div class="c3t-rest"><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Boats are the other draw. About 2 in 3 of the county's boat slips sold with their own deed and tax bill are here.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Little River is not a town, so the county makes the rules. There is no city tax, and trash goes to a private hauler or a county drop-off center.</p><div class="c3t-money"><p>Half the houses here sold for more than $380,000, and half for less. Nearly every sale was a resale, not a new house.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Little%20River">Send me houses in Little River<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></div></div></section><section style="background:var(--ivory)" id="conway"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Conway">5. Conway: a river city with its own services</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="/submarkets/conway/" style="color:var(--navy);text-decoration:underline">Conway</a> was laid out in 1732, as Kingston. Its older streets of houses under live oaks run down to the Waccamaw River.</p><div class="c3t-pic" style="grid-row:2/span 2"><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/buyers/no-hoa/conway-older-house-and-oak-1200w.webp" srcset="/images/buyers/no-hoa/conway-older-house-and-oak-600w.webp 600w, /images/buyers/no-hoa/conway-older-house-and-oak-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="An older white wood house with black shutters behind a large oak tree, with a paved driveway, a low brick planter and thick shrubs, on a shaded street in Conway" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/publicdomain/mark/1.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: Pubdog. License: Public domain" title="License: Public domain">Photo: Pubdog</a></span></div><figcaption>An older house under a live oak, a few blocks from Main Street in Conway.</figcaption></figure></div></div><div class="c3t-rest"><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Riverwalk is a path along the river with benches and a kayak launch. Riverfront Park beside it has a public boat landing with floating docks. Conway is a city, so it picks up trash at the curb.</p><ul class="c3t-facts" role="list"><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h8l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v4h4M9 17l6-6"/><circle cx="9.5" cy="11.5" r="1"/><circle cx="14.5" cy="16.5" r="1"/></svg></span><span>The city tax is high: about $654 a year on each $100,000 of value, against about $368 outside the towns.</span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 11.5 12 4.5l8 7M6.5 10v4.5M17.5 10v4.5M2 17c1.7 1.2 3.3 1.2 5 0s3.3-1.2 5 0 3.3 1.2 5 0 3.3-1.2 5 0M2 20.5c1.7 1.2 3.3 1.2 5 0s3.3-1.2 5 0 3.3 1.2 5 0 3.3-1.2 5 0"/></svg></span><span>The river reached major flood stage 6 times from 2015 through 2025. The first streets to flood are low ones near Crabtree Swamp, such as Long Avenue and Sherwood Drive. About 95 in 100 homes in the city are outside both FEMA's high-risk zone and the land Florence's water reached.</span></li></ul><div class="c3t-money"><p>At about $271,000, a typical house in Conway sold for the least of any place here.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Conway">Send me houses in Conway<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></div><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Want land, a newer house or a lower tax bill?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us which matters most. We plan a day of showings in two of these inland towns, so you see both before you choose.</p><a class="btn btn-brass" href="/contact/">Have us plan a showing day</a></div></div></section><section style="background:var(--ivory-2)" id="north-myrtle-beach"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="North Myrtle Beach">6. North Myrtle Beach: most houses for sale near the sand</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About 3 in 4 houses for sale in <a href="/submarkets/north-myrtle-beach/" style="color:var(--navy);text-decoration:underline">North Myrtle Beach</a> are within a mile of the beach. Ocean Drive has Main Street, McLean Park with its lake, and the Ingram Dunes Nature Preserve, which the city calls its last maritime forest.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The state Senate calls North Myrtle Beach the home of the shag, South Carolina's state dance. At Cherry Grove, at the north end, about 680 houses sit on dug channels and the marsh edge. The city's boat ramp there reaches the ocean through Hog Inlet.</p><div class="c3t-pic" style="grid-row:2/span 3"><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/submarkets-north-myrtle-beach/cherry-grove-channels-from-above-1200w.webp" srcset="/images/2026-11-a/submarkets-north-myrtle-beach/cherry-grove-channels-from-above-600w.webp 600w, /images/2026-11-a/submarkets-north-myrtle-beach/cherry-grove-channels-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="857" alt="Cherry Grove from above: rows of houses on narrow lots between dug channels, with docks behind them, the marsh beyond, and the ocean along the bottom, labelled Boat ramp, Heritage Shores, Channel houses and Atlantic Ocean" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo, 2023. License: Public domain" title="License: Public domain">U.S. government aerial photo, 2023</a></span></div><figcaption>Houses on the dug channels at Cherry Grove, at the north end of North Myrtle Beach, from above.</figcaption></figure></div></div><div class="c3t-rest"><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our clients from New York bought beachfront here near the waterway, so they could finally use their boat.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On the county's tax rolls, about half the houses here are someone's main home. The rest are taxed as second homes or rentals.</p><div class="c3t-money"><p>Count on about $565,000 for a typical house. About half the houses for sale list no HOA fee.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=North%20Myrtle%20Beach">Send me houses in North Myrtle Beach<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></div></div></section><section style="background:var(--ivory)" id="carolina-forest"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Carolina Forest">7. Carolina Forest: the newest homes, almost no flood zone</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Half the homes in <a href="/submarkets/carolina-forest/" style="color:var(--navy);text-decoration:underline">Carolina Forest</a> were built in 2007 or later, the newest of any place here. Under 1 percent of its houses are in FEMA's high-risk flood zone.</p><div class="c3t-pic" style="grid-row:2/span 2"><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/buyers-relocating-which-town/carolina-forest-houses-and-woods-from-above-1200w.webp" srcset="/images/2026-11-a/buyers-relocating-which-town/carolina-forest-houses-and-woods-from-above-600w.webp 600w, /images/2026-11-a/buyers-relocating-which-town/carolina-forest-houses-and-woods-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Aerial photo of a subdivision of houses on cul-de-sac streets in Carolina Forest, with ponds, thick woods around it and cleared land on the right" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo, 2023. License: Public domain" title="License: Public domain">U.S. government aerial photo, 2023</a></span></div><figcaption>Houses on streets that end in cul-de-sacs in Carolina Forest, with woods around them and land being cleared for more on the right.</figcaption></figure></div></div><div class="c3t-rest"><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">It is a large planned area of neighborhoods outside the city limits, with a Myrtle Beach address. McLeod Health cut the ribbon on a new hospital here in August 2026. The county's Bike and Run Park, on the waterway, has miles of mountain bike and hiking trails.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Nearly every house for sale in the Carolina Forest ZIP code lists an HOA fee, about $125 a month in a typical listing. Almost none of the houses for sale here are listed as open to nightly rentals.</p><div class="c3t-money"><p>The middle sale here in the past year was about $440,000.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Carolina%20Forest">Send me houses in Carolina Forest<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></div></div></section><section style="background:var(--ivory-2)" id="myrtle-beach"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Myrtle Beach">8. Myrtle Beach: the shortest drive to everything</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">From a typical house in <a href="/submarkets/myrtle-beach/" style="color:var(--navy);text-decoration:underline">Myrtle Beach</a>, the beach, the airport and Coastal Grand Mall are each about 15 minutes or less by car. Pine Lakes Country Club, which opened in 1927, was the city's first golf course.</p><div class="c3t-pic" style="grid-row:2/span 2"><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/buyers/best-neighborhoods/market-common-valor-park-1200w.webp" srcset="/images/buyers/best-neighborhoods/market-common-valor-park-600w.webp 600w, /images/buyers/best-neighborhoods/market-common-valor-park-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="The Market Common from the air: streets of homes outlined in orange beside a lake, a dot labelled Valor Park at the edge of the shops, and ball fields and a lake labelled Grand Park" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.govinfo.gov/content/pkg/USCODE-2023-title17/html/USCODE-2023-title17-chap1-sec105.htm" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo, 2026. License: Public domain" title="License: Public domain">U.S. government aerial photo, 2026</a></span></div><figcaption>The Market Common from the air: its homes, outlined, Valor Park and Grand Park beside the shops.</figcaption></figure></div></div><div class="c3t-rest"><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Market Common is a town center with shops, restaurants and a movie theater, and apartments above the stores. Grand Park and Valor Park are next to the shops, with a lake and a path around it, sports fields and a playground.</p><ul class="c3t-facts" role="list"><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 21h18M5 21V9.5l5-3V21M10 21V4h9v17M13 8h3M13 12h3M13 16h3M7.5 13h.01M7.5 16.5h.01"/></svg></span><span>A city resident's parking decal costs nothing, and it covers parking at the city's meters and pay stations.</span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span>Nearly every house in the city is outside the zones that allow rentals under 90 days.</span></li></ul><div class="c3t-money"><p>Half the houses in the city sold for more than $535,000, and half for less.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Myrtle%20Beach">Send me houses in Myrtle Beach<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></div><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Is the house you like inside the city?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the address. We tell you which side of the city line it is on, and what that changes: the tax, the trash pickup, the parking decal and the rental rule.</p><a class="btn btn-brass" href="/contact/">Ask us about an address</a></div></div></section><section style="background:var(--ivory)" id="socastee"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Socastee">9. Socastee: a historic village on the waterway</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Socastee began in the late 1800s as a lumber and turpentine camp. Its old swing bridge, built in the mid-1930s, carries Dick Pond Road over the Intracoastal Waterway. The bridge, two houses, a store and a pecan grove make up a historic district on the National Register.</p><div class="c3t-pic" style="grid-row:2/span 2"><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/buyers-relocating-which-town/socastee-swing-bridge-from-above-1200w.webp" srcset="/images/2026-11-a/buyers-relocating-which-town/socastee-swing-bridge-from-above-600w.webp 600w, /images/2026-11-a/buyers-relocating-which-town/socastee-swing-bridge-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Aerial photo of a blue steel truss swing bridge carrying a two-lane road over the Intracoastal Waterway at Socastee, with a newer four-lane bridge at the lower left and houses at the upper left" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo, 2023. License: Public domain" title="License: Public domain">U.S. government aerial photo, 2023</a></span></div><figcaption>The old Socastee swing bridge, the blue steel span, on the Intracoastal Waterway, with the newer highway bridge at the lower left.</figcaption></figure></div></div><div class="c3t-rest"><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A house here costs about what it does in Longs, but Socastee is much closer to the beach and the airport. The beach, the airport and Coastal Grand Mall are each about 15 minutes or less from a typical house.</p><ul class="c3t-facts" role="list"><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 11.5 12 4.5l8 7M6.5 10v4.5M17.5 10v4.5M2 17c1.7 1.2 3.3 1.2 5 0s3.3-1.2 5 0 3.3 1.2 5 0 3.3-1.2 5 0M2 20.5c1.7 1.2 3.3 1.2 5 0s3.3-1.2 5 0 3.3 1.2 5 0 3.3-1.2 5 0"/></svg></span><span>About 1 in 9 houses here are in FEMA's high-risk flood zone, more than twice the share in Conway or Myrtle Beach. We check the zone for each house.</span></li></ul><div class="c3t-money"><p>That is about $300,000 for a typical house in Socastee.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Socastee">Send me houses in Socastee<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></div></div></section><section style="background:var(--ivory-2)" id="surfside-beach"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Surfside Beach">10. Surfside Beach: the sand at the end of the street</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In <a href="/submarkets/surfside-beach/" style="color:var(--navy);text-decoration:underline">Surfside Beach</a>, a typical house is about 3 minutes by car from the sand, the closest of any place here. Every home in the town is less than a mile from Ocean Boulevard, the beach road.</p><div class="c3t-pic" style="grid-row:2/span 2"><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/submarkets-surfside-beach/surfside-beach-pier-from-above-2026-1200w.webp" srcset="/images/2026-11-a/submarkets-surfside-beach/surfside-beach-pier-from-above-2026-600w.webp 600w, /images/2026-11-a/submarkets-surfside-beach/surfside-beach-pier-from-above-2026-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Aerial photo of the Surfside Beach Pier, labelled, running from a wide beach into a green ocean, with parking lots and rows of beach houses behind the sand" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.govinfo.gov/content/pkg/USCODE-2023-title17/html/USCODE-2023-title17-chap1-sec105.htm" target="_blank" rel="noopener noreferrer" aria-label="Photo: NOAA National Geodetic Survey. License: Public domain" title="License: Public domain">Photo: NOAA National Geodetic Survey</a></span></div><figcaption>The Surfside Beach pier from the air, with the beach parking lots and the streets of beach houses behind it.</figcaption></figure></div></div><div class="c3t-rest"><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The town's new concrete pier opened in 2024. Walking on it is free, and it has two restaurants, an ice cream shop and a bait shop.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Fewer than half the houses here are taxed as someone's main home. Along the ocean, only about 1 in 8 homes is. On many inland streets, about 7 in 10 are.</p><ul class="c3t-facts" role="list"><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 11.5 12 4.5l8 7M6.5 10v4.5M17.5 10v4.5M2 17c1.7 1.2 3.3 1.2 5 0s3.3-1.2 5 0 3.3 1.2 5 0 3.3-1.2 5 0M2 20.5c1.7 1.2 3.3 1.2 5 0s3.3-1.2 5 0 3.3 1.2 5 0 3.3-1.2 5 0"/></svg></span><span>About 3 in 10 houses here are inside FEMA's high-risk flood zone, so we check each one.</span></li></ul><div class="c3t-money"><p>At about $705,000, a typical house here sold for the most of any place on this page.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Surfside%20Beach">Send me houses in Surfside Beach<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></div><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Found a house near the beach?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the house. We check its flood zone and what a flood policy costs there before you make an offer.</p><a class="btn btn-brass" href="/contact/">Have us check the flood zone</a></div></div></section><section style="background:var(--ivory)" id="garden-city"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Garden City">11. Garden City: between the ocean and the marsh</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="/submarkets/garden-city/" style="color:var(--navy);text-decoration:underline">Garden City</a> is a strip of beach houses between the ocean and the salt marsh. Its pier is 668 feet long, with bands every night at both ends, weather permitting. A pier pass covers fishing, with no state fishing license needed on the pier.</p><div class="c3t-pic" style="grid-row:2/span 2"><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/buyers/no-hoa/garden-city-beach-and-marsh-from-the-ocean-2011-1200w.webp" srcset="/images/buyers/no-hoa/garden-city-beach-and-marsh-from-the-ocean-2011-600w.webp 600w, /images/buyers/no-hoa/garden-city-beach-and-marsh-from-the-ocean-2011-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="782" alt="Beach houses in rows between the ocean beach and a wide marsh with tidal creeks and boat docks at Garden City Beach, seen from a plane over the ocean" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: U.S. Geological Survey. License: Public domain" title="License: Public domain">Photo: U.S. Geological Survey</a></span></div><figcaption>Beach houses at Garden City, seen from over the ocean, with the salt marsh and its creeks behind them.</figcaption></figure></div></div><div class="c3t-rest"><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">From November through February, the county lets golf carts drive on its beach here, with a state permit and a licensed driver.</p><div class="c3t-money"><p>Houses in Garden City sold for about $406,000 at the middle, about $300,000 less than in Surfside Beach, the next place north.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Garden%20City">Send me houses in Garden City<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></div></div></section><section style="background:var(--ivory-2)" id="murrells-inlet"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Murrells Inlet">12. Murrells Inlet: the creek and the closest hospital</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The <a href="/submarkets/murrells-inlet/" style="color:var(--navy);text-decoration:underline">Murrells Inlet</a> on this page is the part in Georgetown County, south of the county line. Houses on the creek side of Business 17 have docks over the marsh.</p><div class="c3t-pic" style="grid-row:2/span 2"><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/submarkets-murrells-inlet/murrells-inlet-creek-front-docks-from-above-1200w.webp" srcset="/images/2026-11-a/submarkets-murrells-inlet/murrells-inlet-creek-front-docks-from-above-600w.webp 600w, /images/2026-11-a/submarkets-murrells-inlet/murrells-inlet-creek-front-docks-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Aerial photo of creek-front houses in Murrells Inlet, labelled: Business 17 at the left, houses under live oaks, and wooden docks running from the yards out to the tidal creek, with salt marsh islands beyond" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo, 2023. License: Public domain" title="License: Public domain">U.S. government aerial photo, 2023</a></span></div><figcaption>Houses on the creek side of Business 17 in Murrells Inlet, with docks reaching out over the marsh edge to the creek.</figcaption></figure></div></div><div class="c3t-rest"><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The MarshWalk is a half-mile wooden boardwalk along the marsh, with restaurants and free live music. A hospital is about 6 minutes from a typical house, the closest of any place here.</p><ul class="c3t-facts" role="list"><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h8l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v4h4M9 17l6-6"/><circle cx="9.5" cy="11.5" r="1"/><circle cx="14.5" cy="16.5" r="1"/></svg></span><span>Sales tax here is 7 percent, against 8 percent in Horry County.</span></li></ul><div class="c3t-money"><p>The middle sale here was about $610,000. A house here also costs the most of any place on this page to keep each year.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Murrells%20Inlet">Send me houses in Murrells Inlet<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></div></div></section><section style="background:var(--ivory)" id="pawleys-litchfield"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Pawleys Island">13. Pawleys Island and Litchfield: an island town where houses rarely sell</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Town of <a href="/submarkets/pawleys-island/" style="color:var(--navy);text-decoration:underline">Pawleys Island</a> is the island itself, a town of its own since 1985. The mainland around it with a Pawleys Island address is county land, and so is Litchfield.</p><div class="c3t-pic" style="grid-row:2/span 2"><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/buyers-relocating-which-town/pawleys-island-north-end-1200w.webp" srcset="/images/2026-11-a/buyers-relocating-which-town/pawleys-island-north-end-600w.webp 600w, /images/2026-11-a/buyers-relocating-which-town/pawleys-island-north-end-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="A wide beach at low tide with a row of raised houses along the dunes and an inlet beyond" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: Phoebe. License: CC BY-SA 4.0" title="License: CC BY-SA 4.0">Photo: Phoebe</a></span></div><figcaption>The north end of Pawleys Island at low tide: houses along the dune line, and the inlet at right.</figcaption></figure></div></div><div class="c3t-rest"><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The island has about 480 houses, and they rarely sell: only 10 changed hands at a market price in the past year. Every island house but one is in FEMA's high-risk flood zone. Across the whole area, about a third of houses are, the highest share on this page.</p><div class="c3t-money"><p>Across the island, the mainland and Litchfield, the middle sale was about $650,000, and nearly all of those sales were off the island. On the island itself, the middle sale over the last three years was about $2.45 million.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Pawleys%20Island">Send me houses in Pawleys Island<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></div></div></section><section style="background:var(--ivory-2)" id="compare"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Compare">How do the towns compare on price and the cost to keep a house?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The chart puts what a typical house sold for beside what it costs each year, besides the mortgage. The next section shows where that yearly cost comes from.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}@media (max-width:699px){main#main .c3-gchart.c3-gchart-list [role=row]{grid-template-columns:minmax(0,1fr) auto;column-gap:.8rem;align-items:start}main#main .c3-gchart.c3-gchart-list .b{display:none}main#main .c3-gchart.c3-gchart-list .dot{display:none}main#main .c3-gchart.c3-gchart-list .f{display:block}main#main .c3-gchart.c3-gchart-list [role=cell]{justify-content:flex-end}}</style><figure class="c3-gchart c3-gchart-compact c3-gchart-list"><div role="table" aria-label="A typical house: what it sold for, and what it costs each year besides the mortgage"><span class="cap" aria-hidden="true">A typical house: what it sold for, and what it costs each year besides the mortgage</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Place, each year, besides the mortgage</span><span role="columnheader">typical sale price</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">10. Surfside Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about $8,300 a year</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">$705,000</span></span></div><div role="row"><span role="rowheader"><span class="n">13. Pawleys Island</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about $9,500 a year</span></span><span role="cell"><span class="b" style="--f:0.922" aria-hidden="true"></span><span class="v">$650,000</span></span></div><div role="row"><span role="rowheader"><span class="n">12. Murrells Inlet</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about $9,700 a year</span></span><span role="cell"><span class="b" style="--f:0.865" aria-hidden="true"></span><span class="v">$610,000</span></span></div><div role="row"><span role="rowheader"><span class="n">6. North Myrtle Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about $7,800 a year</span></span><span role="cell"><span class="b" style="--f:0.801" aria-hidden="true"></span><span class="v">$565,000</span></span></div><div role="row"><span role="rowheader"><span class="n">8. Myrtle Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about $8,600 a year</span></span><span role="cell"><span class="b" style="--f:0.759" aria-hidden="true"></span><span class="v">$535,000</span></span></div><div role="row"><span role="rowheader"><span class="n">7. Carolina Forest</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about $8,500 a year</span></span><span role="cell"><span class="b" style="--f:0.624" aria-hidden="true"></span><span class="v">$440,000</span></span></div><div role="row"><span role="rowheader"><span class="n">11. Garden City</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about $8,200 a year</span></span><span role="cell"><span class="b" style="--f:0.575" aria-hidden="true"></span><span class="v">$406,000</span></span></div><div role="row"><span role="rowheader"><span class="n">4. Little River</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about $8,000 a year</span></span><span role="cell"><span class="b" style="--f:0.539" aria-hidden="true"></span><span class="v">$380,000</span></span></div><div role="row"><span role="rowheader"><span class="n">2. Aynor</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about $6,600 a year</span></span><span role="cell"><span class="b" style="--f:0.493" aria-hidden="true"></span><span class="v">$350,000</span></span></div><div role="row"><span role="rowheader"><span class="n">3. Longs</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about $7,700 a year</span></span><span role="cell"><span class="b" style="--f:0.425" aria-hidden="true"></span><span class="v">$300,000</span></span></div><div role="row"><span role="rowheader"><span class="n">9. Socastee</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about $7,700 a year</span></span><span role="cell"><span class="b" style="--f:0.425" aria-hidden="true"></span><span class="v">$300,000</span></span></div><div role="row"><span role="rowheader"><span class="n">1. Loris</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about $6,400 a year</span></span><span role="cell"><span class="b" style="--f:0.397" aria-hidden="true"></span><span class="v">$280,000</span></span></div><div role="row"><span role="rowheader"><span class="n">5. Conway</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about $7,900 a year</span></span><span role="cell"><span class="b" style="--f:0.384" aria-hidden="true"></span><span class="v">$271,000</span></span></div></div></div><figcaption>Detached houses, not condos or townhouses, sold in the year to September 2026. The cost each year is for a house you live in, outside the flood zone: the tax, the county fee, insurance, the HOA fee and upkeep.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The table adds the drives and the flood zone. The lot sizes are in the entries for Loris and Aynor. Drive minutes are with no traffic; summer traffic on US 17 adds time.</p><style>.c3-cc{margin:1.4rem 0 1.8rem;max-width:960px}.c3-cc table{width:100%;border-collapse:collapse;font-size:var(--read,1.0625rem);line-height:1.45;color:var(--muted)}.c3-cc caption{caption-side:top;text-align:left;color:var(--navy);font-weight:600;font-size:1em;line-height:1.4;padding:0 0 .7rem}.c3-cc th,.c3-cc td{padding:.6rem .7rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule);overflow-wrap:break-word}.c3-cc thead th{color:var(--navy);font-weight:600;font-size:1em;border-bottom:2px solid var(--navy);vertical-align:bottom}.c3-cc tbody th{color:var(--navy);font-weight:600}.c3-cc .n{text-align:right;font-variant-numeric:tabular-nums}.c3-cc .i{display:inline-flex;vertical-align:-4px;margin-right:.45rem;color:var(--brass-ink)}.c3-cc tr.c3-self>*{background:#fff}@media (max-width:49.999em){.c3-cc table,.c3-cc tbody,.c3-cc tr,.c3-cc th,.c3-cc td{display:block;width:auto}.c3-cc caption{display:block}.c3-cc thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.c3-cc tbody tr{background:var(--ivory-2);border-top:3px solid var(--brass);margin:0 0 .8rem;padding:.5rem 0 .6rem}section[style*="background:var(--ivory-2)"] .c3-cc tbody tr{background:var(--ivory)}.c3-cc tr.c3-self{background:#fff!important;border:2px solid var(--brass)}.c3-cc tr.c3-self>*{background:transparent}.c3-cc th,.c3-cc td{border:0;padding:.2rem 1rem}.c3-cc tbody th{display:flex;align-items:center;font-size:1.1em;padding-bottom:.35rem}.c3-cc tbody th .i{flex:none;vertical-align:0}.c3-cc tbody th a{display:inline-block;padding:.5rem 0}.c3-cc .n{text-align:left}.c3-cc td[data-label]::before{content:attr(data-label) ": ";color:var(--navy);font-weight:500}}</style><div class="c3-cc"><table><caption>The 13 places side by side: minutes by car from a typical house, and the share of houses in FEMA's high-risk flood zone</caption><thead><tr><th scope="col">Place</th><th scope="col" class="n">To the beach</th><th scope="col" class="n">To the airport</th><th scope="col" class="n">To a hospital</th><th scope="col" class="n">In a flood zone</th></tr></thead><tbody><tr><th scope="row">1. Loris</th><td class="n" data-label="To the beach">35 min</td><td class="n" data-label="To the airport">55 min</td><td class="n" data-label="To a hospital">11 min</td><td class="n" data-label="In a flood zone">1%</td></tr><tr><th scope="row">2. Aynor</th><td class="n" data-label="To the beach">45 min</td><td class="n" data-label="To the airport">45 min</td><td class="n" data-label="To a hospital">30 min</td><td class="n" data-label="In a flood zone">under 1%</td></tr><tr><th scope="row">3. Longs</th><td class="n" data-label="To the beach">20 min</td><td class="n" data-label="To the airport">45 min</td><td class="n" data-label="To a hospital">14 min</td><td class="n" data-label="In a flood zone">3%</td></tr><tr><th scope="row">4. Little River</th><td class="n" data-label="To the beach">14 min</td><td class="n" data-label="To the airport">45 min</td><td class="n" data-label="To a hospital">7 min</td><td class="n" data-label="In a flood zone">4%</td></tr><tr><th scope="row">5. Conway</th><td class="n" data-label="To the beach">30 min</td><td class="n" data-label="To the airport">30 min</td><td class="n" data-label="To a hospital">13 min</td><td class="n" data-label="In a flood zone">5%</td></tr><tr><th scope="row">6. North Myrtle Beach</th><td class="n" data-label="To the beach">6 min</td><td class="n" data-label="To the airport">35 min</td><td class="n" data-label="To a hospital">10 min</td><td class="n" data-label="In a flood zone">22%</td></tr><tr><th scope="row">7. Carolina Forest</th><td class="n" data-label="To the beach">20 min</td><td class="n" data-label="To the airport">20 min</td><td class="n" data-label="To a hospital">13 min</td><td class="n" data-label="In a flood zone">under 1%</td></tr><tr><th scope="row">8. Myrtle Beach</th><td class="n" data-label="To the beach">10 min</td><td class="n" data-label="To the airport">13 min</td><td class="n" data-label="To a hospital">12 min</td><td class="n" data-label="In a flood zone">5%</td></tr><tr><th scope="row">9. Socastee</th><td class="n" data-label="To the beach">13 min</td><td class="n" data-label="To the airport">14 min</td><td class="n" data-label="To a hospital">14 min</td><td class="n" data-label="In a flood zone">11%</td></tr><tr><th scope="row">10. Surfside Beach</th><td class="n" data-label="To the beach">3 min</td><td class="n" data-label="To the airport">15 min</td><td class="n" data-label="To a hospital">10 min</td><td class="n" data-label="In a flood zone">30%</td></tr><tr><th scope="row">11. Garden City</th><td class="n" data-label="To the beach">5 min</td><td class="n" data-label="To the airport">20 min</td><td class="n" data-label="To a hospital">7 min</td><td class="n" data-label="In a flood zone">31%</td></tr><tr><th scope="row">12. Murrells Inlet</th><td class="n" data-label="To the beach">10 min</td><td class="n" data-label="To the airport">25 min</td><td class="n" data-label="To a hospital">6 min</td><td class="n" data-label="In a flood zone">18%</td></tr><tr><th scope="row">13. Pawleys Island</th><td class="n" data-label="To the beach">7 min</td><td class="n" data-label="To the airport">40 min</td><td class="n" data-label="To a hospital">20 min</td><td class="n" data-label="In a flood zone">32%</td></tr></tbody></table></div><p class="c3t-note">A hospital here is the nearest of Grand Strand Medical Center, Conway Medical Center, McLeod Health Loris, McLeod Health Seacoast and Tidelands Waccamaw Community Hospital.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Narrowed it to two or three?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us which places and your budget. We send houses for sale in those places, with the flood zone, the tax and the HOA fee for each.</p><a class="btn btn-brass" href="/contact/">Send us your towns</a></div></div></section><section style="background:var(--ivory)" id="yearly-cost"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Yearly cost">What does a house cost to keep each year besides the mortgage?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For a typical house, about $6,400 to $9,700 a year, as your home and outside the flood zone. That spread is much smaller than the spread in price.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Take two places. A typical house in North Myrtle Beach sold for nearly twice what one in Longs did. Each year it costs only about $140 more to keep.</p><div class="c3t-ex"><div><h3>Longs</h3><p class="s">Typical house: about $300,000</p><dl><dt>Tax, as your home</dt><dd>$1,100</dd><dt>County fee</dt><dd>$89</dd><dt>Insurance</dt><dd>$2,000</dd><dt>HOA fee</dt><dd>$1,200</dd><dt>Upkeep</dt><dd>$3,300</dd><dt class="t">Total a year</dt><dd class="t">$7,700</dd></dl></div><div><h3>North Myrtle Beach</h3><p class="s">Typical house: about $565,000</p><dl><dt>Tax, as your home</dt><dd>$2,530</dd><dt>County fee</dt><dd>none</dd><dt>Insurance</dt><dd>$2,000</dd><dt>HOA fee</dt><dd>none</dd><dt>Upkeep</dt><dd>$3,300</dd><dt class="t">Total a year</dt><dd class="t">$7,800</dd></dl></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Two things keep the gap small:</p><ul class="c3t-facts" role="list"><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h8l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v4h4M9 17l6-6"/><circle cx="9.5" cy="11.5" r="1"/><circle cx="14.5" cy="16.5" r="1"/></svg></span><span>A home you live in is taxed on 4 percent of its value, not 6 percent, and most of the school tax comes off its bill.</span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span><span>North Myrtle Beach has a low city tax rate, and about half its houses for sale have no HOA fee.</span></li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Two things can widen it, and both matter most near the beach:</p><ul class="c3t-facts" role="list"><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 9.4c-.4-1-1.5-1.8-3-1.8-1.8 0-3 1-3 2.2 0 3 6 1.6 6 4.4 0 1.3-1.3 2.2-3 2.2-1.6 0-2.7-.7-3.1-1.8M12 5.8v1.8M12 16.4v1.8"/><circle cx="12" cy="12" r="9"/></svg></span><span>Insurance. The cards use about $2,000, the middle that Horry County owners pay for a house; half pay between about $1,300 and $3,000. East of US 17, or of Bypass 17 where it runs farther west, an insurer may leave wind and hail out. You can buy that cover separately.</span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 11.5 12 4.5l8 7M6.5 10v4.5M17.5 10v4.5M2 17c1.7 1.2 3.3 1.2 5 0s3.3-1.2 5 0 3.3 1.2 5 0 3.3-1.2 5 0M2 20.5c1.7 1.2 3.3 1.2 5 0s3.3-1.2 5 0 3.3 1.2 5 0 3.3-1.2 5 0"/></svg></span><span>Flood insurance. Among Horry County owners who carry a FEMA flood policy on the house they live in, the middle policy costs about $1,070 a year in the A zones. Those are FEMA's high-risk zones where big storm waves are not expected. Outside the high-risk zones it is about $550.</span></li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Near the beach, both can apply. A typical Surfside Beach house in the high-risk flood zone, with a $3,000 insurance bill, costs about $10,400 a year to keep instead of $8,300. If you buy with us, we get you an insurance quote for the address before you make an offer.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our <a href="/buyers/cost-to-own/" style="color:var(--navy);text-decoration:underline">cost to own</a> page breaks down every part.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Want the yearly cost of one house?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us a house you like. We work out its tax for that address, its HOA fee, its flood zone and the insurance quotes, so you know the year's cost before you offer.</p><a class="btn btn-brass" href="/contact/">Have us price a house's yearly cost</a></div></div></section><section style="background:var(--ivory-2)" id="city-or-county"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="City or county">What changes when a house is inside city limits?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The tax rate, the trash pickup, the sales tax and the rules for rentals and golf carts. Four of the 13 places are a city or town in full. Myrtle Beach, North Myrtle Beach and Conway are cities, and Surfside Beach is a town. The City of Loris, the Town of Aynor and the Town of Pawleys Island sit inside places that are mostly county land.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}@media (max-width:699px){main#main .c3-gchart.c3-gchart-list [role=row]{grid-template-columns:minmax(0,1fr) auto;column-gap:.8rem;align-items:start}main#main .c3-gchart.c3-gchart-list .b{display:none}main#main .c3-gchart.c3-gchart-list .dot{display:none}main#main .c3-gchart.c3-gchart-list .f{display:block}main#main .c3-gchart.c3-gchart-list [role=cell]{justify-content:flex-end}}</style><figure class="c3-gchart c3-gchart-compact c3-gchart-list"><div role="table" aria-label="Property tax a year on each $100,000 of value, on a home you live in"><span class="cap" aria-hidden="true">Property tax a year on each $100,000 of value, on a home you live in</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Where the house is, fee on the bill</span><span role="columnheader">tax a year</span></div></div><div role="rowgroup"><div role="row" class="ref"><span role="rowheader"><span class="n">Outside the towns, Horry County</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">plus a fee of about $89 on most bills</span></span><span role="cell"><span class="b" style="--f:0.531" aria-hidden="true"></span><span class="v">$368</span></span></div><div role="row"><span role="rowheader"><span class="n">Garden City</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">plus a fee of about $89 on most bills</span></span><span role="cell"><span class="b" style="--f:0.567" aria-hidden="true"></span><span class="v">$393</span></span></div><div role="row"><span role="rowheader"><span class="n">Myrtle Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">no county fee</span></span><span role="cell"><span class="b" style="--f:0.583" aria-hidden="true"></span><span class="v">$404</span></span></div><div role="row"><span role="rowheader"><span class="n">Surfside Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">plus an $82 fee</span></span><span role="cell"><span class="b" style="--f:0.607" aria-hidden="true"></span><span class="v">$420</span></span></div><div role="row"><span role="rowheader"><span class="n">North Myrtle Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">no county fee</span></span><span role="cell"><span class="b" style="--f:0.648" aria-hidden="true"></span><span class="v">$448</span></span></div><div role="row"><span role="rowheader"><span class="n">Pawleys Island and Litchfield</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">plus a $96 or $44 fee</span></span><span role="cell"><span class="b" style="--f:0.659" aria-hidden="true"></span><span class="v">$456</span></span></div><div role="row"><span role="rowheader"><span class="n">Murrells Inlet</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">plus a $96 fee</span></span><span role="cell"><span class="b" style="--f:0.745" aria-hidden="true"></span><span class="v">$516</span></span></div><div role="row"><span role="rowheader"><span class="n">Conway</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">no county fee</span></span><span role="cell"><span class="b" style="--f:0.944" aria-hidden="true"></span><span class="v">$654</span></span></div><div role="row"><span role="rowheader"><span class="n">City of Loris</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">no county fee</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">$692</span></span></div></div></div><figcaption>Horry County's tax rates and bills for 2026. Pawleys Island, Litchfield and Murrells Inlet: Georgetown County's current estimate. Before the tax break at 65, below the chart.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">At 65, after a year living in South Carolina, the first $50,000 of your home's value is not taxed. Outside the towns in Horry County, that saves about $180 a year; in Conway, about $330.</p><style>.c3-cc{margin:1.4rem 0 1.8rem;max-width:960px}.c3-cc table{width:100%;border-collapse:collapse;font-size:var(--read,1.0625rem);line-height:1.45;color:var(--muted)}.c3-cc caption{caption-side:top;text-align:left;color:var(--navy);font-weight:600;font-size:1em;line-height:1.4;padding:0 0 .7rem}.c3-cc th,.c3-cc td{padding:.6rem .7rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule);overflow-wrap:break-word}.c3-cc thead th{color:var(--navy);font-weight:600;font-size:1em;border-bottom:2px solid var(--navy);vertical-align:bottom}.c3-cc tbody th{color:var(--navy);font-weight:600}.c3-cc .n{text-align:right;font-variant-numeric:tabular-nums}.c3-cc .i{display:inline-flex;vertical-align:-4px;margin-right:.45rem;color:var(--brass-ink)}.c3-cc tr.c3-self>*{background:#fff}@media (max-width:39.999em){.c3-cc table,.c3-cc tbody,.c3-cc tr,.c3-cc th,.c3-cc td{display:block;width:auto}.c3-cc caption{display:block}.c3-cc thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.c3-cc tbody tr{background:var(--ivory-2);border-top:3px solid var(--brass);margin:0 0 .8rem;padding:.5rem 0 .6rem}section[style*="background:var(--ivory-2)"] .c3-cc tbody tr{background:var(--ivory)}.c3-cc tr.c3-self{background:#fff!important;border:2px solid var(--brass)}.c3-cc tr.c3-self>*{background:transparent}.c3-cc th,.c3-cc td{border:0;padding:.2rem 1rem}.c3-cc tbody th{display:flex;align-items:center;font-size:1.1em;padding-bottom:.35rem}.c3-cc tbody th .i{flex:none;vertical-align:0}.c3-cc tbody th a{display:inline-block;padding:.5rem 0}.c3-cc .n{text-align:left}.c3-cc td[data-label]::before{content:attr(data-label) ": ";color:var(--navy);font-weight:500}}</style><div class="c3-cc"><table><caption>What changes at the city line</caption><thead><tr><th scope="col">What changes</th><th scope="col">Inside a city or town</th><th scope="col">Outside, in the county</th></tr></thead><tbody><tr><th scope="row">Trash and recycling</th><td data-label="Inside a city or town">The town's service, where it has one</td><td data-label="Outside, in the county">Horry: a hauler or drop-off center</td></tr><tr><th scope="row">Sales tax</th><td data-label="Inside a city or town">9% Myrtle Beach; 8% Horry; 7% Pawleys</td><td data-label="Outside, in the county">8% in Horry, 7% in Georgetown</td></tr><tr><th scope="row">Renting by the night</th><td data-label="Inside a city or town">Each town's own rule, below</td><td data-label="Outside, in the county">Horry: no limit. Georgetown: one zone</td></tr><tr><th scope="row">Golf cart hours and streets</th><td data-label="Inside a city or town">Each town can set its own</td><td data-label="Outside, in the county">The county's rules, or the state's</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Trash: Myrtle Beach, North Myrtle Beach and Conway pick it up at the curb, and Loris, Aynor and Surfside Beach offer service too. Renting by the night, place by place:</p><ul class="c3t-facts" role="list"><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span><b>Myrtle Beach:</b> most neighborhoods of houses are not zoned for rentals under 90 days.</span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span><b>North Myrtle Beach:</b> no special zoning or permit, beyond a yearly business license and the lodging taxes.</span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span><b>Surfside Beach:</b> stays under 30 days only in the zoning districts along the ocean.</span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span><b>Conway:</b> the code allows them in three downtown districts.</span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span><b>Outside the towns in Horry County:</b> zoning puts no limit on how long a home is rented.</span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span><b>Outside the towns in Georgetown County:</b> a tourist home only in the resort residential district, as a conditional use.</span></li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Outside the towns, the county's Solid Waste Authority does not collect trash at the curb. Only county residents who live outside the towns may use its 25 drop-off centers. Under state law, a golf cart needs a $5 permit decal and liability insurance, and may use only roads posted 35 mph or less.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A subdivision's recorded rules can bar nightly rentals even where zoning allows them. Our <a href="/invest/str-rules/" style="color:var(--navy);text-decoration:underline">rental rules</a> page has each town's rule in full.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Want the rules for one address?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the address. We check whether it is inside a city, and read the town's rules and the HOA's recorded rules for what you plan to do.</p><a class="btn btn-brass" href="/contact/">Ask us to check the rules</a></div></div></section><section style="background:var(--ivory)" id="questions-about-the-towns"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Questions about the towns</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is it better to live in Myrtle Beach or North Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A typical house costs about the same in both: $535,000 in Myrtle Beach and $565,000 in North Myrtle Beach. In North Myrtle Beach it is closer to the beach, but more often in the high-risk flood zone. Myrtle Beach is much closer to the airport, and most of its neighborhoods of houses are not zoned for nightly rentals.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does a Myrtle Beach address mean the house is in the city?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not always. Carolina Forest houses, and many in Socastee, have Myrtle Beach mailing addresses but are outside the city limits. They pay no city tax and get no city trash pickup. We check the city line for any address you send us.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Where near Myrtle Beach are most houses someone's home all year?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In most of these places, about 3 in 4 houses or more are the owner's main home, taxed at the 4 percent rate. In North Myrtle Beach about half are, and in Surfside Beach fewer than half. The rest are taxed at the 6 percent rate for second homes and rentals.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Which town near Myrtle Beach has the least crime?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Chapter3 does not rate any town on crime or describe who lives anywhere. Fair housing law bars agents from steering buyers toward or away from an area. We give you the record of the house itself: its flood zone, its tax and the rules for its address.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeDocType" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry deeds</a>, <a href="https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry parcels</a>, <a href="https://gis1.georgetowncountysc.org/portal/home/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Georgetown parcels</a>, <a href="https://msc.fema.gov/portal/home" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FEMA flood maps</a>, <a href="https://www.fema.gov/openfema-data-page/nfip-redacted-policies-v3" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FEMA policies</a>, <a href="https://www.horrycountysc.gov/media/kufln4qp/tax-levy-2026_2.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry 2026 levy</a>, <a href="https://www.gtcountysc.gov/385/Property-Tax-Calculator" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Georgetown tax</a>, <a href="https://data.census.gov/table/ACSDT5Y2024.B25035" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Census ACS</a>, <a href="https://dor.sc.gov/sites/dor/files/forms/ST500.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SCDOR ST-500</a>, <a href="https://www.solidwasteauthority.org/recyclingcenters.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Solid Waste Authority</a>, <a href="https://www.scstatehouse.gov/code/t56c002.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 56-2</a>, <a href="https://cityofmyrtlebeach.com/services/parking_meters/index.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Myrtle Beach parking</a>, <a href="https://projectportal.scdot.org/sc-historic-bridges/s-616-bridge-over-intercoastal-waterway-horry-county" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SCDOT bridge record</a>, <a href="https://www.horrycountysc.gov/departments/parksandrecreation/parks" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry parks</a>, <a href="https://www.scstatehouse.gov/code/t12c037.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-37</a>, <a href="https://www.scstatehouse.gov/code/t38c075.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 38-75</a>. Prices are recorded sales of detached houses, not values. Drive minutes: OpenStreetMap roads, from 60 houses drawn at random in each place. Listing shares: our feed, in aggregate.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Outside Loris: houses on wide lots along two country roads, with sheds, gardens and farm fields across the road. U.S. government aerial photo, 2023, by the USDA Farm Service Agency, <a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://imagery.nationalmap.gov/arcgis/rest/services/USGSNAIPImagery/ImageServer" target="_blank" rel="noopener noreferrer">The National Map (USGS)</a>.</div><div role="listitem">Aynor from above: houses on big lots along the town's grid of streets, and farm fields and woods across the highway. U.S. government aerial photo, 2023, by the USDA Farm Service Agency, <a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://imagery.nationalmap.gov/arcgis/rest/services/USGSNAIPImagery/ImageServer" target="_blank" rel="noopener noreferrer">The National Map (USGS)</a>.</div><div role="listitem">A new subdivision going up beside farm fields in Longs: streets and ponds dug, some houses built or framed, and most lots still empty. U.S. government aerial photo, 2023, by the USDA Farm Service Agency, <a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://imagery.nationalmap.gov/arcgis/rest/services/USGSNAIPImagery/ImageServer" target="_blank" rel="noopener noreferrer">The National Map (USGS)</a>.</div><div role="listitem">Two of Little River's marinas share one basin off the Intracoastal Waterway, with slips sold with their own deed. U.S. government aerial photo, 2023, by the USDA Farm Service Agency, <a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://planetarycomputer.microsoft.com/dataset/naip" target="_blank" rel="noopener noreferrer">Microsoft Planetary Computer</a>. Chapter3 Realty cut this view from the NAIP image, raised the contrast a little and added labels placed from county and Census coordinates.</div><div role="listitem">An older house under a live oak, a few blocks from Main Street in Conway. Photo: Pubdog, <a href="https://creativecommons.org/publicdomain/mark/1.0/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://commons.wikimedia.org/wiki/File:Conway_Residential_Historic_District_Jun_10.JPG" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>. Chapter3 Realty blurred the house number and resized the photo.</div><div role="listitem">Houses on the dug channels at Cherry Grove, at the north end of North Myrtle Beach, from above. U.S. government aerial photo, 2023, by the USDA Farm Service Agency, <a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://imagery.nationalmap.gov/arcgis/rest/services/USGSNAIPImagery/ImageServer" target="_blank" rel="noopener noreferrer">USGS The National Map</a>. Chapter3 Realty exported this view from the NAIP image service, raised the contrast a little and added labels placed from OpenStreetMap, Horry County and Census coordinates.</div><div role="listitem">Houses on streets that end in cul-de-sacs in Carolina Forest, with woods around them and land being cleared for more on the right. U.S. government aerial photo, 2023, by the USDA Farm Service Agency, <a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://imagery.nationalmap.gov/arcgis/rest/services/USGSNAIPImagery/ImageServer" target="_blank" rel="noopener noreferrer">The National Map (USGS)</a>.</div><div role="listitem">The Market Common from the air: its homes, outlined, Valor Park and Grand Park beside the shops. Photo: NOAA National Geodetic Survey, <a href="https://www.govinfo.gov/content/pkg/USCODE-2023-title17/html/USCODE-2023-title17-chap1-sec105.htm" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://noaa-eri-pds.s3.amazonaws.com/index.html#2026_Pre_Event/EC2601a_OB_N_RGB/" target="_blank" rel="noopener noreferrer">NOAA Emergency Response Imagery</a>. Chapter3 Realty cut this view from one NOAA aerial photo, resized it, adjusted the colors and added an outline and labels.</div><div role="listitem">The old Socastee swing bridge, the blue steel span, on the Intracoastal Waterway, with the newer highway bridge at the lower left. U.S. government aerial photo, 2023, by the USDA Farm Service Agency, <a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://imagery.nationalmap.gov/arcgis/rest/services/USGSNAIPImagery/ImageServer" target="_blank" rel="noopener noreferrer">The National Map (USGS)</a>.</div><div role="listitem">The Surfside Beach pier from the air, with the beach parking lots and the streets of beach houses behind it. Photo: NOAA National Geodetic Survey, <a href="https://www.govinfo.gov/content/pkg/USCODE-2023-title17/html/USCODE-2023-title17-chap1-se