ina"}}]}</script></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Ready to look at condos?</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">Tell us your price range and how you plan to rent. If you buy with us, an agent reads each building's rental rules, confirms the loan with the lender and gets you an insurance quote before you make an offer.</p><a class="btn btn-brass btn-lg" href="/contact/">Have us help buy your next unit</a></div></section></main>
+<main id="main"><div class="detail-hero bg-grid"><div class="wrap"><div class="breadcrumb"><a href="/">Home</a><span>/</span><a href="/invest/">Invest</a><span>/</span><span style="color:var(--muted)">Condo Investing</span></div><p class="eyebrow" style="margin-bottom:1rem">Condo investing</p><h1 class="detail-h1">Are Myrtle Beach condos a good investment?<br/><em style="font-style:italic;color:var(--brass)">What one earns and costs a year, how condos compare with houses, and how to pick the building.</em></h1><div class="detail-media" style="margin:0 0 1.2rem;max-width:760px"><style id="c3-glass">main#main{--g-ink:#8a5226;--g-ink-lg:#a8612c;--g-edge:rgba(255,255,255,.8);--g-hi:inset 0 1px 0 rgba(255,255,255,.95);--g-sh:0 1px 2px rgba(28,32,40,.05),0 14px 36px -20px rgba(28,32,40,.3);--g-r:20px;--g-blur:saturate(150%) blur(16px);background-color:#f8f4ee;background-image:radial-gradient(44rem 26rem at 4% 460px,rgba(232,201,154,.30),rgba(232,201,154,0) 70%),radial-gradient(40rem 26rem at 98% 1000px,rgba(196,120,58,.08),rgba(196,120,58,0) 70%),radial-gradient(46rem 26rem at 16% 1500px,rgba(232,201,154,.22),rgba(232,201,154,0) 70%),radial-gradient(40rem 24rem at 94% 1960px,rgba(42,48,64,.045),rgba(42,48,64,0) 70%);background-size:100% 2400px;background-repeat:repeat-y}main#main>section[style*="background:var(--ivory"],main#main .detail-hero{background:transparent!important}main#main .detail-hero{border-bottom:0}main#main .detail-hero.bg-grid{background-image:none}main#main>section[style*="background:var(--ivory"]+section[style*="background:var(--ivory"]{border-top:1px solid rgba(255,255,255,.7)}main#main>section[style*="background:var(--ivory"]{padding-bottom:2.25rem}main#main>section[style*="background:var(--ivory"]:not(.detail-hero+section){padding-top:2.25rem}@media (min-width:700px){main#main>section[style*="background:var(--ivory"]{padding-bottom:3.5rem}main#main>section[style*="background:var(--ivory"]:not(.detail-hero+section){padding-top:3.5rem}}main#main .eyeb