color:var(--muted);font-size:.85rem;line-height:1.45;margin-top:.5rem}@media (min-width:700px){.c3ph-gal{display:grid;grid-template-columns:repeat(var(--c3ph-n,3),minmax(0,1fr));gap:1rem;overflow:visible;padding:0}.c3ph-gal>figure{min-width:0}}@media (max-width:699px){.c3ph-gal.c3ph-row{display:flex;gap:.75rem;padding:0 var(--c3ph-bleed,1.4rem) .4rem;margin:1.6rem calc(-1*var(--c3ph-bleed,1.4rem)) 0;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding:0 var(--c3ph-bleed,1.4rem);-webkit-overflow-scrolling:touch;scrollbar-width:none}.c3ph-row::-webkit-scrollbar{display:none}.c3ph-row>figure{flex:0 0 82%;scroll-snap-align:start}}.c3ph-swipe{display:flex;align-items:center;gap:.75rem;margin:.5rem 0 1.6rem;color:var(--navy);font:500 .95rem/1.3 var(--sans)}.c3ph-dots{display:inline-flex;gap:.45rem}.c3ph-dots i{display:block;width:10px;height:10px;border-radius:50%;border:1.5px solid var(--navy);box-sizing:border-box}.c3ph-dots i:first-child{background:var(--navy)}@supports (animation-timeline:view()){.c3ph-rowbox{timeline-scope:--c3ph-p1,--c3ph-p2,--c3ph-p3}.c3ph-row>figure:nth-child(1){view-timeline:--c3ph-p1 inline}.c3ph-row>figure:nth-child(2){view-timeline:--c3ph-p2 inline}.c3ph-row>figure:nth-child(3){view-timeline:--c3ph-p3 inline}.c3ph-dots i{animation:c3ph-dot linear both;animation-range:cover}.c3ph-dots i:nth-child(1){animation-timeline:--c3ph-p1}.c3ph-dots i:nth-child(2){animation-timeline:--c3ph-p2}.c3ph-dots i:nth-child(3){animation-timeline:--c3ph-p3}@keyframes c3ph-dot{0%,36%{background:transparent}42%,60%{background:var(--navy)}66%,100%{background:transparent}}}@media (min-width:700px){.c3ph-swipe{display:none}}.c3ph-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:1.4rem 0 1.8rem;padding:0;list-style:none}@media (min-width:700px){.c3ph-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}}@media (min-width:1000px){.c3ph-cards.c3ph-4{grid-template-columns:repeat(4,minmax(0,1fr))}}.c3ph-card{margin:0;background:var(--ivory);border:1px solid var(--rule);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}.c3ph-card .c3ph-f{border-radius:0}.c3ph-card img,.c3ph-card svg{display:block;width:100%;height:auto;aspect-ratio:var(--c3ph-r,4/3);object-fit:cover}.c3ph-card .c3ph-cr{font-size:.56rem;padding:1.2rem .45rem .25rem 1.6rem}.c3ph-card strong{display:block;color:var(--navy);font-size:.98rem;font-weight:500;line-height:1.3;padding:.7rem .8rem 0}.c3ph-card span.c3ph-t{display:block;color:var(--muted);font-size:.86rem;line-height:1.45;padding:.2rem .8rem .85rem}.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:760px}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Alan Wilson won the governor's race in the <a href="https://scvotes.gov/2026-general-election-results/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">unofficial count</a>, 51.71% to 47.00%. Jermaine Johnson conceded on election night. The Associated Press had <a href="https://yourislandnews.com/alan-wilson-declares-victory-in-sc-governors-race-johnson-concedes/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">not called the race</a> when he did.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In an interview before the election, Wilson named the gap he wants to close:</p><blockquote class="rt-q"><p>"Owner-occupied homes are taxed at a much lower rate" while "second, third, and fourth homes, which are usually rental properties, are taxed at a higher rate."</p><p>"...looking at Act 388 and reforming how we assess property taxes on those types of properties."</p><p class="by">Alan Wilson, in a <a href="https://www.wistv.com/2026/10/28/full-interview-alan-wilson-shares-priorities-governor-ahead-election-day/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">full interview with WIS</a> before the election</p></blockquote><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">His affordability agenda, as <a href="https://www.foxcarolina.com/2026/10/15/republican-nominee-sc-governor-alan-wilson-announces-affordability-agenda/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Fox Carolina</a> and <a href="https://www.herecolumbia.com/2026/10/16/governor-candidate-alan-wilson-affordability-campaign-plan/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">HERE Columbia</a> reported it, lists "Reforming Act 388 to remove higher property taxes for rental properties". He has published no bill text, no new rate and no cost.</p><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-e/rental-property-tax-cut/myrtle-beach-oceanfront-rentals-1200w.webp" srcset="/images/2026-11-e/rental-property-tax-cut/myrtle-beach-oceanfront-rentals-600w.webp 600w, /images/2026-11-e/rental-property-tax-cut/myrtle-beach-oceanfront-rentals-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="600" alt="A row of high-rise towers with balconies along the beach in Myrtle Beach under a clear sky" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: Loadmaster. License: CC BY-SA 3.0" title="License: CC BY-SA 3.0">Photo: Loadmaster</a></span></div><figcaption>Oceanfront towers in Myrtle Beach. A unit in them that its owner rents out pays the 6% rate today.</figcaption></figure></div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">His other property tax plans</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The same agenda, as reported, also lists these:</p><ul style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem">Enroll seniors automatically in their property tax break for older owners.</li><li style="margin-bottom:.5rem">Expand the property tax break for disabled veterans.</li><li style="margin-bottom:.5rem">Lower personal property taxes for commercial businesses.</li><li style="margin-bottom:.5rem">Eliminate the state income tax and overhaul property taxes.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="https://wilsonforsc.com/priorities/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">His campaign site</a> adds a pledge to "eliminate the car property tax for seniors and veterans". Our <a href="/market-reports/2026-election/" style="color:var(--navy);text-decoration:underline">guide to the 2026 election</a> covers his other plans and the rest of the results. His plan for faster home permits is on <a href="/invest/horry-county-growth-roads-permits/" style="color:var(--navy);text-decoration:underline">our page on what the new leaders say about roads and growth</a>.</p></div></section><section style="background:var(--ivory)" id="the-tax-now"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The tax at 6% and at 4%">How much property tax does a Myrtle Beach rental pay now, and at 4%?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">At 4%, a Myrtle Beach rental would pay a third to three fifths less than it does at 6%. How much depends on whether a change also drops the school operating tax.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="At 4%, the $5,347 tax on a $350,000 Myrtle Beach rental falls to $3,564 or $2,037"><span class="cap" aria-hidden="true">At 4%, the $5,347 tax on a $350,000 Myrtle Beach rental falls to $3,564 or $2,037</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Tax rule</span><span role="columnheader">tax a year</span></div></div><div role="rowgroup"><div role="row" class="ref"><span role="rowheader"><span class="n">Today, at 6%</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">$5,347</span></span></div><div role="row"><span role="rowheader"><span class="n">At 4%, still paying the school tax</span></span><span role="cell"><span class="b" style="--f:0.667" aria-hidden="true"></span><span class="v">$3,564</span></span></div><div role="row"><span role="rowheader"><span class="n">At 4%, taxed like an owner's home</span></span><span role="cell"><span class="b" style="--f:0.381" aria-hidden="true"></span><span class="v">$2,037</span></span></div></div></div><figcaption>Horry County's 2026 tax rates, 254.6 mills inside the city: county, schools and city. Before credits, fees and any special district.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Two rules make the gap. The <a href="https://www.scstatehouse.gov/scconstitution/A10.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">state constitution</a> taxes a rental on 6% of its value and an owner's home on 4%. Since Act 388, an owner's home also pays no school operating tax. How the 4% and 6% rates work today is on our <a href="/buyers/property-taxes/" style="color:var(--navy);text-decoration:underline">Horry County property tax page</a>.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Wilson has not said which of the two he means, so the chart shows both. Our page on <a href="/buyers/act-388-changes/" style="color:var(--navy);text-decoration:underline">what Act 388 changes would mean</a> has the law's history.</p><div class="rt-tbl rt-stack"><div class="cap">The same $350,000 rental, a year, in two places</div><table><thead><tr><th scope="col">Where</th><th scope="col" class="num">Today, at 6%</th><th scope="col" class="num">At 4%, with the school tax</th><th scope="col" class="num">At 4%, like an owner's home</th></tr></thead><tbody><tr><th scope="row">Inside Myrtle Beach</th><td class="num" data-l="Today, at 6%"><b>$5,347</b></td><td class="num" data-l="At 4%, with the school tax"><b>$3,564</b></td><td class="num" data-l="At 4%, like an owner's home"><b>$2,037</b></td></tr><tr><th scope="row">Unincorporated Horry County</th><td class="num" data-l="Today, at 6%"><b>$4,051</b></td><td class="num" data-l="At 4%, with the school tax"><b>$2,701</b></td><td class="num" data-l="At 4%, like an owner's home"><b>$1,173</b></td></tr></tbody></table><div class="note">Unincorporated means outside any city or town, here inside the county fire district. Some parcels there also pay an 8.1-mill waste levy, which would add about 4%.</div></div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Your rental's numbers</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Type in the county's value of your rental. The tax rates are Horry County's for this year.</p><div class="rt-calc"><div class="k">Work out the tax on your rental</div><div class="g"><label>The county's value of the rental<input id="rtPrice" type="text" inputmode="numeric" autocomplete="off" value="350,000" oninput="c3Rt()" aria-label="The county's value of the rental, in dollars"></label><label>Where it is<select id="rtArea" onchange="c3Rt()" aria-label="Where the rental is"><option value="254.6">Inside Myrtle Beach city limits</option><option value="192.9">Unincorporated Horry County, county fire district</option></select></label></div><div class="out" role="list" aria-live="polite"><div role="listitem" class="now"><span>Today, at 6%</span><strong id="rtSix">$5,347</strong></div><div role="listitem"><span>At 4%, still paying the school tax</span><strong id="rtFour">$3,564</strong></div><div role="listitem"><span>At 4%, taxed like an owner's home</span><strong id="rtHome">$2,037</strong></div></div><div class="note" id="rtNote">A change would save $1,782 to $3,310 a year on this rental.</div><div class="note">Before the 25% exemption a rental gets when it sells.</div></div><script>function c3Rt(){var p=document.getElementById("rtPrice"),a=document.getElementById("rtArea"),o=["rtSix","rtFour","rtHome"].map(function(i){return document.getElementById(i)}),n=document.getElementById("rtNote");if(!p||!a||!n)return;var v=parseFloat(String(p.value).replace(/[$,\s]/g,"")),m=parseFloat(a.value),s=109.1;var f=function(x){return "$"+Math.round(x).toLocaleString("en-US")};if(!(v>0)){o.forEach(function(e){e.textContent="--"});n.textContent="Enter the county's value of the rental.";return}var six=v*0.06*m/1000,four=v*0.04*m/1000,home=v*0.04*(m-s)/1000;o[0].textContent=f(six);o[1].textContent=f(four);o[2].textContent=f(home);n.textContent="A change would save "+f(six-four)+" to "+f(six-home)+" a year on this rental."}</script><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">These bills are before credits and fees. Our <a href="/buyers/property-taxes/" style="color:var(--navy);text-decoration:underline">Horry County property tax guide</a> has the credits an owner who lives in the home gets.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">If you buy a rental</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">When a rental sells, the <a href="https://www.scstatehouse.gov/code/t12c037.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">county exempts 25%</a> of its value at the sale. The exemption cannot bring the taxable value below the county's current value of the parcel. The buyer applies to the county assessor before January 31 of the first tax year.</p></div></section><section style="background:var(--ivory-2)" id="votes-it-needs"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The votes it needs">Can the governor cut the tax on rentals by himself?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. Lawmakers can change the 6% rate without a statewide vote, but <a href="https://www.scstatehouse.gov/scconstitution/A10.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">only with two-thirds</a> of the members of each house. That is 83 House votes and 31 Senate votes.</p><figure class="rt-fig"><div class="cap">Republicans hold two-thirds of the Senate, but not of the House</div><div class="rt-ch"><svg role="img" aria-label="The House: 79 Republicans and 45 Democrats in the unofficial count, with the two-thirds line at 83 of 124, past the Republican seats." viewBox="0 0 300 112" style="font-family:var(--sans)"><text x="6" y="20" font-size="18" font-weight="700" fill="#1c2028">House, 124 members</text><text x="198.8" y="44" text-anchor="end" font-size="17" font-weight="700" fill="#a8482f">83 needed</text><rect x="6" y="54" width="183.5" height="30" rx="6" fill="#2a3040"/><rect x="189.5" y="54" width="104.5" height="30" rx="6" fill="#b9c2ca"/><text x="14.0" y="75" font-size="16" font-weight="700" fill="#fff">79 Republicans</text><text x="294.0" y="104" text-anchor="end" font-size="16" font-weight="700" fill="#1c2028">45 Democrats</text><line x1="198.8" x2="198.8" y1="49" y2="90" stroke="#a8482f" stroke-width="3"/></svg><svg role="img" aria-label="The Senate: 34 Republicans and 12 Democrats, with the line at 31 of 46, inside the Republican seats." viewBox="0 0 300 112" style="font-family:var(--sans)"><text x="6" y="20" font-size="18" font-weight="700" fill="#1c2028">Senate, 46 members</text><text x="200.1" y="44" text-anchor="end" font-size="17" font-weight="700" fill="#a8482f">31 needed</text><rect x="6" y="54" width="212.9" height="30" rx="6" fill="#2a3040"/><rect x="218.9" y="54" width="75.1" height="30" rx="6" fill="#b9c2ca"/><text x="14.0" y="75" font-size="16" font-weight="700" fill="#fff">34 Republicans</text><text x="294.0" y="104" text-anchor="end" font-size="16" font-weight="700" fill="#1c2028">12 Democrats</text><line x1="200.1" x2="200.1" y1="49" y2="90" stroke="#a8482f" stroke-width="3"/></svg></div><figcaption>House seats are the unofficial 2026 count. Senate seats were not on the ballot, except one special election.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Republicans won 79 House seats in the unofficial count. Even with every Republican voting yes, a change needs 4 Democratic votes in the House. In the Senate, Republicans hold more seats than the two-thirds needs.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Two House races were close enough for a recount under state law, one led by each party. The Republican count could still move by a seat either way.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">There are two ways to make the change:</p><ol class="rt-routes" aria-label="The two ways the rental rate could change"><li><b class="t">Route 1: a new law</b><ol><li><strong>House:</strong> two-thirds of its members vote yes.</li><li><strong>Senate:</strong> two-thirds of the senators agree.</li><li>The new rate goes into state law. No statewide vote is needed.</li></ol></li><li><b class="t">Route 2: an amendment</b><ol><li>Two-thirds of the members elected to each house vote yes.</li><li>A majority of voters approve it at the next general election, in November 2028.</li><li>The next legislature votes to ratify it.</li></ol></li></ol><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">One pending bill, <a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/815.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">S. 815</a>, would amend the constitution so lawmakers could set the classes and rates by ordinary law. It is in the Senate Finance Committee.</p></div></section><section style="background:var(--ivory)" id="what-it-would-cost"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What it would cost">What would a rental tax cut cost Horry County and its schools?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Suppose every home now taxed at 6% moved to 4%. At 2018 shares, that would take about a sixth of the taxable value off the real property the county assessor values. The county, the cities and the schools would collect less, unless someone else paid more.</p><figure class="rt-fig rt-side"><div class="cap">Horry County rentals are 36.4% of the value but 47.2% of the taxable value</div><svg role="img" aria-label="Paired bars for Horry County in 2018. Homes their owners live in: 35.5 percent of value, 30.8 percent of the taxable value. Rental property at 6 percent: 36.4 percent of value, 47.2 percent of the taxable value. Commercial property: 21.4 percent of value, 21.1 percent of the taxable value." viewBox="0 0 340 284" style="font-family:var(--sans)"><text x="4" y="18" font-size="18" font-weight="700" fill="#1c2028">Homes their owners live in</text><rect x="4" y="28" width="85.2" height="20" rx="5" fill="#b9c2ca"/><text x="95.2" y="44" font-size="16" fill="#1c2028">35.5% of value</text><rect x="4" y="54" width="73.9" height="20" rx="5" fill="#c4783a"/><text x="83.9" y="70" font-size="16" font-weight="700" fill="#1c2028">30.8% of taxable value</text><text x="4" y="114" font-size="18" font-weight="700" fill="#1c2028">Rental property, at 6%</text><rect x="4" y="124" width="87.4" height="20" rx="5" fill="#b9c2ca"/><text x="97.4" y="140" font-size="16" fill="#1c2028">36.4% of value</text><rect x="4" y="150" width="113.3" height="20" rx="5" fill="#c4783a"/><text x="123.3" y="166" font-size="16" font-weight="700" fill="#1c2028">47.2% of taxable value</text><text x="4" y="210" font-size="18" font-weight="700" fill="#1c2028">Commercial property</text><rect x="4" y="220" width="51.4" height="20" rx="5" fill="#b9c2ca"/><text x="61.4" y="236" font-size="16" fill="#1c2028">21.4% of value</text><rect x="4" y="246" width="50.6" height="20" rx="5" fill="#c4783a"/><text x="60.6" y="262" font-size="16" font-weight="700" fill="#1c2028">21.1% of taxable value</text></svg><figcaption>Gray bar: share of the value the county assessor counts. Brass bar: share of the taxable value, after the 4% and 6% rates. The figures are for 2018, from the Lincoln Institute of Land Policy study. Rental property is the study's "other residential" class, which it describes as typically rental property at 6%.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In 2018, rental property was 36.4% of the value the county assessor counts, but 47.2% of the taxable value. At 4%, rentals' taxable value would fall by a third.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The <a href="https://www.lincolninst.edu/app/uploads/legacy-files/pubfiles/sc_volume_2_chapter_2.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">study behind these shares</a> is by the Lincoln Institute of Land Policy. The South Carolina Chamber Foundation and South Carolina Realtors picked the ten counties it studied. It found the tax had shifted "from owner-occupied residential properties to non-owner-occupied residential properties as well as commercial, manufacturing, and utility properties."</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="The largest part of the $5,347 on the $350,000 city rental is the school operating tax"><span class="cap" aria-hidden="true">The largest part of the $5,347 on the $350,000 city rental is the school operating tax</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Who gets it</span><span role="columnheader">a year</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">School operating tax</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">$2,291</span></span></div><div role="row"><span role="rowheader"><span class="n">City of Myrtle Beach</span></span><span role="cell"><span class="b" style="--f:0.764" aria-hidden="true"></span><span class="v">$1,751</span></span></div><div role="row"><span role="rowheader"><span class="n">Horry County</span></span><span role="cell"><span class="b" style="--f:0.478" aria-hidden="true"></span><span class="v">$1,094</span></span></div><div role="row"><span role="rowheader"><span class="n">School debt</span></span><span role="cell"><span class="b" style="--f:0.092" aria-hidden="true"></span><span class="v">$210</span></span></div></div></div><figcaption>Horry County's 2026 tax rates, at the 6% rental rate. A home its owner lives in pays no school operating tax.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The school operating tax is the largest part of a rental's bill. For homes their owners live in, <a href="https://www.scstatehouse.gov/code/t11c011.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">a state fund</a> filled by Act 388's 1% sales tax pays the school districts back. Wilson has not said whether the state would do the same for rentals.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Who says the gap is unfair, and who backs it</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A <a href="https://sc.edu/study/colleges_schools/law/student_life/journals/jled/editions/_documents/2025_54_1/boyette_jled54.1_.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">2025 student note</a> in a University of South Carolina law journal argues the higher rate shifts the tax onto renters. It says the rate "can also prevent the development of affordable housing". The Lincoln study puts the yearly tax in South Carolina at about 0.5% of value for a home its owner lives in. For an apartment renter's property, it is slightly above 1.5%.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On the other side, groups such as nohometax.org back Act 388 as it is. The same note cites the group's page, titled "We Support Act 388".</p></div></section><section style="background:var(--ivory-2)" id="short-and-long-run"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Short run and long run">What could a rental tax cut do to cash flow and prices?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the first year or two, a cut would raise cash flow on the tax line, by a third or more of the bill. Over five years or more, past examples point to other owners paying a larger share, unless the state paid the difference.</p><ul class="rt-runs" aria-label="What a rental tax cut could do, and what has to happen first"><li class="first"><span class="k">First</span><b class="h">Nothing changes until lawmakers vote.</b><ul><li>No bill exists. A change needs two-thirds of each house, or an amendment that voters approve in November 2028.</li><li>Until then, a rental's bill stays at 6%.</li></ul></li><li><span class="k">Short run: the first 1 to 2 years</span><b class="h">More cash flow, from the tax line only.</b><ul><li>Our $350,000 city rental would keep $1,782 to $3,310 a year more.</li><li>Rents: no study we found measured how much of a tax cut reaches tenants here. A USC law student's note argues the 6% rate has pushed rents up.</li><li>Prices: a rental that nets more is worth more to a buyer. How much of the saving shows up in prices, no study here has measured.</li></ul></li><li><span class="k">Long run: 5 years or more</span><b class="h">Other owners pay a larger share, unless the state steps in.</b><ul><li>The two rates and Act 388's school exemption shifted the tax toward rentals and businesses, the Lincoln study found.</li><li>A cut would move tax the opposite way. About a sixth of the taxable value of the real property the county assessor values would come off, at 2018 shares. Homes their owners live in and businesses would pay a larger share, unless the state replaced it or spending fell.</li><li>Over time, a lower yearly tax could lift what buyers pay for rentals. We give no figure, because no study here has measured it.</li></ul></li></ul><div class="rt-tbl rt-stack"><div class="cap">What happened where this was tried before</div><table><thead><tr><th scope="col">Past example</th><th scope="col">What happened</th><th scope="col">What it points to here</th></tr></thead><tbody><tr><th scope="row">Act 388, South Carolina, 2006</th><td data-l="What happened">Homes their owners live in stopped paying school operating tax. A 1% sales tax paid the schools back. Rentals and businesses kept paying it.</td><td data-l="What it points to here">When one kind of property pays less, the others pay a larger share. A rental cut would move part of the tax back onto homes and businesses.</td></tr><tr><th scope="row">Florida's cap on non-homestead homes</th><td data-l="What happened">Florida caps the yearly rise in taxable value at 10% for a home of nine units or fewer that is not the owner's homestead. The cap covers every tax but the school tax. A homestead: 3% or inflation, whichever is lower.</td><td data-l="What it points to here">A state can slow the growth of a rental's bill without cutting its rate. We found no study of what the cap did to Florida rents or prices.</td></tr><tr><th scope="row">H. 3841, South Carolina, 2026</th><td data-l="What happened">A property tax bill on the 4% rate passed the House 109-0 and the Senate 43-0.</td><td data-l="What it points to here">Two-thirds is reachable when both parties agree. That bill was narrow; a rental rate change is larger.</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">None of this is a forecast of what lawmakers will pass. It is what the same mechanism did before, with the size of the change our arithmetic gives.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Buying a rental before lawmakers vote?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the listing. We work out its tax at 6% today and at 4%, so the price you offer rests on the bill it pays now.</p><a class="btn btn-brass" href="/contact/">Send us the listing</a></div></div></section><section style="background:var(--ivory)" id="what-democrats-said"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What Democrats said">What did Jermaine Johnson and the Democrats say about property tax?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Johnson's platform, as <a href="https://www.wmbfnews.com/2026/09/30/sc-governor-candidates-split-taxes-infrastructure-ahead-registration-deadlines/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">WMBF summarized it</a>, called for lowering property taxes, income tax relief for lower-income families and "building more affordable housing". The summary does not say which property taxes he would lower.</p><div class="rt-tbl rt-stack"><div class="cap">What each candidate for governor said about property tax</div><table><thead><tr><th scope="col">Test</th><th scope="col">Alan Wilson, Republican</th><th scope="col">Jermaine Johnson, Democrat</th></tr></thead><tbody><tr><th scope="row">The goal</th><td data-l="Alan Wilson, Republican">"Reforming Act 388 to remove higher property taxes for rental properties"</td><td data-l="Jermaine Johnson, Democrat">Lowering property taxes</td></tr><tr><th scope="row">Names the rental rate</th><td data-l="Alan Wilson, Republican">Yes, the higher tax on rentals</td><td data-l="Jermaine Johnson, Democrat">Not in the summary</td></tr><tr><th scope="row">Other tax items</th><td data-l="Alan Wilson, Republican">Tax breaks for seniors and veterans, the car tax, business personal property, the income tax</td><td data-l="Jermaine Johnson, Democrat">Income tax relief for lower-income families, more affordable housing</td></tr><tr><th scope="row">Whose words</th><td data-l="Alan Wilson, Republican">His interview and his site; the agenda as news outlets reported it</td><td data-l="Jermaine Johnson, Democrat">WMBF's summary of his platform</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the House, a rental change needs Democratic votes. At today's count, if 42 of the 45 Democrats voted no, it would fail even with every Republican voting yes.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Annie Andrews, the Democrat who won the U.S. Senate seat, works on federal law, and the property tax here is state and local. Her housing plan backs a <a href="/buyers/first-time-buyer-tax-credit/" style="color:var(--navy);text-decoration:underline">$50,000 federal tax cut for first-time buyers</a>.</p></div></section><section style="background:var(--ivory-2)" id="what-we-do-now"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What we do now">What should a Myrtle Beach rental investor do while this is debated?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Buy and sell on the tax a rental pays today. A plan with no bill can change before it passes, or never pass.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In Chapter3's experience, property tax stops more rental deals here than insurance does. When you buy or sell a rental, our agents check its numbers three ways:</p><ul style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem">On the 6% bill it pays today, with the 25% exemption where it applies.</li><li style="margin-bottom:.5rem">On the 4% bills beside it, so you see what a change would be worth without paying for it up front.</li><li style="margin-bottom:.5rem">On the buyer's tax, which rests on the new price and can be higher than the seller's.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our <a href="/invest/run-the-numbers/" style="color:var(--navy);text-decoration:underline">rental numbers guide</a> adds the rest of the costs.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If you rent by the week, our page on <a href="/invest/short-term-rental-rules-statehouse/" style="color:var(--navy);text-decoration:underline">which short-term rental rules a new Statehouse can change</a> covers the other half of the law.</p></div></section><section style="background:var(--ivory)" id="rental-property-tax-questions"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Rental property tax questions</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does the 6% rate apply to a condo I rent out?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. The 4% rate is only for the home the owner lives in and applies for. A condo, house or townhouse you rent out is taxed at 6%, whether it rents by the week or by the year.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Would a second home that is never rented get the cut?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Lawmakers have not decided. Today the 6% rate covers every home its owner does not live in, rented or not. Lawmakers would decide which homes a change covers when they write the bill.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does the 4% rate stay on a home after its owner dies?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For a time, under a 2026 law. The home keeps the 4% rate until the estate closes or a deed out of it is recorded. At the latest, it keeps it until December 31 of the year after the death. It loses the rate if it is rented for more than 72 days.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Would a cut change the taxes a short-term rental collects from guests?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. The plan is about property tax. A weekly rental still collects the state's 7% accommodations tax and any local tax of up to 3%. A few rentals are exempt, such as a home rented for 14 days or fewer in a year.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.scstatehouse.gov/scconstitution/A10.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">S.C. Constitution Art. X</a>, <a href="https://www.scstatehouse.gov/scconstitution/A16.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Art. XVI</a>, <a href="https://www.scstatehouse.gov/code/t12c043.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">S.C. Code 12-43</a>, <a href="https://www.scstatehouse.gov/code/t12c037.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">12-37</a>, <a href="https://www.scstatehouse.gov/code/t11c011.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">11-11-155</a>, <a href="https://www.scstatehouse.gov/code/t12c036.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">12-36</a>, <a href="https://www.horrycountysc.gov/media/kufln4qp/tax-levy-2026_2.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County 2026 levy</a>, <a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/3841.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">H. 3841</a>, <a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/815.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">S. 815</a>, <a href="https://scvotes.gov/2026-general-election-results/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Election Commission</a>, <a href="https://yourislandnews.com/alan-wilson-declares-victory-in-sc-governors-race-johnson-concedes/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Daily Gazette</a>, <a href="https://www.wistv.com/2026/10/28/full-interview-alan-wilson-shares-priorities-governor-ahead-election-day/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">WIS</a>, <a href="https://www.foxcarolina.com/2026/10/15/republican-nominee-sc-governor-alan-wilson-announces-affordability-agenda/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Fox Carolina</a>, <a href="https://www.herecolumbia.com/2026/10/16/governor-candidate-alan-wilson-affordability-campaign-plan/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">HERE Columbia</a>, <a href="https://wilsonforsc.com/priorities/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Wilson's priorities</a>, <a href="https://www.wmbfnews.com/2026/09/30/sc-governor-candidates-split-taxes-infrastructure-ahead-registration-deadlines/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">WMBF</a>, <a href="https://www.lincolninst.edu/app/uploads/legacy-files/pubfiles/sc_volume_2_chapter_2.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Lincoln Institute</a>, <a href="https://sc.edu/study/colleges_schools/law/student_life/journals/jled/editions/_documents/2025_54_1/boyette_jled54.1_.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">USC law note</a>, <a href="https://www.flsenate.gov/Laws/Constitution" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Florida Constitution Art. VII</a>. Bills are our arithmetic from the county's 2026 rates, before credits and fees. Election results are the unofficial count. Not legal or tax advice.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Oceanfront towers in Myrtle Beach. Photo: Loadmaster (David R. Tribble), <a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 3.0</a>, via <a href="https://commons.wikimedia.org/wiki/File:Atlantic_Ocean_shoreline_in_Myrtle_Beach,_South_Carolina.jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>. Chapter3 Realty cropped and resized the photo.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-11-e/rental-property-tax-cut/myrtle-beach-oceanfront-rentals-1200w.webp","url":"https://chapter3realty.com/images/2026-11-e/rental-property-tax-cut/myrtle-beach-oceanfront-rentals-1200w.webp","width":1200,"height":600,"encodingFormat":"image/webp","name":"Oceanfront towers in Myrtle Beach","caption":"Oceanfront towers in Myrtle Beach. A unit in them that its owner rents out pays the 6% rate today.","description":"A row of high-rise towers with balconies along the beach in Myrtle Beach under a clear sky","creator":{"@type":"Person","name":"Loadmaster (David R. Tribble)"},"creditText":"Loadmaster (David R","copyrightNotice":"© Loadmaster (David R. Tribble), CC BY-SA 3.0","license":"https://creativecommons.org/licenses/by-sa/3.0/","acquireLicensePage":"https://commons.wikimedia.org/wiki/File:Atlantic_Ocean_shoreline_in_Myrtle_Beach,_South_Carolina.jpg","isBasedOn":"https://commons.wikimedia.org/wiki/File:Atlantic_Ocean_shoreline_in_Myrtle_Beach,_South_Carolina.jpg","contentLocation":{"@type":"Place","name":"Oceanfront, Myrtle Beach, South Carolina"}}]}</script></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Buying or selling a Myrtle Beach rental?</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">Send us the address. We work out its tax at 6% today and at 4%, and price it on the law as it stands.</p><a class="btn btn-brass btn-lg" href="/contact/">Send us the rental</a></div></section></main>
