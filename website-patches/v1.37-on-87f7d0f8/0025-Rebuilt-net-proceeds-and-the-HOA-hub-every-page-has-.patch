nd" paint-order="stroke">low</text><text x="65.5" y="239.8" text-anchor="middle" font-size="13" fill="#4a4f5c">Jan</text><rect x="102.0" y="97.0" width="32.8" height="80.0" rx="3" fill="#7d8291"><title>February</title></rect><text x="118.4" y="239.8" text-anchor="middle" font-size="13" fill="#4a4f5c">Feb</text><rect x="154.9" y="97.0" width="32.8" height="32.8" rx="3" fill="#7d8291"><title>March</title></rect><text x="171.3" y="239.8" text-anchor="middle" font-size="13" fill="#4a4f5c">Mar</text><rect x="207.8" y="97.0" width="32.8" height="14.5" rx="3" fill="#7d8291"><title>April</title></rect><text x="224.2" y="239.8" text-anchor="middle" font-size="13" fill="#4a4f5c">Apr</text><rect x="260.7" y="97.0" width="32.8" height="1.5" rx="3" fill="#c4783a"><title>May</title></rect><text x="277.1" y="239.8" text-anchor="middle" font-size="13" fill="#4a4f5c">May</text><rect x="313.6" y="78.7" width="32.8" height="18.3" rx="3" fill="#c4783a"><title>June</title></rect><text x="330.0" y="239.8" text-anchor="middle" font-size="13" fill="#4a4f5c">Jun</text><rect x="366.6" y="62.7" width="32.8" height="34.3" rx="3" fill="#c4783a"><title>July</title></rect><text x="383.0" y="239.8" text-anchor="middle" font-size="13" fill="#4a4f5c">Jul</text><rect x="419.5" y="52.1" width="32.8" height="45.0" rx="3" fill="#c4783a"><title>August</title></rect><text x="435.9" y="46.2" text-anchor="middle" font-size="13" font-weight="600" fill="#8a5226" stroke="#fbf8f3" stroke-width="4" stroke-linejoin="round" paint-order="stroke">high</text><text x="435.9" y="239.8" text-anchor="middle" font-size="13" fill="#4a4f5c">Aug</text><rect x="472.4" y="64.3" width="32.8" height="32.8" rx="3" fill="#c4783a"><title>September</title></rect><text x="488.8" y="239.8" text-anchor="middle" font-size="13" fill="#4a4f5c">Sep</text><rect x="525.3" y="82.5" width="32.8" height="14.5" rx="3" fill="#c4783a"><title>October</title></rect><text x="541.7" y="239.8" text-anchor="middle" font-size="13" fill="#4a4f5c">Oct</text><rect x="578.2" y="97.0" width="32.8" height="38.1" rx="3" fill="#7d8291"><title>November</title></rect><text x="594.6" y="239.8" text-anchor="middle" font-size="13" fill="#4a4f5c">Nov</text><rect x="631.1" y="97.0" width="32.8" height="91.5" rx="3" fill="#7d8291"><title>December</title></rect><text x="647.5" y="239.8" text-anchor="middle" font-size="13" fill="#4a4f5c">Dec</text></svg><figcaption>Zillow's rent index, every kind of home, Myrtle Beach metro: each month's average distance from the trend, 2015 to 2026.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The swing is small, about $40 a month on a house. Near the college, the month you list makes more difference to empty weeks than to the price.</p><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);letter-spacing:.01em;color:#fff;text-align:right;background:radial-gradient(farthest-side at 100% 100%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.c3ph-cr a{color:#fff;text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);text-underline-offset:2px;pointer-events:auto;padding:10px 0 6px}.c3ph-hero{margin:1.6rem 0 2rem}.c3ph-hero .c3ph-f{border-radius:8px}.c3ph-hero img{aspect-ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}</style><figure class="c3ph-hero" style="margin:1.6rem 0 1.8rem;max-width:640px;"><div class="c3ph-f"><img src="/images/2026-11-a/invest-rent-prices/coastal-carolina-bell-tower-1200w.webp" srcset="/images/2026-11-a/invest-rent-prices/coastal-carolina-bell-tower-600w.webp 600w, /images/2026-11-a/invest-rent-prices/coastal-carolina-bell-tower-1200w.webp 1200w" sizes="(max-width: 680px) 100vw, 640px" width="1200" height="675" alt="A clock and bell tower on a red brick base beside a pink crape myrtle and flower beds on the Coastal Carolina University campus" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: Sk5893. License: CC BY-SA 4.0" title="License: CC BY-SA 4.0">Photo: Sk5893</a></span></div><figcaption>The bell tower at Coastal Carolina University in Conway. New students arrive in August and look for homes to rent.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If your house is near Coastal Carolina University, end the lease in August and start marketing the house a month before it ends. New students arrive in August and need a home to rent. In our experience, August turnover near the college has been no problem, and it is the month we have found best for no empty weeks. More on <a href="/invest/student-rentals/" style="color:var(--navy);text-decoration:underline">student rentals near the college</a>.</p></div></section><section style="background:var(--ivory)" id="your-house"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What will my house rent for">How much can I rent my house for in Myrtle Beach?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For one house, an agent at Chapter3 works out what it will rent for from current local leases and listings, at no cost, before you write the offer. The figures on this page are where we start.</p><div class="rp-ex" role="group" aria-label="Worked example"><p class="k">Worked example: a 3-bedroom house in Carolina Forest, bought empty</p><dl><div><dt>3-bedroom homes rented in Carolina Forest, with utilities</dt><dd>about $1,980</dd></div><div><dt>Less the utilities a house tenant pays</dt><dd>about $200</dd></div><div><dt>Rent, with the tenant paying the utilities</dt><dd>about $1,780</dd></div><div><dt>Homes listed now in ZIP 29579, every kind of home</dt><dd>about $1,770</dd></div><div><dt>Listed in August, not January</dt><dd>about $40 more</dd></div></dl><p><b>List a 3-bedroom house there from about $1,780 a month, with the tenant paying the utilities.</b> The Census figure counts old leases with new ones, and new leases cost more. Before you offer, we check the leases and listings near the one house.</p></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A furnished home on a lease of a few months is priced another way: <a href="/invest/mid-term-rentals/" style="color:var(--navy);text-decoration:underline">mid-term rentals</a>. For a quick screen, <a href="/invest/long-term-rental/" style="color:var(--navy);text-decoration:underline">our investment analyzer</a> takes any Grand Strand address and returns an estimated market rent with the cash flow. It is a screening estimate, not an appraisal. What a manager charges is on <a href="/invest/property-management/" style="color:var(--navy);text-decoration:underline">our property management cost page</a>.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Want this worked example done for one house?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us which house. We price it the same way, from the leases and listings near it, at no cost.</p><a class="btn btn-brass" href="/contact/">Ask us what it will rent for</a></div></div></section><section style="background:var(--ivory-2)" id="fair-market-rent"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Fair market rent">What is the fair market rent in Horry County?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The fair market rent matters to a landlord who takes housing vouchers (Section 8). The U.S. Department of Housing and Urban Development (HUD) publishes it each year. For Horry County, it is $1,823 a month for three bedrooms in the fiscal year 2027 schedule, with utilities.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">It is not the average rent. About four in ten recent movers into a standard home pay that much or less.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="HUD fair market rent a month, Horry County"><span class="cap" aria-hidden="true">HUD fair market rent a month, Horry County</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Home</span><span role="columnheader">fair market rent, with utilities</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Studio</span></span><span role="cell"><span class="b" style="--f:0.583" aria-hidden="true"></span><span class="v">$1,155</span></span></div><div role="row"><span role="rowheader"><span class="n">1 bedroom</span></span><span role="cell"><span class="b" style="--f:0.635" aria-hidden="true"></span><span class="v">$1,258</span></span></div><div role="row"><span role="rowheader"><span class="n">2 bedrooms</span></span><span role="cell"><span class="b" style="--f:0.759" aria-hidden="true"></span><span class="v">$1,504</span></span></div><div role="row"><span role="rowheader"><span class="n">3 bedrooms</span></span><span role="cell"><span class="b" style="--f:0.92" aria-hidden="true"></span><span class="v">$1,823</span></span></div><div role="row"><span role="rowheader"><span class="n">4 bedrooms</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">$1,981</span></span></div></div></div><figcaption>HUD's schedule for the Myrtle Beach-North Myrtle Beach-Conway metro area, from October. The figures include the utilities, except the telephone.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The voucher program uses it to work out what it pays. The rules for landlords who take vouchers are on our <a href="/invest/section-8-rentals/" style="color:var(--navy);text-decoration:underline">Section 8 rentals</a> page. The three-bedroom figure has risen about 55 percent in ten years.</p></div></section><section style="background:var(--ivory)" id="raising-the-rent"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Raising the rent">Can a landlord raise the rent in South Carolina?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. A new lease can state a higher rent. During a lease, the rent is the amount the lease states.</p><div class="rp-law"><div><b>No local rent limits</b><p>South Carolina does not let a city or county limit rents on privately owned homes.</p></div><div><b>Thirty days' notice</b><p>Either side can end a month-to-month lease with thirty days' written notice.</p></div><div><b>No raise to retaliate</b><p>A landlord may not raise the rent above market value to punish a tenant who complained to a code agency or to the landlord.</p></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Deposits, notices and the rest of the landlord's rules are on our <a href="/invest/landlord-rules/" style="color:var(--navy);text-decoration:underline">South Carolina landlord rules</a> page.</p></div></section><section style="background:var(--ivory-2)" id="rent-prices-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Rent prices FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What is the average rent in Horry County?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The middle rent for every rented home in Horry County is about $1,110 a month before utilities. It counts houses, apartments, condos and mobile homes, on old leases and new.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How much is rent for a 4-bedroom house in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Across every rented home with four bedrooms in Horry County, old leases and new, the middle rent is about $1,530 a month with utilities. The survey has too few rented 4-bedroom houses alone for a firm figure.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Where is rent cheapest on the Grand Strand?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Among ten Grand Strand ZIP codes, the asking rent is lowest in the north end of Myrtle Beach (29572). It is about $1,530 a month across every kind of home listed for rent. Little River (29566) is next, about $1,560.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Did the fair market rent go down?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For four bedrooms, yes: it fell from $2,111 to $1,981 a month in the fiscal year 2027 schedule. The three-bedroom figure rose.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://data.census.gov/table/ACSDT5Y2024.B25064?g=050XX00US45051" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Census ACS rent tables</a>, <a href="https://www.census.gov/programs-surveys/acs/microdata.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Census ACS microdata</a>, <a href="https://www.zillow.com/research/data/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Zillow research data</a>, <a href="https://www.huduser.gov/portal/datasets/fmr.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">HUD fair market rents</a>, <a href="https://www.ecfr.gov/current/title-24/subtitle-B/chapter-VIII/part-888/subpart-A/section-888.113" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">24 CFR 888.113</a>, <a href="https://www.scstatehouse.gov/code/t27c039.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 27-39</a>, <a href="https://www.scstatehouse.gov/code/t27c040.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 27-40</a>. Census: 2020-2024 American Community Survey 5-year estimates, 2024 dollars. "Most of Horry County" leaves out the Loris, Aynor and Green Sea area; Chapter3 computed those medians from the Census microdata. Zillow's metro area includes Brunswick County, NC; Zillow's data is through September 2026. No rent or value for any one address. Not legal advice.</p><style>.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Houses in Carolina Forest from above. Photo: NOAA National Geodetic Survey, <a href="https://www.govinfo.gov/content/pkg/USCODE-2023-title17/html/USCODE-2023-title17-chap1-sec105.htm" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://noaa-eri-pds.s3.amazonaws.com/index.html#2026_Pre_Event/EC2601a_OB_N_RGB/" target="_blank" rel="noopener noreferrer">NOAA Emergency Response Imagery</a>. Chapter3 Realty cut a 1600 x 1200 px view from one NOAA map tile, raised the contrast and color slightly, and resized it.</div><div role="listitem">The bell tower at Coastal Carolina University. Photo: Sk5893, <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a>, via <a href="https://commons.wikimedia.org/wiki/File:Spadoni_Park_Circle.jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>. Chapter3 Realty resized the photo.</div><div role="listitem">Chapter3 Realty resized these photos and cropped some of them. Each photo keeps the license listed with it.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-11-a/invest-rent-prices/carolina-forest-streets-from-above-1200w.webp","url":"https://chapter3realty.com/images/2026-11-a/invest-rent-prices/carolina-forest-streets-from-above-1200w.webp","width":1200,"height":900,"encodingFormat":"image/webp","name":"Houses in Carolina Forest, seen from above","caption":"Houses in Carolina Forest, seen from above. Carolina Forest is in ZIP code 29579, row 5 of the table.","description":"Rows of houses with gray roofs and short driveways along streets with strips of woods between them in Carolina Forest, seen from above","creator":{"@type":"Organization","name":"NOAA National Geodetic Survey"},"creditText":"NOAA National Geodetic Survey, public domain","copyrightNotice":"Public domain (NOAA National Geodetic Survey)","license":"https://www.govinfo.gov/content/pkg/USCODE-2023-title17/html/USCODE-2023-title17-chap1-sec105.htm","acquireLicensePage":"https://noaa-eri-pds.s3.amazonaws.com/index.html#2026_Pre_Event/EC2601a_OB_N_RGB/","isBasedOn":"https://noaa-eri-pds.s3.amazonaws.com/index.html#2026_Pre_Event/EC2601a_OB_N_RGB/","contentLocation":{"@type":"Place","name":"Carolina Forest, Myrtle Beach, South Carolina"},"representativeOfPage":true},{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-11-a/invest-rent-prices/coastal-carolina-bell-tower-1200w.webp","url":"https://chapter3realty.com/images/2026-11-a/invest-rent-prices/coastal-carolina-bell-tower-1200w.webp","width":1200,"height":675,"encodingFormat":"image/webp","name":"The bell tower at Coastal Carolina University in Conway","caption":"The bell tower at Coastal Carolina University in Conway. New students arrive in August and look for homes to rent.","description":"A clock and bell tower on a red brick base beside a pink crape myrtle and flower beds on the Coastal Carolina University campus","creator":{"@type":"Person","name":"Sk5893"},"creditText":"Sk5893, CC BY-SA 4.0, via Wikimedia Commons","copyrightNotice":"© Sk5893, CC BY-SA 4.0","license":"https://creativecommons.org/licenses/by-sa/4.0/","acquireLicensePage":"https://commons.wikimedia.org/wiki/File:Spadoni_Park_Circle.jpg","isBasedOn":"https://commons.wikimedia.org/wiki/File:Spadoni_Park_Circle.jpg","contentLocation":{"@type":"Place","name":"Coastal Carolina University, Conway, South Carolina"},"representativeOfPage":true}]}</script></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Get the rent for the house you are looking at.</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">One call. An agent at Chapter3 works out what the house will rent for from current local leases and listings, before you offer.</p><a class="btn btn-brass btn-lg" href="tel:+18543332135">Call a specialized agent</a></div></section></main>
+</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most rented houses here have three bedrooms: about six in ten. Houses are about three in ten rented homes. About half are apartments and condos, and about one in seven is a mobile home.</p><figure class="c3-gchart"><div role="table" aria-label="Middle rent a month, leases old and new, most of Horry County"><span class="cap" aria-hidden="true">Middle rent a month, leases old and new, most of Horry County</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Kind of home, utilities the renter pays</span><span role="columnheader">rent before utilities</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">1-bedroom apartment or condo</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">plus about $100 of utilities</span></span><span role="cell"><span class="b" style="--f:0.612" aria-hidden="true"></span><span class="v">$1,100</span></span></div><div role="row"><span role="rowheader"><span class="n">2-bedroom apartment or condo</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">plus about $100 of utilities</span></span><span role="cell"><span class="b" style="--f:0.644" aria-hidden="true"></span><span class="v">$1,150</span></span></div><div role="row"><span role="rowheader"><span class="n">3-bedroom house</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">plus about $200 of utilities</span></span><span role="cell"><span class="b" style="--f:0.833" aria-hidden="true"></span><span class="v">$1,500</span></span></div></div></div><figcaption>Census surveys of renters.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The chart counts every lease in place, old and new, so each figure is lower than what a new tenant pays. The survey has too few rented houses with two or four bedrooms for a firm figure. Condos rented by the night are another market: <a href="/invest/condos/" style="color:var(--navy);text-decoration:underline">our condo investing guide</a>.</p></div></section><section style="background:var(--ivory)" id="new-leases"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="New leases">Why does a new lease cost more than the rent the last tenant paid?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Across every rented home, a lease signed in the last two years costs about 40 percent more than one signed five or more years ago. For rented houses, it is about $1,600 a month against about $1,100, before utilities.</p><figure class="c3-gchart"><div role="table" aria-label="Middle rent a month before utilities, by how long the renter has been in the home"><span class="cap" aria-hidden="true">Middle rent a month before utilities, by how long the renter has been in the home</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Renters</span><span role="columnheader">rent before utilities</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Rented houses: moved in within 2 years</span></span><span role="cell"><span class="b" style="--f:0.893" aria-hidden="true"></span><span class="v">$1,600</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Rented houses: stayed 5 years or more</span></span><span role="cell"><span class="b" style="--f:0.596" aria-hidden="true"></span><span class="v">$1,100</span></span></div><div role="row"><span role="rowheader"><span class="n">Every rented home: moved in within 2 years</span></span><span role="cell"><span class="b" style="--f:0.743" aria-hidden="true"></span><span class="v">$1,340</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Every rented home: stayed 5 years or more</span></span><span role="cell"><span class="b" style="--f:0.514" aria-hidden="true"></span><span class="v">$930</span></span></div></div></div><figcaption>Census surveys of renters, most of Horry County.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">An average of all leases includes long tenants on old rents, so it is lower than what the next tenant will pay.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For an owner, it means two things. Plan a house you buy empty on the new-lease figure. A house you buy with a tenant in it may come with an older, lower rent until that lease ends. Before you offer, we find out how long the tenant has been there and what the lease says.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Buying a house that has a tenant in it?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We read the lease, so you know the rent you start with and when that lease ends.</p><a class="btn btn-brass" href="/contact/">Have us read the lease</a></div></div></section><section style="background:var(--ivory-2)" id="by-area"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="By area">What does rent cost in Carolina Forest, Socastee and the rest of the Grand Strand?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Asking rent is the rent on a home listed for rent now. Across ten Grand Strand ZIP codes, it is lowest in the north end of Myrtle Beach, about $1,530 a month, and highest in North Myrtle Beach, about $1,950. The asking rent in the highest ZIP code is about $420 a month more than in the lowest.</p><figure style="margin:1.8rem 0;max-width:760px"><svg xmlns="http://www.w3.org/2000/s