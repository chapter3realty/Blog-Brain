ne;display:inline-flex;width:2rem;height:2rem;border-radius:50%;align-items:center;justify-content:center;background:linear-gradient(145deg,rgba(255,255,255,.98),rgba(232,201,154,.55));border:1px solid rgba(255,255,255,.9);box-shadow:inset 0 1px 0 #fff,0 3px 10px -4px rgba(145,89,43,.45);color:var(--brass-ink)}.c3-gi{position:relative;padding-left:1.7rem;color:var(--muted);font-size:1rem;line-height:1.35;margin:0 0 .3rem}.c3-gi::before{content:attr(data-n);position:absolute;left:0;top:.2rem;color:var(--g-ink,var(--brass-ink));font-weight:600}.c3-gi a{display:inline-block;padding:.2rem 0;color:var(--navy);font-weight:600;text-decoration:underline;text-underline-offset:.18em}.c3-place-cta{display:flex;flex-wrap:wrap;align-items:center;gap:.7rem 1.2rem;max-width:760px;margin:1.6rem 0 .4rem;padding:1rem 1.2rem;border-radius:20px;background:linear-gradient(180deg,rgba(255,255,255,.76),rgba(255,255,255,.52));border:1px solid var(--g-edge,rgba(255,255,255,.8));box-shadow:var(--g-hi,none),var(--g-sh,none);-webkit-backdrop-filter:var(--g-blur,none);backdrop-filter:var(--g-blur,none)}.c3-place-cta>p:first-child{flex:1 1 18rem;margin:0;color:var(--navy);font-size:var(--read,1.0625rem);line-height:1.55}main#main .c3-place-cta .c3-offer{margin:0;flex:0 1 auto}.c3-mini{max-width:760px;margin:1rem 0 1.2rem;padding:.4rem .8rem .6rem;border-radius:20px;background:linear-gradient(180deg,rgba(255,255,255,.76),rgba(255,255,255,.52));border:1px solid var(--g-edge,rgba(255,255,255,.8));box-shadow:var(--g-hi,none),var(--g-sh,none)}.c3-mini table{width:100%;border-collapse:collapse;font-size:.92rem;line-height:1.35}.c3-mini caption{text-align:left;font-weight:600;color:var(--navy);padding:.4rem 0 .5rem}.c3-mini th,.c3-mini td{text-align:left;vertical-align:top;padding:.45rem .45rem .45rem 0;border-bottom:1px solid rgba(28,32,40,.1);color:var(--navy)}.c3-mini thead th{font-weight:600;border-bottom:1px solid rgba(28,32,40,.25)}.c3-mini tbody th{font-weight:600}.c3-mini a{color:var(--navy);text-decoration:underline;text-underline-offset:.18em}@media (max-width:979px){.c3-guide{display:flex;flex-direction:column}.c3-guide>figure,.c3-guide>.c3-map-figure{order:-1;margin:0 0 .8rem}}@media (max-width:699px){main>section{padding-top:2rem!important;padding-bottom:2rem!important}main>section[style^='background:var(--navy)'] p[style*='font-size:1.7rem'],main>section[style^='background:var(--navy)'] h2{font-size:1.4rem!important}.c3-guide-grid{display:block}.c3-guide-card{padding:0;background:none;border:0;box-shadow:none;margin:0 0 .4rem}.c3-guide-card h3{font-size:1rem;margin-bottom:0}.c3-guide-card h3 .i{width:1.5rem;height:1.5rem}.c3-gi{font-size:.97rem;line-height:1.3;margin-bottom:0;white-space:nowrap}.c3-gi a{padding:.08rem 0}.c3-mini{padding:.3rem .5rem .5rem}.c3-mini table{font-size:.85rem}}@media (max-width:699px){main#main .c3-aerial .c3ph-hero{margin-left:-24px!important;margin-right:-24px!important;width:calc(100% + 48px)!important;max-width:none!important;padding:0!important;border:0!important;border-radius:0!important;box-shadow:none!important;background:none!important}main#main .c3-aerial .c3ph-f,main#main .c3-aerial img{border-radius:0!important}main#main .c3-aerial figcaption{padding:0 24px}main#main .c3-guide>figure{margin-left:-24px!important;margin-right:-24px!important;width:calc(100% + 48px)!important;max-width:none!important;padding:0!important;border:0!important;border-radius:0!important;box-shadow:none!important}main#main .c3-guide>figure svg,main#main .c3-guide>figure img{border-radius:0!important;border-left:0!important;border-right:0!important;max-width:none!important}main#main .c3-guide>figure figcaption{padding:0 24px}}main#main .detail-hero .detail-sub{display:none}</style><div class="c3-guide c3-guide-map"><div class="c3-guide-grid"><div class="c3-guide-card"><h3><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11a9 7.5 0 0 1 18 0q-2.25-1.5-4.5 0t-4.5 0-4.5 0-4.5 0zM12 11v8M2.5 21.5c3-1.4 6.3-1.4 9.5 0s6.5 1.4 9.5 0"/></svg></span>Walk to the beach</h3><div class="c3-gi" data-n="1"><a href="#cherry-grove">Cherry Grove</a>: a record shark</div><div class="c3-gi" data-n="2"><a href="#surfside-beach">Surfside Beach</a>: a free pier</div></div><div class="c3-guide-card"><h3><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8.5 18.5V3.5l8 3.6-8 3.6M3.5 19c0-1.4 3.8-2.5 8.5-2.5s8.5 1.1 8.5 2.5-3.8 2.5-8.5 2.5-8.5-1.1-8.5-2.5z"/><circle cx="16" cy="15.2" r="1.2"/></svg></span>Golf course neighborhoods</h3><div class="c3-gi" data-n="3"><a href="#pine-lakes">Pine Lakes</a>: golf since 1927</div><div class="c3-gi" data-n="4"><a href="#tidewater">Tidewater</a>: houses on the fairways</div><div class="c3-gi" data-n="5"><a href="#barefoot-resort">Barefoot Resort</a>: a waterway course</div><div class="c3-gi" data-n="6"><a href="#prince-creek">Prince Creek</a>: where pros played</div><div class="c3-gi" data-n="7"><a href="#wild-wing">Wild Wing</a>: a Monday night league</div></div><div class="c3-guide-card"><h3><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v13M12 3l7 11h-7M10 6l-5 8h5M3 16h18l-2 4H5z"/></svg></span>A boat or a paddle</h3><div class="c3-gi" data-n="8"><a href="#plantation-lakes">Plantation Lakes</a>: pontoon boats</div><div class="c3-gi" data-n="9"><a href="#waterbridge">Waterbridge</a>: kayaks from a dock</div></div><div class="c3-guide-card"><h3><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 8h12l-1 12.1a1 1 0 0 1-1 .9H8a1 1 0 0 1-1-.9zM9 10V6.5a3 3 0 0 1 6 0V10"/></svg></span>A town center you can walk</h3><div class="c3-gi" data-n="10"><a href="#market-common">Market Common</a>: a Saturday market</div></div><div class="c3-guide-card"><h3><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span>New houses</h3><div class="c3-gi" data-n="11"><a href="#deerfield">Deerfield</a>: new on old golf land</div></div><div class="c3-guide-card"><h3><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 9.4c-.4-1-1.5-1.8-3-1.8-1.8 0-3 1-3 2.2 0 3 6 1.6 6 4.4 0 1.3-1.3 2.2-3 2.2-1.6 0-2.7-.7-3.1-1.8M12 5.8v1.8M12 16.4v1.8"/><circle cx="12" cy="12" r="9"/></svg></span>More house for the money</h3><div class="c3-gi" data-n="12"><a href="#avalon">Avalon</a>: ball fields inside</div><div class="c3-gi" data-n="13"><a href="#the-farm">The Farm</a>: 280 acres of open land</div></div></div></div></div></section><section style="background:var(--ivory)" id="cherry-grove"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Cherry Grove">1. Cherry Grove: a fishing pier with a world-record shark</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In 1964 a 1,780-pound tiger shark was landed from Cherry Grove Pier, a world record at the time. The pier is about a 12-minute walk, about half a mile, from the middle of Cherry Grove.</p><div class="hx-strip" data-place="cherry-grove" data-name="Cherry Grove"></div><div class="hx-fallback"><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/buyers/best-neighborhoods/cherry-grove-pier-from-above-1200w.webp" srcset="/images/buyers/best-neighborhoods/cherry-grove-pier-from-above-600w.webp 600w, /images/buyers/best-neighborhoods/cherry-grove-pier-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Cherry Grove from above: a long wooden pier labelled Cherry Grove Pier runs from a blue building on the beach out past the waves, with rows of beach houses behind the sand" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo. License: Public domain" title="License: Public domain">U.S. government aerial photo</a></span></div><figcaption>Cherry Grove Pier from above, running out past the surf, with beach houses behind the sand.</figcaption></figure></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A public beach access is about a tenth of a mile from the center of the neighborhood. North Myrtle Beach <a href="https://www.nmb.us/179/Beach-Ordinances" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">allows leashed dogs on the beach</a> all year, except at midday in summer.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Away from the condo towers on the ocean, Cherry Grove's streets hold about 1,700 houses. Most of the houses listed for sale here are raised beach houses.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Plan on flood insurance. Almost every home here is in a high-risk flood zone, where a lender usually requires it.</p><p class="c3-place-price">Houses in Cherry Grove usually sold for about $695,000 last year. More than half of the homes for sale here are listed with no homeowners association (HOA) fee.</p></div></section><section style="background:var(--ivory-2)" id="surfside-beach"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Surfside Beach, ocean side">2. Surfside Beach, ocean side: a free concrete pier with two restaurants</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The ocean side of Surfside Beach has its own town pier, and <a href="https://www.surfsidebeach.org/212/Surfside-Beach-Fishing-Pier" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">walking onto it is free</a>. The concrete pier runs 814 feet into the ocean, with two restaurants, an ice cream shop and a bait and tackle shop.</p><div class="hx-strip" data-place="surfside-beach" data-name="Surfside Beach, ocean side"></div><div class="hx-fallback"><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/buyers/best-neighborhoods/surfside-beach-pier-1200w.webp" srcset="/images/buyers/best-neighborhoods/surfside-beach-pier-600w.webp 600w, /images/buyers/best-neighborhoods/surfside-beach-pier-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Surfside Beach from the air: a long pier labelled Surfside Beach Pier runs from the beach into a green ocean, with rows of houses on the streets behind the sand" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.govinfo.gov/content/pkg/USCODE-2023-title17/html/USCODE-2023-title17-chap1-sec105.htm" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo. License: Public domain" title="License: Public domain">U.S. government aerial photo</a></span></div><figcaption>The Surfside Beach Pier from the air, with streets of beach houses behind the sand.</figcaption></figure></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The pier and the sand are about a nine-minute walk from the center of the neighborhood. A summer evening can end out on the pier, which stays open until one in the morning from April through October.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Surfside Beach began as part of a rice plantation called The Ark. The name Surfside Beach came from a Florida town. Its streets mix older one-story ranch houses with raised beach houses.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About one home in four on the ocean side is in a high-risk flood zone, where a lender usually requires flood insurance.</p><p class="c3-place-price">Houses on the ocean side of Surfside Beach usually sold for about $705,000 last year, and condos for about $405,000. Most homes for sale here are listed with no HOA fee.</p></div></section><section style="background:var(--ivory)" id="pine-lakes"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Pine Lakes">3. Pine Lakes: where Sports Illustrated was planned</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="https://www.pinelakes.com/about-pine-lakes-country-club/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Sports Illustrated was planned at Pine Lakes</a>. In 1954 a group of Time-Life executives came to play the course and plan a new weekly sports magazine.</p><div class="hx-strip" data-place="pine-lakes" data-name="Pine Lakes"></div><div class="hx-fallback"><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/buyers/no-hoa/pine-lakes-clubhouse-1200w.webp" srcset="/images/buyers/no-hoa/pine-lakes-clubhouse-600w.webp 600w, /images/buyers/no-hoa/pine-lakes-clubhouse-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="675" alt="The large white Pine Lakes clubhouse with a row of tall columns, black shutters and dormer windows in a gray roof" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/publicdomain/mark/1.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: Pubdog. License: Public domain" title="License: Public domain">Photo: Pubdog</a></span></div><figcaption>The 1927 clubhouse at Pine Lakes Country Club, on the National Register of Historic Places.</figcaption></figure></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Pine Lakes Country Club opened in 1927 as Myrtle Beach's first golf course. Robert White, a native of St. Andrews, Scotland, and the first president of the PGA of America, designed it. The club is known as The Granddaddy.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Beside the club, in Myrtle Beach, The Preserve at Pine Lakes and Pine Lakes Estates hold houses much newer than the course. Most of the houses listed for sale there have the primary bedroom on the main floor. Owners in The Preserve share their own pool.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Few of the houses are on the course itself: only 13 of their 250 house lots border it.</p><p class="c3-place-price">Houses here usually sold for about $600,000 last year, and a house in The Preserve pays an HOA fee of about $95 a month.</p></div></section><section style="background:var(--ivory-2)" id="tidewater"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Tidewater Plantation">4. Tidewater Plantation: houses on the fairways</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About seven of every ten houses in Tidewater Plantation have <a href="/buyers/golf-communities/" style="color:var(--navy);text-decoration:underline">lots that border the golf course</a>, and many streets curve between two fairways.</p><div class="hx-strip" data-place="tidewater" data-name="Tidewater Plantation"></div><div class="hx-fallback"><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/buyers/best-neighborhoods/tidewater-golf-course-1200w.webp" srcset="/images/buyers/best-neighborhoods/tidewater-golf-course-600w.webp 600w, /images/buyers/best-neighborhoods/tidewater-golf-course-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Tidewater Plantation from above: houses under tall trees along curving streets, with green golf fairways and greens on both sides, one labelled Golf course" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo. License: Public domain" title="License: Public domain">U.S. government aerial photo</a></span></div><figcaption>Tidewater from above: houses under the trees, with golf fairways on both sides of them.</figcaption></figure></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The neighborhood is on a neck of land between the Intracoastal Waterway and Cherry Grove Inlet, with salt marsh along its edges. Many of the houses stand under tall trees, and some streets carry sailing names, such as Spinnaker Drive and Topsail Lane.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The course is public, so golfers who do not live here play past the back yards.</p><p class="c3-place-price">Houses in Tidewater usually sold for about $625,000 last year, and the HOA fee for a house is about $230 a month.</p></div></section><section style="background:var(--ivory)" id="barefoot-resort"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Barefoot Resort">5. Barefoot Resort: a golf course along the waterway</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For a golfer, the Greg Norman course has seven holes along the waterway and wide fairways. Barefoot <a href="https://www.barefootgolf.com/same-day-reduced-replay-rate/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">sells a second round the same day</a> at a lower rate, booked when the first round ends.</p><div class="hx-strip" data-place="barefoot-resort" data-name="Barefoot Resort"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Barefoot Resort's road to the shops crosses a swing bridge from the 1930s, moved here from Edenton, North Carolina. Barefoot Landing's shops and restaurants are on the far side of the Intracoastal Waterway, about six minutes from the condos by car.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the Yacht Club Villas, North Tower, Dye Townhomes and the Retreat, most homes are condos, about 390 of them, with about 80 houses. Owners in two of the resort's associations share the North Tower pool beside the waterway.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">With so few houses, a buyer who wants a yard of their own has little to choose from here.</p><p class="c3-place-price">Homes in these four Barefoot sections, mostly condos, usually sold for about $430,000 last year, and the condo fee is about $680 a month.</p></div></section><section style="background:var(--ivory-2)" id="prince-creek"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Prince Creek">6. Prince Creek: a course where the pros played</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Prince Creek's sections border TPC Myrtle Beach, a Tom Fazio course. Tom Watson won the Senior PGA Tour Championship there in 2000, and <a href="https://www.tpcmyrtlebeach.com/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Lee Trevino and Gary Player</a> have played it too.</p><div class="hx-strip" data-place="prince-creek" data-name="Prince Creek"></div><div class="hx-fallback"><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/buyers/best-neighborhoods/prince-creek-tpc-1200w.webp" srcset="/images/buyers/best-neighborhoods/prince-creek-tpc-600w.webp 600w, /images/buyers/best-neighborhoods/prince-creek-tpc-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Prince Creek from above: curving streets of houses and ponds beside green golf fairways and greens, labelled TPC Myrtle Beach" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo. License: Public domain" title="License: Public domain">U.S. government aerial photo</a></span></div><figcaption>Prince Creek from above: streets of houses beside the TPC Myrtle Beach golf course.</figcaption></figure></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">From the middle of Prince Creek, the entrance to <a href="https://southcarolinaparks.com/huntington-beach" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Huntington Beach State Park</a> is about 12 minutes by car. The park has a wide beach, Atalaya, a Moorish-style winter home, and a freshwater lake where alligators are easy to spot.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Prince Creek mixes houses and townhomes, in sections of their own, and builders have also sold new homes here for about $320,000. The HOA fee is about $100 to $390 a month, depending on the section. Our agents check which section a home is in before you make an offer.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most of the houses are not on the course itself: of about 640 houses in Prince Creek outside the Seasons section, about 19 have lots that border it.</p><p class="c3-place-price">Homes in Prince Creek usually sold for about $490,000 last year.</p></div></section><section style="background:var(--ivory)" id="wild-wing"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Wild Wing Plantation">7. Wild Wing Plantation: a Monday night golf league</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On summer Monday nights, Wild Wing runs a <a href="https://www.playwildwing.com/spark-golf-league/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">community golf league</a>. Teams play nine holes on its Hummingbird course, with a playoff at the end of the season.</p><div class="hx-strip" data-place="wild-wing" data-name="Wild Wing Plantation"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Wishbones Bar and Grill, at the club, has a full bar and two indoor TrackMan golf simulators. The main course, the Avocet, was designed by Jeff Brauer and Larry Nelson.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Many streets are named for water birds, such as Wood Stork Drive and Black Skimmer Drive. The lots along them are big, more than a third of an acre in a typical case.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Wild Wing is inside the city of Conway, and a beach day starts with a drive of about 20 minutes.</p><p class="c3-place-price">Houses in Wild Wing usually sold for about $600,000 last year, and the HOA fee is about $135 a month.</p></div></section><section style="background:var(--ivory-2)" id="plantation-lakes"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Plantation Lakes">8. Plantation Lakes: pontoon boats on a lake with 15 miles of shoreline</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In Carolina Forest, owners at Plantation Lakes <a href="https://www.plantationlakespoa.com/community.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">take pontoon boats out</a> on a lake with about 15 miles of shoreline. About two of every three houses have lots that border the water, and some have a dock of their own.</p><div class="hx-strip" data-place="plantation-lakes" data-name="Plantation Lakes"></div><div class="hx-fallback"><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/buyers/best-neighborhoods/plantation-lakes-docks-1200w.webp" srcset="/images/buyers/best-neighborhoods/plantation-lakes-docks-600w.webp 600w, /images/buyers/best-neighborhoods/plantation-lakes-docks-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Plantation Lakes from above: houses with back yards on a dark winding lake labelled Lake, and a small boat dock, marked Boat docks, beside two pools" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo. License: Public domain" title="License: Public domain">U.S. government aerial photo</a></span></div><figcaption>Plantation Lakes from above: houses along the lake, and the boat docks at the owners’ amenity area.</figcaption></figure></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">An owner can take the boat to the amenity area, which has day and overnight docks and a boat ramp. On a cool evening, the clubhouse has a great room with a fireplace and a reading and card room.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A house lot here is typically about half an acre.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Boats on the lake are limited to 19 feet, with small motors.</p><p class="c3-place-price">Houses in Plantation Lakes usually sold for about $740,000 last year, and the HOA fee is about $125 a month.</p></div></section><section style="background:var(--ivory)" id="waterbridge"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Waterbridge">9. Waterbridge: kayaks from a floating dock, and potluck Thursdays</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In Carolina Forest, Waterbridge owners can launch a kayak on the neighborhood's lakes from a floating dock. The lakes take only boats with no motor or an electric one.</p><div class="hx-strip" data-place="waterbridge" data-name="Waterbridge"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Walking paths cross the water on bridges. The HOA's calendar holds card nights, bunco, mahjong, a book club and potluck Thursdays, and the fitness center at the clubhouse is open around the clock.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Owners also have a storage area for boats and jet skis. It is full now, so we ask about a space before you offer.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Builders are still selling new houses on the newest streets.</p><p class="c3-place-price">Resale houses in Waterbridge usually sold for about $630,000 last year, and new ones from builders for about $550,000. The HOA fee is about $150 a month.</p></div></section><section style="background:var(--ivory-2)" id="market-common"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The Market Common">10. The Market Common: a Saturday market you can walk to</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">From the middle of The Market Common, <a href="https://waccamawmarkets.org/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">the farmers market</a> at Valor Park is about a five-minute walk. It is held on Saturdays from April to mid-December.</p><div class="hx-strip" data-place="market-common" data-name="The Market Common"></div><div class="hx-fallback"><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/buyers/best-neighborhoods/market-common-valor-park-1200w.webp" srcset="/images/buyers/best-neighborhoods/market-common-valor-park-600w.webp 600w, /images/buyers/best-neighborhoods/market-common-valor-park-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="The Market Common from the air: streets of homes outlined in orange beside a lake, a dot labelled Valor Park at the edge of the shops, and ball fields and a lake labelled Grand Park" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.govinfo.gov/content/pkg/USCODE-2023-title17/html/USCODE-2023-title17-chap1-sec105.htm" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo. License: Public domain" title="License: Public domain">U.S. government aerial photo</a></span></div><figcaption>The Market Common from the air: its homes, outlined, Valor Park, where the Saturday market is held, and Grand Park.</figcaption></figure></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The neighborhood stands on the old Myrtle Beach Air Force Base, which closed in 1993. Three Air Force jets, among them an A-10 Warthog, stand in Warbird Park, on loan to the city.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Grand Park, with seven ball fields, picnic shelters and a playground, is a two-minute walk from the middle of the neighborhood. The houses and townhomes are close together, beside a district of shops and offices.</p><p class="c3-place-price">Houses in The Market Common usually sold for about $540,000 last year, and townhomes for about $398,000.</p></div></section><section style="background:var(--ivory)" id="deerfield"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Deerfield Plantation area">11. Deerfield Plantation area: new houses on old golf land</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Deerfield is built around the old Deer Track golf courses near Surfside Beach. A typical lot in the older streets is about a third of an acre, and new houses now stand on the old South Course.</p><div class="hx-strip" data-place="deerfield" data-name="Deerfield Plantation area"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The owners' association owns about 14 acres of lake and canals among the homes. The beach is about seven minutes away by car, and at the closest access all three parking spaces are for golf carts.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On the old North Course, building has only begun, so homes near it are beside a building site.</p><p class="c3-place-price">Homes in the older streets of the Deerfield Plantation area usually sold for about $355,000 last year, and the HOA fee is under $90 a month.</p></div></section><section style="background:var(--ivory-2)" id="avalon"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Avalon">12. Avalon: ball fields in the middle of the neighborhood</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the middle of Avalon, the owners' association holds about nine acres of amenity land with a baseball field, soccer fields and a beach volleyball court. A ball game needs no drive.</p><div class="hx-strip" data-place="avalon" data-name="Avalon"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The same grounds have a playground, and the association holds a second, smaller amenity area too. Avalon is in Carolina Forest, about a 20-minute drive from the beach.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The houses are a mix of one-story and two-story, and almost every one is outside the high-risk flood zone. The ones for sale have about 1,700 square feet.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The ones for sale were built between 2000 and 2006, so our agents check the roof and the air conditioner for you.</p><p class="c3-place-price">Houses in Avalon usually sold for about $290,000 last year, and the HOA fee is about $84 a month.</p></div></section><section style="background:var(--ivory)" id="the-farm"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The Farm at Carolina Forest">13. The Farm at Carolina Forest: open land next to most houses</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About two of every three houses at The Farm border land the HOA owns: ponds, woods and open space, about 280 acres of it.</p><div class="hx-strip" data-place="the-farm" data-name="The Farm at Carolina Forest"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The houses are on curving streets, with townhomes and condos in sections of their own. Houses listed here in recent years usually have about 1,900 square feet. A beach morning starts with a drive of about 12 minutes from the middle of the neighborhood.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our <a href="/submarkets/carolina-forest/the-farm/" style="color:var(--navy);text-decoration:underline">guide to The Farm at Carolina Forest</a> has its pools, its schools and its HOA rules.</p><p class="c3-place-price">Houses at The Farm usually sold for about $350,000 last year, and the HOA fee for a house is $107 a month.</p></div></section><section style="background:var(--ivory-2)" id="side-by-side"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Side by side">How do the 13 neighborhoods compare?</h2><div class="c3-mini"><table><caption>The 13 neighborhoods side by side</caption><thead><tr><th scope="col">Neighborhood</th><th scope="col">Homes usually sell for</th><th scope="col">HOA fee a month</th><th scope="col">To the beach</th></tr></thead><tbody><tr><th scope="row"><a href="#cherry-grove">1. Cherry Grove</a></th><td>About $695,000 for a house</td><td>None on most homes listed for sale</td><td>A short walk, about 0.1 mile</td></tr><tr><th scope="row"><a href="#surfside-beach">2. Surfside Beach</a></th><td>Houses $705,000, condos $405,000</td><td>None on most homes listed for sale</td><td>A 9-minute walk</td></tr><tr><th scope="row"><a href="#pine-lakes">3. Pine Lakes</a></th><td>About $600,000</td><td>About $95 for a house</td><td>About 6 minutes</td></tr><tr><th scope="row"><a href="#tidewater">4. Tidewater</a></th><td>About $625,000 for a house</td><td>About $230 for a house</td><td>About 8 minutes</td></tr><tr><th scope="row"><a href="#barefoot-resort">5. Barefoot Resort</a></th><td>About $430,000, mostly condos</td><td>About $680 for a condo</td><td>About 6 minutes</td></tr><tr><th scope="row"><a href="#prince-creek">6. Prince Creek</a></th><td>About $490,000</td><td>About $100 to $390, by section</td><td>About 11 minutes</td></tr><tr><th scope="row"><a href="#wild-wing">7. Wild Wing</a></th><td>About $600,000</td><td>About $135</td><td>About 20 minutes</td></tr><tr><th scope="row"><a href="#plantation-lakes">8. Plantation Lakes</a></th><td>About $740,000</td><td>About $125</td><td>About 15 to 20 minutes</td></tr><tr><th scope="row"><a href="#waterbridge">9. Waterbridge</a></th><td>About $630,000; new about $550,000</td><td>About $150</td><td>About 15 to 20 minutes</td></tr><tr><th scope="row"><a href="#market-common">10. Market Common</a></th><td>Houses $540,000, townhomes $398,000</td><td>About $300 to $680 for a townhome</td><td>About 5 minutes</td></tr><tr><th scope="row"><a href="#deerfield">11. Deerfield</a></th><td>About $355,000, older streets</td><td>Under $90 for a house</td><td>About 7 minutes</td></tr><tr><th scope="row"><a href="#avalon">12. Avalon</a></th><td>About $290,000 for a house</td><td>About $84 for a house</td><td>About 20 minutes</td></tr><tr><th scope="row"><a href="#the-farm">13. The Farm</a></th><td>About $350,000 for a house</td><td>$107</td><td>About 12 minutes</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Times are by car with no traffic, except Cherry Grove and Surfside Beach, which are on foot. Each time is from the middle of the neighborhood to the nearest public beach access.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For clubs and gates, see our <a href="/buyers/gated-communities/" style="color:var(--navy);text-decoration:underline">guide to gated communities near Myrtle Beach</a>. If price matters most, see <a href="/buyers/affordable-places-to-live/" style="color:var(--navy);text-decoration:underline">the most affordable places near Myrtle Beach</a>. For no HOA fee at all, see <a href="/buyers/no-hoa-homes/" style="color:var(--navy);text-decoration:underline">homes with no HOA near Myrtle Beach</a>. Our <a href="/buyers/55-plus-communities/" style="color:var(--navy);text-decoration:underline">guide to 55+ communities near Myrtle Beach</a> compares four with a 55+ age rule.</p></div></section><section style="background:var(--ivory)" id="best-neighborhoods-in-myrtle-beach-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Best neighborhoods in Myrtle Beach: FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Which Myrtle Beach neighborhoods are closest to the beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Cherry Grove is closest, with a public beach access about a tenth of a mile from the middle of the neighborhood. On the ocean side of Surfside Beach, the sand is about a nine-minute walk. The Market Common is about five minutes from the beach by car.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is Carolina Forest or Myrtle Beach better to live in?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The city of Myrtle Beach is better for being close to the beach, and Carolina Forest for big neighborhood pools and lakes. Plantation Lakes, Waterbridge, Avalon and The Farm, all in Carolina Forest, are 12 to 20 minutes from the beach by car.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Which neighborhoods near Myrtle Beach have no HOA?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most homes for sale on the ocean side of Surfside Beach, and more than half in Cherry Grove, are listed with no HOA fee. Most other neighborhoods on this page have an HOA fee of under $250 a month for a house.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Are there 55+ communities near Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. Del Webb North Myrtle Beach, Del Webb at Grande Dunes, Seasons at Prince Creek West and Myrtle Trace are 55+ communities, and our 55+ guide compares them.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.nmb.us/179/Beach-Ordinances" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">North Myrtle Beach</a>, <a href="https://www.surfsidebeach.org/212/Surfside-Beach-Fishing-Pier" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Surfside Beach pier</a>, <a href="https://www.pinelakes.com/about-pine-lakes-country-club/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Pine Lakes</a>, <a href="https://www.barefootgolf.com/same-day-reduced-replay-rate/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Barefoot golf</a>, <a href="https://www.tpcmyrtlebeach.com/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">TPC Myrtle Beach</a>, <a href="https://www.playwildwing.com/spark-golf-league/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Wild Wing</a>, <a href="https://www.aol.com/miami-look-myrtle-beach-grande-100000795.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">The Sun News</a>, <a href="https://www.plantationlakespoa.com/community.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Plantation Lakes</a>, <a href="https://southcarolinaparks.com/huntington-beach" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">State parks</a>, <a href="https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">County parcels</a>, <a href="https://www.census.gov/geographies/mapping-files/time-series/geo/tiger-line-file.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Census maps</a>. Prices are middle resales over 12 months. Fees and house features come from homes for sale (The Farm's fee from its HOA); counts, lots and flood zones from county parcels. Photos: NOAA and USDA aerials, <a href="https://www.govinfo.gov/content/pkg/USCODE-2023-title17/html/USCODE-2023-title17-chap1-sec105.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">public domain</a>, labelled by Chapter3; the clubhouse by Pubdog, <a href="https://creativecommons.org/publicdomain/mark/1.0/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">public domain</a>, via <a href="https://commons.wikimedia.org/wiki/File:Ocean_Forest_Country_Club_Jun_10.JPG" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>.</p><script type="application/ld+json">{"@context":"https://schema.org","@gra