}function fmt(x){return (x<0?'-$':'$')+Math.abs(Math.round(x)).toLocaleString('en-US')}function row(list,n,v,strong){var el=document.createElement('li');el.style.display='flex';el.style.justifyContent='space-between';if(strong){el.style.fontWeight='700';el.style.color='var(--ivory)';el.style.borderTop='1px solid rgba(244,239,232,.25)';el.style.paddingTop='.5rem';el.style.marginTop='.3rem'}el.innerHTML='<span>'+n+'</span><span>'+(typeof v==='number'?fmt(v):v)+'</span>';list.appendChild(el)}var RATE=0.0521,DED=0.44;function calc(){var mfj=f[0].value==='m',use=f[1].value,price=num(f[2]),costPct=num(f[3])/100,basis=num(f[4]),imp=num(f[5]),dep=num(f[6]),inc=num(f[7]),payoff=num(f[8]),nr=f[9].checked,aff=f[10].checked;var out=$('cg-out');out.innerHTML='';var realized=price*(1-costPct);var adjBasis=basis+imp-dep;var gain=Math.max(0,realized-adjBasis);row(out,'Amount realized (price minus selling costs)',realized);row(out,'Adjusted basis',adjBasis);row(out,'Total gain',gain);var excl=0;if(use==='primary'){excl=Math.min(Math.max(0,gain-dep),mfj?500000:250000);row(out,'Section 121 exclusion',-excl)}var taxable=gain-excl;var recap=Math.min(dep,taxable);var ltcg=Math.max(0,taxable-recap);var b0=mfj?98900:49450,b15=mfj?613700:545500;var start=inc;var in0=Math.max(0,Math.min(b0-start,ltcg));var in15=Math.max(0,Math.min(b15-Math.max(start,b0),ltcg-in0));var in20=Math.max(0,ltcg-in0-in15);var fed=in15*0.15+in20*0.20+recap*0.25;var magi=inc+taxable;var niitTh=mfj?250000:200000;var niit=(use!=='primary'||taxable>0)?Math.max(0,Math.min(taxable,magi-niitTh))*0.038:0;if(use==='primary'&&taxable===0)niit=0;var sc=taxable*(1-DED)*RATE;row(out,'Federal capital gains tax (0/15/20% stacked on income)',fed);row(out,'Net investment income tax (3.8% over threshold)',niit);row(out,'South Carolina tax after the 44% deduction (about 2.92%)',sc);var wh=0;if(nr){if(taxable<=0){wh=0}else if(aff){wh=taxable*RATE}else{wh=Math.min(realized*RATE,Math.max(0,realized-payoff))}}row(out,'Withheld at closing (I-290'+(nr?(aff?', with gain affidavit':', NO affidavit'):', resident: none')+')',wh);if(nr&&wh>sc)row(out,'Estimated SC refund after filing',wh-sc);row(out,'Estimated total tax (federal + NIIT + SC)',fed+niit+sc,true);row(out,'Net after taxes and payoff',realized-payoff-fed-niit-sc,true);var notes=['Assumes property held over one year and a 2026 sale under H.4216 rates (5.21% top rate, 44% long-term gain deduction retained).'];if(use==='primary')notes.push('Primary residence: assumes you owned and lived in the home 2 of the last 5 years; depreciation from any rental period is never excludable.');if(use==='inherited')notes.push('Inherited: enter the date-of-death value as basis (stepped-up); gains are usually near zero, and the I-295 affidavit prevents withholding on the full price.');if(nr&&!aff)notes.push('Without the affidavit, withholding runs on the full amount realized, capped at net proceeds; you recover the excess only by filing an SC return.');notes.push('Educational estimate only. Not tax or legal advice; brackets stack simplistically here and your CPA should prepare the I-295 gain figure.');$('cg-note').textContent=notes.join(' ')}f.forEach(function(el){['input','change'].forEach(function(ev){el.addEventListener(ev,calc)})});calc();})();</script></div></section>
 
