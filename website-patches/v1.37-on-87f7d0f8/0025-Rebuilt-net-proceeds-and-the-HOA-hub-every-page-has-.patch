d:linear-gradient(180deg,rgba(255,255,255,.76),rgba(255,255,255,.52));border:1px solid var(--g-edge,rgba(255,255,255,.8));box-shadow:var(--g-hi,none),var(--g-sh,none)}main#main .c3-place-cta>p:first-child{flex:1 1 18rem;margin:0;color:var(--navy);font-size:var(--read,1.0625rem);line-height:1.55}main#main .c3-place-cta .c3-offer{margin:0;flex:0 1 auto}@media (prefers-reduced-transparency:reduce){main#main .c3-place-cta{background:#fbf8f3}}main#main .detail-hero .detail-sub{display:none}</style><style>main#main .hx-strip:empty{display:none}main#main .hx-strip:not(:empty)+.hx-fallback{display:none}</style><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}@media (max-width:699px){main#main .c3-gchart.c3-gchart-list [role=row]{grid-template-columns:minmax(0,1fr) auto;column-gap:.8rem;align-items:start}main#main .c3-gchart.c3-gchart-list .b{display:none}main#main .c3-gchart.c3-gchart-list .dot{display:none}main#main .c3-gchart.c3-gchart-list .f{display:block}main#main .c3-gchart.c3-gchart-list [role=cell]{justify-content:flex-end}}</style><figure class="c3-gchart c3-gchart-compact c3-gchart-list"><div role="table" aria-label="About half the price of a Myrtle Beach home"><span class="cap" aria-hidden="true">About half the price of a Myrtle Beach home</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Place, best feature</span><span role="columnheader">Usually sold for</span></div></div><div role="rowgroup"><div role="row" class="ref"><span role="rowheader"><span class="n">A Myrtle Beach home</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">$420,000</span></span></div><div role="row"><span role="rowheader"><span class="n"><a href="#parkview">1. Parkview</a></span><span class="dot" aria-hidden="true">&middot;</span><span class="f">4 min to the beach</span></span><span role="cell"><span class="b" style="--f:0.451" aria-hidden="true"></span><span class="v">$190,000</span></span></div><div role="row"><span role="rowheader"><span class="n"><a href="#fairways-at-wild-wing">2. Fairways at Wild Wing</a></span><span class="dot" aria-hidden="true">&middot;</span><span class="f">golf, lawn care</span></span><span role="cell"><span class="b" style="--f:0.51" aria-hidden="true"></span><span class="v">$215,000</span></span></div><div role="row"><span role="rowheader"><span class="n"><a href="#sawgrass-east">3. Sawgrass East</a></span><span class="dot" aria-hidden="true">&middot;</span><span class="f">garage, lawn care</span></span><span role="cell"><span class="b" style="--f:0.528" aria-hidden="true"></span><span class="v">$225,000</span></span></div><div role="row"><span role="rowheader"><span class="n"><a href="#birchwood">4. Birchwood</a></span><span class="dot" aria-hidden="true">&middot;</span><span class="f">paddle the Waccamaw</span></span><span role="cell"><span class="b" style="--f:0.531" aria-hidden="true"></span><span class="v">$225,000</span></span></div><div role="row"><span role="rowheader"><span class="n"><a href="#golf-and-yacht-club">5. Golf and Yacht Club</a></span><span class="dot" aria-hidden="true">&middot;</span><span class="f">gated, one story</span></span><span role="cell"><span class="b" style="--f:0.534" aria-hidden="true"></span><span class="v">$225,000</span></span></div><div role="row"><span role="rowheader"><span class="n"><a href="#forestbrook-village">6. Forestbrook Village</a></span><span class="dot" aria-hidden="true">&middot;</span><span class="f">up to 2,400 sq ft</span></span><span role="cell"><span class="b" style="--f:0.551" aria-hidden="true"></span><span class="v">$230,000</span></span></div><div role="row"><span role="rowheader"><span class="n"><a href="#victory-point">7. Victory Point</a></span><span class="dot" aria-hidden="true">&middot;</span><span class="f">new townhomes</span></span><span role="cell"><span class="b" style="--f:0.559" aria-hidden="true"></span><span class="v">$235,000</span></span></div><div role="row"><span role="rowheader"><span class="n"><a href="#amber-bluff">8. Amber Bluff</a></span><span class="dot" aria-hidden="true">&middot;</span><span class="f">smart homes, CCU 6 min</span></span><span role="cell"><span class="b" style="--f:0.564" aria-hidden="true"></span><span class="v">$240,000</span></span></div><div role="row"><span role="rowheader"><span class="n"><a href="#villas-at-sandridge">9. Villas at Sandridge</a></span><span class="dot" aria-hidden="true">&middot;</span><span class="f">5 min to a wake park</span></span><span role="cell"><span class="b" style="--f:0.582" aria-hidden="true"></span><span class="v">$245,000</span></span></div><div role="row"><span role="rowheader"><span class="n"><a href="#indigo-grove">10. Indigo Grove</a></span><span class="dot" aria-hidden="true">&middot;</span><span class="f">22 acres open space</span></span><span role="cell"><span class="b" style="--f:0.582" aria-hidden="true"></span><span class="v">$245,000</span></span></div><div role="row"><span role="rowheader"><span class="n"><a href="#wynbrooke">11. Wynbrooke</a></span><span class="dot" aria-hidden="true">&middot;</span><span class="f">MarshWalk 5 min away</span></span><span role="cell"><span class="b" style="--f:0.592" aria-hidden="true"></span><span class="v">$250,000</span></span></div><div role="row"><span role="rowheader"><span class="n"><a href="#polo-farms">12. Polo Farms</a></span><span class="dot" aria-hidden="true">&middot;</span><span class="f">fenced yards, $20 fee</span></span><span role="cell"><span class="b" style="--f:0.605" aria-hidden="true"></span><span class="v">$255,000</span></span></div></div></div><figcaption>Tap a name to read about it.</figcaption></figure></div></section><section style="background:var(--ivory)" id="parkview"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Parkview">1. Parkview: townhomes by the city's golf course, near the beach</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Parkview is a four-minute drive from the beach. Its townhomes are off 17th Avenue South, inside the city of Myrtle Beach, around ponds and a pool for owners.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Built in the mid-2000s, the townhomes have about 1,050 to 1,350 square feet and two or three bedrooms. Many have vaulted ceilings and a front porch, and some have a screened porch.</p><div class="hx-strip" data-place="parkview" data-name="Parkview"></div><div class="hx-fallback"><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/buyers/affordable/parkview-and-whispering-pines-from-above-1200w.webp" srcset="/images/buyers/affordable/parkview-and-whispering-pines-from-above-600w.webp 600w, /images/buyers/affordable/parkview-and-whispering-pines-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Aerial view of townhomes around a pond beside a road, with golf course fairways and ponds to the southwest, with labels" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="Photo: USDA Farm Service Agency, NAIP. License: Public domain" title="License: Public domain">Photo: USDA Farm Service Agency, NAIP</a></span></div><figcaption>Parkview, beside 17th Avenue South, with Whispering Pines Golf Course, from above.</figcaption></figure></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Whispering Pines, the <a href="https://www.cityofmyrtlebeach.com/i_want_to/find/whispering_pines_golf_course.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">city's own 18-hole golf course</a>, is less than a quarter mile from Parkview. It was originally part of the Myrtle Beach Air Force Base, and its tee markers feature the squadron emblems. Residents of Horry, Georgetown and Brunswick counties play a round there for $45 plus tax, with a cart.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">There are about 200 townhomes here, and the HOA fee includes water, sewer, grounds care and the pool. For dinner and a movie, The Market Common has shops, restaurants and a theater.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Few of these townhomes come up for sale in a year, so one of our agents watches for each new listing.</p><p class="c3-place-price">Townhomes here usually sold for about $190,000 last year, with an HOA fee of about $325 a month.</p></div></section><section style="background:var(--ivory-2)" id="fairways-at-wild-wing"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Fairways at Wild Wing">2. The Fairways at Wild Wing: townhomes in a golf community</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Fairways townhomes usually have two stories and three or four bedrooms. Most have their own garage, some with room for two cars, and some put the main bedroom downstairs.</p><div class="hx-strip" data-place="fairways-at-wild-wing" data-name="The Fairways at Wild Wing"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">They are inside Wild Wing Plantation, a golf club, and some are near the course. The HOA fee usually includes the lawn care, the pool and the internet, so a Saturday can go to golf instead of yard work.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Fairways is inside Conway's city limits, where the yearly tax is higher than outside a town.</p><p class="c3-place-price">Fairways townhomes usually sold for about $215,000 last year, and the HOA fee is about $390 a month.</p></div></section><section style="background:var(--ivory)" id="sawgrass-east"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Sawgrass East">3. Sawgrass East: townhomes where the fee covers the insurance and the lawn</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">At Sawgrass East, the HOA fee usually pays the insurance on the buildings, the lawn care, and the water, sewer and trash. In most townhomes here, an owner has no water or trash bill of their own, and the HOA cares for the lawns.</p><div class="hx-strip" data-place="sawgrass-east" data-name="Sawgrass East"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Many of the townhomes have three bedrooms, often with a one-car garage and the main bedroom downstairs.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">There are about 255 of them, built in the mid-2000s, around three small lakes that the HOA owns, with a pool and a clubhouse for owners. The county's Carolina Forest library and recreation center are on the boulevard that leads in.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The beach is about ten miles away by road, so a beach day means a drive.</p><p class="c3-place-price">Sawgrass East townhomes usually sold for about $225,000 last year, and the HOA fee is about $425 a month.</p></div></section><section style="background:var(--ivory-2)" id="birchwood"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Birchwood">4. Birchwood: a new house on a quarter acre</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Birchwood is small: 77 lots, with new Lennar houses on lots of about a quarter acre and about 12 acres of open space. A quarter acre gives a new house a real backyard at this price.</p><div class="hx-strip" data-place="birchwood" data-name="Birchwood"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Chris Anderson Landing, a county boat ramp on the Waccamaw River, is about 7 minutes from Birchwood by car. From there you can paddle the state's Waccamaw River trail downriver through bald cypress woods, about 20 miles to Red Bluff Landing.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">FEMA maps every lot in Birchwood as an area of minimal flood hazard. High-speed internet is included in the monthly dues.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A new house here sells for about what a 1980s house does in the Golf and Yacht Club, closer to Myrtle Beach. Birchwood is off SC 905, southwest of Longs, and North Myrtle Beach and its beaches are about 20 minutes by car.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The long drive is to Myrtle Beach: Coastal Grand Mall is about a forty-minute drive, by the Carolina Bays Parkway.</p><p class="c3-place-price">New houses in Birchwood usually sold for about $225,000 last year; the HOA fee is about $120 a month.</p></div></section><section style="background:var(--ivory)" id="golf-and-yacht-club"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Golf and Yacht Club">5. Myrtle Beach Golf and Yacht Club: one-story houses behind a gate</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The older part of Myrtle Beach Golf and Yacht Club has about 470 houses inside a gate, most of them one story. For a boat, Osprey Marina has wet slips and dry boat storage on the Intracoastal Waterway, about four miles away by road.</p><div class="hx-strip" data-place="golf-and-yacht-club" data-name="Myrtle Beach Golf and Yacht Club"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most houses there were built in the 1980s, with two or three bedrooms and two baths. They typically have about 1,200 square feet, on about an eighth of an acre, and many have a porch or a patio.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Owners share a pool and hot tub, tennis courts and a community center.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Age matters here. Insurers may require an older home to have an updated roof, wiring, plumbing and heating, so we have the home inspector look at each before you buy.</p><p class="c3-place-price">Houses in the older part usually sold for about $225,000 last year, and the HOA fee is about $95 a month.</p></div></section><section style="background:var(--ivory-2)" id="forestbrook-village"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Forestbrook Village">6. Forestbrook Village: new townhome plans up to 2,400 square feet</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">At Forestbrook Village, Lennar has four townhome plans, from about 1,450 up to 2,400 square feet. Lennar is still building here, so some of these townhomes are brand new.</p><div class="hx-strip" data-place="forestbrook-village" data-name="Forestbrook Village"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The townhomes are off Forestbrook Road, south of US 501, beside the older Forestbrook neighborhood. Owners have a pool and a playground, and internet and grounds care are included.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Near Forestbrook Village, <a href="https://www.arrowheadcc.com/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Arrowhead Country Club</a> has 27 holes of golf along the Intracoastal Waterway. Water comes into play on 24 of them.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Some lots here are in a high-risk flood zone, where a lender usually requires flood insurance, so the lot can matter as much as the plan.</p><p class="c3-place-price">Lennar's townhomes here usually sold for about $230,000 last year, with an HOA fee of about $170 a month.</p></div></section><section style="background:var(--ivory)" id="victory-point"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Victory Point">7. Victory Point: new townhomes on part of the old speedway</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Victory Point is built on part of the old Myrtle Beach Speedway. The track <a href="https://www.myhorrynews.com/visit/race-to-myrtle-beach-speedway-for-the-nascar-experience/article_494efd18-8ab0-11e8-825d-ef4e52fa72ee.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">opened in 1958</a> as RAMBI Raceway, and cars ran their <a href="https://www.wmbfnews.com/2024/07/10/old-myrtle-beach-speedway-being-transformed-into-townhome-community" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">last laps there in 2020</a>. Several streets have racing names: Speedway Street, Talladega Drive and Pit Crew Drive.</p><div class="hx-strip" data-place="victory-point" data-name="Victory Point"></div><div class="hx-fallback"><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/buyers/affordable/old-speedway-and-victory-point-labelled-from-above-1200w.webp" srcset="/images/buyers/affordable/old-speedway-and-victory-point-labelled-from-above-600w.webp 600w, /images/buyers/affordable/old-speedway-and-victory-point-labelled-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Aerial view of an empty oval dirt race track beside a divided highway, with labels for the track, US 501 and where Victory Point's townhomes are now" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="Photo: USDA Farm Service Agency, NAIP. License: Public domain" title="License: Public domain">Photo: USDA Farm Service Agency, NAIP</a></span></div><figcaption>The old Myrtle Beach Speedway beside US 501, before Victory Point was built on part of its land.</figcaption></figure></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The townhomes are new, three-bedroom and about 1,450 square feet. Lennar built them off US 501, by Tanger Outlets, with a pool, a playground, a picnic area and a pond.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Lennar lists Victory Point as sold out for now, so we watch for resales.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Expect more building. Another owner plans <a href="https://www.myhorrynews.com/news/for-rent-townhome-community-breaks-ground-in-carolina-forest/article_bc89fa83-1610-4e28-ad33-58e653b0135c.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">194 townhomes for rent</a> on about 20 acres of the old speedway land beside it.</p><p class="c3-place-price">Townhomes in Victory Point usually sold for about $235,000 last year, and the HOA fee is about $235 a month.</p></div></section><section style="background:var(--ivory-2)" id="amber-bluff"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Amber Bluff">8. The Townes at Amber Bluff: smart-home townhomes about 6 minutes from the football stadium</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Every townhome at Amber Bluff came with a smart-home package: you can control the front door lock, the thermostat and the video doorbell from your phone.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Off Savannah Bluff Road, <a href="https://www.drhorton.com/south-carolina/myrtle-beach/conway/the-townes-at-amber-bluff" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">D.R. Horton builds one plan</a>, the Pearson. It has two stories and a one-car garage, in about 1,420 square feet.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On game days, Brooks Stadium, where the Chanticleers play football, is about a six-minute drive. Coastal Carolina University and Horry-Georgetown Technical College are about as close, for a class or a job.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Downtown Conway, with its shops on Main Street and its riverwalk on the Waccamaw River, is about a seven-minute drive.</p><div class="hx-strip" data-place="amber-bluff" data-name="The Townes at Amber Bluff"></div><div class="hx-fallback"><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/buyers/affordable/conway-main-street-downtown-1200w.webp" srcset="/images/buyers/affordable/conway-main-street-downtown-600w.webp 600w, /images/buyers/affordable/conway-main-street-downtown-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Main Street in downtown Conway, South Carolina, with a row of two-story brick and stone shop buildings, street trees and parked cars under a blue sky" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/publicdomain/mark/1.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: Pubdog. License: Public domain" title="License: Public domain">Photo: Pubdog</a></span></div><figcaption>Main Street in downtown Conway, the downtown closest to Amber Bluff.</figcaption></figure></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Each owner will also pay a yearly insurance assessment that is not yet set. We find out what it will be for any home you like.</p><p class="c3-place-price">These townhomes usually sold for about $240,000 last year, with an HOA fee of about $100 a month.</p></div></section><section style="background:var(--ivory)" id="villas-at-sandridge"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Villas at Sandridge">9. Villas at Sandridge: townhomes five minutes from a cable wake park</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">At Shark Wake Park, a five-minute drive from Villas at Sandridge, a cable pulls wakeboard riders across the water. It is inside the <a href="https://www.sctrails.net/trails/trail/north-myrtle-beach-park-and-sports-complex" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">North Myrtle Beach Park and Sports Complex</a>, which also has walking trails, two dog parks and an accessible playground.</p><div class="hx-strip" data-place="villas-at-sandridge" data-name="Villas at Sandridge"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Villas at Sandridge is a small community of 79 townhomes off SC 90 near Little River, with about 8 acres of shared open space. Dream Finders Homes built them with two stories and a one-car garage, and some plans have the main bedroom on the first floor.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The city's <a href="https://nmb.us/802/North-Myrtle-Beach-Park-Sports-Complex-E" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">new section of the park</a> has added soccer and baseball fields, ponds, trails and two more playgrounds. The nearest beach is a seven-minute trip by car.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Expect higher dues here than at the other new communities on this list.</p><p class="c3-place-price">These townhomes usually sold for about $245,000 last year, and the dues are about $300 a month.</p></div></section><section style="background:var(--ivory-2)" id="indigo-grove"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Indigo Grove">10. Indigo Grove: new houses on open land, 13 minutes from the beach</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most of Indigo Grove's new houses back onto about 22 acres of open space that the HOA owns. The beach is about 13 minutes away by car.</p><div class="hx-strip" data-place="indigo-grove" data-name="Indigo Grove"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The open land holds three new ponds, one with a small island of trees, and strips of woods along a creek. The neighborhood is off SC 90, and its homes are zoned for Riverside Elementary and North Myrtle Beach Middle and High.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most of the houses are Lennar's, which sells them as The Overlook. <a href="https://www.lennar.com/new-homes/south-carolina/myrtle-beach/longs/the-overlook" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Lennar lists nine floor plans</a> with three to five bedrooms, some of them one story, on lots of about a fifth of an acre.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Every lot is outside the high-risk flood zone, so a lender usually will not require flood insurance on a home here.</p><p class="c3-place-price">New houses here usually sold for about $245,000 last year, with an HOA fee of about $80 a month.</p></div></section><section style="background:var(--ivory)" id="wynbrooke"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Wynbrooke">11. Wynbrooke: townhomes five minutes from the Murrells Inlet MarshWalk</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">At the <a href="https://www.marshwalk.com/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Murrells Inlet MarshWalk</a>, five minutes from Wynbrooke, the restaurants on the marsh have live music every night, and there is never a cover charge.</p><div class="hx-strip" data-place="wynbrooke" data-name="Wynbrooke"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="https://southcarolinaparks.com/huntington-beach" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Huntington Beach State Park</a>, with three miles of beach, is 10 minutes away.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The townhomes, built in the early 2000s, are off SC 707, around ponds, and some back onto the water. Many have a screened porch and a loft.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Wynbrooke's HOA fee is the highest of the twelve, though it usually pays for the insurance on the buildings and for the grounds care.</p><p class="c3-place-price">Townhomes in Wynbrooke usually sold for about $250,000 last year, with an HOA fee of about $450 a month.</p></div></section><section style="background:var(--ivory-2)" id="polo-farms"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Polo Farms">12. Polo Farms: one-story houses with fenced yards</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Many backyards in Polo Farms are fenced, and several have their own pool. That is room for a dog to run and a swim at home, in a house of your own for about the price of a townhome in Wynbrooke.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most of the houses are one story, with three bedrooms, on lots of about a fifth of an acre. They are off SC 905, west of Longs, and were built in three phases, from the mid-2000s on.</p><div class="hx-strip" data-place="polo-farms" data-name="Polo Farms"></div><div class="hx-fallback"><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/buyers/affordable/polo-farms-and-simpson-creek-from-above-1200w.webp" srcset="/images/buyers/affordable/polo-farms-and-simpson-creek-from-above-600w.webp 600w, /images/buyers/affordable/polo-farms-and-simpson-creek-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Aerial view of a neighborhood of houses with fenced yards and two ponds, a creek curving past it and a highway, with labels for Polo Farms, SC 905 and Simpson Creek" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="Photo: USDA Farm Service Agency, NAIP. License: Public domain" title="License: Public domain">Photo: USDA Farm Service Agency, NAIP</a></span></div><figcaption>Polo Farms off SC 905, with Simpson Creek along its southwest side.</figcaption></figure></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Flood is a concern here. After Hurricane Florence in 2018, the Waccamaw River rose to historic heights; <a href="https://www.wmbfnews.com/2018/11/29/wmbf-investigates-did-poor-planning-lead-flooding-longs-community/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">floodwater filled the streets</a> and gutted homes across the neighborhood. More than four in ten of its lots are in a high-risk flood zone. Before you make an offer, we look up the lot on FEMA's flood map.</p><p class="c3-place-price">Houses in Polo Farms usually sold for about $255,000 last year, and the HOA fee is about $20 a month.</p></div></section><section style="background:var(--ivory)" id="schools"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Cost, beach and schools">How do the twelve compare on yearly cost, the beach and schools?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The map shows where each place is, and the table gives the HOA fee and tax a year, the drive to a beach and the zoned schools. To choose by what you want nearby, read our guide to the <a href="/buyers/best-neighborhoods/" style="color:var(--navy);text-decoration:underline">best neighborhoods near Myrtle Beach</a>. For no HOA fee at all, see our guide to <a href="/buyers/no-hoa-homes/" style="color:var(--navy);text-decoration:underline">homes with no HOA</a>. To compare one Carolina Forest neighborhood in depth, see <a href="/submarkets/carolina-forest/the-farm/" style="color:var(--navy);text-decoration:underline">what it is like to live in The Farm at Carolina Forest</a>.</p><style>.c3-cmp{margin:1.2rem 0 1.6rem;max-width:900px}.c3-cmp .t{overflow-x:auto}.c3-cmp table{width:100%;border-collapse:collapse;font-size:.98rem;line-height:1.4}.c3-cmp caption{caption-side:top;text-align:left;color:var(--navy);font-weight:600;padding:0 0 .6rem}.c3-cmp th,.c3-cmp td{text-align:left;padding:.45rem .8rem .45rem 0;border-top:1px solid var(--line,#e3ddd0);vertical-align:top}.c3-cmp thead th{border-top:0;color:var(--navy)}.c3-cmp td{color:var(--muted)}.c3-cmp tbody th{color:var(--navy);font-weight:500}.c3-cmp th a{color:var(--navy)}@media (max-width:599px){.c3-cmp table{font-size:.92rem}}</style><figure class="c3-cmp"><figure style="margin:1.8rem 0;max-width:760px"><svg xmlns="http://www.w3.org/2000/svg" id="c3r-affordable-neighborhoods" viewBox="0 0 360 430" width="360" height="430" role="img" aria-label="Affordable neighborhoods near Myrtle Beach: a map of 12 places, numbered 1, Parkview; 2, Fairways at Wild Wing; 3, Sawgrass East; 4, Birchwood; 5, Golf and Yacht Club; 6, Forestbrook Village; 7, Victory Point; 8, Amber Bluff; 9, Villas at Sandridge; 10, Indigo Grove; 11, Wynbrooke; and 12, Polo Farms." style="display:block;width:100%;height:auto;max-width:760px;background:#f7f3ec;border:1px solid rgba(28,32,40,.15)"><style>#c3r-affordable-neighborhoods text{font-family:'DM Sans',system-ui,-apple-system,'Segoe UI',sans-serif;paint-order:stroke;stroke:#f7f3ec;stroke-width:3px;stroke-linejoin:round;fill:#1c2028}#c3r-affordable-neighborhoods .h{font:500 17px 'Fraunces',Georgia,serif}#c3r-affordable-neighborhoods .l{font-size:14px;font-weight:500}#c3r-affordable-neighborhoods .m{font-size:13px;font-weight:500;fill:#91592b}#c3r-affordable-neighborhoods .t{font-