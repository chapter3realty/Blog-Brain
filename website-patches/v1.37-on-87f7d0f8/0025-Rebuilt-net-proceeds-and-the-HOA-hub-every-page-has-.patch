ct x="13" y="-10.7" width="78.6" height="21.5" rx="10" fill="#ffffff" fill-opacity=".9" stroke="#ffffff" stroke-width=".8"/><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="nm" y="4.5" text-anchor="middle">5</text><text class="l" x="15" y="5.3"><tspan x="15">Socastee</tspan></text></g></g><g transform="translate(43.2 339.2)"><g class="k"><rect x="13" y="-9.4" width="234" height="21.5" rx="10" fill="#1c2028" fill-opacity=".1"/><rect x="13" y="-10.7" width="234" height="21.5" rx="10" fill="#ffffff" fill-opacity=".9" stroke="#ffffff" stroke-width=".8"/><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="nm" y="4.5" text-anchor="middle">6</text><text class="l" x="15" y="5.3"><tspan x="15">Murrells Inlet and Garden City</tspan></text></g></g><g transform="translate(289.9 141.8)"><g class="k"><rect x="-121.2" y="-18.2" width="108.2" height="39" rx="10" fill="#1c2028" fill-opacity=".1"/><rect x="-121.2" y="-19.5" width="108.2" height="39" rx="10" fill="#ffffff" fill-opacity=".9" stroke="#ffffff" stroke-width=".8"/><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="nm" y="4.5" text-anchor="middle">7</text><text class="l" x="-15" y="-3.5" text-anchor="end"><tspan x="-15">North</tspan><tspan x="-15" dy="17.5">Myrtle Beach</tspan></text></g></g><g transform="translate(170.2 222.7)"><g class="k"><rect x="13" y="-9.4" width="108.2" height="21.5" rx="10" fill="#1c2028" fill-opacity=".1"/><rect x="13" y="-10.7" width="108.2" height="21.5" rx="10" fill="#ffffff" fill-opacity=".9" stroke="#ffffff" stroke-width=".8"/><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="nm" y="4.5" text-anchor="middle">8</text><text class="l" x="15" y="5.3"><tspan x="15">Myrtle Beach</tspan></text></g></g><g transform="translate(245.7 65.2)"><g class="k"><rect x="13" y="-9.4" width="55.6" height="21.5" rx="10" fill="#1c2028" fill-opacity=".1"/><rect x="13" y="-10.7" width="55.6" height="21.5" rx="10" fill="#ffffff" fill-opacity=".9" stroke="#ffffff" stroke-width=".8"/><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="nm" y="4.5" text-anchor="middle">9</text><text class="l" x="15" y="5.3"><tspan x="15">Longs</tspan></text></g></g></g></svg><figcaption style="color:var(--muted);font-size:.85rem;line-height:1.6;margin-top:.6rem">Each number marks where an area's quick resales were, in the order of the chart below. The areas are ZIP codes. Another 13 resales around Loris, Aynor and Green Sea were too few to show. Map data: U.S. Census Bureau TIGER/Line; Horry County GIS.</figcaption></figure><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}@media (max-width:699px){main#main .c3-gchart.c3-gchart-list [role=row]{grid-template-columns:minmax(0,1fr) auto;column-gap:.8rem;align-items:start}main#main .c3-gchart.c3-gchart-list .b{display:none}main#main .c3-gchart.c3-gchart-list .dot{display:none}main#main .c3-gchart.c3-gchart-list .f{display:block}main#main .c3-gchart.c3-gchart-list [role=cell]{justify-content:flex-end}}</style><figure class="c3-gchart c3-gchart-compact c3-gchart-list"><div role="table" aria-label="Middle gain on a home resold within 12 months, by area"><span class="cap" aria-hidden="true">Middle gain on a home resold within 12 months, by area</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Area, resales, what sold and middle price paid</span><span role="columnheader">middle gain</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Conway</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">47 resales, mostly houses, paid $200,000</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">$66,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Carolina Forest</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">41 resales, mostly houses, paid $205,000</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">$66,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Surfside Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">30 resales, mostly condos, paid $181,000</span></span><span role="cell"><span class="b" style="--f:0.871" aria-hidden="true"></span><span class="v">$58,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Little River</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">32 resales, mostly houses, paid $176,000</span></span><span role="cell"><span class="b" style="--f:0.849" aria-hidden="true"></span><span class="v">$56,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Socastee</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">32 resales, mostly houses, paid $206,000</span></span><span role="cell"><span class="b" style="--f:0.494" aria-hidden="true"></span><span class="v">$33,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Murrells Inlet and Garden City</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">20 resales, mostly houses, paid $308,000</span></span><span role="cell"><span class="b" style="--f:0.405" aria-hidden="true"></span><span class="v">$27,000</span></span></div><div role="row"><span role="rowheader"><span class="n">North Myrtle Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">33 resales, mostly houses, paid $455,000</span></span><span role="cell"><span class="b" style="--f:0.348" aria-hidden="true"></span><span class="v">$23,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Myrtle Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">81 resales, mostly condos, paid $150,000</span></span><span role="cell"><span class="b" style="--f:0.333" aria-hidden="true"></span><span class="v">$22,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Longs</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">15 resales, mostly houses, paid $166,000</span></span><span role="cell"><span class="b" style="--f:0.258" aria-hidden="true"></span><span class="v">$17,000</span></span></div></div></div></figure></div></section><section style="background:var(--ivory-2)" id="how-we-find-them"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="How we find them">How do we find a house worth flipping?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our agents use a deal finder we built to look at every home for sale on the Grand Strand in one pass. An agent checks everything it finds:</p><ol style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem"><strong>A reason to be cheap.</strong> It pulls every house for sale that has one: a distressed sale, a <a href="/invest/foreclosures/" style="color:var(--navy);text-decoration:underline">foreclosure</a>, a short sale, or an older house at the low end of the price range.</li><li style="margin-bottom:.5rem"><strong>The nearby sales.</strong> For the cheapest houses per square foot, it finds houses of about the same size that sold within a mile in the last year.</li><li style="margin-bottom:.5rem"><strong>The list.</strong> The houses furthest under the middle of their nearby sales make the list. It reads the photos and description of the top ones and lists the repairs it can see, with a cost range for each.</li><li style="margin-bottom:.5rem"><strong>The agent's call.</strong> An agent reads the sales, decides what the house will sell for once it is fixed, and works out your highest offer. That number comes from an agent who knows the streets, never from a computer.</li></ol><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A house far under its neighbors is not always a deal. Sometimes the size in the listing is wrong, the price is an auction's opening bid, or the house needs everything. The finder marks those, and the agent finds out which it is before you spend a dollar.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">What you get on the flip list</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">For each house: its asking price per square foot against the middle of its nearby sales, the six nearest sales, the repairs its photos show with a cost range, and your highest offer by the 70 percent rule. Tell us your price range.</p><a class="btn btn-brass" href="/contact/">Get the flip list</a></div></div></section><section style="background:var(--ivory)" id="the-math"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The math">How do you work out what to offer?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Every flip starts with the after-repair value, what the house will sell for once it is fixed up. Take that number and subtract everything you spend. What is left is your profit.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Many flippers use the 70 percent rule to set their highest offer: 70 percent of the after-repair value, minus the repairs. On a house that will sell for $300,000 fixed up and needs $45,000 of work, that is $165,000. The 30 percent left over covers your costs and your profit.</p><div class="c3-flipcalc" style="background:var(--navy);border-radius:12px;padding:1.5rem 1.6rem;margin:1.6rem 0;max-width:600px"><p style="font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass-2);margin-bottom:.9rem">Run your own deal</p><div style="display:grid;gap:.75rem"><label style="display:flex;justify-content:space-between;align-items:center;gap:1rem;color:rgba(244,239,232,.9);font-family:var(--sans);font-size:.93rem">What it sells for fixed up<span style="white-space:nowrap;color:rgba(244,239,232,.55)">$ <input id="flipArv" type="number" min="0" step="1000" value="300000" oninput="c3Flip()" aria-label="What it sells for fixed up in dollars" style="width:132px;background:rgba(244,239,232,.12);border:1px solid rgba(244,239,232,.34);border-radius:6px;color:#f4efe8;font-family:var(--sans);font-size:.95rem;padding:.42rem .55rem;text-align:right"></span></label><label style="display:flex;justify-content:space-between;align-items:center;gap:1rem;color:rgba(244,239,232,.9);font-family:var(--sans);font-size:.93rem">What you pay<span style="white-space:nowrap;color:rgba(244,239,232,.55)">$ <input id="flipPaid" type="number" min="0" step="1000" value="200000" oninput="c3Flip()" aria-label="What you pay in dollars" style="width:132px;background:rgba(244,239,232,.12);border:1px solid rgba(244,239,232,.34);border-radius:6px;color:#f4efe8;font-family:var(--sans);font-size:.95rem;padding:.42rem .55rem;text-align:right"></span></label><label style="display:flex;justify-content:space-between;align-items:center;gap:1rem;color:rgba(244,239,232,.9);font-family:var(--sans);font-size:.93rem">Repairs<span style="white-space:nowrap;color:rgba(244,239,232,.55)">$ <input id="flipRehab" type="number" min="0" step="1000" value="45000" oninput="c3Flip()" aria-label="Repairs in dollars" style="width:132px;background:rgba(244,239,232,.12);border:1px solid rgba(244,239,232,.34);border-radius:6px;color:#f4efe8;font-family:var(--sans);font-size:.95rem;padding:.42rem .55rem;text-align:right"></span></label><label style="display:flex;justify-content:space-between;align-items:center;gap:1rem;color:rgba(244,239,232,.9);font-family:var(--sans);font-size:.93rem">Holding and selling costs<span style="white-space:nowrap;color:rgba(244,239,232,.55)">$ <input id="flipCosts" type="number" min="0" step="1000" value="30000" oninput="c3Flip()" aria-label="Holding and selling costs in dollars" style="width:132px;background:rgba(244,239,232,.12);border:1px solid rgba(244,239,232,.34);border-radius:6px;color:#f4efe8;font-family:var(--sans);font-size:.95rem;padding:.42rem .55rem;text-align:right"></span></label></div><div style="display:flex;justify-content:space-between;gap:1rem;align-items:baseline;border-top:1px solid rgba(244,239,232,.22);margin-top:1.15rem;padding-top:1rem;font-family:var(--sans);color:rgba(244,239,232,.9)"><span>Your profit</span><strong id="flipProfit" style="color:var(--brass-2);font-family:var(--serif);font-size:1.7rem;line-height:1">$25,000</strong></div><div style="display:flex;justify-content:space-between;gap:1rem;align-items:baseline;margin-top:.5rem;font-family:var(--sans);color:rgba(244,239,232,.75);font-size:.9rem"><span>Price plus repairs, as a share of the fixed-up value</span><strong id="flipRatio" style="color:var(--ivory)">82%</strong></div><p id="flipVerdict" style="font-family:var(--sans);color:rgba(244,239,232,.72);line-height:1.6;margin:.7rem 0 0;font-size:.92rem">Above the 70 percent most flippers aim for, so this deal leaves little room for the repairs to run over.</p></div><script>function c3Flip(){var g=function(id){var e=document.getElementById(id);var v=e?parseFloat(e.value):NaN;return isFinite(v)&&v>0?v:0};var money=function(n){return "$"+Math.round(n).toLocaleString("en-US")};var pr=document.getElementById("flipProfit"),ra=document.getElementById("flipRatio"),sy=document.getElementById("flipVerdict");if(!pr||!ra||!sy)return;var arv=g("flipArv"),paid=g("flipPaid"),reh=g("flipRehab"),cost=g("flipCosts");var profit=arv-paid-reh-cost;pr.textContent=(profit<0?"-":"")+money(Math.abs(profit));if(!arv){ra.textContent="--";sy.textContent="Enter what the house sells for fixed up.";return}var share=(paid+reh)/arv*100;ra.textContent=Math.round(share)+"%";sy.textContent=profit<=0?"This deal loses money. Lower the price you pay or the repair budget.":share<=70?"Inside the 70 percent most flippers aim for, which leaves room for the repairs to run over.":share<=75?"A little over the 70 percent most flippers aim for.":"Above the 70 percent most flippers aim for, so this deal leaves little room for the repairs to run over."}document.addEventListener("DOMContentLoaded",c3Flip);</script></div></section><section style="background:var(--ivory-2)" id="local-costs"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Local costs">What does a flip cost here besides the house and the repairs?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Four costs bill you every month you own the house: the property tax, the loan, insurance and utilities. The rest come at the two closings, and when you sell, the commission and the deed fee.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The tax is the one most investors miss. A house that is not its owner's own home is taxed on 6 percent of its value, not 4 percent, and it pays the school operating tax.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On a house the county appraises at $250,000, in one of its tax districts outside the cities, that is about $3,015 a year instead of about $919, plus an $89.40 fee on each bill. We work out the bill for the actual address, and every town's rate is in our <a href="/buyers/property-taxes/" style="color:var(--navy);text-decoration:underline">property tax calculator</a>.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The deed fee is $1.85 for each $500 of the price, and the law puts it on the seller: about $962 on a $260,000 sale. If you buy at the county's court-ordered foreclosure sale, you pay the fee on that deed as well.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We also get the insurance quotes for the empty house and the loan's terms, so the monthly cost of holding it is a number, not a guess.</p></div></section><section style="background:var(--ivory)" id="permits"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Permits and licenses">What permits and licenses does a flip need?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In Horry County outside the cities, <a href="https://www.horrycountysc.gov/departments/code-enforcement/permits/building-permit/when-to-get-a-building-permit/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">you need a building permit</a> to build, alter, repair or tear down, and for any electrical, gas, mechanical or plumbing work. South Carolina <a href="https://www.scstatehouse.gov/code/t40c059.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">licenses the people who do the work</a> by the size of the job:</p><style>.c3-cc{margin:1.4rem 0 1.8rem;max-width:960px}.c3-cc table{width:100%;border-collapse:collapse;font-size:var(--read,1.0625rem);line-height:1.45;color:var(--muted)}.c3-cc caption{caption-side:top;text-align:left;color:var(--navy);font-weight:600;font-size:1em;line-height:1.4;padding:0 0 .7rem}.c3-cc th,.c3-cc td{padding:.6rem .7rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule);overflow-wrap:break-word}.c3-cc thead th{color:var(--navy);font-weight:600;font-size:1em;border-bottom:2px solid var(--navy);vertical-align:bottom}.c3-cc tbody th{color:var(--navy);font-weight:600}.c3-cc .n{text-align:right;font-variant-numeric:tabular-nums}.c3-cc .i{display:inline-flex;vertical-align:-4px;margin-right:.45rem;color:var(--brass-ink)}.c3-cc tr.c3-self>*{background:#fff}@media (max-width:39.999em){.c3-cc table,.c3-cc tbody,.c3-cc tr,.c3-cc th,.c3-cc td{display:block;width:auto}.c3-cc caption{display:block}.c3-cc thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.c3-cc tbody tr{background:var(--ivory-2);border-top:3px solid var(--brass);margin:0 0 .8rem;padding:.5rem 0 .6rem}section[style*="background:var(--ivory-2)"] .c3-cc tbody tr{background:var(--ivory)}.c3-cc tr.c3-self{background:#fff!important;border:2px solid var(--brass)}.c3-cc tr.c3-self>*{background:transparent}.c3-cc th,.c3-cc td{border:0;padding:.2rem 1rem}.c3-cc tbody th{display:flex;align-items:center;font-size:1.1em;padding-bottom:.35rem}.c3-cc tbody th .i{flex:none;vertical-align:0}.c3-cc tbody th a{display:inline-block;padding:.5rem 0}.c3-cc .n{text-align:left}.c3-cc td[data-label]::before{content:attr(data-label) ": ";color:var(--navy);font-weight:500}}</style><div class="c3-cc"><table><caption>Permits and licenses for flip work in Horry County</caption><thead><tr><th scope="col">The work</th><th scope="col">County permit</th><th scope="col">Who may do it</th></tr></thead><tbody><tr><th scope="row">Paint, wallpaper, tile, carpet, cabinets, countertops</th><td data-label="County permit">No</td><td data-label="Who may do it">You, or a pro registered with the state</td></tr><tr><th scope="row">A new roof</th><td data-label="County permit">We check first</td><td data-label="Who may do it">A roofer registered with the state</td></tr><tr><th scope="row">Electrical, plumbing, heating and air</th><td data-label="County permit">Yes</td><td data-label="Who may do it">A contractor licensed for the trade</td></tr><tr><th scope="row">Walls, structure, a full renovation</th><td data-label="County permit">Yes</td><td data-label="Who may do it">A licensed builder, for jobs over $5,000</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Before you budget a new roof, we ask the county's code office whether it needs a permit. The county's own pages disagree.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The owner's exemption from the license does not cover a flip. It is only for a house you build or repair to live in, and a sale or rental within two years of finishing is presumed to mean it was done to sell.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Working without the license is a misdemeanor for the contractor, with a fine of $500 to $10,000, at least 30 days in jail, or both. An unlicensed contractor also cannot put a lien on the house or sue to be paid. In the City of Myrtle Beach, <a href="https://www.cityofmyrtlebeach.com/departments/construction_services_department.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">electrical, plumbing, gas and mechanical work</a> each need a trade permit.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Houses built before 1978</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Many of the cheapest houses are old enough to have lead paint. In a house built before 1978, <a href="https://www.epa.gov/lead/renovation-repair-and-painting-program" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">anyone paid to do work that disturbs paint</a> must be certified in lead-safe work. The EPA says the rule applies to a flipper doing their own work too. Small patches are outside it: 6 square feet of paint or less in a room, or 20 square feet or less outside. Replacing windows is always covered.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Houses in a flood zone</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">This is the rule that can end a flip. If the work costs 50 percent or more of the building's value before the work, not counting the land, <a href="https://www.govinfo.gov/content/pkg/CFR-2025-title44-vol1/xml/CFR-2025-title44-vol1-sec59-1.xml" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">the federal flood program</a> calls it a substantial improvement. Work to fix code violations an inspector has cited, and some work on historic buildings, are left out of that count.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In <a href="https://horrycountysc.gov/departments/emergency-management/flooding/build-responsibly/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">unincorporated Horry County</a>, the whole house must then meet the rules for a new building. In a high-risk flood zone marked AE on the flood map, that means a lowest floor at least 3 feet above the flood height shown on the flood map for that spot.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the <a href="https://www.cityofmyrtlebeach.com/services/flood_protection/index.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">City of Myrtle Beach</a>, work on a building in a flood zone that does not meet today's flood rules must cost less than 50 percent of the building's value.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For an older house low to the ground, the rule can mean raising it or keeping the job under the limit. We check the flood zone and the county's building value before you offer, so you know the repair budget the rule allows. Our <a href="/buyers/coastal-insurance/" style="color:var(--navy);text-decoration:underline">coastal insurance</a> page covers flood insurance on the finished house.</p></div></section><section style="background:var(--ivory-2)" id="selling-it"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Selling it">How does a finished flip sell here?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most of our buyers for a finished flip are moving from out of state, or retiring. We spend several thousand dollars a month advertising to buyers moving to the Grand Strand, so a finished flip goes in front of them the day it lists. Lighter repairs sometimes suit the rental buyers on our list before the house reaches the open market.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">One investor here inherited a house and had it fully repaired over about two and a half months. An agent at Chapter3 advertised it for sale while the work was going on. It went under contract a week before the work finished, and it closed for cash the day construction ended. Repaired, the house was worth about $390,000.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Advertise before the work ends. The loan, the tax and the insurance stop the day the house sells.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Plan to list by March. The fewest homes sell here in January and February. Every other month, about 800 to 1,050 sell, and prices move little, so the season gives you more buyers, not a higher price.</p></div></section><section style="background:var(--ivory)" id="selling"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Disclosures and tax">What do you owe when you sell?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">When you sell a house as an investor, you give the buyer <a href="https://www.scstatehouse.gov/code/t27c050.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">South Carolina's property condition disclosure</a>, the same form any owner gives. There is no exemption for investors, and it goes to the buyer before both sides sign.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">When you sell most homes built before 1978, you also give the buyer the EPA's lead pamphlet and a lead disclosure, and the buyer gets 10 days to have the paint tested unless the buyer waives it. If the buyer asks for a termite letter, only a licensed pest control company may issue it.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A gain on a house held one year or less is a <a href="https://www.irs.gov/taxtopics/tc409" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">short-term gain</a>, taxed as ordinary income. If you flip as a business, a house held mainly for sale to customers is not a capital asset, so its gain is not a capital gain at all. A flip also <a href="https://www.irs.gov/businesses/small-businesses-self-employed/like-kind-exchanges-real-estate-tax-tips" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">cannot go into a 1031 exchange</a>.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">South Carolina's 44 percent deduction on capital gains is for property held more than a year, so a flip gets none of it. For 2026, <a href="https://dor.sc.gov/news/information-about-h-4216" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">South Carolina's top rate</a> is 5.21 percent on income above $30,000. Talk to a tax advisor before your first sale.</p></div></section><section style="background:var(--ivory-2)" id="wholesaling"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Wholesaling">Is wholesaling allowed in South Carolina?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not the way it used to work. <a href="https://www.scstatehouse.gov/code/t40c057.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">South Carolina's 2024 license law</a> defines wholesaling as holding a contract to buy a home and then marketing the house to another buyer before you own it. Marketing someone else's property for pay is a broker's work and needs a license. A real estate brokerage and its agents may not wholesale or help a wholesaler. Assigning the contract itself is not wholesaling under the law.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The agents at Chapter3 have sold on the Grand Strand for decades and often hear about discounted houses, such as estate sales and new foreclosures, before they reach the big listing websites.</p></div></section><section style="background:var(--ivory)" id="loans"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Loans and cash">How do you pay for a flip?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Many flips use a hard money loan, a short-term loan that closes quickly and can pay for part of the repairs. Its rate is higher than a normal mortgage, so every extra month you own the house costs you money. Our preferred lender, <a href="https://brickwoodmortgage.com/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">BrickWood Mortgage</a>, offers fix-and-flip and bridge loans, so the purchase, the loan and the repair budget are planned together.</p><p style="font-size:.8rem;color:var(--muted);line-height:1.6;max-width:720px;margin-top:-.2rem;margin-bottom:1rem"><strong style="color:var(--navy)">Disclosure.</strong> Chapter3 Realty Corp has a business relationship with BrickWood Mortgage (NMLS #189497). Because of this relationship, this referral may provide Chapter3 Realty a financial or other benefit. You are never required to use BrickWood. You are free to shop any lender. <a href="/buyers/programs/#afba" style="color:var(--navy);text-decoration:underline">See full AfBA Disclosure.</a></p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Cash is stronger. Bank-owned and off-market houses usually go to the buyer who can close soonest, and cash has no appraisal to fail. It also removes the largest holding cost, the loan interest.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You can still win with a loan off-market, where there is no cash offer to lose to. Our agents talk to owners before a house is listed and learn what the seller needs. Then we build the offer around it: the closing date, a shorter inspection, more earnest money, or a price that pays the seller for waiting on your loan.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Keep a backup plan. We run each address through our <a href="/invest/long-term-rental/" style="color:var(--navy);text-decoration:underline">rental analyzer</a> too, so you know what it would rent for if it does not sell. If it would rent well, you can refinance into a <a href="/invest/strategies/dscr-loans/" style="color:var(--navy);text-decoration:underline">DSCR loan</a>, which is approved on the rent instead of your tax returns, and keep it. That is the <a href="/invest/strategies/brrrr/" style="color:var(--navy);text-decoration:underline">BRRRR strategy</a>: buy, fix, rent, refinance, repeat.</p></div></section><section style="background:var(--ivory-2)" id="fix-and-flip-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Fix and flip FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How long does a flip take in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About six months from purchase to resale. The middle home resold within a year in Horry County sold again 191 days after its purchase, and the middle half took about four to ten months.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I flip a house in Myrtle Beach from out of state?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. A Chapter3 agent walks the house on video, runs the numbers, and lines up the closing attorney and the inspector. Our page for out-of-state buyers explains how a closing works from a distance.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do I have to use BrickWood Mortgage?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. You may use any lender you like. BrickWood Mortgage is our preferred lender for fix-and-flip and bridge loans.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do you need a license to flip houses in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No real estate license is needed to buy and sell a house you own. The contractors you hire need theirs, and the permits section above shows which work needs a license.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeDocType" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County deed index</a>, <a href="https://www.govinfo.gov/content/pkg/CFR-2025-title44-vol1/xml/CFR-2025-title44-vol1-sec59-1.xml" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">44 CFR 59.1</a>, <a href="https://www.horrycountysc.gov/departments/code-enforcement/permits/building-permit/when-to-get-a-building-permit/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County building permits</a>, <a href="https://www.scstatehouse.gov/code/t40c059.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 40-59</a>, <a href="https://www.scstatehouse.gov/code/t40c057.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 40-57</a>, <a href="https://www.epa.gov/lead/renovation-repair-and-painting-program" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">EPA lead rules</a>, <a href="https://www.scstatehouse.gov/code/t27c050.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 27-50</a>, <a href="https://www.scstatehouse.gov/code/t12c043.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-43</a>, <a href="https://www.horrycountysc.gov/media/kufln4qp/tax-levy-2026_2.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County 2026 tax levy</a>, <a href="https://dor.sc.gov/tax/deed-recording-fee" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SCDOR deed recording fee</a>, <a href="https://www.irs.gov/taxtopics/tc409" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">IRS Topic 409</a>. Quick resales: every deed the county recorded over two years, read by Chapter3, placed by the county's parcel map and Census ZIP areas; builder sales and lots left out. Not legal or tax advice.</p></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Want this week's flip list?</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">Tell us your price range. An agent runs our deal finder and sends you the best houses for sale, with the nearby sales and the repairs behind each one.</p><a class="btn btn-brass btn-lg" href="/contact/">Get the flip list</a></div></section></main>
+<main id="main"><div class="detail-hero bg-grid"><div class="wrap"><div class="breadcrumb"><a href="/">Home</a><span>/</span><a href="/invest/">Invest</a><span>/</span><span style="color:var(--muted)">Fix and Flip</span></div><p class="eyebrow" style="margin-bottom:1rem">Strategy</p><h1 class="detail-h1">How do you find a fix and flip in Myrtle Beach?<br/><em style="font-style:italic;color:var(--brass)">Local numbers from the county's deeds.</em></h1><p style="color:var(--muted);font-size:.9rem;margin-bottom:1rem">By <strong style="color:var(--navy);font-weight:600">Devin Day</strong>, Operations Officer &middot; Reviewed by <strong style="color:var(--navy);font-weight:600">Tim Nash</strong>, Broker-in-Charge &middot; <span style="white-space:nowrap">Updated November 9, 2026</span></p><p class="detail-sub">344 quick resales (flips) in the year to September 2026. When a company resold, the middle gain was about $75,000. Houses gained most in Conway, Carolina Forest and Little River.</p></div></div><section style="background:var(--ivory)"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">The short answer</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, a fix and flip can pay here if you buy right. In the year to September 2026, Horry County homes were resold within 12 months of their last sale at least 344 times. When a company resold the home, the middle gain between the two deed prices was about $75,000, before any costs. Conway, Carolina Forest and Little River had the biggest gains on houses.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our deal finder pulls every house for sale with a reason to be cheap and compares it with what houses its size sold for nearby. An agent then reads the repairs and works out your highest offer.</p></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><p style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">The best houses for sale this week, in your price range</p><a class="btn btn-brass btn-lg" href="/contact/">Get the flip list</a></div></section><section style="background:var(--ivory);padding-top:2.5rem"><div class="wrap"><nav aria-label="On this page" style="margin-top:0;max-width:720px"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.3rem;font-weight:600">On this page</p><ul style="list-style:none;margin:0;padding:0"><li><a href="#local-numbers" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Local numbers</a></li><li><a href="#where" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Where</a></li><li><a href="#how-we-find-them" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">How we find them</a></li><li><a href="#the-math" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">The math</a></li><li><a href="#local-costs" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Local costs</a></li><li><a href="#permits" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Permits and licenses</a></li><li><a href="#selling-it" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Selling it</a></li><li><a href="#selling" style="display:block;padding:.65rem 0;color:var