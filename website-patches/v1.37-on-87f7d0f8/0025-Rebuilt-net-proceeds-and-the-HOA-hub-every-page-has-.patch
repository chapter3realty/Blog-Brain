+out["flood_policy_per_unit_year"] = {"all": R["all"], "zone_V": R["zone_V"], "asOfDate": R["asOfDate"]}
+out["flood_policy_per_unit_month_median"] = round(R["all"]["per_unit_median"] / 12)
