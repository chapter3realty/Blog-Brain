m .6rem;background:rgba(255,255,255,.55);border:1px solid var(--rule);border-radius:6px;line-height:1.25}.c3-glance .i{flex:0 0 auto;display:flex;width:2rem;height:2rem;border-radius:50%;background:var(--ivory-2);color:var(--brass-ink);align-items:center;justify-content:center}.c3-glance strong{display:block;color:var(--navy);font-size:.9rem;font-weight:500}.c3-glance span.t{display:block;color:var(--muted);font-size:1rem}@media (max-width:699px){.c3-glance{gap:.3rem}.c3-glance li{flex-direction:column;justify-content:flex-start;text-align:center;gap:.2rem;padding:.4rem .1rem}.c3-glance .i{width:1.6rem;height:1.6rem}.c3-glance strong{font-size:.875rem}.c3-glance span.t{font-size:1rem;line-height:1.2}}</style><ul role="list" class="c3-glance" style="--n:4"><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 5h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM3 10h18M8 3v4M16 3v4M8 14h.01M12 14h.01M16 14h.01M8 17.5h.01M12 17.5h.01"/></svg></span><span><strong>A call</strong><span class="t">Same day</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span><span><strong>Your analysis</strong><span class="t">Usually a day or two</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 9.4c-.4-1-1.5-1.8-3-1.8-1.8 0-3 1-3 2.2 0 3 6 1.6 6 4.4 0 1.3-1.3 2.2-3 2.2-1.6 0-2.7-.7-3.1-1.8M12 5.8v1.8M12 16.4v1.8"/><circle cx="12" cy="12" r="9"/></svg></span><span><strong>Cost</strong><span class="t">Free</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span><strong>Listing with us</strong><span class="t">Not required</span></span></li></ul><div id="ldWrap" class="hv-form"><div class="idx-lead" style="grid-template-columns:1fr"><input class="idx-input" id="ldCtx" placeholder="Property address" aria-label="Property address" autocomplete="street-address"></div><div class="idx-lead"><input class="idx-input" id="ldName" placeholder="Your name" aria-label="Your name" autocomplete="name"><input class="idx-input" id="ldPhone" placeholder="Phone" aria-label="Phone" type="tel" autocomplete="tel"></div><div class="idx-lead" style="grid-template-columns:1fr"><input class="idx-input" id="ldEmail" placeholder="Email" aria-label="Email" type="email" autocomplete="email"></div><label class="hv-consent"><input type="checkbox" id="ldConsent"><span>I consent to receive calls and text messages from Chapter 3 Realty about my property inquiry, showing appointments, and listing information I requested, at the phone number provided, including calls placed using an automated system or an artificial or prerecorded voice. Message frequency varies. Message and data rates may apply. Reply HELP for help, STOP to opt out. Consent is not a condition of any purchase.</span></label><p id="ldErr" class="hv-err" role="alert"></p><button type="button" class="btn btn-brass btn-lg" onclick="ldSubmit()">Get my home value</button></div><div id="ldOk" class="hv-ok">Thanks. Tim Nash and the team will reach out the same day to talk through your home and start your market analysis. If it is evening, we still call.</div><p class="hv-disc">This valuation service may not be used for the purposes of obtaining financing in a federally related transaction.</p><script>function ldSubmit(){var cx=document.getElementById('ldCtx').value.trim(),n=document.getElementById('ldName').value.trim(),ph=document.getElementById('ldPhone').value.trim(),em=document.getElementById('ldEmail').value.trim(),c=document.getElementById('ldConsent').checked,err=document.getElementById('ldErr');function fail(m){err.textContent=m;err.style.display='block';}err.style.display='none';if(!cx||!n){fail('Add the property address and your name.');return;}if(!ph&&!em){fail('Add a phone number or an email so we can reach you.');return;}if(!c){fail('Check the consent box to send the request.');return;}c3SendForm({property_address:cx,name:n,phone:ph,email:em,consent:c?'yes':'no'},'home-value');document.getElementById('ldWrap').style.display='none';document.getElementById('ldOk').style.display='block';}</script></div></section><section style="background:var(--ivory-2)" id="home-value-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Home value FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What is my home worth in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Across Horry County, houses and other homes resold for a middle price of about $350,000 in the latest 12 months of county deeds, and condos for about $215,000. In the city of Conway the middle house sold for about $265,000, and inside North Myrtle Beach for about $535,000.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How accurate are online home estimates in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Close on some homes and far off on others. Redfin's figures for Horry County put its middle miss at 6.6 percent on homes not for sale, and 1.65 percent once a home is listed.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What is the difference between a CMA and an appraisal?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A CMA, a comparative market analysis, is an agent's pricing of your home from the sales most like it. An appraisal is a licensed appraiser's opinion of value. In South Carolina an agent's valuation must not be called an appraisal.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Why is my county assessed value different from my market value?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The county values every home at once, for tax, so it cannot see what one home has. The taxable value is often lower still: under state law it can rise only so far between sales. A sale resets it.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Are Myrtle Beach home prices dropping?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. By the Federal Housing Finance Agency's house price index, house prices in Horry County were about flat in the year to mid-2026, after rising about half from mid-2021 to mid-2025.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does a home valuation cost anything?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. Our valuation is free, and you do not have to list your home with us.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County deed index</a>, <a href="https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County parcels and flood zones</a>, <a href="https://www.fhfa.gov/data/hpi" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FHFA house price index</a>, <a href="https://www.redfin.com/redfin-estimate" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Redfin Estimate accuracy</a>, <a href="https://www.irs.gov/taxtopics/tc701" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">IRS Topic 701</a>, <a href="https://www.scstatehouse.gov/code/t12c037.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-37</a>, <a href="https://www.scstatehouse.gov/code/t12c024.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-24</a>, <a href="https://www.scstatehouse.gov/code/t12c008.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-8-580</a>, <a href="https://www.scstatehouse.gov/code/t40c060.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 40-60</a>. Sale prices: resale deeds recorded in the 12 months to September 2026, builders left out. "Near" a town means its mailing address, outside its limits. Houses include townhouses and a few condo-hotel units. Test: 4,919 house resales, January to September 2026. Not legal or tax advice.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Streets of two-story beach houses among trees behind the oceanfront at Crescent Beach in North Myrtle Beach, seen from a plane over the ocean. Photo: U.S. Geological Survey, <a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://doi.org/10.5066/F7N877XX" target="_blank" rel="noopener noreferrer">U.S. Geological Survey</a>.</div><div role="listitem">Chapter3 Realty resized these photos and cropped some of them.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/buyers/no-hoa/crescent-beach-streets-from-the-ocean-2011-1200w.webp","url":"https://chapter3realty.com/images/buyers/no-hoa/crescent-beach-streets-from-the-ocean-2011-1200w.webp","width":1200,"height":782,"encodingFormat":"image/webp","name":"Streets of two-story beach houses among trees behind the oceanfront at Crescent Beach in North Myrtle Beach, seen from a plane over the ocean","caption":"Crescent Beach in North Myrtle Beach from over the ocean in 2011: buildings on the beach, then streets of houses. Houses for sale within 0.1 mile of the ocean ask about 2.5 times as much a square foot as houses more than 2 miles away.","description":"Streets of two-story beach houses among trees behind the oceanfront at Crescent Beach in North Myrtle Beach, seen from a plane over the ocean","creator":{"@type":"Organization","name":"U.S. Geological Survey"},"creditText":"U.S","copyrightNotice":"Public domain (U.S. Geological Survey)","license":"https://www.usa.gov/publicdomain/label/1.0/","acquireLicensePage":"https://doi.org/10.5066/F7N877XX","isBasedOn":"https://doi.org/10.5066/F7N877XX","contentLocation":{"@type":"Place","name":"Crescent Beach, North Myrtle Beach, South Carolina"}}]}</script></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Ask what your home is worth.</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">Send the address. An agent calls you, and listing with us is your choice.</p><a class="btn btn-brass btn-lg" href="#lead-form">Get my home value</a></div></section></main>
+<main id="main"><div class="detail-hero bg-grid"><div class="wrap"><div class="breadcrumb"><a href="/">Home</a><span>/</span><a href="/sell/">Sell</a><span>/</span><span style="color:var(--muted)">Home Value</span></div><p class="eyebrow" style="margin-bottom:1rem">Selling a home</p><h1 class="detail-h1">What is my home worth in Myrtle Beach?<br/><em style="font-style:italic;color:var(--brass)"></em></h1><p style="color:var(--muted);font-size:.9rem;margin-bottom:1rem">By <strong style="color:var(--navy);font-weight:600">Devin Day</strong>, Operations Officer &middot; Reviewed by <strong style="color:var(--navy);font-weight:600">Tim Nash</strong>, Broker-in-Charge &middot; <span style="white-space:nowrap">Updated November 9, 2026</span></p><p class="detail-sub">A licensed broker tells you what your own Horry County home is worth, free, from the sales most like it.</p></div></div><section style="background:var(--ivory)"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">The short answer</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Houses and other homes that resold in Horry County went for a middle price of about $350,000 in the 12 months to September 2026, and condos for about $215,000. By area, the middle house price ran from about $234,000 in the city of Loris to about $620,000 in the town of Surfside Beach.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For what your own home is worth, an agent picks the sales most like it and sends you the number with those sales.</p></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><p style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Send your address. An agent calls the same day.</p><a class="btn btn-br