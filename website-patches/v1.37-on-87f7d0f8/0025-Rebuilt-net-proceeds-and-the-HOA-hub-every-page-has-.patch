go{flex:1 1 100%}}@media (min-width:1000px) and (max-width:1100px){.header-ctas .hdr-phone{display:none!important}}main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2){padding:.9rem 0!important}main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2)>.wrap{display:block!important;text-align:center!important;background:linear-gradient(160deg,rgba(42,48,64,.95),rgba(28,32,40,.97))!important;border:1px solid rgba(255,255,255,.14)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.14),0 26px 60px -30px rgba(28,32,40,.6)!important;border-radius:28px!important;padding:2.2rem 1.6rem!important;margin-left:auto!important;margin-right:auto!important}@media (max-width:699px){main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2)>.wrap{padding:1.6rem 1.2rem 1.7rem!important;border-radius:24px!important}}</style><style>.c3-glance{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(var(--n),minmax(0,1fr));gap:.75rem;max-width:760px}.c3-glance li{display:flex;align-items:center;gap:.55rem;margin:0;padding:.5rem .6rem;background:rgba(255,255,255,.55);border:1px solid var(--rule);border-radius:6px;line-height:1.25}.c3-glance .i{flex:0 0 auto;display:flex;width:2rem;height:2rem;border-radius:50%;background:var(--ivory-2);color:var(--brass-ink);align-items:center;justify-content:center}.c3-glance strong{display:block;color:var(--navy);font-size:.9rem;font-weight:500}.c3-glance span.t{display:block;color:var(--muted);font-size:1rem}@media (max-width:699px){.c3-glance{gap:.3rem}.c3-glance li{flex-direction:column;justify-content:flex-start;text-align:center;gap:.2rem;padding:.4rem .1rem}.c3-glance .i{width:1.6rem;height:1.6rem}.c3-glance strong{font-size:.875rem}.c3-glance span.t{font-size:1rem;line-height:1.2}}</style><ul role="list" class="c3-glance" style="--n:3"><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h8l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v4h4M9 17l6-6"/><circle cx="9.5" cy="11.5" r="1"/><circle cx="14.5" cy="16.5" r="1"/></svg></span><span><strong>$1,320</strong><span class="t">of fees in state law on a $350,000 sale with a mortgage</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 9.4c-.4-1-1.5-1.8-3-1.8-1.8 0-3 1-3 2.2 0 3 6 1.6 6 4.4 0 1.3-1.3 2.2-3 2.2-1.6 0-2.7-.7-3.1-1.8M12 5.8v1.8M12 16.4v1.8"/><circle cx="12" cy="12" r="9"/></svg></span><span><strong>$3,500</strong><span class="t">for each 1 percent of commission</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span><strong>The buyer</strong><span class="t">pays for both title insurance policies</span></span></li></ul></div><p style="color:var(--muted);font-size:.9rem;margin-bottom:1rem">By <strong style="color:var(--navy);font-weight:600">Devin Day</strong>, Operations Officer &middot; Reviewed by <strong style="color:var(--navy);font-weight:600">Tim Nash</strong>, Broker-in-Charge &middot; <span style="white-space:nowrap">Updated November 9, 2026</span></p><p class="detail-sub">On a $350,000 Horry County sale with a mortgage to release, the fees in state law come to $1,320. The commission you agree is the big cost.</p></div></div><section style="background:var(--ivory)"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">The short answer</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On the middle Horry County home, a $350,000 sale with a mortgage to release, the fees in state law come to $1,320, under half of 1 percent. The commission you agree with your agent is the biggest selling cost: $3,500 for each 1 percent.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Your mortgage payoff comes out of the same check. With a 5 percent commission, as an example, and $175,000 still owed, you keep about $155,500 before your attorney's fee and any HOA charges.</p></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><p style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Have us build a net sheet on your address.</p><a class="btn btn-brass btn-lg" href="#lead-form">Have us build my net sheet</a></div></section><section style="background:var(--ivory);padding-top:2.5rem"><div class="wrap"><nav aria-label="On this page" style="margin-top:0;max-width:720px"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.3rem;font-weight:600">On this page</p><ul style="list-style:none;margin:0;padding:0"><li><a href="#net-sheet" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Net sheet</a></li><li><a href="#calculator" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Calculator</a></li><li><a href="#who-pays" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Who pays</a></li><li><a href="#attorney" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Attorney</a></li><li><a href="#deed-stamps" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Deed stamps</a></li><li><a href="#hoa" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">HOA</a></li><li><a href="#payoff" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Payoff</a></li><li><a href="#property-taxes" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Property taxes</a></li><li><a href="#tax" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Tax on the gain</a></li><li><a href="#keep-more" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Keep more</a></li><li><a href="#lead-form" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Your net sheet</a></li><li><a href="#seller-costs-faq" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Seller costs FAQ</a></li></ul></nav></div></section><section style="background:var(--ivory-2)" id="net-sheet"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Net sheet">What will I walk away with on a $350,000 home?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Take the price, subtract your selling costs and your mortgage payoff, and the rest is yours. The example is the middle Horry County home, with $175,000 still owed and a closing at the end of June.</p><div class="np-tw"><table class="np-sheet"><caption>Example: a $350,000 home with $175,000 left on the mortgage, closing at the end of June</caption><thead><tr><th scope="col">Line, and who decides it</th><th scope="col">Amount</th></tr></thead><tbody><tr class="plus"><th scope="row">Sale price<span class="w">You and the buyer agree on it</span></th><td>$350,000</td></tr><tr><th scope="row">Commission, 5 percent in this example<span class="w">You and your agent agree on it</span></th><td>&minus;$17,500</td></tr><tr><th scope="row">Deed stamps<span class="w">State law: $1.85 for each $500 of the price</span></th><td>&minus;$1,295</td></tr><tr><th scope="row">Recording the deed and your mortgage release<span class="w">County fees: $15 and $10</span></th><td>&minus;$25</td></tr><tr><th scope="row">Your share of this year's property tax<span class="w">Credited to the buyer: half the year, as your own home</span></th><td>&minus;about $640</td></tr><tr><th scope="row">Mortgage payoff<span class="w">Your lender's payoff statement</span></th><td>&minus;$175,000</td></tr><tr class="na"><th scope="row">Your attorney's fee<span class="w">It differs from one attorney's office to the next</span></th><td>Not in this example</td></tr><tr class="na"><th scope="row">HOA charges on the sale, if any<span class="w">The box ticked on the contract</span></th><td>Not in this example</td></tr></tbody><tfoot><tr class="total"><th scope="row">You keep<span class="w">Before your attorney's fee and any HOA charges</span></th><td>about $155,500</td></tr></tfoot></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The 5 percent and the $175,000 are example figures. The two lines without a number depend on your sale. The calculator below takes your own numbers.</p></div></section><section style="background:var(--ivory)" id="calculator"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Calculator">Seller net proceeds calculator</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The boxes start with the example above. Type your price, what you owe and your commission. Leave a box empty if you do not know the number yet.</p><div class="np-calc" role="group" aria-labelledby="npT"><p class="k" id="npT">Your own net sheet</p><div class="np-res" aria-live="polite"><span class="l">You keep about</span><span class="big" id="npoKeep">$155,500</span><span class="s" id="npoNote">before your attorney's fee and any HOA charges</span></div><div class="np-grid"><div class="np-in"><label for="npPrice">Sale price</label><span class="u">$<input id="npPrice" type="number" min="0" step="1000" inputmode="decimal" value="350000" oninput="npCalc()"></span></div><div class="np-in"><label for="npPayoff">What you still owe on the mortgage</label><span class="u">$<input id="npPayoff" type="number" min="0" step="1000" inputmode="decimal" value="175000" oninput="npCalc()"></span></div><div class="np-in"><label for="npComm">Commission in percent (an example; type yours)</label><span class="u"><input id="npComm" type="number" min="0" max="10" step="0.25" inputmode="decimal" value="5" oninput="npCalc()">%</span></div><div class="np-in"><label for="npMonth">Closing at the end of</label><span class="u"><select id="npMonth" onchange="npCalc()"><option value="1">January</option><option value="2">February</option><option value="3">March</option><option value="4">April</option><option value="5">May</option><option value="6" selected>June</option><option value="7">July</option><option value="8">August</option><option value="9">September</option></select></span></div><fieldset class="np-radio"><legend>The home is</legend><label><input type="radio" name="npKind" value="home" checked onchange="npCalc()"> My own home</label><label><input type="radio" name="npKind" value="second" onchange="npCalc()"> A second home or a rental</label></fieldset><div class="np-in"><label for="npHoa">HOA charges on the sale, if any</label><span class="u">$<input id="npHoa" type="number" min="0" step="1000" inputmode="decimal" oninput="npCalc()"></span></div><div class="np-in"><label for="npCredit">Credit to the buyer toward their costs, if any</label><span class="u">$<input id="npCredit" type="number" min="0" step="1000" inputmode="decimal" oninput="npCalc()"></span></div><div class="np-in"><label for="npAtty">Your attorney's fee, if you know it</label><span class="u">$<input id="npAtty" type="number" min="0" step="1000" inputmode="decimal" oninput="npCalc()"></span></div></div><dl class="np-out"><div><dt>Commission</dt><dd id="npoComm">$17,500</dd></div><div><dt>Deed stamps</dt><dd id="npoDeed">$1,295</dd></div><div><dt>Recording fees</dt><dd id="npoRec">$25</dd></div><div><dt>Your share of this year's property tax</dt><dd id="npoTax">$638</dd></div><div><dt>HOA charges, credit to the buyer and attorney</dt><dd id="npoOther">$0</dd></div><div><dt>Mortgage payoff</dt><dd id="npoPayoff">$175,000</dd></div></dl><p class="n">An estimate for planning. The tax line uses Horry County's 2026 rates for most homes outside city limits.</p></div><script>function npNet(o){var p=o.price,comm=p*o.pct/100,deed=p>0?Math.ceil(p/500)*1.85:0,rec=(p>0?15:0)+(o.payoff>0?10:0);var days=[31,59,90,120,151,181,212,243,273][o.month-1]||181;var year=p*(o.kind==="home"?0.04*91.9:0.06*201.0)/1000;var tax=year*days/365,other=o.atty+o.hoa+o.credit;return{comm:comm,deed:deed,rec:rec,tax:tax,other:other,keep:p-comm-deed-rec-tax-other-o.payoff};}function npCalc(){var g=function(i){var e=document.getElementById(i);var v=e?parseFloat(e.value):NaN;return isFinite(v)&&v>0?v:0};var m=function(n){return (n<0?"-":"")+"$"+Math.round(Math.abs(n)).toLocaleString("en-US")};var k=document.querySelector('input[name="npKind"]:checked');var o={price:g("npPrice"),payoff:g("npPayoff"),pct:g("npComm"),atty:g("npAtty"),hoa:g("npHoa"),credit:g("npCredit"),month:parseInt(document.getElementById("npMonth").value,10)||6,kind:k?k.value:"home"};var r=npNet(o),s=function(i,t){document.getElementById(i).textContent=t};s("npoKeep",(r.keep<0?"-":"")+"$"+(Math.round(Math.abs(r.keep)/100)*100).toLocaleString("en-US"));s("npoComm",m(r.comm));s("npoDeed",m(r.deed));s("npoRec",m(r.rec));s("npoTax",m(r.tax));s("npoOther",m(r.other));s("npoPayoff",m(o.payoff));s("npoNote",o.atty>0?(o.hoa>0?"after every line below":"after every line below, before any HOA charges"):(o.hoa>0?"before your attorney's fee":"before your attorney's fee and any HOA charges"));}</script><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For a closing from October to the end of the year, we work out your tax share from the actual bill.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Live in another state? About 6 in 10 Horry County condo units have their tax bill mailed outside South Carolina. When your permanent home is outside the state, the buyer must <a href="https://www.scstatehouse.gov/code/statmast.php?title=12&amp;chapter=8" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">hold back part of the price</a> for state income tax.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For a 2026 sale it is <a href="https://dor.sc.gov/news/information-about-h-4216" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">5.21 percent</a> of your gain if you sign the state's gain affidavit. Without the affidavit, it is 5.21 percent of the price less your selling costs. A main home whose gain is inside the federal exclusion has no hold-back. Our <a href="/sell/capital-gains/" style="color:var(--navy);text-decoration:underline">capital gains page</a> works it out.</p></div></section><section style="background:var(--ivory-2)" id="who-pays"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Who pays">Who pays what when you sell a house in South Carolina?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On <a href="https://screaltors.org/wp-content/uploads/2026/02/310.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">the state REALTORS' standard contract</a>, you pay the deed stamps, your mortgage payoff, the fee you agreed with your agent and your own attorney. The buyer pays both title insurance policies.</p><div class="np-who" role="group" aria-label="Who pays which closing cost on South Carolina's standard home contract"><div class="np-col"><p class="t">You pay</p><ul><li>The deed preparation</li><li>The deed stamps and the deed recording</li><li>Your mortgage payoff, and recording its release</li><li>Property tax for the months you owned the home</li><li>The fee you agreed with your own agent</li><li>Your own attorney</li></ul></div><div class="np-col"><p class="t">The buyer pays</p><ul><li>Both title insurance policies, the owner's and the lender's</li><li>The title exam</li><li>Inspections, the appraisal and any survey</li><li>The buyer's attorney</li></ul></div><div class="np-col"><p class="t">The side the contract ticks pays<span>You pay if no box is ticked</span></p><ul><li>The association's fees for its papers</li><li>The association's letter of what is owed</li><li>Transfer fees</li><li>A capital or working-capital payment to the association</li></ul></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Each side pays its own costs unless both agree otherwise in writing. The form also tells both sides they are responsible for getting legal advice before they sign.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Buying another home here as well? Our <a href="/buyers/closing-costs/" style="color:var(--navy);text-decoration:underline">closing costs page</a> lists the buyer's side.</p></div></section><section style="background:var(--ivory)" id="attorney"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Attorney">What does the closing attorney charge the seller for?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="https://www.sccourts.org/media/opinions/HTMLFiles/SC/25508.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">A South Carolina attorney must supervise</a> every home closing in the state. If the buyer has a loan for a home they will live in, <a href="https://www.scstatehouse.gov/code/statmast.php?title=37&amp;chapter=10" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">the buyer chooses the closing attorney</a>.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">An attorney who represents only the buyer does not advise you. You may refuse to sign a settlement statement you do not agree with. The attorney charges on your side of the closing statement can include three things:</p><ul class="np-plain"><li><b>The deed preparation</b>Preparing a deed for someone else is the practice of law, so a lawyer prepares your deed. On the standard contract, that cost is yours.</li><li><b>A payoff handling fee</b>In a standard South Carolina closing, the buyer's attorney typically prepares the settlement statement. Under a <a href="https://www.scbar.org/media/grihef1j/11-06.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">South Carolina Bar ethics opinion</a>, when that attorney also sends your mortgage payoff, they may add a reasonable payoff handling fee to your side.</li><li><b>Your own attorney, if you hire one</b>On the standard contract, your own attorney's fee is your cost.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">These charges differ from one attorney's office to the next, so this page prints no figure for them.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Want the attorney's charges on your net sheet?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the address and what you owe. We ask the attorney's office for its charges and fill in every other line, free.</p><a class="btn btn-brass" href="#lead-form">Have us fill in every line</a></div></div></section><section style="background:var(--ivory-2)" id="deed-stamps"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Deed stamps">How much are SC deed stamps at your price?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Deed stamps, the state's fee on a deed that many people call the transfer tax, are <a href="https://www.scstatehouse.gov/code/statmast.php?title=12&amp;chapter=24" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">$1.85 for each $500 of the price</a>, or part of $500. The seller owes them.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The county also charges <a href="https://www.scstatehouse.gov/code/statmast.php?title=8&amp;chapter=21" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">$15 to record the deed</a> and $10 to record the release of a paid-off mortgage.</p><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);letter-spacing:.01em;color:#fff;text-align:right;background:radial-gradient(farthest-side at 100% 100%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.c3ph-cr a{color:#fff;text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);text-underline-offset:2px;pointer-events:auto;padding:10px 0 6px}.c3ph-hero{margin:1.6rem 0 2rem}.c3ph-hero .c3ph-f{border-radius:8px}.c3ph-hero img{aspect-ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}</style><figure class="c3ph-hero" style="margin:1.3rem 0 1.5rem;max-width:640px;"><div class="c3ph-f"><img src="/images/2026-11-a/buyers-cost-to-own/carolina-forest-house-streets-from-above-1200w.webp" srcset="/images/2026-11-a/buyers-cost-to-own/carolina-forest-house-streets-from-above-600w.webp 600w, /images/2026-11-a/buyers-cost-to-own/carolina-forest-house-streets-from-above-1200w.webp 1200w" sizes="(max-width: 680px) 100vw, 640px" width="1200" height="900" alt="Rows of two-story houses with gray roofs and short driveways along curving streets and a cul-de-sac, beside ponds and pine woods, seen from above" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.govinfo.gov/content/pkg/USCODE-2023-title17/html/USCODE-2023-title17-chap1-sec105.htm" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo. License: Public domain" title="License: Public domain">U.S. government aerial photo</a></span></div><figcaption>Houses on streets in Carolina Forest, outside city limits, seen from above.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We read the county's recorded deeds to find four prices. Three are for homes other than condos: the middle sale, and the prices 1 in 4 sold below and above. The last row is the middle condo. Find the price nearest yours.</p><div class="np-tw"><table class="np-tab"><caption>The fees in state law at four Horry County prices, with a mortgage to release</caption><thead><tr><th scope="col">Sale price</th><th scope="col">Deed stamps</th><th scope="col">Fees in state law</th><th scope="col">Each 1% of commission</th></tr></thead><tbody><tr><th scope="row">$266,000<span class="w">1 in 4 resale homes sold for less</span></th><td><span class="l">Deed stamps</span>$984</td><td><span class="l">Fees in state law</span>$1,009</td><td><span class="l">Each 1% of commission</span>$2,660</td></tr><tr><th scope="row">$350,000<span class="w">The middle resale home</span></th><td><span class="l">Deed stamps</span>$1,295</td><td><span class="l">Fees in state law</span>$1,320</td><td><span class="l">Each 1% of commission</span>$3,500</td></tr><tr><th scope="row">$500,000<span class="w">1 in 4 resale homes sold for more</span></th><td><span class="l">Deed stamps</span>$1,850</td><td><span class="l">Fees in state law</span>$1,875</td><td><span class="l">Each 1% of commission</span>$5,000</td></tr><tr><th scope="row">$215,000<span class="w">The middle resale condo</span></th><td><span class="l">Deed stamps</span>$796</td><td><span class="l">Fees in state law</span>$821</td><td><span class="l">Each 1% of commission</span>$2,150</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">At each of these four prices, the fees in state law come to under half of 1 percent of the price, about 0.38 percent. The commission and the other lines on the net sheet come on top.</p></div></section><section style="background:var(--ivory)" id="hoa"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="HOA">What HOA fees does a seller pay at closing?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The association's charges for the sale go to the side the contract ticks, and to you if no box is ticked. Your regular dues are split as of the closing day instead, like the property tax.</p><ul class="np-plain"><li><b>No cap in state law</b>South Carolina has no cap on what an association charges for its resale papers or its letter of what is owed. A transfer fee covenant that makes an owner pay a third party on each sale is <a href="https://www.scstatehouse.gov/code/statmast.php?title=27&amp;chapter=1" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">not binding</a> if it was recorded after February 1, 2012. A fee paid to the association itself is still allowed.</li><li><b>Unpaid dues come out of your money</b>Unpaid HOA fees are usually a lien on the home, and they come out of the seller's money at closing. We look for them before closing. On a condo sale, <a href="https://www.scstatehouse.gov/code/statmast.php?title=27&amp;chapter=31" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">state law</a> requires your unpaid association charges to be paid out of the price, after past-due taxes and recorded mortgages.</li><li><b>Special assessments</b>For a special assessment approved before closing, the contract has two boxes: you pay all of it, or only the part due in the year of closing. One approved after closing is the buyer's. Our <a href="/hoa/special-assessments/" style="color:var(--navy);text-decoration:underline">special assessments page</a> goes further.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">More than 1 in 4 houses for sale here list no HOA fee. Almost every condo for sale lists one. Our <a href="/hoa/estoppel-and-transfer-fees/" style="color:var(--navy);text-decoration:underline">guide to HOA fees when a home sells</a> covers the letter the association sends for the sale.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Have us find out what your HOA charges when you sell.</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the address and the name of your association. We find out its charges on a sale and put them on your net sheet.</p><a class="btn btn-brass" href="#lead-form">Ask us about my HOA</a></div></div></section><section style="background:var(--ivory-2)" id="payoff"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Payoff">Why is my mortgage payoff more than my balance?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Your <a href="https://www.consumerfinance.gov/ask-cfpb/what-is-a-payoff-amount-and-is-it-the-same-as-my-current-balance-en-205/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">payoff</a> includes the interest due through the day the loan is paid off, and any fees charged and not yet paid. Some loans also charge a prepayment penalty, a fee for paying the loan off early.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On a home loan made for personal use, the servicer must send <a href="https://www.consumerfinance.gov/rules-policy/regulations/1026/36/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">an accurate payoff statement</a> within seven business days of a written request. A loan made to buy a rental the owner does not use counts as a business loan, and that rule does not apply to it. A beach place the owner planned to use more than 14 days a year still counts as personal.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Closing day: guard the wire</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Never follow wiring instructions that arrive in an email. <a href="https://www.consumerfinance.gov/archive/blog/mortgage-closing-scams-how-protect-yourself-and-your-closing-funds/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Confirm them by phone</a> with the attorney's office, at a number you agreed on in advance.</p></div></section><section style="background:var(--ivory)" id="property-taxes"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Property taxes">Who pays the property taxes when you sell in Horry County?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You pay for the part of the year you owned the home, and the buyer pays for the rest. South Carolina property taxes for a year are <a href="https://www.scstatehouse.gov/code/statmast.php?title=12&amp;chapter=45" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">due between September 30 and January 15</a> after they are assessed.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For most of the year, the tax for the months you have owned the home has not been billed yet. At closing you credit the buyer your share. The credit is your own tax for those months, not an extra cost.</p><figure class="np-chart"><p class="cap">The later you close, the bigger the tax credit to the buyer</p><svg class="np-n" viewBox="0 0 330 344" role="img" aria-label="Bar chart: the credit to the buyer for your share of the year's property tax on a $350,000 home. End of March: about $320 for your own home, about $1,040 for a second home or rental; End of June: about $640 for your own home, about $2,090 for a second home or rental; End of September: about $960 for your own home, about $3,160 for a second home or rental." font-family="DM Sans, system-ui, sans-serif"><rect x="0" y="3" width="17" height="17" rx="3" fill="#c4783a"/><text x="24" y="18" font-size="17" fill="#1c2028">Your own home</text><rect x="0" y="30" width="17" height="17" rx="3" fill="#5c6b78"/><text x="24" y="45" font-size="17" fill="#1c2028">Second home or rental</text><g transform="translate(0 22)"><text x="0" y="68" font-size="17" font-weight="600" fill="#1c2028">End of March</text><rect x="0" y="77" width="20.9" height="18" rx="9" fill="#c4783a"/><text x="29.4" y="92" font-size="17" font-weight="600" fill="#1c2028">about $320</text><rect x="0" y="103" width="68.6" height="18" rx="9" fill="#5c6b78"/><text x="77.1" y="118" font-size="17" font-weight="600" fill="#1c2028">about $1,040</text><text x="0" y="160" font-size="17" font-weight="600" fill="#1c2028">End of June</text><rect x="0" y="169" width="42.0" height="18" rx="9" fill="#c4783a"/><text x="50.5" y="184" font-size="17" font-weight="600" fill="#1c2028">about $640</text><rect x="0" y="195" width="137.9" height="18" rx="9" fill="#5c6b78"/><text x="146.4" y="210" font-size="17" font-weight="600" fill="#1c2028">about $2,090</text><text x="0" y="252" font-size="17" font-weight="600" fill="#1c2028">End of September</text><rect x="0" y="261" width="63.4" height="18" rx="9" fill="#c4783a"/><text x="71.9" y="276" font-size="17" font-weight="600" fill="#1c2028">about $960</text><rect x="0" y="287" width="208.0" height="18" rx="9" fill="#5c6b78"/><text x="216.5" y="302" font-size="17" font-weight="600" fill="#1c2028">about $3,160</text></g></svg><svg class="np-w" viewBox="0 0 640 282" role="img" aria-label="Bar chart: the credit to the buyer for your share of the year's property tax on a $350,000 home. End of March: about $320 for your own home, about $1,040 for a second home or rental; End of June: about $640 for your own home, about $2,090 for a second home or rental; End of September: about $960 for your own home, about $3,160 for a second home or rental." font-family="DM Sans, system-ui, sans-serif"><rect x="0" y="3" width="15" height="15" rx="3" fill="#c4783a"/><text x="21" y="16" font-size="15" fill="#1c2028">Your own home</text><rect x="144" y="3" width="15" height="15" rx="3" fill="#5c6b78"/><text x="165" y="16" font-size="15" fill="#1c2028">Second home or rental</text><g transform="translate(0 20)"><text x="0" y="36" font-size="15" font-weight="600" fill="#1c2028">End of March</text><rect x="0" y="44" width="53.4" height="16" rx="8" fill="#c4783a"/><text x="60.9" y="57" font-size="15" font-weight="600" fill="#1c2028">about $320</text><rect x="0" y="67" width="175.4" height="16" rx="8" fill="#5c6b78"/><text x="182.9" y="80" font-size="15" font-weight="600" fill="#1c2028">about $1,040</text><text x="0" y="118" font-size="15" font-weight="600" fill="#1c2028">End of June</text><rect x="0" y="126" width="107.5" height="16" rx="8" fill="#c4783a"/><text x="115.0" y="139" font-size="15" font-weight="600" fill="#1c2028">about $640</text><rect x="0" y="149" width="352.7" height="16" rx="8" fill="#5c6b78"/><text x="360.2" y="162" font-size="15" font-weight="600" fill="#1c2028">about $2,090</text><text x="0" y="200" font-size="15" font-weight="600" fill="#1c2028">End of September</text><rect x="0" y="208" width="162.1" height="16" rx="8" fill="#c4783a"/><text x="169.6" y="221" font-size="15" font-weight="600" fill="#1c2028">about $960</text><rect x="0" y="231" width="532.0" height="16" rx="8" fill="#5c6b78"/><text x="539.5" y="244" font-size="15" font-weight="600" fill="#1c2028">about $3,160</text></g></svg><figcaption>On a $350,000 home outside city limits, at Horry County's 2026 tax rates. </figcaption></figure><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Why a second home pays about three times as much</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A home its owner lives in is <a href="https://www.scstatehouse.gov/code/statmast.php?title=12&amp;chapter=43" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">assessed at 4 percent</a> of its value and pays no school operating tax. A second home or rental is assessed at 6 percent and pays the full <a href="https://www.horrycountysc.gov/media/kufln4qp/tax-levy-2026_2.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">county levy</a>.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Inside a city or town, such as Myrtle Beach or Conway, the tax and the credit differ from these figures.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">If the bill turns out different</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The closing attorney figures the tax split from the tax information they judge reliable. If the bill later turns out different, you and the buyer settle the difference between yourselves.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">When a home's last deed is old, its tax bill, and the tax credit at closing, is often smaller than one figured on today's price. Our <a href="/buyers/property-taxes/" style="color:var(--navy);text-decoration:underline">property tax page</a> explains why.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Have us work out the tax credit from your own tax bill.</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the address. We work out your share of this year's tax from the county's bill for your home.</p><a class="btn btn-brass" href="#lead-form">Have us check my tax bill</a></div></div></section><section style="background:var(--ivory-2)" id="tax"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Tax on the gain">Is the money you keep from the sale taxed?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Often not, if it was your main home. You can exclude up to $250,000 of gain from your income, or $500,000 for a married couple filing jointly.</p><ul class="np-plain"><li><b>Who can use the exclusion</b>You <a href="https://www.irs.gov/taxtopics/tc701" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">owned and lived in the home</a> at least 2 of the last 5 years. You also did not use the exclusion on another home in the 2 years before.</li><li><b>Your selling costs lower the gain</b>The commission, legal fees, and the deed stamps and other fees you pay as the seller <a href="https://www.irs.gov/publications/p523" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">count as selling expenses</a>.</li><li><b>The sale is reported on Form 1099-S</b>The closing attorney's office <a href="https://www.irs.gov/instructions/i1099s" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">reports most sales to the IRS</a>. A main home that sells for $250,000 or less may be left off if you certify the whole gain is excluded. For a married seller the limit is $500,000.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A rental or a second home is taxed differently. Our <a href="/sell/capital-gains/" style="color:var(--navy);text-decoration:underline">capital gains guide</a> works through it.</p></div></section><section style="background:var(--ivory)" id="keep-more"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Keep more">How do sellers here keep more of the price?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Price it once. On a $350,000 home, each 1 percent off the asking price is $3,500, the same as 1 percent of commission.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We checked every resale house and townhouse for sale in Horry County for a price cut. More than half have cut their asking price at every price: about 63 percent under $300,000, and about 56 percent in each higher band.</p><div class="np-stat"><p class="k">Resale homes for sale in Horry County, our count</p><ul><li><strong>1,260 of 2,188</strong><span>houses and townhouses have cut their asking price</span></li><li><strong>1,372 of 2,652</strong><span>condos have cut their asking price</span></li></ul></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The homes for sale near the top of this page are the kind a seller near the middle competes with. Our <a href="/sell/home-value/" style="color:var(--navy);text-decoration:underline">home value page</a> shows how we price a home from the recorded sales most like it.</p><ul class="np-plain"><li><b>The commission is yours to agree</b><a href="https://www.nar.realtor/the-facts/what-the-nar-settlement-means-for-home-buyers-and-sellers" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Agents' fees are fully negotiable</a>, and no law fixes them. Offers to pay the buyer's agent are no longer made on the MLS, the agents' shared listing service. Offering to pay the buyer's agent is a choice, not a requirement.</li><li><b>A credit to the buyer is your money</b>The contract caps it at a dollar amount. If the buyer's costs come in lower, or the lender allows less, the rest stays with you. On an <a href="https://www.hud.gov/sites/default/files/Housing/documents/40001-hsgh-Update-18.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FHA loan</a>, the seller and others may pay up to 6 percent of the price toward the buyer's closing costs. On a <a href="https://www.va.gov/housing-assistance/home-loans/funding-fee-and-closing-costs/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">VA loan</a>, other concessions are capped at 4 percent of the home's reasonable value.</li><li><b>A home warranty is rare on a resale here</b>Only 62 of 2,188 resale houses and townhouses for sale advertise one. Nearly all the home warranties offered here come with new homes. The standard contract has no home warranty clause; buyer and seller can add one with a separate addendum.</li></ul><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Have us price your home against what is for sale now.</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We compare your home with the recent sales most like it and the homes for sale near it, and send you a price, free.</p><a class="btn btn-brass" href="/sell/home-value/">Get my home's price</a></div></div></section><section style="background:var(--ivory-2)" id="lead-form"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Your net sheet">Get a net sheet for your own home</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Give us the address and what you owe, and a licensed agent builds your net sheet with every line on this page filled in for your sale.</p><div id="ldWrap" class="np-form"><div class="idx-lead" style="grid-template-columns:1fr"><input class="idx-input" id="ldCtx" placeholder="Property address" aria-label="Property address" autocomplete="street-address"></div><div class="idx-lead"><input class="idx-input" id="ldName" placeholder="Your name" aria-label="Your name" autocomplete="name"><input class="idx-input" id="ldPhone" placeholder="Phone" aria-label="Phone" type="tel" autocomplete="tel"></div><div class="idx-lead" style="grid-template-columns:1fr"><input class="idx-input" id="ldEmail" placeholder="Email" aria-label="Email" type="email" autocomplete="email"></div><label class="np-consent"><input type="checkbox" id="ldConsent"><span>I consent to receive calls and text messages from Chapter 3 Realty about my property inquiry, showing appointments, and listing information I requested, at the phone number provided, including calls placed using an automated system or an artificial or prerecorded voice. Message frequency varies. Message and data rates may apply. Reply HELP for help, STOP to opt out. Consent is not a condition of any purchase.</span></label><p id="ldErr" class="np-err" role="alert"></p><button type="button" class="btn btn-brass btn-lg" onclick="ldSubmit()">Send my net sheet request</button><p class="np-tel">Free, and no obligation. Prefer to talk now?</p><a class="btn btn-outline np-call" href="tel:+18543332135">Call 854.333.2135</a></div><div id="ldOk" class="np-ok">Thanks. A licensed team member will reach out with your seller net sheet.</div><script>function ldSubmit(){var cx=document.getElementById('ldCtx').value.trim(),n=document.getElementById('ldName').value.trim(),ph=document.getElementById('ldPhone').value.trim(),em=document.getElementById('ldEmail').value.trim(),c=document.getElementById('ldConsent').checked,err=document.getElementById('ldErr');function fail(m){err.textContent=m;err.style.display='block';}err.style.display='none';if(!cx||!n){fail('Add the property address and your name.');return;}if(!ph&&!em){fail('Add a phone number or an email so we can reach you.');return;}if(!c){fail('Check the consent box to send the request.');return;}c3SendForm({property_address:cx,name:n,phone:ph,email:em,consent:c?'yes':'no'},'net-proceeds');document.getElementById('ldWrap').style.display='none';document.getElementById('ldOk').style.display='block';}</script><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Selling it yourself instead? Our <a href="/sell/fsbo/" style="color:var(--navy);text-decoration:underline">for sale by owner guide</a> covers the costs that stay the same. Selling from far away? Our page on <a href="/sell/out-of-state-buyers/" style="color:var(--navy);text-decoration:underline">selling from out of state</a> explains the steps.</p></div></section><section style="background:var(--ivory)" id="seller-costs-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Seller costs FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What is a seller net sheet?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A list of every line on the seller's side of the closing: the price, less the commission, the fees, the tax credit and the payoff. The $350,000 example near the top of this page is one.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Who pays title insurance in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The buyer pays both policies, the owner's and the lender's, on the state REALTORS' standard contract. Buyer and seller can agree to something else in writing.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does the seller need an attorney in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Every South Carolina home closing must be supervised by a South Carolina attorney, and a lawyer prepares the seller's deed. When the buyer has a loan for a home they will live in, the buyer picks that attorney, who does not advise you. Your own attorney is your cost.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I sell my house before the mortgage is paid off?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. The closing pays off the loan out of the sale money, and you get what is left.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://screaltors.org/wp-content/uploads/2026/02/310.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC REALTORS Form 310</a>, <a href="https://www.scstatehouse.gov/code/statmast.php?title=12&amp;chapter=24" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-24</a>, <a href="https://www.scstatehouse.gov/code/statmast.php?title=8&amp;chapter=21" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">8-21</a>, <a href="https://www.scstatehouse.gov/code/statmast.php?title=12&amp;chapter=45" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">12-45</a>, <a href="https://www.scstatehouse.gov/code/statmast.php?title=12&amp;chapter=43" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">12-43</a>, <a href="https://www.scstatehouse.gov/code/statmast.php?title=27&amp;chapter=1" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">27-1</a>, <a href="https://www.scstatehouse.gov/code/statmast.php?title=27&amp;chapter=31" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">27-31</a>, <a href="https://www.scstatehouse.gov/code/statmast.php?title=12&amp;chapter=8" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">12-8</a>, <a href="https://www.sccourts.org/media/opinions/HTMLFiles/SC/25508.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Doe v. McMaster</a>, <a href="https://www.scbar.org/media/grihef1j/11-06.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Bar opinion 11-06</a>, <a href="https://www.horrycountysc.gov/media/kufln4qp/tax-levy-2026_2.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County 2026 levy</a>, <a href="https://www.consumerfinance.gov/ask-cfpb/what-is-a-payoff-amount-and-is-it-the-same-as-my-current-balance-en-205/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">CFPB</a>, <a href="https://www.irs.gov/publications/p523" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">IRS Pub 523</a>, <a href="https://www.hud.gov/sites/default/files/Housing/documents/40001-hsgh-Update-18.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">HUD 4000.1</a>, <a href="https://www.va.gov/housing-assistance/home-loans/funding-fee-and-closing-costs/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">VA</a>, <a href="https://www.nar.realtor/the-facts/what-the-nar-settlement-means-for-home-buyers-and-sellers" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NAR</a>, <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeDocType" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">County deeds</a>. Prices: our count of county deeds. Homes for sale: our count of the listing feed on Novembe