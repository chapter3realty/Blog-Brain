lor:var(--navy);font:500 .95rem/1.3 var(--sans)}.c3ph-dots{display:inline-flex;gap:.45rem}.c3ph-dots i{display:block;width:10px;height:10px;border-radius:50%;border:1.5px solid var(--navy);box-sizing:border-box}.c3ph-dots i:first-child{background:var(--navy)}@supports (animation-timeline:view()){.c3ph-rowbox{timeline-scope:--c3ph-p1,--c3ph-p2,--c3ph-p3}.c3ph-row>figure:nth-child(1){view-timeline:--c3ph-p1 inline}.c3ph-row>figure:nth-child(2){view-timeline:--c3ph-p2 inline}.c3ph-row>figure:nth-child(3){view-timeline:--c3ph-p3 inline}.c3ph-dots i{animation:c3ph-dot linear both;animation-range:cover}.c3ph-dots i:nth-child(1){animation-timeline:--c3ph-p1}.c3ph-dots i:nth-child(2){animation-timeline:--c3ph-p2}.c3ph-dots i:nth-child(3){animation-timeline:--c3ph-p3}@keyframes c3ph-dot{0%,36%{background:transparent}42%,60%{background:var(--navy)}66%,100%{background:transparent}}}@media (min-width:700px){.c3ph-swipe{display:none}}.c3ph-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:1.4rem 0 1.8rem;padding:0;list-style:none}@media (min-width:700px){.c3ph-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}}@media (min-width:1000px){.c3ph-cards.c3ph-4{grid-template-columns:repeat(4,minmax(0,1fr))}}.c3ph-card{margin:0;background:var(--ivory);border:1px solid var(--rule);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}.c3ph-card .c3ph-f{border-radius:0}.c3ph-card img,.c3ph-card svg{display:block;width:100%;height:auto;aspect-ratio:var(--c3ph-r,4/3);object-fit:cover}.c3ph-card .c3ph-cr{font-size:.56rem;padding:1.2rem .45rem .25rem 1.6rem}.c3ph-card strong{display:block;color:var(--navy);font-size:.98rem;font-weight:500;line-height:1.3;padding:.7rem .8rem 0}.c3ph-card span.c3ph-t{display:block;color:var(--muted);font-size:.86rem;line-height:1.45;padding:.2rem .8rem .85rem}.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:720px}</style><style>main#main .c3g-wants{list-style:none;margin:.2rem 0 1rem;padding:0;max-width:760px;border-top:1px solid rgba(28,32,40,.16)}main#main .c3g-wants>li{margin:0;padding:.5rem 0;border-bottom:1px solid rgba(28,32,40,.16);line-height:1.5;font-size:.98rem}@media (min-width:700px){main#main .c3g-wants>li{display:grid;grid-template-columns:15rem minmax(0,1fr);column-gap:1rem}}main#main .c3g-wants b{display:block;color:var(--navy);font-family:var(--sans);font-weight:650;font-size:.92rem}main#main .c3g-wants a{color:var(--navy);text-decoration:underline;text-underline-offset:.18em;white-space:nowrap}main#main .c3g-wants ul{display:inline;list-style:none;margin:0;padding:0}main#main .c3g-wants ul>li{display:inline;margin:0}main#main .c3g-wants ul>li:not(:last-child)::after{content:'\00b7';color:var(--muted);padding:0 .1rem 0 .4rem}main#main .c3g-wants-h{font-family:var(--sans)!important;font-size:.7rem!important;letter-spacing:.14em;text-transform:uppercase;color:var(--brass)!important;margin:0 0 .5rem!important;font-weight:600;line-height:1.4}@media (min-width:700px){main#main .detail-h1{text-wrap:balance}}main#main .detail-h1 em{display:block;font-size:clamp(1.3rem,2.5vw,2.25rem);line-height:1.25;margin-top:.55rem;text-wrap:balance}@media (max-width:959px){main#main .detail-h1 em{color:#8a5226!important}}</style><div class="c3-gcards c3g-guide-list"><h3 class="c3g-wants-h">Choose by what you want</h3><ul class="c3g-wants"><li><b>The ocean, or an oceanfront club</b><ul><li><a href="#grande-dunes">4. Grande Dunes</a></li> <li><a href="#litchfield-by-the-sea">16. Litchfield by the Sea</a></li> <li><a href="#debordieu-colony">18. DeBordieu Colony</a></li></ul></li><li><b>A marina with staff</b><ul><li><a href="#the-reserve">13. The Reserve</a></li> <li><a href="#heritage-plantation">17. Heritage Plantation</a></li></ul></li><li><b>A boat ramp at home</b><ul><li><a href="#waterway-palms-plantation">5. Waterway Palms Plantation</a></li> <li><a href="#the-bluffs-on-the-waterway">6. The Bluffs on the Waterway</a></li></ul></li><li><b>A famous golf course</b><ul><li><a href="#tidewater-plantation">1. Tidewater Plantation</a></li> <li><a href="#barefoot-resort">3. Barefoot Resort</a></li> <li><a href="#prestwick">8. Prestwick</a></li> <li><a href="#wachesaw-plantation">11. Wachesaw Plantation</a></li> <li><a href="#wachesaw-east">12. Wachesaw East</a></li></ul></li><li><b>History you live inside</b><ul><li><a href="#willbrook-plantation">14. Willbrook Plantation</a></li> <li><a href="#litchfield-plantation">15. Litchfield Plantation</a></li></ul></li><li><b>Main Street by golf cart</b><ul><li><a href="#seaside-plantation">2. Seaside Plantation</a></li></ul></li><li><b>55+</b><ul><li><a href="#prince-creek-55">9. Seasons at Prince Creek West</a></li></ul></li><li><b>Lots of nearly half an acre</b><ul><li><a href="#bellwood-landing">10. Bellwood Landing</a></li></ul></li><li><b>A fee under $100 a month</b><ul><li><a href="#myrtle-beach-golf-and-yacht-club">7. Myrtle Beach Golf and Yacht Club</a></li></ul></li></ul></div><style>main#main .detail-hero .detail-sub{display:none}</style></div></section><section style="background:var(--ivory)" id="area-nmb"><div class="wrap"><h3 class="c3g-area">North Myrtle Beach<span>, 1 to 3</span></h3></div></section><section style="background:var(--ivory-2)" id="tidewater-plantation"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="1. Tidewater Plantation">1. Tidewater Plantation: nine holes along Cherry Grove Inlet</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Tidewater, in North Myrtle Beach, has one of the best public courses in South Carolina: Golf Digest ranks it No. 38 in the state. Nine of its holes play along the tidal inlet at Cherry Grove.</p><div class="hx-strip" data-place="tidewater-plantation" data-name="Tidewater Plantation"></div><div class="hx-fallback"><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/buyers/gated-communities/tidewater-plantation-marsh-from-above-2023-1200w.webp" srcset="/images/buyers/gated-communities/tidewater-plantation-marsh-from-above-2023-600w.webp 600w, /images/buyers/gated-communities/tidewater-plantation-marsh-from-above-2023-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Tidewater Plantation from above, labelled: golf fairways along the tidal water behind Cherry Grove Inlet, houses above them, and canal homes at the lower right; labels: Golf holes along the inlet and Tidewater Plantation" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="Photo: USDA Farm Service Agency, NAIP. License: Public domain" title="License: Public domain">Photo: USDA Farm Service Agency, NAIP</a></span></div><figcaption>Tidewater Plantation from above, with its golf holes along the inlet labelled. Houses line the street above the fairways.</figcaption></figure></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The course opened in 1990. Golf Digest named it the best new public course in America that year. Golf Magazine put it first on its list of 1990's top 10 new public courses. About seven in ten of the house lots touch the course. Golf membership is sold to residents and property owners of Horry, Georgetown and Brunswick counties.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Tidewater is inside North Myrtle Beach's city limits, with city services. It is on the Intracoastal Waterway, not the ocean, but the neighborhood keeps its own beach cabana, with parking, at Cherry Grove Beach.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Tidewater has about 580 houses and one master association, with six smaller associations under it, so a house may answer to two associations. We check both for any home you like.</p><p class="c3-place-price">Homes at Tidewater usually sell for about $625,000. The HOA fee is about $230 a month.</p></div></section><section style="background:var(--ivory)" id="seaside-plantation"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="2. Seaside Plantation">2. Seaside Plantation: Main Street by golf cart</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">From the south end of Seaside Plantation, Main Street in North Myrtle Beach is about two-thirds of a mile by road. The way runs on two side streets, with no main highway to cross. The city lets a golf cart with a state permit use secondary roads posted at 35 mph or less, from sunrise to sunset.</p><div class="hx-strip" data-place="seaside-plantation" data-name="Seaside Plantation"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Each spring and fall the Society of Stranders brings its shag dance festivals, the Spring Safari and the Fall Migration, to Main Street and Ocean Drive. The ocean is a quarter to three-quarters of a mile from the houses, and some houses look onto the neighborhood's lakes.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Festival weeks bring crowds to Main Street.</p><p class="c3-place-price">Homes here usually sell for about $720,000, with an HOA fee of about $210 a month.</p></div></section><section style="background:var(--ivory-2)" id="barefoot-resort"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="3. Barefoot Resort">3. Barefoot Resort: the course that hosts the Monday After the Masters</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Dye Estates, a gated neighborhood inside Barefoot Resort in North Myrtle Beach, surrounds the Dye Course, home of the Monday After the Masters. Hootie & the Blowfish host the charity pro-am each spring, and it brings celebrities and PGA Tour players to the course. Many of its houses are large custom homes, on lots of about two-thirds of an acre.</p><div class="hx-strip" data-place="barefoot-resort" data-name="Barefoot Resort"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Its gate is staffed. A guard works the main gate 24 hours a day, and owners drive through a resident lane with a barcode on the car. A guest gets in only when the owner has given the guard the guest's name and the date. At the second gate, an owner who has set up a gate code can let a guest in by phone. The guest calls from the keypad, and the owner presses 9.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Leatherleaf, the other gated neighborhood here, has 62 houses with the Love Course on every side. Davis Love III designed that course with Pinehurst No. 2 in mind, and Leatherleaf's Residents' Club has a lifestyle director who plans events.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In summer a free shuttle runs to the owners' beach cabana, which has key-fob parking, showers and a pet-washing station. In these two neighborhoods you call the driver 15 minutes ahead. At Barefoot a golf membership stays with certain houses. The seller gives it up at closing, and the buyer can take it over by enrolling within 60 days.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most of Barefoot Resort has no gate. In Dye Estates no one may swim, boat or fish in the ponds. Lots there are still for sale with no deadline to build, so a house can go up next door at any time.</p><p class="c3-place-price">Leatherleaf homes usually sell for about $700,000 to $975,000, with an HOA fee of about $390 a month. Two Dye Estates homes resold this past year, for about $1.4 million and about $2.5 million.</p></div></section><section style="background:var(--ivory)" id="area-mb"><div class="wrap"><h3 class="c3g-area">Myrtle Beach<span>, 4 to 6</span></h3></div></section><section style="background:var(--ivory-2)" id="grande-dunes"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="4. Grande Dunes">4. Grande Dunes: an oceanfront club and a marina for big boats</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In Myrtle Beach, many Grande Dunes homes come with a household membership to the Ocean Club, a private club on the beach. It has towel and bar service at its pool and cabanas on the sand. We confirm it for each home you look at.</p><div class="hx-strip" data-place="grande-dunes" data-name="Grande Dunes"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The private Members Club is a separate membership from the home. Its course was designed by Nick Price, a member of golf's Hall of Fame, with Craig Schreiner. The clubhouse has golf simulators, and the calendar includes themed dinners, wine tastings and a Fourth of July cookout.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Grande Dunes Marina, on the Intracoastal Waterway, has 126 slips and takes boats up to 120 feet long, with fuel and a store. A two-mile trail along the waterway is open to the public. In Calais, Palermo and Villa Venezia, most houses are one-story Mediterranean-style homes, and many have a private pool.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Grande Dunes has a security company on contract, with a main guard house, a north guard house and a guard house at the Ocean Club. This page covers three of its gated sections: Calais, Palermo and Villa Venezia.</p><p class="c3-place-price">Homes in those three sections usually sell for about $1.5 million, and the HOA fee is about $200 to $400 a month.</p></div></section><section style="background:var(--ivory)" id="waterway-palms-plantation"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="5. Waterway Palms Plantation">5. Waterway Palms Plantation: a Charleston-style plan around a lake</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Waterway Palms Plantation, in Carolina Forest, was planned to echo Charleston's Battery district. At its center the association owns a lake parcel of about 15 acres. The clubhouse stands on a point in the lake, with water on three sides.</p><div class="hx-strip" data-place="waterway-palms-plantation" data-name="Waterway Palms Plantation"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most houses sold here lately were built since 2020, and they are large: many are custom homes of about 3,000 to 3,800 square feet. Many rise two or three stories, some have an elevator, and lots on the Intracoastal Waterway often have a private dock. The neighborhood also has its own boat ramp on the waterway, so a boat can go in without a trip across town.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The lots are small, and about one in five has no house on the county roll yet.</p><p class="c3-place-price">Homes usually sell for about $780,000, and the HOA fee is about $150 a month.</p></div></section><section style="background:var(--ivory-2)" id="the-bluffs-on-the-waterway"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="6. The Bluffs on the Waterway">6. The Bluffs on the Waterway: a boathouse clubhouse on the waterway</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Bluffs on the Waterway, in Carolina Forest, has two clubhouses, and one of them is a boathouse on the Intracoastal Waterway. Its boat ramp sits on a waterfront lot of more than 6 acres. Grande Dunes Marina is about 2.5 miles away by water.</p><div class="hx-strip" data-place="the-bluffs-on-the-waterway" data-name="The Bluffs on the Waterway"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Many of its houses are custom Mediterranean-style homes in stucco. Black Creek runs through the woods along the west side, and the county's bike park is less than a mile away.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Carolina Bays Parkway (S.C. 31) runs along one side; the nearest lots are about 280 feet from it.</p><p class="c3-place-price">Homes here usually sell for about $850,000; the HOA fee is about $150 a month.</p></div></section><section style="background:var(--ivory)" id="area-south"><div class="wrap"><h3 class="c3g-area">Socastee, Surfside Beach and Murrells Inlet<span>, 7 to 12</span></h3></div></section><section style="background:var(--ivory-2)" id="myrtle-beach-golf-and-yacht-club"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="7. Myrtle Beach Golf and Yacht Club">7. Myrtle Beach Golf and Yacht Club: room for the boat and the camper</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">At Myrtle Beach Golf and Yacht Club, off Bay Road in Socastee, the association keeps storage for RVs, trailers and boats, for a fee when space is open. Enterprise Landing, a public boat ramp on the Intracoastal Waterway, is about a 4-minute drive from the entrance.</p><div class="hx-strip" data-place="myrtle-beach-golf-and-yacht-club" data-name="Myrtle Beach Golf and Yacht Club"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The owners' association owns about 62 acres of open land, most of it the wide strips of grass and woods between the streets. Its Community Watch desk is covered 24 hours a day, and the HOA fee is about $95 a month.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Despite the name, there is no golf or yacht club anymore; Heron Point, its golf club, closed years ago. Sandpiper Place, where D.R. Horton is building new houses, shares the entrance but has its own owners association. We look up the association for any home you like.</p><p class="c3-place-price">In the older part, homes usually sell for about $225,000.</p></div></section><section style="background:var(--ivory)" id="prestwick"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="8. Prestwick">8. Prestwick: a Pete and P.B. Dye course named Course of the Year</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Prestwick, near Surfside Beach, has a course by Pete Dye and his son P.B. Dye that was named the 2025 Myrtle Beach Area Golf Course of the Year. It carries several of Dye's marks: wooden bulkheads along many water banks, deep-faced bunkers around greens that are often raised, and fast greens.</p><div class="hx-strip" data-place="prestwick" data-name="Prestwick"></div><div class="hx-fallback"><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/buyers/gated-communities/prestwick-course-from-above-2023-1200w.webp" srcset="/images/buyers/gated-communities/prestwick-course-from-above-2023-600w.webp 600w, /images/buyers/gated-communities/prestwick-course-from-above-2023-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Prestwick from above, labelled: houses among the fairways of a golf course, with a long lake at the left; labels: Dye golf course and Prestwick" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="Photo: USDA Farm Service Agency, NAIP. License: Public domain" title="License: Public domain">Photo: USDA Farm Service Agency, NAIP</a></span></div><figcaption>Prestwick from above, with its Dye golf course labelled: houses among the fairways, with a long lake at the left and an RV lot at the lower right.</figcaption></figure></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Prestwick opened in 1989 as a private club, founded by the Jackson family, who also created Ocean Lakes. The Gatlin Brothers once lived here and held a charity golf tournament each year, and about half the lots are on the course. When the club ended its memberships, the owners association took over the pools and the tennis center. Owners have two pools and two hard courts, and the eleven clay courts take their own membership.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The course is fully public now, so you share the fairways with visiting golfers.</p><p class="c3-place-price">Homes usually sell for about $480,000, and the HOA fee is about $190 a month.</p></div></section><section style="background:var(--ivory-2)" id="prince-creek-55"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="9. Seasons at Prince Creek West">9. Seasons at Prince Creek West (55+): a clubhouse, indoor and outdoor pools and bocce</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">At Seasons at Prince Creek West, in Murrells Inlet, the builder listed a ballroom, a card room, an art studio and a billiards room in the clubhouse.</p><div class="hx-strip" data-place="prince-creek-55" data-name="Seasons at Prince Creek West"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Today the community has a clubhouse, indoor and outdoor pools, a fitness center, tennis and bocce. The Murrells Inlet MarshWalk is about a 10-minute drive.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Every occupied home must have a resident <a href="/buyers/55-plus-communities/seasons-at-prince-creek-west/" style="color:var(--navy);text-decoration:underline">55 or older</a>. Most are one-story builder homes, about half of them 1,750 to 2,350 square feet. They sit on lots of about a fifth of an acre, so the yards are small. The county roll shows a house on every lot.</p><p class="c3-place-price">Homes usually sell for about $500,000, and the HOA fee, about $340 a month, includes internet, trash pickup and lawn care.</p></div></section><section style="background:var(--ivory)" id="bellwood-landing"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="10. Bellwood Landing">10. Bellwood Landing: big lots on Collins Creek, with TPC beyond the woods</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In Bellwood Landing, in Murrells Inlet, about a dozen lots back onto Collins Creek, which runs through a wide band of woods. Beyond the woods lies TPC Myrtle Beach, a Tom Fazio design that has hosted the PGA Tour's Monday qualifier for the Myrtle Beach Classic.</p><div class="hx-strip" data-place="bellwood-landing" data-name="Bellwood Landing"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The lots are big, many of them nearly half an acre, and seventeen are an acre or more. Many houses are custom, often two stories.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For tennis, pickleball or a cookout, owners drive about 4 minutes to the Park at Prince Creek West. It has courts and a covered pavilion with grills. The park is shared with the other Prince Creek West neighborhoods, not Bellwood's own.</p><p class="c3-place-price">Homes here usually sell for about $810,000, and the HOA fee is about $160 a month.</p></div></section><section style="background:var(--ivory-2)" id="wachesaw-plantation"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="11. Wachesaw Plantation">11. Wachesaw Plantation: a members' club on a bluff above the river</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Before the neighborhoods were planned, archaeologists dug at Wachesaw, on the Waccamaw River in Murrells Inlet. Their University of South Carolina study of Wachesaw and the neighboring Richmond Hill plantation found more than half a million artifacts. Some finds are on display in the clubhouse.</p><div class="hx-strip" data-place="wachesaw-plantation" data-name="Wachesaw Plantation"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The members own the Wachesaw Plantation Club. Its Tom Fazio course has hosted Carolinas Golf Association championships. Each March the members host the Can-Am Junior Team Matches.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">From the best lots you look down a Fazio fairway or out over the Waccamaw River.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Kimbels, the club's restaurant, is on the bluff above the waterway and the 18th green, with a Tavern Room, open decks and an enclosed porch. Wachesaw's eight clay tennis courts and its book clubs and card groups fill the rest of the week. The main gate has a guard, and Wacca Wache Marina, outside the gates, has about 100 wet slips and indoor racks.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The club is rebuilding its pool and its Magnolia's restaurant, so part of the club is a work site for now.</p><p class="c3-place-price">Homes usually sell for about $700,000, and the HOA fee on most homes is about $150 a month.</p></div></section><section style="background:var(--ivory)" id="wachesaw-east"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="12. Wachesaw East">12. Wachesaw East: where the LPGA played four years</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Wachesaw East, in Murrells Inlet, has a course that hosted four televised LPGA Tour events, from 1997 to 2000. Karrie Webb won the first two.</p><div class="hx-strip" data-place="wachesaw-east" data-name="Wachesaw East"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Clyde Johnston laid out the course on a former rice plantation, past freshwater lakes and wetlands. Houses line the fairways behind the gate, most of them one story and from the early 2000s. The club's grill, the Toasted Tee Pub & Grub, has hosted happy hours with live music.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The course and its grill are a business of their own, not the homeowners': Festiva Real Estate Holdings bought them in 2017.</p><p class="c3-place-price">Homes usually sell for about $500,000, and the HOA fee is about $145 a month.</p></div></section><section style="background:var(--ivory-2)" id="area-pawleys"><div class="wrap"><h3 class="c3g-area">Pawleys Island<span>, 13 to 18</span></h3></div></section><section style="background:var(--ivory)" id="the-reserve"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="13. The Reserve">13. The Reserve: Greg Norman's private course and a marina with dry storage</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Near Pawleys Island, The Reserve's marina sits at the southern tip of Sandy Island, where Thoroughfare Creek meets the Waccamaw River. Staff launch and haul boats from a dry storage building that holds about 200. The marina also has a fuel dock, and a boardwalk runs through a cypress forest to the river.</p><div class="hx-strip" data-place="the-reserve" data-name="The Reserve"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Reserve Golf Club is a private Greg Norman course of up to 7,200 yards, set among 160 acres of wetlands. It has hosted the Carolinas Mid-Amateur twice, and a golf membership includes the club's dining and social events.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Each fall the Pawleys Island Festival of Music & Art puts up its tent at the golf club, and the neighborhood has private beach access with parking.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Dry storage takes boats up to 27 feet. A bigger boat needs a wet slip or a side tie.</p><p class="c3-place-price">Homes usually sell for about $1.3 million, and the HOA fee on most homes is about $320 a month.</p></div></section><section style="background:var(--ivory-2)" id="willbrook-plantation"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="14. Willbrook Plantation">14. Willbrook Plantation: a neighborhood on three rice plantations</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Willbrook, near Pawleys Island, was built on the land of three rice plantations, Willbrook, Oatland and Turkey Hill, and its golf course crosses two of them. Five markers along the course tell that history hole by hole. Under the live oaks by the 5th hole are brick remains at the site of the plantation house, which burned in 1895 and was rebuilt that year.</p><div class="hx-strip" data-place="willbrook-plantation" data-name="Willbrook Plantation"></div><div class="hx-fallback"><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/buyers/gated-communities/willbrook-plantation-named-from-above-2023-1200w.webp" srcset="/images/buyers/gated-communities/willbrook-plantation-named-from-above-2023-600w.webp 600w, /images/buyers/gated-communities/willbrook-plantation-named-from-above-2023-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Willbrook Plantation from above, labelled: houses among trees beside golf fairways and a pond, open fields cut by ditches at the upper left, and more houses at the lower left; label: Willbrook Plantation" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="Photo: USDA Farm Service Agency, NAIP. License: Public domain" title="License: Public domain">Photo: USDA Farm Service Agency, NAIP</a></span></div><figcaption>Willbrook Plantation from above: its houses are in the middle and at the upper right, beside golf fairways. The houses at the lower left are in Litchfield Plantation.</figcaption></figure></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">By the 8th hole is the Oatland cemetery of enslaved people, protected inside the community. After rice, the land was used for duck and quail hunting.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Willbrook is a gated neighborhood of about 250 houses inside Litchfield by the Sea, with its own clubhouse and social calendar. Its residents have Litchfield by the Sea's private beach and Beach Club, and one car barcode is issued for both. Golf membership is separate, and the club accepts applications from any golfer.</p><p class="c3-place-price">Homes usually sell for about $840,000, and the HOA fee is about $340 a month.</p></div></section><section style="background:var(--ivory)" id="litchfield-plantation"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="15. Litchfield Plantation">15. Litchfield Plantation: the owners own the plantation house</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Near Pawleys Island, at the end of the Avenue of Live Oaks, stands Litchfield Plantation's house, and the owners own it. For about 50 years the developer controlled the association. In 2018 the owners took control after court challenges, and the house, its pool and about 7 acres passed to the association.</p><div class="hx-strip" data-place="litchfield-plantation" data-name="Litchfield Plantation"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The house and its avenue of oaks appear on a map of the land drawn in 1794. After taking it over, the owners repaired it and set up a club room, and it has hosted weddings to help pay for its upkeep. A terrace off the main room overlooks the old rice fields.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The gatehouse stands on the avenue. The association also owns a beach house on Pawleys Island, about 4 miles away by road. A private marina on the river is an optional extra.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The old rice fields beside the community, about 330 acres, still belong to the original development company, not to the owners.</p><p class="c3-place-price">Houses here usually sell for about $800,000 to $1.8 million. The HOA fee on most homes is about $230 a month.</p></div></section><section style="background:var(--ivory-2)" id="litchfield-by-the-sea"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="16. Litchfield by the Sea">16. Litchfield by the Sea: a mile of beach and a guard around the clock</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Litchfield by the Sea, near Pawleys Island, has about a mile of its own beach, with an oceanfront Beach Club, a deck and a pavilion.</p><div class="hx-strip" data-place="litchfield-by-the-sea" data-name="Litchfield by the Sea"></div><div class="hx-fallback"><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/buyers/gated-communities/litchfield-by-the-sea-from-above-2023-1200w.webp" srcset="/images/buyers/gated-communities/litchfield-by-the-sea-from-above-2023-600w.webp 600w, /images/buyers/gated-communities/litchfield-by-the-sea-from-above-2023-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Litchfield by the Sea from above, labelled: homes around a large lake, large buildings and tennis courts near the beach, and the Atlantic Ocean at the right; labels: Litchfield by the Sea and Beach" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="Photo: USDA Farm Service Agency, NAIP. License: Public domain" title="License: Public domain">Photo: USDA Farm Service Agency, NAIP</a></span></div><figcaption>Litchfield by the Sea from above: homes around a lake, large buildings by the beach and the Atlantic Ocean at the right.</figcaption></figure></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A guard works the main gate day and night. Owners' cars come in with a barcode, and each guest must be registered by the owner before the visit.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A normal week can include Tai Chi on Wednesday and yoga on Thursday at the Beach Club. In between there is crabbing off the docks on Osprey Lake and a walk on the paved paths through the marsh.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Many homes are condos and villas from the 1980s to the 2000s, and the Beach Club comes with the home. The association also lists single-family homes in Charlestowne Grant, Compass Point and River Club, and freestanding villas in Oystercatcher Island. Many of Charlestowne Grant's houses are raised beach houses.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">It is many neighborhoods inside the gates, each with its own sub-association, and the HOA fee differs from section to section and from unit to unit. In the sections whose sales we read, condo and villa fees range from about $620 a month to about $1,880 for an oceanfront condo.</p><p class="c3-place-price">One-bedroom condos in Summerhouse usually sell for about $200,000, and four villas in Breakers Reef sold last year for about $1.5 million to $2.2 million.</p></div></section><section style="background:var(--ivory)" id="heritage-plantation"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="17. Heritage Plantation">17. Heritage Plantation: a dock master and a crow's nest over the river</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Heritage Plantation, near Pawleys Island, has a marina with a full-time dock master. Its dock house is built over the Waccamaw River, with a crow's nest and a swing on its roof. The marina also has a deck over the water, bordered by cypress trees, that serves as a daily sunset gathering place.</p><div class="hx-strip" data-place="heritage-plantation" data-name="Heritage Plantation"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The HOA fee includes cable TV, home internet, the dock master and 24-hour security, and the association lists a separate phone line for the main gate.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Many mornings are reserved for league play on four green-clay Har-Tru courts and four pickleball courts. The Heritage Club, a public par-71 course by Dan Maples, lies among the live oaks on land that was once the True Blue and Midway plantations.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A few lots look over the old rice fields toward the river.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Trash pickup costs extra, and boat slips are rented by the day, the month or the year.</p><p class="c3-place-price">Homes usually sell for about $710,000, and the HOA fee is about $325 a month.</p></div></section><section style="background:var(--ivory-2)" id="debordieu-colony"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="18. DeBordieu Colony">18. DeBordieu Colony: a planters' colony with a Dye course and a private beach club</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Before the Civil War, rice planters built a colony of summer homes at DeBordieu, on the ocean south of Pawleys Island. Later owners of the land included Isaac Emerson, the Bromo-Seltzer maker, and the Vanderbilt family. Locals say "Debidue".</p><div class="hx-strip" data-place="debordieu-colony" data-name="DeBordieu Colony"></div><div class="hx-fallback"><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/buyers/gated-communities/debordieu-beach-houses-from-the-ocean-2011-1200w.webp" srcset="/images/buyers/gated-communities/debordieu-beach-houses-from-the-ocean-2011-600w.webp 600w, /images/buyers/gated-communities/debordieu-beach-houses-from-the-ocean-2011-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="782" alt="Large beach houses with walkways over the dunes, more houses among dark green oaks behind them, and a wide salt marsh with creeks at the top, at DeBordieu Colony seen from a plane over the ocean" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: U.S. Geological Survey. License: Public domain" title="License: Public domain">Photo: U.S. Geological Survey</a></span></div><figcaption>DeBordieu Colony from over the ocean in 2011: large houses behind the dunes, with walkways over the dunes to the beach, and the salt marsh beyond.</figcaption></figure></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Only DeBordieu owners can join the DeBordieu Club. It has a Pete and P.B. Dye course that has hosted the Carolinas Mid-Amateur, and eight Har-Tru tennis courts. Its places to eat include the Beanery cafe and the Beach Club, with three dining spaces. On the Fourth of July the colony holds a parade.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Many houses are raised beach houses with an elevator, and some stand right on the ocean. Every car comes through one gate. Guests are registered online, in an app or by phone, and a guest pass lasts up to a week. The colony covers 2,700 acres, and at least 600 of them are a nature preserve.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">South Carolina spends public money to rebuild a beach only where the public has full access to it, and DeBordieu does not qualify. Its owners pay for their beach themselves, through assessments to a beach fund they voted to set up. Boats cannot stay at the community dock overnight.</p><p class="c3-place-price">Homes here usually sell for about $2 million, and the HOA fee is about $300 to $400 a month.</p></div></section><section style="background:var(--ivory)" id="compare"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Prices">What do homes sell for, and what is the HOA fee?</h2><div class="c3g-where"><style>.c3g-tkey{display:none}@media(max-width:640px){.c3g-tkey{display:block;color:var(--muted);font-size:.9rem;margin:0 0 .3rem}.c3g-table thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}.c3g-table tr{display:block;padding:.3rem 0;border-bottom:1px solid var(--line,#e3dccf)}.c3g-table td{display:inline;border:0!important;padding:0!important;font-size:.95rem}.c3g-table td[data-l]::before{content:" \00B7  ";color:var(--muted)}}</style><div style="max-width:760px"><p class="c3g-tkey">Place &middot; homes sell for &middot; HOA fee a month &middot; gate</p><table class="c3g-table" style="border-collapse:collapse;width:100%;font-size:var(--read,1.0625rem);line-height:1.45"><thead><tr><th scope="col" style="padding:.45rem .6rem;border-bottom:1px solid var(--line,#e3dccf);vertical-align:top;text-align:left">Neighborhood</th><th scope="col" style="padding:.45rem .6rem;border-bottom:1px solid var(--line,#e3dccf);vertical-align:top;text-align:left">Homes sell for</th><th scope="col" style="padding:.45rem .6rem;border-bottom:1px solid var(--line,#e3dccf);vertical-align:top;text-align:left">HOA fee a month</th><th scope="col" style="padding:.45rem .6rem;border-bottom:1px solid var(--line,#e3dccf);vertical-align:top;text-align:left">Gate</th></tr></thead><tbody><tr><td style="padding:.45rem .6rem;border-bottom:1px solid var(--line,#e3dccf);vertical-align:top;text-align:left"><a href="#tidewater-plantation" style="color:var(--navy);text-decoration:underline;text-underline-offset:.18em">1. Tidewater Plantation</a></td><td style="padding:.45rem .6rem;border-bottom:1px solid var(--line,#e3dccf);vertical-align:top;text-align:left" data-l="Homes sell for">About $625,000</td><td style="padding:.45rem .6rem;border-bottom:1px solid var(--line,#e3dccf);vertical-align:top;text-align:left" data-l="HOA fee a month">About $230</td><td style="padding:.45rem .6rem;border-bottom:1px solid var(--line,#e3dccf);verti