alty.com/images/2026-11-a/submarkets-north-myrtle-beach/barefoot-landing-waterway-from-above-1200w.webp","width":1200,"height":857,"encodingFormat":"image/webp","name":"Barefoot Landing on the Intracoastal Waterway at US 17, with the neighborhoods across the waterway on the far bank","caption":"Barefoot Landing on the Intracoastal Waterway at US 17, 2023 aerial, with the neighborhoods across the waterway on the far bank.","description":"From above: shops around a lake labelled Barefoot Landing, the wide Intracoastal Waterway with a marina on its far bank labelled Across the waterway, and US 17","creator":{"@type":"Organization","name":"USDA Farm Service Agency, NAIP"},"creditText":"USDA Farm Service Agency, NAIP, public domain, via USGS The National Map","copyrightNotice":"Public domain (USDA Farm Service Agency, NAIP)","license":"https://www.fsa.usda.gov/help/policies-and-links/","acquireLicensePage":"https://imagery.nationalmap.gov/arcgis/rest/services/USGSNAIPImagery/ImageServer","isBasedOn":"https://imagery.nationalmap.gov/arcgis/rest/services/USGSNAIPImagery/ImageServer","contentLocation":{"@type":"Place","name":"Barefoot Landing on the Intracoastal Waterway, North Myrtle Beach, South Carolina"},"representativeOfPage":true}]}</script></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Tell us how you will use the home.</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">A place to live, a second home or a weekly rental: we will show you the parts and houses that fit. We check the flood zone, the HOA rules and the rental rules for each before you offer.</p><a class="btn btn-brass btn-lg" href="/contact/?place=North%20Myrtle%20Beach">Ask about North Myrtle Beach homes</a></div></section></main>
