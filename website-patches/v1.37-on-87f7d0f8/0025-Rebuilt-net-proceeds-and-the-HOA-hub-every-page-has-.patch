/chapter3realty.com/images/2026-11-b/hoa/houses-and-towers-from-the-ocean-4x3.webp","width":1200,"height":900,"encodingFormat":"image/webp","description":"Older two-story houses on lawns along the beach at left, and two tall condo towers on the beach at right, with streets of houses under oak trees behind, seen from a plane over the ocean in Myrtle Beach","creator":{"@type":"Organization","name":"U.S. Geological Survey"},"creditText":"U.S","copyrightNotice":"Public domain (U.S. Geological Survey)","license":"https://www.usa.gov/publicdomain/label/1.0/","acquireLicensePage":"https://doi.org/10.5066/F7N877XX","isBasedOn":"https://doi.org/10.5066/F7N877XX"},{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-11-b/hoa/houses-and-towers-from-the-ocean-16x9.webp","url":"https://chapter3realty.com/images/2026-11-b/hoa/houses-and-towers-from-the-ocean-16x9.webp","width":1200,"height":675,"encodingFormat":"image/webp","description":"Older two-story houses on lawns along the beach at left, and two tall condo towers on the beach at right, with streets of houses under oak trees behind, seen from a plane over the ocean in Myrtle Beach","creator":{"@type":"Organization","name":"U.S. Geological Survey"},"creditText":"U.S","copyrightNotice":"Public domain (U.S. Geological Survey)","license":"https://www.usa.gov/publicdomain/label/1.0/","acquireLicensePage":"https://doi.org/10.5066/F7N877XX","isBasedOn":"https://doi.org/10.5066/F7N877XX"}],"mainEntityOfPage":{"@id":"https://chapter3realty.com/hoa/"},"about":{"@type":"Thing","name":"Homeowners association fees on the Grand Strand, South Carolina"},"keywords":"Myrtle Beach HOA fees, average HOA fees Myrtle Beach, what do HOA fees cover, HOA fees per month, are HOA fees monthly or yearly, 55+ HOA fees Myrtle Beach, gated community HOA fees, Horry County HOA"}</script>
+<script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is a regime fee?","acceptedAnswer":{"@type":"Answer","text":"A regime fee is the condo fee. South Carolina's condo law calls a condo a regime, so its association fee is also called a regime fee."}},{"@type":"Question","name":"Can I refuse to join an HOA?","acceptedAnswer":{"@type":"Answer","text":"No, not when the home is in one. Under South Carolina law, the recorded declaration requires each owner to pay the association's assessments."}},{"@type":"Question","name":"Can HOA fees go up?","acceptedAnswer":{"@type":"Answer","text":"Yes. South Carolina's HOA law and condo law set no cap on dues, on a special assessment or on a fine. The limits are in the association's own recorded rules."}}]}</script>
