+      + '.c3-addr li[aria-selected=true],.c3-addr li:hover{background:#f4efe8}'
+      + '.c3-addr .c3-addr-g{padding:.3rem .75rem 0;font-size:.7rem;color:#8a949c;cursor:default;background:none!important}';
