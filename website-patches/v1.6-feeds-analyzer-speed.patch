at(auto-fit,minmax(min(150px,100%),1fr));gap:1rem;background:#fff;border:1px solid var(--rule);border-radius:12px;padding:1.5rem 1.6rem;margin-bottom:1.4rem"><div><label style="display:block;font-family:var(--sans);font-size:.66rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:.4rem;font-weight:600">Purchase price ($)</label><input id="cmp-price" type="number" inputmode="decimal" value="350000" oninput="c3Compare()" style="width:100%;padding:.6rem .7rem;border:1px solid var(--rule);border-radius:8px;background:#fff;font-family:var(--sans);font-size:.9rem;color:var(--navy)"></div><div><label style="display:block;font-family:var(--sans);font-size:.66rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:.4rem;font-weight:600">Long-term rent ($/mo)</label><input id="cmp-rent" type="number" inputmode="decimal" value="2100" oninput="c3Compare()" style="width:100%;padding:.6rem .7rem;border:1px solid var(--rule);border-radius:8px;background:#fff;font-family:var(--sans);font-size:.9rem;color:var(--navy)"></div><div><label style="display:block;font-family:var(--sans);font-size:.66rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:.4rem;font-weight:600">Short-term rate ($/night)</label><input id="cmp-adr" type="number" inputmode="decimal" value="185" oninput="c3Compare()" style="width:100%;padding:.6rem .7rem;border:1px solid var(--rule);border-radius:8px;background:#fff;font-family:var(--sans);font-size:.9rem;color:var(--navy)"></div><div><label style="display:block;font-family:var(--sans);font-size:.66rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:.4rem;font-weight:600">Short-term occupancy (%)</label><input id="cmp-occ" type="number" inputmode="decimal" value="62" oninput="c3Compare()" style="width:100%;padding:.6rem .7rem;border:1px solid var(--rule);border-radius:8px;background:#fff;font-family:var(--sans);font-size:.9rem;color:var(--navy)"></div></div><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(255px,100%),1fr));gap:1rem"><div id="cmp-ltr-card" style="background:var(--navy);border-radius:12px;padding:1.6rem 1.75rem;border:2px solid transparent;transition:border-color .2s"><div style="font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:var(--brass-2);margin-bottom:1.1rem">Long-term rental</div><div style="display:flex;justify-content:space-between;align-items:baseline;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(244,239,232,.12)"><span style="color:rgba(244,239,232,.7);font-size:.83rem">Income a year</span><strong id="cmp-ltr-gross" style="color:var(--ivory);font-family:var(--sans);font-size:.95rem;font-weight:500">$0</strong></div><div style="display:flex;justify-content:space-between;align-items:baseline;gap:1rem;padding:.55rem 0;border-bottom:1px solid rgba(244,239,232,.12)"><span style="color:rgba(244,239,232,.7);font-size:.83rem">Operating costs</span><strong id="cmp-ltr-cost" style="color:var(--ivory);font-family:var(--sans);font-size:.95rem;font-weight:500">$0</strong></div><div style="display:flex;justify-content:space-between;align-items:baseline;gap:1rem;padding:.9rem 0;border-bottom:1px solid rgba(244,239,232,.12)"><span style="color:rgba(244,239,232,.7);font-size:.8rem">Net income a year</span><strong id="cmp-ltr-noi" style="color:var(--ivory);font-family:var(--sans);font-size:1.4rem;font-weight:600">$0</strong></div><div style="display:flex;justify-content:space-between;align-items:baseline;gap:1rem;padding:.55rem 0 0"><span style="color:rgba(244,239,232,.7);font-size:.83rem">Return on price</span><strong id="cmp-ltr-cap" style="color:var(--brass-2);font-family:var(--sans);font-size:.95rem">0%</strong></div><div style="margin-top:.9rem;font-size:.72rem;color:rgba(244,239,232,.45);line-height:1.5">A year-round lease. Steadier, less work.</div></div><div id="cmp-str-card" style="background:var(--navy);border-radius:12px;padding:1.6rem 1.