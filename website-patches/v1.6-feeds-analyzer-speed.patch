+/* Address suggestions in every address box (owner, 2026-10-26), from Google Places with the
+   site's browser key (a public key, limited to this site). Nothing loads until someone types
+   4 characters. A pick fills the box and fires "c3:address" with the street and town, so a
+   form with a separate town box (or the rental analyzer) can fill the rest.
+   Also: no number box on the site changes when the page is scrolled over it. */
+(function () {
+  var KEY = 'AIzaSyAFTNMGh-PmVFTl3S0ViiM9zNYicFrgGfs';
+  var SEL = 'input[data-addr],#ltr-street,#ldCtx,#rnAddr,#sbh-street';
+  document.addEventListener('wheel', function (e) {
+    var a = document.activeElement;
+    if (a && a.type === 'number' && e.target === a) a.blur();
+  }, { passive: true });
+  var css = false;
+  function styles() {
+    if (css) return; css = true;
+    var s = document.createElement('style');
+    s.textContent = '.c3-addr{position:absolute;z-index:60;margin:4px 0 0;padding:6px;list-style:none;background:#fff;border-radius:14px;box-shadow:0 14px 40px rgba(28,32,40,.22);max-height:18rem;overflow:auto}'
