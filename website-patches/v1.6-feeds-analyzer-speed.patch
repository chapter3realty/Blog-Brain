-size:.82rem;color:var(--muted);line-height:1.6"><div style="margin-bottom:.55rem">Operating costs as a share of income: long-term <input id="cmp-ltrcost" type="number" inputmode="decimal" value="35" oninput="c3Compare()" style="width:52px;padding:.25rem .35rem;border:1px solid var(--rule);border-radius:6px;font-family:var(--sans);text-align:center">% , short-term <input id="cmp-strcost" type="number" inputmode="decimal" value="50" oninput="c3Compare()" style="width:52px;padding:.25rem .35rem;border:1px solid var(--rule);border-radius:6px;font-family:var(--sans);text-align:center">%</div>These cover taxes, insurance, upkeep, and management. Short-term costs more because of cleaning, supplies, utilities, and 20 to 30 percent management. Change them to your own numbers.</div><p style="color:var(--muted);line-height:1.7;max-width:680px;margin-top:1.4rem">Short-term can earn more, but it takes more work and the rules change street by street. See <a href="/invest/str-tools/" style="color:var(--brass);font-weight:600;text-decoration:none">how Grand Strand short-term rentals work</a>, or <a href="/contact/" style="color:var(--brass);font-weight:600;text-decoration:none">have us run your exact property</a>.</p></div><script>function c3Compare(){var g=function(id){var e=document.getElementById(id);return e?(parseFloat(e.value)||0):0;};var price=g("cmp-price"),rent=g("cmp-rent"),adr=g("cmp-adr"),occ=g("cmp-occ")/100,lc=g("cmp-ltrcost")/100,sc=g("cmp-strcost")/100;var lg=rent*12,sg=adr*365*occ;var ln=lg*(1-lc),sn=sg*(1-sc);var money=function(n){return "$"+Math.round(n).toLocaleString("en-US");};var set=function(id,v){var e=document.getElementById(id);if(e)e.textContent=v;};set("cmp-ltr-gross",money(lg));set("cmp-str-gross",money(sg));set("cmp-ltr-cost","-"+money(lg*lc));set("cmp-str-cost","-"+money(sg*sc));set("cmp-ltr-noi",money(ln));set("cmp-str-noi",money(sn));set("cmp-ltr-cap",(price?(ln/price*100):0).toFixed(1)+"%");set("cmp-str-cap",(price?(sn/price*100):0).toFixed(1)+"%");var lcard=document.getElementById("cmp-ltr-card"),scard=document.getElementById("cmp-str-card");if(lcard&&scard){lcard.style.borderColor=ln>=sn?"var(--brass)":"transparent";scard.style.borderColor=sn>ln?"var(--brass)":"transparent";}var v=document.getElementById("cmp-verdict");if(v){var diff=Math.abs(sn-ln);if(sn>ln){v.textContent="Short-term projects about "+money(diff)+" more a year, before the extra work.";}else if(ln>sn){v.textContent="Long-term projects about "+money(diff)+" more a year, with less work.";}else{v.textContent="";}}}var C3_STR={"north myrtle beach":{adr:370,occ:56,name:"North Myrtle Beach"},"myrtle beach":{adr:255,occ:58,name:"Myrtle Beach",mb:true},"surfside beach":{adr:410,occ:42,name:"Surfside Beach"},"garden city":{adr:360,occ:48,name:"Garden City"},"murrells inlet":{adr:300,occ:50,name:"Murrells Inlet"},"pawleys island":{adr:420,occ:56,name:"Pawleys Island"},"little river":{adr:240,occ:52,name:"Little River"},"conway":{adr:150,occ:45,name:"Conway"},"_default":{adr:270,occ:54,name:"the Grand Strand"}};function c3DetectSub(){var city=((document.getElementById("ltr-city")||{}).value||"").toLowerCase().trim();for(var k in C3_STR){if(k!=="_default"&&city.indexOf(k)>=0)return C3_STR[k];}var zip=(((document.getElementById("ltr-zip")||{}).value)||"").trim().slice(0,5);var Z={"29582":"north myrtle beach","29597":"north myrtle beach","29598":"north myrtle beach","29585":"pawleys island","29576":"murrells inlet","29566":"little river","29526":"conway","29527":"conway","29587":"surfside beach"};if(Z[zip])return C3_STR[Z[zip]];if(/^295(72|75|77|79|88)$/.test(zip))return C3_STR["myrtle beach"];return C3_STR["_default"];}function c3SetVal(id,v){var e=document.getElementById(id);if(e){e.value=v;}}function c3AutoCompare(){var cmp=document.getElementById("compare");if(cmp)cmp.style.display="block";var sm=c3DetectSub();var val=document.getElementById("ltr-r-value");var price=val?parseFloat(val.textContent.replace(/[^0-9.]/g,"")):0;if(price>1000)c3SetVal("cmp-price",Math.round(price));var mt=document.querySelectorAll("#ltr-income-metrics>div");for(var i=0;i<mt.length;i++){if(/monthly rent/i.test(mt[i].textContent)){var mr=(mt[i].textContent.match(/\$[\d,]+/)||[""])[0].replace(/[^0-9]/g,"");if(mr)c3SetVal("cmp-rent",mr);break;}}c3SetVal("cmp-adr",sm.adr);c3SetVal("cmp-occ",sm.occ);var note=document.getElementById("cmp-note");if(note)note.textContent="Short-term numbers are the "+sm.name+" average. Adjust them to your property.";var warn=document.getElementById("cmp-warn");if(warn){if(sm.mb){warn.style.display="block";warn.innerHTML="<strong>Heads up:</strong> most residential zones in the City of Myrtle Beach do not allow short-term rentals. Confirm the zoning before you count on nightly income. <a href=\"/contact/\" style=\"color:var(--brass);font-weight:600;text-decoration:none\">Chapter3 can check this for you.</a>";}else{warn.style.display="none";}}c3Compare();}(function(){var m=document.getElementById("ltr-income-metrics");if(m&&window.MutationObserver){new MutationObserver(function(){if(m.children.length){setTimeout(c3AutoCompare,60);}}).observe(m,{childList:true});}})();document.addEventListener("DOMContentLoaded",c3Compare);</script><section style="background:var(--ivory)"><div style="max-width:1000px;margin:0 auto;padding:3.5rem 1.5rem 4rem"><p style="font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem">Common Questions</p><h2 style="font-family:var(--serif);font-size:2rem;color:var(--navy);margin-bottom:1.5rem">Frequently asked questions</h2><div style="border-top:1px solid var(--rule);padding:1.4rem 0"><h3 style="font-family:var(--serif);font-size:1.2rem;color:var(--navy);margin-bottom:.5rem">Can I still invest here if my property can&rsquo;t be a short-term rental?</h3><p style="color:var(--muted);line-height:1.7;max-width:680px">Yes, and this is one of the most useful workarounds on the Grand Strand. Many Myrtle Beach residential zones (and plenty of HOAs) don&rsquo;t allow Airbnb-style short-term rentals. South Carolina&rsquo;s 90-day threshold is a <strong>tax</strong> rule: stays under 90 days are subject to the state accommodations tax. It does not override local zoning. Cities, counties and HOAs set their own minimum lease terms, and those minimums vary, so a 90-day lease is not automatically permitted where nightly rentals are banned. Mid-term tenants such as traveling nurses, remote workers and October-to-March snowbirds are a common way to cash-flow a property in those zones. Before you count on it, confirm the minimum lease term in that city&rsquo;s ordinance and the HOA covenants for the specific address. Run any address through the analyzer to compare the long-term and mid-term numbers.</p></div><div style="border-top:1px solid var(--rule);padding:1.4rem 0"><h3 style="font-family:var(--serif);font-size:1.2rem;color:var(--navy);margin-bottom:.5rem">What does the long-term rental analyzer calculate?</h3><p style="color:var(--muted);line-height:1.7;max-width:680px">For any Grand Strand address you enter, it estimates property value, <a href="/invest/rent-prices/" style="color:var(--brass);font-weight:600;text-decoration:underline">market rent</a>, DSCR, cap rate, net operating income, monthly cash flow, cash-on-cash return, and appreciation, and it flags nearby permit activity.</p></div><div style="border-top:1px solid var(--rule);padding:1.4rem 0"><h3 style="font-family:var(--serif);font-size:1.2rem;color:var(--navy);margin-bottom:.5rem">What is DSCR and why does it matter?</h3><p style="color:var(--muted);line-height:1.7;max-width:680px">Debt-Service Coverage Ratio is net operating income divided by annual debt service. Investor lenders typically look for 1.20 or higher. It tells you whether the rent comfortably covers the loan.</p></div><div style="border-top:1px solid var(--rule);padding:1.4rem 0"><h3 style="font-family:var(--serif);font-size:1.2rem;color:var(--navy);margin-bottom:.5rem">What cap rate is realistic for a Myrtle Beach long-term rental?</h3><p style="color:var(--muted);line-height:1.7;max-width:680px">As of July 2026, a Horry County rental bought in the cheaper third of the market returns 4.2 to 7.5 percent a year after costs with a property manager, and 5.1 to 8.8 percent without one. Dividing the same rent by the typical value of every home in the area gives a much lower number, because most of those homes are not rentals. <a href="/invest/rental-returns/" style="color:var(--navy);text-decoration:underline">The rental returns page</a> has the figure for each area.</p></div><div style="border-top:1px solid var(--rule);padding:1.4rem 0"><h3 style="font-family:var(--serif);font-size:1.2rem;color:var(--navy);margin-bottom:.5rem">Are the numbers an appraisal?</h3><p style="color:var(--muted);line-height:1.7;max-width:680px">No. They are an actual screening estimate to compare deals quickly. Confirm with comparable sales, inspections, and a licensed agent before making an offer.</p></div></div></section>
