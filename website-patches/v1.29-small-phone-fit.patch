From 9da13c85793c8cba2690eeefc73f9f353f27c200 Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Tue, 3 Nov 2026 21:43:30 +0000
Subject: [PATCH] Nothing cut off on a small phone: the homes row's search
 wraps below 380 px, and the neighborhoods hub's title fits at 320 px

- idx-lib/filters.js: below 380 px the AI search row wraps (the words, then the button on its own line). It ran to 364 px in a 320 px window on every page with a homes row (critic, 2026-11-03).
- /submarkets/: the H1 fits at 320 px.
---
 chapter3realty/submarkets/index.html | 2 +-
 idx-lib/filters.js                   | 2 ++
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/chapter3realty/submarkets/index.html b/chapter3realty/submarkets/index.html
index dfb10d04..00292021 100644
--- a/chapter3realty/submarkets/index.html
+++ b/chapter3realty/submarkets/index.html
@@ -77,7 +77,7 @@
   #ltr-teaser .wrap>div{flex-direction:column;align-items:center;text-align:center}
 }
 </style>
-<script type="application/ld+json">{"@context": "https://schema.org", "@type": "Person", "@id": "https://chapter3realty.com/about/#devin-day", "name": "Devin Day", "jobTitle": "Operations Officer", "description": "Operations Officer and front-end product lead", "knowsAbout": ["Mortgage financing", "DSCR loans", "Real estate investment analysis", "Myrtle Beach real estate"], "worksFor": {"@id": "https://chapter3realty.com/#org"}, "url": "https://chapter3realty.com/about/", "image": "https://chapter3realty.com/team/devin.webp"}</script><style id="c3-nohscroll">html{overflow-x:clip}#c3-fab{display:none !important}</style><script type="application/ld+json">{"@context":"https://schema.org","@type":"Article","headline":"Grand Strand Neighborhoods | Myrtle Beach Area Guide","description":"Grand Strand submarket research: home prices, rental income, and investor data for Myrtle Beach, Murrells Inlet, North Myrtle Beach, and five more areas.","image":"https://chapter3realty.com/og-image.jpg","datePublished":"2026-06-12","dateModified":"2026-11-03","author":{"@id":"https://chapter3realty.com/about/#devin-day"},"publisher":{"@id":"https://chapter3realty.com/#org"},"mainEntityOfPage":"https://chapter3realty.com/submarkets/"}</script></head>
+<script type="application/ld+json">{"@context": "https://schema.org", "@type": "Person", "@id": "https://chapter3realty.com/about/#devin-day", "name": "Devin Day", "jobTitle": "Operations Officer", "description": "Operations Officer and front-end product lead", "knowsAbout": ["Mortgage financing", "DSCR loans", "Real estate investment analysis", "Myrtle Beach real estate"], "worksFor": {"@id": "https://chapter3realty.com/#org"}, "url": "https://chapter3realty.com/about/", "image": "https://chapter3realty.com/team/devin.webp"}</script><style id="c3-nohscroll">html{overflow-x:clip}#c3-fab{display:none !important}</style><script type="application/ld+json">{"@context":"https://schema.org","@type":"Article","headline":"Grand Strand Neighborhoods | Myrtle Beach Area Guide","description":"Grand Strand submarket research: home prices, rental income, and investor data for Myrtle Beach, Murrells Inlet, North Myrtle Beach, and five more areas.","image":"https://chapter3realty.com/og-image.jpg","datePublished":"2026-06-12","dateModified":"2026-11-03","author":{"@id":"https://chapter3realty.com/about/#devin-day"},"publisher":{"@id":"https://chapter3realty.com/#org"},"mainEntityOfPage":"https://chapter3realty.com/submarkets/"}</script><style id="c3-hub-h1-fit">@media (max-width:359px){#page-submarkets-index h1{font-size:2.1rem!important}}</style></head>
 <body>
