+ * homes spread across the place's price range (photos first, so the row shows a wide variety),
+ * each card a photo, the price and the listing firm (16.14), then a "See all" card. A place with
+ * fewer than STRIP_MIN homes keeps its empty slot (CSS hides it). The page's styles carry the look;
+ * the disclaimer (16.16, 16.17) is added once, before </main>. */
+const STRIP_CARDS = 10;
+const STRIP_MIN = 3;
+const SLOT = /<div class="hx-strip" data-place="([a-z0-9-]+)" data-name="([^"<>]*)"><\/div>/g;
+
+function spread(listings, n) {
+  const withPhoto = listings.filter((l) => safeUrl(l.photo));
+  const pool = (withPhoto.length >= STRIP_MIN ? withPhoto : listings).slice().sort((a, b) => (a.price || 0) - (b.price || 0));
+  if (pool.length <= n) return pool;
+  const out = [];
+  for (let i = 0; i < n; i++) out.push(pool[Math.round((i * (pool.length - 1)) / (n - 1))]);
+  return [...new Set(out)];
+}
