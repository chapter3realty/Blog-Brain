+   the home on a listing page or in the analyzer (window.c3AgentContext), else the page. */
+(function () {
+  var box = document.getElementById('c3a'); if (!box) return;
+  var form = document.getElementById('c3a-form'), done = document.getElementById('c3a-done'), err = document.getElementById('c3a-err');
+  var ctx = null, last = null;
+  function context(el) {
+    var c = { address: '', note: '' };
+    if (el && el.getAttribute('data-address')) c.address = el.getAttribute('data-address');
+    if (!c.address && typeof window.c3AgentContext === 'function') { try { var x = window.c3AgentContext() || {}; c.address = x.address || ''; c.note = x.note || ''; } catch (e) {} }
+    var addr = document.querySelector('.hx-l-addr'); if (!c.address && addr) c.address = addr.textContent.trim();
+    var mls = document.documentElement.getAttribute('data-hx-mls'); if (mls) c.note = (c.note ? c.note + ' ' : '') + 'MLS #' + mls + '.';
+    return c;
+  }
+  function open(el) {
+    ctx = context(el); last = document.activeElement;
+    var about = document.getElementById('c3a-about');
+    about.hidden = !ctx.address; about.textContent = ctx.address ? 'About ' + ctx.address : '';
+    form.hidden = false; done.hidden = true; err.hidden = true; box.hidden = false;
+    setTimeout(function () { document.getElementById('c3a-name').focus(); }, 30);
+    return true;
+  }
+  function close() { box.hidden = true; if (last && last.focus) last.focus(); }
+  window.c3AgentOpen = open;
+  box.addEventListener('click', function (e) { if (e.target === box || e.target.closest('[data-c3a-close]')) close(); });
+  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !box.hidden) close(); });
+  /* Every link to the contact page, and anything marked data-agent, opens the form. The contact page itself still works when opened directly. */
+  document.addEventListener('click', function (e) {
+    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+    var a = e.target.closest && e.target.closest('a[href^="/contact"],[data-agent]');
+    if (!a || a.hasAttribute('data-no-agent') || /^\/contact\/?$/.test(location.pathname)) return;
+    e.preventDefault(); e.stopPropagation(); open(a);
+  }, true);
+  form.addEventListener('submit', function (e) {
+    e.preventDefault(); err.hidden = true;
+    function v(id) { return document.getElementById(id).value.trim(); }
+    var name = v('c3a-name'), phone = v('c3a-phone'), email = v('c3a-email'), cb = document.getElementById('c3a-consent');
+    var digits = phone.replace(/[^0-9]/g, '');
+    if (!name) { err.textContent = 'Please add your name.'; err.hidden = false; return; }
+    if (digits.length < 10) { err.textContent = 'Please add a phone number we can call.'; err.hidden = false; return; }
+    if (email.indexOf('@') < 1) { err.textContent = 'Please add your email.'; err.hidden = false; return; }
+    if (!cb.checked) { err.textContent = 'Please tick the box so we may call and text you.'; err.hidden = false; return; }
+    if (typeof window.c3SendForm === 'function') {
+      window.c3SendForm({ name: name, phone: phone, email: email, consent: 'yes', property_address: (ctx && ctx.address) || '',
+        message: 'Talk to an agent. ' + ((ctx && ctx.address) ? 'About ' + ctx.address + '. ' : '') + ((ctx && ctx.note) || '') + ' Page: ' + document.title }, 'Talk to an Agent');
+    }
+    form.hidden = true; done.hidden = false;
+  });
+})();
