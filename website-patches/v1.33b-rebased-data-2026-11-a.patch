+   "terms_urls": ["https://imagery.nationalmap.gov/arcgis/rest/services/USGSNAIPImagery/ImageServer", "https://www.fsa.usda.gov/help/policies-and-links/"],
+   "taken": "2023", "display_credit": "U.S. government aerial photo, 2023",
