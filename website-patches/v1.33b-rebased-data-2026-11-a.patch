index 00000000..09c3734d
--- /dev/null
+++ b/data/2026-11-a/invest-condos/count_ratio.py
@@ -0,0 +1,14 @@
+"""Counts of residential parcels with a building in Horry County GIS layer 24, condo units (legal description has 'HPR')
+against all other homes, and how many carry the 4 percent legal-residence ratio (AssessedProp under 5 percent of TaxableProp).
+Run: python3 -I count_ratio.py <datadir>. Writes raw/ratio-counts.json with every query URL."""
+import json, sys, time, urllib.request, urllib.parse
+D = sys.argv[1]; Q = "https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer/24/query?"
+BASE = "LandUseCode LIKE '1%' AND MarketImprv > 0"
+W = {"condo_all": BASE + " AND LegalDescr LIKE '%HPR%'", "condo_4pct": BASE + " AND LegalDescr LIKE '%HPR%' AND AssessedProp < TaxableProp*0.05",
+     "other_all": BASE + " AND LegalDescr NOT LIKE '%HPR%'", "other_4pct": BASE + " AND LegalDescr NOT LIKE '%HPR%' AND AssessedProp < TaxableProp*0.05"}
+out = {"read": time.strftime("%Y-%m-%d"), "layer": Q[:-7], "counts": {}}
+for k, w in W.items():
+    url = Q + urllib.parse.urlencode({"where": w, "returnCountOnly": "true", "f": "json"})
+    n = json.load(urllib.request.urlopen(url, timeout=120))["count"]
+    out["counts"][k] = {"where": w, "url": url, "count": n}; print(k, n)
+json.dump(out, open(D + "/raw/ratio-counts.json", "w"), indent=1)
diff --git a/data/2026-11-a/invest-condos/fetch_condo_parcels.py b/data/2026-11-a/invest-condos/fetch_condo_parcels.py
new file mode 100644
index 00000000..387f6a4c
--- /dev/null
+++ b/data/2026-11-a/invest-condos/fetch_condo_parcels.py
@@ -0,0 +1,23 @@
+"""Every condo unit parcel in Horry County: GIS layer 24, residential (LandUseCode 1xx) with a building value, legal description
+containing 'HPR' (horizontal property regime, a condo under SC Code Title 27 Chapter 31). Fields kept: legal description, tax district,
+assessed, taxable and market values, owner mailing state, sale date. No owner name or street.
+Usage: RAW=<scratch> python3 -I fetch_condo_parcels.py. Writes RAW/condo-parcels.json (keeps PIN for joins; stays outside the repo)."""
+import json, os, sys, time, urllib.request, urllib.parse
+RAW = os.environ["RAW"]
+Q = "https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer/24/query"
+WHERE = "LegalDescr LIKE '%HPR%' AND LandUseCode LIKE '1%' AND MarketImprv > 0"
+F = "PIN,LegalDescr,TaxDistrict,LandUseCode,AssessedProp,TaxableProp,MarketProp,MarketLand,OwnerState,SaleDate"
+rows, off = [], 0
+while True:
+    data = urllib.parse.urlencode({"where": WHERE, "outFields": F, "orderByFields": "OBJECTID", "resultOffset": off, "resultRecordCount": 2000, "returnGeometry": "false", "f": "json"}).encode()
+    for i in range(5):
+        try:
+            d = json.loads(urllib.request.urlopen(urllib.request.Request(Q, data=data), timeout=180).read())
+            if "error" in d: raise Exception(d["error"])
+            break
+        except Exception as e:
+            print("retry", e, file=sys.stderr); time.sleep(5)
+    feats = [x["attributes"] for x in d["features"]]; rows += feats; off += len(feats); print(off, flush=True)
+    if not feats or not d.get("exceededTransferLimit"): break
+json.dump({"query": Q, "where": WHERE, "fields": F, "read": time.strftime("%Y-%m-%d"), "rows": rows}, open(os.path.join(RAW, "condo-parcels.json"), "w"))
+print("rows", len(rows))
diff --git a/data/2026-11-a/invest-condos/fetch_flood.py b/data/2026-11-a/invest-condos/fetch_flood.py
new file mode 100644
index 00000000..514f2f61
--- /dev/null
+++ b/data/2026-11-a/invest-condos/fetch_flood.py
@@ -0,0 +1,30 @@
+"""FEMA flood zone (Horry County GIS layer 19, 'Flood Zones', fields FLD_ZONE, SFHA_TF, STATIC_BFE) at the center point
+of every kept home sale in batch 2026-10-d's deed file (Horry County deeds recorded 2025-10-01 to 2026-09-30).
+Usage: RAW=<scratch> python3 -I fetch_flood.py <deed file out-of-state-buyers.json>
+Writes RAW/flood-points.json keyed by 'lat,lon' (no PIN, address or owner)."""
+import json, os, sys, time, urllib.request, urllib.parse
+from concurrent.futures import ThreadPoolExecutor
+RAW = os.environ["RAW"]; deeds = json.load(open(sys.argv[1]))["sales"]
+Q = "https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer/19/query?"
+out_f = os.path.join(RAW, "flood-points.json")
+done = json.load(open(out_f)) if os.path.exists(out_f) else {}
+pts = sorted({f"{x['lat']:.5f},{x['lon']:.5f}" for x in deeds if x.get("lat") and x.get("lon")} - set(done))
+print(len(pts), "points to query", flush=True)
+def one(k):
+    lat, lon = k.split(",")
+    q = urllib.parse.urlencode({"geometry": f"{lon},{lat}", "geometryType": "esriGeometryPoint", "inSR": 4326, "spatialRel": "esriSpatialRelIntersects",
+                                "outFields": "FLD_ZONE,SFHA_TF,STATIC_BFE,ZONE_SUBTY" if False else "FLD_ZONE,SFHA_TF,STATIC_BFE", "returnGeometry": "false", "f": "json"})
+    for i in range(5):
+        try:
+            d = json.loads(urllib.request.urlopen(urllib.request.Request(Q + q, headers={"User-Agent": "Mozilla/5.0"}), timeout=60).read())
+            if "error" in d: raise Exception(d["error"])
+            return k, [f["attributes"] for f in d["features"]]
+        except Exception as e:
+            time.sleep(3 + 2 * i)
+    return k, None
+with ThreadPoolExecutor(8) as ex:
+    for n, (k, v) in enumerate(ex.map(one, pts)):
+        if v is not None: done[k] = v
+        if n % 500 == 0:
+            print(n, flush=True); json.dump(done, open(out_f, "w"))
+json.dump(done, open(out_f, "w")); print("done", len(done))
