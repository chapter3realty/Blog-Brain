+ var hasDown=document.getElementById("coDown").value.trim()!=="",hasRate=document.getElementById("coRate").value.trim()!=="";
+ var ask=hasDown&&hasRate?"":"Add "+(hasDown?"your rate":hasRate?"your down payment":"down payment and rate");
+ document.getElementById("coPI").textContent=ask||fmt(pi);
+ document.getElementById("coTax").textContent=fmt(tax);
+ document.getElementById("coInsOut").textContent=fmt(ins);
+ document.getElementById("coHoaOut").textContent=fmt(hoa);
+ document.getElementById("coUp").textContent=fmt(up);
+ document.getElementById("coTotal").textContent=ask||fmt(pi+tax+ins+hoa+up);
+}
