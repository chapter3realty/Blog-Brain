new file mode 100644
index 00000000..1799a104
--- /dev/null
+++ b/data/2026-11-a/buyers-cost-to-own/analyze_ahs.py
@@ -0,0 +1,44 @@
+#!/usr/bin/env python3
+"""Routine maintenance a homeowner spends in a typical year, from the Census American Housing Survey 2023 national PUF.
+Input: household.csv from https://www2.census.gov/programs-surveys/ahs/2023/AHS%202023%20National%20PUF%20v1.1%20CSV.zip
+(MAINTAMT = yearly routine maintenance cost in a typical year, dollars; the Census verification sheet puts the owner median at $510; MARKETVAL = owner's estimate of value; WEIGHT = final weight).
+AHS definition (2023 AHS Definitions, "Routine maintenance costs in typical year"): minor repairs, painting, restoring shingles,
+fixing water pipes, replacing parts of large equipment, repairing fences, gutters, decks; NOT room additions, remodeling or replacements.
+Groups: owner-occupied (TENURE 1), one-family detached (BLD 02), and owned units in buildings of 3+ units (BLD 05-09, mostly condos), U.S. and South Atlantic division (DIVISION 5, which holds SC).
+Negative codes (-6 not applicable, -9 not reported) are dropped. Usage: python3 -I analyze_ahs.py <household.csv> <out.json>"""
+import csv, json, sys
+src, out = sys.argv[1], sys.argv[2]
+def clean(v): return v.strip().strip("'\"")
+def wq(pairs, q):
+    pairs = sorted(pairs); tot = sum(w for _, w in pairs); acc = 0
+    for v, w in pairs:
+        acc += w
+        if acc >= q * tot: return v
+groups = {}
+with open(src, newline='') as f:
+    for r in csv.DictReader(f):
+        r = {k.strip("'\""): clean(v) for k, v in r.items()}
+        if r['TENURE'] != '1' or r['BLD'] not in ('02', '05', '06', '07', '08', '09'): continue
+        kind = 'house' if r['BLD'] == '02' else 'apt'
+        try: m, val, w = float(r['MAINTAMT']), float(r['MARKETVAL']), float(r['WEIGHT'])
+        except ValueError: continue
+        if m < 0 or w <= 0: continue
+        yb = r.get('YRBUILT', '')
+        for g in ('US', 'SouthAtlantic' if r['DIVISION'] == '5' else None):
+            if not g: continue
+            if kind == 'apt': g = g + '_owned_unit_in_building_of_3plus'
+            groups.setdefault(g, []).append((m, val if val > 0 else None, w, yb))
+res = {'source': 'Census AHS 2023 National PUF v1.1, household.csv', 'rule': __doc__, 'groups': {}}
+for g, rows in groups.items():
+    yr = [(a, w) for a, _, w, _ in rows]
+    share = [(a / v, w) for a, v, w, _ in rows if v]
+    tot = sum(w for _, w in yr)
+    old = [(a, w) for a, _, w, yb in rows if yb.isdigit() and int(yb) < 1980]
+    new = [(a, w) for a, _, w, yb in rows if yb.isdigit() and int(yb) >= 2000]
+    res['groups'][g] = {'records': len(rows), 'weighted_homes': round(tot),
+        'yearly': {'p25': wq(yr, .25), 'median': wq(yr, .5), 'p75': wq(yr, .75), 'mean': round(sum(a * w for a, w in yr) / tot)},
+        'share_spending_zero': round(sum(w for a, w in yr if a == 0) / tot, 3),
+        'pct_of_value': {'median': round(wq(share, .5) * 100, 2), 'mean_of_totals': round(sum(a * w for a, v, w, _ in rows if v) / sum(v * w for a, v, w, _ in rows if v) * 100, 2)},
+        'mean_marketval_of_homes_with_value': round(sum(v * w for a, v, w, _ in rows if v) / sum(w for a, v, w, _ in rows if v)),
+        'built_before_1980_median': wq(old, .5) if old else None, 'built_2000_or_later_median': wq(new, .5) if new else None}
+json.dump(res, open(out, 'w'), indent=1); print(json.dumps(res['groups'], indent=1))
diff --git a/data/2026-11-a/buyers-cost-to-own/analyze_ahs_jobs.py b/data/2026-11-a/buyers-cost-to-own/analyze_ahs_jobs.py
new file mode 100644
index 00000000..cb59d24c
--- /dev/null
+++ b/data/2026-11-a/buyers-cost-to-own/analyze_ahs_jobs.py
@@ -0,0 +1,41 @@
+#!/usr/bin/env python3
+"""What the big replacements cost, from the Census American Housing Survey 2023 national PUF (project.csv joined to household.csv).
+JOBTYPE labels from the AHS 2023 Value Labels Package: 16 roofing, 26 central air conditioning, 27 built-in heating, 29 water heater,
+18 doors or windows, 17 siding, 33 fencing. JOBCOST = what the job cost (dollars; Census adds noise to the PUF).
+Group: owner-occupied (TENURE 1) one-family detached (BLD 02) homes in the South Atlantic division (DIVISION 5, holds SC).
+Jobs with JOBCOST <= 0 or a negative code are dropped. Weighted by the household WEIGHT.
+Also the mean yearly spend on these seven jobs per home (two-year window per the 2023 AHS Definitions, 'Exterior additions and replacements').
+Usage: python3 -I analyze_ahs_jobs.py <household.csv> <project.csv> <out.json>"""
+import csv, json, sys
+hh, pj, out = sys.argv[1:4]
+def c(v): return v.strip().strip("'\"")
+H = {}
+with open(hh, newline='') as f:
+    for r in csv.DictReader(f):
+        r = {k.strip("'\""): c(v) for k, v in r.items()}
+        if r['TENURE'] == '1' and r['BLD'] == '02' and r['DIVISION'] == '5':
+            H[r['CONTROL']] = float(r['WEIGHT'])
+LAB = {'16': 'roof', '26': 'central air conditioning', '27': 'heating equipment', '29': 'water heater', '18': 'doors or windows', '17': 'siding', '33': 'fencing'}
+jobs = {k: [] for k in LAB}; did = {k: set() for k in LAB}
+with open(pj, newline='') as f:
+    for r in csv.DictReader(f):
+        r = {k.strip("'\""): c(v) for k, v in r.items()}
+        if r['CONTROL'] not in H or r['JOBTYPE'] not in LAB: continue
+        try: cost = float(r['JOBCOST'])
+        except ValueError: continue
+        did[r['JOBTYPE']].add(r['CONTROL'])
+        if cost > 0: jobs[r['JOBTYPE']].append((cost, H[r['CONTROL']]))
+def wq(p, q):
+    p = sorted(p); t = sum(w for _, w in p); a = 0
+    for v, w in p:
+        a += w
+        if a >= q * t: return v
+tot = sum(H.values())
+spend = sum(c * w for k in LAB for c, w in jobs[k])
+res = {'source': 'Census AHS 2023 National PUF v1.1 (household.csv, project.csv)', 'rule': __doc__, 'owner_detached_homes_weighted': round(tot), 'records': len(H), 'jobs': {},
+       'mean_yearly_spend_on_these_jobs_per_home': round(spend / 2 / tot), 'mean_rule': 'sum of job cost x weight over the seven types, / 2 (the survey asks about the last two years), / weighted owner detached homes (including homes with no job)'}
+for k, lab in LAB.items():
+    p = jobs[k]
+    res['jobs'][lab] = {'jobs_with_cost': len(p), 'median_cost': wq(p, .5) if p else None, 'p25': wq(p, .25) if p else None, 'p75': wq(p, .75) if p else None,
+                        'share_of_homes_reporting_job': round(sum(H[x] for x in did[k]) / tot, 3)}
+json.dump(res, open(out, 'w'), indent=1); print(json.dumps(res['jobs'], indent=1), res['mean_yearly_spend_on_these_jobs_per_home'])
