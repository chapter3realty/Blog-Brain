+    // The section in view is the last one whose top has passed 40% of the screen; above the first, none. Read from
+    // the layout on each frame, so a jump (a reload that restores the scroll, a link to a section) never leaves a
+    // stale tab marked.
+    let queued = false;
+    const update = () => {
+      queued = false;
+      const line = window.innerHeight * 0.4;
+      let id = null;
+      for (const section of sections) if (section.getBoundingClientRect().top <= line) id = section.id;
+      mark(id);
+    };
+    const queue = () => {
+      if (queued) return;
+      queued = true;
+      requestAnimationFrame(update);
+    };
+    addEventListener('scroll', queue, { passive: true });
+    addEventListener('resize', queue);
+    update();
+  })();
+  // Listing photos come from Airbnb and disappear when a host removes them: a cover shows its branded card instead,
+  // anything else drops the photo's box.
+  document.addEventListener(
+    'error',
+    (event) => {
+      const image = event.target;
+      if (!(image instanceof HTMLImageElement) || !image.hasAttribute('data-photo')) return;
+      if (image.parentElement?.hasAttribute('data-cover')) return image.remove();
+      const tile = image.closest('[data-monogram]');
+      if (tile) tile.textContent = tile.getAttribute('data-monogram');
+      else image.closest('[data-photo-box]')?.remove();
+    },
+    true
+  );
+</script> <script>
+  // Listing photos come from Airbnb and disappear when a host removes them; hide the broken image so the grey
+  // placeholder shows instead. Capture phase, because image error events do not bubble.
+  const hideImage = (image) => {
+    image.style.visibility = 'hidden';
+  };
+  document.addEventListener(
+    'error',
+    (event) => {
+      if (event.target instanceof HTMLImageElement && event.target.hasAttribute('data-hide-on-error')) {
+        hideImage(event.target);
+      }
+    },
+    true
+  );
+  // Any that failed before this ran.
+  document.querySelectorAll('img[data-hide-on-error]').forEach((image) => {
+    if (image.complete && image.naturalWidth === 0 && image.getAttribute('src')) hideImage(image);
+  });
+</script>
