+
+function getTax() {
+var marketValue = document.getElementById("marketValue").value;
+var district = document.getElementById("district").value;
+
+var res = document.getElementsByName("res");
+for (var i = 0, length = res.length; i < length; i++)
+{
+ if (res[i].checked)
+ {
+  var residence = res[i].value;
+  break;
+ }
+}
+
+var ratioa;
+var ratio;
+var taxes;
+var resulthtml;
+var millage;
+var hh;
+var sw;
+var swhh;
+
+if (marketValue == "" || residence == "" || district == "") {
+alert("Please complete all fields");
+return false;
+}
+else {
+var marketValue = Number(marketValue);
+if (!isInt(marketValue))
+{ alert("Please enter a valid number (integer) for market value");
+document.getElementById('marketValue').value = "";
+return false;
+}
+
+hh = 44;
+sw = 52;
+
