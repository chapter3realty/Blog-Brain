index 00000000..62ea52e2
--- /dev/null
+++ b/data/2026-11-a/submarkets-surfside-beach/build_map.py
@@ -0,0 +1,49 @@
+#!/usr/bin/env python3
+"""Map layers for /submarkets/surfside-beach/: the town's zoning districts drawn from its own zoning map (georef_zoning.py),
+grouped by what they allow for nightly rentals, the town limits (county layer 31), Ocean Boulevard and US 17 Business /
+US 17 (county layer 18), the pier, and the Ocean Lakes parent parcel (county layer 24, PIN 45900000325).
+Also counts town homes and active listings by group. No parcels, addresses or listing points are written.
+Run: RAW=<scratch> python3 -I build_map.py <datadir>. Writes map-layers.geojson and map-counts.json."""
+import sys, os, json, urllib.request, urllib.parse, collections
+from shapely.geometry import shape, mapping, Point, LineString
+from shapely.ops import unary_union
+RAW = os.environ["RAW"]; D = sys.argv[1]
+J = lambda n: json.load(open(os.path.join(RAW, n)))
+GROUP = {"R3": "nightly", "C3": "nightly", "R1": "no_nightly", "R2": "no_nightly"}
+town = shape(J("town-limits.geojson")["features"][0]["geometry"])
+z = collections.defaultdict(list)
+for f in J("zoning-polys.geojson")["features"]:
+    z[GROUP.get(f["properties"]["zone"], "other")].append(shape(f["geometry"]))
+feats = []
+LABEL = {"nightly": "R3 and C3: nightly rentals allowed", "no_nightly": "R1 and R2: no rentals under 30 days", "other": "Other districts (PD, C1, C2, C4, PL, MP): check the parcel"}
+for k, gs in z.items():
+    g = unary_union(gs).buffer(0.00002).buffer(-0.00002).intersection(town.buffer(0.0003)).simplify(0.00003)
+    feats.append({"type": "Feature", "properties": {"layer": "zoning", "group": k, "label": LABEL[k]}, "geometry": mapping(g)})
+feats.append({"type": "Feature", "properties": {"layer": "town_limits", "name": "Town of Surfside Beach (county layer 31)"}, "geometry": mapping(town.simplify(0.00003))})
+roads = collections.defaultdict(list)
+for f in J("roads.json"):
+    nm = (f["attributes"].get("FULLNAME") or "").upper()
+    key = "Ocean Boulevard" if nm in ("N OCEAN BLVD", "S OCEAN BLVD") else ("US 17 Business" if "17 BUS" in nm else ("US 17" if nm in ("HWY 17", "N HWY 17", "S HWY 17", "US HWY 17", "S KINGS HWY", "N KINGS HWY", "HWY 17 BYP", "US HWY 17 BYP") else None))
+    if key:
+        for p in f["geometry"]["paths"]: roads[key].append(LineString(p))
+for k, ls in roads.items():
+    feats.append({"type": "Feature", "properties": {"layer": "road", "name": k}, "geometry": mapping(unary_union(ls).simplify(0.00003))})
+feats.append({"type": "Feature", "properties": {"layer": "poi", "name": "Surfside Beach Pier", "src": "OSM/Nominatim, pull_drives.py"}, "geometry": {"type": "Point", "coordinates": [-78.9717534, 33.6049921]}})
+U = "https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer/24/query"
+r = json.loads(urllib.request.urlopen(urllib.request.Request(U, data=urllib.parse.urlencode({"where": "PIN = 45900000325", "outFields": "Acreage", "returnGeometry": "true", "outSR": "4326", "f": "json"}).encode()), timeout=300).read())
+ol = unary_union([shape({"type": "Polygon", "coordinates": x["geometry"]["rings"]}).buffer(0) for x in r["features"]])
+feats.append({"type": "Feature", "properties": {"layer": "ocean_lakes", "name": "Ocean Lakes Family Campground (county parcel 45900000325, outside the town)", "acres": r["features"][0]["attributes"]["Acreage"]}, "geometry": mapping(ol.simplify(0.00003))})
+json.dump({"type": "FeatureCollection", "features": feats}, open(os.path.join(D, "map-layers.geojson"), "w"))
+H = J("parcel-zones.json"); C = collections.Counter(GROUP.get(h["zone"], "other") for h in H)
+L = J("listings-ssb.json"); lc = collections.Counter()
+for h in L["homes"].values():
+    pt = Point(h["lng"], h["lat"])
+    if not town.contains(pt): lc["outside_town"] += 1; continue
+    g = "other"
+    for k, gs in z.items():
+        if any(s.contains(pt) for s in gs): g = k; break
+    lc[g] += 1
+out = {"homes_by_group": dict(C), "listings_by_group": dict(lc), "listings_pulled": L["pulled"],
+       "ocean_lakes_parcel_inside_town": town.intersects(ol), "ocean_lakes_centroid": [round(ol.centroid.x, 5), round(ol.centroid.y, 5)],
+       "ocean_lakes_north_of_town_north_edge": ol.centroid.y > town.bounds[3] - 0.003}
+json.dump(out, open(os.path.join(D, "map-counts.json"), "w"), indent=1); print(json.dumps(out, indent=1)); print([f["properties"] for f in feats])
diff --git a/data/2026-11-a/submarkets-surfside-beach/build_streets.py b/data/2026-11-a/submarkets-surfside-beach/build_streets.py
new file mode 100644
index 00000000..8ef5668a
--- /dev/null
+++ b/data/2026-11-a/submarkets-surfside-beach/build_streets.py
@@ -0,0 +1,63 @@
+"""Streets for the rental map on /submarkets/surfside-beach/ (fix round 1, 2026-11-04).
+Reads the county road centerlines already pulled for this page (county GIS layer 18, raw roads.json,
+the same pull build_map.py uses) and writes map-streets.geojson: every named street inside the town,
+simplified, plus a label point and direction for the streets the map names. Also prints which streets
+the inland edge of the nightly-rental band follows (ledger row 45).
+Run: python3 -I build_streets.py <raw dir> <data dir>."""
+import json, sys, math, collections
+from shapely.geometry import shape, LineString, Point, mapping
+from shapely.ops import unary_union, linemerge
+import shapely
+RAW, D = sys.argv[1], sys.argv[2]
+L = json.load(open(D + "/map-layers.geojson"))
+geo = {f["properties"].get("group") or f["properties"]["layer"]: shape(f["geometry"]) for f in L["features"] if f["properties"]["layer"] in ("zoning", "town_limits")}
+lat0 = 33.61; kx = math.cos(math.radians(lat0)) * 111320; ky = 110574
+fwd = lambda g: shapely.transform(g, lambda c: [[(x + 78.975) * kx, (y - lat0) * ky] for x, y in c])
+back = lambda g: shapely.transform(g, lambda c: [[x / kx - 78.975, y / ky + lat0] for x, y in c])
+town = fwd(geo["town_limits"]); night = fwd(geo["nightly"]); no = fwd(geo["no_nightly"])
+by = collections.defaultdict(list)
+for f in json.load(open(RAW + "/roads.json")):
+    nm = f["attributes"]["FULLNAME"]
+    if not nm: continue
+    for p in f["geometry"]["paths"]:
+        ls = fwd(LineString(p))
+        if town.buffer(20).intersects(ls): by[nm].append(ls)
+# Labels: street name on the map, and where along the street (share of its length inside the town).
+LABELS = {"N OCEAN BLVD": ("Ocean Blvd", 0.3), "DOGWOOD DR N": ("Dogwood Dr N", 0.8), "LAKESIDE DR": ("Lakeside Dr", 0.5),
+          "POPLAR DR N": ("Poplar Dr N", 0.5), "POPLAR DR S": ("Poplar Dr S", 0.5), "SURFSIDE DR": ("Surfside Dr", 0.62),
+          "16TH AVE N": ("16th Ave N", 0.65), "8TH AVE N": ("8th Ave N", 0.3), "6TH AVE S": ("6th Ave S", 0.45), "13TH AVE S": ("13th Ave S", 0.45)}
+feats = []
+for nm, ls in sorted(by.items()):
+    u = unary_union(ls).intersection(town.buffer(20))
+    if u.is_empty: continue
+    m = linemerge(u) if u.geom_type == "MultiLineString" else u
+    props = {"layer": "street", "name": nm}
+    if nm in LABELS:
+        text, at = LABELS[nm]
+        longest = max(m.geoms, key=lambda g: g.length) if m.geom_type == "MultiLineString" else m
+        a = longest.interpolate(at, normalized=True); b = longest.interpolate(min(1, at + 0.04), normalized=True)
+        if a.distance(b) < 1: b = longest.interpolate(max(0, at - 0.04), normalized=True)
+        A, B = back(a), back(b)
+        props.update({"label": text, "label_at": [round(A.x, 6), round(A.y, 6)], "label_dir": [round(B.x, 6), round(B.y, 6)]})
+    g = back(m.simplify(4))
+    feats.append({"type": "Feature", "properties": props, "geometry": shapely.geometry.mapping(g)})
+missing = [k for k in LABELS if not any(f["properties"]["name"] == k for f in feats)]
+assert not missing, missing
+json.dump({"type": "FeatureCollection", "note": "County road centerlines (layer 18) inside the Town of Surfside Beach, simplified to 4 m. build_streets.py.", "features": feats},
+          open(D + "/map-streets.geojson", "w"), separators=(",", ":"))
+# Row 45: the streets the band's inland edge follows, walking the edge every 60 m.
+edge = night.boundary.intersection(no.buffer(12))
+ax = (math.cos(0.85), math.sin(0.85)); pier = fwd(Point(-78.9717534, 33.6049921))
+along = lambda p: (p.x - pier.x) * ax[0] + (p.y - pier.y) * ax[1]
+pts = []
+for gm in (edge.geoms if hasattr(edge, "geoms") else [edge]):
+    n = max(1, int(gm.length // 60)); pts += [gm.interpolate(i / n, normalized=True) for i in range(n + 1)]
+allr = [(nm, unary_union(ls)) for nm, ls in by.items()]
+cnt = collections.Counter()
+for p in pts:
+    nm, d = min(((nm, u.distance(p)) for nm, u in allr), key=lambda t: t[1])
+    if d < 40 and "AVE" not in nm: cnt[(nm, "north of the pier" if along(p) > 0 else "south of the pier")] += 1
+out = {"edge_with_R1R2_m": round(edge.length), "points": len(pts), "nearest_street_counts": {f"{k[0]} ({k[1]})": v for k, v in cnt.most_common()}}
+for nm in ("N OCEAN BLVD", "DOGWOOD DR N", "LAKESIDE DR", "WILLOW DR S", "DOGWOOD DR S"):
+    u = unary_union(by[nm]); out[nm] = {"in_band_m": round(u.intersection(night).length), "in_R1R2_m": round(u.intersection(no).length)}
+json.dump(out, open(D + "/band-edge-streets.json", "w"), indent=1); print(json.dumps(out, indent=1))
