35rem;background:var(--ivory);padding:1.15rem 1.2rem}.wt-n{font-family:var(--serif);font-size:1.3rem;color:var(--brass);line-height:1}.wt-t{font-family:var(--sans);font-size:.95rem;font-weight:600;color:var(--navy);line-height:1.35}.wt-d{font-family:var(--sans);font-size:.84rem;color:var(--muted);line-height:1.55}</style></div></section>
