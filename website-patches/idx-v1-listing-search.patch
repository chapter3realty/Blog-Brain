+/* Flip to false the day Web3Forms is removed. It is the ONLY switch: it stops
+   the second send AND turns a CRM failure into a visible phone number. */
+function c3SendForm(fields, pageName) {
+  /* The disclosure EXACTLY as this page renders it. The CRM stores it verbatim
+     as proof of what the visitor saw, so it is read from the DOM, not hardcoded. */
+  var consentText = '';
+  var box = document.querySelector('.form-consent span');
+  if (box) { consentText = (box.textContent || '').replace(/\s+/g, ' ').trim(); }
+  if (!consentText) {
+    var nodes = document.querySelectorAll('.form-consent, label, span, p');
+    for (var i = 0; i < nodes.length; i++) {
+      var t = nodes[i].textContent || '';
+      if (t.indexOf('I consent to receive') > -1) { consentText = t.replace(/\s+/g, ' ').trim(); break; }
+    }
+  }
+
+  /* One of the CRM's three form types. A closed set: the page selects one of
+     theirs, it never invents a value. */
+  var p = location.pathname;
+  var formType = 'contact';
+  if (p.indexOf('/sell/home-value') === 0 || p.indexOf('/sell/net-proceeds') === 0) formType = 'valuation';
+  else if (p.indexOf('/sell/') === 0) formType = 'seller';
+
+  var crm = {
+    formType: formType,
+    name: fields.name || '',
+    phone: fields.phone || '',
+    email: fields.email || '',
+    consent: fields.consent === true || fields.consent === 'yes',
+    consentText: consentText,
+    website: '',
+    page: p,
+    formName: pageName || ''
+  };
+
+  /* The CRM's promoted keys land on the contact record itself, where the team
+     reads them. Anything else only reaches the submission. */
+  if (fields.property_address) { crm.property_address = String(fields.property_address); }
+  if (fields.building || fields.community) { crm.area = String(fields.building || fields.community); }
+  var msg = fields.message || fields.notes || fields.details || '';
+  if (msg) { crm.message = String(msg); }
+  if (fields.interest) { crm.interest = String(fields.interest); }
+
+  /* No consent box on this page means the CRM will refuse and alarm Slack.
+     Do not send it. */
+  if (!crm.consent) { console.warn('c3SendForm: no consent recorded, not sending'); return; }
+
+  function post(attempt) {
+    return fetch('https://app.chapter3realty.com/api/forms/lead', {
+      method: 'POST',
+      headers: {'Content-Type': 'application/json'},
+      body: JSON.stringify(crm)
+    }).then(function (r) {
+      return r.json().catch(function () { return {}; }).then(function (d) {
