--- /dev/null
+++ b/functions/sitemap-homes.xml.js
@@ -0,0 +1,29 @@
+/**
+ * /sitemap-homes.xml : the listing search's pages for search engines (contract §5).
+ * The search page and every "homes in <place>" page; single listings only when
+ * IDX_INDEX_LISTINGS=1 (from the CRM's sitemap feed, fetched at most once an hour).
+ */
+import { crm, idxOn } from "../idx-lib/crm.js";
+import { PLACES } from "../idx-lib/places.js";
+import { listingPath } from "../idx-lib/render.js";
+
+const SITE = "https://chapter3realty.com";
+const x = (s) => String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&apos;" })[c]);
+
+export async function onRequest(context) {
+  const { env, request } = context;
+  if (!idxOn(env, request).on || idxOn(env, request).preview) return new Response("Not found", { status: 404 });
+  const urls = [`<url><loc>${SITE}/homes/</loc></url>`, ...Object.keys(PLACES).map((s) => `<url><loc>${SITE}/homes/near/${s}/</loc></url>`)];
+  if (env.IDX_INDEX_LISTINGS === "1") {
+    const r = await crm(env, request, "/api/idx/sitemap", { anonymous: true, cacheSeconds: 3600, timeoutMs: 25000 } /* the CRM may take several seconds; only crawlers wait here */);
+    if (r.status === 200 && r.json && r.json.ok) {
+      for (const l of Array.isArray(r.json.listings) ? r.json.listings : []) {
+        if (!l || typeof l.mlsNumber !== "string" || !/^[A-Za-z0-9]{3,20}$/.test(l.mlsNumber)) continue;
+        const mod = /^\d{4}-\d{2}-\d{2}$/.test(l.updatedOn || "") ? `<lastmod>${l.updatedOn}</lastmod>` : "";
+        urls.push(`<url><loc>${x(SITE + listingPath(l))}</loc>${mod}</url>`);
+      }
+    }
+  }
+  return new Response(`<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n${urls.join("\n")}\n</urlset>\n`,
+    { headers: { "content-type": "application/xml; charset=utf-8", "cache-control": "public, max-age=3600" } });
+}
diff --git a/idx-lib/crm.js b/idx-lib/crm.js
new file mode 100644
index 00000000..16b99dc6
--- /dev/null
+++ b/idx-lib/crm.js
@@ -0,0 +1,139 @@
+/**
+ * The website's only door to the CRM's listing API (contract v1, 21 Oct 2026:
+ * docs/website-listing-api.md in the CRM repo). Server side only: the browser
+ * never calls the CRM's /api/idx.
+ *
+ * Settings (Cloudflare Pages -> Settings -> Variables and Secrets):
+ *   IDX_LIVE            "1" turns the listing search on. Anything else: /homes/*
+ *                       is a 404, the homes strips stay empty, the header keeps
+ *                       its old search pop-up.
+ *   IDX_API_SECRET      the production key (encrypted, Production env only).
+ *   IDX_DEV_KEY         the development key, in .dev.vars on Devin's machine only.
+ *                       Never in the Pages Preview env (preview URLs are public).
+ *   CRM_URL             optional, default https://app.chapter3realty.com
+ *   TURNSTILE_SITE_KEY  the public Turnstile site key for the sign-up form.
+ *   IDX_PREVIEW_WORD    optional: /homes/?idxpreview=<word> once shows the pages
+ *                       while IDX_LIVE is off (noindex).
+ *   IDX_INDEX_LISTINGS  optional, "1" lets search engines index single listings.
+ *
+ * Caching (contract §4): only answers to calls made WITHOUT a token, only a 200
+ * with ok: true, keyed by the exact CRM URL, at most 10 minutes (the sitemap an
+ * hour). A call with a token is never cached.
+ */
+import { TERMS_VERSION } from "./terms.js";
+
+export const COOKIE = "c3_idx";
+export const PREVIEW_COOKIE = "c3_idx_preview";
+export const ORIGINS = ["https://chapter3realty.com", "https://www.chapter3realty.com"];
+
+export function crmBase(env) {
+  // Only an https host: a wrong setting must never send the key elsewhere or in the clear.
+  const u = (env.CRM_URL || "").replace(/\/+$/, "");
+  return /^https:\/\/[a-z0-9.-]+$/i.test(u) ? u : "https://app.chapter3realty.com";
+}
+
+function key(env) {
+  return env.IDX_API_SECRET || env.IDX_DEV_KEY || "";
+}
+
+export function readCookie(request, name) {
+  const all = request.headers.get("Cookie") || "";
+  for (const part of all.split(/;\s*/)) {
+    const i = part.indexOf("=");
+    if (i > 0 && part.slice(0, i) === name) {
+      try { return decodeURIComponent(part.slice(i + 1)); } catch { return null; }
+    }
+  }
+  return null;
+}
+
+/** The payload of a token (not secret; the CRM checks the signature). */
+export function tokenPayload(token) {
+  try {
+    const b64 = token.split(".")[0].replace(/-/g, "+").replace(/_/g, "/");
+    return JSON.parse(atob(b64 + "===".slice((b64.length + 3) % 4)));
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * The visitor's token, or null. Signed out when the cookie is missing, malformed,
+ * past expiresAt, or for terms other than the current ones (new terms need no CRM
+ * change: bump TERMS_VERSION and everyone accepts again).
+ */
+export function visitorToken(request) {
+  const t = readCookie(request, COOKIE);
+  if (!t || t.length > 1500 || !/^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/.test(t)) return null;
+  const p = tokenPayload(t);
+  if (!p || typeof p.expiresAt !== "number" || p.expiresAt * 1000 <= Date.now()) return null;
+  if (p.termsVersion !== TERMS_VERSION) return null;
+  return t;
+}
+
+export const clearCookie = () => `${COOKIE}=; Path=/; Max-Age=0; HttpOnly; Secure; SameSite=Lax`;
+export const setCookie = (token) => `${COOKIE}=${encodeURIComponent(token)}; Path=/; Max-Age=7776000; HttpOnly; Secure; SameSite=Lax`;
+
+/** Is the search on for this request: live, or the owner's preview cookie? */
+export function idxOn(env, request) {
+  if (env.IDX_LIVE === "1") return { on: true, preview: false };
+  const word = env.IDX_PREVIEW_WORD;
+  if (word && readCookie(request, PREVIEW_COOKIE) === word) return { on: true, preview: true };
+  return { on: false, preview: false };
+}
+
+/** Only our own origins may post to /homes/api/* (contract §10). */
+export function sameOrigin(request) {
+  const o = request.headers.get("origin");
+  if (!o) return false;
+  if (ORIGINS.includes(o)) return true;
+  // Local development (wrangler pages dev) only: the request's own origin on localhost.
+  const own = new URL(request.url).origin;
+  return o === own && /^http:\/\/(localhost|127\.0\.0\.1)(:\d+)?$/.test(own);
+}
+
+/**
+ * GET or POST the CRM. path is built by the caller from parameters it validated.
+ * opts: { method, body, token (string|null|undefined = read the cookie), anonymous,
+ *         cacheSeconds, timeoutMs (default 8000) }. Returns { status, json, retryAfter }.
+ * A network failure or a timeout reads as { status: 502, json: null }; a non-JSON
+ * answer keeps its status with json: null.
+ */
+export async function crm(env, request, path, opts = {}) {
+  if (!key(env)) return { status: 503, json: { ok: false, error: "switched_off" } };
+  const method = opts.method || "GET";
+  const token = opts.anonymous ? null : opts.token !== undefined ? opts.token : visitorToken(request);
+  const url = `${crmBase(env)}${path}`;
+  const cacheable = !token && method === "GET";
+  const cache = typeof caches !== "undefined" ? caches.default : null;
+  const cacheKey = cacheable && cache ? new Request(`https://chapter3realty.com/__idx-cache/${encodeURIComponent(url)}`) : null;
+  if (cacheKey) {
+    const hit = await cache.match(cacheKey);
+    if (hit) return { status: 200, json: await hit.json() };
+  }
+  const headers = {
+    "x-idx-key": key(env),
+    "x-idx-client-ip": request.headers.get("cf-connecting-ip") || "",
+    accept: "application/json",
+  };
+  if (token) headers.authorization = `Bearer ${token}`;
+  if (opts.userAgent) headers["x-idx-user-agent"] = (request.headers.get("user-agent") || "").slice(0, 400);
+  if (opts.body) headers["content-type"] = "application/json";
+  let res;
+  try {
+    res = await fetch(url, { method, headers, body: opts.body ? JSON.stringify(opts.body) : undefined, signal: AbortSignal.timeout(opts.timeoutMs || 8000) });
+  } catch {
+    return { status: 502, json: null };
+  }
+  let json = null;
+  try {
+    json = await res.json();
+  } catch {
+    return { status: res.status === 200 ? 502 : res.status, json: null, retryAfter: res.headers.get("retry-after") };
+  }
+  if (cacheKey && res.status === 200 && json && json.ok === true) {
+    const seconds = Math.min(opts.cacheSeconds || 600, 3600);
+    await cache.put(cacheKey, new Response(JSON.stringify(json), { headers: { "content-type": "application/json", "cache-control": `public, max-age=${seconds}` } }));
+  }
+  return { status: res.status, json, retryAfter: res.headers.get("retry-after") };
+}
diff --git a/idx-lib/edge.js b/idx-lib/edge.js
new file mode 100644
index 00000000..b0e879ff
--- /dev/null
+++ b/idx-lib/edge.js
@@ -0,0 +1,139 @@
+/**
+ * What the listing search adds to the site's own pages, at the edge (functions/_middleware.js).
+ * Only while the search is on (IDX_LIVE, or the owner's preview cookie):
+ *
+ * 1. The header's "Search Listings" buttons open /homes/ instead of the old pop-up.
+ * 2. A guide page's homes strips are filled. A page carries empty slots,
+ *    <div class="hx-strip" data-place="<slug>" data-name="<Name>"></div> (Blog-Brain
+ *    tools/glass.js homes()), one per community, where the community's photo was. Each slot
+ *    gets one row that pans sideways: up to 10 homes spread across the place's price range,
+ *    photos first, each a photo, the price and the listing firm, then "See all N homes".
+ *    A place with fewer than 3 homes keeps its empty slot, and the page shows the place's
+ *    photo instead. If the MLS copy is stale (503), no listings show at all (CCMLS 16.7).
+ * 3. Where listings show, the notice (16.16, 16.17), the sign-up and tour dialogs and the
+ *    page script are added once.
+ */
+import { crm, idxOn, visitorToken } from "./crm.js";
+import { PLACES } from "./places.js";
+import { STYLE, STRIP_STYLE, SCRIPT, disclaimer, esc, safeUrl, signupDialog, stripCard, tourDialog } from "./render.js";
+
+const SLOT = /<div class="hx-strip" data-place="([a-z0-9-]+)" data-name="([^"<>]*)"><\/div>/g;
+const STRIP_CARDS = 10;
+const STRIP_MIN = 3;
+const STRIP_BUDGET_MS = 3000; // a slow CRM never holds up a guide page: past this, no strips
+const TYPES = ["house", "condo", "townhouse", "manufactured", "multi", "land"];
+
+/** The CRM search for a place, from validated parts only (contract §3, §5). Null if a part is bad. */
+export function placeParams(q) {
+  const p = new URLSearchParams();
+  if (q.subdivision !== undefined) {
+    if (!/^[A-Za-z0-9 .,'&()\/-]{2,80}$/.test(q.subdivision)) return null;
+    p.set("subdivision", q.subdivision);
+  }
+  if (q.near !== undefined) {
+    const m = /^(-?\d+(?:\.\d+)?),\s?(-?\d+(?:\.\d+)?)$/.exec(q.near);
+    if (!m) return null;
+    const lat = +m[1], lng = +m[2];
+    if (lat < 31 || lat > 37 || lng < -82 || lng > -75) return null;
+    p.set("near", `${lat.toFixed(6)},${lng.toFixed(6)}`);
+    const miles = Math.min(25, Math.max(0.1, Number(q.miles) || 1));
+    p.set("miles", String(miles));
+  }
+  if (!p.has("subdivision") && !p.has("near")) return null; // never "every listing in the MLS"
+  if (q.type !== undefined) {
+    if (!TYPES.includes(q.type)) return null;
+    p.set("type", q.type);
+  }
+  // hoa=0: only homes whose listing says there is no HOA (CRM ticket 415). The only value there is.
+  if (q.hoa !== undefined) {
+    if (String(q.hoa) !== "0") return null;
+    p.set("hoa", "0");
+  }
+  return p;
+}
+
+/** Up to n homes across the price range: lowest, highest and evenly between, photos first. */
+export function spread(listings, n = STRIP_CARDS) {
+  const withPhoto = listings.filter((l) => safeUrl(l.photo));
+  const pool = (withPhoto.length >= STRIP_MIN ? withPhoto : listings).slice().sort((a, b) => (a.listPrice || 0) - (b.listPrice || 0));
+  if (pool.length <= n) return pool;
+  const out = [];
+  for (let i = 0; i < n; i++) out.push(pool[Math.round((i * (pool.length - 1)) / (n - 1))]);
+  return [...new Set(out)];
+}
+
+/** Required wherever homes are shown as having no HOA (CRM ticket 415): where that fact comes from. */
+export const NO_HOA_NOTE = "No HOA, as listed by the listing agent. Confirm before you buy.";
+
+function strip(slug, name, listings, total, noHoa) {
+  const all = `/homes/near/${slug}/`;
+  // name is our own markup from the page (already escaped there): print it as it is.
+  const n = typeof total === "number" ? total : listings.length;
+  return `<p class="hx-s-head"><b>Homes for sale in ${name} now</b><a href="${all}">See all ${esc(String(n))}</a></p>`
+    + (noHoa ? `<p class="hx-s-note">${NO_HOA_NOTE}</p>` : "")
+    + `<div class="hx-s-row">${spread(listings).map((l) => stripCard(l, false)).join("")}`
+    + `<a class="hx-s-all" href="${all}" draggable="false">See all ${esc(String(n))} homes in ${name}</a></div>`;
+}
+
+const switchHeader = (html) => html.replace(/onclick="openIdx\(\)"/g, `onclick="location.href='/homes/'"`);
+
+/** The response with the listing search's additions, or untouched. Never throws. */
+export async function withIdx(context, response) {
+  let text = null;
+  try {
+    const { request, env } = context;
+    if (request.method !== "GET" || response.status !== 200) return response;
+    if (!(response.headers.get("content-type") || "").includes("text/html")) return response;
+    const gate = idxOn(env, request);
+    if (!gate.on) return response;
+    const url = new URL(request.url);
+    text = await response.text();
+    let html = switchHeader(text);
+    const headers = new Headers(response.headers);
+    headers.delete("content-length");
+    // The body changes, so the static file's validators no longer describe it (a 304 would bring back old strips).
+    headers.delete("etag");
+    headers.delete("last-modified");
+    const slots = url.pathname.startsWith("/homes") ? [] : [...html.matchAll(SLOT)];
+    if (!slots.length) return new Response(html, { status: 200, headers });
+
+    const slugs = [...new Set(slots.map((m) => m[1]))].filter((s) => PLACES[s]);
+    const calls = Promise.all(slugs.map((s) => {
+      const p = placeParams(PLACES[s].q);
+      if (!p) return null;
+      p.set("sort", "price_asc");
+      p.set("size", "48");
+      return crm(env, request, `/api/idx/listings?${p.toString()}`, { anonymous: true, timeoutMs: STRIP_BUDGET_MS - 500 }).catch(() => null);
+    }));
+    let timer;
+    const late = new Promise((done) => { timer = setTimeout(() => done(null), STRIP_BUDGET_MS); });
+    const answers = await Promise.race([calls, late]);
+    clearTimeout(timer);
+    if (!answers) return new Response(html, { status: 200, headers });
+    // A stale MLS copy means no listings anywhere on the page (16.7).
+    if (answers.some((r) => r && r.status === 503 && r.json && r.json.error === "stale")) return new Response(html, { status: 200, headers });
+    const filled = new Map();
+    let meta = null;
+    slugs.forEach((s, i) => {
+      const r = answers[i];
+      const ls = r && r.status === 200 && r.json && r.json.ok ? r.json.listings || [] : [];
+      if (ls.length >= STRIP_MIN) { filled.set(s, [ls, r.json.total]); meta = meta || r.json.meta; }
+    });
+    if (!filled.size) return new Response(html, { status: 200, headers });
+
+    html = html.replace(SLOT, (whole, slug, name) => {
+      const f = filled.get(slug);
+      return f ? `<div class="hx-strip" data-place="${slug}" data-name="${name}">${strip(slug, name, f[0], f[1], PLACES[slug].q.hoa !== undefined)}</div>` : whole;
+    });
+    const signed = Boolean(visitorToken(request));
+    html = html
+      .replace("</head>", () => `${STYLE}${STRIP_STYLE}</head>`)
+      .replace(/<body([^>]*)>/, (m, a) => `<body${a} data-hx-signed="${signed ? "1" : "0"}">`)
+      .replace("</main>", () => `<div class="hx-wrap" style="padding-top:0">${disclaimer(meta)}</div></main>`)
+      .replace("</body>", () => `${signupDialog(env.TURNSTILE_SITE_KEY)}${tourDialog()}${SCRIPT}</body>`);
+    headers.set("cache-control", signed || gate.preview ? "private, no-store" : "public, max-age=300");
+    return new Response(html, { status: 200, headers });
+  } catch {
+    return text === null ? response : new Response(text, { status: response.status, headers: response.headers });
+  }
+}
