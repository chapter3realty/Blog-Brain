35.4" stroke="#1c2028" stroke-width="5" stroke-linecap="round"/><path d="M240 300A50 50 0 0 1 225.4 335.4" fill="none" stroke="#1c2028" stroke-width="2" stroke-dasharray="4 4"/><circle cx="234" cy="293" r="4.5" fill="#1c2028"/><rect x="436" y="168" width="26" height="40" rx="5" fill="#1c2028"/><circle cx="449" cy="182" r="6" fill="none" stroke="#fff" stroke-width="2"/><path d="M404 222H432M404 216v12M432 216v12" stroke="#8a5226" stroke-width="2.5" stroke-linecap="round"/><text x="70" y="56" text-anchor="start" font-family="Inter,Arial,sans-serif" font-size="17" font-weight="600" fill="#1c2028">House</text><text x="272" y="230" text-anchor="middle" font-family="Inter,Arial,sans-serif" font-size="17" font-weight="600" fill="#1c2028">Pool</text><text x="60" y="340" text-anchor="start" font-family="Inter,Arial,sans-serif" font-size="14" font-weight="500" fill="#5a5f6b">Outside the fence</text><g><circle cx="40" cy="190" r="15" fill="#1c2028"/><text x="40" y="196" text-anchor="middle" font-family="Inter,Arial,sans-serif" font-size="17" font-weight="700" fill="#fff">1</text></g><g><circle cx="330" cy="300" r="15" fill="#1c2028"/><text x="330" y="306" text-anchor="middle" font-family="Inter,Arial,sans-serif" font-size="17" font-weight="700" fill="#fff">2</text></g><g><circle cx="258" cy="338" r="15" fill="#1c2028"/><text x="258" y="344" text-anchor="middle" font-family="Inter,Arial,sans-serif" font-size="17" font-weight="700" fill="#fff">3</text></g><g><circle cx="216" cy="276" r="15" fill="#1c2028"/><text x="216" y="282" text-anchor="middle" font-family="Inter,Arial,sans-serif" font-size="17" font-weight="700" fill="#fff">4</text></g><g><circle cx="245" cy="48" r="15" fill="#1c2028"/><text x="245" y="54" text-anchor="middle" font-family="Inter,Arial,sans-serif" font-size="17" font-weight="700" fill="#fff">5</text></g><g><circle cx="449" cy="140" r="15" fill="#1c2028"/><text x="449" y="146" text-anchor="middle" font-family="Inter,Arial,sans-serif" font-size="17" font-weight="700" fill="#fff">6</text></g></svg><ol class="pl-key" aria-label="What the numbers in the drawing show"><li><span class="n" aria-hidden="true">1</span><span><b>Height</b>At least 48 inches tall, measured on the side away from the pool.</span></li><li><span class="n" aria-hidden="true">2</span><span><b>Gaps</b>No opening a 4-inch ball could pass through. The gap under the fence is at most 2 inches over grass, or 4 over concrete.</span></li><li><span class="n" aria-hidden="true">3</span><span><b>The gate</b>It opens outward, away from the pool. It closes by itself and latches by itself.</span></li><li><span class="n" aria-hidden="true">4</span><span><b>The latch</b>A latch lower than 54 inches goes on the pool side, at least 3 inches below the top of the gate.</span></li><li><span class="n" aria-hidden="true">5</span><span><b>Doors and windows</b>Where the house wall is part of the barrier, each door to the pool needs an alarm. Each window with a sill under 48 inches needs one too.</span></li><li><span class="n" aria-hidden="true">6</span><span><b>The pump</b>Pumps, filters and heaters sit at least 36 inches from the outside of the fence, so they cannot be used to climb over it.</span></li></ol></div><figcaption>Our drawing of section 305 of the 2021 International Swimming Pool and Spa Code, as Horry County's pool fence form quotes it.</figcaption></figure><ul class="pl-plain" aria-label="Three more parts of the county's rule"><li><b>Covers instead of a fence</b>A hot tub with a safety cover that locks needs no fence. Neither does a pool with a powered safety cover that meets the safety standard.</li><li><b>Instead of door alarms</b>The code also allows a safety cover on the pool, tested and labeled to the safety standard. The county can approve another protection, such as doors that close and latch by themselves.</li><li><b>A new pool</b>It needs a county permit and inspections, and no one may swim in it until the county approves them.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The rule is there for small children. Most children who drown in a pool or spa drown at a home, the <a href="https://www.cpsc.gov/s3fs-public/Pool-or-Spa-Submersion-Estimated-Nonfatal-Drowning-Injuries-and-Reported-Drownings-2026-Report.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Consumer Product Safety Commission</a> reports.</p></div></section><section style="background:var(--ivory-2)" id="inspection"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Inspection">Do home inspectors check pools in South Carolina?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not unless you ask. The standard South Carolina home inspectors follow comes from the <a href="https://www.homeinspector.org/Resources/Standard-of-Practice" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">American Society of Home Inspectors</a>. It does not require them to inspect a pool, a hot tub or a fence.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You and the inspector can agree to add the pool. The inspector must tell you before the inspection what it will not cover.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Buying a house with a pool?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us which house. We ask the seller for the pool's county permit papers and tell you what the inspection will leave out.</p><a class="btn btn-brass" href="/contact/">Have us look into the pool</a></div></div></section><section style="background:var(--ivory)" id="pool-homes-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Pool homes FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Are there homes with a pool under $300,000 in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Few. On the day we counted, 5 of the 575 houses for sale in Horry County at $300,000 or less had their own pool. 168 houses at that price were in a neighborhood with a shared pool.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does a pool add value to a home in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On asking prices, yes. At every size we checked, houses with a pool ask more than houses without one. Part of that gap comes from where they are: nearer the beach and more often on the water.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do pool homes in Myrtle Beach allow short-term rentals?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">More often than other houses. About 28 percent of houses for sale with their own pool say short-term rentals are allowed, against about 12 percent of all houses.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Are pool homes near Myrtle Beach in gated communities?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About 1 in 5 houses for sale with their own pool is in a gated community, against about 1 in 9 of all houses.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do townhouses near Myrtle Beach have a pool?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Many share one. Half of the 298 townhouses for sale in Horry County, 149, are in a community with a shared pool. Their middle asking price is about $270,000.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.horrycountysc.gov/media/r2sebvu1/pool-fence-affidavit-2021-ispsc.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County fence form</a>, <a href="https://www.scstatehouse.gov/code/statmast.php?title=6&chapter=9" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 6-9</a>, <a href="https://llr.sc.gov/bcc/PDFfiles/Building%20Codes%20in%20Effect%20for%20South%20Carolina%20Final.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC codes council</a>, <a href="https://www.scstatehouse.gov/code/statmast.php?title=40&chapter=59" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 40-59</a>, <a href="https://www.llr.sc.gov/res/PDF/FAQ/RBI%20FAQ.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">LLR inspector FAQ</a>, <a href="https://www.homeinspector.org/Resources/Standard-of-Practice" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">ASHI standard</a>, <a href="https://www.scstatehouse.gov/code/t12c037.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-37</a>, <a href="https://www.des.sc.gov/sites/des/files/Library/Regulations/R.61-51.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">DES R.61-51</a>, <a href="https://content.naic.org/article/consumer_insight_protecting_your_home_coverage_pools_hot_tubs_and_backyard_toys.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NAIC</a>, <a href="https://www.energystar.gov/products/pool_pumps" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">ENERGY STAR</a>, <a href="https://www.cpsc.gov/s3fs-public/Pool-or-Spa-Submersion-Estimated-Nonfatal-Drowning-Injuries-and-Reported-Drownings-2026-Report.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">CPSC</a>, <a href="https://www.ncei.noaa.gov/products/land-based-station/us-climate-normals" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NOAA normals</a>, <a href="https://www.mbgyc.com/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Golf and Yacht Club HOA</a>, <a href="https://waterbridgehoa.com/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Waterbridge HOA</a>, <a href="https://www.plantationlakespoa.com/community.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Plantation Lakes POA</a>. Homes for sale: our count of the listings on our site, Horry County, November 8, 2026, asking prices. Source: Coastal Carolinas Association of REALTORS® Multiple Listing Service (CCMLS).</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1rem"><strong style="color:var(--navy)">Legal notice.</strong> Chapter3 Realty Corp is a licensed South Carolina real estate brokerage. We are not attorneys, insurers or tax advisers, and nothing on this page is legal, insurance or tax advice. For the rule on one property, ask the county or city building office or a South Carolina attorney.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Four beach houses in a row, each with a small fenced pool between the house and the dunes, with wooden walkways over the dunes to the beach. Photo: U.S. Geological Survey, <a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://doi.org/10.5066/F7N877XX" target="_blank" rel="noopener noreferrer">U.S. Geological Survey</a>.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-11-n/buyers-pool-homes/surfside-beach-houses-with-pools-2011-1200w.webp","url":"https://chapter3realty.com/images/2026-11-n/buyers-pool-homes/surfside-beach-houses-with-pools-2011-1200w.webp","width":1200,"height":675,"encodingFormat":"image/webp","name":"Four beach houses in a row, each with a small fenced pool between the house and the dunes, with wooden walkways over the dunes to the beach","caption":"Four oceanfront houses in Surfside Beach, each with its own pool behind the dunes, seen from a plane in 2011.","description":"Four beach houses in a row, each with a small fenced pool between the house and the dunes, with wooden walkways over the dunes to the beach","creator":{"@type":"Organization","name":"U.S. Geological Survey"},"creditText":"U.S","copyrightNotice":"Public domain (U.S. Geological Survey)","license":"https://www.usa.gov/publicdomain/label/1.0/","acquireLicensePage":"https://doi.org/10.5066/F7N877XX","isBasedOn":"https://doi.org/10.5066/F7N877XX","contentLocation":{"@type":"Place","name":"The oceanfront of the Town of Surfside Beach (Horry County tax district 660), Surfside Beach, South Carolina"},"representativeOfPage":true}]}</script></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Want a pool home? We will find it.</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">Tell us your price and the towns you like. We set up a search for houses with a pool, or in a neighborhood with one, and send you the matches.</p><a class="btn btn-brass btn-lg" href="/contact/">Have us set up your pool-home search</a></div></section></main>
