1c2028" stroke-width="2"/><text x="219.2" y="136.6" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-size="21" font-weight="600" fill="#1c2028" paint-order="stroke" stroke="#fbf8f3" stroke-width="6" stroke-linejoin="round"><tspan x="219.2" dy="0">Loris</tspan></text><circle cx="291.3" cy="219.0" r="4.5" fill="#fff" stroke="#1c2028" stroke-width="2"/><text x="291.3" y="204.0" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-size="21" font-weight="600" fill="#1c2028" paint-order="stroke" stroke="#fbf8f3" stroke-width="6" stroke-linejoin="round"><tspan x="291.3" dy="0">Longs</tspan></text><circle cx="71.1" cy="184.7" r="4.5" fill="#fff" stroke="#1c2028" stroke-width="2"/><text x="71.1" y="169.7" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-size="21" font-weight="600" fill="#1c2028" paint-order="stroke" stroke="#fbf8f3" stroke-width="6" stroke-linejoin="round"><tspan x="71.1" dy="0">Aynor</tspan></text><circle cx="144.5" cy="277.5" r="4.5" fill="#fff" stroke="#1c2028" stroke-width="2"/><text x="131.5" y="284.5" text-anchor="end" font-family="Inter,system-ui,sans-serif" font-size="21" font-weight="600" fill="#1c2028" paint-order="stroke" stroke="#fbf8f3" stroke-width="6" stroke-linejoin="round"><tspan x="131.5" dy="0">Conway</tspan></text><circle cx="334.4" cy="251.7" r="4.5" fill="#fff" stroke="#1c2028" stroke-width="2"/><text x="338.4" y="235.7" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-size="21" font-weight="600" fill="#1c2028" paint-order="stroke" stroke="#fbf8f3" stroke-width="6" stroke-linejoin="round"><tspan x="338.4" dy="0">Little River</tspan></text><circle cx="305.4" cy="284.5" r="4.5" fill="#fff" stroke="#1c2028" stroke-width="2"/><text x="345.4" y="320.5" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-size="21" font-weight="600" fill="#1c2028" paint-order="stroke" stroke="#fbf8f3" stroke-width="6" stroke-linejoin="round"><tspan x="345.4" dy="0">North Myrtle</tspan><tspan x="345.4" dy="23">Beach</tspan></text><circle cx="220.3" cy="347.0" r="4.5" fill="#fff" stroke="#1c2028" stroke-width="2"/><text x="234.3" y="365.0" text-anchor="start" font-family="Inter,system-ui,sans-serif" font-size="21" font-weight="600" fill="#1c2028" paint-order="stroke" stroke="#fbf8f3" stroke-width="6" stroke-linejoin="round"><tspan x="234.3" dy="0">Myrtle Beach</tspan></text><circle cx="177.8" cy="403.4" r="4.5" fill="#fff" stroke="#1c2028" stroke-width="2"/><text x="189.8" y="425.4" text-anchor="start" font-family="Inter,system-ui,sans-serif" font-size="21" font-weight="600" fill="#1c2028" paint-order="stroke" stroke="#fbf8f3" stroke-width="6" stroke-linejoin="round"><tspan x="189.8" dy="0">Surfside Beach</tspan></text></g></svg><div class="bd-key" aria-hidden="true"><span><i style="background:#2a78d6"></i>D.R. Horton</span><span><i style="background:#eb6834"></i>Lennar</span><span><i style="background:#1baf7a"></i>Ryan Homes</span><span><i style="background:#eda100"></i>Pulte Homes</span><span><i style="background:#e87ba4"></i>Meritage Homes</span><span><i style="background:#b9b0a2"></i>Every other seller</span></div><figcaption>Each dot is a place where a builder sold new homes. A larger dot stands for more homes. Map: Chapter3 Realty, from county deeds, county parcel records and Census map lines.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Each town has its own leaders. Among the builders on the chart, D.R. Horton sold the most in Conway, Loris, Little River and Surfside Beach. Lennar sold the most in Longs, Myrtle Beach and North Myrtle Beach:</p><table class="bd-t bd-towns"><caption>New homes sold, by mailing town</caption><thead><tr><th scope="col">Town</th><th scope="col" class="num">New homes sold</th><th scope="col">Builders that sold the most there</th><th scope="col" class="num">Middle price</th></tr></thead><tbody><tr><th scope="row"><a href="/submarkets/conway/">Conway</a></th><td class="num" data-l="New homes sold">1,478</td><td class="txt" data-l="Builders that sold the most">D.R.&nbsp;Horton, Lennar, Mungo&nbsp;Homes</td><td class="num" data-l="Middle price">$312,000</td></tr><tr><th scope="row">Longs</th><td class="num" data-l="New homes sold">1,340</td><td class="txt" data-l="Builders that sold the most">Lennar, Meritage&nbsp;Homes, D.R.&nbsp;Horton</td><td class="num" data-l="Middle price">$328,000</td></tr><tr><th scope="row"><a href="/submarkets/myrtle-beach/">Myrtle Beach</a></th><td class="num" data-l="New homes sold">1,131</td><td class="txt" data-l="Builders that sold the most">Lennar, D.R.&nbsp;Horton, Pulte&nbsp;Homes</td><td class="num" data-l="Middle price">$418,000</td></tr><tr><th scope="row"><a href="/submarkets/north-myrtle-beach/">North Myrtle Beach</a></th><td class="num" data-l="New homes sold">383</td><td class="txt" data-l="Builders that sold the most">Lennar, Pulte&nbsp;Homes, Ryan&nbsp;Homes</td><td class="num" data-l="Middle price">$503,000</td></tr><tr><th scope="row">Loris</th><td class="num" data-l="New homes sold">315</td><td class="txt" data-l="Builders that sold the most">D.R.&nbsp;Horton, Lennar, Starlight&nbsp;Homes</td><td class="num" data-l="Middle price">$276,000</td></tr><tr><th scope="row"><a href="/submarkets/little-river/">Little River</a></th><td class="num" data-l="New homes sold">256</td><td class="txt" data-l="Builders that sold the most">D.R.&nbsp;Horton, Ashton&nbsp;Woods, Lennar</td><td class="num" data-l="Middle price">$327,000</td></tr><tr><th scope="row"><a href="/submarkets/murrells-inlet/">Murrells Inlet</a></th><td class="num" data-l="New homes sold">135</td><td class="txt" data-l="Builders that sold the most">Ryan&nbsp;Homes, Toll&nbsp;Brothers, Lennar</td><td class="num" data-l="Middle price">$425,000</td></tr><tr><th scope="row">Aynor</th><td class="num" data-l="New homes sold">125</td><td class="txt" data-l="Builders that sold the most">Starlight&nbsp;Homes, Howell&nbsp;Homes, Great&nbsp;Southern&nbsp;Homes</td><td class="num" data-l="Middle price">$305,000</td></tr><tr><th scope="row"><a href="/submarkets/surfside-beach/">Surfside Beach</a></th><td class="num" data-l="New homes sold">70</td><td class="txt" data-l="Builders that sold the most">D.R.&nbsp;Horton, Ocean&nbsp;Palms&nbsp;Builders, Ameri&nbsp;Built&nbsp;Homes</td><td class="num" data-l="Middle price">$284,000</td></tr><tr><th scope="row">Galivants Ferry</th><td class="num" data-l="New homes sold">42</td><td class="txt" data-l="Builders that sold the most">D.R.&nbsp;Horton</td><td class="num" data-l="Middle price">$272,000</td></tr></tbody></table><p class="bd-note">Our count of county deeds for the same 12 months. Builders are listed with the most sales first. Towns with 40 or more new homes sold.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Three communities let you compare builders in one visit. In each, two or more builders each sold 10 or more homes. In Arcadia, they are Mungo Homes, Pulte Homes and Lennar. In Waterbridge, they are D.R. Horton and the community company Waterbridge SC LLC. In SayeBrook, they are Toll Brothers, Pulte Homes and Carolina Cottage Homes.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">What the ten busiest new communities have, from pools to boat docks, is in <a href="/buyers/new-construction/#where" style="color:var(--navy);text-decoration:underline">our new construction guide</a>.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Compare two builders in one afternoon</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us the town and your price. We pick the builders that build there at that price and set up the visits, as your agent from the first one.</p><a class="btn btn-brass" href="/contact/">Have us plan your builder visits</a></div></div></section><section style="background:var(--ivory-2)" id="largest"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The five largest">What are the five largest builders like?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For each one: what it sold, where, what its homes are like, and the warranty and lender its annual report states:</p><ul class="bd-plain bd-prof" aria-label="The five largest builders"><li><b>D.R. Horton</b><p>The most new homes of any builder, for about $325,000 in the middle.</p><span class="bd-l"><em>Where:</em> Auberon Woods in Conway and Eden Springs in Longs, and the most homes in Conway, Loris and Little River.</span><span class="bd-l"><em>The homes:</em> Its homes for sale now are mostly houses with 3 or 4 bedrooms, about 1,800 square feet in the middle.</span><span class="bd-l"><em>Warranty:</em> 1 year on most of the home, 2 years on the major systems of the house, 10 years on major structural parts.</span><span class="bd-l"><em>Lender:</em> It owns one, DHI Mortgage.</span></li><li><b>Lennar</b><p>The second most, for about $258,000 in the middle, the lowest price of these five.</p><span class="bd-l"><em>Where:</em> The Overlook in Longs and Kingston Oaks in Conway, and the most homes in Longs, Myrtle Beach and North Myrtle Beach.</span><span class="bd-l"><em>The homes:</em> Its homes for sale now are houses and townhouses, mostly with 3 or 4 bedrooms, about 1,800 square feet in the middle.</span><span class="bd-l"><em>Warranty:</em> At least 1 year on materials and workmanship. Its annual report gives no longer term.</span><span class="bd-l"><em>Lender:</em> It owns one.</span></li><li><b>Ryan Homes</b><p>The third most, for about $350,000 in the middle.</p><span class="bd-l"><em>Where:</em> Grande Dunes North Village, which has Longs mailing addresses, and more homes around Conway.</span><span class="bd-l"><em>The homes:</em> Its owner, NVR, builds Ryan Homes mainly for first-time buyers and buyers moving up from their first home.</span><span class="bd-l"><em>Warranty:</em> Its annual report gives no term. We get the booklet from the builder.</span><span class="bd-l"><em>Lender:</em> It owns one, NVR Mortgage.</span></li><li><b>Pulte Homes</b><p>The fourth most, for about $488,000 in the middle, the highest price of these five.</p><span class="bd-l"><em>Where:</em> <a href="/buyers/55-plus-communities/del-webb-north-myrtle-beach/" style="color:var(--navy);text-decoration:underline">Del Webb North Myrtle Beach</a> and Crescent Cove in Myrtle Beach, and more homes in Longs. Del Webb is PulteGroup's brand for active adults, and our <a href="/buyers/55-plus-communities/" style="color:var(--navy);text-decoration:underline">55+ guide</a> compares it with the others.</span><span class="bd-l"><em>The homes:</em> Its homes for sale now are all houses, mostly with 3 bedrooms, about 2,700 square feet in the middle. That is larger than the others here.</span><span class="bd-l"><em>Warranty:</em> 1 year on the whole home, and some parts for up to 10 years.</span><span class="bd-l"><em>Lender:</em> It owns one, Pulte Mortgage.</span></li><li><b>Meritage Homes</b><p>The fifth most, for about $340,000 in the middle.</p><span class="bd-l"><em>Where:</em> Cypress Ridge in Longs. Nearly all its homes have Longs addresses.</span><span class="bd-l"><em>The homes:</em> Its homes for sale now are houses with 3 or 4 bedrooms, about 1,600 square feet in the middle.</span><span class="bd-l"><em>Warranty:</em> Generally 1 year on workmanship, 2 years on the systems of the house, and up to 10 years on the structure.</span><span class="bd-l"><em>Lender:</em> It shares a mortgage company with a partner and works with lenders it prefers. It may pay part of the closing costs for buyers who use them.</span></li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Each of the five owns all or part of a mortgage company. At the four that give a share, most buyers who take a mortgage use it. That choice is separate from the house. Our guide covers <a href="/buyers/new-construction/#incentives" style="color:var(--navy);text-decoration:underline">whether to use the builder's lender</a>.</p></div></section><section style="background:var(--ivory)" id="owners"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Other builders">Who are the other large builders, and who owns them?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Several builders here sell under one name and sign deeds under another, and some have been bought by other companies. The name on the deed is the company that sold you the house, and it stands behind the warranty:</p><ul class="bd-plain bd-2" aria-label="Other builders and who owns them"><li><b>Mungo Homes</b>Its busiest community is Arcadia in Myrtle Beach, and about half its homes have Conway addresses. It is part of Clayton Properties Group, a Berkshire Hathaway company, and the deeds name Clayton Properties Group.</li><li><b>Great Southern Homes, now Stanley Martin</b>Mostly Conway addresses. This South Carolina builder became part of Stanley Martin Homes in 2026, and Stanley Martin now lists its homes for sale. Before the sale, it gave 1 year on materials and workmanship, 2 years on plumbing, wiring and heating and air, and 10 years on the structure.</li><li><b>Starlight Homes</b>Spring Grove in Aynor, Andalusia in Loris and Bayview in Conway, at some of the lowest prices on the chart. It is an Ashton Woods company. Ashton Woods also sells homes here under its own name, mostly with Little River addresses.</li><li><b>Dream Finders Homes</b>Mostly Conway addresses. It came here by buying the homebuilding business of H&amp;H Constructors of Fayetteville, and its count includes those homes. It gives 1 year on workmanship and up to 10 years on the structure, and owns a mortgage company, Jet HomeLoans.</li><li><b>Beazer Homes</b>It became part of Dream Finders Homes in 2026. Before that, its annual report said it owned no mortgage company and named several lenders for each community. It gave 1 to 2 years on workmanship and up to 10 years on certain structural failures.</li><li><b>Toll Brothers</b>The highest prices on the chart. Its homes are around North Myrtle Beach, Murrells Inlet and Myrtle Beach, including SayeBrook. Many of its buyers get a limited 10-year warranty on the structure, and it owns a mortgage company.</li></ul><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Know who you are buying from</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the builder's contract. We read it with you, line by line, starting with the name of the seller.</p><a class="btn btn-brass" href="/contact/">Send us the builder's contract</a></div></div></section><section style="background:var(--ivory-2)" id="prices"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What they cost">What do new homes from each builder cost?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Lennar and Starlight Homes sold for the least in the middle, and Toll Brothers for the most. The table gives the price range of each builder's sales, and how many of its homes are for sale now:</p><table class="bd-t bd-prices"><caption>What each builder's new homes sold for, and how many are for sale now</caption><thead><tr><th scope="col">Builder</th><th scope="col" class="num">Typical price range</th><th scope="col" class="num">For sale now</th></tr></thead><tbody><tr><th scope="row">D.R. Horton</th><td class="num" data-l="Typical price range">$279,000 to $375,000</td><td class="num" data-l="For sale now">248</td></tr><tr><th scope="row">Lennar</th><td class="num" data-l="Typical price range">$232,000 to $308,000</td><td class="num" data-l="For sale now">60</td></tr><tr><th scope="row">Ryan Homes</th><td class="num" data-l="Typical price range">$309,000 to $523,000</td><td class="num" data-l="For sale now">1</td></tr><tr><th scope="row">Pulte Homes</th><td class="num" data-l="Typical price range">$419,000 to $623,000</td><td class="num" data-l="For sale now">31</td></tr><tr><th scope="row">Meritage Homes</th><td class="num" data-l="Typical price range">$300,000 to $382,000</td><td class="num" data-l="For sale now">29</td></tr><tr><th scope="row">Mungo Homes</th><td class="num" data-l="Typical price range">$325,000 to $492,000</td><td class="num" data-l="For sale now">60</td></tr><tr><th scope="row">Great Southern Homes</th><td class="num" data-l="Typical price range">$300,000 to $350,000</td><td class="num" data-l="For sale now">62</td></tr><tr><th scope="row">Beverly Homes</th><td class="num" data-l="Typical price range">$300,000 to $394,000</td><td class="num" data-l="For sale now">60</td></tr><tr><th scope="row">Beazer Homes</th><td class="num" data-l="Typical price range">$338,000 to $500,000</td><td class="num" data-l="For sale now">40</td></tr><tr><th scope="row">Dream Finders Homes</th><td class="num" data-l="Typical price range">$273,000 to $500,000</td><td class="num" data-l="For sale now">32</td></tr><tr><th scope="row">Starlight Homes</th><td class="num" data-l="Typical price range">$230,000 to $288,000</td><td class="num" data-l="For sale now">18</td></tr><tr><th scope="row">Toll Brothers</th><td class="num" data-l="Typical price range">$503,000 to $692,000</td><td class="num" data-l="For sale now">6</td></tr><tr><th scope="row">Ashton Woods</th><td class="num" data-l="Typical price range">$255,000 to $450,000</td><td class="num" data-l="For sale now">15</td></tr><tr><th scope="row">DRB Homes</th><td class="num" data-l="Typical price range">$291,000 to $378,000</td><td class="num" data-l="For sale now">27</td></tr><tr><th scope="row">Howell Homes</th><td class="num" data-l="Typical price range">$273,000 to $327,000</td><td class="num" data-l="For sale now">&mdash;</td></tr></tbody></table><p class="bd-note">Typical price range: half of each builder's homes sold inside it, by our count of county deeds for the same 12 months. For sale now: its new homes in the MLS on the day we counted. Great Southern Homes' homes for sale are listed by Stanley Martin. A dash means we could not match the builder's listings to its deeds.</p><div class="bd-side"><div class="bd-stat"><p class="k">On a budget of $300,000</p><ul><li><strong>280</strong><span>new homes for sale at $300,000 or less</span></li><li><strong>83</strong><span>of them by D.R. Horton, the most of any builder</span></li><li><strong>45</strong><span>by Lennar, the next most</span></li></ul></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">At $300,000 or less, Beverly Homes, Stanley Martin, Starlight Homes and DRB Homes also listed 13 or more each. Every one is on <a href="/homes/map/?has=new_construction,county_horry&amp;max=300000" style="color:var(--navy);text-decoration:underline">our map of new homes for sale</a>.</p></div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Why some builders are hard to find in the listings</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Many builders' homes never reach the MLS, the database brokers share to list homes for sale. Ryan Homes sold 477 homes here and had 1 listed that day. Lennar sold 967 and had 60. We ask those builders for their homes for sale directly.</p></div></section><section style="background:var(--ivory)" id="ask"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Before you sign">What should you ask a builder before you sign?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Seven things. We check each one with you before you sign a builder's contract:</p><ol class="bd-check" aria-label="What we check with any builder"><li><b>The license</b>South Carolina requires a state license for anyone who builds a home for someone else on a job over $5,000. It can be a residential builder license or a general contractor license. Building without one is a misdemeanor. We check the builder's license with the state.</li><li><b>The warranty, in writing</b>We get the builder's warranty booklet. It says what each part of the house is covered for, for how long, and who you call.</li><li><b>The HOA</b>We read the homeowners association (HOA) papers with you. They give the monthly fee, what it pays for, and <a href="/hoa/developer-control-turnover/" style="color:var(--navy);text-decoration:underline">when the builder hands the HOA to the owners</a>.</li><li><b>The lot premium and the upgrades</b>A lot premium is an extra charge for a particular lot. Upgrades are the features you add, which builders call options. We compare both with the base price. Our guide lists <a href="/buyers/new-construction/#tax-bill" style="color:var(--navy);text-decoration:underline">what else the price leaves out</a>, including the first full tax bill.</li><li><b>The incentive and its lender</b>Some incentives come only with the builder's own lender. We ask the builder in writing what it offers, and our guide covers <a href="/buyers/new-construction/#incentives" style="color:var(--navy);text-decoration:underline">whether to use the builder's lender</a>.</li><li><b>Your own inspection</b>A new house can still have mistakes in it. We set up an inspection before you close, and our guide covers <a href="/buyers/new-construction/#inspections" style="color:var(--navy);text-decoration:underline">when to inspect a new home</a>.</li><li><b>Your own agent, from the first visit</b>Tell us before your first visit or online sign-up. We register with the builder as your agent. Our guide explains <a href="/buyers/new-construction/#your-agent" style="color:var(--navy);text-decoration:underline">why the first visit matters</a>.</li></ol></div></section><section style="background:var(--ivory-2)" id="new-home-builders-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">New home builders FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Which home builder in Myrtle Beach is best?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We rank builders by homes sold, not by quality. D.R. Horton sold the most new homes in Horry County. To judge one builder, check the seven things in the last section of this page, starting with its license and its written warranty.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is D.R. Horton or Lennar bigger in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">D.R. Horton. It sold 1,397 new homes in Horry County in those 12 months, against 967 for Lennar. Lennar's homes sold for less in the middle, about $258,000 against about $325,000.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is Del Webb part of Pulte?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. Del Webb is PulteGroup's brand for active adults. Pulte's count on this page includes the homes it sold at Del Webb North Myrtle Beach.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Why can't I find Ryan Homes in the listings?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Few of its homes are listed in the MLS, the database brokers share. Ryan Homes sold 477 homes here in those 12 months and had 1 listed on the day we counted. We ask the builder for its homes for sale directly.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Who is Clayton Properties Group?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Berkshire Hathaway company that owns Mungo Homes. It is the seller on the deeds for Mungo's homes in Horry County.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does a home builder need a license in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, for a home job over $5,000. Building without one is a misdemeanor.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeDocType" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County deeds</a>, <a href="https://www.sec.gov/Archives/edgar/data/882184/000088218425000081/dhi-20250930.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">D.R. Horton 10-K</a>, <a href="https://www.sec.gov/Archives/edgar/data/920760/000162828026003870/len-20251130.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Lennar 10-K</a>, <a href="https://www.sec.gov/Archives/edgar/data/906163/000090616326000018/nvr-20251231.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NVR 10-K</a>, <a href="https://www.sec.gov/Archives/edgar/data/822416/000082241626000007/phm-20251231.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">PulteGroup 10-K</a>, <a href="https://www.sec.gov/Archives/edgar/data/833079/000083307926000010/mth-20251231.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Meritage 10-K</a>, <a href="https://www.sec.gov/Archives/edgar/data/794170/000079417025000112/tol-20251031.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Toll Brothers 10-K</a>, <a href="https://www.sec.gov/Archives/edgar/data/1825088/000162828026010837/dfh-20251231.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Dream Finders 10-K</a>, <a href="https://www.sec.gov/Archives/edgar/data/915840/000091584025000075/bzh-20250930.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Beazer 10-K</a>, <a href="https://www.sec.gov/Archives/edgar/data/915840/000110465926117198/tm2622398d20_8k.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Beazer 8-K</a>, <a href="https://www.sec.gov/Archives/edgar/data/1830188/000183018826000009/uhg-20251231.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">UHG 10-K</a>, <a href="https://www.sec.gov/Archives/edgar/data/1830188/000110465926054519/tm2613353d1_8k.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">UHG 8-K</a>, <a href="https://www.sec.gov/Archives/edgar/data/1067983/000119312526083899/brka-20251231.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Berkshire 10-K</a>, <a href="https://claytonhomes.com/newsroom/press-releases/Clayton-Properties-Group-Acquires-Mungo-Homes" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Clayton release</a>, <a href="https://www.starlighthomes.com/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Starlight Homes</a>, <a href="https://www.scstatehouse.gov/code/statmast.php?title=40&chapter=59" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 40-59</a>. Builder sales: our count of county deeds, November 2025 to October 2026. Listings: our count, November 8, 2026, in aggregate. Source: Coastal Carolinas Association of REALTORS® Multiple Listing Service (CCMLS).</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1rem"><strong style="color:var(--navy)">Legal notice.</strong> Chapter3 Realty Corp is a licensed South Carolina real estate brokerage. We rank builders by homes sold in county records and rate no builder. Nothing on this page is legal advice. For the terms of one builder's contract, talk to a South Carolina attorney.</p></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Buy from any builder with your own agent</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">We come to your first visit, read the builder's contract with you, and set up your inspections before you close.</p><a class="btn btn-brass btn-lg" href="/contact/">Have us join your first builder visit</a></div></section></main>
