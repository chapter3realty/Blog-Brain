+"""OSRM drive times (public router, free flow, no traffic) from the foot of the Garden City Pier (Atlantic Avenue at Waccamaw Drive,
+OpenStreetMap). Destinations from OpenStreetMap Nominatim (2026-11-02). Writes raw/drives.json. Run: python3 -I pull_drives.py <datadir>"""
+import json, sys, os, urllib.request
+D = sys.argv[1]; T = (-78.99795, 33.57690)
+DEST = {"airport_terminal": (-78.9227887, 33.6814671), "marshwalk": (-79.0318225, 33.5578779), "market_common": (-78.9402132, 33.6706705),
+        "tidelands_waccamaw_hospital": (-79.0433811, 33.5605964), "grand_strand_medical": (-78.8194704, 33.7580795),
+        "huntington_beach_sp": (-79.0622818, 33.5131892), "surfside_pier": (-78.9717534, 33.6049921), "coastal_grand": (-78.9223169, 33.7027515),
+        "broadway_at_the_beach": (-78.8807609, 33.7162695)}
+out = {"start": T}
+for k, (x, y) in DEST.items():
+    u = "https://router.project-osrm.org/route/v1/driving/%f,%f;%f,%f?overview=false" % (T[0], T[1], x, y)
+    r = json.loads(urllib.request.urlopen(urllib.request.Request(u, headers={"User-Agent": "Mozilla/5.0"}), timeout=60).read())["routes"][0]
+    out[k] = {"url": u, "duration_s": r["duration"], "distance_m": r["distance"], "minutes": round(r["duration"] / 60, 1), "miles": round(r["distance"] / 1609.344, 1)}
+    print(k, out[k]["minutes"], out[k]["miles"])
+json.dump(out, open(os.path.join(D, "raw", "drives.json"), "w"), indent=1)
diff --git a/data/2026-11-a/submarkets-garden-city/pull_fema.py b/data/2026-11-a/submarkets-garden-city/pull_fema.py
new file mode 100644
index 00000000..38663b6b
--- /dev/null
+++ b/data/2026-11-a/submarkets-garden-city/pull_fema.py
@@ -0,0 +1,18 @@
+#!/usr/bin/env python3
+"""OpenFEMA NFIP policies (v3) for ZIP 29576 (Murrells Inlet and Garden City; both counties), every occupancy type,
+policies that began June 1, 2025 to May 31, 2026. Writes raw/nfip-policies-29576.json. Run: python3 -I pull_fema.py <datadir>"""
+import sys, json, os, time, urllib.request, urllib.parse
+D = sys.argv[1]; R = os.path.join(D, "raw")
+B = "https://www.fema.gov/api/open/v3/NfipPolicies"
+f = "reportedZipCode eq '29576' and policyEffectiveDate ge '2025-06-01T00:00:00.000Z' and policyEffectiveDate lt '2026-06-01T00:00:00.000Z'"
+sel = "totalInsurancePremiumOfThePolicy,policyCost,ratedFloodZone,occupancyType,primaryResidenceIndicator,censusGeoid,nfipCommunityName,condominiumCoverageTypeCode,latitude,longitude,policyCount,originalConstructionDate,elevatedBuildingIndicator,totalBuildingInsuranceCoverage,policyEffectiveDate,rentalPropertyIndicator"
+rows = []; skip = 0
+while True:
+    u = B + "?" + urllib.parse.urlencode({"$filter": f, "$select": sel, "$top": "1000", "$skip": str(skip)}, quote_via=urllib.parse.quote)
+    for i in range(6):
+        try: got = json.loads(urllib.request.urlopen(u, timeout=300).read()).get("NfipPolicies", []); break
+        except Exception as e: print("retry", e, flush=True); time.sleep(10)
+    else: raise SystemExit("failed")
+    rows += got; skip += 1000; print(len(rows), flush=True)
+    if len(got) < 1000: break
+json.dump({"url": u.split("&%24top")[0], "NfipPolicies": rows}, open(os.path.join(R, "nfip-policies-29576.json"), "w"))
diff --git a/data/2026-11-a/submarkets-garden-city/pull_hoa.py b/data/2026-11-a/submarkets-garden-city/pull_hoa.py
new file mode 100644
index 00000000..9a0b76f8
--- /dev/null
+++ b/data/2026-11-a/submarkets-garden-city/pull_hoa.py
@@ -0,0 +1,50 @@
+"""Monthly HOA fee of the active condo listings on Garden City's ocean side (Horry part), in aggregate only (fix round 2).
+The CRM's public map API takes hoaMax (dollars a month, the site's own "Up to $X a month" filter) but returns no fee on a pin.
+So each condo's fee is bracketed: query has=area_garden_city&type=condo&hoaMax=T for T = 0, 10, 20 ... 3000 and record the first T
+at which each MLS number appears (its fee is in T-9 to T). Zones come from zones.py, the same split as analyze_listings.py.
+Saves only counts and the bracketed median, no MLS numbers, addresses, firms or photos.
+Run: RAW=<scratch> python3 -I pull_hoa.py <datadir>. Writes <datadir>/hoa-findings.json."""
+import sys, os, json, time, statistics, urllib.request, urllib.parse, datetime
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from zones import *
+from shapely.geometry import Point, LineString
+from shapely.ops import unary_union
+D = sys.argv[1]
+BASE = "https://chapter3realty.com/homes/api/map?"
+def get(p):
+    url = BASE + urllib.parse.urlencode(p)
+    for i in range(4):
+        try: return json.load(urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"}), timeout=60))
+        except Exception: time.sleep(3)
+    raise SystemExit("failed " + url)
+q = {"has": "area_garden_city", "type": "condo"}
+allc = get(q); assert allc["total"] == len(allc["pins"]), "truncated"
+pins = {p["mls"]: p for p in allc["pins"]}
+osm = J("osm.json")
+WALL = unary_union([LineString([(p["lon"], p["lat"]) for p in e["geometry"]]) for e in osm["elements"] if "Waccamaw Drive" in e.get("tags", {}).get("name", "")])
+GT = CTY["Georgetown County"]
+def where(p):
+    pt = Point(p["lng"], p["lat"])
+    if GT.contains(pt):
+        s, d = side(pt, WALL); return "georgetown/" + ("beach" if s > 0 else ("middle" if d < 400 else "inland"))
+    return "horry/" + zone(pt)
+zoneof = {m: where(p) for m, p in pins.items() if p.get("lat") is not None}
+fee = {}; calls = 1
+for T in range(0, 3001, 10):
+    d = get(dict(q, hoaMax=T)); calls += 1
+    for p in d["pins"]:
+        fee.setdefault(p["mls"], T)
+    if len(fee) >= len(pins): break
+    time.sleep(0.15)
+out = {}
+for key in sorted(set(zoneof.values())) + ["all"]:
+    ms = [m for m in pins if key == "all" or zoneof.get(m) == key]
+    fs = sorted(fee[m] for m in ms if m in fee)
+    out[key] = {"n": len(ms), "with_fee": len(fs), "median_upper": statistics.median(fs) if fs else None,
+                "q1_upper": fs[len(fs) // 4] if fs else None, "q3_upper": fs[(3 * len(fs)) // 4] if fs else None,
+                "min_upper": fs[0] if fs else None, "max_upper": fs[-1] if fs else None}
+F = {"pulled": datetime.datetime.now(datetime.timezone.utc).isoformat(), "calls": calls, "condos": len(pins), "bracketed": len(fee),
+     "note": "CRM public map API, has=area_garden_city&type=condo, filter hoaMax (monthly). Each fee is known to within $10: the value is the top of its $10 bracket. Aggregate only.",
+     "meta_refreshed": allc.get("meta", {}).get("refreshedAt"), "groups": out}
+json.dump(F, open(os.path.join(D, "hoa-findings.json"), "w"), indent=1)
+print(json.dumps(F, indent=1))
diff --git a/data/2026-11-a/submarkets-garden-city/pull_listings.py b/data/2026-11-a/submarkets-garden-city/pull_listings.py
new file mode 100644
index 00000000..c91b5a31
--- /dev/null
+++ b/data/2026-11-a/submarkets-garden-city/pull_listings.py
@@ -0,0 +1,41 @@
+"""Active for-sale listings in the CRM's Garden City area (public map API, has=area_garden_city), for counts and medians in aggregate only.
+Splits price bands until each search returns every home (the API returns at most 144 pins a call).
+Keeps MLS number (to drop duplicates), type, price, beds, square feet, lat, lng and tag. No addresses, firms or photos are saved.
+Run: RAW=<scratch> python3 -I pull_listings.py. Writes RAW/listings-gc.json (kept out of the repo) and prints totals."""
+import json, os, time, urllib.request, urllib.parse, datetime
+RAW = os.environ["RAW"]
+BASE = "https://chapter3realty.com/homes/api/map?"
+TYPES = ["house", "townhouse", "condo", "manufactured", "land", "multi"]
+AREA = "area_garden_city"
+calls = 0
+def get(p):
+    global calls; calls += 1
+    url = BASE + urllib.parse.urlencode(p)
+    for i in range(4):
+        try: return json.load(urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"}), timeout=60))
+        except Exception: time.sleep(3)
+    raise SystemExit("failed " + url)
+def num(s):
+    try: return float(str(s).replace("$", "").replace(",", ""))
+    except Exception: return None
+def band(t, lo, hi, acc, warn, has):
+    d = get({"has": has, "type": t, "min": lo, "max": hi})
+    if d["total"] > len(d["pins"]) and hi - lo > 500:
+        mid = (lo + hi) // 2; band(t, lo, mid, acc, warn, has); band(t, mid + 1, hi, acc, warn, has); return
+    if d["total"] > len(d["pins"]): warn.append([t, lo, hi, d["total"], len(d["pins"])])
+    for p in d["pins"]:
+        acc[p["mls"]] = {"type": t, "price": num(p["price"]), "beds": p.get("beds"), "sqft": p.get("sqft") or None, "lat": p.get("lat"), "lng": p.get("lng"), "tag": p.get("tag") or ""}
+res = {}; totals = {}; warn = []; meta = None
+for t in TYPES:
+    acc = {}; band(t, 0, 50000000, acc, warn, AREA)
+    d = get({"has": AREA, "type": t}); totals[t] = d["total"]; meta = d.get("meta")
+    print(t, "pins", len(acc), "api total", d["total"], flush=True); res.update(acc)
+d = get({"has": AREA}); totals["all"] = d["total"]
+feat = {}
+for h in ["flood_zone", "private_dock", "str_allowed", "raised_home", "oceanfront", "ocean_view", "walk_to_beach", "no_hoa", "furnished", "county_georgetown", "waterfront"]:
+    mls = set()
+    for t in TYPES:
+        acc = {}; band(t, 0, 50000000, acc, [], AREA + "," + h); mls |= set(acc)
+    feat[h] = sorted(mls); print(h, len(mls), flush=True)
+json.dump({"pulled": datetime.datetime.now(datetime.timezone.utc).isoformat(), "calls": calls, "api_totals": totals, "truncated": warn, "meta": meta, "homes": res, "features": feat}, open(os.path.join(RAW, "listings-gc.json"), "w"))
+print("homes", len(res), "calls", calls, "truncated", warn)
