index 00000000..97ecef9d
--- /dev/null
+++ b/data/2026-11-a/submarkets-garden-city/analyze.py
@@ -0,0 +1,96 @@
+#!/usr/bin/env python3
+"""Findings for /submarkets/garden-city/ from Horry County parcels and deeds, FEMA zones (county layer 19), Census and NOAA.
+Run: RAW=<scratch> SALES=<out-of-state-buyers.json> python3 -I analyze.py <datadir>
+Writes <datadir>/findings.json (counts and medians only: no names, addresses, PINs or deed book and page)
+and RAW/parcel-zones.json (per parcel, kept out of the repo) for the map."""
+import sys, os, json, statistics, collections
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from zones import *
+from shapely.geometry import Polygon, Point, shape
+from shapely.strtree import STRtree
+D = sys.argv[1]
+# Land use codes on these parcels: 101 house lots, 107 condo and apartment units, 108 villa units, 135 townhouse units,
+# 109 and 120 other residential (read from sample legal descriptions; the county publishes no code table on the layer).
+def kind(p):
+    c = p["LandUseCode"]; legal = p["LegalDescr"] or ""
+    if c == "107" or "HPR" in legal: return "condo"
+    if c == "101": return "house"
+    return "other"
+fema = [(shape({"type": "Polygon", "coordinates": f["geometry"]["rings"]}).buffer(0), f["attributes"]["FLD_ZONE"], f["attributes"]["STATIC_BFE"]) for f in J("fema.json") if f.get("geometry")]
+ftree = STRtree([g for g, z, b in fema])
+def fzone(pt):
+    hits = [fema[i] for i in ftree.query(pt) if fema[i][0].contains(pt)]
+    if not hits: return "none"
+    order = {"VE": 0, "AE": 1, "AO": 2, "A": 3, "X": 4}
+    return sorted([z for g, z, b in hits], key=lambda z: order.get(z, 9))[0]
+wt = STRtree(list(getattr(WATER, "geoms", [WATER])))
+def on_water(poly):
+    for i in wt.query(poly.buffer(0.00018)):     # about 15 to 20 m
+        if wt.geometries[i].distance(poly) < 0.00018: return True
+    return False
+rows = []
+for p in J("parcels.json"):
+    rr = (p.get("g") or {}).get("rings")
+    if not rr: continue
+    poly = Polygon(rr[0]).buffer(0); pt = poly.representative_point()
+    if not CDP.contains(pt): continue
+    z = zone(pt)
+    ratio = (p["AssessedProp"] / p["TaxableProp"]) if p["TaxableProp"] else None
+    r = {"pin": int(p["PIN"]), "zone": z, "kind": kind(p), "x": round(pt.x, 6), "y": round(pt.y, 6), "fz": fzone(pt),
+         "own": None if ratio is None else ("4" if abs(ratio - 0.04) < 0.003 else ("6" if abs(ratio - 0.06) < 0.003 else "other")),
+         "state": (p["OwnerState"] or "").strip().upper(), "mkt": p["MarketProp"],
+         "water": z == "middle" and on_water(poly)}
+    rows.append(r)
+json.dump(rows, open(os.path.join(RAW, "parcel-zones.json"), "w"))
+def pct(a, b): return round(100 * a / b, 1) if b else None
+def summ(xs):
+    n = len(xs)
+    st = collections.Counter(x["state"] for x in xs)
+    return {"homes": n, "owner_occupied_4pct": sum(x["own"] == "4" for x in xs), "pct_owner_occupied": pct(sum(x["own"] == "4" for x in xs), n),
+            "rate_6pct": sum(x["own"] == "6" for x in xs), "rate_other": sum(x["own"] == "other" for x in xs),
+            "tax_bill_outside_sc": n - st.get("SC", 0) - st.get("", 0), "pct_tax_bill_outside_sc": pct(n - st.get("SC", 0) - st.get("", 0), n),
+            "blank_state": st.get("", 0), "top_states": st.most_common(8),
+            "fema": dict(collections.Counter(x["fz"] for x in xs)), "pct_high_risk": pct(sum(x["fz"] in ("VE", "AE", "AO", "A") for x in xs), n),
+            "pct_ve": pct(sum(x["fz"] == "VE" for x in xs), n),
+            "median_county_market_value": statistics.median([x["mkt"] for x in xs if x["mkt"]]) if xs else None}
+F = {"made": "analyze.py", "stock": {}, "sales": {}}
+for z in ("beach", "middle", "inland", None):
+    for k in ("all", "condo", "house", "other"):
+        xs = [x for x in rows if x["zone"] == z and (k == "all" or x["kind"] == k)]
+        if xs: F["stock"]["%s/%s" % (z, k)] = summ(xs)
+F["stock"]["middle/on_water/house"] = summ([x for x in rows if x["zone"] == "middle" and x["water"] and x["kind"] == "house"])
+F["stock"]["middle/on_water/all"] = summ([x for x in rows if x["zone"] == "middle" and x["water"]])
+F["stock"]["middle/off_water/house"] = summ([x for x in rows if x["zone"] == "middle" and not x["water"] and x["kind"] == "house"])
+F["stock"]["cdp/all"] = summ(rows)
+F["stock"]["east_of_bus17/all"] = summ([x for x in rows if x["zone"] in ("beach", "middle")])
+for k in ("condo", "house", "other"):
+    F["stock"]["cdp/" + k] = summ([x for x in rows if x["kind"] == k])
+# Deed sales recorded 2025-10-01 to 2026-09-30 (the 2026-10-d pull), inside the 2020 Census place
+S = json.load(open(os.environ["SALES"]))
+byz = {(x["zone"]): x for x in rows}
+pz = {x["pin"]: x for x in rows}
+sales = []
+for s in S["sales"]:
+    if s.get("lon") is None: continue
+    pt = Point(s["lon"], s["lat"])
+    if not CDP.contains(pt): continue
+    p = pz.get(int(s["pin"]))
+    z = p["zone"] if p else zone(pt)
+    k = p["kind"] if p else ("condo" if s["condo"] else "other")
+    sales.append({"zone": z, "kind": k, "price": s["cons"], "builder": s["builder"], "where": s["where"], "water": bool(p and p["water"]), "fz": p["fz"] if p else None, "month": s["date"][:7]})
+def ss(xs):
+    pr = sorted(x["price"] for x in xs)
+    if not pr: return {"sales": 0}
+    q = statistics.quantiles(pr, n=4) if len(pr) >= 4 else [pr[0], statistics.median(pr), pr[-1]]
+    return {"sales": len(pr), "median": statistics.median(pr), "p25": q[0], "p75": q[2], "min": pr[0], "max": pr[-1],
+            "builder": sum(x["builder"] for x in xs), "buyer_outside_sc": sum(x["where"] in ("US", "CANADA", "OTHER") for x in xs), "buyer_sc": sum(x["where"] == "SC" for x in xs)}
+for z in ("beach", "middle", "inland"):
+    for k in ("all", "condo", "house", "other"):
+        F["sales"]["%s/%s" % (z, k)] = ss([x for x in sales if x["zone"] == z and (k == "all" or x["kind"] == k)])
+F["sales"]["middle/on_water/house"] = ss([x for x in sales if x["zone"] == "middle" and x["water"] and x["kind"] == "house"])
+F["sales"]["middle/off_water/house"] = ss([x for x in sales if x["zone"] == "middle" and not x["water"] and x["kind"] == "house"])
+F["sales"]["cdp/all"] = ss(sales)
+F["sales_note"] = "Horry County deeds recorded 2025-10-01 to 2026-09-30, home sales of $10,000 or more on one residential parcel with a building (filters in data/2026-10-d/sell-out-of-state-buyers/README.md), point inside the 2020 Garden City CDP."
+json.dump(F, open(os.path.join(D, "findings.json"), "w"), indent=1)
+for k, v in F["stock"].items(): print("STOCK", k, {kk: v[kk] for kk in ("homes", "pct_owner_occupied", "pct_tax_bill_outside_sc", "pct_high_risk", "pct_ve", "median_county_market_value")}, v["fema"])
+for k, v in F["sales"].items(): print("SALES", k, v)
diff --git a/data/2026-11-a/submarkets-garden-city/analyze_census_noaa.py b/data/2026-11-a/submarkets-garden-city/analyze_census_noaa.py
new file mode 100644
index 00000000..69b677ff
--- /dev/null
+++ b/data/2026-11-a/submarkets-garden-city/analyze_census_noaa.py
@@ -0,0 +1,54 @@
+#!/usr/bin/env python3
+"""Census Day 2020 occupancy along Waccamaw Drive (both counties), the Census place totals, the NOAA tide gauge trend and
+high-tide flood days, and the tax worked example. Run: RAW=<scratch> python3 -I analyze_census_noaa.py <datadir>. Writes census-noaa.json and chart-*.json."""
+import sys, os, json, glob, statistics
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from zones import *
+from shapely.geometry import shape, LineString
+from shapely.ops import unary_union
+D = sys.argv[1]; R = lambda n: json.load(open(os.path.join(D, "raw", n)))
+osm = J("osm.json")
+W = unary_union([LineString([(p["lon"], p["lat"]) for p in e["geometry"]]) for e in osm["elements"] if "Waccamaw Drive" in e.get("tags", {}).get("name", "")])
+h5 = {}
+for f in glob.glob(os.path.join(D, "raw/census-H5-blocks-*.json")):
+    dd = json.load(open(f))["response"]["data"]
+    for r in dd[1:]:
+        x = dict(zip(dd[0], r)); h5[x["GEO_ID"][-15:]] = x
+buf = W.buffer(0.0012)   # blocks that touch a band about 110 to 130 m either side of Waccamaw Drive
+out = {"strip_blocks": {}}
+for f in J("blocks2020.geojson")["features"]:
+    p = f["properties"]
+    if p["HU100"] <= 0 or not shape(f["geometry"]).intersects(buf): continue
+    c = {"051": "horry", "043": "georgetown"}[p["COUNTY"]]
+    for k in (c, "both"):
+        o = out["strip_blocks"].setdefault(k, {"blocks": 0, "housing_units": 0, "vacant": 0, "seasonal": 0, "people": 0})
+        x = h5[p["GEOID"]]
+        o["blocks"] += 1; o["housing_units"] += p["HU100"]; o["people"] += p["POP100"]; o["vacant"] += int(x["H5_001N"]); o["seasonal"] += int(x["H5_006N"])
+for k, o in out["strip_blocks"].items():
+    o["occupied"] = o["housing_units"] - o["vacant"]; o["pct_occupied"] = round(100 * o["occupied"] / o["housing_units"], 1); o["pct_seasonal"] = round(100 * o["seasonal"] / o["housing_units"], 1)
+def acs(t, g): d = R("census-%s-%s.json" % (t, g))["response"]["data"]; return dict(zip(d[0], d[1]))
+for g, name in (("160XX00US4528455", "cdp"), ("050XX00US45051", "horry")):
+    h1 = acs("DECENNIALPL2020.H1", g); h5c = acs("DECENNIALDHC2020.H5", g); p1 = acs("DECENNIALPL2020.P1", g)
+    out[name + "_2020"] = {"people": int(p1["P1_001N"]), "housing_units": int(h1["H1_001N"]), "occupied": int(h1["H1_002N"]), "vacant": int(h1["H1_003N"]), "seasonal": int(h5c["H5_006N"]),
+                          "pct_seasonal": round(100 * int(h5c["H5_006N"]) / int(h1["H1_001N"]), 1), "pct_occupied": round(100 * int(h1["H1_002N"]) / int(h1["H1_001N"]), 1)}
+# NOAA Springmaid Pier
+tr = [x for x in R("noaa-sltrend-8661070.json")["SeaLvlTrends"] if x["stationId"] == "8661070"][0]
+yrs = (int(tr["endDate"][-4:]) + 1 - int(tr["startDate"][-4:]))
+out["sea_level"] = {"inches_per_decade": tr["trend"], "error": tr["trendError"], "start": tr["startDate"], "end": tr["endDate"], "inches_over_record": round(tr["trend"] * (2025.96 - 1957.46) / 10, 1)}
+h = R("noaa-htf-annual-8661070.json")["AnnualFloodCount"]
+rows = [{"year": x["year"], "minor_days": x["minCount"], "missing_days": x["nanCount"]} for x in h if x["minCount"] is not None]
+def dec(a, b):
+    xs = [r for r in rows if a <= r["year"] <= b and r["missing_days"] < 60]
+    return {"years": "%d-%d" % (a, b), "years_used": len(xs), "avg_minor_days": round(statistics.mean(r["minor_days"] for r in xs), 1)}
+out["high_tide_flood_days"] = {"by_decade": [dec(1985, 1994), dec(1995, 2004), dec(2005, 2014), dec(2015, 2024)], "rule": "years with fewer than 60 days of missing data",
+                               "outlook_latest": R("noaa-htf-outlook-8661070.json")["MetYearAnnualOutlook"][-1]}
+json.dump({"title": "Minor high-tide flood days a year at Springmaid Pier, Myrtle Beach (NOAA)", "rows": [r for r in rows if r["year"] >= 1980]}, open(os.path.join(D, "chart-high-tide-days.json"), "w"), indent=0)
+# Tax worked example: the middle ocean-side condo sale (findings.json sales beach/condo median), 2026 millage for Murrells Inlet - Garden City
+F = json.load(open(os.path.join(D, "findings.json")))
+price = F["sales"]["beach/condo"]["median"]; mills = 52.1 + 119.1 + 28.0 + 8.1; school_ops = 109.1
+out["tax_example"] = {"price": price, "mills": round(mills, 1), "rental_or_second_home_6pct": round(price * 0.06 * mills / 1000), "legal_residence_4pct": round(price * 0.04 * (mills - school_ops) / 1000),
+                      "parts": "county 52.1 + schools 119.1 (debt 10.0, operation 109.1) + Murrells Inlet-Garden City fire 28.0 + waste management 8.1"}
+A = json.load(open(os.path.join(D, "airroi.json")))
+json.dump({"title": "Average revenue per active Airbnb listing by calendar month, Garden City Beach (AirROI, two-year average)", "rows": [{"month": k, "revenue": v["revenue"], "season": v["season"]} for k, v in A["calendar_avg_2yr"].items()],
+           "occupancy_by_month_last_12": [{"month": k, "occupancy": v["occupancy"]} for k, v in A["months"].items()]}, open(os.path.join(D, "chart-str-months.json"), "w"), indent=0)
+json.dump(out, open(os.path.join(D, "census-noaa.json"), "w"), indent=1); print(json.dumps(out, indent=1))
diff --git a/data/2026-11-a/submarkets-garden-city/analyze_fema.py b/data/2026-11-a/submarkets-garden-city/analyze_fema.py
new file mode 100644
index 00000000..5c45a435
--- /dev/null
+++ b/data/2026-11-a/submarkets-garden-city/analyze_fema.py
@@ -0,0 +1,26 @@
+#!/usr/bin/env python3
+"""NFIP policy cost (what the policyholder pays a year, fees included) for ZIP 29576 policies that began June 2025 to May 2026,
+by area and rated zone. Strip = the three Census block groups the Waccamaw Drive strip falls in (450510513011, 450510513012
+in Horry; 450439205101 in Georgetown). Run: python3 -I analyze_fema.py <datadir>. Writes nfip-findings.json."""
+import json, sys, os, statistics, collections
+D = sys.argv[1]
+r = json.load(open(os.path.join(D, "raw/nfip-policies-29576.json")))["NfipPolicies"]
+STRIP = {"450510513011", "450510513012", "450439205101"}
+OCC = {11: "single-family home", 16: "unit in a multi-unit building (condo unit policy)", 15: "condo association building policy (RCBAP)", 14: "manufactured home"}
+def zg(z):
+    z = (z or "").upper()
+    return "V" if z.startswith("V") else ("A" if z.startswith("A") else ("X" if z in ("X", "B", "C", "AR") or z.startswith("X") else "other"))
+G = collections.defaultdict(list)
+for x in r:
+    area = "strip" if (x.get("censusGeoid") or "") in STRIP else "rest_29576"
+    for a in (area, "all_29576"):
+        G[(a, x["occupancyType"], zg(x["ratedFloodZone"]))].append(x)
+        G[(a, x["occupancyType"], "any")].append(x)
+out = {}
+for (a, o, z), xs in sorted(G.items()):
+    if o not in OCC or len(xs) < 5: continue
+    pc = [x["policyCost"] for x in xs if x.get("policyCost") is not None]
+    out["%s/%s/%s" % (a, o, z)] = {"what": OCC[o], "policies": len(xs), "median_cost": statistics.median(pc), "p25": statistics.quantiles(pc, n=4)[0], "p75": statistics.quantiles(pc, n=4)[2],
+        "primary_residence": sum(bool(x.get("primaryResidenceIndicator")) for x in xs), "median_building_coverage": statistics.median([x["totalBuildingInsuranceCoverage"] or 0 for x in xs])}
+json.dump({"source": "OpenFEMA NfipPolicies v3", "filter": "reportedZipCode 29576, policyEffectiveDate 2025-06-01 to 2026-05-31", "groups": out}, open(os.path.join(D, "nfip-findings.json"), "w"), indent=1)
+for k, v in out.items(): print(k, v)
