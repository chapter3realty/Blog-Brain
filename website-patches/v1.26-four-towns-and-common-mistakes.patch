ate(203.4 52.9)"><g class="k"><text class="T" x="0" y="3.7" text-anchor="middle"><tspan x="0">LITTLE RIVER</tspan></text></g></g><text class="wc"><textPath href="#c3r-little-river-w0" startOffset="50%" text-anchor="middle">Intracoastal Waterway</textPath></text><g transform="translate(252 216)"><g class="k"><text class="o" x="0" y="5.1" text-anchor="middle">Atlantic Ocean</text></g></g><g transform="translate(271.8 73.6)"><g class="k"><path d="M-10.7 -8H10.7V1.2C10.7 6.4 4.8 8 0 9.6C-4.8 8 -10.7 6.4 -10.7 1.2z" fill="#ffffff" stroke="#1c2028" stroke-width="1.1"/><text class="r" y="3.1" text-anchor="middle">17</text></g></g><g transform="translate(54.2 124.3)"><g class="k"><rect x="-12" y="-8" width="23.9" height="16" rx="3" fill="#ffffff" stroke="#1c2028" stroke-width="1.1"/><text class="r" y="4" text-anchor="middle">90</text></g></g><g transform="translate(115 53.4)"><g class="k"><rect x="-9.5" y="-8" width="19" height="16" rx="3" fill="#ffffff" stroke="#1c2028" stroke-width="1.1"/><text class="r" y="4" text-anchor="middle">9</text></g></g><g transform="translate(111.8 142.2)"><g class="k"><rect x="-10.7" y="-8" width="21.5" height="16" rx="3" fill="#ffffff" stroke="#1c2028" stroke-width="1.1"/><text class="r" y="4" text-anchor="middle">31</text></g></g><g><path d="M316.8 66.6L314.8 52.7" stroke="#1c2028" stroke-width="1.1"/><circle cx="316.8" cy="66.6" r="2.4" fill="#1c2028"/><g transform="translate(215.7 183.2)"><g class="k"><rect x="13" y="-16.7" width="88" height="36" rx="10" fill="#1c2028" fill-opacity=".1"/><rect x="13" y="-18" width="88" height="36" rx="10" fill="#ffffff" fill-opacity=".9" stroke="#ffffff" stroke-width=".8"/><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><use href="#c3r-little-river-beach" x="-7.4" y="-7.4" width="14.7" height="14.7" color="#1c2028"/><text class="l" x="15" y="-3"><tspan x="15">Beach</tspan></text><text class="m" x="15" y="12.5">about 11 min</text></g></g><g transform="translate(314.8 52.7)"><g class="k"><rect x="-129.3" y="-45.6" width="112.3" height="36" rx="10" fill="#1c2028" fill-opacity=".1"/><rect x="-129.3" y="-46.9" width="112.3" height="36" rx="10" fill="#ffffff" fill-opacity=".9" stroke="#ffffff" stroke-width=".8"/><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><use href="#c3r-little-river-town" x="-7.4" y="-7.4" width="14.7" height="14.7" color="#1c2028"/><text class="l" x="-18.9" y="-31.9" text-anchor="end"><tspan x="-18.9">Calabash, N.C.</tspan></text><text class="m" x="-18.9" y="-16.4" text-anchor="end">about 7 min</text></g></g><g transform="translate(166.9 113.6)"><g class="k"><rect x="-97.4" y="-16.7" width="84.4" height="36" rx="10" fill="#1c2028" fill-opacity=".1"/><rect x="-97.4" y="-18" width="84.4" height="36" rx="10" fill="#ffffff" fill-opacity=".9" stroke="#ffffff" stroke-width=".8"/><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><use href="#c3r-little-river-hospital" x="-7.4" y="-7.4" width="14.7" height="14.7" color="#1c2028"/><text class="l" x="-15" y="-3" text-anchor="end"><tspan x="-15">Hospital</tspan></text><text class="m" x="-15" y="12.5" text-anchor="end">about 6 min</text></g></g><g transform="translate(43.2 237.4)"><g class="k"><rect x="9.9" y="-38.6" width="128.7" height="36" rx="10" fill="#1c2028" fill-opacity=".1"/><rect x="9.9" y="-39.9" width="128.7" height="36" rx="10" fill="#ffffff" fill-opacity=".9" stroke="#ffffff" stroke-width=".8"/><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><use href="#c3r-little-river-shopping" x="-7.4" y="-7.4" width="14.7" height="14.7" color="#1c2028"/><text class="l" x="11.9" y="-24.9"><tspan x="11.9">Barefoot Landing</tspan></text><text class="m" x="11.9" y="-9.4">about 18 min</text></g></g><g transform="translate(230.5 100.5)"><g class="k"><g transform="scale(0.8)"><ellipse cx="0" cy="1" rx="7" ry="2.4" fill="#1c2028" opacity=".18"/><path d="M0 0C-3-6-13-14-13-26a13 13 0 1 1 26 0c0 12-10 20-13 26z" fill="#c4783a" stroke="#1c2028" stroke-width="1.5"/><use href="#c3r-little-river-home" x="-8.5" y="-34.5" width="17" height="17" color="#ffffff"/></g><text class="h" x="-15" y="-14.5" text-anchor="end"><tspan x="-15">Little River</tspan></text></g></g></g></svg></div><figcaption>Drive times by car from the old village, without traffic. Map data: U.S. Census Bureau TIGER/Line; Horry County GIS.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A swing bridge built in 1935 still carries Sea Mountain Highway over the waterway. It turns on a center pier to let boats through, and it is one of the oldest swing bridges on SCDOT's highways. Boaters signal it to open, and at weekday rush hours it opens only on the hour and half hour.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Vereen Memorial Historical Gardens, a county park on the waterway, has about 3 miles of trails and boardwalks through forest and marsh. A piece of the colonial Kings Highway, the road from Boston to Charleston, still runs at the front of the park.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Little River is a place people live all year. When the Census last counted, about one in five of its homes was kept for seasonal use. In North Myrtle Beach, which borders it, it was nearly half.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="Share of homes kept for seasonal use, 2020 Census"><span class="cap" aria-hidden="true">Share of homes kept for seasonal use, 2020 Census</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Place</span><span role="columnheader">Seasonal homes</span></div></div><div role="rowgroup"><div role="row" class="ref"><span role="rowheader"><span class="n">North Myrtle Beach</span></span><span role="cell"><span class="b" style="--f:0.968" aria-hidden="true"></span><span class="v">48%</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Garden City</span></span><span role="cell"><span class="b" style="--f:0.79" aria-hidden="true"></span><span class="v">39%</span></span></div><div role="row"><span role="rowheader"><span class="n">Little River</span></span><span role="cell"><span class="b" style="--f:0.382" aria-hidden="true"></span><span class="v">19%</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">All of Horry County</span></span><span role="cell"><span class="b" style="--f:0.352" aria-hidden="true"></span><span class="v">18%</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Murrells Inlet</span></span><span role="cell"><span class="b" style="--f:0.272" aria-hidden="true"></span><span class="v">14%</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Carolina Forest</span></span><span role="cell"><span class="b" style="--f:0.092" aria-hidden="true"></span><span class="v">5%</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Conway</span></span><span role="cell"><span class="b" style="--f:0.034" aria-hidden="true"></span><span class="v">2%</span></span></div></div></div><figcaption>Homes no one lived in on Census Day that were kept for seasonal or occasional use, such as vacation homes and many nightly rentals.</figcaption></figure></div></section><section style="background:var(--ivory)" id="town-or-county"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Town or county">Is Little River, SC a town?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. Little River has no town government and no town limits, so Horry County makes its rules and collects its tax. A home here pays the county's property tax and no city tax on top.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">One corner is different. A small part of the Little River ZIP code along the waterway is inside the city of North Myrtle Beach. Its homes, about 250 and mostly condos, have a Little River address and pay North Myrtle Beach's city tax. We check which side of the line a house is on.</p></div></section><section style="background:var(--ivory-2)" id="on-the-water"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="On the water">Living on the water in Little River: boat slips, ramps and waterfront homes</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most marinas rent their slips. At Little River's three marinas you can buy one: a deeded slip is its own piece of real estate, with its own deed and its own county tax bill. The 12 slip sales recorded here in the past year were each for a slip alone, at $10,000 to $95,000, without a condo.</p><figure class="c3-lr-fig"><div class="c3-lr-frame"><img src="/images/2026-11-a/submarkets-little-river/little-river-water-map.svg" width="760" height="495" alt="Map of Little River's water: three marinas with deeded slips near the old village (1 Mariner's Pointe, 2 Coquina Harbour, 3 Lightkeepers Village), the public landings at the US 17 bridge (A), and FEMA's high-risk flood zone striped along the water." loading="lazy" decoding="async"></div><figcaption><ul class="c3-lr-key" aria-label="Map key"><li><span class="c3-lr-num marina" data-n="1" aria-hidden="true"></span><span>Mariner's Pointe</span></li><li><span class="c3-lr-num marina" data-n="2" aria-hidden="true"></span><span>Coquina Harbour</span></li><li><span class="c3-lr-num marina" data-n="3" aria-hidden="true"></span><span>Lightkeepers Village</span></li><li><span class="c3-lr-num sq" data-n="A" aria-hidden="true"></span><span>T. Craig Campbell Landing and, across the waterway, Johnny Causey Landing</span></li><li><span class="c3-lr-sw" style="background:repeating-linear-gradient(45deg,#3d7fb8 0 3px,#b9d3e6 3px 7px)"></span><span>FEMA's high-risk flood zone</span></li><li><span class="c3-lr-sw" style="background:#e3d9cc"></span><span>The city of North Myrtle Beach</span></li></ul><p style="margin:.7rem 0 0">The dark line is the Little River ZIP code. Marker sizes follow the number of deeded slips. The two landings on the Waccamaw River are north-west of this map. Map data: Horry County GIS; FEMA flood map as the county carries it; U.S. Census Bureau TIGER/Line.</p></figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The slips come in sizes. The table gives the length of most slips at each marina, from the county's parcel map. Coquina Harbour's are about 30 to 45 feet. The county's parcel records do not give the depth of the water, so we check it at low tide for any slip you like.</p><style>.c3-cc{margin:1.4rem 0 1.8rem;max-width:960px}.c3-cc table{width:100%;border-collapse:collapse;font-size:var(--read,1.0625rem);line-height:1.45;color:var(--muted)}.c3-cc caption{caption-side:top;text-align:left;color:var(--navy);font-weight:600;font-size:1em;line-height:1.4;padding:0 0 .7rem}.c3-cc th,.c3-cc td{padding:.6rem .7rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule);overflow-wrap:break-word}.c3-cc thead th{color:var(--navy);font-weight:600;font-size:1em;border-bottom:2px solid var(--navy);vertical-align:bottom}.c3-cc tbody th{color:var(--navy);font-weight:600}.c3-cc .n{text-align:right;font-variant-numeric:tabular-nums}.c3-cc .i{display:inline-flex;vertical-align:-4px;margin-right:.45rem;color:var(--brass-ink)}.c3-cc tr.c3-self>*{background:#fff}@media (max-width:49.999em){.c3-cc table,.c3-cc tbody,.c3-cc tr,.c3-cc th,.c3-cc td{display:block;width:auto}.c3-cc caption{display:block}.c3-cc thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.c3-cc tbody tr{background:var(--ivory-2);border-top:3px solid var(--brass);margin:0 0 .8rem;padding:.5rem 0 .6rem}section[style*="background:var(--ivory-2)"] .c3-cc tbody tr{background:var(--ivory)}.c3-cc tr.c3-self{background:#fff!important;border:2px solid var(--brass)}.c3-cc tr.c3-self>*{background:transparent}.c3-cc th,.c3-cc td{border:0;padding:.2rem 1rem}.c3-cc tbody th{display:flex;align-items:center;font-size:1.1em;padding-bottom:.35rem}.c3-cc tbody th .i{flex:none;vertical-align:0}.c3-cc tbody th a{display:inline-block;padding:.5rem 0}.c3-cc .n{text-align:left}.c3-cc td[data-label]::before{content:attr(data-label) ": ";color:var(--navy);font-weight:500}}</style><div class="c3-cc"><table><caption>Deeded boat slips and what they sold for, from county deeds</caption><thead><tr><th scope="col">Marina</th><th scope="col">Most slips</th><th scope="col">Sales, past year</th><th scope="col">Prices</th><th scope="col">Middle price</th></tr></thead><tbody><tr><th scope="row">Mariner's Pointe</th><td data-label="Most slips">About 30 to 35 feet</td><td data-label="Sales, past year">11</td><td data-label="Prices">$10,000 to $38,000</td><td data-label="Middle price">About $16,500</td></tr><tr><th scope="row">Lightkeepers Village</th><td data-label="Most slips">About 45 to 65 feet</td><td data-label="Sales, past year">1</td><td data-label="Prices">$95,000</td><td data-label="Middle price">$95,000</td></tr><tr><th scope="row">Dock Holidays Marina, in North Myrtle Beach</th><td data-label="Most slips">About 40 to 50 feet</td><td data-label="Sales, past year">10</td><td data-label="Prices">$65,000 to $115,000</td><td data-label="Middle price">About $92,500</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Coquina Harbour, with about 80 deeded slips, had no slip sales in the past year.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The county taxes a slip like a second home, on its own value for the slip. It values most Mariner's Pointe slips at $38,000 or more, above nearly every price paid there in the past year. On the county's full $38,000 value, a slip pays about $460 a year in property tax; a slip that has not sold in years may be taxed on a lower, capped value. The marina's association charges a fee on top, and its recorded papers say who may own a slip. We read both before you make an offer.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Where to launch a boat</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Horry County runs two public boat landings in the Little River ZIP. T. Craig Campbell Landing is on the Intracoastal Waterway at the US 17 bridge, about 7 minutes from the old village, with two ramps, a dock and a paved lot. Johnny Causey Landing faces it across the waterway, just inside North Myrtle Beach, with two more ramps and a larger lot.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On the Waccamaw River, Worthams Ferry Landing has one ramp and an unpaved lot. Chris Anderson Landing, on the river near Longs, has two ramps.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Homes on the water</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Few houses here sit on the water: fewer than 2 in every 100 have a lot on the Intracoastal Waterway, a canal off it, or the Waccamaw River. Those few cost far more. Only 5 resold in the past year, and the middle one sold for about $1.3 million.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most homes right by the water are condos, and about half of them are in three communities: Carolina Yacht Landing, Mariner's Pointe and Lightkeepers Village. A condo by the water usually sold for about $263,000 in the past year, and one away from it for about $180,000.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A typical resold house and a Mariner's Pointe slip come to about $375,000 together. If you would rather keep the boat on a trailer at home, our <a href="/buyers/no-hoa-homes/" style="color:var(--navy);text-decoration:underline">guide to homes with no HOA</a> covers where that is allowed.</p></div></section><section style="background:var(--ivory)" id="parts"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Five parts">Which part of Little River should you look at?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Little River's homes fall into five parts, and each gives you something the others do not. The numbers on the map match the entries below.</p><figure class="c3-lr-fig"><div class="c3-lr-frame"><img src="/images/2026-11-a/submarkets-little-river/little-river-parts-map.svg" width="760" height="483" alt="Map of Little River's subdivisions as dots in five numbered parts: 1 the old village and harbors, 2 north and east, 3 north-west, 4 west around the hospital (H), 5 far west at SC 9." loading="lazy" decoding="async"></div><figcaption>Each dot is a subdivision, sized by its homes. The black dot is the old village, and H is McLeod Seacoast hospital. Map data: Horry County GIS; U.S. Census Bureau TIGER/Line; OpenStreetMap.<ol class="c3-lr-key" aria-label="The five parts of Little River"><li><span class="c3-lr-num p-village" data-n="1" aria-hidden="true"></span><a href="#old-village">The old village and the harbors</a></li><li><span class="c3-lr-num p-east" data-n="2" aria-hidden="true"></span><a href="#north-and-east">North and east, toward Calabash</a></li><li><span class="c3-lr-num p-northwest" data-n="3" aria-hidden="true"></span><a href="#north-west">North-west, toward the Waccamaw</a></li><li><span class="c3-lr-num p-west" data-n="4" aria-hidden="true"></span><a href="#west">West, around the hospital</a></li><li><span class="c3-lr-num p-farwest" data-n="5" aria-hidden="true"></span><a href="#far-west">Far west, at SC 9</a></li></ol></figcaption></figure><h3 id="old-village" data-toc="The old village and the harbors" class="c3-lr-h3" style="font-family:var(--serif);font-size:1.3rem;color:var(--navy);margin:2rem 0 .6rem;line-height:1.3"><span class="c3-lr-num p-village" data-n="1" aria-hidden="true"></span><span>The old village and the harbors: all three marinas within a mile</span></h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">This is the part to choose if the boat comes first. The waterfront at the end of Mineola Avenue, its restaurants and all three marinas with deeded slips are within about a mile of the village center. At Mariner's Pointe, the condo buildings ring the slip basin.</p><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);letter-spacing:.01em;color:#fff;text-align:right;background:radial-gradient(farthest-side at 100% 100%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.c3ph-cr a{color:#fff;text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);text-underline-offset:2px;pointer-events:auto;padding:10px 0 6px}.c3ph-hero{margin:1.6rem 0 2rem}.c3ph-hero .c3ph-f{border-radius:8px}.c3ph-hero img{aspect-ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}</style><figure class="c3ph-hero" style="margin:1.6rem 0 1.8rem;max-width:640px;"><div class="c3ph-f"><img src="/images/2026-11-a/submarkets-little-river/little-river-harbours-from-above-1200w.webp" srcset="/images/2026-11-a/submarkets-little-river/little-river-harbours-from-above-600w.webp 600w, /images/2026-11-a/submarkets-little-river/little-river-harbours-from-above-1200w.webp 1200w" sizes="(max-width: 700px) 100vw, 640px" width="1200" height="900" alt="A marina basin full of boats off the Intracoastal Waterway, from above, with Coquina Harbour labelled at its upper end, Lightkeepers Village near its mouth, US 17 at the top left and a golf course at the upper right" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo. License: Public domain" title="License: Public domain">U.S. government aerial photo</a></span></div><figcaption>Coquina Harbour and Lightkeepers Village share one basin between US 17 and the waterway, with a golf course beside it (NAIP aerial, 2023).</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Golf is here too. Hidden Lakes Village borders the River Hills golf course, and Eastport's homes line a course beside Coquina Harbour. Cypress Village, with houses and townhouses, is the largest subdivision in this part.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Homes in Cypress Village resold for about $385,000 at the middle in the past year, and in Hidden Lakes Village for about $318,000. Flood risk is highest at the water's edge: about half the condos at Mariner's Pointe and most homes at Eastport are in FEMA's high-risk zone.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Little%20River's%20old%20village">Get the homes for sale in Little River's old village<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p><h3 id="north-and-east" data-toc="North and east, toward Calabash" class="c3-lr-h3" style="font-family:var(--serif);font-size:1.3rem;color:var(--navy);margin:2rem 0 .6rem;line-height:1.3"><span class="c3-lr-num p-east" data-n="2" aria-hidden="true"></span><span>North and east, toward Calabash: Heather Glen and Vereen Gardens</span></h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Heather Glen is the biggest neighborhood in Little River, with more than 1,100 houses north-east of the old village, and the busiest: more of its houses resold in the past year than in any other. Heather Lakes is east of it.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">This is the side nearest Calabash, North Carolina. Vereen Memorial Historical Gardens is in this part too, between US 17 and the waterway, with its trails along the marsh.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Houses in Heather Glen and Heather Lakes usually resold for about $375,000. Windjammer Village, the third large neighborhood here, has some homes in the high-risk flood zone.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=east%20Little%20River">Get the homes for sale in east Little River<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p><h3 id="north-west" data-toc="North-west, toward the Waccamaw" class="c3-lr-h3" style="font-family:var(--serif);font-size:1.3rem;color:var(--navy);margin:2rem 0 .6rem;line-height:1.3"><span class="c3-lr-num p-northwest" data-n="3" aria-hidden="true"></span><span>North-west, toward the Waccamaw: golf, dry ground and a river ramp</span></h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">River Hills is built along the River Hills golf course. Lafayette Park has more than 400 houses on lots of about a quarter of an acre.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Worthams Ferry Landing, the county's ramp on the Waccamaw River, is north of this part, for a boat you keep on a trailer.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Houses resold for about $385,000 at the middle in River Hills and about $348,000 in Lafayette Park. The marinas are back toward the old village, a drive rather than a walk.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=north-west%20Little%20River">Get the homes for sale in north-west Little River<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p><h3 id="west" data-toc="West, around the hospital" class="c3-lr-h3" style="font-family:var(--serif);font-size:1.3rem;color:var(--navy);margin:2rem 0 .6rem;line-height:1.3"><span class="c3-lr-num p-west" data-n="4" aria-hidden="true"></span><span>West, around the hospital: the landing and condos on the water</span></h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">McLeod Seacoast hospital is in this part, about 6 minutes from the old village. T. Craig Campbell Landing, the county's ramp at the US 17 bridge, is at its south edge.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Carolina Yacht Landing, a condo community on the waterway west of that landing, has about half its units within about 50 feet of the water. Bay Tree, near the hospital, has condos and townhouses.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Among Little River subdivisions with at least five resales, the two highest prices are here: Sawgrass Village at Bridgewater, at about $585,000, and Waterside Village, at about $560,000. Condos at Carolina Yacht Landing resold for about $252,000.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=west%20Little%20River">Get the homes for sale in west Little River<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p><h3 id="far-west" data-toc="Far west, at SC 9" class="c3-lr-h3" style="font-family:var(--serif);font-size:1.3rem;color:var(--navy);margin:2rem 0 .6rem;line-height:1.3"><span class="c3-lr-num p-farwest" data-n="5" aria-hidden="true"></span><span>Far west, at SC 9: a shorter drive to Myrtle Beach</span></h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">This part suits a buyer who drives south to Myrtle Beach often. SC 31, the Carolina Bays Parkway, starts at its edge. From its subdivisions, Coastal Grand Mall in Myrtle Beach is about 30 to 35 minutes by car and the airport about 35 to 40, a few minutes sooner than from the old village.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">It is the part farthest from the water: the old village's waterfront is about 12 to 15 minutes back east by car, and McLeod Seacoast hospital about 9. Its three largest subdivisions, Hidden Brooke, Palm Lakes Plantation and Waterfall, are neighborhoods of houses.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the past year, houses resold for about $340,000 at the middle in Palm Lakes Plantation, $390,000 in Hidden Brooke and $555,000 in Waterfall.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=far%20west%20Little%20River">Get the homes for sale in far west Little River<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}@media (max-width:699px){main#main .c3-gchart.c3-gchart-list [role=row]{grid-template-columns:minmax(0,1fr) auto;column-gap:.8rem;align-items:start}main#main .c3-gchart.c3-gchart-list .b{display:none}main#main .c3-gchart.c3-gchart-list .dot{display:none}main#main .c3-gchart.c3-gchart-list .f{display:block}main#main .c3-gchart.c3-gchart-list [role=cell]{justify-content:flex-end}}</style><figure class="c3-gchart c3-gchart-compact c3-gchart-list"><div role="table" aria-label="Middle resale price in the ten largest subdivisions with 10 or more resales, past year"><span class="cap" aria-hidden="true">Middle resale price in the ten largest subdivisions with 10 or more resales, past year</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Subdivision, part of Little River</span><span role="columnheader">Middle price</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Hidden Brooke</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">part 5</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">$390,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Cypress Village, houses and townhouses</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">part 1</span></span><span role="cell"><span class="b" style="--f:0.988" aria-hidden="true"></span><span class="v">$385,000</span></span></div><div role="row"><span role="rowheader"><span class="n">River Hills</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">part 3</span></span><span role="cell"><span class="b" style="--f:0.988" aria-hidden="true"></span><span class="v">$385,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Heather Glen</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">part 2</span></span><span role="cell"><span class="b" style="--f:0.963" aria-hidden="true"></span><span class="v">$375,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Lafayette Park</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">part 3</span></span><span role="cell"><span class="b" style="--f:0.893" aria-hidden="true"></span><span class="v">$348,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Palm Lakes Plantation</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">part 5</span></span><span role="cell"><span class="b" style="--f:0.873" aria-hidden="true"></span><span class="v">$340,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Hidden Lakes Village</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">part 1</span></span><span role="cell"><span class="b" style="--f:0.815" aria-hidden="true"></span><span class="v">$318,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Windjammer Village</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">part 2</span></span><span role="cell"><span class="b" style="--f:0.796" aria-hidden="true"></span><span class="v">$310,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Carolina Yacht Landing, condos</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">part 4</span></span><span role="cell"><span class="b" style="--f:0.647" aria-hidden="true"></span><span class="v">$252,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Bay Tree, condos</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">part 4</span></span><span role="cell"><span class="b" style="--f:0.424" aria-hidden="true"></span><span class="v">$165,000</span></span></div></div></div><figcaption>Every resale in each subdivision recorded in the county's deeds, mostly houses unless the name says otherwise. Middle price: half sold for more, half for less.</figcaption></figure></div></section><section style="background:var(--ivory-2)" id="flooding"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Flooding">Does Little River flood?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most of it does not. About 96 in 100 Little River homes are outside FEMA's high-risk flood zone. Homes right by the water are the exception: close to half of them are inside it.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="Share of Little River homes inside FEMA's high-risk flood zone"><span class="cap" aria-hidden="true">Share of Little River homes inside FEMA's high-risk flood zone</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Homes</span><span role="columnheader">In the zone</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Homes within about 50 feet of the water</span></span><span role="cell"><span class="b" style="--f:0.9" aria-hidden="true"></span><span class="v">45%</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">All homes in the ZIP</span></span><span role="cell"><span class="b" style="--f:0.072" aria-hidden="true"></span><span class="v">3.6%</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Homes away from the water</span></span><span role="cell"><span class="b" style="--f:0.044" aria-hidden="true"></span><span class="v">2.2%</span></span></div></div></div></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Hurricane Hazel came ashore near Little River, at the North Carolina and South Carolina line, in October 1954 as a Category 4 hurricane. It hit at the year's highest tide, and the storm surge reached as high as 18 feet at Calabash.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Few houses for sale at our last count were in the high-risk zone. We check the flood map, the elevation and the seller's flood disclosure for every house before you make an offer. Our page on <a href="/buyers/undisclosed-flooding/" style="color:var(--navy);text-decoration:underline">how to find out if a house flooded</a> shows every record we use.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do you need flood insurance in Little River?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A lender must require flood insurance when the building is in FEMA's high-risk zone, and can ask for it anywhere.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the Little River ZIP, a flood policy on a house outside the zone usually costs about $480 a year, and inside it about $1,250. A new policy starts 30 days after you apply and pay, unless you buy it with your home loan.</p></div></section><section style="background:var(--ivory)" id="yearly-cost"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Yearly cost">What does it cost to own a home in Little River each year?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A typical resold house you live in costs about $3,000 to $4,300 a year in property tax, a flood policy and homeowners insurance, before wind and hail cover.</p><style>.c3-cc{margin:1.4rem 0 1.8rem;max-width:960px}.c3-cc table{width:100%;border-collapse:collapse;font-size:var(--read,1.0625rem);line-height:1.45;color:var(--muted)}.c3-cc caption{caption-side:top;text-align:left;color:var(--navy);font-weight:600;font-size:1em;line-height:1.4;padding:0 0 .7rem}.c3-cc th,.c3-cc td{padding:.6rem .7rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule);overflow-wrap:break-word}.c3-cc thead th{color:var(--navy);font-weight:600;font-size:1em;border-bottom:2px solid var(--navy);vertical-align:bottom}.c3-cc tbody th{color:var(--navy);font-weight:600}.c3-cc .n{text-align:right;font-variant-numeric:tabular-nums}.c3-cc .i{display:inline-flex;vertical-align:-4px;margin-right:.45rem;color:var(--brass-ink)}.c3-cc tr.c3-self>*{background:#fff}@media (max-width:39.999em){.c3-cc table,.c3-cc tbody,.c3-cc tr,.c3-cc th,.c3-cc td{display:block;width:auto}.c3-cc caption{display:block}.c3-cc thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.c3-cc tbody tr{background:var(--ivory-2);border-top:3px solid var(--brass);margin:0 0 .8rem;padding:.5rem 0 .6rem}section[style*="background:var(--ivory-2)"] .c3-cc tbody tr{background:var(--ivory)}.c3-cc tr.c3-self{background:#fff!important;border:2px solid var(--brass)}.c3-cc tr.c3-self>*{background:transparent}.c3-cc th,.c3-cc td{border:0;padding:.2rem 1rem}.c3-cc tbody th{display:flex;align-items:center;font-size:1.1em;padding-bottom:.35rem}.c3-cc tbody th .i{flex:none;vertical-align:0}.c3-cc tbody th a{display:inline-block;padding:.5rem 0}.c3-cc .n{text-align:left}.c3-cc td[data-label]::before{content:attr(data-label) ": ";color:var(--navy);font-weight:500}}</style><div class="c3-cc"><table><caption>Each year, for a typical resold house you live in, outside North Myrtle Beach</caption><thead><tr><th scope="col">What you pay</th><th scope="col">Each year</th></tr></thead><tbody><tr><th scope="row">Property tax</th><td data-label="Each year">About $1,400</td></tr><tr><th scope="row">Flood policy outside the high-risk zone</th><td data-label="Each year">About $480</td></tr><tr><th scope="row">Homeowners insurance, without wind and hail</th><td data-label="Each year">About $1,100 to $2,400</td></tr><tr><th scope="row">Together</th><td data-label="Each year">About $3,000 to $4,300</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">That insurance range is for a house insured for $350,000. It leaves out wind and hail, which is priced on its own here. We get that quote for any house before you make an offer.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">South Carolina taxes a home you live in on 4 percent of its value, and a second home or rental on 6 percent, so the same house as a rental pays about $4,400. The owner must apply for the lower rate; our <a href="/buyers/property-taxes/" style="color:var(--navy);text-decoration:underline">property tax page</a> shows how. Where there is an HOA, its fee comes on top, and we read its budget and rules with you. Our <a href="/buyers/coastal-insurance/" style="color:var(--navy);text-decoration:underline">coastal insurance page</a> explains each policy.</p></div></section><section style="background:var(--ivory-2)" id="home-prices"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Home prices">What do homes cost in Little River, SC?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A resold house in Little River usually sold for about $357,000 in the past year. Half sold for between about $304,000 and $451,000. New houses from builders sold for less in the middle.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="What a home in Little River sold for in the past year, by kind"><span class="cap" aria-hidden="true">What a home in Little River sold for in the past year, by kind</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Kind of home</span><span role="columnheader">Middle price</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">House, resold</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">$357,000</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">New house from a builder</span></span><span role="cell"><span class="b" style="--f:0.89" aria-hidden="true"></span><span class="v">$318,000</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Townhouse</span></span><span role="cell"><span class="b" style="--f:0.741" aria-hidden="true"></span><span class="v">$265,000</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Condo</span></span><span role="cell"><span class="b" style="--f:0.53" aria-hidden="true"></span><span class="v">$189,000</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Manufactured home on its own lot</span></span><span role="cell"><span class="b" style="--f:0.511" aria-hidden="true"></span><span class="v">$183,000</span></span></div></div></div><figcaption>Sales recorded in the county's deeds for homes in the Little River ZIP code. Middle price: half sold for more, half for less.</figcaption></figure><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What kind of homes are here</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About two in three homes in the Little River ZIP are houses, and more than a quarter are condos.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Room to spread out is uncommon. Fewer than one in twenty houses sits on an acre or more, and the typical house lot is about a fifth of an acre.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Homes for sale now</h3><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="Homes for sale with a Little River address, at our last count"><span class="cap" aria-hidden="true">Homes for sale with a Little River address, at our last count</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Kind, for sale</span><span role="columnheader">Middle asking price</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Houses</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about 190 for sale</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">$398,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Townhouses</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about 29 for sale</span></span><span role="cell"><span class="b" style="--f:0.602" aria-hidden="true"></span><span class="v">$240,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Manufactured homes</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about 19 for sale</span></span><span role="cell"><span class="b" style="--f:0.627" aria-hidden="true"></span><span class="v">$250,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Condos</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about 180 for sale</span></span><span role="cell"><span class="b" style="--f:0.482" aria-hidden="true"></span><span class="v">$192,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Lots</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about 49 for sale</span></span><span role="cell"><span class="b" style="--f:0.414" aria-hidden="true"></span><span class="v">$165,000</span></span></div></div></div><figcaption>Asking prices, not sales. Listing counts from the Coastal Carolinas Association of REALTORS MLS, in aggregate.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About 44 of the houses for sale were new construction, and 22 asked under $300,000.</p></div></section><section style="background:var(--ivory)" id="renting-out"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Renting out">What do homes rent for in Little River?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">HUD's Small Area Fair Market Rent for a three-bedroom in the Little River ZIP is $2,100 a month, with utilities. That is above North Myrtle Beach's ZIP and Myrtle Beach's, and close to Carolina Forest's.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="HUD's fair market rent for a three-bedroom, by ZIP code"><span class="cap" aria-hidden="true">HUD's fair market rent for a three-bedroom, by ZIP code</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">ZIP code</span><span role="columnheader">A month, with utilities</span></div></div><div role="rowgroup"><div role="row" class="ref"><span role="rowheader"><span class="n">Longs, 29568</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">$2,270</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Carolina Forest, 29579</span></span><span role="cell"><span class="b" style="--f:0.982" aria-hidden="true"></span><span class="v">$2,230</span></span></div><div role="row"><span role="rowheader"><span class="n">Little River, 29566</span></span><span role="cell"><span class="b" style="--f:0.925" aria-hidden="true"></span><span class="v">$2,100</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">North Myrtle Beach, 29582</span></span><span role="cell"><span class="b" style="--f:0.828" aria-hidden="true"></span><span class="v">$1,880</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Myrtle Beach, 29577</span></span><span role="cell"><span class="b" style="--f:0.758" aria-hidden="true"></span><span class="v">$1,720</span></span></div></div></div></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Rents people pay here are higher than the county's: the Census survey's middle rent in Little River is about $1,530 a month, against about $1,260 countywide, apartments included.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">A worked example</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Take a typical resold house. At HUD's three-bedroom figure of $2,100 a month, a year comes to about $25,000, about 7 percent of the price. As a rental, the house pays about $4,400 a year in property tax, about 17 percent of that rent.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Insurance, upkeep, management and empty months come out of the rent too. Our <a href="/invest/long-term-rental/" style="color:var(--navy);text-decoration:underline">rental analyzer</a> works them out for any address.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Short-term rentals</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Little River has no city ordinance, so county rules apply. A home in Little River outside North Myrtle Beach that is rented short term needs:</p><ul style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem">a Horry County business license;</li><li style="margin-bottom:.5rem">a county hospitality and accommodations account;</li><li style="margin-bottom:.5rem">a South Carolina sales and accommodations tax account;</li><li style="margin-bottom:.5rem">a yearly county personal property return for its furnishings, due April 30.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">An HOA's rules can forbid short stays, and we read them first. See <a href="/invest/str-rules/" style="color:var(--navy);text-decoration:underline">the short-term rental rules by town</a> and <a href="/invest/airbnb-income/" style="color:var(--navy);text-decoration:underline">what a nightly rental earns by town</a>.</p></div></section><section style="background:var(--ivory-2)" id="carolina-bays-parkway"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The new road">Is the Carolina Bays Parkway being extended through Little River?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The extension is planned but not built. The Carolina Bays Parkway, SC 31, would be extended from SC 9 north-east, passing north and northwest of Little River's old village. It would cross the state line to US 17 near Shallotte, North Carolina. It would be a multi-lane freeway, partly on new ground.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">South Carolina's part is in SCDOT's current program. North Carolina has not funded land buying or building for its part. The whole project is estimated at $797 million.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The two states have named a preferred route. The final choice comes after they review the comments from the public hearings. If you like a house in the north-west part, we show you where it sits against the preferred route's map.</p></div></section><section style="background:var(--ivory)" id="pros-and-cons"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Pros and cons">What are the pros and cons of living in Little River?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The good points are the water, the price and a year-round town. The hard ones are the few houses on the water, flooding at the water's edge, and the drive to the airport.</p><style>.c3-pc{display:grid;gap:1rem;max-width:960px;margin:1.2rem 0 1.6rem}@media (min-width:760px){.c3-pc{grid-template-columns:1fr 1fr;align-items:start}}.c3-pc>div{padding:1.1rem 1.2rem .6rem}.c3-pc h3{font-family:var(--sans);font-size:1.15rem;font-weight:600;color:var(--navy);margin:0 0 .8rem;display:flex;align-items:center;gap:.55rem}.c3-pc,.c3-pc ul{font-size:1em}.c3-pc ul{list-style:none;margin:0;padding:0}.c3-pc li{display:flex;gap:.7rem;align-items:flex-start;color:var(--muted);font-size:var(--read,1.0625rem);line-height:1.7;margin:0 0 .9rem}.c3-pc li svg{flex:none;margin-top:.3rem}.c3-pc .c3-pc-do{display:block;color:var(--navy);font-weight:500;margin-top:.2rem}</style><div class="c3-pc"><div style="background:var(--ivory-2);border-top:3px solid var(--brass)"><h3>Pros</h3><ul><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="11" fill="var(--brass)"/><path d="M6.2 11.4l3.1 3.1 6.5-6.7" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Deeded boat slips you can own, and public ramps on the waterway and the Waccamaw River.</span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="11" fill="var(--brass)"/><path d="M6.2 11.4l3.1 3.1 6.5-6.7" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>No city tax, golf in the neighborhoods, and the beach about 11 minutes away.</span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="11" fill="var(--brass)"/><path d="M6.2 11.4l3.1 3.1 6.5-6.7" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>A year-round community, with the waterfront, the Blue Crab Festival, the swing bridge and Vereen Gardens.</span></li></ul></div><div style="background:var(--ivory-2);border-top:3px solid var(--muted)"><h3>Cons</h3><ul><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="10" fill="none" stroke="var(--muted)" stroke-width="1.6"/><path d="M6.8 11h8.4" stroke="var(--muted)" stroke-width="2.2" stroke-linecap="round"/></svg><span>Few houses are on the water, and those cost far more. We pair a house with a deeded slip instead.</span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="10" fill="none" stroke="var(--muted)" stroke-width="1.6"/><path d="M6.8 11h8.4" stroke="var(--muted)" stroke-width="2.2" stroke-linecap="round"/></svg><span>Homes right at the water's edge have the most flood risk. We check the flood map and the elevation first.</span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="10" fill="none" stroke="var(--muted)" stroke-width="1.6"/><path d="M6.8 11h8.4" stroke="var(--muted)" stroke-width="2.2" stroke-linecap="round"/></svg><span>The airport is about 41 minutes away by car.</span></li></ul></div></div></div></section><section style="background:var(--ivory-2)" id="little-river-sc-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Little River, SC FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is Little River, SC a city, and what county is it in?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Little River is not a city. It is an unincorporated community in Horry County, South Carolina, at the North Carolina line, and the county runs it.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What is there to do in Little River, SC?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most of Little River's life is on the water: the docks and restaurants on the Mineola Avenue waterfront, and public ramps on the waterway and the Waccamaw River. On land there is golf in the neighborhoods, the trails at Vereen Memorial Historical Gardens and the Blue Crab Festival each May.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How far is Little River from Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About 36 minutes by car to Coastal Grand Mall in Myrtle Beach, without traffic. Barefoot Landing, in North Myrtle Beach, is about 18 minutes, and the airport about 41.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does Little River, SC flood?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most of it does not: about 96 in 100 homes are outside FEMA's high-risk flood zone. The risk is at the water's edge, along the Intracoastal Waterway.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What is the property tax in Little River, SC?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A home you live in pays only the county's property tax, about $1,400 a year on a typical resold house, with no city tax on top. A second home or rental is taxed at a higher rate.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How much is a boat slip in Little River?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Deeded slips at Mariner's Pointe, most about 30 to 35 feet long, sold for $10,000 to $38,000 in the past year, each on its own deed, without a condo. Bigger slips at Dock Holidays, across the line in North Myrtle Beach, sold for $65,000 to $115,000.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is Little River, SC safe?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We do not rate any place as safe or unsafe. Reported crime is published by police agency, and we pull the figures for the area around any house you ask about.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Which schools serve Little River, SC?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Horry County Schools assigns schools by address, in nine attendance areas, and none is named Little River. We look up the assigned schools for any house you like.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County GIS</a>, <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">county deeds</a>, <a href="https://data.census.gov/profile/Little_River_CDP,_South_Carolina?g=160XX00US4542010" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Census profile</a>, <a href="https://www.fema.gov/openfema-data-page/fima-nfip-redacted-policies-v2" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FEMA flood policies</a>, <a href="https://www.huduser.gov/portal/datasets/fmr/smallarea/index.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">HUD rents</a>, <a href="https://www.horrycountysc.gov/media/kufln4qp/tax-levy-2026_2.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">2026 tax levy</a>, <a href="https://www.scstatehouse.gov/code/t12c043.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-43</a>, <a href="https://www.law.cornell.edu/uscode/text/42/4012a" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">42 USC 4012a</a>, <a href="https://www.law.cornell.edu/uscode/text/42/4013" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">42 USC 4013</a>, <a href="https://projectportal.scdot.org/sc-historic-bridges/s-20-bridge-over-intercoastal-waterway-horry-county" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SCDOT swing bridge</a>, <a href="https://www.ecfr.gov/current/title-33/chapter-I/subchapter-J/part-117/subpart-B/section-117.911" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">33 CFR 117.911</a>, <a href="https://www.horrycountysc.gov/departments/parksandrecreation/parks" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">county parks</a>, <a href="https://www.horrycounty.org/gisweb/rest/services/Public/ParksRecreation/MapServer/1" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">boat landings</a>, <a href="https://www.weather.gov/ilm/HurricaneHazel1954" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NWS Hazel</a>, <a href="https://www.horrycountysc.gov/media/monjnvh0/sales-tax-chart-short-term-rentals.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">rental filings</a>, <a href="https://www.ncdot.gov/projects/carolina-bays-parkway/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NCDOT project</a>, <a href="https://www.ncdot.gov/projects/carolina-bays-parkway/Documents/carolina-bays-extension-public-hearing-summary.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">hearing summary</a>, <a href="https://www.horrycountyschools.net/about-hcs/our-schools" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County Schools</a>, <a href="https://bluecrabfestival.org/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Blue Crab Festival</a>, <a href="https://online.doi.sc.gov/Eng/Public/HelpInsure/HelpInsure.aspx?LinkId=Home" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC sample rates</a>. Our counts from county parcels, flood maps and deeds. Listings in aggregate from CCMLS. Drives without traffic.</p><style>.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">The waterfront at the end of Mineola Avenue, and the slip basin at Mariner's Pointe, from above. Photo: USDA Farm Service Agency, NAIP, <a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://planetarycomputer.microsoft.com/dataset/naip" target="_blank" rel="noopener noreferrer">Microsoft Planetary Computer</a>. Chapter3 Realty cut this view from the NAIP image, raised the contrast a little and added labels placed from county and Census coordinates.</div><div role="listitem">Coquina Harbour and Lightkeepers Village share one basin between US 17 and the waterway. Photo: USDA Farm Service Agency, NAIP, <a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://planetarycomputer.microsoft.com/dataset/naip" target="_blank" rel="noopener noreferrer">Microsoft Planetary Computer</a>. Chapter3 Realty cut this view from the NAIP image, raised the contrast a little and added labels placed from county and Census coordinates.</div><div role="listitem">Chapter3 Realty resized these photos and cropped some of them.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-11-a/submarkets-little-river/little-river-waterfront-from-above-1200w.webp","url":"https://chapter3realty.com/images/2026-11-a/submarkets-little-river/little-river-waterfront-from-above-1200w.webp","width":1200,"height":900,"encodingFormat":"image/webp","name":"The waterfront at the end of Mineola Avenue, and the slip basin at Mariner's Pointe, from above","caption":"The waterfront at the end of Mineola Avenue, and the slip