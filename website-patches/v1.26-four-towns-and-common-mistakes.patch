+my=lambda la: R*math.log(math.tan(math.pi/4+math.radians(la)/2))
+ALL={'pier':(-78.9985,33.5772,700),'marsh':(-79.0045,33.5775,600),'streets':(-79.0005,33.5865,700),'inland':(-79.0080,33.6010,700),'point':(-79.0270,33.5385,900)}
