+<script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is Garden City, SC in Horry County or Georgetown County?","acceptedAnswer":{"@type":"Answer","text":"Both. The pier is in Horry County, and most of the beach road is in Georgetown County."}},{"@type":"Question","name":"Is Garden City part of Myrtle Beach?","acceptedAnswer":{"@type":"Answer","text":"No. Garden City is not part of any city. Most addresses use Murrells Inlet, ZIP code 29576."}},{"@type":"Question","name":"Can you drive a golf cart on Garden City Beach?","acceptedAnswer":{"@type":"Answer","text":"On the Horry County beach, from November 1 to February 28, with a state permit and a licensed driver."}},{"@type":"Question","name":"Are dogs allowed on Garden City Beach?","acceptedAnswer":{"@type":"Answer","text":"Not from 10 a.m. to 5 p.m., May 1 through Labor Day, on the Horry County beach. At other times, on a hand-held leash no longer than 7 feet."}},{"@type":"Question","name":"Is Garden City, SC safe?","acceptedAnswer":{"@type":"Answer","text":"We do not rate any place as safe or unsafe. On the Horry side, the Horry County Police Department, the county's main law enforcement agency, answers calls. On the Georgetown end, the Georgetown County Sheriff's Office does."}},{"@type":"Question","name":"What schools serve Garden City, SC?","acceptedAnswer":{"@type":"Answer","text":"Schools are assigned by address. Homes on the Horry side are in Horry County Schools, and homes on the Georgetown end are in the Georgetown County School District. We look up the assigned schools for any home you like."}}]}</script>
