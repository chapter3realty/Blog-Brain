+++ b/data/2026-11-a/submarkets-garden-city/pull-blocks.sh
@@ -0,0 +1,7 @@
+#!/bin/sh
+# 2020 Census blocks along Waccamaw Drive (both counties): TIGERweb block polygons with POP100 and HU100, and DHC table H5
+# (vacancy status) for every block in the four tracts the strip crosses. Run from the data folder: RAW=<scratch> sh pull-blocks.sh
+curl -sS "https://tigerweb.geo.census.gov/arcgis/rest/services/TIGERweb/Tracts_Blocks/MapServer/12/query?where=1%3D1&geometry=-79.03,33.52,-78.97,33.60&geometryType=esriGeometryEnvelope&inSR=4326&spatialRel=esriSpatialRelIntersects&outFields=GEOID,POP100,HU100,COUNTY,AREALAND&outSR=4326&f=geojson" -o "$RAW/blocks2020.geojson"
+for tr in 45043920510 45051051202 45051051301 45051051302; do
+  curl -sS "https://data.census.gov/api/access/data/table?id=DECENNIALDHC2020.H5&g=1400000US$tr\$1000000" -o "raw/census-H5-blocks-$tr.json"
+done
diff --git a/data/2026-11-a/submarkets-garden-city/pull-census.sh b/data/2026-11-a/submarkets-garden-city/pull-census.sh
new file mode 100644
index 00000000..b0dfe909
--- /dev/null
+++ b/data/2026-11-a/submarkets-garden-city/pull-census.sh
@@ -0,0 +1,8 @@
+#!/bin/sh
+# Census tables for Garden City CDP (place 4528455) and Horry County (45051), one geography per call. Run from the data folder: sh pull-census.sh
+A="https://data.census.gov/api/access/data/table"
+for t in ACSDT5Y2024.B25002 ACSDT5Y2024.B25004 ACSDT5Y2024.B25003 ACSDT5Y2024.B25077 ACSDT5Y2024.B25024 ACSDT5Y2024.B25035 ACSDT5Y2024.B01003 ACSDT5Y2024.B01002 ACSDT5Y2024.B25064 DECENNIALPL2020.P1 DECENNIALPL2020.H1 DECENNIALDHC2020.H5 DECENNIALSF12010.P1; do
+  for g in 160XX00US4528455 050XX00US45051; do
+    curl -sS "$A?id=$t&g=$g" -o "raw/census-$t-$g.json"; echo "$t $g $(python3 -c "import json,sys;d=json.load(open(sys.argv[1]))['response']['data'];print({k:v for k,v in zip(d[0],d[1]) if not k.endswith(('A','M'))})" raw/census-$t-$g.json 2>&1 | cut -c1-700)"
+  done
+done
