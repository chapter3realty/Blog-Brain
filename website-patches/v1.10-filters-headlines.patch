 <script type="application/ld+json">{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Why is Surfside Beach called the family beach?", "acceptedAnswer": {"@type": "Answer", "text": "It has a quieter, more residential feel than central Myrtle Beach, with steady seasonal demand and a mix of homes and condominiums."}}, {"@type": "Question", "name": "What does Surfside Beach offer investors?", "acceptedAnswer": {"@type": "Answer", "text": "A calmer setting close to the main attractions, with both single-family and condominium options."}}, {"@type": "Question", "name": "Can you Airbnb a property in Surfside Beach?", "acceptedAnswer": {"@type": "Answer", "text": "Only in the right zone. Surfside permits short-term rentals (under 30 days) in the R3 high-density and C3 commercial districts and restricts or prohibits them in inland R1 low-density zones. A town STR permit and safety inspection are required."}}, {"@type": "Question", "name": "Is Surfside Beach a golf-cart town?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Golf carts are a primary local mode of transport, and South Carolina allows registered carts on secondary roads during daylight within a few miles of home."}}, {"@type": "Question", "name": "Why do Surfside Beach median prices look so high?", "acceptedAnswer": {"@type": "Answer", "text": "Because the blended median mixes small inland condos with oceanfront homes. Detached single-family medians run much higher than the overall home-value index, so compare within a tier."}}, {"@type": "Question", "name": "What are property taxes on a second home in Surfside Beach?", "acceptedAnswer": {"@type": "Answer", "text": "A primary home is taxed on 4 percent of its value and does not pay the school operating tax. A second home is taxed on 6 percent and pays the school operating tax. In Surfside Beach that makes a second home's bill about 3.1 times a primary home's on the same house."}}, {"@type": "Question", "name": "Which schools serve Surfside Beach?", "acceptedAnswer": {"@type": "Answer", "text": "Public schools fall within Horry County Schools, generally Lakewood Elementary, St. James Intermediate, and St. James High. Chapter3 will confirm the exact assignment on the district boundary map."}}]}</script>
