+
+/* What a nightly rental keeps (rows 35 and 36, VERIFIED-BY-FIXER), against the fee and tax above. */
+const AV = SI.average_listing, TQ = SI.top_quarter_listing, TWO = SI.by_size["2 bedrooms"];
