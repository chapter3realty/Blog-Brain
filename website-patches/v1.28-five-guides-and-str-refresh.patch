4 -14.7 1.2z" fill="#ffffff" stroke="#1c2028" stroke-width="1.1"/><text class="r" y="3.1" text-anchor="middle">501</text></g></g><g transform="translate(121.5 235.9)"><g class="k"><path d="M-10.7 -8H10.7V1.2C10.7 6.4 4.8 8 0 9.6C-4.8 8 -10.7 6.4 -10.7 1.2z" fill="#ffffff" stroke="#1c2028" stroke-width="1.1"/><text class="r" y="3.1" text-anchor="middle">17</text></g></g><g transform="translate(175.4 85.1)"><g class="k"><rect x="-12" y="-8" width="23.9" height="16" rx="3" fill="#ffffff" stroke="#1c2028" stroke-width="1.1"/><text class="r" y="4" text-anchor="middle">22</text></g></g><g transform="translate(205.9 45.6)"><g class="k"><rect x="-9.5" y="-8" width="19" height="16" rx="3" fill="#ffffff" stroke="#1c2028" stroke-width="1.1"/><text class="r" y="4" text-anchor="middle">9</text></g></g><g><g transform="translate(236.5 112.6)"><g class="k"><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="ab" y="4.5" text-anchor="middle">1</text></g></g><path d="M154.2 191.3L170.2 213.3" stroke="#1c2028" stroke-width="1.2"/><g transform="translate(176.2 221.3)"><g class="k"><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="ab" y="4.5" text-anchor="middle">2</text></g></g><g transform="translate(148.7 197.2)"><g class="k"><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="ab" y="4.5" text-anchor="middle">3</text></g></g><g transform="translate(134.7 211.3)"><g class="k"><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="ab" y="4.5" text-anchor="middle">4</text></g></g><g transform="translate(109.5 212.2)"><g class="k"><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="ab" y="4.5" text-anchor="middle">5</text></g></g><g transform="translate(182.9 154.2)"><g class="k"><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="ab" y="4.5" text-anchor="middle">6</text></g></g><g transform="translate(222.9 90.1)"><g class="k"><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="ab" y="4.5" text-anchor="middle">7</text></g></g><g transform="translate(144.8 164.6)"><g class="k"><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="ab" y="4.5" text-anchor="middle">8</text></g></g><g transform="translate(135.5 115.6)"><g class="k"><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="ab" y="4.5" text-anchor="middle">9</text></g></g><g transform="translate(255.5 98.2)"><g class="k"><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="ab" y="4.5" text-anchor="middle">10</text></g></g><g transform="translate(171.1 136)"><g class="k"><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="ab" y="4.5" text-anchor="middle">11</text></g></g></g></svg><figcaption style="color:var(--muted);font-size:.85rem;line-height:1.6;margin-top:.6rem">Where zoning allows nightly rentals. A subdivision's recorded rules can still bar them. Myrtle Beach's zones: the city's map. Map data: U.S. Census Bureau TIGER/Line; Horry County GIS.</figcaption></figure><ol class="c3w-key" role="list" aria-label="Map key"><li><b>1</b>North Myrtle Beach</li><li><b>2</b>Surfside Beach</li><li><b>3</b>Garden City</li><li><b>4</b>Murrells Inlet</li><li><b>5</b>Pawleys Island and Litchfield</li><li><b>6</b>Myrtle Beach</li><li><b>7</b>Longs</li><li><b>8</b>Socastee</li><li><b>9</b>Conway</li><li><b>10</b>Little River</li><li><b>11</b>Carolina Forest</li></ol></div></div><p style="color:var(--muted);font-size:.9rem;margin-bottom:1rem">By <strong style="color:var(--navy);font-weight:600">Tim Nash</strong>, Broker-in-Charge, 30+ years on the Grand Strand &middot; Reviewed by <strong style="color:var(--navy);font-weight:600">Devin Day</strong>, Operations Officer &middot; <span style="white-space:nowrap">Updated November 3, 2026</span></p><p class="detail-sub">Eleven Grand Strand areas compared for a rental investor.</p></div></div><section style="background:var(--ivory)"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">The short answer</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For a nightly rental, buy in one of the beach areas, where the rules for the address allow it. A rental-data company estimates that the average nightly rental there took in about $25,000 to $48,000 in a year, before costs. For a yearly lease, buy inland. In Longs, Socastee and Conway, a year's rent is about 7 to 9 percent of a house's price. In North Myrtle Beach, Myrtle Beach, Surfside Beach, Murrells Inlet and Pawleys Island, it is 3 to 4 percent.</p></div></section><section style="background:var(--ivory-2)" id="north-myrtle-beach"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="1. North Myrtle Beach">1. North Myrtle Beach: nightly rentals with a business license</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="/submarkets/north-myrtle-beach/" style="color:var(--navy);text-decoration:underline">North Myrtle Beach</a> has no special zoning or permit for nightly rentals. It asks for a business license renewed each year, the lodging taxes, and its rules on trash, parking, noise and occupancy.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/invest-where-to-buy/north-myrtle-beach-towers-and-houses-2011-1200w.webp" srcset="/images/2026-11-a/invest-where-to-buy/north-myrtle-beach-towers-and-houses-2011-600w.webp 600w, /images/2026-11-a/invest-where-to-buy/north-myrtle-beach-towers-and-houses-2011-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="675" alt="Two condo towers, a low condo building and raised beach houses side by side behind the dunes in North Myrtle Beach, seen from over the ocean" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="USGS photo, 2011. License: Public domain" title="License: Public domain">USGS photo, 2011</a></span></div><figcaption>Condo towers and beach houses on the same oceanfront block in North Myrtle Beach.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most homes here are condos, and four in five condos for sale are listed as open to nightly guests. In the rental data's North Myrtle Beach area, the average nightly rental took in about $34,000 a year, before costs.</p><div class="c3w-money"><p class="c3-place-price">The middle house here sold for about $565,000 and the middle condo for about $300,000.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=North%20Myrtle%20Beach">Get rentals for sale in North Myrtle Beach<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></div></section><section style="background:var(--ivory)" id="surfside-beach"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="2. Surfside Beach">2. Surfside Beach: nightly rentals in two districts</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="/submarkets/surfside-beach/" style="color:var(--navy);text-decoration:underline">Surfside Beach</a> allows stays of less than 30 days in only two of its zoning districts. A lease of a year or more is allowed wherever homes are. The town's code does not define a lease of one month to a year. For a monthly rental, we get the town's reading before you make an offer.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/invest-where-to-buy/surfside-beach-pier-and-houses-2011-1200w.webp" srcset="/images/2026-11-a/invest-where-to-buy/surfside-beach-pier-and-houses-2011-600w.webp 600w, /images/2026-11-a/invest-where-to-buy/surfside-beach-pier-and-houses-2011-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="675" alt="The Surfside Beach fishing pier with a parking lot on one side and rows of raised beach houses on the other, seen from over the ocean" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="USGS photo, 2011. License: Public domain" title="License: Public domain">USGS photo, 2011</a></span></div><figcaption>The pier and rows of raised beach houses in Surfside Beach.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Houses cost more here than in any of the other ten areas, and almost no new ones are built. In the rental data's Surfside Beach area, the average nightly rental brought in about $43,000 a year, before costs.</p><div class="c3w-money"><p class="c3-place-price">The middle house here sold for about $705,000 and the middle condo for about $370,000.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Surfside%20Beach">Get rentals for sale in Surfside Beach<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></div></section><section style="background:var(--ivory-2)" id="garden-city"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="3. Garden City">3. Garden City: the most houses for sale that say nightly is allowed</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="/submarkets/garden-city/" style="color:var(--navy);text-decoration:underline">Garden City</a> is outside the towns, in Horry County. A nightly rental here needs a county business license, a state sales tax number and a county hospitality and accommodations tax account.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">More than half the houses for sale here say nightly stays are allowed, the highest share of the eleven areas. In the rental data's Garden City Beach area, the average nightly rental took in about $41,000 a year, before costs.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/invest-where-to-buy/garden-city-pier-and-beach-road-2011-1200w.webp" srcset="/images/2026-11-a/invest-where-to-buy/garden-city-pier-and-beach-road-2011-600w.webp 600w, /images/2026-11-a/invest-where-to-buy/garden-city-pier-and-beach-road-2011-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="675" alt="Garden City Beach from over the ocean: the pier, shops along the beach road, mid-rise condo buildings and raised houses, with the salt marsh behind" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="USGS photo, 2011. License: Public domain" title="License: Public domain">USGS photo, 2011</a></span></div><figcaption>Condo buildings and houses on the strip between the ocean and the marsh at Garden City.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Houses here cost less than in the other five beach areas. FEMA puts 39 percent of homes here in its high-risk flood zone, the highest share of the eleven areas, so we price the flood insurance for each house.</p><div class="c3w-money"><p class="c3-place-price">The middle house here sold for about $406,000 and the middle condo for about $221,000.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Garden%20City">Get rentals for sale in Garden City<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></div></section><section style="background:var(--ivory)" id="murrells-inlet"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="4. Murrells Inlet">4. Murrells Inlet, Georgetown County side: no county business license, and a 30-day limit</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="/submarkets/murrells-inlet/" style="color:var(--navy);text-decoration:underline">Murrells Inlet</a> sits on both sides of the county line. On this page, Murrells Inlet is the Census area of that name, which lies on the Georgetown County side. Georgetown County requires no business license. Its zoning allows a house to be rented for stays of up to 30 days in the county's resort zone. The lot may hold only that house, with a parking space for each bedroom. We look up the zoning of each address.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/invest-where-to-buy/murrells-inlet-georgetown-side-from-above-1200w.webp" srcset="/images/2026-11-a/invest-where-to-buy/murrells-inlet-georgetown-side-from-above-600w.webp 600w, /images/2026-11-a/invest-where-to-buy/murrells-inlet-georgetown-side-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="675" alt="Aerial photo of a subdivision of houses on curving streets on the Georgetown County side of Murrells Inlet, with houses on larger wooded lots below it" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo, 2023. License: Public domain" title="License: Public domain">U.S. government aerial photo, 2023</a></span></div><figcaption>A subdivision on the Georgetown County side of Murrells Inlet, with older houses on larger wooded lots below it.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About three in four homes here are their owner's main home. In the rental data's Murrells Inlet area, the average nightly rental made about $48,000 a year, the most of the six beach areas.</p><div class="c3w-money"><p class="c3-place-price">The middle house here sold for about $610,000, counting every recorded sale.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Murrells%20Inlet">Get rentals for sale in Murrells Inlet<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></div></section><section style="background:var(--ivory-2)" id="pawleys-litchfield"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="5. Pawleys Island and Litchfield">5. Pawleys Island and Litchfield: nightly rentals on the island, with its own tax</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Nightly rentals are allowed on <a href="/submarkets/pawleys-island/" style="color:var(--navy);text-decoration:underline">Pawleys Island</a>, and the town collects its own accommodations tax for its Beach Fund. Off the island, the county's resort zone allows stays of up to 30 days, and a community's HOA can limit rentals.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/invest-where-to-buy/litchfield-beach-houses-and-condos-2011-1200w.webp" srcset="/images/2026-11-a/invest-where-to-buy/litchfield-beach-houses-and-condos-2011-600w.webp 600w, /images/2026-11-a/invest-where-to-buy/litchfield-beach-houses-and-condos-2011-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="675" alt="Raised beach houses and low condo buildings around a pool at Litchfield Beach, with long docks crossing the marsh behind, seen from over the ocean" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="USGS photo, 2011. License: Public domain" title="License: Public domain">USGS photo, 2011</a></span></div><figcaption>Beach houses and low condo buildings at Litchfield Beach, with docks across the marsh.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About 7 percent of homes here are on the oceanfront, in the part of FEMA's high-risk zone where the flood map expects waves. That is the largest share of the eleven areas, and flood insurance costs the most there. Around Pawleys Island, a nightly rental brought in about $31,000 a year, before costs.</p><div class="c3w-money"><p class="c3-place-price">The middle house here sold for about $650,000 and the middle condo for about $325,000, counting every recorded sale.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Pawleys%20Island%20and%20Litchfield">Get rentals for sale in Pawleys Island and Litchfield<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></div></section><section style="background:var(--ivory)" id="myrtle-beach"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="6. Myrtle Beach">6. Myrtle Beach: condos in the zones marked for nightly rentals</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="/submarkets/myrtle-beach/" style="color:var(--navy);text-decoration:underline">Myrtle Beach</a> is a condo market: condos outnumber houses. About three in four condos sit in a zone the city marks for nightly rentals, the dark blue on the map. Most houses do not.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/invest-where-to-buy/myrtle-beach-oceanfront-towers-2011-1200w.webp" srcset="/images/2026-11-a/invest-where-to-buy/myrtle-beach-oceanfront-towers-2011-600w.webp 600w, /images/2026-11-a/invest-where-to-buy/myrtle-beach-oceanfront-towers-2011-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="675" alt="Three large oceanfront towers with pools in front of them in Myrtle Beach, and streets of houses behind, seen from over the ocean" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="USGS photo, 2011. License: Public domain" title="License: Public domain">USGS photo, 2011</a></span></div><figcaption>Oceanfront towers in Myrtle Beach.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the city, any stay of less than 90 days counts as short-term, and most neighborhoods of houses are zoned against it. Some houses for sale are still listed as open to nightly stays. What a listing says is not enough, so we check the zone and the HOA's rules for each house. In the rental data's Myrtle Beach area, the average nightly rental took in about $26,000 a year, the least of the six beach areas.</p><div class="c3w-money"><p class="c3-place-price">The middle condo here sold for about $175,000.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Myrtle%20Beach">Get rentals for sale in Myrtle Beach<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></div></section><section style="background:var(--ivory-2)" id="longs"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="7. Longs">7. Longs: the highest rent next to the price</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The federal housing agency, HUD, publishes a rent for a standard 3-bedroom in each ZIP code, counting the utilities a tenant pays. In Longs it is $2,270 a month. A year of that rent comes to about 9.1 percent of the middle house price, the highest of the eleven areas.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/invest-where-to-buy/longs-new-subdivision-from-above-1200w.webp" srcset="/images/2026-11-a/invest-where-to-buy/longs-new-subdivision-from-above-600w.webp 600w, /images/2026-11-a/invest-where-to-buy/longs-new-subdivision-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Aerial photo of a new subdivision in Longs with streets and ponds cut into bare ground, a few rows of new houses, empty lots, and farm fields and woods around it" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo, 2023. License: Public domain" title="License: Public domain">U.S. government aerial photo, 2023</a></span></div><figcaption>A new subdivision going up beside farm fields in Longs: streets and ponds dug, some houses built or framed, and most lots still empty.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Builders are still selling here: at least 46 percent of house sales in the past year were a builder's first sale. Each new street adds houses for rent near yours, and rents do not always rise with prices. <a href="#townhouses" style="color:var(--navy);text-decoration:underline">Eight townhouses in Little River</a> show how.</p><div class="c3w-money"><p class="c3-place-price">The middle house here sold for about $300,000.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Longs">Get rentals for sale in Longs<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></div></section><section style="background:var(--ivory)" id="socastee"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="8. Socastee">8. Socastee: houses priced like Longs, with tenants all year</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Socastee is outside the towns, in Horry County, so zoning puts no limit on nightly rentals. </p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Socastee houses cost about what Longs houses do. About a third of homes here are rented, so the tenants a yearly lease needs already live here.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/invest-where-to-buy/socastee-subdivision-from-above-1200w.webp" srcset="/images/2026-11-a/invest-where-to-buy/socastee-subdivision-from-above-600w.webp 600w, /images/2026-11-a/invest-where-to-buy/socastee-subdivision-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Aerial photo of rows of similar houses on curving streets around a pond in Socastee, older houses on wooded lots above them and a highway on a bridge at the right" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo, 2023. License: Public domain" title="License: Public domain">U.S. government aerial photo, 2023</a></span></div><figcaption>A subdivision of similar houses around a pond in Socastee, with older houses on wooded lots across the road and a highway bridge on the right.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Socastee has the most homes in the high-risk flood zone of the five inland areas, about 11 percent. We check the zone for the address and price the insurance.</p><div class="c3w-money"><p class="c3-place-price">The middle house here sold for about $300,000.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Socastee">Get rentals for sale in Socastee<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></div></section><section style="background:var(--ivory-2)" id="conway"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="9. Conway">9. Conway: the lowest house prices, and nightly rentals downtown</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A house costs less in <a href="/submarkets/conway/" style="color:var(--navy);text-decoration:underline">Conway</a> than in any of the other ten areas. Census figures put what tenants here pay at about $870 a month at the middle, for rentals of every size. That is less than in Socastee, Myrtle Beach or Carolina Forest, and we price each house against Conway rents, not beach rents.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/invest-where-to-buy/conway-riverwalk-and-warehouses-1200w.webp" srcset="/images/2026-11-a/invest-where-to-buy/conway-riverwalk-and-warehouses-600w.webp 600w, /images/2026-11-a/invest-where-to-buy/conway-riverwalk-and-warehouses-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="A wooden boardwalk with a black rail running past old wooden warehouses and a building with a screened porch, under tall sycamore trees, in Conway" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://commons.wikimedia.org/wiki/Template:PD-self" target="_blank" rel="noopener noreferrer" aria-label="Photo: Pubdog, 2010. License: Public domain" title="License: Public domain">Photo: Pubdog, 2010</a></span></div><figcaption>The riverwalk boardwalk past old wooden warehouses in downtown Conway.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Conway allows a nightly rental only in three of its business districts, including downtown and the riverfront. A stay may last up to 90 days, with a city business license. A bed and breakfast, where the host lives on site, is a separate use. Conway's tax on a rental is the highest per dollar of the eleven areas.</p><div class="c3w-money"><p class="c3-place-price">The middle house here sold for about $271,000.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Conway">Get rentals for sale in Conway<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></div></section><section style="background:var(--ivory)" id="little-river"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="10. Little River">10. Little River: the lowest condo prices</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="/submarkets/little-river/" style="color:var(--navy);text-decoration:underline">Little River</a> has the lowest middle condo price of the eleven areas, and a house's rent for a year is 6.6 percent of its sale price.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/invest-where-to-buy/little-river-houses-and-ponds-from-above-1200w.webp" srcset="/images/2026-11-a/invest-where-to-buy/little-river-houses-and-ponds-from-above-600w.webp 600w, /images/2026-11-a/invest-where-to-buy/little-river-houses-and-ponds-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Aerial photo of houses on curving streets around ponds in Little River, with larger buildings and parking lots at the lower left and woods between" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo, 2023. License: Public domain" title="License: Public domain">U.S. government aerial photo, 2023</a></span></div><figcaption>Houses on curving streets around ponds in Little River, with larger buildings and their parking lots at the lower left.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Nightly stays here depend on the subdivision's recorded rules. About 1 in 7 houses for sale say they are allowed.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">New communities here keep adding rentals. <a href="#townhouses" style="color:var(--navy);text-decoration:underline">Eight townhouses in one of them</a> show why we run today's rent against your price.</p><div class="c3w-money"><p class="c3-place-price">The middle house here sold for about $380,000 and the middle condo for about $155,000.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Little%20River">Get rentals for sale in Little River<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></div></section><section style="background:var(--ivory-2)" id="carolina-forest"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="11. Carolina Forest">11. Carolina Forest: a yearly-lease area with almost no flood zone</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Under 1 percent of <a href="/submarkets/carolina-forest/" style="color:var(--navy);text-decoration:underline">Carolina Forest</a> homes sit in FEMA's high-risk flood zone, the lowest share of the eleven areas. Census figures put what tenants pay at about $1,670 a month at the middle, more than in Conway, Socastee or Myrtle Beach.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/invest-where-to-buy/carolina-forest-houses-and-woods-from-above-1200w.webp" srcset="/images/2026-11-a/invest-where-to-buy/carolina-forest-houses-and-woods-from-above-600w.webp 600w, /images/2026-11-a/invest-where-to-buy/carolina-forest-houses-and-woods-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Aerial photo of a subdivision of houses on cul-de-sac streets in Carolina Forest, with ponds, thick woods around it and cleared land on the right" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo, 2023. License: Public domain" title="License: Public domain">U.S. government aerial photo, 2023</a></span></div><figcaption>Houses on streets that end in cul-de-sacs in Carolina Forest, with woods around them and land being cleared for more on the right.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Carolina Forest is outside the towns, so zoning puts no limit on nightly rentals. Even so, this is a yearly-lease market: none of the houses for sale here is listed for nightly stays. A subdivision's recorded rules can bar them, so we read those rules for each house.</p><div class="c3w-money"><p class="c3-place-price">The middle house here sold for about $440,000.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Carolina%20Forest">Get rentals for sale in Carolina Forest<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></div></section><section style="background:var(--ivory)" id="side-by-side"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Side by side">How do the eleven areas compare?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Inland, a year's rent is a bigger share of a house's price. In the six beach areas, houses cost more for the same rent, so a yearly lease earns less there. That is where nightly rentals are allowed.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="A year of rent, as a share of the middle house price"><span class="cap" aria-hidden="true">A year of rent, as a share of the middle house price</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Area, middle house price</span><span role="columnheader">a year's rent, share of price</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">7. Longs</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">houses about $300,000</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">9.1%</span></span></div><div role="row"><span role="rowheader"><span class="n">8. Socastee</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">houses about $300,000</span></span><span role="cell"><span class="b" style="--f:0.824" aria-hidden="true"></span><span class="v">7.5%</span></span></div><div role="row"><span role="rowheader"><span class="n">9. Conway</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">houses about $271,000</span></span><span role="cell"><span class="b" style="--f:0.791" aria-hidden="true"></span><span class="v">7.2%</span></span></div><div role="row"><span role="rowheader"><span class="n">10. Little River</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">houses about $380,000</span></span><span role="cell"><span class="b" style="--f:0.725" aria-hidden="true"></span><span class="v">6.6%</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">3. Garden City</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">houses about $406,000</span></span><span role="cell"><span class="b" style="--f:0.681" aria-hidden="true"></span><span class="v">6.2%</span></span></div><div role="row"><span role="rowheader"><span class="n">11. Carolina Forest</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">houses about $440,000</span></span><span role="cell"><span class="b" style="--f:0.67" aria-hidden="true"></span><span class="v">6.1%</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">4. Murrells Inlet</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">houses about $610,000</span></span><span role="cell"><span class="b" style="--f:0.451" aria-hidden="true"></span><span class="v">4.1%</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">1. North Myrtle Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">houses about $565,000</span></span><span role="cell"><span class="b" style="--f:0.44" aria-hidden="true"></span><span class="v">4.0%</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">6. Myrtle Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">houses about $535,000</span></span><span role="cell"><span class="b" style="--f:0.429" aria-hidden="true"></span><span class="v">3.9%</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">5. Pawleys Island and Litchfield</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">houses about $650,000</span></span><span role="cell"><span class="b" style="--f:0.385" aria-hidden="true"></span><span class="v">3.5%</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">2. Surfside Beach</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">houses about $705,000</span></span><span role="cell"><span class="b" style="--f:0.363" aria-hidden="true"></span><span class="v">3.3%</span></span></div></div></div><figcaption>Grey bars: the six beach areas, numbered 1 to 6. The rent is HUD's rent for a standard 3-bedroom in the area's main ZIP code, which counts the utilities a tenant pays. The price is the middle house sale in the year to September 2026: resales in Horry County, every recorded sale in Georgetown County.</figcaption></figure><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Picked an area? Get its homes with the numbers</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us the area, your budget and how you will rent. An agent sends back homes for sale there with the rent, the tax and the nightly rule checked.</p><a class="btn btn-brass" href="/contact/">Send my budget</a></div></div></section><section style="background:var(--ivory-2)" id="worked-example"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Worked example">What does a rental leave, by the year inland and by the night at the beach?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Take two homes at the same price, about $300,000. After the tax and the HOA fee, the Longs house leased by the year keeps more of its price than the condo rented by the night.</p><div class="c3w-ex"><div><h3>A house in Longs, leased by the year</h3><p class="s">At the middle house price</p><dl><dt>A year of HUD's 3-bedroom rent</dt><dd>$27,240</dd><dt>Tax at the rental rate</dt><dd>minus $3,600</dd><dt>HOA fee, about $100 a month</dt><dd>minus $1,200</dd><dt class="t">Left each year</dt><dd class="t">about $22,400</dd><dt>Share of the price</dt><dd>about 7.5%</dd></dl></div><div><h3>A condo in North Myrtle Beach, rented by the night</h3><p class="s">At the middle condo price</p><dl><dt>What the average nightly rental took in, rental data for North Myrtle Beach</dt><dd>about $34,400</dd><dt>Tax at the rental rate</dt><dd>minus $4,000</dd><dt>Condo fee, about $700 a month</dt><dd>minus $8,400</dd><dt class="t">Left each year</dt><dd class="t">about $22,000</dd><dt>Share of the price</dt><dd>about 7.3%</dd></dl></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Both are before insurance, repairs and any loan. The condo also pays for cleaning, management, utilities and furniture. Its income is a rental-data company's estimate of the average Airbnb listing in its North Myrtle Beach area, houses and condos of every size, not this condo's. HUD's rent counts the utilities a tenant pays, so the rent you collect on the house is lower.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Flood insurance is one of those costs. In the past year, a federal flood policy on a house cost about $3,300 a year at the middle on the oceanfront, where the flood map expects waves. In the rest of the high-risk zone at the beach, it cost about $1,400. Inland, it was about $1,000 in the high-risk zone. Outside it, a policy cost about $600, at the beach and inland alike.</p></div></section><section style="background:var(--ivory)" id="townhouses"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The townhouses">Why do we run the rent against your price?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We price a rental against the rent it will get now, not against what earlier buyers paid. An agent now on our team learned why in Little River. He helped buyers purchase about eight nearly identical townhouses in a new community there. Each rented for a little over $2,000 a month.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The sale price rose from about $230,000 for the first to about $292,000 for the last, over about a year and a half. The rent stayed the same, so the later buyers lost the cash flow. Before you offer, we put today's rent against your price.</p></div></section><section style="background:var(--ivory-2)" id="the-tax"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The tax">What does the tax on a rental cost in each area?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">South Carolina taxes the home you live in on 4 percent of its value, and a rental or second home on 6 percent. Only the home you live in skips the school operating tax. Outside city limits, a rental's tax bill is about 3.3 times a resident's on the same house; in the towns it differs.</p><div style="overflow-x:auto;margin:1.2rem 0;max-width:760px"><table style="width:100%;border-collapse:collapse;font-size:.92rem"><thead><tr><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Where the home is</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Tax a year on each $100,000 of price</th></tr></thead><tbody><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Most homes outside the towns in Horry County: Longs, Socastee, Carolina Forest, Little River</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$1,206</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Garden City</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$1,244</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Surfside Beach</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$1,285</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">North Myrtle Beach</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$1,327</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Pawleys Island and Litchfield (Georgetown County's current estimate)</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$1,423</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Murrells Inlet, Georgetown County side (current estimate)</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$1,512</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Myrtle Beach</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$1,528</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Conway</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$1,635</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">These figures are before fees, and they tax the full price. A buyer who claims South Carolina's 25 percent exemption on a sale's new value pays less. <a href="/invest/run-the-numbers/" style="color:var(--navy);text-decoration:underline">We run the numbers</a> for the address you pick.</p></div></section><section style="background:var(--ivory)" id="rule-changes"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Rule changes">Will the rules change?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Two bills in the state legislature would set a state rule. One would bar cities and counties from banning short-term rentals, and the other would expressly allow them to. Neither has left committee.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">North Myrtle Beach's council has held workshops and public sessions on new rules. The city's page lists no new rule. Before an offer, we read the current rule and the HOA's recorded rules for the address.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For a rental of one to three months, each area has its own rule:</p><ul class="c3w-month"><li>Myrtle Beach counts any stay under 90 days as short-term, so it needs a marked zone.</li><li>In Conway, the same rule as for a nightly rental: one of three business districts.</li><li>Surfside Beach's code leaves it open, so we ask the town first.</li><li>In Georgetown County's resort zone, a stay may last up to 30 days.</li><li>Outside the towns in Horry County, zoning puts no limit.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">South Carolina's lodging tax applies to stays of less than 90 days in a row, unless the home is rented fewer than 15 days in a year. No state law bans nightly rentals.</p></div></section><section style="background:var(--ivory-2)" id="what-we-check"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What we check">What do we check before you offer?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A house works for your plan only if five things line up. We check each one for the address:</p><ul class="c3w-check" role="list"><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span><strong>The nightly rule for the address:</strong> the town's zone or district, or in Georgetown County the zoning district.</span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span><span><strong>The HOA's recorded rules and papers:</strong> many communities here ban renting a house out at all. We filter those out, and we read the papers for any rule that would block your plan.</span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 15V5a2 2 0 0 0-2-2M15 15V5a2 2 0 0 0-2-2M9 7h6M9 11h6M2 18c1.7 1.2 3.3 1.2 5 0s3.3-1.2 5 0 3.3 1.2 5 0 3.3-1.2 5 0M2 21.5c1.7 1.2 3.3 1.2 5 0s3.3-1.2 5 0 3.3 1.2 5 0 3.3-1.2 5 0"/></svg></span><span><strong>The building's own rental rules,</strong> for a condo.</span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 11.5 12 4.5l8 7M6.5 10v4.5M17.5 10v4.5M2 17c1.7 1.2 3.3 1.2 5 0s3.3-1.2 5 0 3.3 1.2 5 0 3.3-1.2 5 0M2 20.5c1.7 1.2 3.3 1.2 5 0s3.3-1.2 5 0 3.3 1.2 5 0 3.3-1.2 5 0"/></svg></span><span><strong>The flood zone for the address,</strong> and what the flood insurance costs there.</span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h8l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v4h4M9 17l6-6"/><circle cx="9.5" cy="11.5" r="1"/><circle cx="14.5" cy="16.5" r="1"/></svg></span><span><strong>The tax at the rental rate on your price,</strong> in the tax district the home is in.</span></li></ul><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Homes with the numbers, for your budget and plan</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us your budget and whether you will rent by the night, the month or the year. We send back homes for sale in the areas that fit. Each comes with the rent, the tax at the rental rate, the HOA fee and the nightly rule checked.</p><a class="btn btn-brass" href="/contact/">Send my budget</a></div></div></section><section style="background:var(--ivory)" id="where-to-buy-a-rental-questions"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Where to buy a rental: questions</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Where are Airbnbs legal in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the City of Myrtle Beach, only in the zones the city marks for them. Most neighborhoods of houses are zoned against any stay of less than 90 days. About three in four condos in the city are in a marked zone. North Myrtle Beach has no special zoning step for them, and Surfside Beach allows them in two districts.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is Myrtle Beach a good place to buy a rental property?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For a yearly lease, the inland areas earn more rent for the price. A year's rent is about 9.1 percent of a house's price in Longs, against about 3.9 percent in Myrtle Beach. For a nightly rental, buy at the beach, where the rules for the address allow it.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">North Myrtle Beach or Myrtle Beach for a rental?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For a nightly rental, North Myrtle Beach asks only for a license, the lodging taxes and its everyday rules. Myrtle Beach allows it only in marked zones, where most of its condos are. Nightly rentals took in more a year on average in North Myrtle Beach. The middle condo sold for about $300,000 in North Myrtle Beach and about $175,000 in Myrtle Beach.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is Murrells Inlet in Horry or Georgetown County?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Both. The county line runs through Murrells Inlet. The Census area of that name, which this page counts, lies in Georgetown County. Georgetown County requires no business license, and its resort district allows a house to be rented for stays of up to 30 days.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What is the property tax on a rental in Horry County?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Outside the towns, most homes pay about $1,206 a year on each $100,000 of price at the rental rate, before fees. Inside the towns it is higher, and highest in Conway.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Where is the cheapest place to buy a rental near Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Conway for a house, at about $271,000 at the middle in the past year's recorded sales, and Little River for a condo, at about $155,000.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.scstatehouse.gov/code/t12c036.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-36</a>, <a href="https://www.scstatehouse.gov/code/t12c043.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-43</a>, <a href="https://www.cityofmyrtlebeach.com/news_detail_T6_R1468.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Myrtle Beach</a>, <a href="https://www.nmb.us/833/Short-term-Rentals" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">North Myrtle Beach</a>, <a href="https://library.municode.com/sc/surfside_beach" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Surfside code</a>, <a href="https://www.conwaysc.gov/Current%20UDO%20(7.20.26).pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Conway UDO</a>, <a href="https://www.horrycountysc.gov/media/i0pfcm2o/appendix-b-zoning-ordinance-upated-912026.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry zoning</a>, <a href="https://www.horrycountysc.gov/media/monjnvh0/sales-tax-chart-short-term-rentals.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry rental tax</a>, <a href="https://www.gtcountysc.gov/DocumentCenter/View/261" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Georgetown zoning</a>, <a href="https://www.gtcountysc.gov/Faq.aspx?QID=116" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Georgetown license</a>, <a href="https://www.townofpawleysisland.com/beach-renourishment-faqs/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Pawleys Island</a>, <a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/3861.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">H.3861</a>, <a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/442.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">S.442</a>, <a href="https://www.horrycountysc.gov/media/kufln4qp/tax-levy-2026_2.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry levy</a>, <a href="https://www.gtcountysc.gov/385/Property-Tax-Calculator" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Georgetown tax</a>, <a href="https://www.huduser.gov/portal/datasets/fmr/smallarea/index.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">HUD rents</a>, <a href="https://data.census.gov/table/ACSDT5Y2024.B25064" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Census ACS</a>, <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeDocType" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry deeds</a>, <a href="https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry parcels</a>, <a href="https://gis1.georgetowncountysc.org/portal/home/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Georgetown parcels</a>, <a href="https://msc.fema.gov/portal/home" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FEMA maps</a>, <a href="https://www.fema.gov/openfema-data-page/nfip-redacted-policies-v3" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FEMA policies</a>, <a href="https://www.airroi.com/airbnb-data/united-states/south-carolina/north-myrtle-beach" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">AirROI</a>. Not legal advice. Prices are recorded sales, not values. Listing counts: our feed. Nightly income: AirROI's average per listing.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Condo towers and beach houses on the same oceanfront block in North Myrtle Beach. Photo: U.S. Geological Survey, <a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://doi.org/10.5066/F7N877XX" target="_blank" rel="noopener noreferrer">U.S. Geological Survey</a>.</div><div role="listitem">The pier and rows of raised beach houses in Surfside Beach. Photo: U.S. Geological Survey, <a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://doi.org/10.5066/F7N877XX" target="_blank" rel="noopener noreferrer">U.S. Geological Survey</a>.</div><div role="listitem">Condo buildings and houses on the strip between the ocean and the marsh at Garden City. Photo: U.S. Geological Survey, <a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://doi.org/10.5066/F7N877XX" target="_blank" rel="noopener noreferrer">U.S. Geological Survey</a>.</div><div role="listitem">A subdivision on the Georgetown County side of Murrells Inlet, with older houses on larger wooded lots below it. U.S. government aerial photo, 2023, by the USDA Farm Service Agency, <a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://imagery.nationalmap.gov/arcgis/rest/services/USGSNAIPImagery/ImageServer" target="_blank" rel="noopener noreferrer">The National Map (USGS)</a>.</div><div role="listitem">Beach houses and low condo buildings at Litchfield Beach, with docks across the marsh. Photo: U.S. Geological Survey, <a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://doi.org/10.5066/F7N877XX" target="_blank" rel="noopener noreferrer">U.S. Geological Survey</a>.</div><div role="listitem">Oceanfront towers in Myrtle Beach. Photo: U.S. Geological Survey, <a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://doi.org/10.5066/F7N877XX" target="_blank" rel="noopener noreferrer">U.S. Geological Survey</a>.</div><div role="listitem">A new subdivision going up beside farm fields in Longs: streets and ponds dug, some houses built or framed, and most lots still empty. U.S. government aerial photo, 2023, by the USDA Farm Service Agency, <a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://imagery.nationalmap.gov/arcgis/rest/services/USGSNAIPImagery/ImageServer" target="_blank" rel="noopener noreferrer">The National Map (USGS)</a>.</div><div role="listitem">A subdivision of similar houses around a pond in Socastee, with older houses on wooded lots across the road and a highway bridge on the right. U.S. government aerial photo, 2023, by the USDA Farm Service Agency, <a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://imagery.nationalmap.gov/arcgis/rest/services/USGSNAIPImagery/ImageServer" target="_blank" rel="noopener noreferrer">The National Map (USGS)</a>.</div><div role="listitem">The riverwalk boardwalk past old wooden warehouses in downtown Conway. Photo: Pubdog, <a href="https://commons.wikimedia.org/wiki/Template:PD-self" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://commons.wikimedia.org/wiki/File:Waccamaw_River_Warehouse_Historic_District_Jun_10.JPG" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>.</div><div role="lis