+</style><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);letter-spacing:.01em;color:#fff;text-align:right;background:radial-gradient(farthest-side at 100% 100%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.c3ph-cr a{color:#fff;text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);text-underline-offset:2px;pointer-events:auto;padding:10px 0 6px}.c3ph-hero{margin:1.6rem 0 2rem}.c3ph-hero .c3ph-f{border-radius:8px}.c3ph-hero img{aspect-ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}.c3ph-gal{display:grid;grid-template-columns:minmax(0,1fr);gap:1.5rem;margin:1.6rem 0;padding:0;list-style:none}.c3ph-gal>figure{margin:0;min-width:0}.c3ph-gal img{aspect-ratio:var(--c3ph-r,4/3)}.c3ph-gal figcaption{color:var(--muted);font-size:.85rem;line-height:1.45;margin-top:.5rem}@media (min-width:700px){.c3ph-gal{display:grid;grid-template-columns:repeat(var(--c3ph-n,3),minmax(0,1fr));gap:1rem;overflow:visible;padding:0}.c3ph-gal>figure{min-width:0}}@media (max-width:699px){.c3ph-gal.c3ph-row{display:flex;gap:.75rem;padding:0 var(--c3ph-bleed,1.4rem) .4rem;margin:1.6rem calc(-1*var(--c3ph-bleed,1.4rem)) 0;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding:0 var(--c3ph-bleed,1.4rem);-webkit-overflow-scrolling:touch;scrollbar-width:none}.c3ph-row::-webkit-scrollbar{display:none}.c3ph-row>figure{flex:0 0 82%;scroll-snap-align:start}}.c3ph-swipe{display:flex;align-items:center;gap:.75rem;margin:.5rem 0 1.6rem;color:var(--navy);font:500 .95rem/1.3 var(--sans)}.c3ph-dots{display:inline-flex;gap:.45rem}.c3ph-dots i{display:block;width:10px;height:10px;border-radius:50%;border:1.5px solid var(--navy);box-sizing:border-box}.c3ph-dots i:first-child{background:var(--navy)}@supports (animation-timeline:view()){.c3ph-rowbox{timeline-scope:--c3ph-p1,--c3ph-p2,--c3ph-p3}.c3ph-row>figure:nth-child(1){view-timeline:--c3ph-p1 inline}.c3ph-row>figure:nth-child(2){view-timeline:--c3ph-p2 inline}.c3ph-row>figure:nth-child(3){view-timeline:--c3ph-p3 inline}.c3ph-dots i{animation:c3ph-dot linear both;animation-range:cover}.c3ph-dots i:nth-child(1){animation-timeline:--c3ph-p1}.c3ph-dots i:nth-child(2){animation-timeline:--c3ph-p2}.c3ph-dots i:nth-child(3){animation-timeline:--c3ph-p3}@keyframes c3ph-dot{0%,36%{background:transparent}42%,60%{background:var(--navy)}66%,100%{background:transparent}}}@media (min-width:700px){.c3ph-swipe{display:none}}.c3ph-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:1.4rem 0 1.8rem;padding:0;list-style:none}@media (min-width:700px){.c3ph-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}}@media (min-width:1000px){.c3ph-cards.c3ph-4{grid-template-columns:repeat(4,minmax(0,1fr))}}.c3ph-card{margin:0;background:var(--ivory);border:1px solid var(--rule);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}.c3ph-card .c3ph-f{border-radius:0}.c3ph-card img,.c3ph-card svg{display:block;width:100%;height:auto;aspect-ratio:var(--c3ph-r,4/3);object-fit:cover}.c3ph-card .c3ph-cr{font-size:.56rem;padding:1.2rem .45rem .25rem 1.6rem}.c3ph-card strong{display:block;color:var(--navy);font-size:.98rem;font-weight:500;line-height:1.3;padding:.7rem .8rem 0}.c3ph-card span.c3ph-t{display:block;color:var(--muted);font-size:.86rem;line-height:1.45;padding:.2rem .8rem .85rem}.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:760px}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Cities and counties decide where a short-term rental may go, through zoning. Under state law, a county or city with a comprehensive plan can adopt a <a href="https://www.scstatehouse.gov/code/t06c029.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">zoning ordinance</a>. It governs "the use of buildings, structures, and land." The legislature decides the taxes.</p><div class="c3s-whowrap"><table class="c3s-who"><caption>Who decides each short-term rental rule</caption><thead><tr><th scope="col">Rule</th><th scope="col">Who decides</th><th scope="col">What it says now</th></tr></thead><tbody><tr><th scope="row">Where a short-term rental may operate</th><td data-label="Who decides">Each city, and the county outside the cities</td><td data-label="What it says now">Myrtle Beach bars them in most residential zones. North Myrtle Beach asks only for a license.</td></tr><tr><th scope="row">A ban on local bans</th><td data-label="Who decides">The legislature</td><td data-label="What it says now">None. H. 3861 would have made one.</td></tr><tr><th scope="row">State tax on the rent</th><td data-label="Who decides">The legislature</td><td data-label="What it says now">7% of the rent, with three exceptions</td></tr><tr><th scope="row">Local accommodations tax</th><td data-label="Who decides">City and county councils</td><td data-label="What it says now">Up to 3%</td></tr><tr><th scope="row">Business license</th><td data-label="Who decides">Each city and the county</td><td data-label="What it says now">Every rental in Myrtle Beach and North Myrtle Beach needs one</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We checked the state code's chapters on local government, zoning and property and sales tax for a limit on local bans under another name, and found none. The one rule on rental websites asks them to post a notice about local licensing.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Election day changed none of these local rules. Horry County, Myrtle Beach, North Myrtle Beach and Surfside Beach had no question on the Nov. 3 ballot.</p></div></section><section style="background:var(--ivory)" id="myrtle-beach"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Myrtle Beach">What are Myrtle Beach's short-term rental rules?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Myrtle Beach keeps short-term rentals out of most of its residential neighborhoods. In the city, a short-term rental is a stay of under 90 days.</p><ul style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem"><strong>Residential zones.</strong> <a href="https://cityofmyrtlebeach.com/news_detail_T6_R1468.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">No zone that begins with R</a> allows them, except RMV (Residential Multifamily Visitor). Most traditional neighborhoods are in R zones.</li><li style="margin-bottom:.5rem"><strong>Grandfathered houses.</strong> Fewer than 30 houses in those zones, citywide, can keep renting short-term under the old rules.</li><li style="margin-bottom:.5rem"><strong>License and fines.</strong> Every rental needs a city business license. A violation can bring a fine of up to $500, 30 days in jail, or both, on conviction.</li></ul><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-e/short-term-rental-rules-statehouse/myrtle-beach-oceanfront-towers-1200w.webp" srcset="/images/2026-11-e/short-term-rental-rules-statehouse/myrtle-beach-oceanfront-towers-600w.webp 600w, /images/2026-11-e/short-term-rental-rules-statehouse/myrtle-beach-oceanfront-towers-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="600" alt="A row of hotel and condo towers along the beach in Myrtle Beach under a clear sky" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: Loadmaster. License: CC BY-SA 3.0" title="License: CC BY-SA 3.0">Photo: Loadmaster</a></span></div><figcaption>Hotel and condo towers on the oceanfront in Myrtle Beach.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The city added one more rule in December 2024. City council voted unanimously for a <a href="https://www.wmbfnews.com/2024/12/10/myrtle-beach-city-leaders-move-forward-with-short-term-rental-overlay-with-modifications" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">conversion overlay</a> on commercial districts east of Kings Highway, on the ocean side. Under it, short-term rentals there may not convert to long-term rentals. It took effect at once, and a temporary moratorium was set to expire.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Two kinds of units are exempt from the overlay. One is a unit that already has a long-term rental license. The other is a former primary residence or second home that was never rented.</p></div></section><section style="background:var(--ivory-2)" id="north-myrtle-beach"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="North Myrtle Beach and the rest">What are the rules in North Myrtle Beach, Surfside Beach and the rest of Horry County?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">North Myrtle Beach allows short-term rentals with a <a href="https://nmb.us/833/Short-term-Rentals" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">city business license</a>, renewed every year. The city requires no special zoning or permit beyond the license. Each rental collects accommodations tax for the city, the county and the state.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Surfside Beach and Horry County, outside the cities, each decide their own rules too. Our agents check the zone of any Surfside Beach or county address with the town or county before you make an offer. Our <a href="/invest/str-rules/" style="color:var(--navy);text-decoration:underline">short-term rental rules guide</a> lists the rules town by town on the Grand Strand.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Want to buy a rental?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We show you rentals in the zones where short stays are allowed, in Myrtle Beach, North Myrtle Beach and Surfside Beach.</p><a class="btn btn-brass" href="/contact/">Have us find you your next investment</a></div></div></section><section style="background:var(--ivory)" id="accommodations-tax"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Accommodations tax">How much tax does a Grand Strand short-term rental collect, and who decides it?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The state charges <a href="https://www.scstatehouse.gov/code/t12c036.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">7% of the rent</a> on rooms and homes rented to short-stay guests. A city or county can add a <a href="https://www.scstatehouse.gov/code/t06c001.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">local accommodations tax</a> of up to 3%. A county may not charge more than 1.5% inside a city unless the city agrees.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Three kinds of rentals owe no state accommodations tax:</p><ul style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem">Renting fewer than six rooms in the home you live in.</li><li style="margin-bottom:.5rem">A home rented out for 14 days or fewer in a year, the <a href="/invest/14-day-rule/" style="color:var(--navy);text-decoration:underline">14-day rule</a> in federal tax law.</li><li style="margin-bottom:.5rem">A stay of 90 days or more in a row by the same guest.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Both rates are in state law, so the legislature can change them with an ordinary bill. Our <a href="/invest/accommodations-tax/" style="color:var(--navy);text-decoration:underline">accommodations tax guide</a> gives the full rate for each Grand Strand city and county.</p></div></section><section style="background:var(--ivory-2)" id="h-3861"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What H. 3861 would have done">What would H. 3861 have done to Myrtle Beach's rules?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/3861.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">H. 3861</a> said no city or county may make or enforce a rule that bans renting a home to short-term guests. Myrtle Beach could no longer have kept stays of fewer than 29 days out of its R zones.</p><ul style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem"><strong>What counts as short-term.</strong> The bill applies to stays of fewer than 29 days in a row. Myrtle Beach's rule applies to stays under 90 days. A stay of 29 to 89 days would still have been the city's to rule on.</li><li style="margin-bottom:.5rem"><strong>The penalty.</strong> A city or county that kept a ban could not collect tax at the 6% ratio on "qualifying property," in the bill's words. The State Treasurer would also hold back its state aid until it repealed the ban.</li><li style="margin-bottom:.5rem"><strong>Who filed it.</strong> Reps. Hewitt, Bailey, Brewer, Murphy and Bannister. Rep. William Bailey represents Horry County's District 104.</li><li style="margin-bottom:.5rem"><strong>What happened to it.</strong> It was introduced in January 2025 and sent to the House Medical, Military, Public and Municipal Affairs Committee. We checked the bill's record: the committee never voted on it.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A rental is taxed on 6% of its value, and a home you live in on 4%. Our page on the <a href="/invest/rental-property-tax-cut/" style="color:var(--navy);text-decoration:underline">proposed rental property tax cut</a> shows what it costs on a Myrtle Beach rental.</p></div></section><section style="background:var(--ivory)" id="the-votes"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The votes it would need">Could the new South Carolina House pass a bill like H. 3861?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. If all 124 members vote, it would take 63 House votes, the same as in the old House. A bill like H. 3861 is an ordinary bill. It does not need two-thirds. Each house must <a href="https://www.scstatehouse.gov/scconstitution/A03.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">read it three times</a>, on three separate days, and pass it. In the House, a tie fails.</p><figure class="c3s-seats"><div role="img" aria-label="South Carolina House seats by party. Before the election: 89 Republicans and 35 Democrats. After, in the unofficial count: 79 Republicans and 45 Democrats. A bill needs 63 votes and a veto override 83 if all 124 members vote."><span class="cap">South Carolina House, 124 seats</span><div class="c3s-ticks" aria-hidden="true"><span style="left:50.81%">63</span><span style="left:66.94%">83</span></div><div class="c3s-row"><div class="lbl"><b>Before the election</b><span>89 Republicans, 35 Democrats</span></div><div class="c3s-track" aria-hidden="true"><span class="r" style="width:71.77%"></span><span class="d" style="width:28.23%"></span><span class="c3s-mark" style="left:50.81%"></span><span class="c3s-mark" style="left:66.94%"></span></div></div><div class="c3s-row"><div class="lbl"><b>After, unofficial count</b><span>79 Republicans, 45 Democrats</span></div><div class="c3s-track" aria-hidden="true"><span class="r" style="width:63.71%"></span><span class="d" style="width:36.29%"></span><span class="c3s-mark" style="left:50.81%"></span><span class="c3s-mark" style="left:66.94%"></span></div></div></div><ul class="c3s-key"><li style="--c:#2a3040">Republican seats</li><li style="--c:#d4b48f">Democratic seats</li><li style="--c:#c4783a">63: the yes votes a bill needs if all 124 members vote. 83: the votes to override a veto.</li></ul></figure><ul style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem"><strong>The House.</strong> In the unofficial count, Republicans led in 79 races and Democrats in 45. Before the election it had 89 Republicans and 35 Democrats.</li><li style="margin-bottom:.5rem"><strong>The Senate.</strong> It was not on the ballot except for one special race. It still has 34 Republicans and 12 Democrats.</li><li style="margin-bottom:.5rem"><strong>The recounts.</strong> Two House races were within 1 point and qualify for an automatic recount. If one recount changed the result, Republicans would hold 78 or 80 seats. If both did, they would hold 79. Each is more than 63 and fewer than 83.</li></ul><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What changed: the votes to override a veto</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">After a governor's <a href="https://www.scstatehouse.gov/scconstitution/A04.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">veto</a>, two-thirds of each house must vote again to pass the bill. If all members vote, that is 83 in the House and 31 in the Senate.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Republicans held 89 House seats before, enough to override alone. With 79, a House override would need some Democratic votes.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What did the candidates say about short-term rentals?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Nothing we found. Alan Wilson won the governor's race after Jermaine Johnson conceded. We checked Wilson's priorities page and found no short-term rental item, and we found no statement from Johnson. Annie Andrews, the AP's winner of the U.S. Senate race, has none on her issue pages, and state zoning is not a federal vote.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Of the 11 House districts on Horry County's ballot, Republicans led in 8 and Democrats in 3. Rep. Bailey, a sponsor of H. 3861, won District 104 with 66.88% in the unofficial count. Our <a href="/market-reports/2026-election/" style="color:var(--navy);text-decoration:underline">2026 election guide</a> has every result that matters for a home here.</p></div></section><section style="background:var(--ivory-2)" id="other-states"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Arizona and Florida">What happened when Arizona's and Florida's legislatures took this power from cities?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Both legislatures took away the power to ban. Arizona later changed its law. Florida's legislature passed a change in 2024, and the governor vetoed it. In order:</p><ol class="c3s-time" aria-label="What other states did, and what South Carolina did"><li><b class="y">2016</b><strong>Arizona bars local bans</strong><a href="https://www.azleg.gov/legtext/52leg/2R/laws/0208.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SB 1350</a>: "A city or town may not prohibit vacation rentals or short-term rentals."</li><li><b class="y">2022</b><strong>Arizona gives cities some rules back</strong><a href="https://www.azleg.gov/ars/9/00500-39.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SB 1168</a> kept the ban on bans. Cities can now require a permit, with a fee of no more than $250 or the cost, whichever is less. They can also require an emergency contact, notice to neighbors, and liability coverage of $500,000, which the booking platform's coverage can meet. They can suspend a permit for repeat violations.</li><li><b class="y">2024</b><strong>Florida's governor vetoes a vacation rental bill</strong>The <a href="https://flgov.com/eog/news/press/2024/governor-ron-desantis-vetoes-one-bill-0" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">bill, CS/SB 280</a>, would have made platforms collect and pay the taxes and moved licensing to the state.</li><li><b class="y">2025</b><strong>South Carolina's H. 3861 is introduced</strong>It never left committee.</li><li><b class="y">Now</b><strong>Florida keeps its older local rules</strong><a href="http://www.leg.state.fl.us/statutes/index.cfm?App_mode=Display_Statute&URL=0500-0599/0509/Sections/0509.032.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Florida law today</a> says local governments may not ban vacation rentals or limit how long or how often they are rented. Local rules adopted on or before June 1, 2011 still stand.</li></ol><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In Arizona, cities lost the power to ban in 2016. Six years later the legislature let them require permits, contacts and insurance. In Florida, local rules from before the cutoff still stand. We found no study that measured what either change did to home prices or rents.</p></div></section><section style="background:var(--ivory)" id="prices"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Prices and rents">Do short-term rental limits change home prices and rents?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the one peer-reviewed study we found, by a small amount. In Los Angeles County, 18 of 88 cities adopted home-sharing rules. <a href="https://ideas.repec.org/a/eee/juecon/v124y2021ics0094119021000383.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">The study</a>, in the Journal of Urban Economics in 2021, measured what followed in those cities:</p><div class="c3s-stats" role="list" aria-label="What local limits did in Los Angeles County"><div role="listitem"><b>18 of 88</b>cities adopted limits</div><div role="listitem"><b>50% fewer</b>short-term listings</div><div role="listitem"><b>About 2%</b>lower home prices</div><div role="listitem"><b>About 2%</b>lower rents</div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Myrtle Beach is a different market, and a state law like H. 3861 would work in the other direction, opening zones instead of closing them. The study shows how large the effect was there. It is not a forecast for the Grand Strand.</p></div></section><section style="background:var(--ivory-2)" id="what-could-happen"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Short run and long run">What could happen to Grand Strand short-term rentals in the next two years, and after five?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Three paths, each from a past example. None is a forecast of what the new legislature will pass.</p><div class="c3s-cards"><div class="c3s-card"><h3>No new state law</h3><p><b>Where it happened:</b> H. 3861 got no committee vote in 2025 and 2026.</p><p><b>Next two years:</b> Myrtle Beach's R-zone rule, its overlay and North Myrtle Beach's license rule stay as they are.</p><p><b>After five:</b> any change comes from a city or county council vote.</p></div><div class="c3s-card"><h3>A ban on local bans</h3><p><b>Where it happened:</b> Arizona in 2016, and the H. 3861 text.</p><p><b>Next two years:</b> Myrtle Beach could not enforce its R-zone rule on stays under 29 days. Reading the Los Angeles study in reverse, prices and rents in those zones could rise by up to about 2%, or not at all. That is our inference, not a forecast.</p><p><b>After five:</b> in Arizona, six years later, the legislature let cities require permits, emergency contacts and insurance.</p></div><div class="c3s-card"><h3>A law that keeps older local rules</h3><p><b>Where it happened:</b> Florida. Its law keeps local rules adopted on or before June 1, 2011.</p><p><b>Next two years:</b> a cutoff like Florida's keeps the local rules adopted before it. Myrtle Beach's R-zone rule could stay if it came before the cutoff, and new local bans would be barred.</p><p><b>After five:</b> in Florida, the legislature passed a bill moving licensing to the state in 2024, and the governor vetoed it.</p></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Any new law needs the same steps first. A bill is filed and usually passes a committee. It wins 63 House votes if all 124 members vote, then a Senate majority. Then the governor signs it or lets it become law without a signature.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If all members vote, a veto would then need 83 House votes and 31 Senate votes to override.</p></div></section><section style="background:var(--ivory)" id="what-we-do"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What we do">What does Chapter3 do for a short-term rental buyer while the rules stay local?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We check the rules for the one address before you make an offer. In Myrtle Beach that means the zone and whether the house is one of the fewer than 30 grandfathered houses. For a condo, it also means whether the building is in the overlay. In North Myrtle Beach and Surfside Beach it means the license and the zone.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We price a rental on the rules in force on the day you buy.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Looking at a short-term rental here?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us the address or the area. We check its zone and license and show you rentals where short stays are allowed.</p><a class="btn btn-brass" href="/contact/">Talk to a specialized agent</a></div></div></section><section style="background:var(--ivory-2)" id="short-term-rental-rule-questions"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Short-term rental rule questions</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can Myrtle Beach ban short-term rentals?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. No South Carolina law stops a city from barring them through zoning. Myrtle Beach bars stays of under 90 days in every zone that begins with R, except RMV. Fewer than 30 houses citywide are grandfathered.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Did the 2026 election change short-term rental rules on the Grand Strand?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. Horry County, Myrtle Beach, North Myrtle Beach and Surfside Beach had no local ballot question. No state law on the subject passed. The rules change only by a council vote or a new state law.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What was H. 3861?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A 2025 South Carolina House bill that would have barred cities and counties from banning short-term rentals of fewer than 29 days. A government that kept a ban would have lost its state aid. It never got a committee vote.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How much tax does a short-term rental pay in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The state charges 7% of the rent. A city or county may add up to 3%. Rentals of 90 days or more to the same guest owe no accommodations tax.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What did Alan Wilson say about short-term rentals?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Nothing we found. His priorities page has no short-term rental item. As governor he could sign or veto a bill on the subject.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/3861.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">H. 3861</a>, <a href="https://cityofmyrtlebeach.com/news_detail_T6_R1468.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Myrtle Beach rules</a>, <a href="https://nmb.us/833/Short-term-Rentals" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">North Myrtle Beach rules</a>, <a href="https://www.wmbfnews.com/2024/12/10/myrtle-beach-city-leaders-move-forward-with-short-term-rental-overlay-with-modifications" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">WMBF on the overlay</a>, <a href="https://www.scstatehouse.gov/code/t06c029.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">S.C. Code 6-29-720</a>, <a href="https://www.scstatehouse.gov/code/t12c036.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">12-36-920</a>, <a href="https://www.scstatehouse.gov/code/t06c001.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">6-1-520</a>, <a href="https://www.scstatehouse.gov/scconstitution/A03.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Constitution Art. III</a>, <a href="https://www.scstatehouse.gov/scconstitution/A04.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Art. IV</a>, <a href="https://www.scstatehouse.gov/man26/35_Rules-House.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">House Rules</a>, <a href="https://scvotes.gov/2026-general-election-results/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC election results</a>, <a href="https://www.azleg.gov/legtext/52leg/2R/laws/0208.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Arizona SB 1350</a>, <a href="https://www.azleg.gov/ars/9/00500-39.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">A.R.S. 9-500.39</a>, <a href="http://www.leg.state.fl.us/statutes/index.cfm?App_mode=Display_Statute&URL=0500-0599/0509/Sections/0509.032.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Fla. Stat. 509.032</a>, <a href="https://flgov.com/eog/news/press/2024/governor-ron-desantis-vetoes-one-bill-0" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Florida veto</a>, <a href="https://ideas.repec.org/a/eee/juecon/v124y2021ics0094119021000383.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Koster et al. 2021</a>. Election results are the unofficial count until certified. Not legal or tax advice.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Hotel and condo towers on the oceanfront in Myrtle Beach. Photo: Loadmaster (David R. Tribble), <a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 3.0</a>, via <a href="https://commons.wikimedia.org/wiki/File:Atlantic_Ocean_shoreline_in_Myrtle_Beach,_South_Carolina.jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>.</div><div role="listitem">Chapter3 Realty cropped and resized this photo.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-11-e/short-term-rental-rules-statehouse/myrtle-beach-oceanfront-towers-1200w.webp","url":"https://chapter3realty.com/images/2026-11-e/short-term-rental-rules-statehouse/myrtle-beach-oceanfront-towers-1200w.webp","width":1200,"height":600,"encodingFormat":"image/webp","name":"Hotel and condo towers on the oceanfront in Myrtle Beach","caption":"Hotel and condo towers on the oceanfront in Myrtle Beach.","description":"A row of hotel and condo towers along the beach in Myrtle Beach under a clear sky","creator":{"@type":"Person","name":"Loadmaster (David R. Tribble)"},"creditText":"Loadmaster (David R","copyrightNotice":"© Loadmaster (David R. Tribble), CC BY-SA 3.0","license":"https://creativecommons.org/licenses/by-sa/3.0/","acquireLicensePage":"https://commons.wikimedia.org/wiki/File:Atlantic_Ocean_shoreline_in_Myrtle_Beach,_South_Carolina.jpg","isBasedOn":"https://commons.wikimedia.org/wiki/File:Atlantic_Ocean_shoreline_in_Myrtle_Beach,_South_Carolina.jpg","contentLocation":{"@type":"Place","name":"Oceanfront, Myrtle Beach, South Carolina"}}]}</script></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Buying a short-term rental on the Grand Strand?</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">We check the zone, the license and the grandfathered status of the rental you want. We also find rentals where short stays are allowed.</p><a class="btn btn-brass btn-lg" href="/contact/">Have us find you your next investment</a></div></section></main>
