+    "unincorporated": { "name": "Unincorporated Horry County, county fire district", "parts": ["county", "school_debt", "school_operation", "county_fire_district", "fire_apparatus"], "total": 192.9, "ledger": "F148; the 8.1-mill waste levy is left out because which parcels pay it is not confirmed" }
