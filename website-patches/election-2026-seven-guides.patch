);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">County record date</th></tr></thead><tbody><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Sayebrook East (Surfside)</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">3,040</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">0</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">3,040</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">February 2019</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Pine Ridge (Burgess)</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">2,506 by zoning, capped at 2,000 by the August 2026 agreement</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">0</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">up to 2,000</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">The agreement</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Sayebrook West (Surfside)</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">1,880</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">217</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">1,663</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">August 2026</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Palmetto Ranch (Longs)</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">1,292</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">0</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">1,292</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">February 2019</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Collins Tract (Conway South)</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">898, rezoning case filed 2026</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">0</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">898</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">August 2026</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Auberon Woods (Bear Bluff)</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">1,188</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">351</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">837</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">July 2026</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Tupelo Bay Golf Villas (Garden City)</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">800</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">180</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">620</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">August 2026</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">