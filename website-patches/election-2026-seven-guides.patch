 <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How much is the HOA fee in Del Webb at Grande Dunes?","acceptedAnswer":{"@type":"Answer","text":"The HOA fee is about $400 a month for a house and about $445 a month for a villa."}},{"@type":"Question","name":"Is there golf at Grande Dunes?","acceptedAnswer":{"@type":"Answer","text":"Yes, two 18-hole courses. The Grande Dunes Resort Club sells tee times online. The Grande Dunes Members Club is a private club for members and their guests, with its own membership apart from the Ocean Club."}},{"@type":"Question","name":"Is there pickleball in Del Webb at Grande Dunes?","acceptedAnswer":{"@type":"Answer","text":"Yes. The neighborhood has its own courts for pickleball, tennis and bocce, beside the clubhouse, for owners to use."}},{"@type":"Question","name":"What is a villa in Del Webb at Grande Dunes?","acceptedAnswer":{"@type":"Answer","text":"A villa is a home that shares one wall with another home. Villas usually sell for less than the houses here."}},{"@type":"Question","name":"Do you need flood insurance in Del Webb at Grande Dunes?","acceptedAnswer":{"@type":"Answer","text":"Probably not. The homes are outside the high-risk flood zone. If you want a policy, it usually costs about $550 a year."}}]}</script>
