From 132d78bdd01ae0affb1010aecd3a2958ce9c1a5d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 28 Oct 2026 03:45:43 +0000
Subject: [PATCH] Static files skip the site code (_routes.json): images,
 scripts, styles, fonts and icons no longer count as Functions requests, which
 ran the account past Cloudflare's 100,000 a day; the filter list is asked for
 again 2 minutes after a failure, not 10

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012hytMouaajg3aWuepm8WSU
---
 chapter3realty/_routes.json | 23 +++++++++++++++++++++++
 idx-lib/catalog.js          |  4 ++--
 2 files changed, 25 insertions(+), 2 deletions(-)
 create mode 100644 chapter3realty/_routes.json

diff --git a/chapter3realty/_routes.json b/chapter3realty/_routes.json
new file mode 100644
index 00000000..47da3a2a
--- /dev/null
+++ b/chapter3realty/_routes.json
@@ -0,0 +1,23 @@
+{
+  "version": 1,
+  "include": ["/*"],
+  "exclude": [
+    "/assets/*",
+    "/images/*",
+    "/media/*",
+    "/favicon.ico",
+    "/favicon-32.png",
+    "/favicon-512.png",
+    "/apple-touch-icon.png",
+    "/icon-192.png",
+    "/icon-512.png",
+    "/og-image.jpg",
+    "/popup.mp4",
+    "/popup-green.mp4",
+    "/popup-poster.jpg",
+    "/site.webmanifest",
+    "/llms.txt",
+    "/llms-full.txt",
+    "/100285c38d874e7992b8bfc0b1d868a1.txt"
+  ]
+}
diff --git a/idx-lib/catalog.js b/idx-lib/catalog.js
index 964fb3a5..f7c9defa 100644
--- a/idx-lib/catalog.js
+++ b/idx-lib/catalog.js
@@ -10,7 +10,7 @@ import { useCatalog, isDistance } from "./features.js";
 const HOUR = 3600 * 1000;
 let memo = null; // { at, list }
 let pending = null;
-let failedAt = 0; // after a failure, no new try for 10 minutes: a page never waits on a list that is down
+let failedAt = 0; // after a failure, no new try for 2 minutes: a page never waits long on a list that is down
 
 /** The words the filter panel uses for the CRM's groups, in the panel's order. */
 export const GROUP_NAME = { water: "Water and boats", place: "Beach and places nearby", outside: "Outside", inside: "Inside",
@@ -29,7 +29,7 @@ function shape(j) {
 /** The list, or null. Never throws. */
 export async function filterCatalog(env, request) {
   if (memo && Date.now() - memo.at < HOUR) return memo.list;
-  if (!pending && Date.now() - failedAt < 10 * 60 * 1000) return memo ? memo.list : null;
+  if (!pending && Date.now() - failedAt < 2 * 60 * 1000) return memo ? memo.list : null;
   if (!pending) pending = (async () => {
     try {
       const r = await crm(env, request, "/api/idx/filters", { anonymous: true, cacheSeconds: 3600, timeoutMs: 4000 });
-- 
2.43.0

