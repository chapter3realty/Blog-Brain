+// Homes for sale: a blue dot for each home the MLS gives a map point (from /homes/api/map).
+// The search bar narrows them with plain words. Nothing from the listing feed is written
+// as HTML: every word goes in with textContent.
+let homeMarks = [];
+async function loadHomes(qs){
+  const count = document.getElementById('homes-count');
+  try{
+    const r = await fetch('/homes/api/map?' + qs, { credentials:'same-origin' });
+    if(!r.ok){ count.textContent = ''; return; }
+    const j = await r.json();
+    if(!j.ok){ count.textContent = ''; return; }
+    const { Marker3DInteractiveElement, AltitudeMode } = await google.maps.importLibrary("maps3d");
+    let Pin = null;
+    try{ Pin = (await google.maps.importLibrary("marker")).PinElement; }catch(_){}
+    homeMarks.forEach(m => m.remove()); homeMarks = [];
+    j.pins.forEach(p => {
+      const m = new Marker3DInteractiveElement({ position:{ lat:p.lat, lng:p.lng, altitude:0 }, altitudeMode: AltitudeMode.CLAMP_TO_GROUND, title: p.price + ', ' + p.addr });
+      if(Pin){ try{ m.append(new Pin({ background:'#1a73e8', borderColor:'#ffffff', glyphColor:'#ffffff', scale:0.65 })); }catch(_){} }
+      m.addEventListener('gmp-click', () => showHome(p));
+      map.append(m); homeMarks.push(m);
+    });
+    count.textContent = j.pins.length
+      ? j.pins.length + ' homes on the map' + (j.total > j.pins.length ? ', the newest of ' + j.total.toLocaleString('en-US') : '')
+      : (j.total ? j.total.toLocaleString('en-US') + ' homes match. Map dots arrive when the MLS feed adds each home\'s location.' : 'No homes match. Try a town, a price or bedrooms.');
+  }catch(e){ count.textContent = ''; }
+}
+document.getElementById('homesbar').addEventListener('submit', function(e){
+  e.preventDefault();
+  const v = document.getElementById('homes-q').value.trim();
+  loadHomes(v ? 'q=' + encodeURIComponent(v) : 'near=33.70,-78.92&miles=25');
+});
+function showHome(p){
+  const facts = [p.beds != null ? p.beds + ' bds' : '', p.baths != null ? p.baths + ' ba' : '', p.sqft != null ? p.sqft.toLocaleString('en-US') + ' sqft' : ''].filter(Boolean).join(' | ');
+  document.querySelector('#card .eyebrow').textContent = p.tag || p.status || 'For sale';
+  document.getElementById('c-name').textContent = p.price;
+  document.getElementById('c-desc').textContent = (facts ? facts + '. ' : '') + p.addr;
+  document.getElementById('c-price').textContent = 'MLS #' + p.mls + ', ' + p.firm + '. Listing provided by CCMLS.';
+  const link = document.getElementById('c-link');
+  link.href = p.url; link.textContent = 'See this home'; link.style.display = 'inline-block';
+  document.getElementById('card').style.display = 'block';
+}
 function showCard(area){
+  document.querySelector('#card .eyebrow').textContent = 'Area';
+  document.getElementById('c-link').textContent = 'See the full report';
