diff --git a/chapter3realty/assets/app.8e7fe83324.css b/chapter3realty/assets/app.8e7fe83324.css
index aa7ed7f..d04d811 100644
--- a/chapter3realty/assets/app.8e7fe83324.css
+++ b/chapter3realty/assets/app.8e7fe83324.css
@@ -218,3 +218,71 @@ svg text[fill="var(--brass)"]{fill:var(--brass-ink)}
    homepage cream with the old .12 tint, 4.6 or more with .07. */
 .idx-eyebrow,.idx-soon{color:var(--brass-ink)!important}
 .idx-soon{background:rgba(196,120,58,.07)!important}
+
+/* ---- Reading size, line length, links and tap targets (Blog-Brain, 2026-10-11) -----------
+   Measured on the live branch before this block, at 390 and 1280: article text 17px with a
+   1.75 line height, about 75 characters a line on a desktop and up to 117 where a paragraph
+   had no width; brass links in text with no underline; footer links 17 to 20px tall; the
+   header's phone icon 24px wide. The Blog-Brain playbook ("Page design for readers and
+   search") asks for 18px text on phones, 19 to 20px on a desktop, a line height near 1.6,
+   50 to 75 characters a line, underlined links and 44px tap targets.
+   Text colour does not change here: since the owner's creme ground of 2026-10-02 article
+   text is the ink, #1c2028, 15.4:1 on #fbf8f2 and 14.2:1 on #f4efe5.
+   Type and links are scoped to body:not(.home), so the homepage keeps its own type. */
+
+/* rem follows the reader's own browser text size. At the default 16px it is still 17px. */
+html{font-size:106.25%}
+
+/* 1. Article text: 18px on phones, 19.5px from 900px, line height 1.6, lines of about 65
+   characters. The width is 34em, not 65ch: in DM Sans 1ch is the width of a zero, 0.66em,
+   so 65ch measured 92 characters a line.
+   The selectors are the inline styles that tools/mkpage.js and the hand-built pages use for
+   prose. Cards, labels, tables and small print set their own font-size and keep it. */
+body:not(.home) main{--read:1.0625rem}
+@media (min-width:900px){body:not(.home) main{--read:1.15rem}}
+body:not(.home) main p[style*="color:var(--muted);line-height:1.7"]:not([style*="font-size"]),
+body:not(.home) main :is(ul,ol)[style*="color:var(--muted);line-height:1.75"]:not([style*="font-size"]),
+body:not(.home) main ul:not([style*="font-size"])>li[style*="color:var(--muted);line-height:1."],
+body:not(.home) .detail-main p,
+body:not(.home) main .accordion-a{font-size:var(--read)!important;line-height:1.6!important}
+body:not(.home) main p[style*="color:var(--muted);line-height:1.7"][style*="max-width"],
+body:not(.home) main :is(ul,ol)[style*="color:var(--muted);line-height:1.75"][style*="max-width"],
+body:not(.home) .detail-main p,
+body:not(.home) main .accordion-a{max-width:34em!important}
+/* Headings keep their lead over the larger text. A heading with no line height of its own
+   had 1, so a two-line question heading touched itself. */
+body:not(.home) main section h2{line-height:1.25}
+body:not(.home) main section h3{line-height:1.3}
+@media (min-width:900px){body:not(.home) main section h3[style*="font-size:1.2"]{font-size:1.35rem!important}}
+/* Tables 17px (were 15.6px), captions 16px (were 14.5px). */
+body:not(.home) main table[style*="font-size:.92rem"]{font-size:1rem!important}
+body:not(.home) main figcaption{font-size:.95rem!important;line-height:1.5!important}
+/* A link to a section ("On this page") lands below the sticky header, not under it. */
+body:not(.home) main section[id]{scroll-margin-top:9.5rem}
+@media (min-width:769px){body:not(.home) main section[id]{scroll-margin-top:6.5rem}}
+
+/* 2. Links in text are underlined. Their colour is already set above: brass ink on light
+   grounds (5.0 to 5.4:1), brass-2 on navy (5.8:1), navy where the page sets it (14:1). */
+body:not(.home) main :is(p,li,td,dd,figcaption) a:not(.btn):not([style*="border-bottom"]){text-decoration-line:underline!important;text-decoration-thickness:1px;text-underline-offset:.18em}
+
+/* 3. FAQ answers are open text under question headings. Eight hand-built pages used closed
+   <details> boxes; their questions are now H3s (the generator already wrote H3s). */
+h3.accordion-q{display:block;cursor:auto;user-select:text;font-size:1.25rem;line-height:1.3;padding:1.4rem 0 .6rem}
+h3.accordion-q::after{content:none}
+
+/* 4. Tap targets: 44 by 44px on phones and touch screens (WCAG 2.5.5). */
+body:not(.home) .btn{min-height:44px}
+a.skip-link{padding:.75rem 1rem}
+@media (max-width:900px),(pointer:coarse){
+  header .header-ctas a.hdr-phone{min-width:44px;min-height:44px;justify-content:center}
+  header .burger{min-width:44px;min-height:44px}
+  .hdr-callbar{padding:0 .75rem!important}
+  .hdr-callbar a{display:block;padding:.8rem 0;line-height:1.4;min-height:44px}
+  /* Breadcrumb links: a 44px hit area that does not move the line. */
+  .breadcrumb a{padding:13px 3px;margin:-13px -3px}
+  footer .footer-links{gap:0}
+  footer .footer-legal-links{row-gap:0}
+  footer .footer-links a,footer .footer-legal-links a,footer .footer-socials a,footer .footer-address a{display:inline-flex;align-items:center;min-height:44px;min-width:44px}
+}
+/* Two columns of footer links on a phone, so the taller rows do not make it longer. */
+@media (max-width:600px){footer .footer-links{display:grid;grid-template-columns:1fr 1fr;column-gap:1rem}}
