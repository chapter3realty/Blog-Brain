+<script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"When was the Palace Resort in Myrtle Beach built?","acceptedAnswer":{"@type":"Answer","text":"The Palace Resort was built in the mid-1980s, so the tower is about 40 years old."}},{"@type":"Question","name":"How tall is the Palace Resort?","acceptedAnswer":{"@type":"Answer","text":"The Palace Resort stands 241 feet tall. No floor is numbered 13: unit numbers run on floors 1 to 12 and 14 to 23."}},{"@type":"Question","name":"Is the Palace a hotel or condos?","acceptedAnswer":{"@type":"Answer","text":"Both. Its 298 condos are owned one by one, and the resort's own rental program rents many of them to guests by the night."}},{"@type":"Question","name":"Is the water park free at the Palace Resort?","acceptedAnswer":{"@type":"Answer","text":"For the first two guests of each reservation booked through the Palace's own rental program, yes, every day of the stay, in season. Other guests in the room can buy a pass."}},{"@type":"Question","name":"Is the Palace Resort pet friendly?","acceptedAnswer":{"@type":"Answer","text":"Guests may not bring pets; registered service animals are not counted as pets. An owner's own pet rules are in the condo's founding documents, and we read them before you offer."}},{"@type":"Question","name":"What is the address of the Palace Resort?","acceptedAnswer":{"@type":"Answer","text":"The Palace Resort is at 1605 S Ocean Blvd, Myrtle Beach, SC 29577, on the south end of the city's oceanfront."}},{"@type":"Question","name":"How many Palace Resort condos are for sale?","acceptedAnswer":{"@type":"Answer","text":"On November 13, 2026, 25 Palace Resort condos were for sale: 10 studios, 7 one-bedrooms and 8 two-bedrooms."}}]}</script>
