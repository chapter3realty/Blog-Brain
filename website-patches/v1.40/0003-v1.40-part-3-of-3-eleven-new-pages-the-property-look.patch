{"@type":"Place","name":"The Market Common, Myrtle Beach, South Carolina"},"representativeOfPage":true}]}</script></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Ready to look at The Market Common?</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">Tell us the kind of home and your budget. We pick out the houses and townhomes that fit, each with its HOA fee and flood zone.</p><a class="btn btn-brass btn-lg" href="/contact/?place=The%20Market%20Common">Send us your wish list</a></div></section></main>
