t":"USDA Farm Service Agency, NAIP, public domain, via The National Map (USGS)","copyrightNotice":"Public domain (USDA Farm Service Agency, NAIP)","license":"https://www.fsa.usda.gov/help/policies-and-links/","acquireLicensePage":"https://imagery.nationalmap.gov/arcgis/rest/services/USGSNAIPImagery/ImageServer","isBasedOn":"https://imagery.nationalmap.gov/arcgis/rest/services/USGSNAIPImagery/ImageServer","contentLocation":{"@type":"Place","name":"South Waccamaw Drive near Garden City Point, Georgetown County, Garden City Beach, South Carolina"},"representativeOfPage":true}]}</script></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Before you offer on a Garden City home, we check four things.</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">Which county it is in, what its HOA or condo papers say about renting, its flood zone and the building's flood policy, and its tax bill as a rental or as your main home.</p><a class="btn btn-brass btn-lg" href="/contact/?place=Garden%20City">Ask about a Garden City home</a></div></section></main>
