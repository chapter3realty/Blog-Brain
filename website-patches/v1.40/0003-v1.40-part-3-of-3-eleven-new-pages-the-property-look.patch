i{animation:c3ph-dot linear both;animation-range:cover}.c3ph-dots i:nth-child(1){animation-timeline:--c3ph-p1}.c3ph-dots i:nth-child(2){animation-timeline:--c3ph-p2}.c3ph-dots i:nth-child(3){animation-timeline:--c3ph-p3}@keyframes c3ph-dot{0%,36%{background:transparent}42%,60%{background:var(--navy)}66%,100%{background:transparent}}}@media (min-width:700px){.c3ph-swipe{display:none}}.c3ph-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:1.4rem 0 1.8rem;padding:0;list-style:none}@media (min-width:700px){.c3ph-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}}@media (min-width:1000px){.c3ph-cards.c3ph-4{grid-template-columns:repeat(4,minmax(0,1fr))}}.c3ph-card{margin:0;background:var(--ivory);border:1px solid var(--rule);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}.c3ph-card .c3ph-f{border-radius:0}.c3ph-card img,.c3ph-card svg{display:block;width:100%;height:auto;aspect-ratio:var(--c3ph-r,4/3);object-fit:cover}.c3ph-card .c3ph-cr{font-size:.56rem;padding:1.2rem .45rem .25rem 1.6rem}.c3ph-card strong{display:block;color:var(--navy);font-size:.98rem;font-weight:500;line-height:1.3;padding:.7rem .8rem 0}.c3ph-card span.c3ph-t{display:block;color:var(--muted);font-size:.86rem;line-height:1.45;padding:.2rem .8rem .85rem}.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:720px}</style><style>main#main .hx-qs{margin:1rem 0 1.4rem}main#main .hx-strip.hx-qs:empty{display:block!important;height:0;margin:0;overflow:hidden}</style><script>(function(){function fill(s){if(s.getAttribute("data-done"))return;s.setAttribute("data-done","1");fetch("/homes/api/strip?"+s.getAttribute("data-q"),{credentials:"same-origin"}).then(function(r){return r.ok?r.json():null}).then(function(j){if(!j||!j.ok||!j.html||j.html.indexOf("hx-s-empty")>-1)return;var hd=document.createElement("p");hd.className="hx-s-head";var b=document.createElement("b");b.textContent=s.getAttribute("data-head");hd.appendChild(b);if(j.link&&j.link.charAt(0)==="/"){var a=document.createElement("a");a.href=j.link;a.textContent="See all";hd.appendChild(a)}var row=document.createElement("div");row.className="hx-s-row";row.innerHTML=j.html;s.appendChild(hd);s.appendChild(row);if(j.note){var n=document.createElement("p");n.className="hx-s-note";n.textContent=j.note;s.insertBefore(n,row)}}).catch(function(){})}function go(){var all=[].slice.call(document.querySelectorAll(".hx-qs[data-q]"));if(!("IntersectionObserver" in window)){all.forEach(fill);return}var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){io.unobserve(e.target);fill(e.target)}})},{rootMargin:"600px 0px"});all.forEach(function(s){io.observe(s)})}if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",go);else go()})();</script><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not reliably. We put every Horry County home for sale in our home search on FEMA's flood map, by its map pin. About 1 in 6 has its pin in the high-risk flood zone.</p><figure class="c3-gchart fz-chart"><span class="cap">Of 1,122 homes for sale in the high-risk flood zone, 231 came up under our flood zone filter</span><svg class="fz-n" viewBox="0 0 300 135" role="img" aria-label="Bar chart. Of 1,122 Horry County homes for sale in FEMA's high-risk flood zone, 891 did not come up when our home search filtered for flood zone, and 231 did."><text x="0" y="15.0" font-size="15" font-weight="600" fill="#1c2028">Did not come up under flood zone</text><rect x="0" y="23.3" width="300" height="29" rx="14.5" fill="#1c2028" fill-opacity=".07"/><rect x="0" y="23.3" width="238.2" height="29" rx="14.5" fill="#c4783a"/><text x="228.2" y="43.1" font-size="15" font-weight="700" text-anchor="end" fill="#fff">891 homes</text><text x="0" y="89.0" font-size="15" font-weight="600" fill="#1c2028">Came up under flood zone</text><rect x="0" y="97.3" width="300" height="29" rx="14.5" fill="#1c2028" fill-opacity=".07"/><rect x="0" y="97.3" width="61.8" height="29" rx="14.5" fill="#5c6b78"/><text x="69.8" y="117.2" font-size="15" font-weight="700" text-anchor="start" fill="#1c2028">231 homes</text></svg><svg class="fz-w" viewBox="0 0 600 142" role="img" aria-label="Bar chart. Of 1,122 Horry County homes for sale in FEMA's high-risk flood zone, 891 did not come up when our home search filtered for flood zone, and 231 did."><text x="0" y="16.0" font-size="16" font-weight="600" fill="#1c2028">Did not come up under flood zone</text><rect x="0" y="24.8" width="600" height="30" rx="15.0" fill="#1c2028" fill-opacity=".07"/><rect x="0" y="24.8" width="476.5" height="30" rx="15.0" fill="#c4783a"/><text x="466.5" y="45.6" font-size="16" font-weight="700" text-anchor="end" fill="#fff">891 homes</text><text x="0" y="94.0" font-size="16" font-weight="600" fill="#1c2028">Came up under flood zone</text><rect x="0" y="102.8" width="600" height="30" rx="15.0" fill="#1c2028" fill-opacity=".07"/><rect x="0" y="102.8" width="123.5" height="30" rx="15.0" fill="#5c6b78"/><text x="113.5" y="123.6" font-size="16" font-weight="700" text-anchor="end" fill="#fff">231 homes</text></svg><figcaption>Horry County homes for sale in our home search whose map pin is inside FEMA's high-risk flood zone, counted on November 13, 2026.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our home search finds a home under "Flood zone" only when the data that comes with the home says so. FEMA's map is the official answer for the zone. The gap shows up across the market:</p><ul class="fz-facts"><li><strong>Condos.</strong> About 3 in 4 of the high-risk homes for sale are condos. A condo building also has its own flood policy, explained in our <a href="/hoa/master-insurance-ho6/" style="color:var(--navy);text-decoration:underline">guide to condo master insurance</a>.</li><li><strong>The wave zone.</strong> 108 homes for sale are in zone VE, FEMA's coastal zone where storm waves are expected. About 4 in 5 of them did not come up.</li><li><strong>Every price.</strong> At every price, fewer than 3 in 10 of the high-risk homes for sale came up. At $1 million and up, 45 of 59 did not.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The mismatch goes both ways. Of the 397 homes that came up under flood zone, 166 have a map pin outside FEMA's high-risk zone.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Like a house? We will check its flood zone before you offer.</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We read FEMA's map for the address, look for an elevation certificate and get a flood insurance quote.</p><a class="btn btn-brass" href="/contact/">Have us check this house's flood zone</a></div></div></section><section style="background:var(--ivory)" id="how-to-check"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Three steps to check an address</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Three steps give you the zone, FEMA's own answer and a copy to keep:</p><ol style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem"><strong>Type the address into our free <a href="/buyers/property-records/" style="color:var(--navy);text-decoration:underline">property records search</a>.</strong> It reads FEMA's flood map at the address, then names the zone and what it means.</li><li style="margin-bottom:.5rem"><strong>Check it on FEMA's <a href="https://msc.fema.gov/portal/home" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Flood Map Service Center</a>.</strong> Type the same address and read the zone letter at the house. The table below says what each letter means.</li><li style="margin-bottom:.5rem"><strong>Download or print the map.</strong> FEMA updates its maps, so a copy you print today can be replaced by a newer one.</li></ol><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Check each address, not the town. One town can hold both kinds of zone.</p><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/buyers/no-hoa/crescent-beach-streets-from-the-ocean-2011-1200w.webp" srcset="/images/buyers/no-hoa/crescent-beach-streets-from-the-ocean-2011-600w.webp 600w, /images/buyers/no-hoa/crescent-beach-streets-from-the-ocean-2011-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="782" alt="Streets of two-story beach houses among trees behind the oceanfront at Crescent Beach in North Myrtle Beach, seen from a plane over the ocean" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: U.S. Geological Survey. License: Public domain" title="License: Public domain">Photo: U.S. Geological Survey</a></span></div><figcaption>Crescent Beach in North Myrtle Beach, seen from over the ocean: buildings on the beach, then streets of houses. About 1 in 3 homes for sale with a North Myrtle Beach address is in FEMA's high-risk flood zone, and the rest are not.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Horry County's own parcel map has a Flood Zones layer with FEMA's codes. Our <a href="/buyers/property-records/gis-map/" style="color:var(--navy);text-decoration:underline">guide to the Horry County GIS map</a> shows where it is.</p></div></section><section style="background:var(--ivory-2)" id="zone-letters"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">What does my flood zone mean?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Each zone letter stands for a level of flood risk. In the high-risk zones, a mortgage from a bank needs flood insurance on the building.</p><div class="fz-tabwrap"><table class="fz-tab"><caption>What each flood zone letter in Horry County means</caption><thead><tr><th scope="col">Zone</th><th scope="col">What it means</th><th scope="col">Does a bank loan need flood insurance?</th></tr></thead><tbody><tr><th scope="row">VE</th><td><span class="l">What it means</span>High risk, on the coast, where storm waves are expected</td><td><span class="l">Bank loan needs flood insurance?</span>Yes</td></tr><tr><th scope="row">AE or A</th><td><span class="l">What it means</span>High risk: a 1 percent or greater chance of a flood each year</td><td><span class="l">Bank loan needs flood insurance?</span>Yes</td></tr><tr><th scope="row">Shaded X</th><td><span class="l">What it means</span>Moderate risk: a 0.2 percent chance of a flood each year</td><td><span class="l">Bank loan needs flood insurance?</span>No federal rule. Some lenders still ask.</td></tr><tr><th scope="row">X</th><td><span class="l">What it means</span>Minimal flood risk</td><td><span class="l">Bank loan needs flood insurance?</span>No federal rule. Some lenders still ask.</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A 1 percent chance of a flood each year adds up to a 1 in 4 chance or more over 30 years.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">What flood insurance costs here is in our <a href="/buyers/coastal-insurance/" style="color:var(--navy);text-decoration:underline">guide to coastal insurance in Myrtle Beach</a>. For a house on the water, our <a href="/buyers/waterfront-homes/" style="color:var(--navy);text-decoration:underline">waterfront homes guide</a> shows where zone VE reaches.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Some houses are built up off the ground, on pilings. The homes below are listed that way.</p><div class="hx-strip hx-qs" data-q="has=raised_home" data-head="Homes raised on pilings"></div></div></section><section style="background:var(--ivory)" id="lender"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">When will the lender tell me the house is in a flood zone?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If the house is in the high-risk zone, a regulated lender must tell you in writing, a reasonable time before the loan closes.</p><ul class="fz-facts"><li><strong>The wait for a policy.</strong> A National Flood Insurance Program policy bought while the mortgage is made starts with no wait. Most others wait 30 days.</li><li><strong>Before you offer.</strong> Get the zone and a flood insurance quote, so the cost is part of the price you offer.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Whether the house has flooded before is a separate question. Our guide to <a href="/buyers/undisclosed-flooding/" style="color:var(--navy);text-decoration:underline">finding out if a house has flooded</a> covers it.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Send us the address. We get the flood quote before you offer.</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We find the house's flood zone and get a flood insurance quote before you sign a contract.</p><a class="btn btn-brass" href="/contact/">Get a flood zone check and quote</a></div></div></section><section style="background:var(--ivory-2)" id="elevation-certificate"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Does the house have an elevation certificate?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">An elevation certificate records how high a building's lowest floor is, measured from sea level.</p><ul class="fz-facts"><li><strong>Why you want one.</strong> FEMA's flood insurance site says an elevation certificate is not required to buy flood insurance, but it can help you pay less.</li><li><strong>When the rules require one.</strong> A building built or substantially improved in the high-risk zone must have its lowest floor height on record. Federal rules name the elevation certificate as that proof.</li><li><strong>Where to find one.</strong> Horry County posts the signed elevation certificates it has on file, by year and permit number: about 1,700 from 2010 to 2025. They are listed by permit, not by address, and an older house may have none.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We look for the certificate when you send us an address. For the other things we look at before an offer, see our list of <a href="/buyers/common-mistakes/" style="color:var(--navy);text-decoration:underline">common buyer mistakes in Myrtle Beach</a>.</p></div></section><section style="background:var(--ivory)" id="flood-zone-check-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Flood zone check FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is there a Horry County flood map PDF?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. FEMA's Flood Map Service Center lets you download or print the official flood map for any address in the county.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How new is Horry County's flood map?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The countywide map took effect in December 2021. FEMA has revised four small areas of it since, most recently in September 2026.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does Zone X mean I do not need flood insurance?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No federal rule makes you buy it in Zone X, but some lenders still ask. FEMA recommends flood insurance even where a lender does not require it.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I use private flood insurance for the loan?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, if the policy meets the federal rule. Under federal law, a lender must accept private flood insurance that does. A private policy has its own wait before it starts.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does a cash buyer get the flood zone notice?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. The written notice comes from a lender with the loan, so a cash buyer gets none.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://msc.fema.gov/portal/home" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FEMA Map Service Center</a>, <a href="https://hazards.fema.gov/arcgis/rest/services/public/NFHL/MapServer" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FEMA flood map data</a>, <a href="https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer/19" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County flood zones</a>, <a href="https://www.ecfr.gov/current/title-44/section-59.1" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">44 CFR 59.1</a>, <a href="https://www.ecfr.gov/current/title-44/section-60.3" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">60.3</a>, <a href="https://www.ecfr.gov/current/title-44/section-64.3" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">64.3</a>, <a href="https://www.law.cornell.edu/uscode/text/42/4012a" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">42 U.S.C. 4012a</a>, <a href="https://www.law.cornell.edu/uscode/text/42/4104a" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">4104a</a>, <a href="https://www.ecfr.gov/current/title-12/section-22.9" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">12 CFR 22.9</a>, <a href="https://www.floodsmart.gov/get-insured/buy-a-policy" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FloodSmart</a>, <a href="https://www.floodsmart.gov/flood-insurance-cost" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">costs</a>, <a href="https://horrycountysc.gov/departments/emergency-management/flooding/elevation-certificates/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County elevation certificates</a>. Our count: CCMLS homes for sale in our home search, in aggregate, each map pin on the county's copy of FEMA's map, on November 13, 2026. It matched FEMA's live map at 80 of 80 sampled pins. Georgetown County is left out. Not legal or insurance advice.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Pho