rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:720px}</style><p class="dd-btn"><a class="dd-go" href="https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeName" target="_blank" rel="noopener">Open the Horry County deed search<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a></p><p class="dd-go-note">The search belongs to the Horry County Register of Deeds. Chapter3 is a real estate brokerage, not the county.</p><ol class="dd-steps c"><li><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><div><h3>Open the search and accept the county's terms.</h3><p>Click "I accept the conditions above." You then search as a guest, with no account and no fee.</p></div></li><li><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span><div><h3>Choose Name, and type the last name first.</h3><p>Type SMITH JOHN for John Smith. Use at least 3 letters, and click Search.</p></div></li><li><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 5h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM3 10h18M8 3v4M16 3v4M8 14h.01M12 14h.01M16 14h.01M8 17.5h.01M12 17.5h.01"/></svg></span><div><h3>Read the list, then click a row.</h3><p>Each row is one paper under that name. Click it for the date, the kind of paper, both names, the book and page, and the price. It also gives a short description of the land.</p></div></li></ol><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">The deed itself is not online.</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the address. We pull the deed, the plat, any liens and the HOA papers for you, free.</p><a class="btn btn-brass" href="/contact/">Send us the address</a></div><p class="dd-quiet">Looking for lot lines on a map? See our <a href="/buyers/property-records/gis-map/" style="color:var(--navy);text-decoration:underline">Horry County GIS map guide</a>. Pawleys Island or Litchfield? Use <a href="#georgetown" style="color:var(--navy);text-decoration:underline">Georgetown County's deed search</a>. Every county record in one place: <a href="/buyers/property-records/" style="color:var(--navy);text-decoration:underline">Horry County property records</a>.</p><nav class="dd-toc" aria-label="On this page"><p>On this page</p><ul><li><a href="#search">How to search</a></li><li><a href="#free">Is it free?</a></li><li><a href="#copy">Get a copy</a></li><li><a href="#by-name">By name</a></li><li><a href="#by-address">By address</a></li><li><a href="#book-page">Book and page</a></li><li><a href="#liens">Liens and plats</a></li><li><a href="#read">Read a deed</a></li><li><a href="#how-far-back">How far back</a></li><li><a href="#fraud-alert">Fraud alert</a></li><li><a href="#georgetown">Georgetown County</a></li><li><a href="#office">Office and fees</a></li><li><a href="#deed-search-faq">Deed search FAQ</a></li></ul></nav></div></section><section style="background:var(--ivory)" id="free"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Is it free?">Are Horry County land records free?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. Searching the Horry County deed index costs nothing and needs no account. The county charges only for copies and for recording a paper.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The index is online, but the documents are not. Horry County does not show images of recorded documents on the internet. You view and print them at the public viewing area at 1301 Second Avenue in Conway.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/hoa-liens-and-foreclosure/horry-government-justice-center-1200w.webp" srcset="/images/2026-11-a/hoa-liens-and-foreclosure/horry-government-justice-center-600w.webp 600w, /images/2026-11-a/hoa-liens-and-foreclosure/horry-government-justice-center-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="675" alt="The Horry County Government and Justice Center in Conway: brick wings on each side of a white columned entrance, seen across the parking lot" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: Pollinator at English Wikipedia. License: CC BY-SA 3.0" title="License: CC BY-SA 3.0">Photo: Pollinator at English Wikipedia</a></span></div><figcaption>The Horry County Government and Justice Center at 1301 Second Avenue in Conway. The Register of Deeds' public viewing area, where the documents are read and printed, is in this building.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The free search still tells you a lot. It shows that a paper exists, when it was recorded, who signed it, where it is filed and what land it covers.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The county also has an app called "Land Records". It is a parcel map, not the deed search, and it asks you to sign in with a county account. Our <a href="/buyers/property-records/gis-map/" style="color:var(--navy);text-decoration:underline">GIS map guide</a> shows how to use it.</p></div></section><section style="background:var(--ivory-2)" id="copy"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Get a copy">How do I get a copy of my deed in Horry County?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You can get a copy of a Horry County deed three ways: at the <a href="#office" style="color:var(--navy);text-decoration:underline">office in Conway</a>, by mail, or through us.</p><ul class="dd-list"><li><strong>At the office.</strong> View and print the deed in the public viewing area.</li><li><strong>By mail.</strong> Send the county's <a href="https://www.horrycountysc.gov/media/t3wpam13/customer-service-request-form.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">copy request form</a> with a check or money order to the Register of Deeds, PO Box 470, Conway, SC 29528. A deed is $8 for the first 4 pages.</li><li><strong>Through us.</strong> Free, by email, from the address alone.</li></ul><table class="dd-t2"><caption style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">What a copy costs at the Horry County Register of Deeds</caption><thead><tr><th scope="col">Copy</th><th scope="col">Cost</th></tr></thead><tbody><tr><th scope="row">At the office, on the copy machine</th><td>50 cents a page</td></tr><tr><th scope="row">At the office, copied by staff</th><td>$1 a page</td></tr><tr><th scope="row">By mail, a deed or other document</th><td>$8 for the first 4 pages, then $1 a page</td></tr><tr><th scope="row">By mail, a plat</th><td>$5 small (up to 11 by 17), $10 large (24 by 36)</td></tr><tr><th scope="row">At the office, a plat</th><td>$2 a page up to 11 by 17; $10 large, $15 in color</td></tr><tr><th scope="row">To certify a copy</th><td>$2 more</td></tr></tbody></table><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The index shows the number of pages for each paper, so you know the cost before you mail the form.</p></div></section><section style="background:var(--ivory)" id="by-name"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="By name">How do I search Horry County deeds by name?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Choose Name in the Horry County deed search, type the last name first, then the first name, and click Search. These are the four boxes that matter.</p><figure class="dd-fig"><div class="dd-card dd-form" role="img" aria-label="A drawing of the Horry County Register of Deeds Name search. Field 1, Name, holds SMITH JOHN. Field 2, Show Names, is set to All, with Grantor and Grantee as the other choices. Field 3 holds the From Record Date, 1/1/1984, and the To Record Date. Field 4 is Document Type. A Search button sits at the bottom."><div class="hd"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg><span>Name search</span></div><div class="f"><span class="nb">1</span><span class="l">Name</span><span><span class="box">SMITH JOHN</span></span></div><div class="f"><span class="nb">2</span><span class="l">Show Names</span><span class="opt"><span class="on">All</span><span>Grantor</span><span>Grantee</span></span></div><div class="f"><span class="nb">3</span><span class="l">From and To Record Date</span><span><span class="box">1/1/1984</span> to <span class="box">today</span></span></div><div class="f"><span class="nb">4</span><span class="l">Document Type</span><span><span class="box">DEEDS, MTG, LIENS, PLATS</span></span></div><div class="go"><span>Search</span></div></div><figcaption>A drawing of the county's Name search, simplified. The real page has a few more boxes.</figcaption></figure><ol class="dd-steps"><li><span class="nb" aria-hidden="true">1</span><div><h3>Name: the last name first, then the first name.</h3><p>Search every spelling too, with and without a middle initial.</p></div></li><li><span class="nb" aria-hidden="true">2</span><div><h3>Show Names: leave it on All.</h3><p>All finds the name on either side of a paper. On a deed, the grantor is the seller and the grantee is the buyer.</p></div></li><li><span class="nb" aria-hidden="true">3</span><div><h3>From and To Record Date: narrow a long list.</h3><p>The form fills in a From date of January 1, 1984, but names reach back to late 1979. For an older deed, set the From date earlier. A shorter range cuts a common name down to a few rows.</p></div></li><li><span class="nb" aria-hidden="true">4</span><div><h3>Document Type: pick one kind of paper.</h3><p>The four groups are deeds, mortgages, liens and plats. The <a href="#liens" style="color:var(--navy);text-decoration:underline">table below</a> names the exact types to pick.</p></div></li></ol><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A company is searched the same way, by the name on the paper. The index also searches by <a href="#book-page" style="color:var(--navy);text-decoration:underline">book and page</a>, by price range, by recording date and by the <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeComments" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">legal description or memo</a>.</p></div></section><section style="background:var(--ivory-2)" id="by-address"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="By address">Can I search Horry County deeds by address?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Go from the address to the owner's name or the deed's book and page first. A deed's index entry describes the land by its lot and subdivision, so two steps are quicker.</p><ol class="dd-steps"><li><span class="nb" aria-hidden="true">1</span><div><h3>Find the lot on the county's parcel map.</h3><p>On the <a href="/buyers/property-records/gis-map/" style="color:var(--navy);text-decoration:underline">Horry County GIS map</a>, search the address and click the lot. Its card shows the owner and the Deed Book and Deed Page. The map asks you to sign in with a county account.</p></div></li><li><span class="nb" aria-hidden="true">2</span><div><h3>Open the deed.</h3><p>Type the book and page into the <a href="#book-page" style="color:var(--navy);text-decoration:underline">box below</a>, or search the owner's name in the deed search.</p></div></li></ol><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">To see every lot in a subdivision, use the <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeComments" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Legal Description/Memo search</a> and type the subdivision's name. Almost every deed, 999 in 1,000, carries that short description of its lot.</p></div></section><section style="background:var(--ivory)" id="book-page"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Book and page">How do I look up a deed by book and page in Horry County?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Type the deed book and page below, and the county's page for that deed opens. A book and page is printed on the county map's parcel card and in the index entry of every paper.</p><div class="dd-tool" role="group" aria-label="Open a Horry County deed by its book and page"><div class="row"><label for="ddBook">Deed book<input id="ddBook" inputmode="numeric" autocomplete="off" placeholder="Book"></label><label for="ddPage">Page<input id="ddPage" inputmode="numeric" autocomplete="off" placeholder="Page"></label></div><button type="button" class="dd-go" id="ddGo">Open the deed at the county<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></button><p class="msg" id="ddMsg" aria-live="polite">Opens the county's page for that deed book and page in a new tab, with no terms screen.</p></div><script>(function(){function go(){var b=(document.getElementById("ddBook").value||"").replace(/[^0-9]/g,""),p=(document.getElementById("ddPage").value||"").replace(/[^0-9]/g,""),m=document.getElementById("ddMsg");if(!b||!p){m.textContent="Type both numbers: the deed book and the page.";return}window.open("https://acclaimweb.horrycounty.org/AcclaimWeb/details/JumpToBookPage/1/"+b+"/"+p,"_blank","noopener")}document.addEventListener("DOMContentLoaded",function(){var g=document.getElementById("ddGo");if(g)g.addEventListener("click",go);["ddBook","ddPage"].forEach(function(id){var e=document.getElementById(id);if(e)e.addEventListener("keydown",function(ev){if(ev.key==="Enter")go()})})})})();</script><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For a plat, mortgage or lien book, use the county's <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeBookPage" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Book/Page search</a>. Pick the book type there: D for deeds, MTG for mortgages, LN for liens and P for plats.</p></div></section><section style="background:var(--ivory-2)" id="liens"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Liens and plats">How do I find a mortgage, a lien, a plat or an easement in Horry County?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Search the owner's name, then pick the document type. The Horry County index has more than 140 types. These are the ones a buyer or an owner needs.</p><div style="overflow-x:auto;margin:1.2rem 0;max-width:760px"><table style="width:100%;border-collapse:collapse;font-size:.92rem"><thead><tr><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">You want</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Pick this document type</th></tr></thead><tbody><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">A sale or other change of owner</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Pick this document type">DEED (001)</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">A loan against the home</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Pick this document type">MORTGAGE (002)</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Proof a loan was paid off</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Pick this document type">MORTGAGE SATISFACTION (011), or RELEASE - MORTGAGE BOOK (009)</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">A contractor's claim for unpaid work</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Pick this document type">MECHANICS LIEN (015); paid: MECHANICS LIEN SATISFACTION (042)</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><a href="/hoa/liens-and-foreclosure/" style="color:var(--navy);text-decoration:underline">A condo association's claim for dues</a></td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Pick this document type">CONDO LIEN (064); paid: CONDO LIEN SATISFACTION (036)</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">A tax lien</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Pick this document type">TAX LIENS - FEDERAL (093), TAX LIENS - STATE (084)</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><a href="/invest/foreclosures/" style="color:var(--navy);text-decoration:underline">A lawsuit or a foreclosure</a></td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Pick this document type">LIS PENDENS DEED (135), NOTICE OF FORECLOSURE (143)</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">An easement on the land</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Pick this document type">EASEMENT (062)</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><a href="/hoa/documents/" style="color:var(--navy);text-decoration:underline">A neighborhood's rules, or a condo building's master deed</a></td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Pick this document type">RESTRICTIONS (082), MASTER DEED (022)</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">The surveyor's drawing of the lots</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Pick this document type">PLAT - LEGAL SIZE (006), PLAT - OTHER THAN LEGAL SIZE (061), CONDO PLAT (007)</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><a href="/sell/inherited-house/" style="color:var(--navy);text-decoration:underline">An estate or a power of attorney</a></td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Pick this document type">PROBATE FIDUCIARY LETTER (CHARGE) (133), CERTIFICATE OF DEATH (058), POWER OF ATTORNEY (063)</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A paid-off mortgage shows as its own entry under the owner's name. A lis pendens notice says a lawsuit affects the title to the property.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What the deed index does not hold</h3><ul class="dd-list"><li><strong>Court judgments.</strong> The Clerk of Court keeps them. A judgment entered there is a lien on the debtor's land in the county for ten years. The courts' <a href="https://publicindex.sccourts.org/horry/publicindex/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Public Index</a> searches Horry County's cases.</li><li><strong>Property tax.</strong> Whether a home's tax is paid shows on its <a href="/buyers/property-records/tax-bill/" style="color:var(--navy);text-decoration:underline">county tax bill</a>. Our <a href="/buyers/property-taxes/" style="color:var(--navy);text-decoration:underline">Horry County property tax guide</a> explains the rates.</li><li><strong>HOA dues owed.</strong> An association's claim shows only once it is recorded as a lien. Our <a href="/hoa/liens-and-foreclosure/" style="color:var(--navy);text-decoration:underline">HOA liens guide</a> explains what follows.</li></ul><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Have us check a house for liens before you offer.</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We search the recorded loans, liens and lawsuit notices on the house and tell you what we find, free.</p><a class="btn btn-brass" href="/contact/">Ask us to check for liens</a></div></div></section><section style="background:var(--ivory)" id="read"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Read a deed">How do I read a Horry County deed?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Start with the deed's entry in the index. It holds the facts most readers need, and you can see it free, without a trip to Conway.</p><figure class="dd-fig"><div class="dd-card" role="img" aria-label="A drawing of one deed's entry in the Horry County index, with a plain meaning beside each field: record date, book and page, instrument number, map number, number of pages, document type, grantor, grantee, consideration, and the memo or legal description."><div class="hd"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg><span>One deed's entry in the index</span></div><dl><div class="r"><dt>Record Date</dt><dd>The day the county recorded the paper.</dd></div><div class="r"><dt>Book / Page</dt><dd>Where it is filed. A copy is ordered by this.</dd></div><div class="r"><dt>Instrument Number</dt><dd>The county's own number for the paper.</dd></div><div class="r"><dt>Map #</dt><dd>The lot's parcel number. 99 in 100 deeds carry one.</dd></div><div class="r"><dt>Number Of Pages</dt><dd>How long it is, and so what a copy by mail costs.</dd></div><div class="r"><dt>Doc Type</dt><dd>The kind of paper, such as 001 - DEED.</dd></div><div class="r"><dt>Grantor</dt><dd>On a deed, the seller.</dd></div><div class="r"><dt>Grantee</dt><dd>On a deed, the buyer.</dd></div><div class="r"><dt>Consideration</dt><dd>The price shown on the paper. Often $0 or blank.</dd></div><div class="r"><dt>Memo, Legal Description</dt><dd>The land in short: a lot number and a subdivision name.</dd></div></dl></div><figcaption>A drawing of the fields, not a real deed. Click any row in the county's list to see them.</figcaption></figure><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Deeds that show $0</h3><figure class="dd-fig"><div class="dd-stat"><div><span class="big">36.5%</span><span class="lbl">of Horry County deeds show $0 or no price. That is more than 1 in 3.</span></div><svg viewBox="0 0 150 150" role="img" aria-label="A grid of 100 dots, 37 of them shaded: about 37 in every 100 deeds show $0 or no price."><circle cx="7.5" cy="7.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="22.5" cy="7.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="37.5" cy="7.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="52.5" cy="7.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="67.5" cy="7.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="82.5" cy="7.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="97.5" cy="7.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="112.5" cy="7.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="127.5" cy="7.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="142.5" cy="7.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="7.5" cy="22.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="22.5" cy="22.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="37.5" cy="22.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="52.5" cy="22.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="67.5" cy="22.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="82.5" cy="22.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="97.5" cy="22.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="112.5" cy="22.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="127.5" cy="22.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="142.5" cy="22.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="7.5" cy="37.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="22.5" cy="37.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="37.5" cy="37.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="52.5" cy="37.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="67.5" cy="37.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="82.5" cy="37.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="97.5" cy="37.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="112.5" cy="37.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="127.5" cy="37.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="142.5" cy="37.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="7.5" cy="52.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="22.5" cy="52.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="37.5" cy="52.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="52.5" cy="52.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="67.5" cy="52.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="82.5" cy="52.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="97.5" cy="52.5" r="5.4" fill="#c4783a" fill-opacity="1"/><circle cx="112.5" cy="52.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="127.5" cy="52.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="142.5" cy="52.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="7.5" cy="67.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="22.5" cy="67.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="37.5" cy="67.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="52.5" cy="67.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="67.5" cy="67.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="82.5" cy="67.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="97.5" cy="67.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="112.5" cy="67.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="127.5" cy="67.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="142.5" cy="67.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="7.5" cy="82.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="22.5" cy="82.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="37.5" cy="82.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="52.5" cy="82.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="67.5" cy="82.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="82.5" cy="82.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="97.5" cy="82.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="112.5" cy="82.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="127.5" cy="82.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="142.5" cy="82.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="7.5" cy="97.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="22.5" cy="97.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="37.5" cy="97.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="52.5" cy="97.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="67.5" cy="97.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="82.5" cy="97.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="97.5" cy="97.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="112.5" cy="97.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="127.5" cy="97.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="142.5" cy="97.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="7.5" cy="112.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="22.5" cy="112.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="37.5" cy="112.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="52.5" cy="112.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="67.5" cy="112.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="82.5" cy="112.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="97.5" cy="112.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="112.5" cy="112.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="127.5" cy="112.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="142.5" cy="112.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="7.5" cy="127.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="22.5" cy="127.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="37.5" cy="127.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="52.5" cy="127.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="67.5" cy="127.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="82.5" cy="127.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="97.5" cy="127.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="112.5" cy="127.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="127.5" cy="127.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="142.5" cy="127.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="7.5" cy="142.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="22.5" cy="142.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="37.5" cy="142.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="52.5" cy="142.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="67.5" cy="142.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="82.5" cy="142.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="97.5" cy="142.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="112.5" cy="142.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="127.5" cy="142.5" r="5.4" fill="#1c2028" fill-opacity=".14"/><circle cx="142.5" cy="142.5" r="5.4" fill="#1c2028" fill-opacity=".14"/></svg></div><figcaption>Each dot is 1 in 100 deeds recorded in Horry County.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We read every one of the 30,339 deeds Horry County recorded in the 12 months to September 2026. 11,075 of them show $0 or no price.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You cannot tell from a blank price what was paid, and the index does not say why it is blank. State law exempts some deeds from the deed fee, such as an estate's deed of distribution. The full list is under <a href="#fees" style="color:var(--navy);text-decoration:underline">recording fees</a>.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For what homes sold for, see <a href="/sell/home-value/" style="color:var(--navy);text-decoration:underline">what homes sold for by area</a>, worked out from the county's deeds that show a price.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What the deed itself adds</h3><ul class="dd-list"><li><strong>The kind of deed.</strong> In a warranty deed, the seller promises to defend the title against anyone's lawful claim. A tax deed goes to the buyer at a sale for unpaid property tax, once the owner's time to redeem it runs out.</li><li><strong>The owner and the previous owners.</strong></li><li><strong>A full description of the land.</strong></li><li><strong>The affidavit filed with it.</strong> A deed is normally filed with a sworn affidavit. It gives the tax map number and either the value the fee is figured on or the reason the deed is exempt.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Inherited a home? Our guide to <a href="/sell/inherited-house/" style="color:var(--navy);text-decoration:underline">selling an inherited house</a> explains the estate's deed and the steps after it.</p></div></section><section style="background:var(--ivory-2)" id="how-far-back"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="How far back">How far back do Horry County land records go online?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Horry County index lists names and dates from late 1979, starting at Deed Book 660. Older deed books, back to Book 1, show in the index only by book and page, marked non-indexed.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We checked the oldest books in the index. Book 1 still opens by its book and page, with no names to search.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For a deed from before late 1979, call the office before you drive to Conway.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The online list runs a few days behind the recording desk. A paper recorded this week may not show yet. About 2,500 deeds are recorded in Horry County each month, besides the mortgages, liens and plats.</p></div></section><section style="background:var(--ivory)" id="fraud-alert"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Fraud alert">Does Horry County have a property fraud alert?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. Horry County's Recording Notification Service is free for property owners. It sends you an email when a paper is recorded under a name you list.</p><ol class="dd-steps"><li><span class="nb" aria-hidden="true">1</span><div><h3>Open the county's sign-up page.</h3><p>It is part of the Register of Deeds' search site, and the county's <a href="https://www.horrycountysc.gov/departments/register-of-deeds/recording-notification-service/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">service page</a> describes it.</p></div></li><li><span class="nb" aria-hidden="true">2</span><div><h3>List every version of your name.</h3><p>The name must match the recorded name exactly. DOE JOHN, DOE JOHN J and DOE JOHN JR are three different names, so add each one.</p></div></li><li><span class="nb" aria-hidden="true">3</span><div><h3>Click the link in the county's email.</h3><p>The alert starts once you activate it.</p></div></li></ol><p class="dd-btn"><a class="dd-go" href="https://acclaimweb.horrycounty.org/PublicRecordsNotificationWeb/Subscribe" target="_blank" rel="noopener">Sign up for the Horry County alert<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a></p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">An alert comes after a paper is recorded. It cannot stop the recording, but it lets you act quickly if a paper is filed that you did not sign.</p></div></section><section style="background:var(--ivory-2)" id="georgetown"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Georgetown County">How do I search Georgetown County deeds for Pawleys Island and Litchfield?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="/submarkets/pawleys-island/" style="color:var(--navy);text-decoration:underline">Pawleys Island</a> and Litchfield Beach are in Georgetown County, so their deeds are in Georgetown County's own search, not Horry's. Unlike Horry, Georgetown shows a deed on its website when the image is available.</p><p class="dd-btn"><a class="dd-go" href="https://www.georgetowndeeds.com/" target="_blank" rel="noopener">Open the Georgetown County deed search<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a></p><ul class="dd-list"><li><strong>The name:</strong> last name, then first name, or a company name. The search ignores spaces and punctuation, and it can search both sides at once.</li><li><strong>New book codes:</strong> papers recorded after May 14, 2021 use RB for Record Book, PLS for Plat Slide and MLB for Miscellaneous Book.</li><li><strong>Old records:</strong> Georgetown County's property transfers and mortgages go back to the late 1860s.</li></ul><div style="overflow-x:auto;margin:1.2rem 0;max-width:760px"><table style="width:100%;border-collapse:collapse;font-size:.92rem"><thead><tr><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase"></th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Horry County</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Georgetown County</th></tr></thead><tbody><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Search by name online</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Horry County">Yes, free, no account</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Georgetown County">Yes</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">See the deed itself online</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Horry County">No, only in Conway</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Georgetown County">Yes, when the image is available</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Copies at the office</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Horry County">50 cents a page; $1 by staff</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Georgetown County">50 cents a page; $1 for 11 by 17</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Fraud alert</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Horry County">Free, by email</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Georgetown County">Free, by email or text</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">How current, when we checked</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Horry County">A few days behind</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Georgetown County">To the day before</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Georgetown's fraud alert also sends texts. <a href="https://fraudalert.bislandrecords.com/index.php?county=georgetown&state=sc" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Sign up for Georgetown's alert</a> on its own page.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">An online image can show a personal number. You can ask the Register of Deeds in writing to remove your own Social Security, driver's license or bank account number from it. Under South Carolina law, there is no fee.</p></div></section><section style="background:var(--ivory)" id="office"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Office and fees">Horry County Register of Deeds: phone, hours and address</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Horry County Register of Deeds records and keeps the county's deeds, mortgages, plats and other land papers. Its office and public viewing area are in Conway.</p><figure class="dd-fig"><div class="dd-card" role="img" aria-label="The Horry County Register of Deeds office: phone (843) 915-5430; open Monday to Friday, 8 a.m. to 4:45 p.m.; 1301 Second Avenue, Conway, SC 29526; mail to PO Box 470, Conway, SC 29528."><div class="hd"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 21h18M5 21V9.5l5-3V21M10 21V4h9v17M13 8h3M13 12h3M13 16h3M7.5 13h.01M7.5 16.5h.01"/></svg><span>Horry County Register of Deeds</span></div><dl><div class="r"><dt>Phone</dt><dd><a href="tel:+18439155430">(843) 915-5430</a></dd></div><div class="r"><dt>Hours</dt><dd>Monday to Friday, 8 a.m. to 4:45 p.m.</dd></div><div class="r"><dt>Office</dt><dd><a href="https://www.google.com/maps/search/?api=1&query=1301+Second+Avenue+Conway+SC+29526" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">1301 Second Avenue, Conway, SC 29526</a></dd></div><div class="r"><dt>Mail</dt><dd>PO Box 470, Conway, SC 29528</dd></div><div class="r"><dt>Website</dt><dd><a href="https://www.horrycountysc.gov/departments/register-of-deeds/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Register of Deeds</a></dd></div></dl></div></figure><h3 id="fees" style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:2rem 0 .6rem;line-height:1.3">Horry County recording fees</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most papers cost one flat fee to record, whatever their length.</p><table class="dd-t2"><caption style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Horry County recording fees</caption><thead><tr><th scope="col">To record</th><th scope="col">Fee</th></tr></thead><tbody><tr><th scope="row">Deed</th><td>$15</td></tr><tr><th scope="row">Mortgage</th><td>$25</td></tr><tr><th scope="row">Mortgage satisfaction (a paid-off loan)</th><td>$10</td></tr><tr><th scope="row">Plat</th><td>$25</td></tr><tr><th scope="row">Easement</th><td>$25</td></tr><tr><th scope="row">Mechanics lien</th><td>$25</td></tr><tr><th scope="row">Restrictions (a neighborhood's rules)</th><td>$25</td></tr></tbody></table><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The deed fee, often called deed stamps, is separate. It is $1.85 for each $500 of value, or part of $500, which is $3.70 per $1,000.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">By law the seller owes the deed fee, except on a master-in-equity or government deed, where the buyer owes it. Our <a href="/sell/net-proceeds/" style="color:var(--navy);text-decoration:underline">seller's net proceeds calculator</a> and <a href="/buyers/closing-costs/" style="color:var(--navy);text-decoration:underline">closing costs guide</a> show it at your price.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">State law exempts some deeds from the deed fee:</p><ul class="dd-list"><li>A deed of distribution from an estate.</li><li>A deed to a government.</li><li>A transfer into a company or a trust in return only for an interest in it.</li><li>A corrective or quitclaim deed that only confirms title the grantee already holds.</li><li>A deed in lieu of foreclosure.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Selling without an agent? Our <a href="/sell/fsbo/" style="color:var(--navy);text-decoration:underline">for sale by owner guide</a> covers the deed fee and the other costs of a sale.</p></div></section><section style="background:var(--ivory-2)" id="deed-search-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Deed search FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Are Horry County deed records public?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. Anyone can search the Register of Deeds index online as a guest, free, after accepting the county's terms.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I see my deed online in Horry County?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. Horry County puts the index online, not the documents. You view them in Conway, order a copy by mail, or have us pull it for you.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How much does a copy of a deed cost in Horry County?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">By mail, $8 for the first 4 pages and $1 for each page after. At the office, 50 cents a page on the copy machine. A certified copy is $2 more.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What is a plat, and how do I find one in Horry County?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A plat is a scale drawing of lots, usually made by a surveyor. It shows each lot's size and boundaries. Search the name on the plat and pick a plat type, or open it by book and page with book type P.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County deed index</a>, <a href="https://www.horrycountysc.gov/departments/register-of-deeds/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Register of Deeds</a>, <a href="https://www.horrycountysc.gov/media/uevkqtt4/price.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">price list</a>, <a href="https://www.horrycountysc.gov/media/t3wpam13/customer-service-request-form.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">copy request form</a>, <a href="https://www.horrycountysc.gov/media/0twpbohq/rnsinstructions.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">alert guide</a>, <a href="https://www.scstatehouse.gov/code/t12c024.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-24</a>, <a href="https://www.scstatehouse.gov/code/t15c035.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 15-35</a>, <a href="https://www.scstatehouse.gov/code/t30c002.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 30-2</a>, <a href="https://www.scstatehouse.gov/code/t27c007.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 27-7</a>, <a href="https://www.scstatehouse.gov/code/t12c051.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-51</a>, <a href="https://gtcountysc.gov/178/Register-of-Deeds" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Georgetown Register of Deeds</a>, <a href="https://gtcountysc.gov/Faq.aspx?QID=107" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Georgetown FAQ</a>. Our count: every deed (type 001) in Horry County's index for the 12 months to September 2026. Not legal advice.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">The Horry County Government and Justice Center at 1301 Second Avenue in Conway. Photo: Pollinator at English Wikipedia, <a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 3.0</a>, via <a href="https://commons.wikimedia.org/wiki/File:New_Horry_County_Courthouse_and_county_office_complex,_Conway,_South_Carolina_(18_November_2006).jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>. Ch