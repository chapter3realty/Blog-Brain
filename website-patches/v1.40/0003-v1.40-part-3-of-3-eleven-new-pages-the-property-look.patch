;width:calc(100% - 32px);box-sizing:border-box}@media (max-width:699px){main#main>section[style^="background:var(--navy)"]:last-of-type>.wrap{padding:1.6rem 1.2rem 1.7rem!important;border-radius:24px!important}}@media (min-width:980px) and (max-width:1099px){header nav.primary{gap:2.4rem!important}}@media (max-width:359px){main#main .hx-feed .hx-fb-ai,main#main label.hx-fb-q{min-width:0!important;max-width:100%!important;flex-wrap:wrap!important;box-sizing:border-box}}</style><style>main#main .hx-strip:empty{display:none}main#main .hx-strip:not(:empty)+.hx-fallback{display:none}</style><div class="c3-pr-open"><style>main#main .hx-qs{margin:1rem 0 1.4rem}main#main .hx-strip.hx-qs:empty{display:block!important;height:0;margin:0;overflow:hidden}</style><script>(function(){function fill(s){if(s.getAttribute("data-done"))return;s.setAttribute("data-done","1");fetch("/homes/api/strip?"+s.getAttribute("data-q"),{credentials:"same-origin"}).then(function(r){return r.ok?r.json():null}).then(function(j){if(!j||!j.ok||!j.html||j.html.indexOf("hx-s-empty")>-1)return;var hd=document.createElement("p");hd.className="hx-s-head";var b=document.createElement("b");b.textContent=s.getAttribute("data-head");hd.appendChild(b);if(j.link&&j.link.charAt(0)==="/"){var a=document.createElement("a");a.href=j.link;a.textContent="See all";hd.appendChild(a)}var row=document.createElement("div");row.className="hx-s-row";row.innerHTML=j.html;s.appendChild(hd);s.appendChild(row);if(j.note){var n=document.createElement("p");n.className="hx-s-note";n.textContent=j.note;s.insertBefore(n,row)}}).catch(function(){})}function go(){var all=[].slice.call(document.querySelectorAll(".hx-qs[data-q]"));if(!("IntersectionObserver" in window)){all.forEach(fill);return}var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){io.unobserve(e.target);fill(e.target)}})},{rootMargin:"600px 0px"});all.forEach(function(s){io.observe(s)})}if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",go);else go()})();</script><div class="hx-strip hx-qs" data-q="subdivision=PALACE%2C+THE" data-head="Own a condo in the Palace Resort, on the ocean"></div></div><p class="c3-pr-up">The Palace is one of 47 buildings in our <a href="/invest/condo-buildings/" style="color:var(--navy);text-decoration:underline">guide to Myrtle Beach oceanfront condo buildings</a>.</p></div></section><section style="background:var(--ivory)" id="owning"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Owning here">What is it like to own a condo at the Palace?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Book a stay through the Palace's own rental program, and the first two guests on the reservation get the H2Oasis water park free, every day of the stay. H2Oasis is next door at Landmark Resort. Its three slides are each 40 feet tall, and the longest runs 250 feet.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Other guests in the room can buy a pass for $5. The water park opens for the summer season. For an owner who rents through the resort, it is a reason a guest picks your unit over one down the beach.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Whether owners get passes is in the association's rules, and we ask before you offer.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Palace has its own two pools on the ocean, three outdoor whirlpools, an indoor whirlpool and a sauna. A putting green sits next to the oceanfront pools, and two beach accesses lead to the sand. Most of the outdoor features are open in season.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">A 241-foot tower on the south end</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Palace stands 241 feet tall. No floor is numbered 13: unit numbers run on floors 1 to 12 and 14 to 23. The top two floors hold 10 condos each, against 14 on most floors below.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">It stands next door to Landmark Resort, on the south end of the city's oceanfront. Family Kingdom's rides are under a mile north along the beach, and Springmaid Pier is about a mile and a half south.</p><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);letter-spacing:.01em;color:#fff;text-align:right;background:radial-gradient(farthest-side at 100% 100%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.c3ph-cr a{color:#fff;text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);text-underline-offset:2px;pointer-events:auto;padding:10px 0 6px}.c3ph-hero{margin:1.6rem 0 2rem}.c3ph-hero .c3ph-f{border-radius:8px}.c3ph-hero img{aspect-ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}</style><figure class="c3ph-hero" style="margin:1.4rem 0 1.6rem;max-width:640px;"><div class="c3ph-f"><img src="/images/2026-11-d/palace-resort/palace-resort-from-above-1200w.webp" srcset="/images/2026-11-d/palace-resort/palace-resort-from-above-600w.webp 600w, /images/2026-11-d/palace-resort/palace-resort-from-above-1200w.webp 1200w" sizes="(max-width: 700px) 100vw, 640px" width="1200" height="900" alt="Aerial photo of the Palace Resort tower on the beach in Myrtle Beach, labelled, with Landmark Resort next door and the Atlantic Ocean" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo. License: Public domain" title="License: Public domain">U.S. government aerial photo</a></span></div><figcaption>The Palace from above, on the beach, with Landmark Resort next door.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Every unit has a full kitchen, and the resort lists a private balcony among its room features. The resort calls a studio an efficiency. A studio or a one-bedroom sleeps 4, and a two-bedroom sleeps 6.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">All 25 condos for sale on November 13, 2026 came furnished, with covered parking. 23 were listed with an ocean view, and 8 of those as oceanfront units.</p><div class="hx-strip hx-qs" data-q="near=33.672518%2C-78.901529&amp;miles=1&amp;type=condo&amp;has=oceanfront_unit" data-head="Oceanfront condos within a mile of the Palace"></div></div></section><section style="background:var(--ivory-2)" id="hoa-fees"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="HOA fees">What are the HOA fees at the Palace Resort?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">At the Palace Resort, the HOA fee pays water and sewer, trash, internet and the building's insurance, by nearly every listing. Most listings add pest control. Units of the same size list nearly the same fee.</p><style>.c3-cc{margin:1.4rem 0 1.8rem;max-width:960px}.c3-cc table{width:100%;border-collapse:collapse;font-size:var(--read,1.0625rem);line-height:1.45;color:var(--muted)}.c3-cc caption{caption-side:top;text-align:left;color:var(--navy);font-weight:600;font-size:1em;line-height:1.4;padding:0 0 .7rem}.c3-cc th,.c3-cc td{padding:.6rem .7rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule);overflow-wrap:break-word}.c3-cc thead th{color:var(--navy);font-weight:600;font-size:1em;border-bottom:2px solid var(--navy);vertical-align:bottom}.c3-cc tbody th{color:var(--navy);font-weight:600}.c3-cc .n{text-align:right;font-variant-numeric:tabular-nums}.c3-cc .i{display:inline-flex;vertical-align:-4px;margin-right:.45rem;color:var(--brass-ink)}.c3-cc tr.c3-self>*{background:#fff}@media (max-width:59.999em){.c3-cc table,.c3-cc tbody,.c3-cc tr,.c3-cc th,.c3-cc td{display:block;width:auto}.c3-cc caption{display:block}.c3-cc thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.c3-cc tbody tr{background:var(--ivory-2);border-top:3px solid var(--brass);margin:0 0 .8rem;padding:.5rem 0 .6rem}section[style*="background:var(--ivory-2)"] .c3-cc tbody tr{background:var(--ivory)}.c3-cc tr.c3-self{background:#fff!important;border:2px solid var(--brass)}.c3-cc tr.c3-self>*{background:transparent}.c3-cc th,.c3-cc td{border:0;padding:.2rem 1rem}.c3-cc tbody th{display:flex;align-items:center;font-size:1.1em;padding-bottom:.35rem}.c3-cc tbody th .i{flex:none;vertical-align:0}.c3-cc tbody th a{display:inline-block;padding:.5rem 0}.c3-cc .n{text-align:left}.c3-cc td[data-label]::before{content:attr(data-label) ": ";color:var(--navy);font-weight:500}}</style><div class="c3-cc"><table><caption>At the Palace, the fee goes by the size of the unit</caption><thead><tr><th scope="col">Unit</th><th scope="col">Size</th><th scope="col" class="n">HOA fee a month</th><th scope="col" class="n">Fees a year</th><th scope="col" class="n">Middle asking price</th><th scope="col" class="n">For sale Nov. 13</th></tr></thead><tbody><tr><th scope="row">Studio</th><td data-label="Size">341 to 478 sq ft, sleeps 4</td><td class="n" data-label="HOA fee a month">About $460</td><td class="n" data-label="Fees a year">About $5,500</td><td class="n" data-label="Middle asking price">About $132,000</td><td class="n" data-label="For sale Nov. 13">10</td></tr><tr><th scope="row">One-bedroom</th><td data-label="Size">509 to 539 sq ft, sleeps 4</td><td class="n" data-label="HOA fee a month">About $685</td><td class="n" data-label="Fees a year">About $8,200</td><td class="n" data-label="Middle asking price">About $165,000</td><td class="n" data-label="For sale Nov. 13">7</td></tr><tr><th scope="row">Two-bedroom</th><td data-label="Size">739 to 950 sq ft, sleeps 6</td><td class="n" data-label="HOA fee a month">About $915</td><td class="n" data-label="Fees a year">About $11,000</td><td class="n" data-label="Middle asking price">About $219,000</td><td class="n" data-label="For sale Nov. 13">8</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">None of the listings says the fee pays the power bill. You also need your own policy on the inside of the unit; our page on <a href="/hoa/master-insurance-ho6/" style="color:var(--navy);text-decoration:underline">the building's policy and your own condo policy</a> explains the split.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What a year costs before any loan</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A studio at the middle asking price costs about $7,500 a year to hold, before power and your unit's own insurance.</p><div style="overflow-x:auto;margin:1.2rem 0;max-width:760px"><table style="width:100%;border-collapse:collapse;font-size:.92rem"><thead><tr><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Each year, at the middle asking price</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Studio</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Two-bedroom</th></tr></thead><tbody><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">HOA fees</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$5,500</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$11,000</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Property tax as a rental, before any exemption</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$2,000</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$3,300</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><strong>About</strong></td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><strong>$7,500</strong></td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><strong>$14,300</strong></td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">South Carolina taxes a rental or second home on 6 percent of its value, and a sale resets the value to about the price. Our <a href="/buyers/property-taxes/" style="color:var(--navy);text-decoration:underline">property tax page</a> has the lower rate for a home you live in.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Buyers in most associations here, with a rental program or not, pay a transfer fee at closing. Many also put a few months of dues in escrow, an account that holds the money until it is due.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Know the Palace's fees before you offer</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We ask the association for the unit's dues, its transfer fee and any dues held at closing, and add them up for you.</p><a class="btn btn-brass" href="/contact/">Have us get a Palace unit's fees</a></div></div></section><section style="background:var(--ivory)" id="renting"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Renting it">Can you Airbnb a condo at the Palace Resort?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. The Palace is in a City of Myrtle Beach zoning district where nightly rentals are allowed, and the resort itself rents units by the night. About 8 in 10 of the condos for sale on November 13 were in a rental program.</p><ul class="c3-pr-list"><li><strong>Through the resort's own program</strong>The Palace runs an on-site rental program, part of the Vacation Myrtle Beach group. It collects and pays the lodging taxes, sends monthly and year-end statements, and holds the rent in escrow, a separate account, until it pays the owner. Its guests get the water-park passes.</li><li><strong>On your own</strong>You can hire a licensed manager or list the unit on Airbnb yourself. The license and the taxes are on our <a href="/invest/str-rules/" style="color:var(--navy);text-decoration:underline">short-term rental rules page</a>.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The program does not publish its share of the rent, so we get its terms for any unit you consider. Our page on <a href="/invest/rental-program-vs-airbnb/" style="color:var(--navy);text-decoration:underline">a rental program versus Airbnb</a> shows the money both ways.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">What studios, one-bedrooms and two-bedrooms earn across Myrtle Beach is on our <a href="/invest/airbnb-income/" style="color:var(--navy);text-decoration:underline">Airbnb income page</a>. No public source gives income for the Palace alone.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">The resort's rules for guests</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Guests must be 21 to check in. Guests may not bring pets, and a $500 fine applies; registered service animals are not counted as pets. Guests register one car for a studio or one-bedroom, and up to two for a two-bedroom.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">An owner's own rules on pets and cars are in the condo's founding documents and rules. We read them before you offer.</p></div></section><section style="background:var(--ivory-2)" id="sales"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Sales">What have Palace Resort condos sold for?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">21 Palace condos sold in the past year by Horry County's deed records. That is about 1 in 14 units in the building changing hands in a year.</p><div style="overflow-x:auto;margin:1.2rem 0;max-width:760px"><table style="width:100%;border-collapse:collapse;font-size:.92rem"><thead><tr><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Palace condos</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Price</th></tr></thead><tbody><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Middle sale price, past year</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">About $142,000</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Middle half of the sales</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">About $112,500 to $157,000</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Middle asking price, 25 for sale on Nov. 13</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">About $160,000</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Asking prices ran above what units sold for. Upper-floor sales ran higher, mostly because more of them were larger units.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The deeds do not record bedrooms, so we compare a unit with sales of its own size. We price an offer from the recorded sales.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our <a href="/sell/home-value/" style="color:var(--navy);text-decoration:underline">home value page</a> explains how we price a home here.</p></div></section><section style="background:var(--ivory)" id="checks"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Our checks">What we check before you buy at the Palace</h2><ul class="c3-pr-list"><li><strong>Flood zones</strong>About three quarters of the lot is in FEMA's moderate flood zone, and about a quarter in its lowest-risk zone. About 4 percent, a strip on the ocean side, is in the high-risk zone. We check the flood map for the building itself and the flood cover in the building's policy.</li><li><strong>The building's age</strong>Built in the mid-1980s. We read the reserve study, the last two budgets and the minutes for any planned assessment. Our page on <a href="/hoa/special-assessments/" style="color:var(--navy);text-decoration:underline">special assessments</a> shows what one can cost.</li><li><strong>Who uses the units</strong>About 1 in 10 units is taxed as the owner's home. Nearly all the rest pay the higher rate for second homes and rentals.</li><li><strong>If you will use a loan</strong>Many standard loans will not cover a unit in a building run like a hotel. The Palace is not on HUD's list of condos approved for FHA loans. One published condotel loan program asks for at least 500 square feet and a separate bedroom. Every studio for sale is under that size; the one- and two-bedrooms are over it. Ask a lender before you choose a studio.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our affiliated lender, BrickWood Mortgage, a separate company, can tell you which loans fit a Palace unit. Our <a href="/invest/condotel-financing/" style="color:var(--navy);text-decoration:underline">condotel financing page</a> has more.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Have us check a Palace unit before you offer</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We go through each check above for the unit you like, and we get the rental program's terms and the unit's booking history.</p><a class="btn btn-brass" href="/contact/">Have us check a Palace unit</a></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">To weigh the Palace against the other 46 buildings, <a href="/invest/condo-buildings/" style="color:var(--navy);text-decoration:underline">compare the oceanfront condo buildings</a>. Whether a condo suits you at all is on our <a href="/invest/condos/" style="color:var(--navy);text-decoration:underline">Myrtle Beach condos page</a>.</p></div></section><section style="background:var(--ivory-2)" id="palace-resort-myrtle-beach-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Palace Resort Myrtle Beach FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">When was the Palace Resort in Myrtle Beach built?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Palace Resort was built in the mid-1980s, so the tower is about 40 years old.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How tall is the Palace Resort?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Palace Resort stands 241 feet tall. No floor is numbered 13: unit numbers run on floors 1 to 12 and 14 to 23.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is the Palace a hotel or condos?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Both. Its 298 condos are owned one by one, and the resort's own rental program rents many of them to guests by the night.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is the water park free at the Palace Resort?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For the first two guests of each reservation booked through the Palace's own rental program, yes, every day of the stay, in season. Other guests in the room can buy a pass.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is the Palace Resort pet friendly?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Guests may not bring pets; registered service animals are not counted as pets. An owner's own pet rules are in the condo's founding documents, and we read them before you offer.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What is the address of the Palace Resort?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Palace Resort is at 1605 S Ocean Blvd, Myrtle Beach, SC 29577, on the south end of the city's oceanfront.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How many Palace Resort condos are for sale?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On November 13, 2026, 25 Palace Resort condos were for sale: 10 studios, 7 one-bedrooms and 8 two-bedrooms.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.palaceresort.com/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Palace Resort</a>, <a href="https://www.palaceresort.com/waterpark-access/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">water park</a>, <a href="https://www.palaceresort.com/amenities/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">amenities</a>, <a href="https://www.palaceresort.com/faq/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">guest FAQ</a>, <a href="https://www.palaceresort.com/rental-management/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">rental program</a>, <a href="https://www.palaceresort.com/accommodations/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">rooms</a>, <a href="https://www.faa.gov/air_traffic/flight_info/aeronav/digital_products/dof/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FAA obstacle file</a>, <a href="https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County GIS</a>, <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">county deeds</a>, <a href="https://terra.cityofmyrtlebeach.com/server/rest/services/ZONING_DISTRICTS_MB/FeatureServer/0" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">city zoning</a>, <a href="https://msc.fema.gov/portal/home" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FEMA flood map</a>, <a href="https://www.horrycountysc.gov/media/kufln4qp/tax-levy-2026_2.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">2026 tax levy</a>, <a href="https://selling-guide.fanniemae.com/sel/b4-2.1-03/ineligible-projects" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Fannie Mae</a>, <a href="https://entp.hud.gov/idapp/html/condlook.cfm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">HUD condo list</a>. Our counts: CCMLS listings on November 13, 2026, in aggregate; county parcels and the deeds recorded in the 12 months to September 2026; the flood map on the county's parcel drawing.</p><style>.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 