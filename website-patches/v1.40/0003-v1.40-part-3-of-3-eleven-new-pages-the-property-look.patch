dentials:"same-origin"}).then(function(r){return r.ok?r.json():null}).then(function(j){if(!j||!j.ok||!j.html||j.html.indexOf("hx-s-empty")>-1)return;var hd=document.createElement("p");hd.className="hx-s-head";var b=document.createElement("b");b.textContent=s.getAttribute("data-head");hd.appendChild(b);if(j.link&&j.link.charAt(0)==="/"){var a=document.createElement("a");a.href=j.link;a.textContent="See all";hd.appendChild(a)}var row=document.createElement("div");row.className="hx-s-row";row.innerHTML=j.html;s.appendChild(hd);s.appendChild(row);if(j.note){var n=document.createElement("p");n.className="hx-s-note";n.textContent=j.note;s.insertBefore(n,row)}}).catch(function(){})}function go(){var all=[].slice.call(document.querySelectorAll(".hx-qs[data-q]"));if(!("IntersectionObserver" in window)){all.forEach(fill);return}var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){io.unobserve(e.target);fill(e.target)}})},{rootMargin:"600px 0px"});all.forEach(function(s){io.observe(s)})}if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",go);else go()})();</script><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About 760 pieces of land are for sale in Horry County, and about 170 in Georgetown County. In Horry the middle asking price is about $195,000, and the middle size is about 1.7 acres.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="An acre costs least around Loris and Aynor"><span class="cap" aria-hidden="true">An acre costs least around Loris and Aynor</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Area, tracts for sale</span><span role="columnheader">Middle asking price an acre</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Around Loris, Green Sea and Nichols</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">212 tracts</span></span><span role="cell"><span class="b" style="--f:0.073" aria-hidden="true"></span><span class="v">$25,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Around Aynor and Galivants Ferry</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">50 tracts</span></span><span role="cell"><span class="b" style="--f:0.117" aria-hidden="true"></span><span class="v">$40,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Around Conway</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">97 tracts</span></span><span role="cell"><span class="b" style="--f:0.149" aria-hidden="true"></span><span class="v">$51,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Longs</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">31 tracts</span></span><span role="cell"><span class="b" style="--f:0.213" aria-hidden="true"></span><span class="v">$73,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Myrtle Beach, Carolina Forest, Socastee</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">52 tracts</span></span><span role="cell"><span class="b" style="--f:0.444" aria-hidden="true"></span><span class="v">$152,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Little River</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">17 tracts</span></span><span role="cell"><span class="b" style="--f:0.775" aria-hidden="true"></span><span class="v">$265,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Murrells Inlet and Garden City</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">15 tracts</span></span><span role="cell"><span class="b" style="--f:0.883" aria-hidden="true"></span><span class="v">$302,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Pawleys Island area</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">19 tracts</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">$342,000</span></span></div></div></div><figcaption>Middle asking price an acre on tracts of 1 acre or more, by ZIP code area, from our count of land for sale in November 2026. The Pawleys Island area is in Georgetown County; the rest are in Horry.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Of the areas we counted, the Loris, Green Sea and Nichols ZIP codes have the most land for sale: 266 pieces. Of those, 212 are an acre or more, and 70 are 10 acres or more. In all of Horry County, 17 tracts for sale are 100 acres or more.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">These are asking prices, not sale prices. In each area, half the tracts are listed for more than the middle price an acre, and half for less.</p></div></section><section style="background:var(--ivory)" id="loris-aynor"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Loris and Aynor">Land around Loris and Aynor: river landings, longleaf pine and old farms</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The country around Loris and Aynor has the lowest land prices we counted, and a long history as farm land.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Around Loris</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">By 1903, tobacco markets were thriving in Conway and Loris. By the 1920s, Horry grew more tobacco than any other county in South Carolina.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">West of Loris, between Green Sea and Nichols, <a href="https://www.sctrails.net/trails/trail/cartwheel-bay-heritage-preserve" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Cartwheel Bay Heritage Preserve</a> has a 3.5-mile trail through longleaf and loblolly pine. Wild Venus flytraps, pitcher plants and orchids grow along it. It is open dawn to dusk, with no fee.</p><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);letter-spacing:.01em;color:#fff;text-align:right;background:radial-gradient(farthest-side at 100% 100%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.c3ph-cr a{color:#fff;text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);text-underline-offset:2px;pointer-events:auto;padding:10px 0 6px}.c3ph-hero{margin:1.6rem 0 2rem}.c3ph-hero .c3ph-f{border-radius:8px}.c3ph-hero img{aspect-ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}</style><figure class="c3ph-hero" style="max-width:720px;"><div class="c3ph-f"><img src="/images/2026-11-d/land/country-land-outside-loris-from-above-1200w.webp" srcset="/images/2026-11-d/land/country-land-outside-loris-from-above-600w.webp 600w, /images/2026-11-d/land/country-land-outside-loris-from-above-1200w.webp 1200w" sizes="(max-width: 760px) 100vw, 720px" width="1200" height="900" alt="Aerial photo of country land outside Loris: houses and manufactured homes on wide grassy lots along two country roads, plowed farm fields, pine woods and a wet hollow" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo, 2023. License: Public domain" title="License: Public domain">U.S. government aerial photo, 2023</a></span></div><figcaption>Country land outside Loris from above: wide lots along two country roads, plowed fields, pine woods and a wet hollow.</figcaption></figure><div class="hx-strip hx-qs" data-q="type=land&amp;city=Loris&amp;lotMin=1" data-head="Acres for sale in Loris"></div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Around Aynor</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Galivants Ferry is west of Aynor, where US 501 crosses the Little Pee Dee River. There is a public boat landing on each side of the bridge. People fish the river for bluegill, redbreast, bass, crappie and catfish. Downriver, below the US 378 bridge, its state scenic stretch has tea-colored water, cypress-tupelo swamps and sandbars.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Since the 1870s, candidates have come to Galivants Ferry to speak at <a href="https://scencyclopedia.org/sce/entries/galivants-ferry-stump-meeting/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">the Stump</a>. These days they speak from the porch of the Holliday family store, and the crowd eats chicken bog and barbecue. What living in these towns is like is in our guide to <a href="/buyers/relocating/which-town/" style="color:var(--navy);text-decoration:underline">which town fits you</a>.</p><div class="hx-strip hx-qs" data-q="type=land&amp;city=Aynor" data-head="Land for sale in Aynor"></div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Around Conway and Longs</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Around Conway an acre is listed at about $51,000, and in Longs at about $73,000. At Longs, the county runs two boat landings on the Waccamaw River: Chris Anderson Landing on SC 9 and Danny Knight Landing at Red Bluff. Our <a href="/submarkets/conway/" style="color:var(--navy);text-decoration:underline">Conway guide</a> covers the city and its edges.</p><div class="hx-strip hx-qs" data-q="type=land&amp;city=Conway" data-head="Land for sale in Conway"></div><div class="hx-strip hx-qs" data-q="type=land&amp;city=Longs&amp;lotMin=1" data-head="An acre or more in Longs"></div><div class="ld-story"><b>From Chapter3's files.</b> Clients of ours from North Carolina bought land in Longs and built a new house there with a builder.</div></div></section><section style="background:var(--ivory-2)" id="tract-size"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Tract size">The more land you buy, the less each acre costs</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In Horry County, a lot under half an acre is listed at about $686,000 an acre. A tract of 20 acres or more is listed at about $19,000 an acre.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="Price an acre, by lot size"><span class="cap" aria-hidden="true">Price an acre, by lot size</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Lot size, for sale</span><span role="columnheader">Middle asking price an acre</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Under half an acre</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">158 for sale</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">$686,000</span></span></div><div role="row"><span role="rowheader"><span class="n">Half an acre to 1 acre</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">117 for sale</span></span><span role="cell"><span class="b" style="--f:0.204" aria-hidden="true"></span><span class="v">$140,000</span></span></div><div role="row"><span role="rowheader"><span class="n">1 to 5 acres</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">267 for sale</span></span><span role="cell"><span class="b" style="--f:0.079" aria-hidden="true"></span><span class="v">$54,000</span></span></div><div role="row"><span role="rowheader"><span class="n">5 to 20 acres</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">112 for sale</span></span><span role="cell"><span class="b" style="--f:0.044" aria-hidden="true"></span><span class="v">$30,000</span></span></div><div role="row"><span role="rowheader"><span class="n">20 acres or more</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">105 for sale</span></span><span role="cell"><span class="b" style="--f:0.028" aria-hidden="true"></span><span class="v">$19,000</span></span></div></div></div><figcaption>Middle asking price an acre of Horry County land for sale, by the size of the lot. Our count of 763 land listings.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Compare a lot's price an acre only with lots of about the same size, in the same area.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Land for sale, by lot size</h3><div class="hx-strip hx-qs" data-q="type=land&amp;lotMax=0.5" data-head="Lots under half an acre"></div><div class="hx-strip hx-qs" data-q="type=land&amp;lotMin=0.5&amp;lotMax=1" data-head="Half an acre to 1 acre"></div><div class="hx-strip hx-qs" data-q="type=land&amp;lotMin=1&amp;lotMax=5" data-head="1 to 5 acres"></div><div class="hx-strip hx-qs" data-q="type=land&amp;lotMin=5&amp;lotMax=20" data-head="5 to 20 acres"></div><div class="hx-strip hx-qs" data-q="type=land&amp;lotMin=20" data-head="Lots of 20 acres or more"></div></div></section><section style="background:var(--ivory)" id="septic"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Perc test and septic">Do you need a perc test to buy land in South Carolina?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. South Carolina has not used perc tests since the late 1970s, because a lot can pass in a dry season and fail in a wet one. A state inspector reads the soil instead.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Where no public or community sewer reaches a lot, you need the state's septic permit before you build a house or place a manufactured home. Without it, the county will not issue a building permit. The state's steps:</p><ul class="ld-list"><li><strong>Apply online, for $150.</strong> The application needs a copy of the deed, or of the survey map filed for the lot. Our guide to <a href="/buyers/property-records/deeds/" style="color:var(--navy);text-decoration:underline">finding a deed in Horry County</a> shows where to get both.</li><li><strong>The inspector bores the soil.</strong> Under the state's traditional method, an inspector visits the lot and takes at least two soil borings where the septic system would go. The soil's color shows how high the water table rises in the wettest season.</li><li><strong>Wet soil can wait.</strong> If the soil is too wet, the visit may be put off until it dries out. Poor soil can limit the number of bedrooms the house may have.</li><li><strong>The permit is good for five years.</strong> If the site passes, the state issues a Permit to Construct.</li></ul><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What the lot needs room for</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The drainfield is sized at 120 gallons a day per bedroom. A three-bedroom house needs a drainfield big enough for about 360 gallons a day, plus a spare repair area half its size.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The system must sit at least 75 feet from a private well or a creek, pond or other surface water, and 25 feet from a drainage ditch.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If a lot fails the state's conventional and alternative standards, an engineer and a soil scientist can check whether it can take an engineered system. That can cost thousands of dollars more. Not every lot can take a septic system.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What the listings say</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About 1 in 4 Horry land listings are marked "perc or septic approved". We ask the seller for the state's permit itself, not the word "perc". If there is none, we can write your offer so it depends on the lot passing.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">No sewer on the lot?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We look for a septic permit on it, ask whether sewer can reach it, and tell you what the soil visit will look for.</p><a class="btn btn-brass" href="/contact/">Have us check the septic</a></div></div></section><section style="background:var(--ivory-2)" id="water"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Water and sewer">Is there public water and sewer, or do you need a well?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Many lots have public water, and fewer have public sewer: about 4 in 10 Horry land listings list public water, and about 1 in 3 list public sewer. Only 41 list a well.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">With no public sewer you need a septic system, and with no public water you need a well. Before you offer, we ask the local provider whether each one reaches the lot.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="https://www.gswsa.com/about_us.cfm?page=58" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Grand Strand Water and Sewer Authority</a> began east of the Intracoastal Waterway in Horry County. It now serves from the North Carolina line to parts of Georgetown County, and rural areas west of the Waccamaw River. Inside the City of Loris, <a href="https://cityoflorissc.com/water-utilities" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">the city runs water and sewer</a>.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A new drinking-water well needs a state notice with a $70 fee, and a South Carolina certified well driller must drill it.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A listing that says nothing about water or sewer is not proof either way, so we ask the provider.</p></div></section><section style="background:var(--ivory)" id="zoning"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Zoning and mobile homes">What can you build on land in Horry County?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Outside the towns, each county zone has its own smallest lot for a home and its own rule on manufactured homes. In the two forest and farm zones, FA and CFA, a house or a manufactured home needs at least half an acre, 90 feet wide.</p><div style="overflow-x:auto;margin:1.2rem 0;max-width:760px"><table style="width:100%;border-collapse:collapse;font-size:.92rem"><thead><tr><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Zone, outside the towns</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Smallest lot for a home</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Mobile homes</th></tr></thead><tbody><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">FA and CFA (Forest Agriculture, Commercial Forest Agriculture)</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Smallest lot for a home">Half an acre</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Mobile homes">Allowed</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">RE (Rural Estates)</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Smallest lot for a home">1 acre</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Mobile homes">Not allowed</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">AG4 and AG5</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Smallest lot for a home">5 acres</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Mobile homes">Allowed in AG5 only</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">AG6 and AG7</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Smallest lot for a home">1.5 acres</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Mobile homes">Allowed in AG7 only</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">SF6 to SF40</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Smallest lot for a home">6,000 to 40,000 sq ft</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Mobile homes">Not allowed</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">MSF6 to MSF40</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Smallest lot for a home">6,000 to 40,000 sq ft</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Mobile homes">Allowed</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In Limited Forest Agriculture (LFA), a home needs 1 acre. A lot recorded before the county's zoning ordinance can still be built on if it is no more than 25 percent short of its zone's minimum.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our count, at each listing's map point: about half of all Horry land listings are in FA or CFA. Among tracts of an acre or more, 6 in 10 are. Another 62 are in SF zones, where no mobile home is allowed.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We look up the zone of any lot you send us. Our guide to <a href="/buyers/property-records/gis-map/" style="color:var(--navy);text-decoration:underline">the Horry County GIS map</a> shows where the county keeps it.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Deed restrictions</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A deed restriction is a rule recorded with the land. It can bar a mobile home even where the zoning allows one. In our count, 74 Horry land listings mention deed restrictions, and 111 are marked as allowing a mobile home. We read the recorded restrictions before you offer. To look up a parcel yourself, use our <a href="/buyers/property-records/" style="color:var(--navy);text-decoration:underline">Horry County property records search</a>.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can you live in a camper on your land?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Only for part of each month, and only in some places. On land zoned LFA, FA or CFA that touches the Waccamaw River or lies north and west of it, you can keep up to two campers or RVs. The land must have no house or business on it, and you can stay in them up to 15 days a month.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Each camper must be tagged, registered and road-ready, on approved sewer or septic, with permitted power.</p></div></section><section style="background:var(--ivory-2)" id="road"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Road access">Does land in Horry County need road frontage?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, for a new lot. A new lot must have at least 50 feet of frontage on a street. On a cul-de-sac, 25 feet is enough if the lot is 50 feet wide at the building line.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For a lot with no frontage that existed before the zoning ordinance, the county's planning commission decides whether private access is enough to build.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Along some highways, the front of a lot cannot be built on. Outside the towns, no structure may stand within 60 feet of the right of way of certain highways. They include Highways 701, 905 and 917, and two named stretches of Highway 9.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In our count, 77 land listings are marked as on a dirt or gravel road, 49 on a private road and 27 reached by an easement. For those, we find out who keeps up the road and get a copy of the recorded easement.</p></div></section><section style="background:var(--ivory)" id="flood"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Flood and wetlands">Is the land in a flood zone?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About 1 in 8 Horry land listings (91 of 763) sit in FEMA's high-risk flood zone at the listing's map point, and 24 more in the moderate zone. A big tract can reach into a flood zone away from that point.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the unincorporated county, a new home in the high-risk zone must have its lowest floor at least 3 feet above the 100-year flood height. The county <a href="https://www.horrycountysc.gov/departments/code-enforcement/permits/building-permit/what-you-need-for-a-building-permit/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">asks for more papers</a> before it issues the permit.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Wetlands</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If part of a lot may be a wetland, you may need to ask the U.S. Army Corps of Engineers or the state's Bureau of Coastal Management.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our <a href="/buyers/flood-zone-check/" style="color:var(--navy);text-decoration:underline">flood zone check guide</a> shows how to read a flood map. Our guide to <a href="/buyers/undisclosed-flooding/" style="color:var(--navy);text-decoration:underline">finding past flooding</a> shows how to learn whether a place has flooded before.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Big tract near a creek or a swamp?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">One map point can miss a flood zone. We look at the flood map across the whole tract, and tell you what a house there needs.</p><a class="btn btn-brass" href="/contact/">Have us check the flood map</a></div></div></section><section style="background:var(--ivory-2)" id="costs"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Fees to build">What does it cost to build on your own land in Horry County?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Outside the towns, the state and county fees for a 2,000 square foot house with a septic tank and a well come to about $1,650. Impact fees and the house itself are extra.</p><div style="overflow-x:auto;margin:1.2rem 0;max-width:760px"><table style="width:100%;border-collapse:collapse;font-size:.92rem"><thead><tr><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">What you pay for</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">What it costs</th></tr></thead><tbody><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">State septic permit application</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="What it costs">$150</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">State notice for a drinking-water well</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="What it costs">$70, plus the driller</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">County building permit, new house</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="What it costs">20 cents a sq ft for plan review, 50 cents a sq ft at issue, plus $25 for zoning: about $1,425 on 2,000 sq ft</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">County permit, manufactured home</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="What it costs">$150 plus zoning fees, after a $5 registration with the assessor</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Zoning verification letter</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="What it costs">$25</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Rezoning, if your plan needs it</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="What it costs">$250 under 5 acres; $500 plus $10 an acre over 5 acres</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Impact fees</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="What it costs">Charged on new building since October 2021. We get the current amount for your plan.</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For a used manufactured home, all taxes on it must be paid before the county issues the permit.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">To buy a builder's house in a new community instead, see our guide to <a href="/buyers/new-construction/" style="color:var(--navy);text-decoration:underline">new construction in Horry County</a> and the <a href="/buyers/new-construction/builders/" style="color:var(--navy);text-decoration:underline">builders who build the most here</a>. For what is planned near a tract, see <a href="/invest/what-is-being-built/" style="color:var(--navy);text-decoration:underline">what is being built in Horry County</a>.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our affiliated lender, BrickWood Mortgage, a separate company, can explain land and construction loans.</p></div></section><section style="background:var(--ivory)" id="tax"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Farm land tax">Is farm and timber land taxed less in South Carolina?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, when it is in real farm or timber use and the owner applies to the assessor. The land is then taxed on its farm-use value, not its market value.</p><ul class="ld-list"><li><strong>Timber land</strong> must be 5 acres or more, with trees grown for sale.</li><li><strong>Other farm land</strong> must be 10 acres or more, or a smaller tract that earned at least $1,000 in gross farm income in three of five years.</li><li><strong>After a change of use, such as a new house,</strong> the land owes rollback taxes. They are the difference between the farm-use tax and the full tax, for the year of the change and up to three years before it.</li><li><strong>Your own home and up to 5 acres around it</strong> are taxed at the 4 percent rate when you live there and apply.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">How the county works out a tax bill is on our <a href="/buyers/property-taxes/" style="color:var(--navy);text-decoration:underline">Horry County property tax page</a>.</p></div></section><section style="background:var(--ivory-2)" id="buying-land-questions"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Buying land: questions</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can you do a perc test before buying land in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">South Carolina has not used perc tests since the late 1970s. The state's septic permit takes their place: a $150 application with the deed or the lot's survey map, then a soil visit. We can write your offer so it depends on the lot passing.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Where is the cheapest land for sale near Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Around Loris, Green Sea and Nichols, where an acre is listed at about $25,000 on tracts of an acre or more. Around Aynor it is about $40,000.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can you put a mobile home on land in Horry County?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the county's FA and CFA zones, yes, on a lot of at least half an acre. In the SF zones, no. Deed restrictions on the land can still bar one.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is there hunting land for sale in Horry County?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. In our count, 30 Horry land listings are marked for hunting. Tell us the size and the area you want, and we send you the tracts that fit.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What does land cost around Pawleys Island?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the Pawleys Island area, in Georgetown County, an acre is listed at about $342,000 on tracts of an acre or more. That is the highest of the areas we counted.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://des.sc.gov/permits-regulations/septic-tanks/homeowner-resources/septic-tanks-frequently-asked-questions" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC DES septic FAQ</a>, <a href="https://des.sc.gov/permits-regulations/septic-tanks/permits-licenses/septic-tanks-residential-single-home-builder" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">septic permit</a>, <a href="https://des.sc.gov/permits-regulations/septic-tanks/homeowner-resources/site-inspections" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">site inspections</a>, <a href="https://des.sc.gov/permits-regulations/septic-tanks/homeowner-resources/you-buy-land" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">before you buy land</a>, <a href="https://des.sc.gov/programs/bureau-water/residential-wells/private-drinking-water-wells" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">private wells</a>, <a href="https://www.gswsa.com/about_us.cfm?page=58" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">GSWSA</a>, <a href="https://www.horrycountysc.gov/media/i0pfcm2o/appendix-b-zoning-ordinance-upated-912026.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">county zoning ordinance</a>, <a href="https://www.horrycountysc.gov/media/tg5aree5/zoningdistricts.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">zoning districts</a>, <a href="https://www.horrycountysc.gov/departments/code-enforcement/permits/building-permit/cost-of-a-building-permit/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">permit fees</a>, <a href="https://www.horrycountysc.gov/media/e4hbjmgx/planning-and-zoning-fee-schedule-fy-2027.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">zoning fees</a>, <a href="https://horrycountysc.gov/news/articles/how-impact-fees-invest-in-horry-countys-future/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">impact fees</a>, <a href="https://www.horrycountysc.gov/departments/emergency-management/flooding/build-responsibly/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">flood rules</a>, <a href="https://www.scstatehouse.gov/code/t12c043.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-43</a>, <a href="https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County GIS</a>, <a href="https://www.scencyclopedia.org/sce/entries/horry-county/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Encyclopedia</a>, <a href="https://dnr.sc.gov/water/river/scenic/littlepeedee.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SCDNR</a>, <a href="https://www.sctrails.net/trails/trail/cartwheel-bay-heritage-preserve" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Cartwheel Bay</a>, <a href="https://www.horrycountysc.gov/departments/parksandrecreation/boat-landings/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">boat landings</a>. Our counts: CCMLS land listings in aggregate, with the county map's zoning and flood zone at each listing's point.</p><div id="afba" style="margin:1.4rem 0 3rem;max-width:640px"><p style="font-size:1rem;color:var(--muted);line-height:1.7;margin-bottom:.4rem"><strong style="color:var(--navy)">Affiliated Business Arrangement Disclosure.</strong> Chapter3 Realty Corp has a business relationship with BrickWood Mortgage (NMLS #189497). Because of this relationship, referrals to BrickWood Mortgage may provide Chapter3 Realty a financial or other benefit.</p><p style="font-size:1rem;color:var(--muted);line-height:1.7">You are NOT required to use BrickWood Mortgage as a condition for the purchase, sale, or refinance of any property. There are frequently other settlement service providers available with similar services. You are free to shop around to determine that you are receiving the best services and the best rate for those services.</p></div><style>.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Country land outside Loris from above: wide lots along two country roads, plowed fields, pine woods and a wet hollow. Photo: USDA Farm Service Agency, NAIP, <a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href=