+<script type="application/ld+json">{"@context":"https://schema.org","@type":"Article","@id":"https://chapter3realty.com/buyers/property-records/gis-map/#article","headline":"Horry County GIS map: get past the sign-in, find any parcel, and read its lines, acreage and zoning","description":"The Horry County GIS parcel map now asks for a county sign-in. How to get in, search by address, owner or PIN, and read lot lines, acreage and zoning.","url":"https://chapter3realty.com/buyers/property-records/gis-map/","author":{"@type":"Person","@id":"https://chapter3realty.com/about/#devin-day","name":"Devin Day","jobTitle":"Operations Officer","url":"https://chapter3realty.com/about/","worksFor":{"@id":"https://chapter3realty.com/#org"}},"reviewedBy":{"@type":"Person","@id":"https://chapter3realty.com/about/#timmy-nash","name":"Timothy Nash","alternateName":"Tim Nash","jobTitle":"Broker-in-Charge","url":"https://chapter3realty.com/about/","worksFor":{"@id":"https://chapter3realty.com/#org"}},"publisher":{"@id":"https://chapter3realty.com/#org"},"datePublished":"2026-11-13","dateModified":"2026-11-14","inLanguage":"en-US","image":"https://chapter3realty.com/og/buyers-property-records-gis-map.jpg","mainEntityOfPage":{"@id":"https://chapter3realty.com/buyers/property-records/gis-map/"},"about":{"@type":"Thing","name":"The Horry County GIS parcel map, Horry County, South Carolina"},"keywords":"Horry County GIS, Horry County GIS map, Horry County GIS login, Horry County parcel search, Horry County tax map, Horry County tax map number, TMS number, PIN number lookup, Horry County property lines, Horry County zoning map, Horry County zoning codes CFA FA, Georgetown County GIS, Pawleys Island tax map"}</script>
+<script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Do I need an account to use the Horry County GIS map?","acceptedAnswer":{"@type":"Answer","text":"Yes. The parcel map asks for a sign-in with a county website account. Choose Register on the sign-in screen to make one. The same account opens the county's Land Records app."}},{"@type":"Question","name":"Does the county charge for a GIS map account?","acceptedAnswer":{"@type":"Answer","text":"The sign-up form shows no fee and has no payment step. To skip the account, send us the address and we pull the parcel card for you."}},{"@type":"Question","name":"Can I search the Horry County GIS map by owner name?","acceptedAnswer":{"@type":"Answer","text":"Yes. On the Search tab, choose Owner and type the name. The map matches every word you type anywhere in the owner's name, so the order of the words does not matter."}},{"@type":"Question","name":"What if my parcel has no TMS number?","acceptedAnswer":{"@type":"Answer","text":"Search by PIN or by address instead. About 1 in 4 parcels on the Horry County map shows no TMS, but every parcel has an 11-digit PIN."}},{"@type":"Question","name":"Does the Horry County GIS map show what a house is worth?","acceptedAnswer":{"@type":"Answer","text":"No. The parcel card shows who owns the lot, its size and its zoning, but no value for the home and no tax. An agent prices a home from recent sales of homes like it."}},{"@type":"Question","name":"Can I print the Horry County GIS map?","acceptedAnswer":{"@type":"Answer","text":"Yes. The Tools tab has Print Map, next to the measuring tools for distance and area."}},{"@type":"Question","name":"Is Chapter3 part of Horry County?","acceptedAnswer":{"@type":"Answer","text":"No. Chapter3 is a real estate brokerage. The GIS map belongs to Horry County. We pull a lot's county records for buyers and owners, free."}}]}</script>
