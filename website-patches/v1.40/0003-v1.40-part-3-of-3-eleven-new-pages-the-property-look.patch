1 0-3-3M3 12.5h15a3 3 0 1 1-3 3M3 16.5h6"/></svg></span><span><strong>Insurance</strong><span class="t">$170</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span><span><strong>HOA fee</strong><span class="t">$100</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span><strong>Upkeep</strong><span class="t">$270</span></span></li></ul></div><p style="color:var(--muted);font-size:.9rem;margin-bottom:1rem">By <strong style="color:var(--navy);font-weight:600">Devin Day</strong>, Operations Officer &middot; Reviewed by <strong style="color:var(--navy);font-weight:600">Tim Nash</strong>, Broker-in-Charge &middot; <span style="white-space:nowrap">Updated November 14, 2026</span></p><p class="detail-sub">A typical $350,000 house in Horry County costs about $650 a month to own besides the loan, $7,850 a year. Each part is below, town by town.</p></div></div><section style="background:var(--ivory)"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">The short answer</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A typical house in Horry County, about $350,000, costs about $650 a month to own if you live in it, about $7,850 a year. That does not count the loan payment: paying back the loan and its interest.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In Myrtle Beach and North Myrtle Beach, a typical condo costs more to own each year than a typical house. The condo fee is the reason: condo owners pay it for the building they share. A second home pays about three times the property tax, about $2,900 more a year.</p></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><p style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Found a home? We work out its tax and fees before you offer.</p><a class="btn btn-brass btn-lg" href="/contact/?topic=cost-to-own">Talk to a specialized agent</a></div></section><section style="background:var(--ivory);padding-top:2.5rem"><div class="wrap"><nav aria-label="On this page" style="margin-top:0;max-width:720px"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.3rem;font-weight:600">On this page</p><ul style="list-style:none;margin:0;padding:0"><li><a href="#yearly-total" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">The yearly total</a></li><li><a href="#condo-or-house" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Condo or house</a></li><li><a href="#second-home-tax" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Second home tax</a></li><li><a href="#insurance" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Insurance</a></li><li><a href="#upkeep" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Upkeep</a></li><li><a href="#utilit