0.5c1.7 1.2 3.3 1.2 5 0s3.3-1.2 5 0 3.3 1.2 5 0 3.3-1.2 5 0"/></svg></span><span><strong>Houses for sale in the flood zone</strong><span class="t">8 in 10 listings do not say so</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8.5h10.5a3 3 0 1 0-3-3M3 12.5h15a3 3 0 1 1-3 3M3 16.5h6"/></svg></span><span><strong>One flood outside the zone</strong><span class="t">$26,400 paid</span></span></li></ul></div><p style="color:var(--muted);font-size:.9rem;margin-bottom:1rem">By <strong style="color:var(--navy);font-weight:600">Devin Day</strong>, Operations Officer &middot; Reviewed by <strong style="color:var(--navy);font-weight:600">Tim Nash</strong>, Broker-in-Charge &middot; <span style="white-space:nowrap">Updated November 12, 2026</span></p><p class="detail-sub">The costliest mistake is paying the second-home 6 percent tax on a home you live in: about $2,930 a year on a $350,000 house. Nine more follow, by cost.</p></div></div><section style="background:var(--ivory)"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">The short answer</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Of people who bought a house in Horry County in 2024 and have its tax bill mailed to that house, about 1 in 7 are still taxed at 6 percent. That is the rate for second homes and rentals. It is the costliest mistake here, and it comes back every year until they apply for the 4 percent rate for the home they live in.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The seller's low tax bill, flood insurance and wind cover come next.</p></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><p style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Found a house? We can check it for these mistakes before you offer.</p><a class="btn btn-brass btn-lg" href="/contact/">Have us check a house</a></div></section><section style="background:var(--ivory-2)" id="the-list"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The ten mistakes">What are the biggest mistakes when buying a house in Myrtle Beach?</h2><style>main#main .c3-glance li{line-height:1.4}main#main .c3m-rank{list-style:none;margin:1.2rem 0 1.4rem;padding:0;display:grid;grid-template-columns:1fr;gap:.6rem;max-width:920px}@media (min-width:760px){main#main .c3m-rank{grid-template-columns:1fr 1fr}}main#main .c3m-rank li{margin:0;padding:.8rem 1rem .85rem .85rem;border-radius:18px;background:linear-gradient(180deg,rgba(255,255,255,.8),rgba(255,255,255,.56));border:1px solid rgba(255,255,255,.85);box-shadow:inset 0 1px 0 rgba(255,255,255,.95),0 1px 2px rgba(28,32,40,.05),0 12px 30px -18px rgba(28,32,40,.32);display:grid;grid-template-columns:2.2rem minmax(0,1fr);column-gap:.75rem;align-items:start}main#main .c3m-rank .n{flex:none;display:inline-flex;align-items:center;justify-content:center;border-radius:50%;color:var(--g-ink,#8a5226);background:rgba(196,120,58,.13);width:2.2rem;height:2.2rem;font-family:var(--serif);font-weight:600;font-size:1.05rem}main#main .c3m-rank a{color:var(--navy);font-weight:600;font-size:var(--read,1.0625rem);line-height:1.35;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.18em}main#main .c3m-rank .c{display:block;margin-top:.2rem;color:var(--muted);font-size:1rem;line-height:1.45}main#main .c3m-rank .c strong{color:var(--g-ink,#8a5226);font-weight:600}main#main .c3m-rank .w{display:block;margin-top:.25rem;color:var(--navy);font-size:.95re