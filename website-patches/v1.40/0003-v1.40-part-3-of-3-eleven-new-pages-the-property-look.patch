+  + `${S} svg.mbc-n{display:block;width:100%;height:auto;max-width:340px;margin:0 auto}${S} svg.mbc-w{display:none;width:100%;height:auto}`
+  + `@media (min-width:600px){${S} svg.mbc-n{display:none}${S} svg.mbc-w{display:block}}`
