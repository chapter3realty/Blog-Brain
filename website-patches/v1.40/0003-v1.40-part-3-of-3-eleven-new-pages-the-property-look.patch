n fill(s){if(s.getAttribute("data-done"))return;s.setAttribute("data-done","1");fetch("/homes/api/strip?"+s.getAttribute("data-q"),{credentials:"same-origin"}).then(function(r){return r.ok?r.json():null}).then(function(j){if(!j||!j.ok||!j.html||j.html.indexOf("hx-s-empty")>-1)return;var hd=document.createElement("p");hd.className="hx-s-head";var b=document.createElement("b");b.textContent=s.getAttribute("data-head");hd.appendChild(b);if(j.link&&j.link.charAt(0)==="/"){var a=document.createElement("a");a.href=j.link;a.textContent="See all";hd.appendChild(a)}var row=document.createElement("div");row.className="hx-s-row";row.innerHTML=j.html;s.appendChild(hd);s.appendChild(row);if(j.note){var n=document.createElement("p");n.className="hx-s-note";n.textContent=j.note;s.insertBefore(n,row)}}).catch(function(){})}function go(){var all=[].slice.call(document.querySelectorAll(".hx-qs[data-q]"));if(!("IntersectionObserver" in window)){all.forEach(fill);return}var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){io.unobserve(e.target);fill(e.target)}})},{rootMargin:"600px 0px"});all.forEach(function(s){io.observe(s)})}if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",go);else go()})();</script><p class="gm-cta-row"><a class="gm-go" href="https://www.horrycountysc.gov/gis/parcels" target="_blank" rel="noopener">Open the county GIS map<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a></p><p class="gm-go-note">The map belongs to Horry County. Chapter3 is a real estate brokerage, not the county.</p><ol class="gm-steps"><li><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><div><h3>Make a county account, then sign in.</h3><p>Choose <a href="https://www.horrycountysc.gov/register" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Register</a> on the sign-in screen. The form asks for your name, email, mailing address and phone, and it has no payment step. The sign-in may also ask for a code.</p></div></li><li><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span><div><h3>Search by address, owner, PIN or TMS.</h3><p>Open the Search tab and pick one. The PIN works on every lot. About 1 in 4 lots has no TMS on the map.</p></div></li><li><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span><div><h3>Click the lot.</h3><p>A card opens with the county's facts about that piece of land. Zoom in close to see the lengths of the lines.</p></div></li></ol><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">No county account? Send us the address.</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We pull the parcel, the recorded plat and the flood zone for you, free.</p><a class="btn btn-brass" href="/contact/">Have us pull the parcel</a></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Deeds, tax bills and the county's other records are in our <a href="/buyers/property-records/" style="color:var(--navy);text-decoration:underline">Horry County property records guide</a>.</p></div></section><section style="background:var(--ivory)" id="parcel-card"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">What does the parcel card tell you?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The parcel card is the box that opens when you click a lot on the map.</p><figure class="gm-fig"><div class="gm-card" role="img" aria-label="A drawing of the parcel card on the Horry County GIS map, with a plain meaning beside each field: owner name, PIN, TMS, zoning code, acreage, square footage, deed book and page, date transferred and soil type."><div class="hd"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg><span>Parcel details</span></div><dl><div class="r"><dt>Owner Name</dt><dd>Who owns the lot.</dd></div><div class="r"><dt>PIN</dt><dd>The 11-digit number every county office uses for the lot.</dd></div><div class="r"><dt>TMS</dt><dd>The 10-digit tax map number.</dd></div><div class="r"><dt>Zoning Code</dt><dd>What the county allows on the lot, outside the towns.</dd></div><div class="r"><dt>Acreage</dt><dd>The lot's size in the county's records.</dd></div><div class="r"><dt>Square Footage</dt><dd>The area of the shape drawn on the map.</dd></div><div class="r"><dt>Deed Book, Deed Page</dt><dd>Where the deed is filed at the Register of Deeds.</dd></div><div class="r"><dt>Date Transferred</dt><dd>When the lot last changed hands.</dd></div><div class="r"><dt>Soil Type</dt><dd>The soil under the lot, by name.</dd></div></dl></div><figcaption>A drawing of the card the county map shows when you click a lot, with what each field means. The card also shows the lot number, the tax district and the legal description.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The card shows no value for the home and no tax. For what a home could sell for, see <a href="/sell/home-value/" style="color:var(--navy);text-decoration:underline">what homes like yours sold for</a>. With the PIN from the card, you can find <a href="/buyers/property-records/tax-bill/" style="color:var(--navy);text-decoration:underline">the lot's tax bill</a>.</p></div></section><section style="background:var(--ivory-2)" id="property-lines"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Property lines">How do I find property lines in Horry County?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Zoom in on the county map until the lot lines show their lengths. Then use the map's own tools to measure and compare.</p><ul class="gm-list"><li><strong>Read the line lengths.</strong> At close zoom, about 2 of every 3 line pieces show their length in whole feet.</li><li><strong>Measure a fence run.</strong> On the Tools tab, Measurement Tools has Distance and Area.</li><li><strong>Turn on Building Footprints.</strong> We checked the layer: the map draws 417,124 building outlines, so you can see the house and the shed against the lines.</li><li><strong>Find the recorded plat.</strong> A plat is the surveyor's drawing of the lot, filed with the county. Our <a href="/buyers/property-records/deeds/" style="color:var(--navy);text-decoration:underline">deed and plat search guide</a> shows how to find it.</li></ul><figure class="gm-fig gm-small"><div class="gm-draw"><svg class="gm-lines" viewBox="0 0 560 290" role="img" aria-label="A drawing of one lot from above. A solid line joins four corner markers set by a surveyor. A thin dashed line, the county map's line, runs close to it but not on it."><rect x="0" y="0" width="560" height="290" rx="14" fill="#eef1e8"/><rect x="190" y="100" width="170" height="100" rx="4" fill="#d9d3c7" stroke="#8b8478" stroke-width="2"/><text x="275" y="160" text-anchor="middle">House</text><polygon points="70,46 470,40 486,236 64,244" fill="none" stroke="#1c2028" stroke-width="4" stroke-linejoin="round"/><polygon points="80,56 484,34 494,248 76,248" fill="none" stroke="#2f6f8f" stroke-width="2.5" stroke-dasharray="9 7" stroke-linejoin="round"/><circle cx="70" cy="46" r="7" fill="#c4783a" stroke="#fff" stroke-width="2.5"/><circle cx="470" cy="40" r="7" fill="#c4783a" stroke="#fff" stroke-width="2.5"/><circle cx="486" cy="236" r="7" fill="#c4783a" stroke="#fff" stroke-width="2.5"/><circle cx="64" cy="244" r="7" fill="#c4783a" stroke="#fff" stroke-width="2.5"/></svg><div class="gm-key"><span class="s">The surveyed line and its corner markers</span><span class="d">The county map's line, drawn for taxes</span></div></div><figcaption>A drawing, not a real lot. The county draws its lines for taxes. A licensed surveyor finds and marks the corners on the ground.</figcaption></figure></div></section><section style="background:var(--ivory)" id="accuracy"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Accuracy">Is the Horry County GIS map accurate?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The county map is close enough to find a lot, but not close enough to place a fence. The county's <a href="https://www.horrycountysc.gov/gis/parcels/disclaimer" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">disclaimer</a> says its map shows parcels "as used for taxing purposes and not for survey purposes."</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The county keeps two sizes for many lots: the acreage it lists and the area of the shape it draws. We checked every lot the county lists with an acreage, 85,490 lots, and set the two side by side.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On 4 in 5 of those lots, the two are within 5% of each other. About 1 in 10 is drawn more than 10% bigger or smaller. On a one-acre lot, 10% is about 4,400 square feet.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="Half-acre to one-acre lots are drawn off their listed size most often"><span class="cap" aria-hidden="true">Half-acre to one-acre lots are drawn off their listed size most often</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Listed lot size</span><span role="columnheader">Drawn more than 10% off</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Under a quarter acre</span></span><span role="cell"><span class="b" style="--f:0.235" aria-hidden="true"></span><span class="v">5%</span></span></div><div role="row"><span role="rowheader"><span class="n">A quarter to a half acre</span></span><span role="cell"><span class="b" style="--f:0.525" aria-hidden="true"></span><span class="v">11%</span></span></div><div role="row"><span role="rowheader"><span class="n">A half acre to 1 acre</span></span><span role="cell"><span class="b" style="--f:0.895" aria-hidden="true"></span><span class="v">18%</span></span></div><div role="row"><span role="rowheader"><span class="n">1 to 5 acres</span></span><span role="cell"><span class="b" style="--f:0.66" aria-hidden="true"></span><span class="v">13%</span></span></div><div role="row"><span role="rowheader"><span class="n">5 acres or more</span></span><span role="cell"><span class="b" style="--f:0.5" aria-hidden="true"></span><span class="v">10%</span></span></div></div></div><figcaption>Share of lots drawn more than 10% bigger or smaller than their listed acreage, by listed lot size. 85,490 lots the county map lists with an acreage. Our count from the county's parcel layer.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The differences go both ways: about half of these lots are drawn bigger than listed, and half smaller. The listed acreage and the drawn shape come from different county records, and neither is a survey. A difference shows the two disagree, not which one is right.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You can see both on the card. Acreage is the listed size, and Square Footage is the drawn shape's area. One acre is 43,560 square feet.</p><div class="hx-strip hx-qs" data-q="type=house&amp;lotMin=1" data-head="Houses on an acre or more"></div></div></section><section style="background:var(--ivory-2)" id="surveyor"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Surveyors">When do you need a surveyor?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You need a licensed surveyor whenever a decision depends on exactly where the line is on the ground.</p><ul class="gm-list"><li><strong>A fence or a wall near a line.</strong> The county map does not show which side of the line a post is on.</li><li><strong>An addition, a pool or a shed near a side line.</strong> The zoning code says how far a building must stay from the lines. In the SF 10 district, a house stays at least 10 feet from each side line (<a href="#zoning" style="color:var(--navy);text-decoration:underline">zoning codes</a>).</li><li><strong>A disagreement with a neighbor about the line.</strong></li><li><strong>Buying land, or splitting a lot.</strong> The acreage on the map is not a survey.</li><li><strong>An HOA that asks for a surveyor's drawing</strong> before a fence or a shed, as <a href="/submarkets/carolina-forest/the-farm/" style="color:var(--navy);text-decoration:underline">The Farm in Carolina Forest</a> does.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">South Carolina licenses land surveyors through its <a href="https://llr.sc.gov/eng/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Board of Registration for Professional Engineers and Surveyors</a>. The board's <a href="https://verify.llronline.com/LicLookup/Engineers/Engineer.aspx?div=50" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">licensee lookup</a> shows whether a surveyor holds a license.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Buying a lot or a house with land? We check the lines before you offer.</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We pull the county's records on the lot and tell you whether it needs a survey.</p><a class="btn btn-brass" href="/contact/">Have us check the lines</a></div></div></section><section style="background:var(--ivory)" id="tax-map-number"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Tax map number">What is the Horry County tax map number?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The tax map number, or TMS, is a 10-digit number the county gives a parcel to identify it and place it on the map. The parcel card shows two numbers, the TMS and the PIN.</p><div style="overflow-x:auto;margin:1.2rem 0;max-width:760px"><table style="width:100%;border-collapse:collapse;font-size:.92rem"><thead><tr><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Number</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Digits</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Shown on the map for</th></tr></thead><tbody><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">PIN</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Digits">11</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Shown on the map for">Every lot</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">TMS, the tax map number</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Digits">10</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Shown on the map for">About 3 in 4 lots</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For a lot with no TMS, search by PIN or address. The county's <a href="https://www.horrycountysc.gov/departments/assessor/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">tax estimator</a> asks for the PIN.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For what the tax on a home will be, use our <a href="/buyers/property-taxes/" style="color:var(--navy);text-decoration:underline">Horry County property tax guide</a>. To find and pay a bill, see <a href="/buyers/property-records/tax-bill/" style="color:var(--navy);text-decoration:underline">how to look up a tax bill</a>.</p></div></section><section style="background:var(--ivory-2)" id="zoning"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Zoning codes">What do zoning codes like CFA, FA and SF 10 mean?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The zoning code on the parcel card tells you what the county allows on the lot and how far a house must stay from its lines. The table shows six codes you will see often on the county map.</p><div style="overflow-x:auto;margin:1.2rem 0;max-width:760px"><table style="width:100%;border-collapse:collapse;font-size:.92rem"><thead><tr><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Code</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Name</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">What it allows</th></tr></thead><tbody><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">CFA</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Name">Commercial Forest Agriculture</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="What it allows">Farms, forestry, homes, businesses, churches and recreation</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">FA</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Name">Forest and Agriculture</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="What it allows">Farms, forestry, and homes, businesses and churches at low density</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">HC</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Name">Highway Commercial</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="What it allows">Businesses along the county's roads</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">SF 10</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Name">Single Family</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="What it allows">Houses on lots of at least 10,000 square feet</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">MSF 10</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Name">Manufactured Single Family</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="What it allows">Houses or manufactured homes on lots of at least 10,000 square feet</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">SF 20</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="Name">Single Family</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)" data-l="What it allows">Houses on lots of at least 20,000 square feet</td></tr></tbody></table></div><ul class="gm-list"><li><strong>How far a house stays from the lines.</strong> In SF 10 and MSF 10, at least 25 feet from the front line, 10 feet from each side and 15 feet from the back. The full table is in the county's <a href="https://www.horrycountysc.gov/media/i0pfcm2o/appendix-b-zoning-ordinance-upated-912026.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">zoning ordinance</a>.</li><li><strong>Inside the towns.</strong> In Myrtle Beach, North Myrtle Beach, Conway, Surfside Beach and the county's other towns, the county map shows no zoning code. The town's own zoning applies there.</li><li><strong>How tall at the beach.</strong> The county map's Garden City overlay marks height zones of 35, 80, 120 and 180 feet. The ordinance allows new buildings in <a href="/submarkets/garden-city/" style="color:var(--navy);text-decoration:underline">Garden City</a> up to 35 feet. The exceptions are the areas its map shows and a Planned Development District, where up to 180 feet may be approved.</li></ul></div></section><section style="background:var(--ivory)" id="aerials"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Old aerial photos">See the land in 1998, and every few years since</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The map's Imagery tab holds the county's own aerial photos from 11 years, from 1998 to 2026.</p><figure class="gm-fig"><div class="gm-years" role="img" aria-label="The county's aerial photo years on the GIS map: 1998, 2001, 2005, 2008, 2009, 2010, 2014, 2017, 2020, 2023, 2026. The first two are black and white; the rest are in color."><ol><li class="bw">1998</li><li class="bw">2001</li><li>2005</li><li>2008</li><li>2009</li><li>2010</li><li>2014</li><li>2017</li><li>2020</li><li>2023</li><li>2026</li></ol><div class="k"><span class="bw">Black and white</span><span>Color</span></div></div><figcaption>The 11 years of county aerial photos on the map's Imagery tab, each about 6 inches a pixel.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Click through the years to see when a house went up and what stood on the land before it. A street of new houses looks like this from above.</p><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);letter-spacing:.01em;color:#fff;text-align:right;background:radial-gradient(farthest-side at 100% 100%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.c3ph-cr a{color:#fff;text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);text-underline-offset:2px;pointer-events:auto;padding:10px 0 6px}.c3ph-hero{margin:1.6rem 0 2rem}.c3ph-hero .c3ph-f{border-radius:8px}.c3ph-hero img{aspect-ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}</style><figure class="c3ph-hero" style="max-width:720px;"><div class="c3ph-f"><img src="/images/2026-11-a/submarkets-north-myrtle-beach/west-of-us-17-new-streets-from-above-1200w.webp" srcset="/images/2026-11-a/submarkets-north-myrtle-beach/west-of-us-17-new-streets-from-above-600w.webp 600w, /images/2026-11-a/submarkets-north-myrtle-beach/west-of-us-17-new-streets-from-above-1200w.webp 1200w" sizes="(max-width: 760px) 100vw, 720px" width="1200" height="857" alt="From above: new streets and ponds cleared for houses labelled West of US 17, ball fields labelled Central Park, and the highway labelled US 17" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo. License: Public domain" title="License: Public domain">U.S. government aerial photo</a></span></div><figcaption>New streets cleared for houses west of US 17 in North Myrtle Beach, seen from above. A run of aerial photos shows the year a street like this was built.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On the Legend tab, these layers are worth turning on:</p><ul class="gm-list"><li><strong>Flood Zones.</strong> FEMA's flood zone codes, such as AE and VE. Our <a href="/buyers/flood-zone-check/" style="color:var(--navy);text-decoration:underline">flood zone guide</a> says what each one means for a buyer.</li><li><strong>Contours.</strong> Lines every 2 feet of height, to see which part of a lot is lowest. For a house's own flood history, see <a href="/buyers/undisclosed-flooding/" style="color:var(--navy);text-decoration:underline">how to find out if a house flooded</a>.</li><li><strong>Soils.</strong> Each soil area by name, the same name the parcel card gives.</li><li><strong>Interstate 73.</strong> The planned route of the new interstate.</li><li><strong>Airport Overlays.</strong> The zones the county draws around its airports.</li></ul></div></section><section style="background:var(--ivory-2)" id="georgetown"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Georgetown County">Georgetown County GIS for Pawleys Island and Litchfield</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="/submarkets/pawleys-island/" style="color:var(--navy);text-decoration:underline">Pawleys Island</a> and Litchfield are in Georgetown County, and its <a href="https://experience.arcgis.com/experience/fa729743d97047579f348d68f9643ba1" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">GIS One Map</a> opens with no sign-in. Search it by TMS number, address or road name.</p><ul class="gm-list"><li><strong>The TMS has 13 digits, typed with hyphens,</strong> in the county's own format: <span class="gm-nw">05-0029-049-00-00</span>.</li><li><strong>Addresses spell out the direction and shorten the road type:</strong> SOUTH HAZARD ST, not S HAZARD ST, and HAGLEY DR, not HAGLEY DRIVE.</li><li><strong>To search by owner name,</strong> use the <a href="https://www.georgetowndeeds.com/NameSearch.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Register of Deeds name search</a>. The map also links the Assessor's qPublic database.</li><li><strong>About 2 in 3 parcels have a plat reference.</strong> In the deeds search, a plat slide needs an S in front, as in S839-2.</li><li><strong>The state's beachfront lines are a layer:</strong> the baseline and the setback line along the ocean, the lines an oceanfront buyer asks about.</li><li><strong>The Swipe tool compares two aerial years,</strong> for example 2022 and 2024.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Georgetown's map has the same warning as Horry's: its layers do not replace a legal survey, deed or plat. Questions about the map go to the county's <a href="https://gtcountysc.gov/260/GIS-Asset-Management" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">GIS office</a>.</p><div class="hx-strip hx-qs" data-q="city=Pawleys+Island&amp;type=house" data-head="Houses for sale in Pawleys Island"></div></div></section><section style="background:var(--ivory)" id="horry-county-gis-map-questions"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Horry County GIS map questions</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do I need an account to use the Horry County GIS map?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. The parcel map asks for a sign-in with a county website account. Choose Register on the sign-in screen to make one. The same account opens the county's Land Records app.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does the county charge for a GIS map account?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The sign-up form shows no fee and has no payment step. To skip the account, send us the address and we pull the parcel card for you.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I search the Horry County GIS map by owner name?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. On the Search tab, choose Owner and type the name. The map matches every word you type anywhere in the owner's name, so the order of the words does not matter.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What if my parcel has no TMS number?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Search by PIN or by address instead. About 1 in 4 parcels on the Horry County map shows no TMS, but every parcel has an 11-digit PIN.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does the Horry County GIS map show what a house is worth?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. The parcel card shows who owns the lot, its size and its zoning, but no value for the home and no tax. An agent prices a home from recent sales of homes like it.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I print the Horry County GIS map?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. The Tools tab has Print Map, next to the measuring tools for distance and area.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is Chapter3 part of Horry County?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. Chapter3 is a real estate brokerage. The GIS map belongs to Horry County. We pull a lot's county records for buyers and owners, free.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.horrycountysc.gov/gis/parcels" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County GIS map</a>, <a href="https://www.horrycountysc.gov/parcelapp/rest/services/HorryCountyGISApp/MapServer" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">parcel layer</a>, <a href="https://www.horrycountysc.gov/tax-payer-services/real-property-tax/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">tax map number</a>, <a href="https://www.horrycountysc.gov/departments/assessor/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Assessor</a>, <a href="https://www.horrycountysc.gov/media/i0pfcm2o/appendix-b-zoning-ordinance-upated-912026.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">zoning ordinance</a>, <a href="https://www.horrycountysc.gov/departments/planning-and-zoning/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Planning and Zoning</a>, <a href="https://experience.arcgis.com/experience/fa729743d97047579f348d68f9643ba1" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Georgetown One Map</a>, <a href="https://llr.sc.gov/eng/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC LLR</a>. Our count: the county's parcel layer, every lot with a listed acreage (85,490), drawn area against listed acreage. Not a survey and not legal advice.</p><style>.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">New streets cleared for houses west of US 17 in North Myrtle Beach, seen from above. Photo: USDA Farm Service Agency, NAIP, <a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://imagery.nationalmap.gov/arcgis/rest/services/USGSNAIPImagery/ImageServer" target="_blank" rel="noopener noreferrer">USGS The National Map</a>. Chapter3 Realty exported this view from the NAIP image service, raised the contrast a little and added labels placed from OpenStreetMap, Horry County and Census coordinates.</div><div role="listitem">Chapter3 Realty resized these photos and cropped some of them.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-11-a/submarkets-north-myrtle-beach/west-of-us-17-new-streets-from-above-1200w.webp","url":"https://chapter3realty.com/images/2026-11-a/submarkets-north-myrtle-beach/west-of-us-17-new-streets-from-above-1200w.webp","width":1200,"height":857,"encodingFormat":"image/webp","name":"New streets cleared for houses west of US 17 in North Myrtle Beach, seen from above","caption":"New streets cleared for houses west of US 17 in North Myrtle Beach, seen from above. A run of aerial photos shows the year a street like this was built.","description":"From above: new streets and ponds cleared for houses labelled West of US 17, ball fields labelled Central Park, and the highway labelled US 17","creator":{"@type":"Organization","name":"USDA Farm Service Agency, NAIP"},"creditText":"USDA Farm Service Agency, NAIP, public domain, via USGS The National Map","copyrightNotice":"Public domain (USDA Farm Service Agency, NAIP)","license":"https://www.fsa.usda.gov/help/policies-and-links/","acquireLicensePage":"https://imagery.nationalmap.gov/arcgis/rest/services/USGSNAIPImagery/ImageServer","isBasedOn":"https://imagery.nationalmap.gov/arcgis/rest/services/USGSNAIPImagery/ImageServer","contentLocation":{"@type":"Place","name":"West of US 17, Central Park, North Myrtle Beach, South Carolina"},"representativeOfPage":true}]}</script></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Send us the address. We pull the parcel, the plat and the flood zone.</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">You need no county account. An agent sends you the county's facts about that lot, free.</p><a class="btn btn-brass btn-lg" href="/contact/">Send us the address</a></div></section></main>
