0M10 20.5V15h4v5.5"/></svg></span><span><strong>Condos</strong><span class="t">298</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 5h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM3 10h18M8 3v4M16 3v4M8 14h.01M12 14h.01M16 14h.01M8 17.5h.01M12 17.5h.01"/></svg></span><span><strong>Built</strong><span class="t">Mid-1980s</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span><strong>Nightly rentals</strong><span class="t">Allowed</span></span></li></ul></div><p style="color:var(--muted);font-size:.9rem;margin-bottom:1rem">By <strong style="color:var(--navy);font-weight:600">Devin Day</strong>, Operations Officer &middot; Reviewed by <strong style="color:var(--navy);font-weight:600">Tim Nash</strong>, Broker-in-Charge &middot; <span style="white-space:nowrap">Updated November 14, 2026</span></p><p class="detail-sub">Two pools on the ocean with a putting green beside them, and three 40-foot water slides at the resort next door, at 1605 S Ocean Blvd.</p></div></div><section style="background:var(--ivory)"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">The short answer</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Palace Resort is a 241-foot tower on the beach at the south end of Myrtle Beach. It holds 298 condos you can own: studios, one-bedrooms and two-bedrooms. The middle sale price over the past year was about $142,000.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The monthly HOA fee goes by the unit's size: about $460 for a studio, $685 for a one-bedroom and $915 for a two-bedroom. Units may rent by the night, and guests who book through the resort's own rental program get the water park next door.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Booking a stay instead? The resort takes reservations on <a href="https://www.palaceresort.com/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">its own website</a>.</p></div></section><section style="background:var(--ivory-2)"><div class="wrap"><style>@media (min-width:700px){main#main .detail-h1{text-wrap:balance}}main#main .detail-h1 em{display:block;font-size:clamp(1.3rem,2.5vw,2.25rem);line-height:1.25;margin-top:.55rem;text-wrap:balance}@media (max-width:959px){main#main .detail-h1 em{color:var(--g-ink,#8a5226)!important}}main#main .c3-glance li{line-height:1.4}main#main .c3-glance span.t{line-height:1.3}@media (max-width:699px){main#main .c3-glance{grid-template-columns:repeat(2,minmax(0,1fr))!important;column-gap:1rem!important;row-gap:0!important}main#main .c3-glance li{background:none!important;border:0!important;box-shadow:none!important;border-radius:0!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important;border-top:1px solid rgba(28,32,40,.16)!important;flex-direction:row!important;text-align:left!important;justify-content:flex-start!important;align-items:center!important;gap:.55rem!important;padding:.5rem 0!important;min-width:0}main#main .c3-glance li:nth-last-child(-n+2){border-bottom:1px solid rgba(28,32,40,.16)!important}}@media (max-width:359px){main#main .c3-glance li>span.i{display:none!important}main#main .c3-glance{column-gap:.8rem!important}}main#main h2{text-wrap:balance}main#main figure.c3ph-hero{backg