new file mode 100644
index 00000000..f2fb7c42
--- /dev/null
+++ b/data/2026-11-b/invest-non-warrantable-condos/pull_hud_all.py
@@ -0,0 +1,30 @@
+"""HUD FHA condo list (entp.hud.gov condo lookup), Horry County SC, every status, every result page.
+Pages are 25 rows; the 'next' form posts startAt=26, 51, ... and maxRows=50, 75, ... (read from each page's form). One cookie session, pages in order.
+Run: python3 -I pull_hud_all.py <this folder>. Writes raw/hud-condos-horry-X-p<n>.html and hud-horry-all.json
+(project name, ID, address, composition, status, status date, expiration date; public project records)."""
+import sys, re, html, json, time, urllib.request, urllib.parse, http.cookiejar
+out = sys.argv[1]
+cj = http.cookiejar.CookieJar(); op = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cj))
+UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/120 Safari/537.36"
+F = "https://entp.hud.gov/idapp/html/condlook.cfm"; R = "https://entp.hud.gov/idapp/html/condo1.cfm"
+def get(url, data=None, ref=None):
+    rq = urllib.request.Request(url, data=urllib.parse.urlencode(data).encode() if data else None, headers={"User-Agent": UA, **({"Referer": ref} if ref else {})})
+    return op.open(rq, timeout=90).read().decode("latin-1")
+get(F)
+base = dict(FAPPROVAL_METHOD="NEW", FSORTED_BY="condo_name", FSTATE="SC", FCOUNTY="HORRY", FCONDO_ID="", FCONDO_NAME="", FCITY="", FZIP="", FSTATUS_CODE="X", FSEARCH_TYPE="P", FBEGIN_MO="", FBEGIN_DY="", FBEGIN_YR="", FEND_MO="", FEND_DY="", FEND_YR="", CAME_FROM="oth", IN_FHAC="true")
+rows, page, ref, start, maxr = [], 1, F, None, None
+while True:
+    d = dict(base)
+    if start: d.update(startAt=start, maxRows=maxr, pageIn=F, thisPage="condo1.cfm")
+    s = get(R, d, ref); open(f"{out}/raw/hud-condos-horry-X-p{page}.html", "w").write(s)
+    got = 0
+    for r in re.findall(r"<tr[^>]*>(.*?)</tr>", s, re.S | re.I):
+        c = [re.sub(r"\s+", " ", html.unescape(re.sub(r"<[^>]+>", " ", x))).strip() for x in re.findall(r"<td[^>]*>(.*?)</td>", r, re.S | re.I)]
+        if len(c) >= 13 and c[3] == "HORRY COUNTY":
+            rows.append(dict(name=c[0], id=c[1], address=c[2], composition=c[4], fha_concentration=c[6], method=c[7], status=c[9], comments=c[10], status_date=c[11], expiration=c[12])); got += 1
+    m = re.search(r'name="startAt" value="(\d+)"', s); mx = re.search(r'name="maxRows" value="(\d+)"', s)
+    print(page, got, m.group(1) if m else None, flush=True)
+    if not got or not m: break
+    start, maxr, ref, page = m.group(1), mx.group(1), R, page + 1; time.sleep(1.5)
+json.dump({"read": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "source": F + " (State SC, County HORRY, Status All, Project search)", "records": rows}, open(f"{out}/hud-horry-all.json", "w"), indent=1)
+print(len(rows))
diff --git a/data/2026-11-b/invest-non-warrantable-condos/pull_owners.py b/data/2026-11-b/invest-non-warrantable-condos/pull_owners.py
new file mode 100644
index 00000000..ed945de9
--- /dev/null
+++ b/data/2026-11-b/invest-non-warrantable-condos/pull_owners.py
@@ -0,0 +1,59 @@
+"""Two of Fannie Mae's project tests, read from Horry County's parcel layer for the 47 oceanfront buildings in our directory.
+Source: https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer/24/query (one parcel per condo unit).
+Units: every parcel whose legal description starts with one of the building's county regime names
+(../invest-condo-buildings/regimes.json, the same match /invest/condo-buildings/ used) and that has a building value (MarketImprv > 0).
+Per regime (the county's name for one condo regime, which is the project a lender reviews; spellings that differ only in
+punctuation or spaces are one regime, e.g. 'PRINCE CONDO @ C.G PIER' and '@ C.G.PIER') and per building:
+  - units; units taxed at the 4% legal-residence ratio (AssessedProp / TaxableProp = 0.04), the rest at 6% or exempt;
+  - single-entity test: units held by the owner name that holds the most units (exact name after removing punctuation
+    and extra spaces), as a share of units; whether that owner name reads as a company or an association; never the name;
+  - owners whose mailing state is not SC.
+Nothing kept here names an owner, a PIN, a unit or a value. Run: python3 -I pull_owners.py <this folder> [regimes file; default regimes-fixed.json]. Writes owners.json."""
+import json, sys, time, re, urllib.request, urllib.parse, collections, datetime
+out = sys.argv[1]
+U = "https://www.horrycounty.org/parcelapp/rest/services/HorryCountyGISApp/MapServer/24/query"
+RF = sys.argv[2] if len(sys.argv) > 2 else f"{out}/regimes-fixed.json"  # CB regimes.json with the CB verifier row 5 fixes
+R = json.load(open(RF))["buildings"]
+COMPANY = re.compile(r"\b(LLC|L L C|INC|CORP|CORPORATION|CO|COMPANY|LP|LLP|LTD|PARTNERSHIP|HOLDINGS|PROPERTIES|INVESTMENTS|ENTERPRISES|GROUP|BANK|TRUST CO)\b")
+ASSOC = re.compile(r"\b(ASSOC|ASSN|ASSOCIATION|OWNERS|HOA|HPR|REGIME|COUNCIL OF CO.?OWNERS)\b")
+def norm(n): return re.sub(r"\s+", " ", re.sub(r"[^A-Z0-9 ]", " ", (n or "").upper())).strip()
+def kind(n):
+    n = n.split(" C O ")[0]  # classify the owner, not the "c/o" manager
+    if ASSOC.search(n): return "association"
+    if COMPANY.search(n): return "company"
+    return "person or trust"
+res = {"read": datetime.datetime.now(datetime.timezone.utc).isoformat(), "source": U, "regimes_file": RF.replace(out + "/", ""), "buildings": {}}
+for slug, names in R.items():
+    if not names: continue
+    where = "(" + " OR ".join("LegalDescr LIKE '" + n.replace("'", "''") + ";%'" for n in names) + ")"
+    feats, off = [], 0
+    while True:
+        q = {"where": where, "outFields": "LegalDescr,LandUseCode,MarketImprv,AssessedProp,TaxableProp,OwnerName,OwnerState", "returnGeometry": "false", "resultOffset": off, "resultRecordCount": 2000, "f": "json"}
+        j = json.load(urllib.request.urlopen(U + "?" + urllib.parse.urlencode(q), timeout=120)); time.sleep(0.5)
+        f = j.get("features", []); feats += f
+        if not j.get("exceededTransferLimit") or not f: break
+        off += len(f)
+    per = collections.defaultdict(list)
+    for x in feats:
+        a = x["attributes"]
+        if (a.get("MarketImprv") or 0) <= 0: continue
+        per[re.sub(r"[^A-Z0-9]", "", a["LegalDescr"].split(";")[0].upper())].append(a)  # one regime, however the county spells it
+    def stats(rows):
+        n = len(rows)
+        if not n: return {"units": 0}
+        r4 = sum(1 for a in rows if a.get("TaxableProp") and abs(a["AssessedProp"] / a["TaxableProp"] - 0.04) < 0.002)
+        own = collections.Counter(norm(a.get("OwnerName")) for a in rows)
+        top, topn = own.most_common(1)[0]
+        multi = [c for c in own.values() if c > 1]
+        oos = sum(1 for a in rows if (a.get("OwnerState") or "").upper() not in ("SC", ""))
+        return {"units": n, "legal_residence_4pct": r4, "legal_residence_share": round(100 * r4 / n, 1),
+                "not_legal_residence_share": round(100 * (n - r4) / n, 1),
+                "top_owner_units": topn, "top_owner_share": round(100 * topn / n, 1), "top_owner_kind": kind(top),
+                "owners": len(own), "owners_with_2plus_units": len(multi), "units_held_by_multi_owners": sum(multi),
+                "out_of_state_owner_units": oos, "out_of_state_share": round(100 * oos / n, 1),
+                "landuse_first_digit": dict(collections.Counter((a.get("LandUseCode") or "")[:1] + "xx" for a in rows))}
+    allrows = [a for v in per.values() for a in v]
+    res["buildings"][slug] = {"regimes": {k: stats(v) for k, v in per.items()}, "building": stats(allrows)}
+    b = res["buildings"][slug]["building"]
+    print(slug, b.get("units"), b.get("legal_residence_share"), b.get("top_owner_share"), b.get("top_owner_kind"), flush=True)
+json.dump(res, open(f"{out}/owners.json", "w"), indent=1)
diff --git a/data/2026-11-b/invest-non-warrantable-condos/pull_program.py b/data/2026-11-b/invest-non-warrantable-condos/pull_program.py
new file mode 100644
index 00000000..0ff64c66
--- /dev/null
+++ b/data/2026-11-b/invest-non-warrantable-condos/pull_program.py
@@ -0,0 +1,24 @@
+"""Rental-program share of condos for sale, per directory building, from the CRM's public map API (CCMLS active listings).
+For each building in ../invest-condo-buildings/buildings.json: total condos for sale matching its subdivision words, and how many
+carry the listing agent's 'vacation_rental_program' flag. Totals only; no listing is kept.
+Run: python3 -I pull_program.py <this folder>. Writes program.json (with every URL called)."""
+import json, sys, time, urllib.request, urllib.parse, datetime
+out = sys.argv[1]
+B = json.load(open(f"{out}/../invest-condo-buildings/buildings.json"))["buildings"]
+API = "https://chapter3realty.com/homes/api/map?"
+UA = {"User-Agent": "Mozilla/5.0 (research script)"}
+def total(p):
+    url = API + urllib.parse.urlencode(p)
+    for i in range(3):
+        try:
+            j = json.load(urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=60)); time.sleep(2.1); return j["total"], url
+        except Exception as e:
+            time.sleep(5)
+    raise SystemExit("failed " + url)
+res = {"read": datetime.datetime.now(datetime.timezone.utc).isoformat(), "api": API, "buildings": {}}
+for b in B:
+    p = {"type": "condo", "subdivision": b["words"]}
+    t, u1 = total(p); r, u2 = total(dict(p, has="vacation_rental_program"))
+    res["buildings"][b["slug"]] = {"for_sale": t, "in_program": r, "share": round(100 * r / t, 1) if t else None, "calls": [u1, u2]}
+    print(b["slug"], t, r, flush=True)
+json.dump(res, open(f"{out}/program.json", "w"), indent=1)
