+			<td style="text-align: right; width: 124px"><em>$87,550</em></td>
+			<td style="text-align: right; width: 124px">$787</td>
+			<td rowspan="2" style="vertical-align: middle; text-align: center; width: 124px">$230,050 x 2% =</td>
+			<td rowspan="2" style="vertical-align: middle; text-align: center; width: 124px">$4,601</td>
+		</tr>
+		<tr>
+			<td style="text-align: center; width: 124px">Investor</td>
+			<td style="text-align: right; width: 124px"><em>$142,500</em></td>
