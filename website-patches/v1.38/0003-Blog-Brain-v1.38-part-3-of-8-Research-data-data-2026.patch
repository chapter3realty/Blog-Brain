+<div id="" class="column">
+    <h2>Responsibilities</h2>
+    <div class="tabs " style="--number-of-tabs: 3; ">
+
+            <input id="0b540bb4-d467-4fbb-8324-e0d5bee38f6e" class="off-the-grid" type="radio" name="7199012f-0ff4-445a-85d9-9dfbc06838f4" />
