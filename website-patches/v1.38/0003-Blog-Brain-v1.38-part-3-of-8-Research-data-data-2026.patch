diff --git a/data/2026-11-a/buyers-relocating-why-myrtle-beach/rfa_projection.py b/data/2026-11-a/buyers-relocating-why-myrtle-beach/rfa_projection.py
new file mode 100644
index 00000000..977c0524
--- /dev/null
+++ b/data/2026-11-a/buyers-relocating-why-myrtle-beach/rfa_projection.py
@@ -0,0 +1,27 @@
+"""SC Revenue and Fiscal Affairs Office, Vintage 2023 population projections 2024-2043, Horry County total population by year.
+Input: raw/rfa-projections-components.xlsx from
+https://rfa.sc.gov/programs/census-state-liaison-and-data-center/search-and-download-population-data/rfa-population-projections
+Run: python3 -I rfa_projection.py <this dir>. Writes rfa-projection.json."""
+import sys, json, openpyxl
+D = sys.argv[1]
+wb = openpyxl.load_workbook(f"{D}/raw/rfa-projections-components.xlsx", read_only=True, data_only=True)
+ws = wb["TOTAL POPULATION"]
+rows = list(ws.iter_rows(values_only=True))
+hdr_i = next(i for i, r in enumerate(rows) if r and r[0] == "COUNTY")
+top, sub = rows[hdr_i], rows[hdr_i + 1]
+hr = next(r for r in rows if r and isinstance(r[0], str) and r[0].strip().upper() == "HORRY")
+sc = next(r for r in rows if r and isinstance(r[0], str) and r[0].strip().upper() == "SOUTH CAROLINA")
+out = {"source": "https://rfa.sc.gov/programs/census-state-liaison-and-data-center/search-and-download-population-data/rfa-population-projections", "horry": {}, "sc": {}}
+period = None
+for j, (t, s) in enumerate(zip(top, sub)):
+    if t: period = t
+    if isinstance(s, str) and "POPULATION" in s and "CHANGE" not in s.split("\n")[0]:
+        yr = s.split()[0]
+        out["horry"][yr] = hr[j]; out["sc"][yr] = sc[j]
+    if isinstance(s, str) and s.startswith("NET MIGRATION"):
+        out["horry"].setdefault("net_migration", {})[period] = hr[j]
+    if isinstance(s, str) and s.startswith("NATURAL CHANGE"):
+        out["horry"].setdefault("natural_change", {})[period] = hr[j]
+json.dump(out, open(f"{D}/rfa-projection.json", "w"), indent=1)
+print({k: v for k, v in out["horry"].items() if not isinstance(v, dict)})
+print("nm", out["horry"].get("net_migration")); print("nc", out["horry"].get("natural_change"))
diff --git a/data/2026-11-a/buyers-relocating-why-myrtle-beach/trim_raw.py b/data/2026-11-a/buyers-relocating-why-myrtle-beach/trim_raw.py
new file mode 100644
index 00000000..0951b9f8
--- /dev/null
+++ b/data/2026-11-a/buyers-relocating-why-myrtle-beach/trim_raw.py
@@ -0,0 +1,19 @@
+"""Cut the large public downloads in raw/ down to the rows the page uses, so the data folder stays small.
+The scripts read the trimmed files the same way. Full files: re-download from the URLs in README.md.
+Run once after downloading: python3 -I trim_raw.py <this dir>."""
+import csv, sys, os, glob
+D = sys.argv[1]; R = os.path.join(D, "raw")
+def trim(path, keep):
+    rows = list(csv.reader(open(path, encoding="latin-1")))
+    hdr = rows[0]; kept = [hdr] + [r for r in rows[1:] if keep(dict(zip(hdr, r)))]
+    w = csv.writer(open(path, "w", newline="", encoding="latin-1")); w.writerows(kept); print(path, len(rows) - 1, "->", len(kept) - 1)
+for f in glob.glob(os.path.join(R, "countyinflow*.csv")):
+    trim(f, lambda r: r["y2_statefips"].zfill(2) == "45" and r["y2_countyfips"].zfill(3) == "051")
+for f in glob.glob(os.path.join(R, "countyoutflow*.csv")):
+    trim(f, lambda r: r["y1_statefips"].zfill(2) == "45" and r["y1_countyfips"].zfill(3) == "051")
+trim(os.path.join(R, "co-est2025-alldata.csv"), lambda r: r["STATE"] == "45" and r["COUNTY"] == "051")
+trim(os.path.join(R, "cbsa-est2025-alldata.csv"), lambda r: r["LSAD"] == "Metropolitan Statistical Area")
+want = {"45051", "36103", "37019", "37119", "37183", "34029", "36071", "36059", "37047", "36027", "04013", "24005", "09110", "37051", "34025", "42003", "51059", "09003"}
+trim(os.path.join(R, "zhvi-county.csv"), lambda r: (r["StateCodeFIPS"].zfill(2) + r["MunicipalCodeFIPS"].zfill(3)) in want)
+for f in glob.glob(os.path.join(R, "qcew-*.csv")):
+    trim(f, lambda r: r["own_code"] in ("0", "5") and r["industry_code"] == "10")
