city=".9" stroke="#ffffff" stroke-width=".8"/><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><use href="#c3r-myrtle-beach-va-clinic-pin" x="-7.4" y="-7.4" width="14.7" height="14.7" color="#1c2028"/><text class="l" x="15" y="-3"><tspan x="15">Myrtle Beach</tspan></text><text class="m" x="15" y="12.5">about 12 min</text></g></g><g transform="translate(256.4 200.8)"><g class="k"><rect x="-50.8" y="15.3" width="101.5" height="52.5" rx="10" fill="#1c2028" fill-opacity=".1"/><rect x="-50.8" y="14" width="101.5" height="52.5" rx="10" fill="#ffffff" fill-opacity=".9" stroke="#ffffff" stroke-width=".8"/><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><use href="#c3r-myrtle-beach-va-clinic-pin" x="-7.4" y="-7.4" width="14.7" height="14.7" color="#1c2028"/><text class="l" x="0" y="29" text-anchor="middle"><tspan x="0">North</tspan><tspan x="0" dy="16.5">Myrtle Beach</tspan></text><text class="m" x="0" y="61" text-anchor="middle">about 35 min</text></g></g><g transform="translate(122.6 358.6)"><g class="k"><rect x="13" y="-16.7" width="115.7" height="36" rx="10" fill="#1c2028" fill-opacity=".1"/><rect x="13" y="-18" width="115.7" height="36" rx="10" fill="#ffffff" fill-opacity=".9" stroke="#ffffff" stroke-width=".8"/><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><use href="#c3r-myrtle-beach-va-clinic-pin" x="-7.4" y="-7.4" width="14.7" height="14.7" color="#1c2028"/><text class="l" x="15" y="-3"><tspan x="15">Surfside Beach</tspan></text><text class="m" x="15" y="12.5">about 14 min</text></g></g><g transform="translate(128.1 307.5)"><g class="k"><g transform="scale(0.8)"><ellipse cx="0" cy="1" rx="7" ry="2.4" fill="#1c2028" opacity=".18"/><path d="M0 0C-3-6-13-14-13-26a13 13 0 1 1 26 0c0 12-10 20-13 26z" fill="#c4783a" stroke="#1c2028" stroke-width="1.5"/><use href="#c3r-myrtle-beach-va-clinic-home" x="-8.5" y="-34.5" width="17" height="17" color="#ffffff"/></g><text class="h" x="0" y="20.5" text-anchor="middle"><tspan x="0">VA Clinic</tspan></text></g></g></g></svg></div><figcaption style="color:var(--muted);font-size:.95rem;line-height:1.55;margin-top:.6rem">The drive to the Myrtle Beach VA Clinic from the middle of each town, without traffic. Summer traffic takes longer. Map data: U.S. Census Bureau TIGER/Line; Horry County GIS.</figcaption></figure><p class="c3-map-links" style="display:flex;flex-wrap:wrap;gap:.6rem 1.4rem;margin:.9rem 0 1.8rem;max-width:760px"><a class="c3-map-link open" href="https://www.google.com/maps/search/?api=1&amp;query=33.677414,-78.945299" title="Myrtle Beach VA Clinic in Google Maps" target="_blank" rel="noopener noreferrer" style="color:var(--navy);font-weight:500;text-decoration:underline;text-decoration-color:var(--brass);text-underline-offset:3px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" style="vertical-align:-3px;margin-right:.35rem"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>Open in Google Maps</a><a class="c3-map-link directions" href="https://www.google.com/maps/dir/?api=1&amp;destination=33.677414,-78.945299" title="Directions to Myrtle Beach VA Clinic in Google Maps" target="_blank" rel="noopener noreferrer" style="color:var(--navy);font-weight:500;text-decoration:underline;text-decoration-color:var(--brass);text-underline-offset:3px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" style="vertical-align:-3px;margin-right:.35rem"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>Get directions</a></p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The clinic is part of the Ralph H. Johnson VA health care system. From the clinic, the nearest VA medical center is the Ralph H. Johnson VA Medical Center in Charleston, about 2 hours 10 minutes away without traffic. From Loris, Little River and North Myrtle Beach, the Fayetteville VA Medical Center in North Carolina is a shorter drive.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Military history here</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Warbird Park in Myrtle Beach keeps the history of the old Myrtle Beach Air Force Base, with a Wall of Service that lists people who served at the base.</p><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);letter-spacing:.01em;color:#fff;text-align:right;background:radial-gradient(farthest-side at 100% 100%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.c3ph-cr a{color:#fff;text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);text-underline-offset:2px;pointer-events:auto;padding:10px 0 6px}.c3ph-hero{margin:1.6rem 0 2rem}.c3ph-hero .c3ph-f{border-radius:8px}.c3ph-hero img{aspect-ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}</style><figure class="c3ph-hero" style="margin:1.6rem 0 1.8rem;max-width:760px;"><div class="c3ph-f"><img src="/images/2026-11-a/buyers-va-loans/warbird-park-jets-1200w.webp" srcset="/images/2026-11-a/buyers-va-loans/warbird-park-jets-600w.webp 600w, /images/2026-11-a/buyers-va-loans/warbird-park-jets-1200w.webp 1200w" sizes="(max-width: 800px) 100vw, 760px" width="1200" height="675" alt="Military jets in camouflage paint on display on a round plaza with small plaques, under tall pines at Warbird Park in Myrtle Beach" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.loc.gov/rr/print/res/482_high.html" target="_blank" rel="noopener noreferrer" aria-label="Photo: Carol M. Highsmith. License: Public domain" title="License: Public domain">Photo: Carol M. Highsmith</a></span></div><figcaption>Jets on display at Warbird Park in Myrtle Beach.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">South Carolina does not tax military retirement pay, and a surviving spouse gets the same deduction. Our <a href="/buyers/retirees/" style="color:var(--navy);text-decoration:underline">guide for retirees</a> covers the rest of the state's taxes on retirement income. Not every veteran here is retired. One of our clients is a veteran who lives here and works his New York job in alternating weeks.</p></div></section><section style="background:var(--ivory-2)" id="who-qualifies"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Who qualifies">Who qualifies for a VA loan, and how much can you borrow?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You need a Certificate of Eligibility (COE), the VA's letter that says you can use the benefit. These are the <a href="https://www.va.gov/housing-assistance/home-loans/eligibility/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">service minimums</a> for service from the Gulf War to today:</p><ul class="c3-va-cards" role="list" aria-label="VA loan service minimums"><li><span class="c3-va-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 5h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM3 10h18M8 3v4M16 3v4M8 14h.01M12 14h.01M16 14h.01M8 17.5h.01M12 17.5h.01"/></svg></span><span><strong>Serving now</strong>90 days of active duty in a row.</span></li><li><span class="c3-va-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span><strong>A veteran</strong>24 months in a row, or the full period you were called to active duty (at least 90 days), or less if discharged for a disability from your service.</span></li><li><span class="c3-va-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 21h18M5 21V9.5l5-3V21M10 21V4h9v17M13 8h3M13 12h3M13 16h3M7.5 13h.01M7.5 16.5h.01"/></svg></span><span><strong>Guard and Reserve</strong>90 days of qualifying active duty, or 6 qualifying years if you still serve, left honorably or retired.</span></li><li><span class="c3-va-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span><span><strong>A surviving spouse</strong>If you get, or can get, certain VA survivor pay (DIC), or your spouse on active duty is missing in action or held as a prisoner of war.</span></li></ul><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How much you can borrow</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Your entitlement is the most the VA will pay your lender if you do not repay the loan. Your COE shows your basic entitlement. The rest, for a larger loan, is worked out from the loan amount and is not on the COE. With your full entitlement there is <a href="https://www.va.gov/housing-assistance/home-loans/loan-limits/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">no VA loan limit</a>: the lender decides how much you can borrow, and the appraisal must support the price.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If you still have a VA loan on another home, part of your entitlement is in use. Your remaining entitlement is worked out from the county's loan limit, which is $832,750 for a one-unit home in Horry and Georgetown counties, minus the entitlement already in use. If what is left does not cover enough of the new loan, the lender may ask for a down payment.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Credit and down payment help</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The VA requires no minimum credit score, but some lenders have their own. SC Housing's VA loans with no down payment need a score of 640. SC Housing's year-round help works with a VA loan; our <a href="/buyers/programs/" style="color:var(--navy);text-decoration:underline">guide to SC Housing's programs</a> gives its limits.</p></div></section><section style="background:var(--ivory)" id="va-loan-questions"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">VA loan questions</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I use a VA loan more than once?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. After you sell the home and pay off the VA loan, you can ask the VA to restore your entitlement. With a VA loan still open on another home, you may have enough left for a second one.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I buy a manufactured home with a VA loan?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, if you will live in it. A VA loan can buy a manufactured home, or a lot for one. Few sellers here mark VA on them: about 15 in 100 manufactured homes for sale.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I buy a house with a tenant in it using a VA loan?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A house with a tenant is hard to buy with a VA loan while a long lease runs, because you must be able to move in. Most lenders want you in the home within 60 days. We ask about the lease before you make an offer.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What interest rate will I get on a VA loan?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The lender quotes your rate. We do not quote rates. We can introduce you to our preferred lender, or you can use any lender you like.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://lgy.va.gov/lgyhub/condo-report" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">VA condo report</a>, <a href="https://entp.hud.gov/idapp/html/condlook.cfm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">HUD FHA condo list</a>, <a href="https://www.va.gov/housing-assistance/home-loans/loan-types/purchase-loan/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">VA purchase loans</a>, <a href="https://www.va.gov/housing-assistance/home-loans/funding-fee-and-closing-costs/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">VA funding fee</a>, <a href="https://www.va.gov/housing-assistance/home-loans/loan-limits/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">VA loan limits</a>, <a href="https://www.va.gov/housing-assistance/home-loans/eligibility/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">VA eligibility</a>, <a href="https://www.scstatehouse.gov/code/t12c037.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-37</a>, <a href="https://dor.sc.gov/sites/dor/files/forms/PT401I.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SCDOR PT-401-I</a>, <a href="https://www.horrycountysc.gov/media/kufln4qp/tax-levy-2026_2.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County 2026 tax levy</a>, <a href="https://www.va.gov/charleston-health-care/locations/myrtle-beach-va-clinic/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Myrtle Beach VA Clinic</a>, <a href="https://data.census.gov/table/ACSDT1Y2024.B25034?g=050XX00US45051" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Census ACS</a>. Homes for sale: Chapter3's count of MLS listings, in aggregate; a community's condos are matched by its name and checked against its street. Drive times: OpenStreetMap routing, no traffic. Not loan or tax advice.</p><style>.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule)