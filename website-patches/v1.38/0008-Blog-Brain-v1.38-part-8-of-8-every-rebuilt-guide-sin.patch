0 rgba(255,255,255,.85),0 18px 40px -28px rgba(28,32,40,.45);border-radius:20px;margin:1.4rem 0 1.6rem;padding:1.1rem 1.15rem 1rem;max-width:760px}.c3-uf-chart .cap{display:block;font-family:var(--sans);font-weight:650;color:var(--navy);font-size:1.05rem;line-height:1.35;margin:0 0 .8rem}.c3-uf-grp{margin:0 0 .9rem}.c3-uf-grp:last-of-type{margin-bottom:0}.c3-uf-grp .gh{display:flex;align-items:center;gap:.5rem;font-family:var(--sans);font-weight:650;font-size:1rem;color:var(--navy);margin-bottom:.35rem;border-bottom:1px solid rgba(28,32,40,.12);padding-bottom:.2rem}.c3-uf-grp .gh i{display:inline-block;width:1rem;height:.7rem;border-radius:3px}.c3-uf-row{display:grid;grid-template-columns:minmax(7.5rem,11rem) minmax(0,1fr) 3rem;align-items:center;gap:.6rem;font-family:var(--sans);font-size:1rem;color:var(--navy);line-height:1.3;margin:.35rem 0}.c3-uf-row small{display:block;color:var(--muted);font-size:.9rem}.c3-uf-row .bar{display:block;min-width:0;background:rgba(28,32,40,.06);border-radius:5px}.c3-uf-row .bar i{display:block;height:.75rem;border-radius:5px;min-width:3px}.c3-uf-row em{font-style:normal;font-weight:650;text-align:right;font-variant-numeric:tabular-nums}.c3-uf-chart figcaption{color:var(--muted);font-size:.95rem;line-height:1.55;margin:.9rem 0 0;padding:0}.c3-uf-map img{display:block;width:100%;height:auto;border-radius:12px}.c3-uf-key{list-style:none;display:grid;gap:.35rem;margin:.7rem .3rem .2rem;padding:0;font-family:var(--sans);font-size:1rem;color:var(--navy);line-height:1.35}.c3-uf-key li{display:flex;align-items:center;gap:.55rem;margin:0}.c3-uf-key i{flex:none;display:inline-block;width:1.4rem;height:.9rem;border-radius:3px;border:1px solid rgba(28,32,40,.2)}.c3-uf-tiles{list-style:none;margin:1.2rem 0 1.5rem;padding:0;display:grid;gap:.65rem;max-width:760px}@media (min-width:760px){.c3-uf-tiles{grid-template-columns:repeat(3,minmax(0,1fr))}.c3-uf-tiles b{font-size:1.6rem!important}}.c3-uf-tiles>li{background:linear-gradient(180deg,rgba(255,255,255,.8),rgba(255,255,255,.56));border:1px solid rgba(255,255,255,.92);box-shadow:inset 0 1px 0 rgba(255,255,255,.85),0 18px 40px -28px rgba(28,32,40,.45);border-radius:20px;margin:0;padding:.9rem 1rem}.c3-uf-tiles b{display:block;font-family:var(--serif);font-weight:400;font-size:1.9rem;line-height:1.1;color:#8a5226;margin-bottom:.3rem}.c3-uf-tiles span{display:block;color:var(--muted);font-size:1rem;line-height:1.5}.c3-uf-photo img{display:block;width:100%;height:auto;border-radius:12px}.c3-uf-three{list-style:none;margin:1.2rem 0 1.6rem;padding:0;display:grid;gap:.8rem;max-width:960px}@media (min-width:860px){.c3-uf-three{grid-template-columns:repeat(3,minmax(0,1fr))}}.c3-uf-three>li{background:linear-gradient(180deg,rgba(255,255,255,.8),rgba(255,255,255,.56));border:1px solid rgba(255,255,255,.92);box-shadow:inset 0 1px 0 rgba(255,255,255,.85),0 18px 40px -28px rgba(28,32,40,.45);border-radius:20px;margin:0;padding:1rem 1.1rem .95rem}.c3-uf-three .hd{display:flex;align-items:center;gap:.65rem;margin:0 0 .5rem;font-family:var(--sans);font-weight:650;font-size:1.08rem;color:var(--navy);line-height:1.3}.c3-uf-ic{flex:none;display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:13px;color:var(--brass);background:rgba(255,255,255,.85);border:1px solid rgba(255,255,255,.95);box-shadow:0 6px 14px -10px rgba(28,32,40,.45)}.c3-uf-three p{margin:0 0 .5rem;color:var(--muted);font-size:var(--read,1.0625rem);line-height:1.6}.c3-uf-three p:last-child{margin-bottom:0}.c3-uf-three .we{color:var(--navy);font-weight:500}main#main>section[style^="background:var(--navy)"]:last-of-type>.wrap{background:linear-gradient(160deg,rgba(42,48,64,.95),rgba(28,32,40,.97))!important;border:1px solid rgba(255,255,255,.14);box-shadow:inset 0 1px 0 rgba(255,255,255,.14),0 26px 60px -30px rgba(28,32,40,.6);display:block;text-align:center!important;border-radius:28px;padding:2.2rem 1.6rem;margin:0 auto!important}@media (max-width:699px){main#main>sect