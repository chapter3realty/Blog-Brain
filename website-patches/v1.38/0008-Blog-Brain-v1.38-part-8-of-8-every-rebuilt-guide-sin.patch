+const CONDO_UNDER7 = CO.bands.filter((b) => b.months_all < 7).length;
+must(CONDO_UNDER7 === 2 && CO.months_all > 7, "[7] two condo price ranges just under 7, all condos past 7");
+
+/* ---------- the towns (rows 8, 14) ---------- */
