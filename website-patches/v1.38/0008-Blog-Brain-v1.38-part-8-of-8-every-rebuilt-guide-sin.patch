ox}main#main .sl-err{display:none;color:#ffb4a8;font-family:var(--sans);font-size:1rem;margin:0 0 .8rem}main#main .sl-tel{color:rgba(244,239,232,.86);font-family:var(--sans);font-size:1rem;margin:.9rem 0 0}main#main .sl-form a.sl-call{display:flex;align-items:center;margin-top:.6rem;color:var(--ivory);border:1px solid rgba(244,239,232,.55);background:transparent}main#main .sl-ok{display:none;max-width:720px;margin:1.4rem 0 1rem;padding:1.3rem;border-radius:20px;background:var(--navy);color:var(--ivory);font-family:var(--sans);font-size:1.0625rem;line-height:1.6}@media (max-width:379px){main#main .hx-fb,main#main .hx-fb>*{min-width:0;max-width:100%}main#main .hx-fb-ai,main#main .hx-fb-q{min-width:0!important;max-width:100%!important;flex-wrap:wrap;box-sizing:border-box}main#main .hx-fb-q textarea{min-width:0;flex:1 1 100%;width:100%}main#main .hx-fb-go{flex:1 1 100%}}@media (min-width:1000px) and (max-width:1100px){.header-ctas .hdr-phone{display:none!important}}@media (min-width:700px){main#main>section[style^="background:var(--navy)"]:not(:last-child)>.wrap{margin-left:max(2rem,calc((100% - 1200px) / 2 + 2rem))!important}}main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2){padding:.9rem 0!important}main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2)>.wrap{display:block!important;text-align:center!important;background:linear-gradient(160deg,rgba(42,48,64,.95),rgba(28,32,40,.97))!important;border:1px solid rgba(255,255,255,.14)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.14),0 26px 60px -30px rgba(28,32,40,.6)!important;border-radius:28px!important;padding:2.2rem 1.6rem!important;margin-left:auto!important;margin-right:auto!important}@media (max-width:699px){main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2)>.wrap{padding:1.6rem 1.2rem 1.7rem!important;border-radius:24px!important}}</style><style>.c3-glance{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(var(--n),minmax(0,1fr));gap:.75rem;max-width:760px}.c3-glance li{display:flex;align-items:center;gap:.55rem;margin:0;padding:.5rem .6rem;background:rgba(255,255,255,.55);border:1px solid var(--rule);border-radius:6px;line-height:1.25}.c3-glance .i{flex:0 0 auto;display:flex;width:2rem;height:2rem;border-radius:50%;background:var(--ivory-2);color:var(--brass-ink);align-items:center;justify-content:center}.c3-glance strong{display:block;color:var(--navy);font-size:.9rem;font-weight:500}.c3-glance span.t{display:block;color:var(--muted);font-size:1rem}@media (max-width:699px){.c3-glance{gap:.3rem}.c3-glance li{flex-direction:column;justify-content:flex-start;text-align:center;gap:.2rem;padding:.4rem .1rem}.c3-glance .i{width:1.6rem;height:1.6rem}.c3-glance strong{font-size:.875rem}.c3-glance span.t{font-size:1rem;line-height:1.2}}</style><ul role="list" class="c3-glance" style="--n:3"><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 9.4c-.4-1-1.5-1.8-3-1.8-1.8 0-3 1-3 2.2 0 3 6 1.6 6 4.4 0 1.3-1.3 2.2-3 2.2-1.6 0-2.7-.7-3.1-1.8M12 5.8v1.8M12 16.4v1.8"/><circle cx="12" cy="12" r="9"/></svg></span><span><strong>97.3%</strong><span class="t">of the last asking price, for houses</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 5h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM3 10h18M8 3v4M16 3v4M8 14h.01M12 14h.01M16 14h.01M8 17.5h.01M12 17.5h.01"/></svg></span><span><strong>About 4 months</strong><span class="t">from listing to an accepted offer</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span><strong>March to May</strong><span class="t">the months buyers sign the most</span></span></li></ul></div><p style="color:var(--muted);font-size:.9rem;margin-bottom:1rem">By <strong style="color:var(--navy);font-weight:600">Devin Day</strong>, Operations Officer &middot; Reviewed by <strong style="color:var(--navy);font-weight:600">Tim Nash</strong>, Broker-in-Charge &middot; <span style="white-space:nowrap">Updated November 12, 2026</span></p><p class="detail-sub">Houses here sold for about 97 percent of their last asking price. A cash sale is faster, and it pays less.</p></div></div><section style="background:var(--ivory)"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">The short answer</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Listed houses in Horry and Georgetown Counties sold for 97.3 percent of their last asking price from January to September 2026. They took about 4 months from listing to an accepted offer.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A company that bought a house to fix up and resell paid about 70 cents for each dollar it later sold the house for. A cash sale as is trades a large part of the price for speed and no repairs.</p></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><p style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Get both numbers for your home: listed, and sold as is.</p><a class="btn btn-brass btn-lg" href="#lead-form">Have us price it both ways</a></div></section><section style="background:var(--ivory);padding-top:2.5rem"><div class="wrap"><nav aria-label="On this page" style="margin-top:0;max-width:720px"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.3rem;font-weight:600">On this page</p><ul style="list-style:none;margin:0;padding:0"><li><a href="#list-or-cash" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">List or cash</a></li><li><a href="#how-long" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">How long</a></li><li><a href="#share-of-asking" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Share of asking</a></li><li><a href="#best-month" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Best month</a></li><li><a href="#cost-and-value" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Cost and value</a></li><li><a href="#listing-with-us" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Listing with us</a></li><li><a href="#guides" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Selling guides</a></li><li><a href="#lead-form" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Contact us</a></li><li><a href="#selling-your-home-questions" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Selling your home: questions</a></li></ul></nav></div></section><section style="background:var(--ivory-2)" id="list-or-cash"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="List or cash">Should I list my house or sell it for cash?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">List it if the house is ready and you can wait for an offer. Sell it as is for cash if speed or repairs matter more than price. Our <a href="/sell/cash-offer/" style="color:var(--navy);text-decoration:underline">cash offer or listing</a> guide compares what each one leaves you.</p><div class="sl-tw"><table class="sl-tab sl-cmp"><caption>List it, or sell it as is for cash</caption><thead><tr><th scope="col"><span class="sr">Question</span></th><th scope="col">List it</th><th scope="col">Sell it as is for cash</th></tr></thead><tbody><tr><th scope="row">What it brings</th><td><span class="l">List it</span>97.3 percent of the last asking price, on average</td><td><span class="l">Sell it as is</span>About 70 cents on the dollar of what a company later resells it for</td></tr><tr><th scope="row">How long it takes</th><td><span class="l">List it</span>About 4 months to an accepted offer, then the closing</td><td><span class="l">Sell it as is</span>You and the buyer pick the closing date</td></tr><tr><th scope="row">Repairs and showings</th><td><span class="l">List it</span>You fix what an inspector would flag, and buyers tour the house</td><td><span class="l">Sell it as is</span>No repairs. The buyer takes the house as it is</td></tr><tr><th scope="row">The buyer's money</th><td><span class="l">List it</span>Often a loan, and the contract can depend on getting it</td><td><span class="l">Sell it as is</span>Cash. A cash offer does not depend on a loan</td></tr><tr><th scope="row">Best for</th><td><span class="l">List it</span>A house that is ready, and an owner who can wait</td><td><span class="l">Sell it as is</span>Speed, a house that needs work, or an estate</td></tr></tbody></table></div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What does a cash buyer pay here?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We read the past year of Horry County's deeds. We found 82 houses that a company bought from an owner and sold again within that time.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On those houses, the company had paid about 70 cents for each dollar it later sold the house for.</p><aside class="sl-ex" aria-label="Example"><p class="k">Example</p><p>A house would sell for about $350,000 once it is fixed up. A company that buys it to resell would pay about $242,000, at the middle share of those 82 quick resales.</p><p>The difference pays for the repairs, the months the company owns the house, and its profit. The deeds do not show how it splits.</p></aside><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Companies pay less across the market too. For the houses they bought from owners, companies paid a median of about 94 percent of the county's value, the market value on the tax record. People paid about 101 percent.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The difference is in homes the county values under about $400,000.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How do we find you a cash buyer?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We bring you both numbers before you choose: the price range for a listing, and what a cash buyer would pay. Nobody here pushes you either way.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">One of our agents sold a <a href="/sell/rental-property/" style="color:var(--navy);text-decoration:underline">rented house</a> for an owner who was moving to New York. The agent offered it to our list of investors, and a cash buyer closed within 13 days of the day he listed. One sale, not a promise.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The cash buyer we bring you buys your house and owns it. South Carolina law calls it <a href="https://www.scstatehouse.gov/code/statmast.php?title=40&amp;chapter=57" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">wholesaling</a> when someone signs a contract to buy a house, then offers the house to other buyers before owning it.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A brokerage may not do that or help anyone do it. Selling the contract itself to someone else is not wholesaling under that law. Before you sign with any cash buyer, ask whether they will own the house.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does an as-is sale still need the disclosure form?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. Selling as is does not by itself remove <a href="/sell/fsbo/#paperwork" style="color:var(--navy);text-decoration:underline">the state's disclosure form</a>. A seller of a home with one to four units fills it in, signs it and gives it to the buyer. What goes on it is in our guide to <a href="/sell/seller-disclosure/" style="color:var(--navy);text-decoration:underline">what South Carolina makes you disclose</a>.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The form is due before both sides sign the contract, unless the contract names another time or the sale is exempt.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">See the listed number and the cash number side by side</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the address. We put a listing price range and a cash price side by side, and you choose.</p><a class="btn btn-brass" href="#lead-form">Show me the listed and cash prices</a></div></div></section><section style="background:var(--ivory)" id="how-long"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="How long">How long does it take to sell a house in Myrtle Beach?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Houses took an average of 122 days from listing to an accepted offer this year, and condos 131.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The closing comes after the accepted offer, on the date the contract names.</p><div class="sl-tw"><table class="sl-tab sl-area"><caption>In every area, houses waited 111 to 136 days for an offer</caption><thead><tr><th scope="col">Area</th><th scope="col">Houses</th><th scope="col">Condos</th></tr></thead><tbody><tr><th scope="row">Garden City and Murrells Inlet<span class="z">ZIP 29576</span></th><td><span class="l">Houses</span>111 days<span class="s">96.5% of asking</span></td><td><span class="l">Condos</span>148 days<span class="s">97.3% of asking</span></td></tr><tr><th scope="row"><a href="/submarkets/carolina-forest/" style="color:var(--navy);text-decoration:underline">Carolina Forest</a></th><td><span class="l">Houses</span>113 days<span class="s">97.6% of asking</span></td><td><span class="l">Condos</span>131 days<span class="s">96.5% of asking</span></td></tr><tr><th scope="row"><a href="/submarkets/pawleys-island/" style="color:var(--navy);text-decoration:underline">Pawleys Island and Litchfield</a><span class="z">ZIP 29585</span></th><td><span class="l">Houses</span>116 days<span class="s">96.9% of asking</span></td><td><span class="l">Condos</span>114 days<span class="s">97.2% of asking</span></td></tr><tr><th scope="row">Socastee<span class="z">ZIP 29588</span></th><td><span class="l">Houses</span>116 days<span class="s">97.8% of asking</span></td><td><span class="l">Condos</span>109 days<span class="s">96.7% of asking</span></td></tr><tr><th scope="row"><a href="/submarkets/little-river/" style="color:var(--navy);text-decoration:underline">Little River</a><span class="z">ZIP 29566</span></th><td><span class="l">Houses</span>119 days<span class="s">97.2% of asking</span></td><td><span class="l">Condos</span>133 days<span class="s">95.8% of asking</span></td></tr><tr><th scope="row"><a href="/submarkets/surfside-beach/" style="color:var(--navy);text-decoration:underline">Surfside Beach</a><span class="z">ZIP 29575</span></th><td><span class="l">Houses</span>119 days<span class="s">95.6% of asking</span></td><td><span class="l">Condos</span>117 days<span class="s">95.3% of asking</span></td></tr><tr><th scope="row">Loris and Longs<span class="z">ZIP 29568, 29569</span></th><td><span class="l">Houses</span>120 days<span class="s">98.1% of asking</span></td><td><span class="l">Condos</span>152 days<span class="s">98.5% of asking</span></td></tr><tr><th scope="row"><a href="/submarkets/north-myrtle-beach/" style="color:var(--navy);text-decoration:underline">North Myrtle Beach</a><span class="z">ZIP 29582</span></th><td><span class="l">Houses</span>120 days<span class="s">96.6% of asking</span></td><td><span class="l">Condos</span>121 days<span class="s">96.2% of asking</span></td></tr><tr><th scope="row">Georgetown<span class="z">ZIP 29440</span></th><td><span class="l">Houses</span>130 days<span class="s">96.6% of asking</span></td><td><span class="l">Condos</span><span class="na">Too few sales</span></td></tr><tr><th scope="row"><a href="/submarkets/myrtle-beach/" style="color:var(--navy);text-decoration:underline">Myrtle Beach</a><span class="z">ZIP 29572, 29577</span></th><td><span class="l">Houses</span>131 days<span class="s">96.2% of asking</span></td><td><span class="l">Condos</span>142 days<span class="s">94.8% of asking</span></td></tr><tr><th scope="row"><a href="/submarkets/conway/" style="color:var(--navy);text-decoration:underline">Conway</a><span class="z">ZIP 29526, 29527</span></th><td><span class="l">Houses</span>133 days<span class="s">97.8% of asking</span></td><td><span class="l">Condos</span>144 days<span class="s">97.0% of asking</span></td></tr><tr><th scope="row">Aynor<span class="z">ZIP 29511</span></th><td><span class="l">Houses</span>136 days<span class="s">99.6% of asking</span></td><td><span class="l">Condos</span><span class="na">Too few sales</span></td></tr></tbody></table><p class="nt">Days from listing to an accepted offer, and the share of the last asking price it sold for, this year to September. Sorted by the wait for houses, shortest first.</p></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the Myrtle Beach area, condos sold more than twice as often as houses. Those condos waited 142 days and sold for 94.8 percent of asking, the lowest share of any area.</p><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);letter-spacing:.01em;color:#fff;text-align:right;background:radial-gradient(farthest-side at 100% 100%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.c3ph-cr a{color:#fff;text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);text-underline-offset:2px;pointer-events:auto;padding:10px 0 6px}.c3ph-hero{margin:1.6rem 0 2rem}.c3ph-hero .c3ph-f{border-radius:8px}.c3ph-hero img{aspect-ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}</style><figure class="c3ph-hero" style="margin:1.4rem 0 1.5rem;max-width:720px;"><div class="c3ph-f"><img src="/images/2026-11-a/submarkets-myrtle-beach/houses-and-towers-from-the-ocean-1200w.webp" srcset="/images/2026-11-a/submarkets-myrtle-beach/houses-and-towers-from-the-ocean-600w.webp 600w, /images/2026-11-a/submarkets-myrtle-beach/houses-and-towers-from-the-ocean-1200w.webp 1200w" sizes="(max-width: 760px) 100vw, 720px" width="1200" height="782" alt="Older two-story houses on lawns along the beach at left, and two tall condo towers on the beach at right, with streets of houses under oak trees behind, seen from a plane over the ocean in Myrtle Beach" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: U.S. Geological Survey. License: Public domain" title="License: Public domain">Photo: U.S. Geological Survey</a></span></div><figcaption>Houses and condo towers side by side on the beach in Myrtle Beach.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Selling a condo? Our guide to <a href="/sell/sell-my-condo/" style="color:var(--navy);text-decoration:underline">selling a condo in Myrtle Beach</a> goes through it. Our <a href="/market-reports/july-2026/" style="color:var(--navy);text-decoration:underline">July 2026 market report</a> gives June's median prices by Grand Strand area, and our <a href="/market-reports/" style="color:var(--navy);text-decoration:underline">latest market report</a> has the newest month.</p></div></section><section style="background:var(--ivory-2)" id="share-of-asking"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Share of asking">How close to the asking price do homes sell in Myrtle Beach?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Condos sold for 96.0 percent of their last asking price on average this year, a little under houses. Both shares are of the last asking price, after any price cuts.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On November 9, 2026 we counted the resale homes for sale in Horry County. More than half of the houses and townhouses had already cut their price.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Is it a buyer's market? See our guide to <a href="/buyers/buying-in-myrtle-beach/" style="color:var(--navy);text-decoration:underline">buying in Myrtle Beach</a>.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Price it against the homes buyers are touring now</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We pull the homes for sale near yours, including the ones that cut their price, and send you the list with our price range.</p><a class="btn btn-brass" href="#lead-form">Have us pull my competition</a></div></div></section><section style="background:var(--ivory)" id="best-month"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Best month">When is the best time to sell a house in Myrtle Beach?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Buyers signed the most contracts in March, April and May, and the fewest in December, over the past year.</p><div class="sl-months"><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="Buyers signed the most contracts in March, April and May"><span class="cap" aria-hidden="true">Buyers signed the most contracts in March, April and May</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Month</span><span role="columnheader">Contracts signed, houses and condos</span></div></div><div role="rowgroup"><div role="row" class="ref"><span role="rowheader"><span class="n">October</span></span><span role="cell"><span class="b" style="--f:0.857" aria-hidden="true"></span><span class="v">1,383</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">November</span></span><span role="cell"><span class="b" style="--f:0.688" aria-hidden="true"></span><span class="v">1,110</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">December</span></span><span role="cell"><span class="b" style="--f:0.568" aria-hidden="true"></span><span class="v">916</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">January</span></span><span role="cell"><span class="b" style="--f:0.786" aria-hidden="true"></span><span class="v">1,269</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">February</span></span><span role="cell"><span class="b" style="--f:0.796" aria-hidden="true"></span><span class="v">1,285</span></span></div><div role="row"><span role="rowheader"><span class="n">March</span></span><span role="cell"><span class="b" style="--f:0.987" aria-hidden="true"></span><span class="v">1,593</span></span></div><div role="row"><span role="rowheader"><span class="n">April</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">1,614</span></span></div><div role="row"><span role="rowheader"><span class="n">May</span></span><span role="cell"><span class="b" style="--f:0.974" aria-hidden="true"></span><span class="v">1,572</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">June</span></span><span role="cell"><span class="b" style="--f:0.883" aria-hidden="true"></span><span class="v">1,425</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">July</span></span><span role="cell"><span class="b" style="--f:0.865" aria-hidden="true"></span><span class="v">1,396</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">August</span></span><span role="cell"><span class="b" style="--f:0.882" aria-hidden="true"></span><span class="v">1,423</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">September</span></span><span role="cell"><span class="b" style="--f:0.804" aria-hidden="true"></span><span class="v">1,297</span></span></div></div></div><figcaption>Contracts signed on houses and condos each month, October 2025 to September 2026. The three busiest months are in brass.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The wait for an offer barely changed by month: from 112 days for houses in August to 134 in February. The season changes how many buyers sign, more than how long a house waits.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Sellers list the most homes in March too, so a house has the most competition then. To be in front of the spring buyers, have the house photographed and listed by late winter. Our guide to <a href="/sell/best-time-to-sell/" style="color:var(--navy);text-decoration:underline">the best time to sell a house in Myrtle Beach</a> goes month by month.</p></div></section><section style="background:var(--ivory-2)" id="cost-and-value"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Cost and value">What does it cost to sell, and what is my home worth?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">These are the main selling costs on the middle $350,000 home in Horry County.</p><ul class="sl-plain"><li><b>Fees in state law: $1,320</b>Most of it is the state's fee on the deed. The rest is the county's charge to record the deed and the release of your paid-off mortgage. On the state's standard contract, the seller pays these.</li><li><b>Commission: $3,500 for each 1 percent</b>Agents' fees are <a href="https://www.nar.realtor/the-facts/what-the-nar-settlement-means-for-home-buyers-and-sellers" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">fully negotiable</a>, and no law fixes them.</li><li><b>A hold-back, if you live in another state: <a href="https://dor.sc.gov/news/information-about-h-4216" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">5.21 percent</a></b>If your permanent home is outside South Carolina, the buyer must <a href="https://www.scstatehouse.gov/code/statmast.php?title=12&amp;chapter=8" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">hold back</a> that share for state income tax on a 2026 sale. If it was your main home and its profit is tax-free under federal law, nothing is held back. If you sign the state's form, the hold-back is 5.21 percent of your profit only, not of the whole price.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our <a href="/sell/net-proceeds/" style="color:var(--navy);text-decoration:underline">cost to sell a house in South Carolina</a> page lists every line, with a calculator. Our <a href="/sell/capital-gains/" style="color:var(--navy);text-decoration:underline">capital gains page</a> works out the tax on your profit and names the form.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What is my home worth?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Start with <a href="/sell/home-value/" style="color:var(--navy);text-decoration:underline">what homes sold for in your area</a>, from the county's deeds. An agent then prices your home from the sales most like it, free.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Know what you keep before you list</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the address and what you still owe. We send back a net sheet with every cost at your price.</p><a class="btn btn-brass" href="#lead-form">Have us work out what I keep</a></div></div></section><section style="background:var(--ivory)" id="listing-with-us"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Listing with us">How do I sell my house in Myrtle Beach with an agent?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Selling with one of our agents takes these seven steps.</p><ol class="sl-steps"><li><b>A first call</b>We learn your plans, your timing and the house. Owners in another state do this by phone or video.</li><li><b>A price range, with its reasons</b>We compare your home with recent sales on the local MLS, the homes for sale now and the listings that did not sell. We go through the state disclosure form with you.</li><li><b>A short prep list</b>We walk the house with you, in person or by video. The list holds only what an inspector would flag or an appraiser would count.</li><li><b>Photos and the launch</b>We book professional photos. The listing then goes live on the MLS and the home search sites it feeds.</li><li><b>Showings and feedback</b>We pass on what buyers and their agents say. We tell you when the price needs a second look.</li><li><b>Offers</b>We compare each offer on price, the buyer's loan, the inspection terms, the closing date and any credits asked for.</li><li><b>The closing</b>Every South Carolina home closing must be supervised by a <a href="https://www.sccourts.org/media/opinions/HTMLFiles/SC/25508.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">South Carolina attorney</a>. We keep the attorney, the buyer's side and your lender on the same dates.</li></ol><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Your buyer may live far away. About 3 in 10 homes sold in Horry County in the past year went to a buyer whose tax bill goes to another state or country.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Live away yourself? Read <a href="/sell/out-of-state-buyers/" style="color:var(--navy);text-decoration:underline">selling a Myrtle Beach home from out of state</a>.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I sell my house and buy another at the same time?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. Your offer on the next home can say that it goes ahead only if your current home sells and closes. The state's <a href="https://screaltors.org/wp-content/uploads/2026/02/310.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">standard contract</a> has a box for that.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The contract also has a page you and your buyer can add if you need to stay in your home after closing. We plan both sales around your move. The three ways to time the two sales are on <a href="/sell/sell-or-buy-first/" style="color:var(--navy);text-decoration:underline">sell first or buy first</a>.</p></div></section><section style="background:var(--ivory-2)" id="guides"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Selling guides">Which selling guide fits your sale?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Each guide answers one question for one kind of sale.</p><ul class="sl-guides"><li><a href="/sell/home-value/" style="color:var(--navy);text-decoration:underline">What is my home worth in Myrtle Beach?</a></li><li><a href="/sell/net-proceeds/" style="color:var(--navy);text-decoration:underline">What will I keep after selling?</a></li><li><a href="/sell/sell-my-condo/" style="color:var(--navy);text-decoration:underline">Selling a condo in Myrtle Beach</a></li><li><a href="/sell/rental-property/" style="color:var(--navy);text-decoration:underline">Selling a rental with tenants or bookings</a></li><li><a href="/sell/inherited-house/" style="color:var(--navy);text-decoration:underline">Selling an inherited house</a></li><li><a href="/sell/out-of-state-buyers/" style="color:var(--navy);text-decoration:underline">Selling a Myrtle Beach home from another state</a></li><li><a href="/sell/capital-gains/" style="color:var(--navy);text-decoration:underline">The tax on the gain when you sell</a></li><li><a href="/sell/fsbo/" style="color:var(--navy);text-decoration:underline">Selling your house by owner</a></li><li><a href="/sell/cash-offer/" style="color:var(--navy);text-decoration:underline">A cash offer or a listing: which pays more?</a></li><li><a href="/sell/repairs-before-selling/" style="color:var(--navy);text-decoration:underline">What to fix before you sell, and what to leave</a></li><li><a href="/sell/seller-disclosure/" style="color:var(--navy);text-decoration:underline">What South Carolina makes you disclose</a></li><li><a href="/sell/best-time-to-sell/" style="color:var(--navy);text-decoration:underline">The best month to list</a></li><li><a href="/sell/sell-or-buy-first/" style="color:var(--navy);text-decoration:underline">Sell first or buy first?</a></li><li><a href="/sell/divorce/" style="color:var(--navy);text-decoration:underline">Selling a house during a divorce in South Carolina</a></li><li><a href="/invest/strategies/1031-exchange/" style="color:var(--navy);text-decoration:underline">Selling a rental to buy another one</a></li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Buying next, or investing? <a href="/guides/" style="color:var(--navy);text-decoration:underline">Every guide on our site</a> is in one list.</p></div></section><section style="background:var(--ivory)" id="lead-form"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Contact us">Talk to a listing agent about your home</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Send the address. A licensed agent calls you to talk through your home and your timing.</p><div id="ldWrap" class="sl-form"><div class="idx-lead" style="grid-template-columns:1fr"><input class="idx-input" id="ldCtx" placeholder="Property address" aria-label="Property address" autocomplete="street-address"></div><div class="idx-lead"><input class="idx-input" id="ldName" placeholder="Your name" aria-label="Your name" autocomplete="name"><input class="idx-input" id="ldPhone" placeholder="Phone" aria-label="Phone" type="tel" autocomplete="tel"></div><div class="idx-lead" style="grid-template-columns:1fr"><input class="idx-input" id="ldEmail" placeholder="Email" aria-label="Email" type="email" autocomplete="email"></div><div class="idx-lead" style="grid-template-columns:1fr"><textarea class="idx-input" id="ldNote" rows="3" placeholder="Your timing, or anything we should know (optional)" aria-label="Your timing, or anything we should know (optional)"></textarea></div><label class="sl-consent"><input type="checkbox" id="ldConsent"><span>I consent to receive calls and text messages from Chapter 3 Realty about my property inquiry, showing appointments, and listing information I requested, at the phone number provided, including calls placed using an automated system or an artificial or prerecorded voice. Message frequency varies. Message and data rates may apply. Reply HELP for help, STOP to opt out. Consent is not a condition of any purchase.</span></label><p id="ldErr" class="sl-err" role="alert"></p><button type="button" class="btn btn-brass btn-lg" onclick="ldSubmit()">Send it to a listing agent</button><p class="sl-tel">Free, and you do not have to list with us. Prefer to talk now?</p><a class="btn btn-outline sl-call" href="tel:+18543332135">Call 854.333.2135</a></div><div id="ldOk" class="sl-ok">Thanks. A licensed agent will call you about your home.</div><script>function ldSubmit(){var cx=document.getElementById('ldCtx').value.trim(),n=document.getElementById('ldName').value.trim(),ph=document.getElementById('ldPhone').value.trim(),em=document.getElementById('ldEmail').value.trim(),nt=document.getElementById('ldNote').value.trim(),c=document.getElementById('ldConsent').checked,err=document.getElementById('ldErr');function fail(m){err.textContent=m;err.style.display='block';}err.style.display='none';if(!cx||!n){fail('Add the property address and your name.');return;}if(!ph&&!em){fail('Add a phone number or an email so we can reach you.');return;}if(!c){fail('Check the consent box to send the request.');return;}c3SendForm({property_address:cx,name:n,phone:ph,email:em,message:'Seller enquiry. '+nt,consent:c?'yes':'no'},'Sell page');document.getElementById('ldWrap').style.display='none';document.getElementById('ldOk').style.display='block';}</script></div></section><section style="background:var(--ivory-2)" id="selling-your-home-questions"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Selling your home: questions</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How long does it take to sell a house in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Houses waited 122 days on average for an accepted offer this year, and condos 131. You and the buyer then agree on the closing date in the contract.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I sell my house as is in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. You make no repairs, and a company that buys to resell pays less than it later sells the house for. You still give the buyer the state's disclosure form.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do I need an attorney to sell my house in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. A South Carolina attorney must supervise every home closing in the state. Our agent keeps that attorney, the buyer's side and your lender on the same dates.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I sell my house and buy another at the same time?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. Your offer on the next home can depend on selling the one you own now. You and your buyer can also agree that you stay on after closing.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What changes if I live in another state?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The buyer must hold back part of the price for South Carolina income tax, unless the sale is exempt. If you sign the state's form, the buyer holds back a share of your profit only.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.ccarsc.org/pages/marketstats/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">CCAR market reports</a>, <a href="https://www.ccarsc.org/pages/mls-faqs/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">CCAR MLS</a>, <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeDocType" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County deeds</a>, <a href="https://www.scstatehouse.gov/code/statmast.php?title=40&amp;chapter=57" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 40-57</a>, <a href="https://www.scstatehouse.gov/code/statmast.php?title=27&amp;chapter=50" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 27-50</a>, <a href="https://www.scstatehouse.gov/code/statmast.php?title=12&amp;chapter=8" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-8</a>, <a href="https://dor.sc.gov/news/information-about-h-4216" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC DOR</a>, <a href="https://screaltors.org/wp-content/uploads/2026/02/310.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SCR Form 310</a>, <a href="https://www.nar.realtor/the-facts/what-the-nar-settlement-means-for-home-buyers-and-sellers" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NAR</a>, <a href="https://www.sccourts.org/media/opinions/HTMLFiles/SC/25508.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Doe v. McMaster</a>. Market: CCAR's MLS sales in Horry and Georgetown Counties, January to September; areas are ZIP codes. Companies: our count of a year of Horry County deeds, builders left out. Price cuts: our count of the listing feed. Forms: SCR 504 (purchase depends on sale), SCR 375 (stay after closing), DOR I-295 (hold-back).</p><style>.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Houses and condo towers side by side on the beach in Myrtle Beach. Photo: U.S. Geological Survey, <a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://doi.org/10.5066/F7N877XX" target="_blank" rel="noopener noreferrer">U.S. Geological Survey</a>. Chapter3 Realty resized the photo and cut 1x1, 4x3 and 16x9 crops.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObje