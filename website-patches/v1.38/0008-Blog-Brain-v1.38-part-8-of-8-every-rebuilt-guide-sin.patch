border:1.5px solid var(--navy);box-sizing:border-box}.c3ph-dots i:first-child{background:var(--navy)}@supports (animation-timeline:view()){.c3ph-rowbox{timeline-scope:--c3ph-p1,--c3ph-p2,--c3ph-p3}.c3ph-row>figure:nth-child(1){view-timeline:--c3ph-p1 inline}.c3ph-row>figure:nth-child(2){view-timeline:--c3ph-p2 inline}.c3ph-row>figure:nth-child(3){view-timeline:--c3ph-p3 inline}.c3ph-dots i{animation:c3ph-dot linear both;animation-range:cover}.c3ph-dots i:nth-child(1){animation-timeline:--c3ph-p1}.c3ph-dots i:nth-child(2){animation-timeline:--c3ph-p2}.c3ph-dots i:nth-child(3){animation-timeline:--c3ph-p3}@keyframes c3ph-dot{0%,36%{background:transparent}42%,60%{background:var(--navy)}66%,100%{background:transparent}}}@media (min-width:700px){.c3ph-swipe{display:none}}.c3ph-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:1.4rem 0 1.8rem;padding:0;list-style:none}@media (min-width:700px){.c3ph-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}}@media (min-width:1000px){.c3ph-cards.c3ph-4{grid-template-columns:repeat(4,minmax(0,1fr))}}.c3ph-card{margin:0;background:var(--ivory);border:1px solid var(--rule);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}.c3ph-card .c3ph-f{border-radius:0}.c3ph-card img,.c3ph-card svg{display:block;width:100%;height:auto;aspect-ratio:var(--c3ph-r,4/3);object-fit:cover}.c3ph-card .c3ph-cr{font-size:.56rem;padding:1.2rem .45rem .25rem 1.6rem}.c3ph-card strong{display:block;color:var(--navy);font-size:.98rem;font-weight:500;line-height:1.3;padding:.7rem .8rem 0}.c3ph-card span.c3ph-t{display:block;color:var(--muted);font-size:.86rem;line-height:1.45;padding:.2rem .8rem .85rem}.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:760px}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You may read that a POA covers more kinds of property than an HOA, such as empty lots or shops. Under either name, the group's papers on file with the county list what it runs and what its owners pay.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If you fall behind on dues, a POA can put a lien on your home when its papers allow one. A lien is a claim on the home for the money you owe. An HOA can do the same. Of the more than 500 associations that recorded a lien for unpaid charges in Horry County in 2025, about half have "homeowners" or "HOA" in the name, and one in five "property owners" or "POA".</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="What Horry County associations call themselves"><span class="cap" aria-hidden="true">What Horry County associations call themselves</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Word in the name, for example</span><span role="columnheader">share of associations</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Homeowners or HOA</span></span><span role="cell"><span class="b" style="--f:0.52" aria-hidden="true"></span><span class="v">52%</span></span></div><div role="row"><span role="rowheader"><span class="n">Property owners or POA</span></span><span role="cell"><span class="b" style="--f:0.2" aria-hidden="true"></span><span class="v">20%</span></span></div><div role="row"><span role="rowheader"><span class="n">Another name</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">community or master association</span></span><span role="cell"><span class="b" style="--f:0.18" aria-hidden="true"></span><span class="v">18%</span></span></div><div role="row"><span role="rowheader"><span class="n">A condo word</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">condominium or regime</span></span><span role="cell"><span class="b" style="--f:0.09" aria-hidden="true"></span><span class="v">9%</span></span></div></div></div><figcaption>Our count of the more than 500 associations that recorded a lien for unpaid charges in Horry County in 2025, from the county's deed index.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In a condo, an unpaid fee is a lien on the unit under state law. The association can foreclose in court, asking the court to sell the unit to pay the debt, as a lender can with a mortgage. For a house, the association's papers list what it can do. <a href="/hoa/liens-and-foreclosure/" style="color:var(--navy);text-decoration:underline">Can an HOA foreclose in South Carolina?</a> covers the steps, and <a href="/hoa/violations-and-fines/" style="color:var(--navy);text-decoration:underline">HOA violations and fines</a> covers fines.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A name does not always tell you the kind of home. A few names mix a condo word with "property owners" or "homeowners". Some carry no label word at all, only a place name such as a Tower or Villas.</p><p class="hp-note">On this page, POA means a property owners association, not a power of attorney.</p></div></section><section style="background:var(--ivory)" id="condo-vs-house"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Condo vs house">How is a condo association different from an HOA?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A condo association is an HOA too, but it runs a building, not a neighborhood. In a condo, the owners share the building. In a neighborhood of houses, you own your lot and the house on it. That one difference changes the fee, what it covers and how a lender looks at the home.</p><style>.c3-cc{margin:1.4rem 0 1.8rem;max-width:960px}.c3-cc table{width:100%;border-collapse:collapse;font-size:var(--read,1.0625rem);line-height:1.45;color:var(--muted)}.c3-cc caption{caption-side:top;text-align:left;color:var(--navy);font-weight:600;font-size:1em;line-height:1.4;padding:0 0 .7rem}.c3-cc th,.c3-cc td{padding:.6rem .7rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule);overflow-wrap:break-word}.c3-cc thead th{color:var(--navy);font-weight:600;font-size:1em;border-bottom:2px solid var(--navy);vertical-align:bottom}.c3-cc tbody th{color:var(--navy);font-weight:600}.c3-cc .n{text-align:right;font-variant-numeric:tabular-nums}.c3-cc .i{display:inline-flex;vertical-align:-4px;margin-right:.45rem;color:var(--brass-ink)}.c3-cc tr.c3-self>*{background:#fff}@media (max-width:39.999em){.c3-cc table,.c3-cc tbody,.c3-cc tr,.c3-cc th,.c3-cc td{display:block;width:auto}.c3-cc caption{display:block}.c3-cc thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.c3-cc tbody tr{background:var(--ivory-2);border-top:3px solid var(--brass);margin:0 0 .8rem;padding:.5rem 0 .6rem}section[style*="background:var(--ivory-2)"] .c3-cc tbody tr{background:var(--ivory)}.c3-cc tr.c3-self{background:#fff!important;border:2px solid var(--brass)}.c3-cc tr.c3-self>*{background:transparent}.c3-cc th,.c3-cc td{border:0;padding:.2rem 1rem}.c3-cc tbody th{display:flex;align-items:center;font-size:1.1em;padding-bottom:.35rem}.c3-cc tbody th .i{flex:none;vertical-align:0}.c3-cc tbody th a{display:inline-block;padding:.5rem 0}.c3-cc .n{text-align:left}.c3-cc td[data-label]::before{content:attr(data-label) ": ";color:var(--navy);font-weight:500}}</style><div class="c3-cc"><table><caption>House, townhouse or condo: what changes</caption><thead><tr><th scope="col">Kind of home</th><th scope="col">What you own</th><th scope="col">Roof and outside walls</th><th scope="col">Lender reviews the whole building</th></tr></thead><tbody><tr><th scope="row"><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span>House in an HOA or POA</th><td data-label="What you own">The lot and the house</td><td data-label="Roof and outside walls">The HOA's rules say who</td><td data-label="Lender reviews the whole building">No</td></tr><tr><th scope="row"><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 21h18M5 21V9.5l5-3V21M10 21V4h9v17M13 8h3M13 12h3M13 16h3M7.5 13h.01M7.5 16.5h.01"/></svg></span>Townhouse</th><td data-label="What you own">A lot or a unit, as its deed says</td><td data-label="Roof and outside walls">Like a house or a condo, by the deed</td><td data-label="Lender reviews the whole building">Like a house or a condo, by the deed</td></tr><tr><th scope="row"><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span>Condo</th><td data-label="What you own">Your unit and a share of the building</td><td data-label="Roof and outside walls">Every owner shares the cost</td><td data-label="Lender reviews the whole building">Yes, except detached or small buildings</td></tr></tbody></table></div><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-10-d/hoa-hoa-vs-poa/myrtle-beach-oceanfront-towers-1200w.webp" srcset="/images/2026-10-d/hoa-hoa-vs-poa/myrtle-beach-oceanfront-towers-600w.webp 600w, /images/2026-10-d/hoa-hoa-vs-poa/myrtle-beach-oceanfront-towers-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="675" alt="Tall oceanfront towers along the beach in Myrtle Beach, with a row of more towers into the distance" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: DiscoA340. License: CC BY-SA 4.0" title="License: CC BY-SA 4.0">Photo: DiscoA340</a></span></div><figcaption>Oceanfront towers in Myrtle Beach.</figcaption></figure></div></div></section><section style="background:var(--ivory-2)" id="what-you-own"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What you own">What do you own, and who fixes the roof?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In a condo you own your unit alone, plus a share of the shared parts, given as a percentage in the condo's founding papers.</p><figure class="hp-own"><div class="hp-own-g"><div class="pnl"><p class="k">A house in an HOA or POA</p><svg role="img" aria-label="Drawing: in a neighborhood of houses, you own the lot and the house on it; the association has the common areas." viewBox="0 0 340 250" width="100%" style="display:block;height:auto" font-family="var(--sans)"><rect x="0" y="210" width="340" height="40" fill="#e6dccb"/><rect x="8" y="96" width="190" height="130" rx="10" fill="rgba(196,120,58,.10)" stroke="#c4783a" stroke-width="2.5" stroke-dasharray="7 5"/><polygon points="34,152 103,104 172,152" fill="#c4783a"/><rect x="46" y="150" width="114" height="62" fill="#fff" stroke="#1c2028" stroke-width="2"/><rect x="92" y="174" width="22" height="38" fill="#1c2028" opacity=".85"/><rect x="58" y="164" width="22" height="18" fill="#cfdde6" stroke="#1c2028" stroke-width="1.5"/><rect x="126" y="164" width="22" height="18" fill="#cfdde6" stroke="#1c2028" stroke-width="1.5"/><rect x="216" y="180" width="116" height="30" rx="12" fill="#a9cbd8" stroke="#5c6b78" stroke-width="1.5"/><text x="274" y="140" font-size="20" font-weight="700" fill="#1c2028" text-anchor="middle">Common</text><text x="274" y="164" font-size="20" fill="#1c2028" text-anchor="middle">areas</text><text x="8" y="30" font-size="23" font-weight="700" fill="#8a5226">Yours</text><text x="8" y="60" font-size="20" fill="#1c2028">the lot and the house on it</text></svg></div><div class="pnl"><p class="k">A condo</p><svg role="img" aria-label="Drawing: in a condo, you own your unit; the roof, main walls, halls, elevators and land are shared by every owner." viewBox="0 0 340 250" width="100%" style="display:block;height:auto" font-family="var(--sans)"><rect x="0" y="210" width="340" height="40" fill="#e6dccb"/><rect x="18" y="92" width="170" height="120" fill="rgba(92,107,120,.14)" stroke="#5c6b78" stroke-width="2"/><rect x="12" y="82" width="182" height="12" fill="#5c6b78"/><rect x="30" y="104" width="42" height="26" rx="3" fill="#fff" stroke="#1c2028" stroke-width="1.5"/><rect x="82" y="104" width="42" height="26" rx="3" fill="#fff" stroke="#1c2028" stroke-width="1.5"/><rect x="134" y="104" width="42" height="26" rx="3" fill="#fff" stroke="#1c2028" stroke-width="1.5"/><rect x="30" y="139" width="42" height="26" rx="3" fill="#fff" stroke="#1c2028" stroke-width="1.5"/><rect x="82" y="139" width="42" height="26" rx="3" fill="#fff" stroke="#1c2028" stroke-width="1.5"/><rect x="134" y="139" width="42" height="26" rx="3" fill="#c4783a" stroke="#8a5226" stroke-width="3"/><rect x="30" y="174" width="42" height="26" rx="3" fill="#fff" stroke="#1c2028" stroke-width="1.5"/><rect x="82" y="174" width="42" height="26" rx="3" fill="#fff" stroke="#1c2028" stroke-width="1.5"/><rect x="134" y="174" width="42" height="26" rx="3" fill="#fff" stroke="#1c2028" stroke-width="1.5"/><line x1="176" y1="152" x2="214" y2="152" stroke="#8a5226" stroke-width="2.5"/><text x="220" y="148" font-size="23" font-weight="700" fill="#8a5226">Yours</text><text x="220" y="174" font-size="20" fill="#1c2028">one unit</text><text x="8" y="26" font-size="21" font-weight="700" fill="#1c2028">Shared by every owner</text><text x="8" y="52" font-size="19" fill="#1c2028">roof, main walls, halls,</text><text x="8" y="74" font-size="19" fill="#1c2028">elevators and the land</text></svg></div></div><figcaption>Our drawing of what you own in each.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Unless the founding papers say otherwise, the shared parts include the land under the building, the foundations, main walls, roofs, halls, lobbies, stairways, elevators and the central power and water systems. Every owner pays a share of their upkeep by that percentage, and the association insures the building. It may also enter your unit at reasonable hours to repair the shared parts, and for emergency repairs.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Who pays after a leak or a fire is on our <a href="/hoa/who-pays-for-damage/" style="color:var(--navy);text-decoration:underline">who pays for condo damage</a> page.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">And in a neighborhood of houses?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">South Carolina's <a href="https://www.scstatehouse.gov/code/t27c030.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">HOA Act</a> has no rule on who maintains or insures a house in a planned community. It is in the HOA's rules, in papers filed with the county. In most house listings, the fee does not include insurance.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Who fixes the roof on a home you like?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the address. We read its association papers and tell you what is yours to repair and insure.</p><a class="btn btn-brass" href="/contact/">Have us read its papers</a></div></div></section><section style="background:var(--ivory)" id="regime-fees"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Regime fees">What is a regime fee, and why is a condo fee higher?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A regime fee is the condo fee. South Carolina's <a href="https://www.scstatehouse.gov/code/t27c031.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">condo law</a> calls a condo a horizontal property regime. A condo fee is higher because it pays for the building: on the Grand Strand, the typical condo fee is nearly seven times the typical house fee.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="Typical monthly association fee of homes for sale on the Grand Strand"><span class="cap" aria-hidden="true">Typical monthly association fee of homes for sale on the Grand Strand</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Kind of home, range</span><span role="columnheader">typical fee a month</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Condo</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">the middle half pay roughly $460 to $940</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">about $650</span></span></div><div role="row"><span role="rowheader"><span class="n">Townhouse</span></span><span role="cell"><span class="b" style="--f:0.446" aria-hidden="true"></span><span class="v">about $290</span></span></div><div role="row"><span role="rowheader"><span class="n">House</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">the middle half pay roughly $70 to $135</span></span><span role="cell"><span class="b" style="--f:0.146" aria-hidden="true"></span><span class="v">about $95</span></span></div></div></div><figcaption>Our count of homes for sale in the local MLS that list a fee. Half pay more than the typical fee, and half pay less.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In a year, that is about $7,800 for the typical condo and about $1,100 for the typical house, on top of the mortgage, the property tax and your own insurance.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">What fees run here, by kind of home, and what each one covers is on our <a href="/hoa/" style="color:var(--navy);text-decoration:underline">Myrtle Beach HOA fees page</a>.</p><figure class="hp-pays"><p class="cap" id="hp-pays-cap">What the association fee covers</p><div class="hp-pays-t" role="table" aria-labelledby="hp-pays-cap"><div role="row" class="hd"><span role="columnheader">Covers</span><span role="columnheader">Condos</span><span role="columnheader">Town&shy;houses</span><span role="columnheader">Houses</span></div><div role="row"><span role="rowheader">Insurance</span><span role="cell"><b>78%</b><i aria-hidden="true"><i style="width:78%"></i></i></span><span role="cell"><b>34%</b><i aria-hidden="true"><i style="width:34%"></i></i></span><span role="cell"><b>4%</b><i aria-hidden="true"><i style="width:4%"></i></i></span></div><div role="row"><span role="rowheader">Water and sewer</span><span role="cell"><b>84%</b><i aria-hidden="true"><i style="width:84%"></i></i></span><span role="cell"><b>19%</b><i aria-hidden="true"><i style="width:19%"></i></i></span><span role="cell"><b>2%</b><i aria-hidden="true"><i style="width:2%"></i></i></span></div><div role="row"><span role="rowheader">Lawn care</span><span role="cell"><b>91%</b><i aria-hidden="true"><i style="width:91%"></i></i></span><span role="cell"><b>83%</b><i aria-hidden="true"><i style="width:83%"></i></i></span><span role="cell"><b>9%</b><i aria-hidden="true"><i style="width:9%"></i></i></span></div><div role="row"><span role="rowheader">Trash pickup</span><span role="cell"><b>91%</b><i aria-hidden="true"><i style="width:91%"></i></i></span><span role="cell"><b>73%</b><i aria-hidden="true"><i style="width:73%"></i></i></span><span role="cell"><b>46%</b><i aria-hidden="true"><i style="width:46%"></i></i></span></div><div role="row"><span role="rowheader">Internet</span><span role="cell"><b>70%</b><i aria-hidden="true"><i style="width:70%"></i></i></span><span role="cell"><b>25%</b><i aria-hidden="true"><i style="width:25%"></i></i></span><span role="cell"><b>9%</b><i aria-hidden="true"><i style="width:9%"></i></i></span></div><div role="row"><span role="rowheader">Amenities in the community</span><span role="cell"><b>87%</b><i aria-hidden="true"><i style="width:87%"></i></i></span><span role="cell"><b>56%</b><i aria-hidden="true"><i style="width:56%"></i></i></span><span role="cell"><b>61%</b><i aria-hidden="true"><i style="width:61%"></i></i></span></div></div><figcaption>Share of homes for sale with an association fee whose listing says the fee covers each item. The amenities row counts listings that say the community has shared amenities, not that the fee pays for them. Our count of the local MLS.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About three in ten houses for sale have no association at all. <a href="/buyers/no-hoa-homes/" style="color:var(--navy);text-decoration:underline">Homes with no HOA</a> has its own page.</p></div></section><section style="background:var(--ivory-2)" id="two-associations"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Two associations">Why do some homes pay two HOA fees?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Because some master-planned communities have two layers. A master association has rules over the whole community. Inside it, a neighborhood association or a condo association can have its own rules and its own fee. For you, that can mean two bills and two sets of rules. The name will not warn you: only 4 of the more than 500 associations in the lien count above have "master" in the name.</p><figure class="hp-layers" aria-label="Diagram: a master association over a whole community, with a neighborhood association and a condo association inside it"><div class="l1"><b>Master association</b><span>Rules over the whole community, and its own fee</span><div class="l2s"><div class="l2"><b>Neighborhood association</b><span>Its own rules and fee for one neighborhood</span></div><div class="l2"><b>Condo association</b><span>Its own rules and fee for one building</span></div></div></div><figcaption>Our diagram of two layers. A home can belong to the master association and to one association inside it.</figcaption></figure><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What do the two fees come to together?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The master's fee plus the fee of the association inside it. A listing's fee may leave out the second one, so we have no count of that total for homes here. For a home you send us, adding the two up is <a href="#what-we-check" style="color:var(--navy);text-decoration:underline">the second of our checks</a>.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Three communities here with more than one association</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Each entry starts with the typical fee that homes for sale there list, as their agents entered it.</p><div class="hp-comms"><article class="hp-comm"><h3>Grande Dunes<span>Myrtle Beach</span></h3><p class="fee">Houses for sale here list a typical fee of about $350 a month, nearly four times the typical house fee on the Grand Strand.</p><ul class="chips"><li class="top">Grande Dunes Master Association</li><li class="in">Bal Harbor Property Owners Association</li><li class="in">Cipriana Park Property Owners Association</li></ul><p>More than nine in ten of those listings say the community has shared amenities, and more than four in ten list a gate. Bal Harbor and Cipriana Park, two neighborhoods inside Grande Dunes, each have their own POA. Each has an agreement with the master on architectural review, the approval of changes to a home's outside.</p><div class="hx-strip" data-place="grande-dunes" data-name="Grande Dunes"></div><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Grande%20Dunes">Ask about Grande Dunes<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></article><article class="hp-comm"><h3>Barefoot Resort<span>North Myrtle Beach</span></h3><p class="fee">The typical condo for sale here lists about $570 a month, a little under the typical condo fee on the Grand Strand.</p><ul class="chips"><li class="top">Barefoot Resort Residential Owners Association</li><li class="in">Barefoot Resort Nonresidential Owners Association</li><li class="in">Condo associations for its buildings</li></ul><p>Nearly nine in ten of those listings say the fee covers insurance. The residential owners association is the master, with its own design guidelines. The nonresidential owners association is a separate one, with its own papers. Condo buildings inside Barefoot have their own condo associations.</p><div class="hx-strip" data-place="barefoot-resort" data-name="Barefoot Resort"></div><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Barefoot">Ask about Barefoot<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></article><article class="hp-comm"><h3>Prince Creek<span>Murrells Inlet</span></h3><p class="fee">A typical house for sale here lists a fee of about $140 a month.</p><ul class="chips"><li class="top">Prince Creek Master Community Association</li><li class="in">Prince Creek West Road and Park Districts Association</li></ul><p>About half of those listings list a gate, and eight in ten say the fee covers trash pickup. The master association has the master rules and design standards. Prince Creek West also has an association for its roads and parks, with its own rules and its own policy for collecting late dues.</p><div class="hx-strip" data-place="prince-creek" data-name="Prince Creek"></div><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Prince%20Creek">Ask about Prince Creek<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></article></div><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Does a home you like pay two fees?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Name the home. We look for a master association and any association inside it, and add up what each one charges.</p><a class="btn btn-brass" href="/contact/">Have us add up its fees</a></div></div></section><section style="background:var(--ivory)" id="surprises"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Surprises">What surprises buyers in an HOA or a condo?</h2><ol class="hp-sur"><li><span class="n" aria-hidden="true">1</span><div><b>Counting on the building's flood policy</b><p>In a condo, the association insures the building, and a policy on your own unit is a separate one. Flood insurance has a limit: the building's <a href="https://www.govinfo.gov/content/pkg/CFR-2025-title44-vol1/pdf/CFR-2025-title44-vol1-part61-appA3.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">National Flood Insurance Program</a> policy and your own flood policy together pay at most $250,000 for your unit. <a href="/hoa/master-insurance-ho6/" style="color:var(--navy);text-decoration:underline">Master insurance and your condo policy</a> shows which policy covers what.</p></div></li><li><span class="n" aria-hidden="true">2</span><div><b>Finding a second association after closing</b><p>The <a href="https://www.llr.sc.gov/re/RECPDF/Residential%20Property%20Condition%20Disclosure%20Statement%20Addendum.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">seller's disclosure form</a> has room for one association's charges and one contact. The <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeName" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County Register of Deeds</a> index is free to search online, but the county does not show the papers themselves to the public online. They are viewed and printed in Conway, or ordered by mail.</p></div></li></ol><div class="hp-stat"><p class="k">The papers often come late</p><p class="big">65%</p><p class="sub">of Horry County owners who complained to the state about their association got its papers only after they bought.</p><p class="do">Owners file these complaints with <a href="https://www.consumer.sc.gov/HOA-reports" target="_blank" rel="noopener" style="color:inherit">South Carolina Consumer Affairs</a>.</p><p class="src">235 of the 359 complaints from 2022 to 2025 that said when the owner got the papers</p></div></div></section><section style="background:var(--ivory-2)" id="what-we-check"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What we check">What do we check before you make an offer?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We read the papers of every association on the home, and we check these four things:</p><ol class="hp-sur hp-chk"><li><span class="n" aria-hidden="true">1</span><div><b>Every association the home belongs to</b><p>Not only the one on the seller's form. A second association means a second fee and a second set of rules.</p></div></li><li><span class="n" aria-hidden="true">2</span><div><b>What each one charges, and what the fee covers</b><p>Then you know what the fees add up to each month before you make an offer, and which bills they already pay.</p></div></li><li><span class="n" aria-hidden="true">3</span><div><b>The rules that could change your plans</b><p>For example, a ban on renting. When we search for an investor's rental, we read the HOA papers and leave out communities that ban it.</p></div></li><li><span class="n" aria-hidden="true">4</span><div><b>Who keeps up and insures what</b><p>In a condo, the building is shared. For a house, the HOA's papers say what is yours to keep up.</p></div></li></ol><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="/hoa/rental-restrictions/" style="color:var(--navy);text-decoration:underline">HOA rental restrictions</a> covers the rules on renting, and <a href="/hoa/reserves/" style="color:var(--navy);text-decoration:underline">HOA reserves</a> covers what an association has saved.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Four checks before you make an offer</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the address of a home you like, condo or house.</p><a class="btn btn-brass" href="/contact/">Have us run the four checks</a></div></div></section><section style="background:var(--ivory)" id="loans"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Loans">Does a condo association change your loan?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, for many condos. A lender that follows <a href="https://selling-guide.fanniemae.com/sel/b4-2.1-01/general-information-project-standards" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Fannie Mae's rules</a> reviews the whole condo project before a loan on an attached unit. That applies to a project of more than ten units, and to one of five to ten units inside a larger community or under a master association.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Three kinds of home skip the full review: a detached condo, a small condo project, and a house or townhouse in a neighborhood where every owner must belong to the HOA. A detached condo is a stand-alone home sold as a condo. <a href="/invest/non-warrantable-condos/" style="color:var(--navy);text-decoration:underline">Condos most lenders will not lend on</a> covers buildings that fail it.</p></div></section><section style="background:var(--ivory-2)" id="pros-and-cons"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Pros and cons">Does it matter if it is called a POA?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The real choice is between a condo and a house, not between an HOA and a POA:</p><div class="hp-pc"><div class="hp-pc-c"><h3>A condo</h3><ul><li class="g"><span aria-hidden="true">+</span><span>The association keeps up and insures the building, roof included.</span></li><li class="g"><span aria-hidden="true">+</span><span>Your property tax bill is for your unit alone.</span></li><li class="b"><span aria-hidden="true">&minus;</span><span>The biggest monthly fee, because it pays for the building.</span></li><li class="b"><span aria-hidden="true">&minus;</span><span>Every owner shares the cost of big repairs to the building.</span></li></ul></div><div class="hp-pc-c"><h3>A house in an HOA or POA</h3><ul><li class="g"><span aria-hidden="true">+</span><span>The smallest monthly fee.</span></li><li class="g"><span aria-hidden="true">+</span><span>The lot and the house are yours alone.</span></li><li class="b"><span aria-hidden="true">&minus;</span><span>The policy on the house is a bill of its own.</span></li><li class="b"><span aria-hidden="true">&minus;</span><span>In some master-planned communities, a second association with its own rules and fee.</span></li></ul></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Whether dues are tax deductible has its own page: <a href="/hoa/tax-deductible/" style="color:var(--navy);text-decoration:underline">are HOA fees tax deductible</a>. How owners split the bill for a big condo repair is on <a href="/hoa/special-assessments/" style="color:var(--navy);text-decoration:underline">condo special assessments</a>. Our page <a href="/hoa/benefits/" style="color:var(--navy);text-decoration:underline">are HOA fees worth it</a> weighs what the fees buy against what you give up.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Torn between a condo and a house?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us your budget and the towns you like. We send condos and houses for sale, each with its monthly fee.</p><a class="btn btn-brass" href="/contact/">Send me condos and houses</a></div></div></section><section style="background:var(--ivory)" id="hoa-vs-poa-questions"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">HOA vs POA questions</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is an HOA the same as a POA in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. Under the South Carolina Homeowners Association Act, the name does not matter. A group is an HOA when papers filed with the county make the owners pay it dues, except a timeshare plan.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can a POA put a lien on my house?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, if its papers filed with the county give it a lien for unpaid dues, as an HOA's papers can. That is a claim on your house for the unpaid dues. About one in five of the more than 500 associations that recorded a lien for unpaid charges in Horry County in 2025 had "property owners" or "POA" in the name.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is a POA voluntary in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Only when no papers filed with the county make the owners pay it. A group with no such papers, such as a voluntary civic club, is not an HOA under South Carolina's HOA Act. If the papers on your home make you pay, the dues are not voluntary, whatever the group calls itself.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What is a regime fee in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The condo fee. South Carolina's condo law calls a condo a horizontal property regime, so the fee its owners pay is called a regime fee.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What do I own in a condo?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Your unit alone, plus a share of the shared parts, given as a percentage in the condo's founding papers. No owner can force the shared parts to be split up, and selling a unit sells its share with it.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can a home have two HOAs?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. A home in a master-planned community can belong to a master association and to a neighborhood or condo association inside it, each with its own papers and fee. Grande Dunes, Barefoot Resort and Prince Creek each have more than one association.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.scstatehouse.gov/code/t27c030.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 27-30</a>, <a href="https://www.scstatehouse.gov/code/t27c031.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 27-31</a>, <a href="https://www.scstatehouse.gov/code/t27c050.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 27-50</a>, <a href="https://www.llr.sc.gov/re/RECPDF/Residential%20Property%20Condition%20Disclosure%20Statement%20Addendum.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC disclosure addendum</a>, <a href="https://www.govinfo.gov/content/pkg/CFR-2025-title44-vol1/pdf/CFR-2025-title44-vol1-part61-appA3.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">44 CFR 61 App. A(3)</a>, <a href="https://selling-guide.fanniemae.com/sel/b4-2.1-01/general-information-project-standards" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Fannie Mae B4-2.1-01</a>, <a href="https://www.consumer.sc.gov/HOA-reports" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SCDCA HOA reports</a>, <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeName" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County deed index</a>. Fees and what they cover: our count of homes for sale in the local MLS. Association names: our count of the county's lien index. Not legal advice; a South Carolina attorney can advise on your documents.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Oceanfront towers in Myrtle Beach. Photo: DiscoA340, <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a>, via <a href="https://commons.wikimedia.org/wiki/File:Hotels_along_the_Grand_Strand_Beachfront_2.jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>. Chapter3 Realty cropped the photo to the towers and the beach (most of the sky cut), resized it, and cut 1x1, 4x3 and 16x9 crops for the page's share image.</div><div role="listitem">Chapter3 Realty resized these photos and cropped some of them. Each photo keeps the license listed with it.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-10-d/hoa-hoa-vs-poa/myrtle-beach-oceanfront-towers-1200w.webp","url":"https://chapter3realty.com/images/2026-10-d/hoa-hoa-vs-poa/myrtle-beach-oceanfront-towers-1200w.webp","width":1200,"height":675,"encodingFormat":"image/webp","name":"Oceanfront towers in Myrtle Beach","caption":"Oceanfront towers in Myrtle Beach.","description":"Tall oceanfront towers along the beach in Myrtle Beach, with a row of more towers into the distance","creator":{"@type":"Person","name":"DiscoA340"},"creditText":"DiscoA340, CC BY-SA 4.0, via Wikimedia Commons","copyrightNotice":"© DiscoA340, CC BY-SA 4.0","license":"https://creativecommons.org/licenses/by-sa/4.0/","acquireLicensePage":"https://commons.wikimedia.org/wiki/File:Hotels_along_the_Grand_Strand_Beachfront_2.jpg","isBasedOn":"https://commons.wikimedia.org/wiki/File:Hotels_along_the_Grand_Strand_Beachfront_2.jpg","contentLocation":{"@type":"Place","name":"oceanfront, seen from the beach, Myrtle Beach, South Carolina"},"representativeOfPage":true}]}</script></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Ask about any home on the Grand Strand</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">An agent reads its association papers and replies with the fees, the rules and who insures what.</p><a class="btn btn-brass btn-lg" href="/contact/">Ask about a home</a></div></section></main>
