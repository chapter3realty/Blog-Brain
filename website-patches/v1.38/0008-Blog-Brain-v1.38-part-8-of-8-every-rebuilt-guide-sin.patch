+must(MPC["2024"] > MPC["2025"] && MPC["2025"] > MPC["2026"], "row 6: condos no longer fell each first half");
+const CONDO_DOWN_2Y = Math.round((1 - MPC["2026"] / MPC["2024"]) * 100);
+must(CONDO_DOWN_2Y === 7, "row 6: no longer 7 percent");
