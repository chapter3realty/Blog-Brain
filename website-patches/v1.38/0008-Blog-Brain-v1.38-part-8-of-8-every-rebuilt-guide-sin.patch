-(function () {
-  /* Shows on every page load. The only thing that suppresses it is having
-     already submitted - see DONE below. To go back to once-per-visitor, put a
-     time check back in shouldSkip(). */
-  var DONE = 'c3PopDone', SEEN = 'c3PopSeen', DELAY = 10000, WARM = 4000;
-  /* The clip is 3.43s of footage. 1.33x runs it in 2.58s, which is the pace he
-     asked for (owner, 2026-09-13). Nothing is re-encoded: the element plays the
-     same file faster, and the keyer follows because it paints whatever frame is
-     showing. defaultPlaybackRate is set too, because load() resets
-     playbackRate to it. */
-  var RATE = 1.33;
-  var pop, lastFocus;
-
-  /* Metered or 2G: never fetch 3.6MB of video. Show the still and the form. */
-  var NET = navigator.connection || {};
-  var LIGHT = NET.saveData === true || /2g/.test(NET.effectiveType || '');
-
-  /* Two separate suppressions, and they answer different questions.
-     DONE (localStorage, permanent): they already gave us their details, so we
-     never ask again on any visit.
-     SEEN (sessionStorage, this visit only): they have already been shown it
-     once during this browsing session. Without this the popup reopened on
-     every page navigation, which is what a visitor reads as spam. It clears
-     when the browser tab closes, so a genuine return visit gets one more. */
-  function shouldSkip() {
-    /* Never on the listing search: the homes, the maps, and the guide pages that
-       carry homes strips. There the listings are the offer (owner, 2026-10-25). */
-    if (/^\/(homes|map)(\/|$)/.test(location.pathname) || document.querySelector('.hx-strip,[data-hx-map]')) return true;
-    try {
-      if (localStorage.getItem(DONE)) return true;
-      if (sessionStorage.getItem(SEEN)) return true;
-      return false;
-    }
-    catch (e) { return false; }               /* private mode: just show it */
-  }
-  function markSeen() { try { sessionStorage.setItem(SEEN, '1'); } catch (e) {} }
-  function markDone() { try { localStorage.setItem(DONE, String(Date.now())); } catch (e) {} }
