ff" fill-opacity=".9" stroke="#ffffff" stroke-width=".8"/><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="nm" y="4.5" text-anchor="middle">5</text><text class="l" x="0" y="-19.5" text-anchor="middle"><tspan x="0">Conway Medical</tspan></text></g></g><g transform="translate(227.9 155)"><g class="k"><rect x="-85.6" y="-34.2" width="171.2" height="21.5" rx="10" fill="#1c2028" fill-opacity=".1"/><rect x="-85.6" y="-35.5" width="171.2" height="21.5" rx="10" fill="#ffffff" fill-opacity=".9" stroke="#ffffff" stroke-width=".8"/><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="nm" y="4.5" text-anchor="middle">6</text><text class="l" x="0" y="-19.5" text-anchor="middle"><tspan x="0">Grand Strand Medical</tspan></text></g></g><g transform="translate(70 312.1)"><g class="k"><rect x="13" y="-9.4" width="175.8" height="21.5" rx="10" fill="#1c2028" fill-opacity=".1"/><rect x="13" y="-10.7" width="175.8" height="21.5" rx="10" fill="#ffffff" fill-opacity=".9" stroke="#ffffff" stroke-width=".8"/><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="nm" y="4.5" text-anchor="middle">7</text><text class="l" x="15" y="5.3"><tspan x="15">Tidelands Waccamaw</tspan></text></g></g><g transform="translate(316.8 65.2)"><g class="k"><rect x="-157.8" y="-9.4" width="144.8" height="21.5" rx="10" fill="#1c2028" fill-opacity=".1"/><rect x="-157.8" y="-10.7" width="144.8" height="21.5" rx="10" fill="#ffffff" fill-opacity=".9" stroke="#ffffff" stroke-width=".8"/><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><text class="nm" y="4.5" text-anchor="middle">8</text><text class="l" x="-15" y="5.3" text-anchor="end"><tspan x="-15">McLeod Seacoast</tspan></text></g></g></g></svg><figcaption style="color:var(--muted);font-size:.85rem;line-height:1.6;margin-top:.6rem">Map of the four 55+ communities (1 to 4) and the hospital nearest each (5 to 8). Map data: U.S. Census Bureau TIGER/Line; Horry County GIS.</figcaption></figure><ol class="c3-map-key" style="margin:.4rem 0 1.4rem 1.6rem;padding:0;max-width:760px;columns:2 14rem;column-gap:2rem;color:var(--muted);font-size:var(--read,1.0625rem);line-height:1.5"><li style="margin:0 0 .35rem;break-inside:avoid">Myrtle Trace</li><li style="margin:0 0 .35rem;break-inside:avoid">Seasons at Prince Creek West</li><li style="margin:0 0 .35rem;break-inside:avoid">Del Webb at Grande Dunes</li><li style="margin:0 0 .35rem;break-inside:avoid">Del Webb North Myrtle Beach</li><li style="margin:0 0 .35rem;break-inside:avoid">Conway Medical Center</li><li style="margin:0 0 .35rem;break-inside:avoid">Grand Strand Medical Center</li><li style="margin:0 0 .35rem;break-inside:avoid">Tidelands Waccamaw Community Hospital</li><li style="margin:0 0 .35rem;break-inside:avoid">McLeod Health Seacoast</li></ol><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Medicare rates hospitals from 1 to 5 stars. On <a href="https://www.medicare.gov/care-compare/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Care Compare</a>, Tidelands Waccamaw Community Hospital, nearest Seasons, has 4 stars. Conway Medical Center, nearest Myrtle Trace, and Grand Strand Medical Center, nearest Del Webb at Grande Dunes, have 2 each.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">McLeod Health has cut the ribbon on a new 48-bed hospital in Carolina Forest and says it opens this fall. It is about 6 minutes by car from Del Webb at Grande Dunes, the same as Grand Strand Medical Center.</p></div></section><section style="background:var(--ivory-2)" id="hurricanes"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Hurricanes and flooding">Do Myrtle Beach's 55+ communities have to evacuate for hurricanes?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Three of the four are outside every hurricane evacuation zone. Every home in Seasons at Prince Creek West is in Zone C.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">South Carolina draws its <a href="https://www.scemd.org/prepare/know-your-zone/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">evacuation zones</a> A, B and C around storm surge, the rise of sea water in a storm. A home outside every zone is not ordered out by its zone.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The homes in all four communities are outside FEMA's high-risk flood areas, so federal law does not require flood insurance with a mortgage, though a lender may still ask for it. In Seasons, 45 lots touch a high-risk area at one edge, so we check where the house is on the lot.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our <a href="/buyers/coastal-insurance/" style="color:var(--navy);text-decoration:underline">coastal insurance guide</a> explains wind and flood cover, and our <a href="/buyers/relocating/hurricanes/" style="color:var(--navy);text-decoration:underline">hurricane page</a> has more on storms here.</p></div></section><section style="background:var(--ivory)" id="weather"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Weather">What is the weather like in Myrtle Beach all year?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">January afternoons are in the mid to upper 50s: about 56 degrees in Myrtle Beach and about 58 in Conway. Each has close to 40 nights a year at or below freezing.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Summer is milder on the coast. In a normal year, Myrtle Beach has about 22 days of 90 degrees or more, and Conway, inland, about 58.</p></div></section><section style="background:var(--ivory-2)" id="yearly-cost"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Yearly cost at 65">What does a house near Myrtle Beach cost a year at 65?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Outside the city limits, a $400,000 house you live in costs about $1,380 a year in county tax and fees at 65, before insurance and any HOA fee.</p><figure class="c3-gchart"><div role="table" aria-label="Property tax a year on one $400,000 house outside the city limits"><span class="cap" aria-hidden="true">Property tax a year on one $400,000 house outside the city limits</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">How the house is used, rate</span><span role="columnheader">tax a year</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">You live in it, 65 or older</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">with the $50,000 exemption</span></span><span role="cell"><span class="b" style="--f:0.267" aria-hidden="true"></span><span class="v">$1,290</span></span></div><div role="row"><span role="rowheader"><span class="n">You live in it, under 65</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">the 4 percent rate</span></span><span role="cell"><span class="b" style="--f:0.305" aria-hidden="true"></span><span class="v">$1,470</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">A second home or a rental</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">the 6 percent rate</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">$4,820</span></span></div></div></div><figcaption>Horry County's 2026 tax rates, in the county outside the city limits. Inside a city, the city's tax is added.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The 4 percent rate is the lower tax rate on a home you live in. Until you apply for it, the county bills the house at the second-home rate. To get it, you certify that no one in your household claims to be a legal resident of another state. A house that becomes your home for any part of the year gets the lower rate for the whole year.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The $50,000 exemption at 65 is its own application. You qualify once you have lived in South Carolina for a year and turned 65 by December 31 of the year before. Until then, the same house is taxed about $1,470 a year.</p><div style="overflow-x:auto;margin:1.2rem 0;max-width:760px"><table style="width:100%;border-collapse:collapse;font-size:.92rem"><thead><tr><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">$400,000 house at 65</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">A year</th></tr></thead><tbody><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Tax and stormwater fee</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><span style="white-space:nowrap">$1,380</span></td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">HOA fee, four 55+ communities</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><span style="white-space:nowrap">$1,140 to $5,340</span></td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Flood insurance, if wanted</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><span style="white-space:nowrap">About $550 to $600</span></td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Homeowners insurance</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">A quote on the house</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Homeowners insurance is priced house by house. The <a href="https://doi.sc.gov/614/Cost-of-Homeowners-Insurance" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">state insurance department</a> says the price depends on how the house is built, its age, the fire protection nearby, the coverage and the deductible. We get you a quote on the exact house before you write an offer.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Property tax up north can be many times this. One of our clients from New York sold a $1 million house with more than $20,000 a year in property tax. They bought a $700,000 house here, with about $3,200 in tax. Those are one household's numbers, not a promise.</p></div></section><section style="background:var(--ivory)" id="income-tax"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Income tax">Does South Carolina tax Social Security and pensions?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">South Carolina does not tax Social Security. Pensions, IRAs and 401(k) plans get a deduction for each person, larger from the year you turn 65, and military retirement pay is not taxed at all. These rules come from a <a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/4216.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">new state law, Act 110</a>.</p><style>.c3-cc{margin:1.4rem 0 1.8rem;max-width:960px}.c3-cc table{width:100%;border-collapse:collapse;font-size:var(--read,1.0625rem);line-height:1.45;color:var(--muted)}.c3-cc caption{caption-side:top;text-align:left;color:var(--navy);font-weight:600;font-size:1em;line-height:1.4;padding:0 0 .7rem}.c3-cc th,.c3-cc td{padding:.6rem .7rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule);overflow-wrap:break-word}.c3-cc thead th{color:var(--navy);font-weight:600;font-size:1em;border-bottom:2px solid var(--navy);vertical-align:bottom}.c3-cc tbody th{color:var(--navy);font-weight:600}.c3-cc .n{text-align:right;font-variant-numeric:tabular-nums}.c3-cc .i{display:inline-flex;vertical-align:-4px;margin-right:.45rem;color:var(--brass-ink)}.c3-cc tr.c3-self>*{background:#fff}@media (max-width:39.999em){.c3-cc table,.c3-cc tbody,.c3-cc tr,.c3-cc th,.c3-cc td{display:block;width:auto}.c3-cc caption{display:block}.c3-cc thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.c3-cc tbody tr{background:var(--ivory-2);border-top:3px solid var(--brass);margin:0 0 .8rem;padding:.5rem 0 .6rem}section[style*="background:var(--ivory-2)"] .c3-cc tbody tr{background:var(--ivory)}.c3-cc tr.c3-self{background:#fff!important;border:2px solid var(--brass)}.c3-cc tr.c3-self>*{background:transparent}.c3-cc th,.c3-cc td{border:0;padding:.2rem 1rem}.c3-cc tbody th{display:flex;align-items:center;font-size:1.1em;padding-bottom:.35rem}.c3-cc tbody th .i{flex:none;vertical-align:0}.c3-cc tbody th a{display:inline-block;padding:.5rem 0}.c3-cc .n{text-align:left}.c3-cc td[data-label]::before{content:attr(data-label) ": ";color:var(--navy);font-weight:500}}</style><div class="c3-cc"><table><caption>Three example households a year, under the 2026 rules</caption><thead><tr><th scope="col">Example</th><th scope="col" class="n">Social Security</th><th scope="col">Other income</th><th scope=