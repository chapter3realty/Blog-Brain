idth:699px){main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2)>.wrap{padding:1.6rem 1.2rem 1.7rem!important;border-radius:24px!important}}</style><style>.c3-glance{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(var(--n),minmax(0,1fr));gap:.75rem;max-width:760px}.c3-glance li{display:flex;align-items:center;gap:.55rem;margin:0;padding:.5rem .6rem;background:rgba(255,255,255,.55);border:1px solid var(--rule);border-radius:6px;line-height:1.25}.c3-glance .i{flex:0 0 auto;display:flex;width:2rem;height:2rem;border-radius:50%;background:var(--ivory-2);color:var(--brass-ink);align-items:center;justify-content:center}.c3-glance strong{display:block;color:var(--navy);font-size:.9rem;font-weight:500}.c3-glance span.t{display:block;color:var(--muted);font-size:1rem}@media (max-width:699px){.c3-glance{gap:.3rem}.c3-glance li{flex-direction:column;justify-content:flex-start;text-align:center;gap:.2rem;padding:.4rem .1rem}.c3-glance .i{width:1.6rem;height:1.6rem}.c3-glance strong{font-size:.875rem}.c3-glance span.t{font-size:1rem;line-height:1.2}}</style><ul role="list" class="c3-glance" style="--n:3"><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 5h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM3 10h18M8 3v4M16 3v4M8 14h.01M12 14h.01M16 14h.01M8 17.5h.01M12 17.5h.01"/></svg></span><span><strong>Before it is final</strong><span class="t">you can sell during the case, when the two of you agree</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span><strong>Off the loan</strong><span class="t">only by a sale, a new loan or the lender's release</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span><span><strong>A spouse who will not sign</strong><span class="t">can be replaced by the clerk of court, on a judge's order</span></span></li></ul></div><p style="color:var(--muted);font-size:.9rem;margin-bottom:1rem">By <strong style="color:var(--navy);font-weight:600">Devin Day</strong>, Operations Officer &middot; Reviewed by <strong style="color:var(--navy);font-weight:600">Tim Nash</strong>, Broker-in-Charge &middot; <span style="white-space:nowrap">Updated November 8, 2026</span></p><p class="detail-sub">If the two owners cannot agree on the house during a divorce, South Carolina's Family Court decides, and it can order the house sold.</p></div></div><section style="background:var(--ivory)"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">The short answer</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. You can sell a house during a divorce in South Carolina, before or after the divorce is final, when the two of you agree. If you do not, the Family Court decides, and it can order the house sold.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A sale pays off the loan, so neither of you owes it after. If one of you keeps the house, the other still owes the old loan until it is paid off or the lender releases them.</p></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><p style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">A free price for the house from recorded county sales, one number both of you can see.</p><a class="btn btn-brass btn-lg" href="/contact/">Have us price the house</a></div></section><section style="background:var(--ivory);padding-top:2.5rem"><div class="wrap"><nav aria-label="On this page" style="margin-top:0;max-width:720px"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.3rem;font-weight:600">On this page</p><ul style="list-style:none;margin:0;padding:0"><li><a href="#who-gets-it" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Who gets the house</a></li><li><a href="#choices" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">The three choices</a></li><li><a href="#buyout" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">How a buyout works</a></li><li><a href="#agree" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">If you do not agree</a></li><li><a href="#tax" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Tax and timing</a></li><li><a href="#steps" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">The steps</a></li><li><a href="#selling-a-house-in-a-divorce-faq" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Selling a house in a divorce: FAQ</a></li></ul></nav></div></section><section style="background:var(--ivory-2)" id="who-gets-it"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Who gets the house">Who gets the house in a divorce in South Carolina?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The <a href="https://www.scstatehouse.gov/code/statmast.php?title=63&amp;chapter=3" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Family Court</a> divides the house as part of the marital property. Lawyers call this equitable distribution, a fair split that is not always half.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In South Carolina, a house bought during the marriage is usually marital property, even if only one spouse's name is on the deed. The exceptions include a house bought with one spouse's inherited or premarital money, or one a prenuptial agreement leaves out.</p><div class="dv-two" role="group" aria-label="What South Carolina divides in a divorce, and what it does not"><div><p class="k">Usually divided</p><ul><li>A house either of you bought during the marriage</li><li>Anything else either of you bought during the marriage and still owns on the day the case is filed</li><li>A rise in the value of one spouse's house that came from the other spouse's efforts</li></ul></div><div><p class="k">Not divided</p><ul><li>What one spouse inherited, or was given by someone other than the other spouse</li><li>What one spouse owned before the marriage, and what was bought with either of those</li><li>What a written agreement, such as a prenuptial agreement, leaves out</li><li>What is bought after a temporary court order or a signed property agreement</li></ul></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A house one spouse owned before the marriage is not marital property under the law. Any rise in its value that came from the other spouse's efforts can be divided.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is it split 50/50?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. South Carolina <a href="https://www.scstatehouse.gov/code/statmast.php?title=20&amp;chapter=3" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">law</a> does not split marital property in half by rule. The judge weighs 15 factors, as much or as little as the judge finds right.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The factors include how long the marriage lasted and each spouse's income. They include what each spouse put in, counting work in the home, any debts on the property and the tax effect of the split. One factor is whether the parent with custody of the children gets the family home, or the right to live in it for a reasonable time.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Once the court divides the property, that part of the order is final. It can be changed only on appeal.</p></div></section><section style="background:var(--ivory)" id="choices"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The three choices">Sell, buy out your spouse, or keep the house: what does each leave you?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The two of you can choose any of the three by agreement. If you cannot agree, the judge chooses.</p><ul class="dv-cards" aria-label="Three choices for the house in a divorce"><li><span class="k">Choice 1</span><b>Sell and split</b>The house is sold, the loan is paid off at closing, and the two of you divide what is left. The sale pays the deed fee and agent fees. Neither of you owes the old loan after.</li><li><span class="k">Choice 2</span><b>One buys the other out</b>One of you keeps the house and pays the other for their share. The deed between you pays no deed fee, and there is no agent fee. The money can come from a <a href="#buyout" style="color:var(--navy);text-decoration:underline">new loan</a>.</li><li><span class="k">Choice 3</span><b>One keeps it for a time</b>One of you stays in the house for a time, and it is sold or bought out later. Both of you still owe the loan, unless the lender releases one of you.</li></ul><div class="dv-side"><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The calculator works out the first two choices with your own numbers. It starts at a typical Horry County house, about $350,000, with an example $200,000 still owed. We read the county's recorded house sales for the 12 months to September 2026; that was the middle price, condos aside.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">It also starts at an equal split, though a court's split is not always equal.</p><div class="dv-calc" role="group" aria-labelledby="dvCalcT"><p class="k" id="dvCalcT">Try your own numbers</p><div class="dv-in"><label for="dvP">Value of the house</label><span class="u">$ <input id="dvP" type="number" min="0" step="1000" value="350000" oninput="dvCalc()"></span></div><div class="dv-in"><label for="dvO">Still owed on it</label><span class="u">$ <input id="dvO" type="number" min="0" step="1000" value="200000" oninput="dvCalc()"></span></div><div class="dv-in"><label for="dvF">A fee you were quoted, in percent</label><span class="u"><input id="dvF" class="sm" type="number" min="0" max="10" step="0.25" value="1" oninput="dvCalc()"> %</span></div><div class="dv-in"><label for="dvS">Your share, the split you agree or the court orders</label><span class="u"><input id="dvS" class="sm" type="number" min="0" max="100" step="1" value="50" oninput="dvCalc()"> %</span></div><dl class="dv-out"><div><dt>If you sell, you get about</dt><dd id="dvR1">$72,603</dd></div><div><dt>If your spouse keeps it, you are paid</dt><dd id="dvR2">$75,000</dd></div><div><dt>If you keep it, you pay your spouse</dt><dd id="dvR3">$75,000</dd></div><div><dt>and your new loan is at least</dt><dd id="dvR4">$275,000</dd></div></dl><p class="n" id="dvUw" hidden>You owe more than the house is worth. The money from a sale would not pay off the loan. The lender may agree to a short sale.</p><p class="n">The box starts at 1 percent. Type the fee an agent quoted you.</p></div><script>function dvCalc(){var g=function(i){var v=parseFloat(document.getElementById(i).value);return isFinite(v)&&v>0?v:0};var m=function(n){return "$"+Math.round(Math.max(0,n)).toLocaleString("en-US")};var p=g("dvP"),o=g("dvO"),f=g("dvF"),s=Math.min(g("dvS"),100)/100;var e=p-o,d=Math.ceil(p/500)*1.85;document.getElementById("dvR1").textContent=m((e-d-p*f/100)*s);document.getElementById("dvR2").textContent=m(e*s);document.getElementById("dvR3").textContent=m(e*(1-s));document.getElementById("dvR4").textContent=m(o+e*(1-s));document.getElementById("dvUw").hidden=!(o>p)}</script><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The results leave out the closing attorney's fee, other closing costs and the new loan's own costs. Our <a href="/sell/net-proceeds/" style="color:var(--navy);text-decoration:underline">net proceeds calculator</a> counts every cost of a sale, and our <a href="/sell/home-value/" style="color:var(--navy);text-decoration:underline">home value page</a> shows how a house here is priced from recorded sales.</p></div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">When a buyout will not work</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If the one who wants to keep the house cannot get a new loan for the buyout, the buyout cannot be paid that way. Then the choices left are a sale, keeping it for a time, or the judge's decision.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If one of you keeps the house for a time, the money question waits until it is sold or bought out. A written agreement or order that lets one spouse live there also matters for the <a href="#tax" style="color:var(--navy);text-decoration:underline">tax rule</a> later.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">What would each choice leave the two of you?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the address and what is still owed. We price the house from recorded sales near it and set a sale and a buyout side by side.</p><a class="btn btn-brass" href="/contact/">Have us work out both choices on your house</a></div></div></section><section style="background:var(--ivory-2)" id="buyout"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="How a buyout works">How does a buyout work, and how does the other spouse get off the mortgage?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The spouse who leaves gets off the loan in one of three ways. The house is sold, a new loan pays off the old one, or the lender releases them. A divorce order that gives the house to one spouse does not do it, and neither does a quitclaim deed.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The money for a buyout can come from that new loan, which some people call a refinance.</p><ol class="dv-num" aria-label="How a buyout works, in order"><li><b>Agree on the value</b>Use an appraisal, or a real estate agent's written price estimate. If you do not agree, the judge decides the value from the evidence and may appoint an expert, such as an appraiser.</li><li><b>Write the terms down</b>The agreement says who keeps the house, what the other is paid and by when.</li><li><b>The new loan</b>The spouse who keeps the house must qualify for a new loan. It has to pay off the old loan and pay the other spouse. On the example above, that is at least $275,000.</li><li><b>The deed</b>A deed from one spouse to the other as part of the divorce is <a href="https://www.scstatehouse.gov/code/statmast.php?title=12&amp;chapter=24" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">exempt from the deed fee</a>. The exception is a spouse who gets it and is neither a US citizen nor a US resident. A sale of the same house pays $1,295.</li><li><b>The old loan is paid off</b>The new loan pays off the old one. That ends the debt of the spouse who left.</li></ol><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">If the old loan stays</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The lender <a href="https://www.law.cornell.edu/uscode/text/12/1701j-3" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">cannot call the whole loan due</a> because of the divorce, if the spouse on the loan lived there and the one who keeps it lives there. This does not cover a rental or a second home. The spouse who left still owes that loan unless the lender releases them.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If you plan to buy your next home, our page on <a href="/sell/sell-or-buy-first/" style="color:var(--navy);text-decoration:underline">selling or buying first</a> covers the order of the two.</p></div></section><section style="background:var(--ivory)" id="agree"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="If you do not agree">Can my spouse sell the house without me, or refuse to sell?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If both of your names are on the deed, your spouse cannot sell the whole house without you. A sale of the whole house needs both of you to sign the deed, or a judge's order.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If your spouse refuses to sell, the judge can order the sale and order your spouse to sign the deed. If your spouse still will not, the judge can <a href="https://www.scstatehouse.gov/code/statmast.php?title=20&amp;chapter=3" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">have the county's clerk of court sign it</a>, and that signature counts the same.</p><h3 id="notice" style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">If only your spouse's name is on the deed</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Then your claim to the house does not bind a buyer or lender until a <a href="https://www.scstatehouse.gov/code/statmast.php?title=15&amp;chapter=11" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">notice of the divorce case</a> is filed. Either spouse can file it with the clerk of court in the county where the house is. Lawyers call the notice a lis pendens.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">After it is filed, a buyer or lender who takes an interest later is bound by the case. It does not affect a buyer or lender whose rights came first. A family law attorney can tell you whether to file one.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">If the deed says joint tenants with rights of survivorship</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Some deeds name just the two spouses as "joint tenants with rights of survivorship". Then, until the <a href="https://www.scstatehouse.gov/code/statmast.php?title=27&amp;chapter=7" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">final divorce order</a> is filed, if one of you dies, the other owns the whole house. The final order ends that, unless it says otherwise.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Listing the house while you disagree</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">An agent may not market a house without a <a href="https://www.scstatehouse.gov/code/statmast.php?title=40&amp;chapter=57" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">written listing agreement</a> with the owner. Every offer reaches the seller in writing. Changes made during negotiations are in writing, initialed and dated by both sides.</p><h3 id="mediation" style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">If you cannot agree on a price or an offer</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most contested issues in a divorce case, the house included, <a href="https://www.sccourts.org/resources/judicial-community/court-rules/adr/rule-3/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">must go to mediation</a>, unless an exception applies. A mediator is a neutral person who helps the two sides talk. The mediator does not decide, and any agreement is voluntary.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If the two of you still do not agree, the judge decides the terms.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Arguing over what the house is worth?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the address. We send one written price from recorded county sales near the house, the same number to each of you.</p><a class="btn btn-brass" href="/contact/">Have us send one price to both of you</a></div></div></section><section style="background:var(--ivory-2)" id="tax"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Tax and timing">Capital gains tax in a divorce: should you sell before or after it is final?</h2><div class="dv-side"><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For most Horry County houses, selling before or after the divorce is final does not change the tax, if each of you meets the 2-year tests. The whole gain on a typical house bought in 1998 or later is under $250,000, one person's limit. For one bought in the mid-1990s it is close to the limit.</p><figure class="dv-chart"><p class="cap" id="dvChartT">Estimated gain on the whole house, for a typical Horry County house that sells for about $350,000 today, by the year it was bought</p><div class="dv-plot" id="dvPlot"><span class="dv-yl" style="top:100%">$0</span><span class="dv-yl" style="top:66.66666666666667%">$100k</span><span class="dv-yl" style="top:33.333333333333336%">$200k</span><svg viewBox="0 0 600 240" preserveAspectRatio="none" role="img" aria-label="Estimated gain on the whole of a typical Horry County house that sells for about $350,000 today, by the year it was bought: close to the $250,000 limit for a house bought in the mid-1990s, about $151,000 for 2006, $183,000 for 2016 and $120,000 for 2021, falling toward zero for a house bought recently."><line x1="0" x2="600" y1="240" y2="240" class="g" vector-effect="non-scaling-stroke"/><line x1="0" x2="600" y1="160" y2="160" class="g" vector-effect="non-scaling-stroke"/><line x1="0" x2="600" y1="80" y2="80" class="g" vector-effect="non-scaling-stroke"/><polygon points="0,240 0.0,35.2 20.0,40.8 40.0,43.2 60.0,49.6 80.0,52.0 100.0,55.2 120.0,60.0 140.0,64.0 160.0,67.2 180.0,74.4 200.0,89.6 220.0,119.2 240.0,131.2 260.0,123.2 280.0,112.8 300.0,92.0 320.0,81.6 340.0,77.6 360.0,78.4 380.0,85.6 400.0,90.4 420.0,93.6 440.0,100.8 460.0,106.4 480.0,116.8 500.0,123.2 520.0,144.0 540.0,191.2 560.0,213.6 580.0,224.0 600.0,237.6 600,240" class="a"/><polyline points="0.0,35.2 20.0,40.8 40.0,43.2 60.0,49.6 80.0,52.0 100.0,55.2 120.0,60.0 140.0,64.0 160.0,67.2 180.0,74.4 200.0,89.6 220.0,119.2 240.0,131.2 260.0,123.2 280.0,112.8 300.0,92.0 320.0,81.6 340.0,77.6 360.0,78.4 380.0,85.6 400.0,90.4 420.0,93.6 440.0,100.8 460.0,106.4 480.0,116.8 500.0,123.2 520.0,144.0 540.0,191.2 560.0,213.6 580.0,224.0 600.0,237.6" class="l" vector-effect="non-scaling-stroke"/><line x1="0" x2="600" y1="39.99999999999999" y2="39.99999999999999" class="lim" vector-effect="non-scaling-stroke"/></svg><span class="dv-lim" style="top:16.666666666666664%"><span class="w">One owner's limit, </span>$250,000</span><span class="dv-dot" id="dvDot" aria-hidden="true"></span><span class="dv-tip" id="dvTip" aria-hidden="true"></span></div><div class="dv-xa" aria-hidden="true"><span style="left:0%">1995</span><span style="left:33.33333333333333%">2005</span><span style="left:66.66666666666666%">2015</span><span style="left:100%">2025</span></div><p class="dv-xt" aria-hidden="true">Year the house was bought</p><table class="sr"><caption>Estimated gain by year bought</caption><thead><tr><th scope="col">Year bought</th><th scope="col">Estimated gain</th></tr></thead><tbody><tr><td>1995</td><td>$256,000</td></tr><tr><td>1996</td><td>$249,000</td></tr><tr><td>1997</td><td>$246,000</td></tr><tr><td>1998</td><td>$238,000</td></tr><tr><td>1999</td><td>$235,000</td></tr><tr><td>2000</td><td>$231,000</td></tr><tr><td>2001</td><td>$225,000</td></tr><tr><td>2002</td><td>$220,000</td></tr><tr><td>2003</td><td>$216,000</td></tr><tr><td>2004</td><td>$207,000</td></tr><tr><td>2005</td><td>$188,000</td></tr><tr><td>2006</td><td>$151,000</td></tr><tr><td>2007</td><td>$136,000</td></tr><tr><td>2008</td><td>$146,000</td></tr><tr><td>2009</td><td>$159,000</td></tr><tr><td>2010</td><td>$185,000</td></tr><tr><td>2011</td><td>$198,000</td></tr><tr><td>2012</td><td>$203,000</td></tr><tr><td>2013</td><td>$202,000</td></tr><tr><td>2014</td><td>$193,000</td></tr><tr><td>2015</td><td>$187,000</td></tr><tr><td>2016</td><td>$183,000</td></tr><tr><td>2017</td><td>$174,000</td></tr><tr><td>2018</td><td>$167,000</td></tr><tr><td>2019</td><td>$154,000</td></tr><tr><td>2020</td><td>$146,000</td></tr><tr><td>2021</td><td>$120,000</td></tr><tr><td>2022</td><td>$61,000</td></tr><tr><td>2023</td><td>$33,000</td></tr><tr><td>2024</td><td>$20,000</td></tr><tr><td>2025</td><td>$3,000</td></tr></tbody></table><figcaption>Improvements and selling costs, not counted here, lower the gain.</figcaption><script>(function(){var d=[[1995,256000],[1996,249000],[1997,246000],[1998,238000],[1999,235000],[2000,231000],[2001,225000],[2002,220000],[2003,216000],[2004,207000],[2005,188000],[2006,151000],[2007,136000],[2008,146000],[2009,159000],[2010,185000],[2011,198000],[2012,203000],[2013,202000],[2014,193000],[2015,187000],[2016,183000],[2017,174000],[2018,167000],[2019,154000],[2020,146000],[2021,120000],[2022,61000],[2023,33000],[2024,20000],[2025,3000]],p=document.getElementById("dvPlot"),t=document.getElementById("dvTip"),o=document.getElementById("dvDot");function show(e){var b=p.getBoundingClientRect(),x=Math.min(Math.max((e.clientX-b.left)/b.width,0),1),i=Math.round(x*(d.length-1)),r=d[i],l=i/(d.length-1)*100,y=(1-r[1]/300000)*100;o.style.left=l+"%";o.style.top=y+"%";o.style.display="block";t.textContent="Bought in "+r[0]+": gain about $"+(Math.round(r[1]/1000)*1000).toLocaleString("en-US");t.style.left=Math.min(Math.max(l,18),82)+"%";t.style.top=Math.max(y-4,0)+"%";t.style.display="block"}p.addEventListener("pointermove",show);p.addEventListener("pointerdown",show);p.addEventListener("pointerleave",function(){t.style.display="none";o.style.display="none"})})()</script></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The chart shows the gain on the whole house. We checked what a house that sells for about $350,000 today would have cost in each year, using the <a href="https://www.fhfa.gov/data/hpi" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">federal house price index</a> for the Myrtle Beach area.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">When a couple sells a house they own together, each reports their own share of the gain. Each single owner has their own $250,000 limit for their share.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Timing matters when the whole gain is near or over $250,000 and one of you will own the house alone, for example after a buyout. While you are still married, a joint return can use a $500,000 limit, if both of you meet the tests on our <a href="/sell/capital-gains/" style="color:var(--navy);text-decoration:underline">capital gains page</a>.</p></div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Before or after the divorce is final</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If you have no final decree of divorce or separate maintenance by the last day of your tax year, you <a href="https://www.irs.gov/publications/p504" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">count as married</a> for that whole year. For most people that day is December 31, and the rule applies even if you live apart. Separate maintenance is a court order for support while a couple lives apart.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">If one of you has moved out</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A spouse who moved out can still count the house as their home for the tax rule. That holds if a divorce decree, a written separation agreement or a support order lets the other spouse live there, and the other spouse does. Without one of those papers, the time after you move out does not count as time you lived there.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">A buyout and tax</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Generally, moving the house, or your share of it, to your spouse as part of the divorce is <a href="https://www.irs.gov/publications/p523" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">not a sale for tax purposes</a>. There is no gain or loss to report then. This does not hold if the spouse who gets it is neither a US citizen nor a US resident.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The spouse who keeps the house takes on the gain from the original purchase. When they sell it later, that whole gain counts.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If you sell before you meet the 2-year tests, a divorce is one of the listed reasons that can still allow a smaller, partial exclusion. Ask a tax professional before the terms of your agreement are set.</p></div></section><section style="background:var(--ivory)" id="steps"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The steps">What are the steps to sell a house in a divorce in South Carolina?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Seven steps, from living apart to the money from the sale. The order of steps 5 and 6 depends on when the two of you agree.</p><ol class="dv-steps" aria-label="The steps to sell or keep a house in a South Carolina divorce, in order"><li><span class="n" aria-hidden="true">1</span><span class="c"><span class="t">Before the case</span><b>Living apart</b>A no-fault divorce is one where neither spouse has to prove the other did wrong. In South Carolina it needs <a href="https://www.scstatehouse.gov/code/statmast.php?title=20&amp;chapter=3" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">one year of living apart</a>, without living together as a couple.</span></li><li><span class="n" aria-hidden="true">2</span><span class="c"><span class="t">The case</span><b>The case is filed in Family Court</b>In Horry County, it is filed with the <a href="https://www.horrycountysc.gov/departments/clerk-of-court/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Clerk of Court</a>. The clerk has offices in Conway and Myrtle Beach.</span></li><li><span class="n" aria-hidden="true">3</span><span class="c"><span class="t">If needed</span><b>A notice of the case on the house</b>It matters most when the house is in one spouse's name.</span></li><li><span class="n" aria-hidden="true">4</span><span class="c"><span class="t">Before a judge decides</span><b>Mediation</b>Most issues you disagree on, the house included, go to a mediator first.</span></li><li><span class="n" aria-hidden="true">5</span><span class="c"><span class="t">The decision</span><b>Agreement or order</b>A signed agreement or the judge's order says whether the house is sold, bought out or kept.</span></li><li><span class="n" aria-hidden="true">6</span><span class="c"><span class="t">Before or after the divorce</span><b>The sale or the deed</b>On most grounds a final divorce cannot be granted until three months after the case is filed. On the one-year-apart ground, it can be granted once the other spouse has answered the case or missed the deadline to answer.</span></li><li><span class="n" aria-hidden="true">7</span><span class="c"><span class="t">Closing</span><b>The money</b>The lawyer who holds the money from a sale, such as the closing attorney, <a href="https://www.sccourts.org/resources/judicial-community/court-rules/appellate/rule-407/rule-115/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">must keep any part the two of you dispute</a> separate. It stays separate until you agree, a court decides, or a narrow exception in the rule applies. The part you agree on is paid out promptly.</span></li></ol></div></section><section style="background:var(--ivory-2)" id="selling-a-house-in-a-divorce-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Selling a house in a divorce: FAQ</h2><style>.c3-faq details{border-top:1px solid var(--rule,rgba(15,27,45,.14))}.c3-faq details:last-child{border-bottom:1px solid var(--rule,rgba(15,27,45,.14))}.c3-faq summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.2rem 0}.c3-faq summary::-webkit-details-marker{display:none}.c3-faq summary h3{margin:.9rem 0!important;flex:1}.c3-faq summary::after{content:"+";font:400 1.5rem/1 var(--sans);color:var(--brass);flex:none;width:1.5rem;text-align:center}.c3-faq details[open] summary::after{content:"\2212"}.c3-faq details p{margin:0 0 1rem!important}.c3-faq summary:focus-visible{outline:2px solid var(--brass);outline-offset:3px}</style><div class="c3-faq"><details open><summary><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is South Carolina a 50/50 divorce state?</h3></summary><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. The law has no equal-split rule, so the judge's split of the house can be more or less than half.</p></details><details><summary><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Who pays the mortgage during the divorce?</h3></summary><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Both of you owe the lender while both names are on the loan, so a missed payment is missed for both of you. While the case is open, the Family Court can order temporary support. A support order can make one spouse pay debts for the other, such as the mortgage.</p></details><details><summary><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What if we owe more than the house is worth?</h3></summary><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Then the money from a sale would not pay off the loan. The lender may agree to a short sale, a sale for less than what is owed. If the lender forgives the rest, get that in writing.</p></details><details><summary><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is a house I inherited marital property in South Carolina?</h3></summary><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Usually not. What one spouse inherited is not marital property under the law. Whether it became marital, for example after it was put in both names, is a question for a family law attorney.</p></details></div><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.scstatehouse.gov/code/statmast.php?title=20&amp;chapter=3" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 20-3</a>, <a href="https://www.scstatehouse.gov/code/statmast.php?title=63&amp;chapter=3" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 63-3</a>, <a href="https://www.scstatehouse.gov/code/statmast.php?title=15&amp;chapter=11" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 15-11</a>, <a href="https://www.scstatehouse.gov/code/statmast.php?title=27&amp;chapter=7" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 27-7</a>, <a href="https://www.scstatehouse.gov/code/statmast.php?title=12&amp;chapter=24" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-24</a>, <a href="https://www.scstatehouse.gov/code/statmast.php?title=40&amp;chapter=57" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 40-57</a>, <a href="https://www.sccourts.org/resources/judicial-community/court-rules/adr/rule-3/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC ADR Rule 3</a>, <a href="https://www.sccourts.org/resources/judicial-community/court-rules/appellate/rule-407/rule-115/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC RPC 1.15</a>, <a href="https://www.law.cornell.edu/uscode/text/12/1701j-3" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">12 USC 1701j-3</a>, <a href="https://www.ecfr.gov/current/title-12/chapter-I/part-191/section-191.5" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">12 CFR 191.5</a>, <a href="https://www.irs.gov/publications/p523" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">IRS Pub. 523</a>, <a href="https://www.irs.gov/publications/p504" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">IRS Pub. 504</a>, <a href="https://www.consumerfinance.gov/ask-cfpb/what-is-a-short-sale-en-290/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">CFPB</a>, <a href="https://www.fhfa.gov/data/hpi" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FHFA HPI</a>, <a href="https://www.horrycountysc.gov/departments/clerk-of-court/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Clerk of Court</a>, <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeDocType" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">County deeds</a>. Our reading of county deeds: the typical house. The gain chart: our estimate from the FHFA index.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1rem"><strong style="color:var(--navy)">Legal notice.</strong> Chapter3 Realty Corp is a licensed South Carolina real estate brokerage. We are not attorneys or tax professionals, and nothing on this page is legal or tax advice. For advice on your own divorce, talk to a South Carolina family law attorney; for the tax on your sale, a tax professional.</p></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Selling the house in a divorce?</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">Start with a free price from recorded county sales. Tell us where things stand, alone or together.</p><a class="btn btn-brass btn-lg" href="/contact/">Have us talk with you about the house</a></div></section></main>
+<main id="main"><div class="detail-hero bg-grid"><div class="wrap"><div class="breadcrumb"><a href="/">Home</a><span>/</span><a href="/sell/">Sell</a><span>/</span><span style="color:var(--muted)">Selling in a Divorce</span></div><p class="eyebrow" style="margin-bottom:1rem">Selling a home</p><h1 class="detail-h1">Selling a house during a divorce in South Carolina<br/><em style="font-style:italic;color:var(--brass)">The three choices: sell and split, one buys the other out, or one keeps it for a time.</em></h1><div class="detail-media" style="margin:0 0 1.2rem;max-width:760px"><style id="c3-glass">main#main{--g-ink:#8a5226;--g-ink-lg:#a8612c;--g-edge:rgba(255,255,255,.8);--g-hi:inset 0 1px 0 rgba(255,255,255,.95);--g-sh:0 1px 2px rgba(28,32,40,.05),0 14px 36px -20px rgba(28,32,40,.3);--g-r:20px;--g-blur:saturate(150%) blur(16px);background-color:#f8f4ee;background-image:radial-gradient(44rem 26rem at 4% 460px,rgba(232,201,154,.30),rgba(232,201,154,0) 70%),radial-gradient(40rem 26rem at 98% 1000px,rgba(196,120,58,.08),rgba(196,120,58,0) 70%),radial-gradient(46rem 26rem at 16% 1500px,rgba(232,201,154,.22),rgba(232,201,154,0) 70%),radial-gradient(40rem 24rem at 94% 1960px,rgba(42,48,64,.045),rgba(42,48,64,0) 70%);background-size:100% 2400px;background-repeat:repeat-y}main#main>section[style*="background:var(--ivory"],main#main .detail-hero{background:transparent!important}main#main .detail-hero{border-bottom:0}main#main .detail-hero.bg-grid{background-image:none}main#main>section[style*="background:var(--ivory"]+section[style*="background:var(--ivory"]{border-top:1px solid rgba(255,255,255,.7)}main#main>section[style*="background:var(--ivory"]{padding-bottom:2.25rem}main#main>section[style*="background:var(--ivory"]:not(.detail-hero+section){padding-top:2.25rem}@media (min-width:700px){main#main>section[style*="background:var(--ivory"]{padding-bottom:3.5rem}main#main>section[style*="background:var(--ivory"]:not(.detail-hero+section){padding-top:3.5rem}}main#main .eyeb