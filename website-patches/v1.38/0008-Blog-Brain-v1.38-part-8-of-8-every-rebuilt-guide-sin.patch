ff" stroke="#91592b" stroke-width="1.6"/><use href="#c3r-del-webb-at-grande-dunes-beach" x="-7.4" y="-7.4" width="14.7" height="14.7" color="#1c2028"/><text class="l" x="-15" y="-3" text-anchor="end"><tspan x="-15">Beach</tspan></text><text class="m" x="-15" y="12.5" text-anchor="end">about 4 min</text></g></g><g transform="translate(289.3 66.5)"><g class="k"><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><use href="#c3r-del-webb-at-grande-dunes-hospital" x="-7.4" y="-7.4" width="14.7" height="14.7" color="#1c2028"/><text class="l" x="0" y="-35" text-anchor="middle"><tspan x="0">Hospital</tspan></text><text class="m" x="0" y="-19.5" text-anchor="middle">about 6 min</text></g></g><g transform="translate(49.4 285.2)"><g class="k"><circle r="11" fill="#ffffff" stroke="#91592b" stroke-width="1.6"/><use href="#c3r-del-webb-at-grande-dunes-airport" x="-7.4" y="-7.4" width="14.7" height="14.7" color="#1c2028"/><text class="l" x="11.9" y="-41.4"><tspan x="11.9">Myrtle Beach</tspan><tspan x="11.9" dy="16.5">airport</tspan></text><text class="m" x="11.9" y="-9.4">about 20 min</text></g></g><g transform="translate(245.3 91.9)"><g class="k"><g transform="scale(0.8)"><ellipse cx="0" cy="1" rx="7" ry="2.4" fill="#1c2028" opacity=".18"/><path d="M0 0C-3-6-13-14-13-26a13 13 0 1 1 26 0c0 12-10 20-13 26z" fill="#c4783a" stroke="#1c2028" stroke-width="1.5"/><use href="#c3r-del-webb-at-grande-dunes-home" x="-8.5" y="-34.5" width="17" height="17" color="#ffffff"/></g><text class="h" x="-15" y="-14.5" text-anchor="end"><tspan x="-15">Del Webb</tspan></text></g></g></g></svg><figcaption style="color:var(--muted);font-size:.85rem;line-height:1.6;margin-top:.6rem">Map of where Del Webb at Grande Dunes is in Myrtle Beach, with drive times by car. Map data: U.S. Census Bureau TIGER/Line; Horry County GIS.</figcaption></figure><p class="c3-map-links" style="display:flex;align-items:center;gap:.4rem;margin:.6rem 0 1.6rem;max-width:760px;font-size:.95rem"><span style="color:var(--brass-ink);display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span><a href="https://www.google.com/maps/search/?api=1&amp;query=33.749305,-78.842661" style="color:var(--navy);text-decoration:underline;text-underline-offset:3px" target="_blank" rel="noopener noreferrer">Open Del Webb at Grande Dunes in Google Maps</a></p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The nearest hospital is Grand Strand Medical Center, and the nearest grocery store is a Food Lion. The Boardwalk, with its big Ferris wheel, is about 15 minutes away.</p></div></section><section style="background:var(--ivory)" id="what-are-the-homes-like-in-del-webb-at-grande-dunes"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The homes">What are the homes like in Del Webb at Grande Dunes?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most homes in Del Webb at Grande Dunes are on one level, with 2 or 3 bedrooms and about 1,500 to 2,900 square feet.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The homes were built from 2018 to 2026. The builder has finished, so every home here is a resale now.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/55-plus/del-webb-grande-dunes/del-webb-grande-dunes-from-above-1200w.webp" srcset="/images/55-plus/del-webb-grande-dunes/del-webb-grande-dunes-from-above-600w.webp 600w, /images/55-plus/del-webb-grande-dunes/del-webb-grande-dunes-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="675" alt="Del Webb at Grande Dunes from above, with its edge drawn in orange beside the Intracoastal Waterway, streets of homes around ponds, and the clubhouse marked" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo. License: Public domain" title="License: Public domain">U.S. government aerial photo</a></span></div><figcaption>Del Webb at Grande Dunes from above, beside the Intracoastal Waterway. The orange line is the edge of the neighborhood.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The neighborhood has houses and villas. A villa here is a home that shares one wall with another home, and villas usually sell for less than houses.</p><div class="c3ph-gal" role="group" aria-label="Houses and villas in Del Webb at Grande Dunes, from above" style="--c3ph-n:2;--c3ph-r:4/3"><figure><div class="c3ph-f"><img src="/images/55-plus/del-webb-grande-dunes/del-webb-grande-dunes-homes-from-above-1200w.webp" srcset="/images/55-plus/del-webb-grande-dunes/del-webb-grande-dunes-homes-from-above-600w.webp 600w, /images/55-plus/del-webb-grande-dunes/del-webb-grande-dunes-homes-from-above-1200w.webp 1200w" sizes="(max-width: 699px) 100vw, 380px" width="1200" height="900" alt="Curving streets lined with single-family houses with gray roofs, small yards and driveways in Del Webb at Grande Dunes, seen from above, with the label Houses" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo. License: Public domain" title="License: Public domain">U.S. government aerial photo</a></span></div><figcaption>Houses, from above</figcaption></figure><figure><div class="c3ph-f"><img src="/images/55-plus/del-webb-grande-dunes/del-webb-grande-dunes-villas-from-above-1200w.webp" srcset="/images/55-plus/del-webb-grande-dunes/del-webb-grande-dunes-villas-from-above-600w.webp 600w, /images/55-plus/del-webb-grande-dunes/del-webb-grande-dunes-villas-from-above-1200w.webp 1200w" sizes="(max-width: 699px) 100vw, 380px" width="1200" height="900" alt="Streets of villas in Del Webb at Grande Dunes, each building two homes joined by a shared wall, seen from above, with the label Villas" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo. License: Public domain" title="License: Public domain">U.S. government aerial photo</a></span></div><figcaption>Villas, from above: each building is two homes</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For some villas, the HOA takes care of the roofs, gutters and outside paint. Those villa owners pay a little more for it.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Get the list of Del Webb at Grande Dunes homes for sale.</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us what you are looking for. One of our agents sends you the houses and villas for sale now, and finds out what the HOA takes care of on the one you like.</p><a class="btn btn-brass" href="/contact/">Get the list</a></div></div></section><section style="background:var(--ivory-2)" id="who-can-live-in-del-webb-at-grande-dunes"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Who can live here">Who can live in Del Webb at Grande Dunes?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">At least one person living in each home must be 55 or older, under <a href="https://www.delwebbatgrandedunes.com/ResourceCenter/Download/48372~3083079" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">the neighborhood's rules</a>. Everyone else who lives there must be 19 or older.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If the resident who is 55 or older dies or moves out, the others in the home can stay.</p><ul role="list" style="list-style:none;margin:1.2rem 0 1.6rem;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(18rem,1fr));gap:.75rem;max-width:760px"><li style="background:var(--ivory);border-top:3px solid var(--brass);padding:.9rem .85rem 1rem;margin:0"><span style="display:flex;width:2.6rem;height:2.6rem;border-radius:50%;background:var(--ivory-2);color:var(--brass-ink);align-items:center;justify-content:center;margin-bottom:.6rem"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.5 20.5v-1a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v1M16 14.5h1a4 4 0 0 1 4 4v2"/><circle cx="8.5" cy="7" r="3.2"/><circle cx="17" cy="8.8" r="2.5"/></svg></span><strong style="display:block;color:var(--navy);font-size:1rem;font-weight:500;line-height:1.3;margin-bottom:.25rem">Guests</strong><span style="display:block;color:var(--muted);font-size:.9rem;line-height:1.5">Each home gets two guest cards for the pools and the clubhouse.</span></li><li style="background:var(--ivory);border-top:3px solid var(--brass);padding:.9rem .85rem 1rem;margin:0"><span style="display:flex;width:2.6rem;height:2.6rem;border-radius:50%;background:var(--ivory-2);color:var(--brass-ink);align-items:center;justify-content:center;margin-bottom:.6rem"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 13c-2.5 0-5 2.6-5 5 0 1.6 1.2 2.5 2.6 2.5.9 0 1.6-.5 2.4-.5s1.5.5 2.4.5c1.4 0 2.6-.9 2.6-2.5 0-2.4-2.5-5-5-5z"/><circle cx="5.3" cy="11" r="1.8"/><circle cx="9" cy="6.3" r="1.8"/><circle cx="15" cy="6.3" r="1.8"/><circle cx="18.7" cy="11" r="1.8"/></svg></span><strong style="display:block;color:var(--navy);font-size:1rem;font-weight:500;line-height:1.3;margin-bottom:.25rem">Pets</strong><span style="display:block;color:var(--muted);font-size:.9rem;line-height:1.5">Cats and dogs are allowed.</span></li><li style="background:var(--ivory);border-top:3px solid var(--brass);padding:.9rem .85rem 1rem;margin:0"><span style="display:flex;width:2.6rem;height:2.6rem;border-radius:50%;background:var(--ivory-2);color:var(--brass-ink);align-items:center;justify-content:center;margin-bottom:.6rem"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><strong style="display:block;color:var(--navy);font-size:1rem;font-weight:500;line-height:1.3;margin-bottom:.25rem">Renting it out</strong><span style="display:block;color:var(--muted);font-size:.9rem;line-height:1.5">Yes. A lease must be at least 12 months, and you can sign only one a year. A tenant can use the pools and clubhouse only if someone 55 or older lives in the home.</span></li><li style="background:var(--ivory);border-top:3px solid var(--brass);padding:.9rem .85rem 1rem;margin:0"><span style="display:flex;width:2.6rem;height:2.6rem;border-radius:50%;background:var(--ivory-2);color:var(--brass-ink);align-items:center;justify-content:center;margin-bottom:.6rem"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 4h12M6 4v8M14 4v8M5 17.5H3V12h12l3-4h1.5L21 13v4.5h-2M9 17.5h6"/><circle cx="7" cy="17.5" r="2"/><circle cx="17" cy="17.5" r="2"/></svg></span><strong style="display:block;color:var(--navy);font-size:1rem;font-weight:500;line-height:1.3;margin-bottom:.25rem">Golf carts</strong><span style="display:block;color:var(--muted);font-size:.9rem;line-height:1.5">On the streets with a licensed driver, never on the sidewalks.</span></li></ul></div></section><section style="background:var(--ivory)" id="what-does-it-cost-to-live-in-del-webb-at-grande-dunes"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Costs">What does it cost to live in Del Webb at Grande Dunes?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A house in Del Webb at Grande Dunes usually sells for about $665,000, and a villa for about $430,000. The HOA fee is about $400 a month for a house and about $445 for a villa.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Your HOA fee includes basic lawn care and the beach club.</p><div style="overflow-x:auto;margin:1.2rem 0;max-width:760px"><table style="width:100%;border-collapse:collapse;font-size:.92rem"><thead><tr><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Other costs</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">About</th></tr></thead><tbody><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">One-time fee to the HOA when you buy</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">About one year of HOA fees</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Property tax on a house you live in, city tax included</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">About $2,700 a year</td></tr><tr><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Property tax on a villa you live in, city tax included</td><td style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">About $1,700 a year</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">See <a href="/buyers/property-taxes/" style="color:var(--navy);text-decoration:underline">how Horry County taxes a main home and a second home</a>.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You probably will not need flood insurance, because the homes are outside the high-risk flood zone. If you want it, a policy here usually costs about $550 a year.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Get an insurance quote on the home you pick.</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us the exact house or villa. One of our agents helps you get an <a href="/buyers/coastal-insurance/" style="color:var(--navy);text-decoration:underline">insurance</a> quote on it before you write the offer.</p><a class="btn btn-brass" href="/contact/">Get a quote</a></div></div></section><section style="background:var(--ivory-2)" id="how-does-del-webb-at-grande-dunes-compare-with-other-55"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Compare">How does Del Webb at Grande Dunes compare with other 55+ neighborhoods?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Del Webb at Grande Dunes is the only one of these four 55+ neighborhoods with a beach club in the dues.</p><style>.c3-cmp tr.c3-self td{background:#fff;font-weight:600;color:var(--navy)!important}@media (max-width:599px){.c3-cmp tr.c3-self{background:#fff;border:2px solid var(--brass)}.c3-cmp tr.c3-self td{background:transparent}}@media (max-width:599px){.c3-cmp table,.c3-cmp tbody,.c3-cmp tr,.c3-cmp td{display:block;width:100%}.c3-cmp thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}.c3-cmp tr{background:var(--ivory-2);border-top:3px solid var(--brass);margin:0 0 .75rem;padding:.4rem 0}.c3-cmp td{border:0!important;padding:.25rem .9rem!important}.c3-cmp td:first-child{color:var(--navy)!important;font-weight:500;font-size:1rem}.c3-cmp td[data-label]:not(:first-child)::before{content:attr(data-label) ": ";color:var(--navy)}.c3-cmp td a{padding:11px 0}}</style><div class="c3-cmp" style="overflow-x:auto;margin:1.2rem 0;max-width:760px"><table style="width:100%;border-collapse:collapse;font-size:.92rem"><thead><tr><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Community</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Area</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Minutes to the beach by car</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">HOA fee a month</th><th style="padding:.55rem .8rem;border-bottom:2px solid var(--navy);color:var(--navy);text-align:left;font-family:var(--sans);font-size:.8rem;letter-spacing:.04em;text-transform:uppercase">Resale homes usually sell for</th></tr></thead><tbody><tr><td data-label="Community" style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><a href="/buyers/55-plus-communities/del-webb-north-myrtle-beach/" style="color:var(--navy);text-decoration:underline">Del Webb North Myrtle Beach</a></td><td data-label="Area" style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">North Myrtle Beach</td><td data-label="Minutes to the beach by car" style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">About 4</td><td data-label="HOA fee a month" style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">About $315</td><td data-label="Resale homes usually sell for" style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">About $535,000</td></tr><tr class="c3-self"><td data-label="Community" style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><strong style="color:var(--navy);font-weight:700">Del Webb at Grande Dunes</strong></td><td data-label="Area" style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Myrtle Beach</td><td data-label="Minutes to the beach by car" style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">About 4</td><td data-label="HOA fee a month" style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">About $400 for a house</td><td data-label="Resale homes usually sell for" style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">About $665,000 for a house</td></tr><tr><td data-label="Community" style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><a href="/buyers/55-plus-communities/myrtle-trace/" style="color:var(--navy);text-decoration:underline">Myrtle Trace</a></td><td data-label="Area" style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Conway</td><td data-label="Minutes to the beach by car" style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">About 15</td><td data-label="HOA fee a month" style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">$95</td><td data-label="Resale homes usually sell for" style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">About $300,000</td></tr><tr><td data-label="Community" style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)"><a href="/buyers/55-plus-communities/seasons-at-prince-creek-west/" style="color:var(--navy);text-decoration:underline">Seasons at Prince Creek West</a></td><td data-label="Area" style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">Murrells Inlet</td><td data-label="Minutes to the beach by car" style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">About 13</td><td data-label="HOA fee a month" style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">About $340</td><td data-label="Resale homes usually sell for" style="padding:.55rem .8rem;border-bottom:1px solid var(--rule);color:var(--muted)">About $500,000</td></tr></tbody></table></div></div></section><section style="background:var(--ivory)" id="what-are-the-pros-and-cons-of-living-in-del-webb-at-grande"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Pros and cons">What are the pros and cons of living in Del Webb at Grande Dunes?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Del Webb at Grande Dunes is close to the beach, a grocery store and a hospital, and owners there follow rules on leases, fences and sheds.</p><style>.c3-pc{display:grid;gap:1rem;max-width:960px;margin:1.2rem 0 1.6rem}@media (min-width:760px){.c3-pc{grid-template-columns:1fr 1fr;align-items:start}}.c3-pc>div{padding:1.1rem 1.2rem .6rem}.c3-pc h3{font-family:var(--sans);font-size:1.15rem;font-weight:600;color:var(--navy);margin:0 0 .8rem;display:flex;align-items:center;gap:.55rem}.c3-pc,.c3-pc ul{font-size:1em}.c3-pc ul{list-style:none;margin:0;padding:0}.c3-pc li{display:flex;gap:.7rem;align-items:flex-start;color:var(--muted);font-size:var(--read,1.0625rem);line-height:1.7;margin:0 0 .9rem}.c3-pc li svg{flex:none;margin-top:.3rem}.c3-pc .c3-pc-do{display:block;color:var(--navy);font-weight:500;margin-top:.2rem}</style><div class="c3-pc"><div style="background:var(--ivory-2);border-top:3px solid var(--brass)"><h3>Pros</h3><ul><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="11" fill="var(--brass)"/><path d="M6.2 11.4l3.1 3.1 6.5-6.7" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Groceries and the beach are about 4 minutes away by car. The hospital is about 6 minutes away.</span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="11" fill="var(--brass)"/><path d="M6.2 11.4l3.1 3.1 6.5-6.7" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Your HOA fee includes membership in the Grande Dunes Ocean Club, the beach club.</span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="11" fill="var(--brass)"/><path d="M6.2 11.4l3.1 3.1 6.5-6.7" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Owners can tie up a boat at the neighborhood's day dock during the day.</span></li></ul></div><div style="background:var(--ivory-2);border-top:3px solid var(--muted)"><h3>Cons</h3><ul><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="10" fill="none" stroke="var(--muted)" stroke-width="1.6"/><path d="M6.8 11h8.4" stroke="var(--muted)" stroke-width="2.2" stroke-linecap="round"/></svg><span>Leases must be at least a year long.</span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="10" fill="none" stroke="var(--muted)" stroke-width="1.6"/><path d="M6.8 11h8.4" stroke="var(--muted)" stroke-width="2.2" stroke-linecap="round"/></svg><span>Yard fences must be short black metal and approved first. Sheds and dog runs are not allowed. <span class="c3-pc-do">Ask an agent to read the rules with you before you make an offer.</span></span></li><li><svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="10" fill="none" stroke="var(--muted)" stroke-width="1.6"/><path d="M6.8 11h8.4" stroke="var(--muted)" stroke-width="2.2" stroke-linecap="round"/></svg><span>The Ocean Club is a short drive, about 8 minutes, not a walk.</span></li></ul></div></div></div></section><section style="background:var(--ivory-2)" id="how-long-can-grandchildren-stay-in-del-webb-at-grande-dunes"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Grandchildren's stays">How long can grandchildren stay in Del Webb at Grande Dunes?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Grandchildren and other guests younger than 19 can stay in Del Webb at Grande Dunes up to 90 nights in any 12 months.</p><div class="c3-story" style="background:var(--ivory);border-top:3px solid var(--brass);padding:1.5rem 1.5rem .7rem;margin:1.4rem 0 1.4rem;max-width:720px"><p style="color:var(--muted);line-height:1.75;max-width:640px;margin:0 0 .9rem"><strong>Example:</strong> Bill and Nancy are moving from Ohio, and they want their two grandsons to stay with them all summer and again at Christmas.</p><p style="color:var(--muted);line-height:1.75;max-width:640px;margin:0 0 .9rem">They like a villa in Del Webb at Grande Dunes. Before they make an offer, their Chapter3 agent reads the neighborhood's rules with them.</p><p style="color:var(--muted);line-height:1.75;max-width:640px;margin:0 0 .9rem">A grandchild can stay up to 90 nights a year. Their plan is about two weeks more than that. Bill and Nancy cut two weeks from the summer visit and make their offer.</p></div><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Tell us when your family plans to visit.</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">An agent counts the nights against the guest rule with you before you make an offer.</p><a class="btn btn-brass" href="/contact/">Talk to an agent</a></div></div></section><section style="background:var(--ivory)" id="del-webb-at-grande-dunes-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Del Webb at Grande Dunes FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How much is the HOA fee in Del Webb at Grande Dunes?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The HOA fee is about $400 a month for a house and about $445 a month for a villa.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is there golf at Grande Dunes?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, two 18-hole courses. The Grande Dunes Resort Club sells tee times online. The Grande Dunes Members Club is a private club for members and their guests, with its own membership apart from the Ocean Club.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is there pickleball in Del Webb at Grande Dunes?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. The neighborhood has its own courts for pickleball, tennis and bocce, beside the clubhouse, for owners to use.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What is a villa in Del Webb at Grande Dunes?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A villa is a home that shares one wall with another home. Villas usually sell for less than the houses here.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do you need flood insurance in Del Webb at Grande Dunes?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Probably not. The homes are outside the high-risk flood zone. If you want a policy, it usually costs about $550 a year.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.delwebbatgrandedunes.com/ResourceCenter/Download/48372~3083079" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">The neighborhood's recorded rules</a>, <a href="https://www.delwebbatgrandedunes.com/ResourceCenter/Download/48372~3083089" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">HOA rules</a>, <a href="https://grandedunescommunities.sites.townsq.io/2" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Grande Dunes Master Association</a>, <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County deed records</a>, <a href="https://msc.fema.gov/portal/search?AddressQuery=6201%20Marina%20Parkway%2C%20Myrtle%20Beach%2C%20SC%2029572" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FEMA flood map</a>, <a href="https://www.law.cornell.edu/uscode/text/42/4012a" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Federal flood insurance law</a>. This is not legal advice. The HOA fees and home sizes are from recent home listings. OpenStreetMap gave the drive times, without traffic. The flood cost is the typical FEMA policy price in ZIP code 29572.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">The clubhouse, its outdoor pool and the courts, from above. U.S. government aerial photo, 2023, by the USDA Farm Service Agency, <a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://imagery.nationalmap.gov/arcgis/rest/services/USGSNAIPImagery/ImageServer" target="_blank" rel="noopener noreferrer">The National Map (USGS)</a>. Chapter3 Realty drew the outline from Horry County GIS parcels, added the labels and adjusted the colors.</div><div role="listitem">Houses, from above. U.S. government aerial photo, 2023, by the USDA Farm Service Agency, <a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://imagery.nationalmap.gov/arcgis/rest/services/USGSNAIPImagery/ImageServer" target="_blank" rel="noopener noreferrer">The National Map (USGS)</a>. Chapter3 Realty cut a close view of one street from the aerial photo, added one label and adj