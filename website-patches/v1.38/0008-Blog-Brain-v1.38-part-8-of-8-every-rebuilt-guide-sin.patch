+
+/* ---- Row 1: homes for sale with an association fee (one pull; fractions, never counts). ---- */
+const withFee = (t) => LIST[t].all - LIST[t].no_fee;
+const ALL_N = ["condo", "townhouse", "house"].reduce((t, k) => t + LIST[k].all, 0);
