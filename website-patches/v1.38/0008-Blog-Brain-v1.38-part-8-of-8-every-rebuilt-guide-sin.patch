important;max-width:100%!important;flex-wrap:wrap;box-sizing:border-box}main#main .hx-fb-q textarea{min-width:0;flex:1 1 100%;width:100%}main#main .hx-fb-go{flex:1 1 100%}}@media (min-width:1000px) and (max-width:1100px){.header-ctas .hdr-phone{display:none!important}}main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2){padding:.9rem 0!important}main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2)>.wrap{display:block!important;text-align:center!important;background:linear-gradient(160deg,rgba(42,48,64,.95),rgba(28,32,40,.97))!important;border:1px solid rgba(255,255,255,.14)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.14),0 26px 60px -30px rgba(28,32,40,.6)!important;border-radius:28px!important;padding:2.2rem 1.6rem!important;margin-left:auto!important;margin-right:auto!important}@media (max-width:699px){main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2)>.wrap{padding:1.6rem 1.2rem 1.7rem!important;border-radius:24px!important}}</style><style>main#main .hx-strip:empty{display:none}main#main .hx-strip:not(:empty)+.hx-fallback{display:none}</style><style>.c3-glance{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(var(--n),minmax(0,1fr));gap:.75rem;max-width:760px}.c3-glance li{display:flex;align-items:center;gap:.55rem;margin:0;padding:.5rem .6rem;background:rgba(255,255,255,.55);border:1px solid var(--rule);border-radius:6px;line-height:1.25}.c3-glance .i{flex:0 0 auto;display:flex;width:2rem;height:2rem;border-radius:50%;background:var(--ivory-2);color:var(--brass-ink);align-items:center;justify-content:center}.c3-glance strong{display:block;color:var(--navy);font-size:.9rem;font-weight:500}.c3-glance span.t{display:block;color:var(--muted);font-size:1rem}@media (max-width:699px){.c3-glance{gap:.3rem}.c3-glance li{flex-direction:column;justify-content:flex-start;text-align:center;gap:.2rem;padding:.4rem .1rem}.c3-glance .i{width:1.6rem;height:1.6rem}.c3-glance strong{font-size:.875rem}.c3-glance span.t{font-size:1rem;line-height:1.2}}</style><ul role="list" class="c3-glance" style="--n:3"><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 5h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM3 10h18M8 3v4M16 3v4M8 14h.01M12 14h.01M16 14h.01M8 17.5h.01M12 17.5h.01"/></svg></span><span><strong>45 and 180 days</strong><span class="t">to name the next property, and to own it</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h8l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v4h4M9 17l6-6"/><circle cx="9.5" cy="11.5" r="1"/><circle cx="14.5" cy="16.5" r="1"/></svg></span><span><strong>5.21%</strong><span class="t">the state's hold-back rate on a 2026 sale</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span><strong>Form I-295</strong><span class="t">the state form with the exchange boxes</span></span></li></ul></div><p style="color:var(--muted);font-size:.9rem;margin-bottom:1rem">By <strong style="color:var(--navy);font-weight:600">Devin Day</strong>, Operations Officer &middot; Reviewed by <strong style="color:var(--navy);font-weight:600">Tim Nash</strong>, Broker-in-Charge &middot; <span style="white-space:nowrap">Updated November 12, 2026</span></p><p class="detail-sub">South Carolina follows the federal 1031 rules. A seller who lives in another state meets one state step at closing: the 5.21 percent hold-back and Form I-295.</p></div></div><section style="background:var(--ivory)"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">The short answer</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A 1031 exchange works in South Carolina under the federal rules. Name the replacement within 45 days of your sale, and own it within 180 days.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If your permanent home is in another state, the buyer must hold back part of the price for state income tax, unless the sale is exempt. Tick the exchange box on Form I-295 and use a qualified intermediary, a neutral company that holds the sale money. The hold-back then goes to the intermediary, and the state is paid nothing if you finish the exchange.</p></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><p style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Plan the exchange with us before you list.</p><a class="btn btn-brass btn-lg" href="/contact/">Plan my exchange</a></div></section><section style="background:var(--ivory);padding-top:2.5rem"><div class="wrap"><nav aria-label="On this page" style="margin-top:0;max-width:720px"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.3rem;font-weight:600">On this page</p><ul style="list-style:none;margin:0;padding:0"><li><a href="#south-carolina" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">South Carolina</a></li><li><a href="#withholding" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">The hold-back</a></li><li><a href="#example" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Example</a></li><li><a href="#deadlines" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">45 and 180 days</a></li><li><a href="#day-45-list" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">The day-45 list</a></li><li><a href="#what-to-buy" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">What to buy</a></li><li><a href="#vacation-condo" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Vacation condo</a></li><li><a href="#cash-kept" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Cash you keep</a></li><li><a href="#loan" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">The loan</a></li><li><a href="#reverse" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Reverse</a></li><li><a href="#1031-exchange-faq" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">1031 exchange FAQ</a></li></ul></nav></div></section><section style="background:var(--ivory-2)" id="south-carolina"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="South Carolina">Does a 1031 exchange work in South Carolina?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. South Carolina's income tax <a href="https://www.scstatehouse.gov/code/t12c006.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">uses the federal tax code</a>, including section 1031, the exchange rule. A seller from any state uses the same exchange here.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In a 1031 exchange, you sell one rental or investment property, buy another, and put off the tax on the profit. The tax comes due when you later sell without exchanging. A trade counts when it meets three rules:</p><ul class="ex-plain"><li><b>What qualifies</b>Real property held for business or investment, <a href="https://www.law.cornell.edu/uscode/text/26/1031" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">traded for like-kind real property</a> held the same way. Real property in the United States is generally like-kind to other US real property, improved or not. A rental condo for a rental house counts, and so does land for a duplex. A house bought mainly to resell, a flip, does not.</li><li><b>Who holds the money</b>You may not touch the money between the sale and the purchase. If it is credited to your account or set aside so you can draw on it, you have received it. A qualified intermediary, a neutral company, can hold it under a written agreement that limits your right to it. That is <a href="https://www.law.cornell.edu/cfr/text/26/1.1031(k)-1" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">one of the setups the IRS rules accept</a>, so the money does not count as yours.</li><li><b>Who cannot hold it</b>Your real estate agent, attorney, accountant or employee of the past two years cannot be your qualified intermediary. The exception is one whose only work was on 1031 exchanges or routine title, escrow or bank services. Close relatives cannot hold it either. Chapter3 is your agent, so a separate company you choose holds the money.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The forms call the property you sell the relinquished property, and the one you buy the replacement property. <a href="/invest/strategies/" style="color:var(--navy);text-decoration:underline">Our investment strategies guide</a> compares the exchange with the other ways investors buy here.</p></div></section><section style="background:var(--ivory)" id="withholding"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The hold-back">How does a 1031 exchange keep South Carolina's hold-back from going to the state?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">When the seller's permanent home is outside South Carolina, the buyer must <a href="https://www.scstatehouse.gov/code/t12c008.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">hold back part of the price</a> for South Carolina income tax, unless the sale is exempt. For a sale closed in 2026, the rate is <a href="https://dor.sc.gov/news/information-about-h-4216" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">5.21 percent</a>, the state's top individual rate for the year.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="https://dor.sc.gov/sites/dor/files/forms/I295.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Form I-295</a> is the seller's sworn statement to the buyer. If it states your gain, the buyer holds back 5.21 percent of the gain. Without it, the buyer holds back 5.21 percent of the price less your selling costs. A seller that is a corporation is withheld at 5 percent instead. The amount is never more than the cash due to you at closing.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Why an exchange changes the hold-back</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A tax-deferred exchange is not a "sale" for this rule. The Department of Revenue counts a 1031 exchange as exempt. <a href="https://dor.sc.gov/sites/dor/files/policies/RR09-13.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Its ruling</a> still requires the hold-back when the replacement has not been named at the time of the sale. For an exchange that is not on the same day, it gives two ways to handle it.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">The exchange boxes on Form I-295</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The form has three exchange boxes. Tick the one that fits your trade:</p><ul class="ex-plain"><li><b>A swap on the same day</b>You trade one property for the other at one closing and put off the whole gain. The buyer holds back only on gain the form says will be taxed.</li><li><b>An exchange where you keep some cash</b>Part of the gain will be taxed, and you enter that gain on the form.</li><li><b>An exchange through a qualified intermediary</b>You put off the gain using an intermediary and have followed the state's steps for it, in Revenue Ruling #09-13.</li></ul><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What happens when you tick the intermediary box</h3><ol class="ex-steps"><li><b>You sign Form I-295 before a notary</b>You give it to the buyer and keep a copy with your tax records. It is not sent to the state unless the state asks for it.</li><li><b>Form I-290 is filled in as if the sale were taxed</b>Form I-290 is the form that pays the hold-back to the state. It goes to your intermediary at closing, with the amount needed to pay the hold-back.</li><li><b>The buyer and the intermediary sign a contract</b>The intermediary files Form I-290 and pays the hold-back for the buyer if the exchange fails. The buyer remains liable for the payment.</li><li><b>If the exchange fails, the intermediary pays</b>It pays by the 15th of the month after the failure is clear. That is the day the exchange is given up or its time runs out, whichever comes first.</li><li><b>If you finish the exchange, the state is paid nothing</b>Form I-290 is never filed.</li></ol><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">There is a second way. You can pay the hold-back from other money, so the whole sale goes into the exchange. The buyer sends it to the state, and you ask for it back once the exchange is complete.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Money held back beyond your tax comes back by <a href="https://dor.sc.gov/sites/dor/files/forms/I290.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">an amended Form I-290</a> before your tax year ends. After that, it is a credit on your South Carolina return. <a href="/sell/capital-gains/" style="color:var(--navy);text-decoration:underline">Our capital gains guide</a> has the refund steps.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Before the buyer signs, we tell the closing attorney's office and your intermediary that the sale is an exchange. The form and the dates are then in place on closing day.</p></div></section><section style="background:var(--ivory-2)" id="example"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Example">What does South Carolina hold back when you exchange a $400,000 condo?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Example. An owner who lives in another state sells a Myrtle Beach rental condo for $400,000 in 2026. They bought it for $250,000, took $60,000 of depreciation and pay 6 percent to sell.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The price less selling costs is $376,000, and the gain is $186,000.</p><figure class="c3-gchart"><div role="table" aria-label="About what goes to South Carolina when an owner from another state sells a $400,000 condo"><span class="cap" aria-hidden="true">About what goes to South Carolina when an owner from another state sells a $400,000 condo</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">How you sell</span><span role="columnheader">Paid to South Carolina</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">No form: held back at closing</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">$19,600</span></span></div><div role="row"><span role="rowheader"><span class="n">Form I-295 stating your gain: held back at closing</span></span><span role="cell"><span class="b" style="--f:0.495" aria-hidden="true"></span><span class="v">$9,700</span></span></div><div role="row"><span role="rowheader"><span class="n">Exchange keeping $30,000 cash: sent later</span></span><span role="cell"><span class="b" style="--f:0.08" aria-hidden="true"></span><span class="v">$1,560</span></span></div><div role="row"><span role="rowheader"><span class="n">Full exchange, finished, through an intermediary</span></span><span role="cell"><span class="b" style="--f:0" aria-hidden="true"></span><span class="v">$0</span></span></div></div></div><figcaption>The example above, sold in 2026. Money held back beyond your state tax comes back to you.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Without an exchange, the state tax on this gain is about $5,400 at the top rate. The rest of a hold-back comes back once you file. To put off all of the tax, the next property costs $376,000 or more.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The depreciation you took is part of the gain. <a href="/invest/rental-depreciation/" style="color:var(--navy);text-decoration:underline">Our rental depreciation guide</a> explains how a sale taxes it back.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Selling a Grand Strand rental from another state?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We plan your Grand Strand closing around the exchange, with the form and the dates in place before the buyer signs.</p><a class="btn btn-brass" href="/contact/">Have us plan the closing</a></div></div></section><section style="background:var(--ivory)" id="deadlines"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="45 and 180 days">What are the 1031 exchange 45-day and 180-day rules?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Both deadlines <a href="https://www.irs.gov/instructions/i8824" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">count from the day your sale closes</a> and run at the same time, in calendar days.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Your tax return can come first. The exchange must be finished by <a href="https://www.law.cornell.edu/uscode/text/26/6072" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">the return's due date</a>, with extensions, if that is sooner. For a sale that closes after mid-October, day 180 falls after April 15, so an extension keeps all 180 days.</p><div class="ex-card ex-clock" role="group" aria-labelledby="xcT"><p class="k" id="xcT">Your 1031 dates</p><svg class="ex-n" viewBox="0 0 320 76" role="img" aria-label="The 180 days to scale: from day 0, when your sale closes, you have 45 days to name the replacement, then until day 180 to own it." font-family="DM Sans, system-ui, sans-serif"><text x="0" y="18" text-anchor="start" font-size="15" font-weight="700" fill="#1c2028">Day 0</text><text x="80" y="18" text-anchor="middle" font-size="15" font-weight="700" fill="#1c2028">Day 45</text><text x="320" y="18" text-anchor="end" font-size="15" font-weight="700" fill="#1c2028">Day 180</text><rect x="0" y="33" width="320" height="11" rx="6" fill="#c4783a" fill-opacity=".3"/><rect x="0" y="33" width="80" height="11" rx="6" fill="#c4783a"/><rect x="79" y="29" width="2" height="19" fill="#1c2028"/><text x="40" y="67" text-anchor="middle" font-size="15" fill="#1c2028">Name it</text><text x="200" y="67" text-anchor="middle" font-size="15" fill="#1c2028">Own it by day 180</text></svg><svg class="ex-w" viewBox="0 0 640 76" role="img" aria-label="The 180 days to scale: from day 0, when your sale closes, you have 45 days to name the replacement, then until day 180 to own it." font-family="DM Sans, system-ui, sans-serif"><text x="0" y="18" text-anchor="start" font-size="15" font-weight="700" fill="#1c2028">Day 0</text><text x="160" y="18" text-anchor="middle" font-size="15" font-weight="700" fill="#1c2028">Day 45</text><text x="640" y="18" text-anchor="end" font-size="15" font-weight="700" fill="#1c2028">Day 180</text><rect x="0" y="33" width="640" height="11" rx="6" fill="#c4783a" fill-opacity=".3"/><rect x="0" y="33" width="160" height="11" rx="6" fill="#c4783a"/><rect x="159" y="29" width="2" height="19" fill="#1c2028"/><text x="80" y="67" text-anchor="middle" font-size="15" fill="#1c2028">Name it</text><text x="400" y="67" text-anchor="middle" font-size="15" fill="#1c2028">Own it by day 180</text></svg><div class="ex-in"><label for="xcDay">The day your sale closes</label><input id="xcDay" type="date" oninput="xcGo()" onchange="xcGo()"></div><ol class="ex-line" aria-live="polite"><li class="d0"><span class="dn">Day 0</span><span class="dt" id="xod0">&nbsp;</span><span class="dw">Your sale closes. The money goes to your intermediary.</span></li><li class="d45"><span class="dn">Day 45</span><span class="dt" id="xod45">&nbsp;</span><span class="dw">Your signed list of possible replacements is due.</span></li><li class="d180"><span class="dn">Day 180</span><span class="dt" id="xod180">&nbsp;</span><span class="dw">You must own the new property.</span></li></ol><p class="ex-warn" id="xcWarn" hidden>Your tax return is due on April 15, before day 180. File an extension to keep the full 180 days.</p><p class="n">For a person who files a tax return for the calendar year.</p></div><script>function xClock(y,m,d){var t=Date.UTC(y,m-1,d),day=86400000,a=new Date(t+45*day),b=new Date(t+180*day),r=Date.UTC(y+1,3,15);return{d45:a,d180:b,late:b.getTime()>r}}function xcFmt(t){return t.toLocaleDateString("en-US",{weekday:"short",month:"long",day:"numeric",year:"numeric",timeZone:"UTC"})}function xcGo(){var i=document.getElementById("xcDay");if(!i||!i.value)return;var p=i.value.split("-").map(Number);if(p.length<3||!p[0])return;var c=xClock(p[0],p[1],p[2]),s=function(id,t){var e=document.getElementById(id);if(e)e.textContent=t};s("xod0",xcFmt(new Date(Date.UTC(p[0],p[1]-1,p[2]))));s("xod45",xcFmt(c.d45));s("xod180",xcFmt(c.d180));var w=document.getElementById("xcWarn");if(w)w.hidden=!c.late}document.addEventListener("DOMContentLoaded",function(){var i=document.getElementById("xcDay");if(!i)return;if(!i.value){var n=new Date();i.value=n.getFullYear()+"-"+String(n.getMonth()+1).padStart(2,"0")+"-"+String(n.getDate()).padStart(2,"0")}xcGo()})</script><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The IRS can postpone the 45 and 180 days <a href="https://www.irs.gov/irb/2018-50_IRB" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">after a federally declared disaster</a>, but never past the tax return's due date with extensions. After Hurricane Helene, <a href="https://www.irs.gov/newsroom/irs-announces-tax-relief-for-victims-of-hurricane-helene-in-south-carolina-various-deadlines-postponed-to-may-1-2025" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">that relief covered</a> every South Carolina county.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">The exchange, step by step, and what we do at each one</h3><ol class="ex-steps"><li><b>Before you list</b>Choose a qualified intermediary. We start the search for your Grand Strand replacement now, because the 45 days are the short part.</li><li><b>The sale closes</b>The money goes straight to your intermediary, and this day is day 0. We work the closing with the attorney's office so you never touch the money.</li><li><b>Days 1 to 45</b>Shop on the numbers. Our agents check each Grand Strand property's rent, cap rate and tenant history, not the finishes.</li><li><b>Day 45</b>Your signed list goes to your intermediary. We draft it with you and send it in time.</li><li><b>Day 180</b>You close on the new property, and the tax stays put off. Our agents, and the lending, insurance and legal partners we work with here, work to the same date.</li></ol></div></section><section style="background:var(--ivory-2)" id="day-45-list"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The day-45 list">How do you name replacement properties by day 45?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Write the list, sign it, and send it to your intermediary <a href="https://www.law.cornell.edu/cfr/text/26/1.1031(k)-1" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">before day 45 ends</a>. Telling your own agent, attorney or accountant does not count. Describe each property by its street address, legal description or a distinct name.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Choose one of three ways to write it:</p><ul class="ex-plain"><li><b>Up to three properties</b>Name up to three, at any price.</li><li><b>Any number, worth up to twice your sale</b>Name more than three if their total value is no more than twice what you sold.</li><li><b>Any number, if you buy nearly all of them</b>Name as many as you like if you buy at least 95 percent of the total value you named.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Name more than the rules allow, and the IRS treats the list as if you named nothing. You can change the list before day 45 with a new signed notice to the same person. A change by phone does not count.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Have us build your day-45 shortlist.</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the price range from your sale. We send back the strongest Grand Strand picks and a backup, with the rent and the cap rate for each.</p><a class="btn btn-brass" href="/contact/">Start my shortlist</a></div></div></section><section style="background:var(--ivory)" id="what-to-buy"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What to buy">What can a 1031 exchange buy on the Grand Strand?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Buyers whose tax bill goes to another state or country bought 54 percent of the condos sold in Horry County in the past year. 1031 buyers are one of the largest groups of investors we work with here. Many of our investor clients sell in expensive markets and buy here.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the example, the next property costs $376,000 or more. The table counts what is for sale at that price.</p><div class="ex-tw"><table class="ex-tab"><caption>Homes for sale in Horry County, our count on November 9, 2026. Asking prices are rounded.</caption><thead><tr><th scope="col">Kind of home</th><th scope="col">For sale</th><th scope="col">Middle asking price</th><th scope="col">Asking $376,000 or more</th></tr></thead><tbody><tr><th scope="row">Condos</th><td><span class="l">For sale</span>2,694</td><td><span class="l">Middle ask</span>$215,000</td><td><span class="l">Asking $376,000 or more</span>471</td></tr><tr><th scope="row">Houses</th><td><span class="l">For sale</span>2,929</td><td><span class="l">Middle ask</span>$420,000</td><td><span class="l">Asking $376,000 or more</span>1,720</td></tr><tr><th scope="row">Townhouses</th><td><span class="l">For sale</span>307</td><td><span class="l">Middle ask</span>$265,000</td><td><span class="l">Asking $376,000 or more</span>58</td></tr><tr><th scope="row">Buildings with 2 to 4 units</th><td><span class="l">For sale</span>51</td><td><span class="l">Middle ask</span>$680,000</td><td><span class="l">Asking $376,000 or more</span>44</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Far more houses than condos for sale ask that much.</p><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);letter-spacing:.01em;color:#fff;text-align:right;background:radial-gradient(farthest-side at 100% 100%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.c3ph-cr a{color:#fff;text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);text-underline-offset:2px;pointer-events:auto;padding:10px 0 6px}.c3ph-hero{margin:1.6rem 0 2rem}.c3ph-hero .c3ph-f{border-radius:8px}.c3ph-hero img{aspect-ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}</style><figure class="c3ph-hero" style="margin:1.3rem 0 1.5rem;max-width:720px;"><div class="c3ph-f"><img src="/images/2026-11-a/invest-where-to-buy/north-myrtle-beach-towers-and-houses-2011-1200w.webp" srcset="/images/2026-11-a/invest-where-to-buy/north-myrtle-beach-towers-and-houses-2011-600w.webp 600w, /images/2026-11-a/invest-where-to-buy/north-myrtle-beach-towers-and-houses-2011-1200w.webp 1200w" sizes="(max-width: 760px) 100vw, 720px" width="1200" height="675" alt="Two condo towers, a low condo building and raised beach houses side by side behind the dunes in North Myrtle Beach, seen from over the ocean" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="USGS photo, 2011. License: Public domain" title="License: Public domain">USGS photo, 2011</a></span></div><figcaption>Condo towers and beach houses on the same oceanfront block in North Myrtle Beach.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Buildings with 2 to 4 units are scarce: 51 for sale, and half ask more than $680,000.</p><div class="hx-strip" data-place="duplexes-around-myrtle-beach" data-name="the Myrtle Beach area" data-head="Duplexes, triplexes and fourplexes for sale around Myrtle Beach"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Condos sold for about $215,000 at the middle in the past year, the same as the middle asking price now. Houses and other homes that are not condos sold for about $350,000. Under the three-property rule, you can split one sale into two or three condos.</p><div class="hx-strip" data-place="condos-around-myrtle-beach" data-name="the Myrtle Beach area" data-head="Condos for sale around Myrtle Beach"></div><div class="hx-fallback"><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Want the homes for sale at your exchange price?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us what your sale brings. We send the condos, houses and 2 to 4 unit buildings for sale at that price, with the numbers on each.</p><a class="btn btn-brass" href="/contact/">Send me homes at my price</a></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="/invest/condos/" style="color:var(--navy);text-decoration:underline">Our guide to condos as rentals</a> and <a href="/invest/strategies/small-multifamily/" style="color:var(--navy);text-decoration:underline">our guide to 2 to 4 unit buildings</a> compare the two. <a href="/invest/rental-returns/" style="color:var(--navy);text-decoration:underline">Rental returns by area</a> gives the cap rates, and <a href="/invest/long-term-rental/" style="color:var(--navy);text-decoration:underline">the rental analyzer</a> runs the numbers on one address.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How one investor trades up</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">One of Tim Nash's longtime clients, an investor based in New York, owns more than 200 properties, mostly condos. The IRS lets an owner deduct the cost of a residential rental building over 27.5 years, called depreciation. When a condo has used up that deduction, he sells it and trades up through a 1031 exchange.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="/invest/how-long-to-hold/" style="color:var(--navy);text-decoration:underline">How long to hold a rental before selling</a> has the costs a sale must cover first. <a href="/invest/cost-segregation/" style="color:var(--navy);text-decoration:underline">Our cost segregation guide</a> shows how a study changes the depreciation on the new property.</p></div></section><section style="background:var(--ivory-2)" id="vacation-condo"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Vacation condo">Can you 1031 exchange a vacation condo you also use?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, if you rent it out enough. <a href="https://www.irs.gov/irb/2008-10_IRB" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">The IRS will not challenge</a> the exchange of a beach condo you rent out and also use if it passes this test:</p><ul class="ex-plain"><li><b>Owned 24 months</b>You owned the condo for at least 24 months before the exchange.</li><li><b>Rented each year</b>In each of those two years, you rented it at a fair rent for 14 days or more.</li><li><b>Little personal use</b>Personal use was no more than 14 days or 10 percent of the rented days, whichever is more. Days your family uses it, or anyone pays less than a fair rent, count as personal use.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The condo you buy passes the same test for the 24 months after you buy it. The test is not the only way in. A condo that misses it may still qualify.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A home used only as your own home does not qualify. A former main home may get the separate home-sale exclusion if you lived in it two of the last five years. <a href="/sell/capital-gains/" style="color:var(--navy);text-decoration:underline">The capital gains guide</a> covers that exclusion.</p></div></section><section style="background:var(--ivory)" id="cash-kept"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Cash you keep">What happens if you keep some of the cash?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Cash you keep from the exchange, often called boot, <a href="https://www.irs.gov/businesses/small-businesses-self-employed/like-kind-exchanges-real-estate-tax-tips" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">is taxed</a>, up to the amount of your gain. If the new loan is smaller than the one you paid off, the difference counts as cash you kept.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">South Carolina's share comes from that part only. Your intermediary sends the state a modified Form I-290 for the money that was not put into the new property.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the example, buy a $346,000 property and keep $30,000. The intermediary sends the state about $1,560. The state tax on that $30,000 is about $880 at the top rate, and the rest comes back when you file.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Federal tax is due on the cash too. <a href="/sell/capital-gains/" style="color:var(--navy);text-decoration:underline">Our capital gains calculator</a> has the federal rates.</p></div></section><section style="background:var(--ivory-2)" id="loan"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The loan">How do you finance the replacement inside 180 days?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The loan for the new property must close inside the same 180 days. The lender starts during the search, so the purchase and the loan move together.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Use your own lender, or our affiliated lender, BrickWood Mortgage, a separate company. Many exchange buyers use <a href="/invest/strategies/dscr-loans/" style="color:var(--navy);text-decoration:underline">a DSCR loan</a>, which qualifies on the property's rent.</p></div></section><section style="background:var(--ivory)" id="reverse"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Reverse">How does a reverse 1031 exchange work in South Carolina?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In a reverse exchange you buy first. <a href="https://www.irs.gov/irb/2000-40_IRB" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Another party</a> that is not you or your agent, called an exchange accommodation titleholder, takes title to the new property first.</p><ol class="ex-steps"><li><b>The titleholder takes title</b>It holds the new property for you until the exchange is finished.</li><li><b>You sign an agreement with it</b>You and the titleholder sign a written agreement within 5 business days after it takes title.</li><li><b>You name the property you will sell</b>Do it within 45 days after the titleholder takes title.</li><li><b>You finish the exchange</b>Sell the old property and finish within 180 days after the titleholder takes title.</li></ol><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A reverse exchange fits when the right property comes up before your sale is ready. For the tax put off with no property to manage, <a href="/invest/strategies/dst/" style="color:var(--navy);text-decoration:underline">a Delaware statutory trust share</a> is the other choice.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Found the next property before your sale?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us about both properties. We plan the purchase and the sale with your intermediary around the 45 and 180 days.</p><a class="btn btn-brass" href="/contact/">Ask about a reverse exchange</a></div></div></section><section style="background:var(--ivory-2)" id="1031-exchange-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">1031 exchange FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does a 1031 exchange have to be in the same state?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. The rules are federal. Real property in the United States is generally like-kind to other US real property if both are held for business or investment. A rental in another state can be traded for one here.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I 1031 exchange into a home I will live in?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not one you only live in. A beach condo you rent out and also use can qualify when it passes the IRS rental test described on this page.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I do a 1031 exchange with a family member, such as a parent or a child?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, with a limit. It covers a spouse, parent, grandparent, child, grandchild, brother or sister, and a company you control. If either of you sells the property you got within two years, the deferred gain is taxed. There are a few exceptions, such as a death.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does South Carolina tax the gain later?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. The state follows the federal rules, so the gain you put off is taxed when you sell without exchanging. South Carolina deducts 44 percent of a net capital gain and taxes the rest.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is a company that sells a condo held back too?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. For a corporation the rate is 5 percent. A business seller can be treated as a resident on Form I-295 if it meets four tests. It has done business in South Carolina for the last two tax years and will keep doing it. It is registered here and has filed a South Carolina return with none overdue.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I exchange into a DST?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. A share of a Delaware statutory trust can be the replacement if the trust stays inside the IRS ruling's limits and the other 1031 rules are met.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Who reports a 1031 exchange to the IRS?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You do, on IRS Form 8824 with your tax return for the year of the exchange.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.scstatehouse.gov/code/t12c008.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-8-580</a>, <a href="https://www.scstatehouse.gov/code/t12c006.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">12-6</a>, <a href="https://dor.sc.gov/news/information-about-h-4216" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SCDOR</a>, <a href="https://dor.sc.gov/sites/dor/files/forms/I295.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Form I-295</a>, <a href="https://dor.sc.gov/sites/dor/files/forms/I290.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Form I-290</a>, <a href="https://dor.sc.gov/sites/dor/files/policies/RR09-13.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">RR 09-13</a>, <a href="https://www.law.cornell.edu/uscode/text/26/1031" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">26 USC 1031</a>, <a href="https://www.law.cornell.edu/uscode/text/26/6072" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">26 USC 6072</a>, <a href="https://www.law.cornell.edu/cfr/text/26/1.1031(k)-1" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">26 CFR 1.1031(k)-1</a>, <a href="https://www.irs.gov/businesses/small-businesses-self-employed/like-kind-exchanges-real-estate-tax-tips" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">IRS</a>, <a href="https://www.irs.gov/instructions/i8824" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Form 8824</a>, <a href="https://www.irs.gov/irb/2008-10_IRB" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Rev. Proc. 2008-16</a>, <a href="https://www.irs.gov/irb/2018-50_IRB" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Rev. Proc. 2018-58</a>, <a href="https://www.irs.gov/irb/2000-40_IRB" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Rev. Proc. 2000-37</a>, <a href="https://www.irs.gov/irb/2004-33_IRB" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Rev. Rul. 2004-86</a>, <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeDocType" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">County deeds</a>. Sales: our count of county deeds. Homes for sale: our count of the listing feed on November 9, 2026, in total only. The example is constructed.</p><style>.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Condo towers and beach houses in North Myrtle Beach. Photo: U.S. Geological Survey, <a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://doi.org/10.5066/F7N877XX" target="_blank" rel="noopener noreferrer">U.S. Geological Survey</a>.</div><div role="listitem">Chapter3 Realty resized these photos and cropped some of them.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-11-a/invest-where-to-buy/north-myrtle-beach-towers-and-houses-2011-1200w.webp","url":"https://chapter3realty.com/images/2026-11-a/invest-where-to-buy/north-myrtle-beach-towers-and-houses-2011-1200w.webp","width":1200,"height":675,"encodingFormat":"image/webp","name":"Condo towers and beach houses on the same oceanfront block in North Myrtle Beach","caption":"Condo towers and beach houses on the same oceanfront block in North Myrtle Beach.","description":"Two condo towers, a low condo building and raised beach houses side by side behind the dunes in North Myrtle Beach, seen from over the ocean","creator":{"@type":"Organization","name":"U.S. Geological Survey"},"creditText":"U.S","copyrightNotice":"Public domain (U.S. Geological Survey)","license":"https://www.usa.gov/publicdomain/label/1.0/","acquireLicensePage":"https://doi.org/10.5066/F7N877XX","isBasedOn":"https://doi.org/10.5066/F7N877XX","contentLocation":{"@type":"Place","name":"Oceanfront in the City of North Myrtle Beach (Horry County tax district 550), North Myrtle Beach, South Carolina"},"representativeOfPage":true}]}</script><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1rem"><strong style="color:var(--navy)">Legal notice.</strong> Chapter3 Realty Corp is a licensed South Carolina real estate brokerage. We are not attorneys or tax advisers, and nothing on this page is legal or tax advice. Your qualified intermediary and your tax adviser confirm the exchange.</p></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bot