,40,.97))!important;border:1px solid rgba(255,255,255,.14)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.14),0 26px 60px -30px rgba(28,32,40,.6)!important;border-radius:28px!important;padding:2.2rem 1.6rem!important;margin-left:auto!important;margin-right:auto!important}@media (max-width:699px){main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2)>.wrap{padding:1.6rem 1.2rem 1.7rem!important;border-radius:24px!important}}</style><style>main#main .hx-strip:empty{display:none}main#main .hx-strip:not(:empty)+.hx-fallback{display:none}</style><style>.c3-glance{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(var(--n),minmax(0,1fr));gap:.75rem;max-width:760px}.c3-glance li{display:flex;align-items:center;gap:.55rem;margin:0;padding:.5rem .6rem;background:rgba(255,255,255,.55);border:1px solid var(--rule);border-radius:6px;line-height:1.25}.c3-glance .i{flex:0 0 auto;display:flex;width:2rem;height:2rem;border-radius:50%;background:var(--ivory-2);color:var(--brass-ink);align-items:center;justify-content:center}.c3-glance strong{display:block;color:var(--navy);font-size:.9rem;font-weight:500}.c3-glance span.t{display:block;color:var(--muted);font-size:1rem}@media (max-width:699px){.c3-glance{gap:.3rem}.c3-glance li{flex-direction:column;justify-content:flex-start;text-align:center;gap:.2rem;padding:.4rem .1rem}.c3-glance .i{width:1.6rem;height:1.6rem}.c3-glance strong{font-size:.875rem}.c3-glance span.t{font-size:1rem;line-height:1.2}}</style><ul role="list" class="c3-glance" style="--n:3"><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span><span><strong>46 to 49%</strong><span class="t">of the rent left for the loan on an inland house</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 9.4c-.4-1-1.5-1.8-3-1.8-1.8 0-3 1-3 2.2 0 3 6 1.6 6 4.4 0 1.3-1.3 2.2-3 2.2-1.6 0-2.7-.7-3.1-1.8M12 5.8v1.8M12 16.4v1.8"/><circle cx="12" cy="12" r="9"/></svg></span><span><strong>75 to 80%</strong><span class="t">of nightly income that lenders count</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span><strong>1.25</strong><span class="t">the ratio we aim for</span></span></li></ul></div><p style="color:var(--muted);font-size:.9rem;margin-bottom:1rem">By <strong style="color:var(--navy);font-weight:600">Devin Day</strong>, Operations Officer &middot; Reviewed by <strong style="color:var(--navy);font-weight:600">Tim Nash</strong>, Broker-in-Charge &middot; <span style="white-space:nowrap">Updated November 12, 2026</span></p><p class="detail-sub">The 6 percent rental tax and the HOA fee sit inside a DSCR loan's ratio. Houses inland often pass, while a beach condo's dues can use the rent first.</p></div></div><section style="background:var(--ivory)"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">The short answer</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A DSCR loan qualifies on the rent. The lender divides the rent it counts by the monthly bill: principal and interest, property tax, insurance and HOA dues. The three program sheets we read ask for a ratio of 1.00 or more.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On the Grand Strand, the middle 3-bedroom house in Longs or Carolina Forest leaves 46 to 49 percent of the rent for the loan at our 1.25 target. On the middle oceanfront two-bedroom in Myrtle Beach rented by the night, the dues, tax and insurance alone come to more than the income a lender counts.</p></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><p style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Send us a listing. We work out its ratio before you offer.</p><a class="btn btn-brass btn-lg" href="/contact/">Have us check a listing's ratio</a></div></section><section style="background:var(--ivory);padding-top:2.5rem"><div class="wrap"><nav aria-label="On this page" style="margin-top:0;max-width:720px"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.3rem;font-weight:600">On this page</p><ul style="list-style:none;margin:0;padding:0"><li><a href="#what-is-dscr" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">DSCR in SC</a></li><li><a href="#formula" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">The formula</a></li><li><a href="#good-ratio" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">A good ratio</a></li><li><a href="#which-pass" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Which rentals pass</a></li><li><a href="#airbnb-income" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Airbnb income</a></li><li><a href="#condotels" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Condotels</a></li><li><a href="#what-to-bring" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">What to bring</a></li><li><a href="#who-qualifies" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Who qualifies</a></li><li><a href="#how-we-help" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">How we help</a></li><li><a href="#dscr-loan-faq" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">DSCR loan FAQ</a></li></ul></nav></div></section><section style="background:var(--ivory-2)" id="what-is-dscr"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="DSCR in SC">What is a DSCR loan, and does it work in South Carolina?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">DSCR is short for debt service coverage ratio. It is the rent a home collects, divided by the monthly bill it must cover. The lender qualifies the loan on the rent, not on your income. You sign that the home is for business and that you will not live in it.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">DSCR loans work on South Carolina rentals, and the formula does not change at the state line. The local numbers do. A rental here is taxed on 6 percent of its value, condo dues can be high, and towns and HOAs set their own rules on nightly rentals. Each of those sits inside the ratio.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The rent the lender counts is the appraiser's. The appraiser fills in a rent schedule with the appraisal, and with a lease in place the lender may use the lease, within limits. HUD's rents on this page are a guide; the appraiser's figure is the one that counts.</p></div></section><section style="background:var(--ivory)" id="formula"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The formula">How do you calculate DSCR on a Grand Strand rental?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Add up the monthly bill, then divide the rent by it. <a href="https://selling-guide.fanniemae.com/sel/b3-6-03/monthly-housing-expense-subject-property" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">The bill lenders divide by</a> holds principal and interest, the property tax, the insurance and the HOA dues.</p><div class="dl-card" role="group" aria-label="The DSCR formula and a worked example"><p class="k">The formula</p><p class="dl-f"><b>DSCR</b> = the monthly rent the lender counts, divided by the monthly bill: principal and interest, property tax, insurance and HOA dues.</p><div class="dl-tw"><table class="dl-ex"><caption>Worked example: the middle 3-bedroom house for sale in Carolina Forest, asking about $390,000</caption><thead><tr><th scope="col">In the ratio</th><th scope="col">A month</th><th scope="col">Where it comes from</th></tr></thead><tbody><tr><th scope="row">Rent the lender counts</th><td class="a">$2,230</td><td class="w">HUD's fair market rent for a 3-bedroom in the ZIP code. Your lender uses the appraiser's figure.</td></tr><tr><th scope="row">Property tax</th><td class="a">about $392</td><td class="w">A rental is taxed on 6 percent of its value, at the 2026 county rate for most homes outside city limits</td></tr><tr><th scope="row">Insurance</th><td class="a">about $275</td><td class="w">A landlord policy, one agency's estimate. We get a quote for the address.</td></tr><tr><th scope="row">HOA dues</th><td class="a">$100</td><td class="w">The middle house's HOA fee</td></tr><tr><th scope="row">Principal and interest</th><td class="a">Lender's quote</td><td class="w"></td></tr></tbody></table></div><p class="dl-res">The tax, insurance and HOA use about <b>34 percent</b> of the rent. At a ratio of 1.25, principal and interest must fit in the <b>46 percent</b> that is left.</p></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The HOA fee counts against the rent, and a special assessment can count too; ask your lender. Flood insurance counts where a home needs it. <a href="/invest/long-term-rental/" style="color:var(--navy);text-decoration:underline">Our rental analyzer</a> runs the same numbers on any address.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Have us fill in the bill for an address.</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us an address. We fill in the tax, an insurance quote and the dues, and you add your lender's quote.</p><a class="btn btn-brass" href="/contact/">Have us fill in the numbers</a></div></div></section><section style="background:var(--ivory-2)" id="good-ratio"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="A good ratio">What is a good DSCR for a rental, and what if it is below 1.00?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A ratio of 1.00 means the rent just covers the bill. Our target is 1.25.</p><figure class="dl-card dl-scalecard"><p class="k">What the ratio means</p><svg class="dl-n" viewBox="0 0 280 70" role="img" aria-label="A line of DSCR ratios from 0.7 to 1.3. Below 1.00 the rent falls short of the bill. Marked: 0.75, our affiliated lender's floor; 1.00, where the rent just covers the bill; 1.15, asked by some programs for a nightly rental; 1.25, our target."><rect x="24.0" y="29" width="116.0" height="11" fill="rgba(155,44,44,.22)"/><rect x="140.0" y="29" width="96.7" height="11" fill="rgba(92,107,120,.25)"/><rect x="236.7" y="29" width="19.3" height="11" fill="rgba(196,120,58,.45)"/><line x1="43.3" x2="43.3" y1="25" y2="44" stroke="#1c2028" stroke-width="2"/><text x="43.3" y="21" text-anchor="middle" font-size="15" font-weight="700" fill="#1c2028">0.75</text><line x1="140.0" x2="140.0" y1="25" y2="44" stroke="#1c2028" stroke-width="2"/><text x="140.0" y="21" text-anchor="middle" font-size="15" font-weight="700" fill="#1c2028">1.00</text><line x1="198.0" x2="198.0" y1="25" y2="44" stroke="#1c2028" stroke-width="2"/><text x="198.0" y="21" text-anchor="middle" font-size="15" font-weight="700" fill="#1c2028">1.15</text><line x1="236.7" x2="236.7" y1="25" y2="44" stroke="#1c2028" stroke-width="2"/><text x="236.7" y="21" text-anchor="middle" font-size="15" font-weight="700" fill="#8a5226">1.25</text><text x="24" y="65" font-size="15" fill="#4a4f5c">Rent falls short</text><text x="256" y="65" text-anchor="end" font-size="15" fill="#4a4f5c">More cushion</text></svg><svg class="dl-w" viewBox="0 0 640 70" role="img" aria-label="A line of DSCR ratios from 0.6 to 1.4. Below 1.00 the rent falls short of the bill. Marked: 0.75, our affiliated lender's floor; 1.00, where the rent just covers the bill; 1.15, asked by some programs for a nightly rental; 1.25, our target."><rect x="24.0" y="29" width="296.0" height="11" fill="rgba(155,44,44,.22)"/><rect x="320.0" y="29" width="185.0" height="11" fill="rgba(92,107,120,.25)"/><rect x="505.0" y="29" width="111.0" height="11" fill="rgba(196,120,58,.45)"/><line x1="135.0" x2="135.0" y1="25" y2="44" stroke="#1c2028" stroke-width="2"/><text x="135.0" y="21" text-anchor="middle" font-size="15" font-weight="700" fill="#1c2028">0.75</text><line x1="320.0" x2="320.0" y1="25" y2="44" stroke="#1c2028" stroke-width="2"/><text x="320.0" y="21" text-anchor="middle" font-size="15" font-weight="700" fill="#1c2028">1.00</text><line x1="431.0" x2="431.0" y1="25" y2="44" stroke="#1c2028" stroke-width="2"/><text x="431.0" y="21" text-anchor="middle" font-size="15" font-weight="700" fill="#1c2028">1.15</text><line x1="505.0" x2="505.0" y1="25" y2="44" stroke="#1c2028" stroke-width="2"/><text x="505.0" y="21" text-anchor="middle" font-size="15" font-weight="700" fill="#8a5226">1.25</text><text x="24" y="65" font-size="15" fill="#4a4f5c">Rent falls short</text><text x="616" y="65" text-anchor="end" font-size="15" fill="#4a4f5c">More cushion</text></svg><ol class="dl-scale"><li><span class="n">0.75</span><span class="t"><b>Our affiliated lender's floor</b>BrickWood Mortgage, a separate company, starts writing DSCR loans at this ratio.</span></li><li><span class="n">1.00</span><span class="t"><b>The rent just covers the bill</b>The three program sheets we read ask for a ratio of 1.00 or more.</span></li><li><span class="n">1.15</span><span class="t"><b>A nightly rental, at some programs</b>Some ask 1.15 for a nightly rental, or 1.25 on a small loan.</span></li><li class="us"><span class="n">1.25</span><span class="t"><b>Our target</b>A fifth of the rent is left after the whole bill.</span></li></ol></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Below 1.00, the rent does not cover the bill, and you pay the rest each month. At 1.25, the cushion is there for an empty month or a repair.</p></div></section><section style="background:var(--ivory)" id="which-pass"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Which rentals pass">Which Grand Strand rentals pass a DSCR loan?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We worked out the bill on six kinds of home for sale here, at the middle asking price of each. The chart shows how much of the rent the tax, the insurance and the HOA fee use before the loan.</p><figure class="dl-card dl-split"><p class="cap">On a beach condo, the HOA fee and the tax use most of the rent before the loan</p><p class="key"><span><i class="s-hoa"></i>HOA fee</span><span><i class="s-ti"></i>Tax and insurance</span><span><i class="s-cu"></i>Cushion at 1.25</span><span><i class="s-left"></i>Left for the loan</span></p><ol class="rows" style="--full:86.96%"><li><span class="lab">Longs house, 3 bedrooms</span><span class="val"><b>About 49%</b> left for the loan</span><svg class="bar" viewBox="0 0 115 10" preserveAspectRatio="none" role="img" aria-label="Longs house, 3 bedrooms: HOA fee 4 percent and tax and insurance 26 percent of the rent, 49 percent left for the loan at 1.25"><rect x="0.00" y="0" width="4.40" height="10" fill="#1c2028"/><rect x="4.40" y="0" width="26.30" height="10" fill="#5c6b78"/><rect x="30.70" y="0" width="20.00" height="10" fill="rgba(196,120,58,.32)"/><rect x="50.70" y="0" width="49.30" height="10" fill="#c4783a"/></svg></li><li><span class="lab">Carolina Forest house, 3 bedrooms</span><span class="val"><b>About 46%</b> left for the loan</span><svg class="bar" viewBox="0 0 115 10" preserveAspectRatio="none" role="img" aria-label="Carolina Forest house, 3 bedrooms: HOA fee 5 percent and tax and insurance 30 percent of the rent, 46 percent left for the loan at 1.25"><rect x="0.00" y="0" width="4.50" height="10" fill="#1c2028"/><rect x="4.50" y="0" width="29.90" height="10" fill="#5c6b78"/><rect x="34.40" y="0" width="20.00" height="10" fill="rgba(196,120,58,.32)"/><rect x="54.40" y="0" width="45.60" height="10" fill="#c4783a"/></svg></li><li><span class="lab">Carolina Forest condo, 2 bedrooms</span><span class="val"><b>About 44%</b> left for the loan</span><svg class="bar" viewBox="0 0 115 10" preserveAspectRatio="none" role="img" aria-label="Carolina Forest condo, 2 bedrooms: HOA fee 23 percent and tax and insurance 13 percent of the rent, 44 percent left for the loan at 1.25"><rect x="0.00" y="0" width="23.10" height="10" fill="#1c2028"/><rect x="23.10" y="0" width="13.40" height="10" fill="#5c6b78"/><rect x="36.50" y="0" width="20.00" height="10" fill="rgba(196,120,58,.32)"/><rect x="56.50" y="0" width="43.50" height="10" fill="#c4783a"/></svg></li><li><span class="lab">Myrtle Beach condo in the city, 2 bedrooms</span><span class="val"><b>About 14%</b> left for the loan</span><svg class="bar" viewBox="0 0 115 10" preserveAspectRatio="none" role="img" aria-label="Myrtle Beach condo in the city, 2 bedrooms: HOA fee 39 percent and tax and insurance 27 percent of the rent, 14 percent left for the loan at 1.25"><rect x="0.00" y="0" width="38.70" height="10" fill="#1c2028"/><rect x="38.70" y="0" width="27.20" height="10" fill="#5c6b78"/><rect x="65.90" y="0" width="20.00" height="10" fill="rgba(196,120,58,.32)"/><rect x="85.90" y="0" width="14.00" height="10" fill="#c4783a"/></svg></li><li><span class="lab">Garden City Beach condo, 2 bedrooms, nightly</span><span class="val"><b>About 20%</b> left for the loan</span><svg class="bar" viewBox="0 0 115 10" preserveAspectRatio="none" role="img" aria-label="Garden City Beach condo, 2 bedrooms, nightly: HOA fee 34 percent and tax and insurance 26 percent of the rent, 20 percent left for the loan at 1.25"><rect x="0.00" y="0" width="34.30" height="10" fill="#1c2028"/><rect x="34.30" y="0" width="26.00" height="10" fill="#5c6b78"/><rect x="60.30" y="0" width="20.00" height="10" fill="rgba(196,120,58,.32)"/><rect x="80.30" y="0" width="19.70" height="10" fill="#c4783a"/></svg></li><li><span class="lab">Myrtle Beach oceanfront condo, 2 bedrooms, nightly</span><span class="val"><b class="bad">More than the rent before any loan</b></span><svg class="bar" viewBox="0 0 115 10" preserveAspectRatio="none" role="img" aria-label="Myrtle Beach oceanfront condo, 2 bedrooms, nightly: HOA fee 78 percent and tax and insurance 32 percent of the rent, more than all of it"><rect x="0.00" y="0" width="77.80" height="10" fill="#1c2028"/><rect x="77.80" y="0" width="31.50" height="10" fill="#5c6b78"/><line x1="100" x2="100" y1="0" y2="10" stroke="#fff" stroke-width="3" vector-effect="non-scaling-stroke"/></svg></li></ol><p class="ax"><span style="left:86.96%"><i aria-hidden="true">&#9650;</i>All the rent</span></p><figcaption>Share of the monthly rent a lender counts, for the middle home for sale of each kind. Yearly leases use HUD's rent for the ZIP code. Nightly condos count 75 percent of a year of guest payments. Insurance is one agency's estimate, and flood insurance is not included.</figcaption></figure><ul class="dl-plain"><li><b>A city condo on a yearly lease is tight</b>The middle 2-bedroom condo inside Myrtle Beach leaves about 14 percent. Its dues alone, about $550 a month, take 39 percent of the rent.</li><li><b>An oceanfront condo rented by the night fails before the loan</b>Take a typical oceanfront two-bedroom in Myrtle Beach, booked the nights the average listing books. That average counts listings open only part of the year. Its HOA fee is about $1,200 a month. With the tax and insurance, that is about 109 percent of the nightly income a lender counts at 75 percent. The ratio is about 0.91 with no loan at all.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Taxes stop more rental deals here than insurance does. A home that is not its owner's legal residence, such as a house rented out year-round or a second home, is taxed on 6 percent. <a href="/buyers/property-taxes/" style="color:var(--navy);text-decoration:underline">Our property tax guide</a> works out the bill.</p><h3 class="dl-place">Longs: the Waccamaw River, and the most rent left for the loan</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Waccamaw River runs past Longs, and it is the only river that starts in a Carolina bay. From the landing on SC 9, you can paddle a state preserve along 28 miles of it, past bald cypress and water tupelo. Otters and black bears live there, and you may camp on the riverbank on preserve land.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Of the six homes we worked, the Longs house leaves the most of the rent for the loan, about 49 percent. The middle 3-bedroom house for sale asks about $320,000, and HUD's rent for a 3-bedroom in its ZIP code is $2,270 a month.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Much of Longs is new. About half the houses sold there in a year of county deeds were sales by builders, 280 of 607. About 2 in 5 homes in its ZIP code were built in 2010 or later. Only 3 in 100 of its houses are in FEMA's high-risk flood zone. Builders here rarely offer incentives to a buyer using a DSCR loan, so plan on none.</p><div class="hx-strip" data-place="dscr-longs-houses" data-name="Longs" data-head="Longs houses: the strongest DSCR numbers we found"></div><div class="hx-fallback"><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Longs">Send me 3-bedroom rentals in Longs<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div><h3 class="dl-place">Carolina Forest: trails in the woods, and almost no houses in the flood zone</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Off River Oaks Drive, the county's Bike and Run Park, which riders call "The Hulk", has 7 miles of mountain bike and running trails on about 70 acres. It sits between Carolina Forest and the Intracoastal Waterway.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Almost no houses in Carolina Forest are in FEMA's high-risk flood zone, and half its homes were built in 2007 or later. The middle 3-bedroom house for sale asks about $390,000 and leaves about 46 percent of the rent for the loan.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A condo there does almost as well. At HUD's 2-bedroom figure for the ZIP code, the middle 2-bedroom condo, about $165,000 with dues of about $425 a month, leaves about 44 percent.</p><div class="hx-strip" data-place="dscr-carolina-forest-houses" data-name="Carolina Forest" data-head="Best DSCR rental buys in Carolina Forest"></div><div class="hx-fallback"><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Carolina%20Forest">Send me Carolina Forest houses that clear 1.25<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="/invest/where-to-buy/" style="color:var(--navy);text-decoration:underline">Our where-to-buy guide</a> compares every area's rent with its prices.</p></div></section><section style="background:var(--ivory-2)" id="airbnb-income"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Airbnb income">Can you use Airbnb income for a DSCR loan in Myrtle Beach?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, at some lenders. Lenders count 75 to 80 percent of the nightly-rental estimate, to allow for advertising, furnishing and cleaning. A loan officer at our preferred lender says only 75 percent counts. Two of the three program sheets we read count at most 80 percent of nightly-rental income; the third asks for a 1.15 ratio instead.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The cut can make a nightly rental count for less than a yearly lease. The middle two-bedroom nightly rental in the Myrtle Beach area took in about $20,100 in a year, counting listings open only part of the year. Counted at 75 percent, that is about $1,256 a month. HUD's figure for a 2-bedroom on a yearly lease in ZIP code 29577 is $1,420.</p><ul class="dl-plain"><li><b>Some programs take it only on a refinance</b>Two of the three sheets we read take nightly income only when you refinance. On a purchase, the home may have to qualify on the yearly-lease rent.</li><li><b>The rules must allow nightly rentals</b>The lender's appraiser must show no city, county or HOA rule against them. In the City of Myrtle Beach, a stay under 90 days is short-term, and most of the city's residential zones bar it. <a href="/invest/str-rules/" style="color:var(--navy);text-decoration:underline">Our short-term rental rules guide</a> goes town by town.</li><li><b>Most condos allow them; few houses with an HOA do</b>About 7 in 10 condos for sale in Horry County say short-term rentals are allowed. Among houses for sale with an HOA fee, about 4 in 100 say so.</li></ul><h3 class="dl-place">Garden City Beach: the pier, and a beach condo that still passes</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Garden City Beach has a 668-foot pier. In summer, bands play every night at both ends of it, weather permitting, and you can fish from it around the clock. A pier pass covers fishing, so no state license is needed.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">It is also where a condo by the sea can still pass the ratio. About two dozen condos for sale in Garden City Beach are marked for nightly rentals. The middle 2-bedroom among them has dues of about $575 a month, under half the oceanfront tower's. Counted at 75 percent, its nightly income leaves about 20 percent for the loan at 1.25.</p><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);letter-spacing:.01em;color:#fff;text-align:right;background:radial-gradient(farthest-side at 100% 100%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.c3ph-cr a{color:#fff;text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);text-underline-offset:2px;pointer-events:auto;padding:10px 0 6px}.c3ph-hero{margin:1.6rem 0 2rem}.c3ph-hero .c3ph-f{border-radius:8px}.c3ph-hero img{aspect-ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}</style><figure class="c3ph-hero" style="margin:1.3rem 0 1.5rem;max-width:720px;"><div class="c3ph-f"><img src="/images/2026-11-a/invest-condos/garden-city-condos-2011-1200w.webp" srcset="/images/2026-11-a/invest-condos/garden-city-condos-2011-600w.webp 600w, /images/2026-11-a/invest-condos/garden-city-condos-2011-1200w.webp 1200w" sizes="(max-width: 760px) 100vw, 720px" width="1200" height="675" alt="A tall tan condo tower and several low-rise condo buildings with pools on the beach at Garden City, with beach houses and a wide salt marsh behind them" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: USGS. License: Public domain" title="License: Public domain">Photo: USGS</a></span></div><figcaption>A condo tower and low-rise condo buildings on the beach at Garden City Beach, with the salt marsh behind them.</figcaption></figure><div class="hx-strip" data-place="str-garden-city-beach-condos" data-name="Garden City Beach" data-head="Best Airbnb opportunities in Garden City Beach"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="/invest/airbnb-income/" style="color:var(--navy);text-decoration:underline">What Airbnbs make here</a> has the income town by town, and <a href="/invest/str-vs-ltr/" style="color:var(--navy);text-decoration:underline">nightly or yearly</a> compares the two plans.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Have us check whether a condo's nightly income passes the ratio.</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the condo. We read its HOA papers for the rental rules and work out its ratio at 75 percent.</p><a class="btn btn-brass" href="/contact/">Have us check a condo's numbers</a></div></div></section><section style="background:var(--ivory)" id="condotels"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Condotels">Can you get a DSCR loan on a condotel or non-warrantable condo here?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A non-warrantable condo is in a building that fails one of Fannie Mae's project rules, so the usual conventional loan will not work there.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Often not. About 8 in 10 condos for sale in oceanfront buildings in Horry County say the unit is in a rental program. All three DSCR program sheets we read exclude non-warrantable condos, and two of them also name condotels. Fannie Mae <a href="https://selling-guide.fanniemae.com/sel/b4-2.1-03/ineligible-projects" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">will not buy a loan</a> in a building run like a hotel or with a rental pool. It is one of the two companies Congress created to buy mortgages from lenders.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="/invest/condotel-financing/" style="color:var(--navy);text-decoration:underline">Our condotel financing guide</a> names the buildings and the loans that do work. <a href="/invest/non-warrantable-condos/" style="color:var(--navy);text-decoration:underline">Our non-warrantable condo guide</a> goes tower by tower.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=the%20building">Have us check the building before you offer<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div></section><section style="background:var(--ivory-2)" id="what-to-bring"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What to bring">How much down, what credit score and what else does a DSCR loan need?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A DSCR loan asks you for money down, a credit score, money in reserve and a plan for the first few years.</p><ul class="dl-plain"><li><b>Money down</b>15 to 25 percent on most purchases, and more on a condotel. Figures from our affiliated lender, BrickWood Mortgage, a separate company.</li><li><b>Credit score</b>The program sheets we read set credit score floors from 660 to 720.</li><li><b>Reserves</b>Money in the bank after closing, counted in months of the home's bill. The programs we read ask for 3 to 6 months, and one asks a first-time investor for 12.</li><li><b>A fee to pay off early</b>Many DSCR loans charge a prepayment fee if you sell or refinance in the first few years. Ask your lender before a quick resale or <a href="/invest/strategies/brrrr/" style="color:var(--navy);text-decoration:underline">a BRRRR refinance</a>.</li><li><b>The price of the loan</b>According to a loan officer at our preferred lender, with good credit and a 1.25 to 1.5 ratio, a DSCR loan is priced about like a conventional loan.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">To see what the loan would cost on a home here, call us. We will work with our affiliated lender to give you solid numbers.</p></div></section><section style="background:var(--ivory)" id="who-qualifies"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Who qualifies">Who can get a DSCR loan: an LLC, a first-time investor, a Canadian?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Each of them can get a DSCR loan at some programs, with limits.</p><ul class="dl-plain"><li><b>An LLC</b>A DSCR loan can close in your name or in an LLC; the investor clients we work with usually close in an LLC. About 9 in 10 of them form a new LLC for each house. <a href="/invest/llc/" style="color:var(--navy);text-decoration:underline">Our LLC guide</a> covers the steps.</li><li><b>A first-time investor</b>One program we read takes a first-time investor with a 700 score, 12 months of reserves and a home they own and live in. Another does not take them, and a third asks them for a 1.00 ratio. All three refuse a first-time home buyer.</li><li><b>A Canadian</b>Canadians usually need a DSCR loan unless they have a Social Security number and U.S. credit, or a U.S. work card. They need a Social Security number or a U.S. taxpayer ID number from the IRS, called a TIN. Some programs take only U.S. citizens and permanent residents. <a href="/invest/canadian-buyers/" style="color:var(--navy);text-decoration:underline">Our guide for Canadian buyers</a> has the rest.</li><li><b>Someone who will use it too</b>Plan to stay in the home more than 14 days in the coming year? Then <a href="https://www.consumerfinance.gov/rules-policy/regulations/1026/interp-3/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">federal rules</a> no longer treat it as a rental its owner does not live in. The business-loan exemption may not apply. Tell your lender early.</li></ul><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Have us find a rental that clears 1.25.</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us your price range and how you will hold it. We send homes whose rent clears the ratio, with the tax, the dues and the rental rules checked.</p><a class="btn btn-brass" href="/contact/">Send me rentals that clear 1.25</a></div></div></section><section style="background:var(--ivory-2)" id="how-we-help"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="How we help">How does Chapter3 help with a DSCR purchase on the Grand Strand?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The investor clients we work with here buy most often with a DSCR loan or <a href="/invest/strategies/1031-exchange/" style="color:var(--navy);text-decoration:underline">a 1031 exchange</a>. At each step of a DSCR purchase, we do the work:</p><ol class="dl-steps"><li><b>Find the property</b>Many agents wait for the client to bring a deal. We search the Grand Strand for homes that cash flow enough for a DSCR loan, and we send them to you.</li><li><b>Check the rules</b>Many communities ban renting the house at all. We filter out the ones here that do, and we read the HOA papers for rules that would block your plan.</li><li><b>Work out the bill</b>We work out the Horry County tax at 6 percent, and we get an insurance quote for the house before you make an offer.</li><li><b>Run the ratio</b>We divide the rent by the bill, at our 1.25 target. If you plan to rent by the night, we count 75 percent of the nightly income.</li><li><b>Choose your lender</b>You choose your lender. Our affiliated lender, BrickWood Mortgage, a separate company, is one option.</li></ol><p class="dl-story">We have a buyer who spent over a year scrolling Zillow and sending his agent links, asking if each was a good purchase. Every time, he got the same answer: yes, it is in an up and coming neighborhood.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Finding the property is the hard part, and it is the part we do.</p></div></section><section style="background:var(--ivory)" id="dscr-loan-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">DSCR loan FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What is a good DSCR for a rental property?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our target is 1.25, which leaves a fifth of the rent after the whole monthly bill. The three program sheets we read ask for 1.00 or more.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I get a DSCR loan in South Carolina without tax returns?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. A DSCR loan is judged on the home's rent and its monthly bill. You sign that the home is a rental for business and that you will not live in it.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I get a DSCR loan if the rent does not cover the bill?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Sometimes. Our affiliated lender, BrickWood Mortgage, a separate company, starts writing DSCR loans at a ratio of 0.75. Below 1.00, you pay the rest of the bill each month.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I use Airbnb income for a DSCR loan in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">At some lenders. They count 75 to 80 percent of the nightly-rental estimate, and two of the three sheets we read take it only on a refinance. The city and the HOA must allow nightly rentals.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does a DSCR loan need an appraisal?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. The rent the lender counts is the appraiser's market rent, written on a rent schedule with the appraisal.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I get a DSCR loan in an LLC?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. A DSCR loan can close in your name or in an LLC. The investor clients we work with usually close in an LLC.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can a first-time home buyer get a DSCR loan?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not at the three programs we read. A first-time investor who already owns a home can qualify at some programs.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can Canadians get a DSCR loan?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A Canadian without a Social Security number and U.S. credit usually needs a DSCR loan, and needs a Social Security number or a U.S. taxpayer ID number (TIN). Some programs take only U.S. citizens and permanent residents.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://selling-guide.fanniemae.com/sel/b3-6-03/monthly-housing-expense-subject-property" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Fannie Mae B3-6-03</a>, <a href="https://www.consumerfinance.gov/rules-policy/regulations/1026/interp-3/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Reg Z comment 3(a)-4</a>, <a href="https://www.scstatehouse.gov/code/t12c043.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-43-220</a>, <a href="https://www.horrycountysc.gov/media/kufln4qp/tax-levy-2026_2.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County 2026 tax levy</a>, <a href="https://www.huduser.gov/portal/datasets/fmr.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">HUD fair market rents</a>, <a href="https://clovered.com/landlord-insurance/south-carolina/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Clovered insurance estimates</a>, <a href="https://www.cityofmyrtlebeach.com/news_detail_T6_R1468.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">City of Myrtle Beach</a>. Loan rules: three DSCR program sheets for mortgage professionals, read by us and not named. Nightly income: AirROI. Listings: our count, in total only; one that does not say rentals are allowed may be a ban, a limit or a blank field. Longs and Carolina Forest: county deeds, FEMA and the Census Bureau. Not loan advice.</p><style>.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Condo buildings at Garden City Beach. Photo: U.S. Geological Survey, <a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://doi.org/10.5066/F7N877XX" target="_blank" rel="noopener noreferrer">U.S. Geological Survey</a>.</div><div role="listitem">Chapter3 Realty resized these photos and cropped some of them.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-11-a/invest-condos/garden-city-condos-2011-1200w.webp","url":"https://chapter3realty.com/images/2026-11-a/invest-condos/garden-city-condos-2011-1200w.webp","width":1200,"height":675,"encodingFormat":"image/webp","name":"A condo tower and low-rise condo buildings on the beach at Garden City Beach, with the salt marsh behind them","caption":"A condo tower and low-rise condo buildings on the beach at Garden City Beach, with the salt marsh behind them.","description":"A tall tan condo tower and several low-rise condo buildings with pool