yle="margin-top:0;max-width:720px"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.3rem;font-weight:600">On this page</p><ul style="list-style:none;margin:0;padding:0"><li><a href="#is-it-legal" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Is it legal</a></li><li><a href="#what-you-save" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">What you save</a></li><li><a href="#attorney" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">The attorney</a></li><li><a href="#paperwork" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">The paperwork</a></li><li><a href="#sell-for-less" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">By-owner prices</a></li><li><a href="#buyers" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Finding buyers</a></li><li><a href="#for-you" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Is it for you</a></li><li><a href="#steps" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">The steps</a></li><li><a href="#lead-form" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Our coaching</a></li><li><a href="#selling-by-owner-faq" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Selling by owner FAQ</a></li></ul></nav></div></section><section style="background:var(--ivory-2)" id="is-it-legal"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Is it legal">Can you sell your own house in South Carolina without a real estate agent?</h2><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);letter-spacing:.01em;color:#fff;text-align:right;background:radial-gradient(farthest-side at 100% 100%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.c3ph-cr a{color:#fff;text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);text-underline-offset:2px;pointer-events:auto;padding:10px 0 6px}.c3ph-hero{margin:1.6rem 0 2rem}.c3ph-hero .c3ph-f{border-radius:8px}.c3ph-hero img{aspect-ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}.c3ph-gal{display:grid;grid-template-columns:minmax(0,1fr);gap:1.5rem;margin:1.6rem 0;padding:0;list-style:none}.c3ph-gal>figure{margin:0;min-width:0}.c3ph-gal img{aspect-ratio:var(--c3ph-r,4/3)}.c3ph-gal figcaption{color:var(--muted);font-size:.85rem;line-height:1.45;margin-top:.5rem}@media (min-width:700px){.c3ph-gal{display:grid;grid-template-columns:repeat(var(--c3ph-n,3),minmax(0,1fr));gap:1rem;overflow:visible;padding:0}.c3ph-gal>figure{min-width:0}}@media (max-width:699px){.c3ph-gal.c3ph-row{display:flex;gap:.75rem;padding:0 var(--c3ph-bleed,1.4rem) .4rem;margin:1.6rem calc(-1*var(--c3ph-bleed,1.4rem)) 0;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding:0 var(--c3ph-bleed,1.4rem);-webkit-overflow-scrolling:touch;scrollbar-width:none}.c3ph-row::-webkit-scrollbar{display:none}.c3ph-row>figure{flex:0 0 82%;scroll-snap-align:start}}.c3ph-swipe{display:flex;align-items:center;gap:.75rem;margin:.5rem 0 1.6rem;color:var(--navy);font:500 .95rem/1.3 var(--sans)}.c3ph-dots{display:inline-flex;gap:.45rem}.c3ph-dots i{display:block;width:10px;height:10px;border-radius:50%;border:1.5px solid var(--navy);box-sizing:border-box}.c3ph-dots i:first-child{background:var(--navy)}@supports (animation-timeline:view()){.c3ph-rowbox{timeline-scope:--c3ph-p1,--c3ph-p2,--c3ph-p3}.c3ph-row>figure:nth-child(1){view-timeline:--c3ph-p1 inline}.c3ph-row>figure:nth-child(2){view-timeline:--c3ph-p2 inline}.c3ph-row>figure:nth-child(3){view-timeline:--c3ph-p3 inline}.c3ph-dots i{animation:c3ph-dot linear both;animation-range:cover}.c3ph-dots i:nth-child(1){animation-timeline:--c3ph-p1}.c3ph-dots i:nth-child(2){animation-timeline:--c3ph-p2}.c3ph-dots i:nth-child(3){animation-timeline:--c3ph-p3}@keyframes c3ph-dot{0%,36%{background:transparent}42%,60%{background:var(--navy)}66%,100%{background:transparent}}}@media (min-width:700px){.c3ph-swipe{display:none}}.c3ph-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:1.4rem 0 1.8rem;padding:0;list-style:none}@media (min-width:700px){.c3ph-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}}@media (min-width:1000px){.c3ph-cards.c3ph-4{grid-template-columns:repeat(4,minmax(0,1fr))}}.c3ph-card{margin:0;background:var(--ivory);border:1px solid var(--rule);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}.c3ph-card .c3ph-f{border-radius:0}.c3ph-card img,.c3ph-card svg{display:block;width:100%;height:auto;aspect-ratio:var(--c3ph-r,4/3);object-fit:cover}.c3ph-card .c3ph-cr{font-size:.56rem;padding:1.2rem .45rem .25rem 1.6rem}.c3ph-card strong{display:block;color:var(--navy);font-size:.98rem;font-weight:500;line-height:1.3;padding:.7rem .8rem 0}.c3ph-card span.c3ph-t{display:block;color:var(--muted);font-size:.86rem;line-height:1.45;padding:.2rem .8rem .85rem}.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:760px}</style><style>main#main .detail-hero .detail-sub{display:none}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. South Carolina's <a href="https://www.scstatehouse.gov/code/t40c057.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">license law</a> does not apply to an owner selling their own home, so you need no real estate license. This is called selling "for sale by owner", or FSBO.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Three duties apply to most owners who sell, with or without an agent:</p><ol class="fs-duties" aria-label="What every owner who sells must do in South Carolina"><li><b>A South Carolina attorney supervises the closing</b><a href="#attorney" style="color:var(--navy);text-decoration:underline">Who picks the attorney</a></li><li><b>The buyer gets the state's disclosure form before the contract</b><a href="#paperwork" style="color:var(--navy);text-decoration:underline">What the form asks</a></li><li><b>Most homes built before 1978 need lead papers</b><a href="#lead" style="color:var(--navy);text-decoration:underline">Which homes</a></li></ol></div></section><section style="background:var(--ivory)" id="what-you-save"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What you save">How much do you save selling by owner on a Myrtle Beach-area home?</h2><div class="fs-side"><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You save the listing broker's fee, what you would pay an agent to market and sell the home. Try it with your own price and the fee you were quoted:</p><div class="fs-calc" role="group" aria-labelledby="fsCalcT"><p class="k" id="fsCalcT">Try your own price</p><div class="fs-in"><label for="fsPrice">Your price</label><span class="u">$ <input id="fsPrice" type="number" min="0" step="1000" value="350000" oninput="fsCalc()"></span></div><div class="fs-in"><label for="fsPct">A fee you were quoted, in percent</label><span class="u"><input id="fsPct" type="number" min="0" max="10" step="0.25" value="1" oninput="fsCalc()"> %</span></div><dl class="fs-out"><div><dt>The fee you do not pay</dt><dd id="fsFee">$3,500</dd></div><div><dt>Deed fee, owed either way</dt><dd id="fsDeed">$1,295</dd></div></dl><p class="n">The box starts at 1 percent. Type the fee an agent quoted you.</p></div><script>function fsCalc(){var g=function(i){var v=parseFloat(document.getElementById(i).value);return isFinite(v)&&v>0?v:0};var m=function(n){return "$"+Math.round(n).toLocaleString("en-US")};var p=g("fsPrice"),f=g("fsPct");document.getElementById("fsDeed").textContent=m(Math.ceil(p/500)*1.85);document.getElementById("fsFee").textContent=m(p*f/100)}</script><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Two costs stay the same with or without an agent. You owe the deed fee, also called <a href="https://www.scstatehouse.gov/code/t12c024.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">deed stamps</a>: $1.85 for each $500 of the price. You also pay your share of the closing attorney's fee. Ask the attorney's office for its fee in writing before the contract says who pays it.</p></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The three ways to sell differ in who markets the house, who handles the papers and who you pay:</p><style>.c3-cc{margin:1.4rem 0 1.8rem;max-width:960px}.c3-cc table{width:100%;border-collapse:collapse;font-size:var(--read,1.0625rem);line-height:1.45;color:var(--muted)}.c3-cc caption{caption-side:top;text-align:left;color:var(--navy);font-weight:600;font-size:1em;line-height:1.4;padding:0 0 .7rem}.c3-cc th,.c3-cc td{padding:.6rem .7rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule);overflow-wrap:break-word}.c3-cc thead th{color:var(--navy);font-weight:600;font-size:1em;border-bottom:2px solid var(--navy);vertical-align:bottom}.c3-cc tbody th{color:var(--navy);font-weight:600}.c3-cc .n{text-align:right;font-variant-numeric:tabular-nums}.c3-cc .i{display:inline-flex;vertical-align:-4px;margin-right:.45rem;color:var(--brass-ink)}.c3-cc tr.c3-self>*{background:#fff}@media (max-width:59.999em){.c3-cc table,.c3-cc tbody,.c3-cc tr,.c3-cc th,.c3-cc td{display:block;width:auto}.c3-cc caption{display:block}.c3-cc thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.c3-cc tbody tr{background:var(--ivory-2);border-top:3px solid var(--brass);margin:0 0 .8rem;padding:.5rem 0 .6rem}section[style*="background:var(--ivory-2)"] .c3-cc tbody tr{background:var(--ivory)}.c3-cc tr.c3-self{background:#fff!important;border:2px solid var(--brass)}.c3-cc tr.c3-self>*{background:transparent}.c3-cc th,.c3-cc td{border:0;padding:.2rem 1rem}.c3-cc tbody th{display:flex;align-items:center;font-size:1.1em;padding-bottom:.35rem}.c3-cc tbody th .i{flex:none;vertical-align:0}.c3-cc tbody th a{display:inline-block;padding:.5rem 0}.c3-cc .n{text-align:left}.c3-cc td[data-label]::before{content:attr(data-label) ": ";color:var(--navy);font-weight:500}}</style><div class="c3-cc"><table><caption>Three ways to sell a $350,000 home, and what each one costs you</caption><thead><tr><th scope="col">How you sell</th><th scope="col">How it works</th><th scope="col" class="n">Deed fee</th><th scope="col">Listing broker's fee</th><th scope="col">Buyer's agent</th><th scope="col">Coaching fee</th></tr></thead><tbody><tr><th scope="row"><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span>Sell it yourself</th><td data-label="How it works">You do all of it</td><td class="n" data-label="Deed fee">$1,295</td><td data-label="Listing broker's fee">None</td><td data-label="Buyer's agent">Your choice</td><td data-label="Coaching fee">None</td></tr><tr><th scope="row"><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5.5 7h8A1.5 1.5 0 0 1 15 8.5v11a1.5 1.5 0 0 1-1.5 1.5h-8A1.5 1.5 0 0 1 4 19.5v-11A1.5 1.5 0 0 1 5.5 7zM8 7V4.5A1.5 1.5 0 0 1 9.5 3h9A1.5 1.5 0 0 1 20 4.5v11a1.5 1.5 0 0 1-1.5 1.5H15M9.5 17.5l-2.3-2.4a1.4 1.4 0 0 1 2.3-1.6 1.4 1.4 0 0 1 2.3 1.6z"/></svg></span>Sell it yourself, with our coaching</th><td data-label="How it works">You do it, we coach</td><td class="n" data-label="Deed fee">$1,295</td><td data-label="Listing broker's fee">None</td><td data-label="Buyer's agent">Your choice</td><td data-label="Coaching fee">Flat fee, credited if you list with us</td></tr><tr><th scope="row"><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span>List with an agent</th><td data-label="How it works">The agent markets and sells it</td><td class="n" data-label="Deed fee">$1,295</td><td data-label="Listing broker's fee">What you agree with your broker</td><td data-label="Buyer's agent">Your choice</td><td data-label="Coaching fee">None</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our <a href="/sell/net-proceeds/" style="color:var(--navy);text-decoration:underline">net proceeds calculator</a> works out what you keep after your loan payoff.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">What would you keep, by owner or with an agent?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send the address. We price the home from recorded county sales and work out what you keep both ways, free.</p><a class="btn btn-brass" href="#lead-form">Have us work out what you keep</a></div></div></section><section style="background:var(--ivory-2)" id="attorney"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The attorney">Do you need a lawyer to sell a house by owner in South Carolina?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, for the closing, the meeting where the buyer pays and you sign the house over. Every home closing in South Carolina <a href="https://www.sccourts.org/media/opinions/HTMLFiles/SC/25508.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">must be supervised</a> by a South Carolina attorney.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Preparing a deed for someone else is the practice of law. Anyone who prepares your deed for you, the paper that transfers the house, must be a lawyer.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Who picks the closing attorney?</h3><ul class="fs-cards fs-3" aria-label="Who chooses the closing attorney"><li><span class="k">The buyer has a home loan</span><b>The buyer chooses</b>If the loan is for a home the buyer will live in, the buyer picks the closing attorney, and the lender must follow that choice.</li><li><span class="k">Every sale</span><b>The contract can name one</b>The contract can name the closing attorney and say who pays the attorney's fees. You and the buyer agree on it.</li><li class="hot"><span class="k">You want advice</span><b>Hire your own</b>An attorney who represents only the buyer does not advise the seller. Advice on your side of the deal comes from your own attorney.</li></ul><h3 id="contract" style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Who writes the purchase contract?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A 2007 opinion of the state Attorney General's office looked at agents who fill in the blanks of a printed sale contract an attorney wrote. If the buyer has an agent, the offer may come to you on that kind of form.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The <a href="https://www.scag.gov/wp-content/uploads/2011/03/harrison-j-h-5-22-07-os-8395-unauthorized-practice-of-law.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">office</a> said that does not appear to be the practice of law, if no legal advice is given or asked for. The state Supreme Court has the final word. Preparing a legal paper for someone else is the practice of law when it involves legal advice. Advice on the contract's terms comes from a lawyer. A South Carolina attorney can write the contract for you, or read the buyer's before you sign.</p><h3 id="paid" style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How you get paid safely</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Closing money often moves by wire transfer, and <a href="https://www.consumerfinance.gov/archive/blog/mortgage-closing-scams-how-protect-yourself-and-your-closing-funds/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">scammers send fake wiring instructions</a> by email. Never follow wiring instructions in an email. Confirm them by phone with the attorney's office, at a number you agreed on in advance.</p></div></section><section style="background:var(--ivory)" id="paperwork"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The paperwork">What paperwork do you need to sell by owner in South Carolina?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The main paper is the state's <a href="https://llr.sc.gov/re/recpdf/Property-Condition-Disclosure-Statement-06.2025.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Residential Property Condition Disclosure Statement</a>, a form where you tell the buyer what you know about the home. <a href="https://www.scstatehouse.gov/code/t27c050.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">State law</a> requires it for a home with one to four units, unless the sale is one of the kinds <a href="#no-form" style="color:var(--navy);text-decoration:underline">listed below</a> that need no form. The form is free. Our guide to <a href="/sell/seller-disclosure/" style="color:var(--navy);text-decoration:underline">the South Carolina seller disclosure form</a> goes through all 28 questions.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The form has nine parts. It asks 28 numbered questions, each answered Yes, No or No Representation, plus lines where you describe things such as the roof's age, pests and leases.</p><figure class="fs-fig"><p class="cap">What South Carolina's disclosure form asks, part by part</p><ol class="fs-form" aria-label="The nine parts of the South Carolina disclosure form"><li><span class="pn">I</span><span class="pt">Water and sewer</span><span class="pq">Questions 1 to 4</span></li><li><span class="pn">II</span><span class="pt">Roof, gutters, foundation and floors</span><span class="pq">Questions 5 to 7</span></li><li><span class="pn">III</span><span class="pt">Plumbing, electrical, appliances, heating and cooling</span><span class="pq">Questions 8 to 14</span></li><li><span class="pn">IV</span><span class="pt">Termites, wood rot and other pests</span><span class="pq">Describe</span></li><li class="hot"><span class="pn">V</span><span class="pt">Zoning, rights of others to use your land, legal claims, water damage, flood and the beach</span><span class="pq">Questions 15 to 28</span><span class="coast"><b>Questions 22 to 28, on the coast and flooding</b><ul><li><i>22</i>Erosion and erosion control</li><li><i>23</i>Flood hazards, wetlands, flood zones, flood risk</li><li><i>24</i>Flood insurance on the property now</li><li><i>25</i>Flood insurance claims during your ownership</li><li><i>26</i>Flood repairs not claimed on insurance during your ownership</li><li><i>27</i>Federal flood disaster aid during your ownership</li><li><i>28</i>A charge for beach nourishment, sand added to the beach, while you owned it</li></ul>Question 20 also asks whether the house flooded while you owned it.</span></li><li><span class="pn">VI</span><span class="pt">Lead paint, asbestos, radon, buried tanks and mold</span><span class="pq">Describe</span></li><li><span class="pn">VII</span><span class="pt">Leases and vacation rentals in place at closing</span><span class="pq">Describe</span></li><li><span class="pn">VIII</span><span class="pt">Utility charges and equipment the utility financed</span><span class="pq">Describe</span></li><li><span class="pn">IX</span><span class="pt">Whether the home is in an association</span><span class="pq">Yes or No, then the addendum</span></li></ol><figcaption>Our drawing of the state's form. Each numbered question is answered Yes, No or No Representation. Parts marked "Describe" have lines to write on.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A home in a homeowners association (HOA), a property owners association or a condo also needs the form's addendum. It asks 11 more questions and lists the dues and the association's contact. Our <a href="/hoa/documents/" style="color:var(--navy);text-decoration:underline">HOA documents page</a> lists the association papers a buyer will ask for.</p><div class="fs-side"><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Why the flood questions matter here</h3><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/sell-fsbo/raised-beach-houses-surfside-beach-1200w.webp" srcset="/images/2026-11-a/sell-fsbo/raised-beach-houses-surfside-beach-600w.webp 600w, /images/2026-11-a/sell-fsbo/raised-beach-houses-surfside-beach-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="675" alt="Rows of two- and three-story beach houses behind the dunes, a mid-rise building and parking lots beside the Surfside Beach fishing pier, seen from over the ocean" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="USGS photo, 2011. License: Public domain" title="License: Public domain">USGS photo, 2011</a></span></div><figcaption>Beach houses beside the Surfside Beach pier in 2011. Questions 22 to 28 on the state form ask every seller about erosion, flooding and beach nourishment.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">FEMA has paid 8,815 flood insurance claims in Horry County since 1978. Nearly 1 in 4 were on buildings rated outside the high-risk flood zone. That is why questions 23 to 27 matter here, even away from the water. Our <a href="/buyers/undisclosed-flooding/" style="color:var(--navy);text-decoration:underline">flood history page</a> shows what a buyer can find out about a home's flood past.</p></div><h3 id="form-rules" style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Four rules about the form</h3><ul class="fs-plain fs-2" aria-label="Four rules about the disclosure form"><li><span class="k">"No Representation"</span><b>Not a way to skip a question</b>It means you do not know enough to answer Yes or No. It does not protect you if you know of the problem.</li><li><span class="k">After you hand it over</span><b>Correct it if anything changes</b>If the roof starts to leak before closing, you must correct the form or repair the roof.</li><li class="hot"><span class="k">If you leave something out</span><b>You can owe the buyer</b>A seller who knowingly leaves a problem off the form, or answers falsely, can owe the buyer their actual losses and court costs. A court may add the winner's attorney fees.</li><li><span class="k">Selling as is</span><b>The form still applies</b>You can sell "as is", which means without repairs. An as-is sale still needs the form, unless it is one of the sales listed below.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not giving the form does not cancel the contract or stop the closing.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What you do not have to tell a buyer</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You do not have to disclose that someone died in the home. You also do not have to disclose an illness of someone who lived there if it is highly unlikely to spread by living in the home. The same goes for the sex offender registry. If a buyer asks you directly, you may not lie.</p><h3 id="no-form" style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Sales that need no form</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">South Carolina lists 15 kinds of sale that need no form. Among them:</p><ul style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem">A sale only to your spouse, or only to your children, grandchildren, parents or grandparents. If your child's spouse is also a buyer, the sale needs the form.</li><li style="margin-bottom:.5rem">A sale only between co-owners.</li><li style="margin-bottom:.5rem">A sale by an executor or trustee settling an estate or a trust.</li><li style="margin-bottom:.5rem">The first sale of a home no one has lived in.</li><li style="margin-bottom:.5rem">A sale at public auction.</li><li style="margin-bottom:.5rem">Any sale where buyer and seller both agree in writing to skip the form.</li></ul><div class="fs-lead-box" id="lead"><b>Homes built before 1978</b>A seller of most homes built before 1978 must also give the buyer the <a href="https://www.epa.gov/lead/real-estate-disclosures-about-potential-lead-hazards" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">federal lead pamphlet</a>. You also say what you know about lead paint and hand over any lead reports. The contract must include a lead warning statement. The buyer gets 10 days to test for lead, unless both agree in writing to a different period or the buyer waives it. Keep the signed form for three years. Four cases are not covered. One is a unit with no bedroom. Another is housing for older people or people with disabilities where no child under six lives. The others are a home a certified inspector found free of lead paint, and a foreclosure sale.</div><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Want a licensed agent to read your form first?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us your filled-in form before a buyer sees it. Our agents read every answer and mark the ones a buyer will ask about.</p><a class="btn btn-brass" href="#lead-form">Send us your form to review</a></div></div></section><section style="background:var(--ivory-2)" id="sell-for-less"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="By-owner prices">Do houses sold by owner sell for less?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Nationally, yes, but many of those sales were to someone the seller knew. NAR, the National Association of Realtors, surveys people who bought a home to live in and also sold one. In <a href="https://nar.realtor/newsroom/first-time-home-buyer-share-falls-to-historic-low-of-21-median-age-rises-to-40" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">its 2025 survey</a>, 5 percent sold by owner, the lowest share in NAR's records.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">More than half of by-owner sellers already knew the buyer. In resort and recreation areas, 9 percent sold by owner.</p><figure class="c3-gchart"><div role="table" aria-label="Middle sale price in NAR's 2025 survey, by how the home sold"><span class="cap" aria-hidden="true">Middle sale price in NAR's 2025 survey, by how the home sold</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">How it sold</span><span role="columnheader">middle price</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">By owner, seller knew the buyer</span></span><span role="cell"><span class="b" style="--f:0.847" aria-hidden="true"></span><span class="v">$360,000</span></span></div><div role="row"><span role="rowheader"><span class="n">By owner, seller did not know the buyer</span></span><span role="cell"><span class="b" style="--f:0.876" aria-hidden="true"></span><span class="v">$372,200</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Sold with an agent</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">$425,000</span></span></div></div></div><figcaption>The groups sell different homes in different places, so the gap is not all price lost. The survey covers people who bought a home to live in and also sold one.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">County deeds point the same way for sales between people who share a last name. We read the county's deed index for a year and compared those sales with other sales between two people.</p><figure class="c3-gchart"><div role="table" aria-label="Horry County home sales recorded under $100,000"><span class="cap" aria-hidden="true">Horry County home sales recorded under $100,000</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Who sold to whom, how many</span><span role="columnheader">share under $100,000</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Seller and buyer share a last name</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">22 of 73 sales</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">3 in 10</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Other sales between people</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">294 of 7,449 sales</span></span><span role="cell"><span class="b" style="--f:0.131" aria-hidden="true"></span><span class="v">1 in 25</span></span></div></div></div><figcaption>Our count of the county's deeds, October 2025 to September 2026: resales between two people, with no company, trust, estate or builder on either side. The middle price was $200,000 when the two shared a last name and $310,000 for the rest.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A shared last name is not proof of family, and relatives with different last names are missed. Even so, those 73 sales recorded far lower prices.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Selling to a stranger</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Selling to a stranger is a different job. The price has to come from the sales most like your home, and enough buyers have to see the house.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Asked the hardest part, 17 percent of by-owner sellers named getting the price right, more than any other task.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Two quick numbers are a poor guide to a price. We checked both against 4,919 house resales recorded this year. On a typical house, each was this far off the sale price:</p><div class="fs-stat"><p class="k">How far off, on a typical house</p><ul><li><strong>9 percent</strong><span>the county's value, an estimate made for tax</span></li><li><strong>16 percent</strong><span>the middle price of the six nearest sales</span></li></ul></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our <a href="/sell/home-value/" style="color:var(--navy);text-decoration:underline">home value page</a> shows the test.</p></div></section><section style="background:var(--ivory)" id="buyers"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Finding buyers">How will buyers find your house, and do you have to pay their agent?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Owners who sell by themselves reach buyers with a yard sign, word of mouth, open houses and listing websites. This chart shows how by-owner sellers in <a href="https://www.rirealtors.org/clientuploads/documents/NAR/Homebuyers_and_sellers_trend_2025.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NAR's 2025 survey</a> did it:</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="How owners who sold by themselves reached buyers"><span class="cap" aria-hidden="true">How owners who sold by themselves reached buyers</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Way they reached buyers</span><span role="columnheader">share of by-owner sellers</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">A yard sign</span></span><span role="cell"><span class="b" style="--f:0.6" aria-hidden="true"></span><span class="v">24%</span></span></div><div role="row"><span role="rowheader"><span class="n">Friends, relatives or neighbors</span></span><span role="cell"><span class="b" style="--f:0.55" aria-hidden="true"></span><span class="v">22%</span></span></div><div role="row"><span role="rowheader"><span class="n">The MLS website</span></span><span role="cell"><span class="b" style="--f:0.5" aria-hidden="true"></span><span class="v">20%</span></span></div><div role="row"><span role="rowheader"><span class="n">An open house</span></span><span role="cell"><span class="b" style="--f:0.5" aria-hidden="true"></span><span class="v">20%</span></span></div><div role="row"><span role="rowheader"><span class="n">Realtor.com</span></span><span role="cell"><span class="b" style="--f:0.35" aria-hidden="true"></span><span class="v">14%</span></span></div><div role="row"><span role="rowheader"><span class="n">Sites that gather listings from many sources</span></span><span role="cell"><span class="b" style="--f:0.325" aria-hidden="true"></span><span class="v">13%</span></span></div><div role="row"><span role="rowheader"><span class="n">Social media</span></span><span role="cell"><span class="b" style="--f:0.225" aria-hidden="true"></span><span class="v">9%</span></span></div><div role="row"><span role="rowheader"><span class="n">For-sale-by-owner websites</span></span><span role="cell"><span class="b" style="--f:0.125" aria-hidden="true"></span><span class="v">5%</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Did not actively market it</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">40%</span></span></div></div></div><figcaption>NAR's 2025 survey. Sellers could name more than one way, so the shares add to more than 100 percent.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The MLS is the database real estate brokers share to list homes for sale, so an owner gets on it through a broker. In NAR's survey, 7 percent of sellers who used an agent said the agent put the home on the MLS and did little else.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On the MLS, your house competes with every other home for sale:</p><div class="fs-stat"><p class="k">Houses for sale in Horry County now</p><ul><li><strong>About 3,700</strong><span>houses listed for sale on the MLS, the database brokers share</span></li><li><strong>56 percent</strong><span>of them have already cut their asking price. Buyers compare yours with all of them.</span></li></ul></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="https://llr.sc.gov/re/RECPDF/Limited%20Market%20Exposure%20Guidance%20Document.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Broad marketing</a> generally exposes a home to the greatest number of qualified buyers. Keeping a home off the open market may reduce buyer competition and may hurt the price, terms or time to sell.</p><h3 id="buyers-agent" style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do you have to pay the buyer's agent?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No rule requires it. Since August 2024, an agent who uses the MLS <a href="https://www.nar.realtor/the-facts/what-the-nar-settlement-means-for-home-buyers-and-sellers" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">signs a written agreement</a> with a buyer before touring a home. Offers to pay the buyer's agent are no longer made on the MLS.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You can still offer to pay the buyer's agent off the MLS, or offer the buyer a credit toward their costs. Agents' fees are negotiable, and no law names an amount.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">A price from the sales next to yours</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We pull the recorded sales closest to your home and send you a price range, free, whether you sell by owner or list.</p><a class="btn btn-brass" href="#lead-form">Have us find the sales closest to yours</a></div></div></section><section style="background:var(--ivory-2)" id="for-you"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Is it for you">Is selling by owner a good idea for you?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The answer changes with who the buyer is and where the house is. Find your situation:</p><ul class="fs-cards fs-2" aria-label="Should you sell by owner: your situation and what to do"><li><span class="k">You already have a buyer</span><b>A relative, a neighbor or your tenant</b>Selling it yourself fits best. There is no one to find, so the work is the papers and the closing. <a href="#no-form" style="color:var(--navy);text-decoration:underline">Sales that need no form</a></li><li class="hot"><span class="k">You are selling to a stranger</span><b>You want the most money</b>See <a href="#sell-for-less" style="color:var(--navy);text-decoration:underline">whether homes sold by owners sell for less</a>, and what changes the price.</li><li><span class="k">Your house is near the water</span><b>Or in a flood zone</b>Gather your flood papers before you list: insurance, past claims and repair bills. Questions 20 and 22 to 28 of the form ask about each.</li><li><span class="k">You want to keep the fee</span><b>But not do it alone</b>You sell it yourself, and a licensed agent coaches you on the price, the form and the contract for a flat fee. <a href="#lead-form" style="color:var(--navy);text-decoration:underline">Our coaching</a></li></ul></div></section><section style="background:var(--ivory)" id="steps"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The steps">What are the steps to sell a house by owner in South Carolina?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Eight steps, from the price to the money in your account. Steps marked "Required by law" come from state or federal rules.</p><ol class="fs-steps" aria-label="The steps to sell a house by owner in South Carolina, in order"><li><span class="n" aria-hidden="true">1</span><span class="c"><span class="t">Before you list</span><b>Set the price</b>Price it from the recorded sales most like your home. Our <a href="/sell/home-value/" style="color:var(--navy);text-decoration:underline">home value page</a> shows how.</span></li><li class="hot"><span class="n" aria-hidden="true">2</span><span class="c"><span class="t">Before you list</span><span class="t law">Required by law</span><b>Fill in the papers</b>The state's disclosure form, the HOA addendum if you have an association, and the <a href="#lead" style="color:var(--navy);text-decoration:underline">lead papers</a> for most homes built before 1978.</span></li><li><span class="n" aria-hidden="true">3</span><span class="c"><span class="t">Showings</span><b>Reach buyers and show the house</b>Use the ways <a href="#buyers" style="color:var(--navy);text-decoration:underline">in the chart above</a>. Keep valuables and medicines out of sight during showings.</span></li><li><span class="n" aria-hidden="true">4</span><span class="c"><span class="t">Before you sign</span><b>Check that the buyer can pay</b>Ask for a loan approval letter from a lender, or proof of the cash, before you sign anything.</span></li><li class="hot"><span class="n" aria-hidden="true">5</span><span class="c"><span class="t">Signing</span><span class="t law">Required by law</span><b>Hand over the form, then sign the contract</b>The form comes first, unless the contract names another time. Agree in writing on the deposit and who holds it, the inspection period, the loan deadline and the closing date. <a href="#contract" style="color:var(--navy);text-decoration:underline">Who writes the contract</a></span></li><li class="hot"><span class="n" aria-hidden="true">6</span><span class="c"><span class="t">After signing</span><span class="t law">Required by law</span><b>The buyer's lead test</b>For most homes built before 1978, the buyer's <a href="#lead" style="color:var(--navy);text-decoration:underline">lead test period</a> starts now.</span></li><li class="hot"><span class="n" aria-hidden="true">7</span><span class="c"><span class="t">Before closing</span><span class="t law">Required by law</span><b>Keep the form up to date</b>The <a href="#form-rules" style="color:var(--navy);text-decoration:underline">form rules</a> apply until closing day.</span></li><li><span class="n" aria-hidden="true">8</span><span class="c"><span class="t">Closing day</span><b>Sign, and get paid by wire</b><a href="#paid" style="color:var(--navy);text-decoration:underline">Check the wiring instructions by phone</a>. The deed fee comes out of the sale.</span></li></ol><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do you pay tax on the sale?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Often not. Under <a href="https://www.irs.gov/taxtopics/tc701" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">federal tax law</a>, you can leave part or all of your gain out of your income.</p><ul class="fs-plain fs-2" aria-label="Tax on the sale of a home"><li><span class="k">How much</span><b>Up to $250,000 of gain</b>Or $500,000 of gain for a married couple filing jointly.</li><li><span class="k">Who qualifies</span><b>You lived there 2 of 5 years</b>You owned and lived in the home at least 2 of the last 5 years. You did not use this exclusion on another home in the 2 years before.</li><li class="hot"><span class="k">You live in another state</span><b>The buyer holds back state tax</b>For a 2026 sale it is 5.21 percent. It is figured on your gain if you sign the state's <a href="https://www.scstatehouse.gov/code/t12c008.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">gain affidavit</a>, Form I-295, or on the whole price if you do not. A main home whose gain fits inside the federal exclusion has none.</li><li class="hot"><span class="k">Getting it back</span><b>Your South Carolina return</b>File a South Carolina return for the year of the sale. The amount held back counts toward the tax you owe there. You can ask for a refund of any amount held back beyond the tax.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our <a href="/sell/capital-gains/" style="color:var(--navy);text-decoration:underline">capital gains page</a> works through the tax when the gain is larger.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Do the eight steps with a coach</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">You sell it yourself. We coach you on the price, the form, the contract and closing day, for a flat fee.</p><a class="btn btn-brass" href="#lead-form">Have us coach your sale</a></div></div></section><section style="background:var(--ivory-2)" id="lead-form"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Our coaching">What does Chapter3's coaching for owners include?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You list and sell the home yourself, and keep what you save. A licensed Chapter3 agent coaches you through it for a flat fee:</p><ul class="fs-coach" aria-label="What the coaching covers"><li>The price, from county sales of similar homes</li><li>The state's form, read before a buyer sees it</li><li>The purchase contract and its deadlines</li><li>Checking a buyer's loan approval or proof of cash</li><li>Lining up the closing attorney and closing day</li><li>Whether listing is worth the fee for your house</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If you decide to list with us at any point, the full coaching fee is credited back. The price check is free either way.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We are paid the flat coaching fee if you sell it yourself. If you list with us, we are paid the listing fee you agree with us, less the coaching fee you already paid.</p><div id="ldWrap" class="fs-form-box"><div class="idx-lead" style="grid-template-columns:1fr"><input class="idx-input" id="ldCtx" placeholder="Property address" aria-label="Property address" autocomplete="street-address"></div><div class="idx-lead"><input class="idx-input" id="ldName" placeholder="Your name" aria-label="Your name" autocomplete="name"><input class="idx-input" id="ldPhone" placeholder="Phone" aria-label="Phone" type="tel" autocomplete="tel"></div><div class="idx-lead" style="grid-template-columns:1fr"><input class="idx-input" id="ldEmail" placeholder="Email" aria-label="Email" type="email" autocomplete="email"></div><label class="fs-consent"><input type="checkbox" id="ldConsent"><span>I consent to receive calls and text messages from Chapter 3 Realty about my property inquiry, showing appointments, and listing information I requested, at the phone number provided, including calls placed using an automated system or an artificial or prerecorded voice. Message frequency varies. Message and data rates may apply. Reply HELP for help, STOP to opt out. Consent is not a condition of any purchase.</span></label><p id="ldErr" class="fs-err" role="alert"></p><button type="button" class="btn btn-brass btn-lg" onclick="ldSubmit()">Send my coaching request</button><p class="fs-tel">Free, no obligation. Prefer to talk now? Call <a href="tel:+18543332135">854.333.2135</a>.</p></div><div id="ldOk" class="fs-ok">Thanks. A licensed team member will reach out the same day, evenings included, to explain the coaching and build your free pricing analysis.</div><script>function ldSubmit(){var cx=document.getElementById('ldCtx').value.trim(),n=document.getElementById('ldName').value.trim(),ph=document.getElementById('ldPhone').value.trim(),em=document.getElementById('ldEmail').value.trim(),c=document.getElementById('ldConsent').checked,err=document.getElementById('ldErr');function fail(m){err.textContent=m;err.style.display='block';}err.style.display='none';if(!cx||!n){fail('Add the property address and your name.');return;}if(!ph&&!em){fail('Add a phone number or an email so we can reach you.');return;}if(!c){fail('Check the consent box to send the request.');return;}c3SendForm({property_address:cx,name:n,phone:ph,email:em,consent:c?'yes':'no'},'fsbo-coaching');document.getElementById('ldWrap').style.display='none';document.getElementById('ldOk').style.display='block';}</script></div></section><section style="background:var(--ivory)" id="selling-by-owner-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Selling by owner FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Who pays the deed stamps when you sell by owner in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The seller pays them, whether or not an agent is involved: $1,295 on a $350,000 sale.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I sell my house to my son or daughter without the disclosure form?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, if the sale is only to your children, grandchildren, parents or grandparents. If your child's spouse is also a buyer, the sale needs the form.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do I have to tell a buyer that someone died in the house?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. South Carolina does not require it. If a buyer asks you directly, you may not lie about it.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I sell my house as is in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. An as-is sale still needs the state's disclosure form, unless it is one of the sales that need no form, such as some family sales.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can a buyer use their own agent to buy a for-sale-by-owner home?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. The buyer's written agreement with their agent says how that agent is paid. You can offer to pay that agent, or offer the buyer a credit toward their costs.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.scstatehouse.gov/code/t40c057.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 40-57</a>, <a href="https://www.sccourts.org/media/opinions/HTMLFiles/SC/25508.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Doe v. McMaster</a>, <a href="https://www.scstatehouse.gov/code/t37c010.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 37-10</a>, <a href="https://www.scbar.org/for-lawyers/quicklinks/legal-resources/ethics-advisory-opinions/ethics-advisory-opinion-06-11/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Bar 06-11</a>, <a href="https://www.scstatehouse.gov/code/t27c050.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 27-50</a>, <a href="https://llr.sc.gov/re/recpdf/Property-Condition-Disclosure-Statement-06.2025.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC form</a>, <a href="https://www.epa.gov/lead/real-estate-disclosures-about-potential-lead-hazards" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">EPA lead rule</a>, <a href="https://www.scstatehouse.gov/code/t12c024.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-24</a>, <a href="https://www.scstatehouse.gov/code/t12c008.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-8</a>, <a href="https://dor.sc.gov/news/information-about-h-4216" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SCDOR H. 4216</a>, <a href="https://nar.realtor/newsroom/first-time-home-buyer-share-falls-to-historic-low-of-21-median-age-rises-to-40" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NAR 2025 release</a>, <a href="https://www.rirealtors.org/clientuploads/documents/NAR/Homebuyers_and_sellers_trend_2025.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NAR 2025 Profile</a>, <a href="https://www.scag.gov/wp-content/uploads/2011/03/harrison-j-h-5-22-07-os-8395-unauthorized-practice-of-law.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC AG opinion</a>, <a href="https://www.nar.realtor/the-facts/what-the-nar-settlement-means-for-home-buyers-and-sellers" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NAR settlement</a>, <a href="https://llr.sc.gov/re/RECPDF/Limited%20Market%20Exposure%20Guidance%20Document.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Commission</a>, <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeDocType" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">County deeds</a>, <a href="https://www.fema.gov/openfema-data-page/fima-nfip-redacted-claims-v2" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">OpenFEMA</a>, <a href="https://www.irs.gov/taxtopics/tc701" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">IRS Topic 701</a>, <a href="https://www.consumerfinance.gov/archive/blog/mortgage-closing-scams-how-protect-yourself-and-your-closing-funds/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">CFPB</a>. Our reading of county deeds: the $350,000 home, the county-value test, the last-name count. Listings: our search, in aggregate.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1rem"><strong style="color:var(--navy)">Legal notice.</strong> Chapter3 Realty Corp is a licensed South Carolina real estate brokerage. We are not attorneys, and nothing on this page is legal or tax advice. For advice on your own sale, talk to a South Carolina attorney.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Rows of two- and three-story beach houses behind the dunes, a mid-rise building and parking lots beside the Surfside Beach fishing pier, seen from over the ocean. Photo: U.S. Geological Survey, <a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://doi.org/10.5066/F7