s (animation-timeline:view()){.c3ph-rowbox{timeline-scope:--c3ph-p1,--c3ph-p2,--c3ph-p3}.c3ph-row>figure:nth-child(1){view-timeline:--c3ph-p1 inline}.c3ph-row>figure:nth-child(2){view-timeline:--c3ph-p2 inline}.c3ph-row>figure:nth-child(3){view-timeline:--c3ph-p3 inline}.c3ph-dots i{animation:c3ph-dot linear both;animation-range:cover}.c3ph-dots i:nth-child(1){animation-timeline:--c3ph-p1}.c3ph-dots i:nth-child(2){animation-timeline:--c3ph-p2}.c3ph-dots i:nth-child(3){animation-timeline:--c3ph-p3}@keyframes c3ph-dot{0%,36%{background:transparent}42%,60%{background:var(--navy)}66%,100%{background:transparent}}}@media (min-width:700px){.c3ph-swipe{display:none}}.c3ph-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:1.4rem 0 1.8rem;padding:0;list-style:none}@media (min-width:700px){.c3ph-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}}@media (min-width:1000px){.c3ph-cards.c3ph-4{grid-template-columns:repeat(4,minmax(0,1fr))}}.c3ph-card{margin:0;background:var(--ivory);border:1px solid var(--rule);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}.c3ph-card .c3ph-f{border-radius:0}.c3ph-card img,.c3ph-card svg{display:block;width:100%;height:auto;aspect-ratio:var(--c3ph-r,4/3);object-fit:cover}.c3ph-card .c3ph-cr{font-size:.56rem;padding:1.2rem .45rem .25rem 1.6rem}.c3ph-card strong{display:block;color:var(--navy);font-size:.98rem;font-weight:500;line-height:1.3;padding:.7rem .8rem 0}.c3ph-card span.c3ph-t{display:block;color:var(--muted);font-size:.86rem;line-height:1.45;padding:.2rem .8rem .85rem}.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:720px}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A condo master policy is the insurance the condo association buys for the whole building. You pay your share of it through the condo fee. An HO-6 is the policy you buy for your own unit.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-10-d/hoa-special-assessments/north-myrtle-beach-oceanfront-roofs-and-balconies-2011-1200w.webp" srcset="/images/2026-10-d/hoa-special-assessments/north-myrtle-beach-oceanfront-roofs-and-balconies-2011-600w.webp 600w, /images/2026-10-d/hoa-special-assessments/north-myrtle-beach-oceanfront-roofs-and-balconies-2011-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="525" alt="Two oceanfront mid-rise buildings in North Myrtle Beach with stacked balconies and railings, a flat roof with rooftop equipment and a pool behind the dunes" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: U.S. Geological Survey. License: Public domain" title="License: Public domain">Photo: U.S. Geological Survey</a></span></div><figcaption>Roofs, balconies and a pool on oceanfront buildings in North Myrtle Beach, seen from a plane. A condo master policy insures parts like these.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">South Carolina's condo law requires the association to insure the property. It also gives each owner the right to insure their own unit. An HO-6 insures your belongings, the improvements made to your unit, and your liability.</p><div class="c3-ins-tab"><table><caption class="sr">Who insures what in a condo: the building's master policy and your HO-6</caption><thead><tr><th scope="col">What</th><th scope="col">Building's master policy</th><th scope="col">Your HO-6</th></tr></thead><tbody><tr><th scope="row">The roof, the outside walls, the halls, the elevators and the pool</th><td><span class="l">Building's policy</span>Yes</td><td><span class="l">Your HO-6</span>No</td></tr><tr><th scope="row">Cabinets, floors and fixtures inside your unit, as built</th><td><span class="l">Building's policy</span>Depends on the building</td><td><span class="l">Your HO-6</span>When the building's policy leaves them out</td></tr><tr><th scope="row">Upgrades you or an earlier owner made</th><td><span class="l">Building's policy</span>Only in an all-in policy</td><td><span class="l">Your HO-6</span>Yes</td></tr><tr><th scope="row">Your furniture, clothes and other belongings</th><td><span class="l">Building's policy</span>No</td><td><span class="l">Your HO-6</span>Yes</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About 8 in 10 oceanfront condos for sale list insurance among what the condo fee includes. Our page on <a href="/hoa/" style="color:var(--navy);text-decoration:underline">what HOA fees cover</a> breaks the fee down.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Owners who live in their condo here pay about $800 a year for their own policy.</p></div></section><section style="background:var(--ivory)" id="inside"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Inside your unit">Does the condo master policy cover the inside of my unit?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">There are three kinds of master policy. Two of them cover some of the inside of your unit. The building's recorded papers usually say which kind applies:</p><ul style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem"><strong>Bare walls.</strong> The association insures the structure and the shared areas. You insure the building parts inside your unit, such as sinks, built-in cabinets, appliances, flooring and wall coverings, and any upgrades.</li><li style="margin-bottom:.5rem"><strong>Single entity.</strong> The association also insures the fixtures in each unit as built. You insure your belongings and your own upgrades.</li><li style="margin-bottom:.5rem"><strong>All in.</strong> The association also insures the upgrades owners made. You insure your belongings.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Some agents say "walls in" for single entity, and some use it for the owner's own policy. We go by the building's papers, not the label.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How do I find out which kind my building has?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">South Carolina's condo law does not say where the association's policy stops inside a unit. The building's own papers do: the insurance section of its recorded founding papers, and its policy's declarations page.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">With bare walls, a new kitchen or a tiled floor is yours to insure.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Know what the building's policy leaves to you</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the building's name. We get its recorded papers and its policy's declarations page, and tell you what your HO-6 must insure.</p><a class="btn btn-brass" href="/contact/">Have us read the building's insurance section</a></div></div></section><section style="background:var(--ivory-2)" id="mortgage"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="HO-6 for a mortgage">How much HO-6 coverage do I need for my mortgage?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For most conventional loans, your HO-6 must insure at least what the building's policy leaves out inside your unit, or the building's per-unit deductible, whichever is more. Fannie Mae's rules for the HO-6, in full:</p><ul class="c3-ins-rules"><li><strong>When you need one</strong><span>When the building's policy leaves out any part of the inside of your unit, or charges a deductible to each unit.</span></li><li><strong>How much it must insure</strong><span>At least the larger of two amounts: what it costs to restore what the building's policy leaves out, or the building's per-unit deductible.</span></li><li><strong>How it pays</strong><span>At replacement cost, the cost to restore your unit as it was.</span></li><li><strong>Its own deductible</strong><span>At most 5 percent of its coverage or $2,500, whichever is more.</span></li><li><strong>Wind</strong><span>If the building's per-unit deductible is for one peril, such as wind, your HO-6 must cover that peril.</span></li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Fannie Mae's rules are not a law. An FHA or VA loan, a loan the lender keeps, or a cash purchase can have other rules.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Fannie Mae has rules for the building's policy too. Its deductible can be at most 5 percent of what it insures.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A deductible charged to each unit can be at most $50,000. Our page on <a href="/invest/non-warrantable-condos/" style="color:var(--navy);text-decoration:underline">condos most lenders will not lend on</a> explains what a building that misses these rules means for a loan.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does an HO-6 cover wind and hail?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Near the ocean, it may not. East of U.S. 17 or Bypass 17, whichever is farther west, an insurer may leave wind out of a policy. You can then buy wind cover on its own, for example from the state's wind and hail pool.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">When we get you an insurance quote, we ask that it include wind. Our page on <a href="/buyers/coastal-insurance/" style="color:var(--navy);text-decoration:underline">coastal insurance in Myrtle Beach</a> explains the state's wind and hail pool.</p></div></section><section style="background:var(--ivory)" id="deductible"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The storm deductible">Does an HO-6 cover the master policy deductible?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Sometimes. The part of an HO-6 that can pay your share of the building's deductible is its loss assessment coverage. It pays your share, up to its limit, and nothing above it.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On this coast, the deductible to ask about is the one for storms. A building's policy can have a separate wind or named storm deductible. For a loan Fannie Mae buys, it must meet the same 5 percent limit.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="A 5 percent storm deductible could bill each owner about $6,500"><span class="cap" aria-hidden="true">A 5 percent storm deductible could bill each owner about $6,500</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Storm deductible, note</span><span role="columnheader">One owner's share</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">A 1 percent storm deductible</span></span><span role="cell"><span class="b" style="--f:0.179" aria-hidden="true"></span><span class="v">About $1,300</span></span></div><div role="row"><span role="rowheader"><span class="n">A 2 percent storm deductible</span></span><span role="cell"><span class="b" style="--f:0.357" aria-hidden="true"></span><span class="v">About $2,600</span></span></div><div role="row"><span role="rowheader"><span class="n">A 5 percent storm deductible</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">the most Fannie Mae allows</span></span><span role="cell"><span class="b" style="--f:0.893" aria-hidden="true"></span><span class="v">About $6,500</span></span></div></div></div><figcaption>Example: a building insured for about $131,000 a unit, the middle rebuild cost for Horry condo buildings of 10 or more units, with the bill split evenly.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A basic condo policy pays only a small set amount toward your share of an association's assessment, unless you buy a higher limit.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Before you close, we put the building's storm deductible, in dollars, next to the loss assessment limit on your HO-6 quote. If the limit is smaller, we ask for a quote with a higher one.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We also ask the insurance agent, in writing, whether the policy pays an assessment that comes from the association's storm deductible. The answer depends on the policy.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">How a deductible is split among owners, and who pays after a leak or a fire, is on our page on <a href="/hoa/who-pays-for-damage/" style="color:var(--navy);text-decoration:underline">who pays for condo damage</a>. When the association bills every owner for it, that bill is a <a href="/hoa/special-assessments/" style="color:var(--navy);text-decoration:underline">special assessment</a>.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How to spot a storm deductible on the policy</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">South Carolina requires any home or building policy with a separate hurricane, named storm or wind deductible to say so in capital letters, on its front and on its declarations page. The rule applies to the association's policy too.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The sentence starts:</p><blockquote class="c3-ins-quote">THIS POLICY CONTAINS A SEPARATE DEDUCTIBLE FOR HURRICANE, NAMED STORM OR WIND/HAIL LOSSES, WHICH MAY RESULT IN HIGH OUT-OF-POCKET EXPENSES TO YOU.</blockquote><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A named storm is a hurricane, tropical storm or tropical depression named by the National Weather Service or the National Hurricane Center. If your HO-6 has a separate storm deductible, the insurer must show you, when you buy it and at each renewal, how it works on a $100,000 policy.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Know your share of a storm bill before you close</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the building. We get its storm deductible and tell you the loss assessment limit that pays your share.</p><a class="btn btn-brass" href="/contact/">Have us compare the deductible to your quote</a></div></div></section><section style="background:var(--ivory-2)" id="flood"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Flood">How does flood insurance work on a Myrtle Beach condo?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Your HO-6 most likely does not cover flood. Most homeowners insurance does not cover flood damage. Flood cover is its own policy.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The building's flood policy does not insure your furniture or belongings either. A flood policy on your own unit can, if you buy contents cover. It can also pay your share of a flood assessment from the association.</p><p class="c3-ins-do"><strong>When to add your own flood policy:</strong> if a flood would leave you replacing what is in the unit. A unit flood policy here cost a middle of about $495 a year.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">The building's flood policy</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The federal flood program sells two flood policies for a condo. One goes to the association for the building, called an RCBAP. The other goes to an owner for a unit.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The building's policies on Horry condos, in FEMA's latest full year:</p><ul class="c3-ins-rules c3-ins-one"><li><strong>Insured close to full value</strong><span>Of the 702 that report a rebuild cost, 701 meet the program's 80 percent rule. A building insured for less than that gets a smaller payment after a flood.</span></li><li><strong>Often at the top limit</strong><span>276 of 1,172 buy $250,000 a unit, the program's top limit.</span></li><li><strong>A small deductible</strong><span>832 of 1,172 carry a $1,250 deductible. Another 105 carry $25,000.</span></li><li><strong>Your share of the cost</strong><span>A middle of about $405 a unit a year, paid through the condo fee. Our page on <a href="/hoa/" style="color:var(--navy);text-decoration:underline">HOA fees</a> shows the rest of the fee.</span></li><li><strong>Contents</strong><span>Only property the owners share or the association owns. 151 of 1,172 buy any.</span></li></ul><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Your own flood policy on a unit</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You can buy your own federal flood policy on your unit, even when the building has one. Half the unit policies here cost between about $370 and $640 a year.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About 3 in 4 of these unit policies were outside FEMA's high-risk flood zones. The two policies together pay at most $250,000 for one unit, and pay for the same damage only once.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A unit flood policy pays your share of a flood assessment from the association, up to its building limit. It does not pay an assessment that comes from the association's own flood deductible.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">That deductible is usually small, as the list above shows.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Flood claims on Horry condo buildings</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Four storms brought the largest flood payments on these buildings' own flood policies:</p><div class="c3-ins-tab c3-ins-num"><table><caption class="sr">Flood claims on Horry County condo buildings' own flood policies, by storm</caption><thead><tr><th scope="col">Storm</th><th scope="col">Building claims</th><th scope="col">Paid</th></tr></thead><tbody><tr><th scope="row">Hurricane Hugo, 1989</th><td><span class="l">Building claims</span>232</td><td><span class="l">Paid</span>About $17.1 million</td></tr><tr><th scope="row">Hurricane Matthew, 2016</th><td><span class="l">Building claims</span>113</td><td><span class="l">Paid</span>About $7.7 million</td></tr><tr><th scope="row">Hurricane Florence, 2018</th><td><span class="l">Building claims</span>39</td><td><span class="l">Paid</span>About $8.4 million</td></tr><tr><th scope="row">Hurricane Ian, 2022</th><td><span class="l">Building claims</span>101</td><td><span class="l">Paid</span>About $8.2 million</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">After Hurricane Ian, unit flood policies made 6 claims. Our page on <a href="/buyers/undisclosed-flooding/" style="color:var(--navy);text-decoration:underline">finding out whether a home has flooded</a> shows what we look up for one building.</p></div></section><section style="background:var(--ivory)" id="before-you-buy"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Before you buy">What should I ask for before I buy a condo, and when?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Get the building's papers first, then have your HO-6 written once, at the right size. Your lender checks that your policy is big enough. The right size comes from what the building's policy leaves out.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Buying a policy before you know means paying to redo it, and that can hold up your closing. We read these papers, in this order:</p><ul class="c3-ins-rules c3-ins-one"><li><strong>The insurance section of the condo's founding papers</strong><span>It says which kind of master policy the building has.</span></li><li><strong>The declarations page of the building's policy</strong><span>It shows the amount insured and every deductible, with any separate one for wind.</span></li><li><strong>The per-unit deductible, if there is one</strong><span>Your lender sizes your HO-6 against it.</span></li><li><strong>The building's flood policy and its deductible</strong><span>Most are $1,250; some are $25,000.</span></li><li><strong>The loss assessment limit on your HO-6 quote</strong><span>It should be enough to pay your share of the storm deductible.</span></li><li><strong>The budget and the reserves</strong><span>Money the building has saved for repairs. Our page on <a href="/hoa/reserves/" style="color:var(--navy);text-decoration:underline">condo reserves</a> explains how much is enough.</span></li><li><strong>The statement of what the seller owes</strong><span>The association's letter on unpaid dues, explained on our page on <a href="/hoa/estoppel-and-transfer-fees/" style="color:var(--navy);text-decoration:underline">what the seller still owes the HOA</a>.</span></li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If you buy with us, we get you an insurance quote for the address before you make an offer. Insurance is a commodity: we recommend the cheapest policy that satisfies you and your lender.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If you will rent the unit out, our page on <a href="/invest/landlord-insurance/" style="color:var(--navy);text-decoration:underline">landlord insurance on a Myrtle Beach rental</a> covers the policy for a rental.</p></div></section><section style="background:var(--ivory-2)" id="master-policy-and-ho-6-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Master policy and HO-6 FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do I need an HO-6 if the HOA has a master policy?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For most conventional loans, yes, when the master policy leaves out any part of the inside of your unit or charges a deductible to each unit. Your belongings are yours to insure under every kind of master policy.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is HO-6 insurance required in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not by state law. South Carolina's condo law requires the association to insure the building and lets each owner insure their own unit. A lender usually requires an HO-6.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How much is HO-6 insurance in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Owners in Horry County pay about $800 a year for their own condo policy. A flood policy on the unit, if you buy one, cost a middle of about $495 a year.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How much loss assessment coverage should I have?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Enough to pay your share of the building's storm deductible. There is no legal minimum, so the number printed on your policy is the number you have. In a typical Horry building of 10 or more units, each owner's even share of a 5 percent storm deductible is about $6,500.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does my HO-6 cover flood?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most likely not. Most homeowners insurance does not cover flood damage, and the building's flood policy does not insure your belongings. A flood policy on your unit can, and here it cost a middle of about $495 a year.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What is an RCBAP?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Residential Condominium Building Association Policy, the federal flood policy a condo association buys on its building. It does not insure owners' furniture or belongings.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.scstatehouse.gov/code/t27c031.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 27-31</a>, <a href="https://www.scstatehouse.gov/code/t38c075.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 38-75</a>, <a href="https://www.scstatehouse.gov/coderegs/Chapter%2069.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Reg. 69-56</a>, <a href="https://doi.sc.gov/1023/Understanding-the-Types-of-Homeowner-Ins" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Department of Insurance</a>, <a href="https://selling-guide.fanniemae.com/sel/b7-3-03/master-property-insurance-requirements-project-developments" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Fannie Mae B7-3-03</a>, <a href="https://selling-guide.fanniemae.com/sel/b7-3-04/individual-property-insurance-requirements-unit-project-development" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Fannie Mae B7-3-04</a>, <a href="https://www.floodsmart.gov/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FEMA FloodSmart</a>, <a href="https://www.ecfr.gov/current/title-44/chapter-I/subchapter-B/part-61" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">44 CFR Part 61</a>, <a href="https://www.fema.gov/openfema-data-page/fima-nfip-redacted-policies-v2" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">OpenFEMA policies</a>, <a href="https://www.fema.gov/openfema-data-page/fima-nfip-redacted-claims-v2" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">OpenFEMA claims</a>, <a href="https://www.irmi.com/term/insurance-definitions/bare-walls-coverage" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">IRMI</a>, <a href="https://www2.census.gov/programs-surveys/acs/data/pums/2024/1-Year/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Census PUMS 2024</a>. Our counts: federal flood policies on Horry condos in FEMA's latest full year, and every Horry condo flood claim. Owners' policy cost: owners living in their condo, Horry County outside the Loris area. Not legal advice.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Roofs, balconies and a pool on oceanfront buildings in North Myrtle Beach, seen from a plane. Photo: U.S. Geological Survey, <a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://doi.org/10.5066/F7N877XX" target="_blank" rel="noopener noreferrer">U.S. Geological Survey</a>. Chapter3 Realty cut 1600 by 700 pixels around the two buildings in the center left of the 3008 by 1960 original, and resized it for the page. The 1x1, 4x3 and 16x9 share crops are cut from the center of the full frame.</div><div role="listitem"></div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-10-d/hoa-special-assessments/north-myrtle-beach-oceanfront-roofs-and-balconies-2011-1200w.webp","url":"https://chapter3realty.com/images/2026-10-d/hoa-special-assessments/north-myrtle-beach-oceanfront-roofs-and-balconies-2011-1200w.webp","width":1200,"height":525,"encodingFormat":"image/webp","name":"Roofs, balconies and a pool on oceanfront buildings in North Myrtle Beach, seen from a plane","caption":"Roofs, balconies and a pool on oceanfront buildings in North Myrtle Beach, seen from a plane. A condo master policy insures parts like these.","description":"Two oceanfront mid-rise buildings in North Myrtle Beach with stacked balconies and railings, a flat roof with rooftop equipment and a pool behind the dunes","creator":{"@type":"Organization","name":"U.S. Geological Survey"},"creditText":"U.S","copyrightNotice":"Public domain (U.S. Geological Survey)","license":"https://www.usa.gov/publicdomain/label/1.0/","acquireLicensePage":"https://doi.org/10.5066/F7N877XX","isBasedOn":"https://doi.org/10.5066/F7N877XX","contentLocation":{"@type":"Place","name":"Windy Hill section, oceanfront, North Myrtle Beach, South Carolina"},"representativeOfPage":true}]}</script></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Buying a condo? Get an insurance quote before you offer.</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">If you buy with us, we get you an insurance quote for the address before you make an offer, and we read the building's insurance papers with you.</p><a class="btn btn-brass btn-lg" href="/contact/">Ask for an insurance quote</a></div></section></main>
