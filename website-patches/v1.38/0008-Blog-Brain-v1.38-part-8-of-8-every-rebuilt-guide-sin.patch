+must(COV.hoa_includes_water_sewer.with_flag === 1068 && COV.hoa_includes_insurance.with_flag === 896 && COV.hoa_includes_internet.with_flag === 974 && COV.hoa_includes_electric.with_flag === 631, "row 16 changed");
