0 var(--c3ph-bleed,1.4rem) .4rem;margin:1.6rem calc(-1*var(--c3ph-bleed,1.4rem)) 0;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding:0 var(--c3ph-bleed,1.4rem);-webkit-overflow-scrolling:touch;scrollbar-width:none}.c3ph-row::-webkit-scrollbar{display:none}.c3ph-row>figure{flex:0 0 82%;scroll-snap-align:start}}.c3ph-swipe{display:flex;align-items:center;gap:.75rem;margin:.5rem 0 1.6rem;color:var(--navy);font:500 .95rem/1.3 var(--sans)}.c3ph-dots{display:inline-flex;gap:.45rem}.c3ph-dots i{display:block;width:10px;height:10px;border-radius:50%;border:1.5px solid var(--navy);box-sizing:border-box}.c3ph-dots i:first-child{background:var(--navy)}@supports (animation-timeline:view()){.c3ph-rowbox{timeline-scope:--c3ph-p1,--c3ph-p2,--c3ph-p3}.c3ph-row>figure:nth-child(1){view-timeline:--c3ph-p1 inline}.c3ph-row>figure:nth-child(2){view-timeline:--c3ph-p2 inline}.c3ph-row>figure:nth-child(3){view-timeline:--c3ph-p3 inline}.c3ph-dots i{animation:c3ph-dot linear both;animation-range:cover}.c3ph-dots i:nth-child(1){animation-timeline:--c3ph-p1}.c3ph-dots i:nth-child(2){animation-timeline:--c3ph-p2}.c3ph-dots i:nth-child(3){animation-timeline:--c3ph-p3}@keyframes c3ph-dot{0%,36%{background:transparent}42%,60%{background:var(--navy)}66%,100%{background:transparent}}}@media (min-width:700px){.c3ph-swipe{display:none}}.c3ph-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:1.4rem 0 1.8rem;padding:0;list-style:none}@media (min-width:700px){.c3ph-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}}@media (min-width:1000px){.c3ph-cards.c3ph-4{grid-template-columns:repeat(4,minmax(0,1fr))}}.c3ph-card{margin:0;background:var(--ivory);border:1px solid var(--rule);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}.c3ph-card .c3ph-f{border-radius:0}.c3ph-card img,.c3ph-card svg{display:block;width:100%;height:auto;aspect-ratio:var(--c3ph-r,4/3);object-fit:cover}.c3ph-card .c3ph-cr{font-size:.56rem;padding:1.2rem .45rem .25rem 1.6rem}.c3ph-card strong{display:block;color:var(--navy);font-size:.98rem;font-weight:500;line-height:1.3;padding:.7rem .8rem 0}.c3ph-card span.c3ph-t{display:block;color:var(--muted);font-size:.86rem;line-height:1.45;padding:.2rem .8rem .85rem}.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:760px}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our agents check five things. Each card says what that check can miss.</p><ol class="c3-uf-steps" aria-label="The five checks we run on a house's flood history"><li><span class="k">Ask the seller for the claim records</span><span class="c3-uf-tag own"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span>From the seller</span><p>The Federal Emergency Management Agency (FEMA) runs federal flood insurance. It will not give a buyer a house's flood insurance claims: <a href="https://agents.floodsmart.gov/flood-maps-and-data/faqs-about-nfip-data" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">federal privacy law bars it</a> without the owner's consent.</p><p>We ask the seller for those, and for the insurance industry's <a href="https://www.tn.gov/commerce/insurance/consumer-resources/clue.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">claims report on the house</a>, called CLUE.</p><p class="miss"><b>What it misses:</b> A flood on a house that had no flood insurance.</p></li><li><span class="k">Put the house on two flood maps</span><span class="c3-uf-tag"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>Public maps: we pull them</span><p>FEMA's flood map is a forecast of risk. After Florence, Horry County <a href="https://psds.wcu.edu/projects-and-research/municipalprojects/horry-county-flood-mapping-2/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">mapped how far Florence's water went</a>.</p><p>We put the house on both maps. <a href="#florence-map" style="color:var(--navy);text-decoration:underline">Our map of the two</a> shows where they differ.</p><p class="miss"><b>What it misses:</b> Whether water got inside. The county's map shows the ground Florence's water covered, in that one storm.</p></li><li><span class="k">Ask the county's floodplain staff</span><span class="c3-uf-tag"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>We ask the county</span><p>Horry County's <a href="https://horrycountysc.gov/media/kw5fxufi/flood-news-flyer-with-ppa-feb-2026.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">floodplain staff</a> answer "Has my property ever flooded?" and keep the county's flood history, including where floods have repeated. The county also posts the <a href="https://horrycountysc.gov/departments/emergency-management/flooding/elevation-certificates/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">signed surveys</a> it has on file that show how high a floor is.</p><p class="miss"><b>What it misses:</b> A house inside a city. Each city keeps its own records, and we ask that city.</p></li><li><span class="k">Look for a permit behind every repair</span><span class="c3-uf-tag"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>We ask the county or city</span><p>Outside city limits in Horry County, <a href="https://horrycountysc.gov/departments/emergency-management/flooding/build-responsibly/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">any work on a building over $500</a> needs a permit. Inside a city, the city issues it. A flood repair done legally leaves a <a href="/buyers/common-mistakes/" style="color:var(--navy);text-decoration:underline">permit record</a>.</p><p class="miss"><b>What it misses:</b> Work done with no permit. A repair with no record is a question we put to the seller.</p></li><li><span class="k">Read the house and the street</span><span class="c3-uf-tag"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>At the showing</span><p>We use the county's <a href="https://horrycountysc.gov/departments/emergency-management/flooding/prepare-for-a-flood-hazard/know-your-flood-hazard/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">questions about water around a house</a>. We look at whether water flows away from the house or stands next to the walls, whether the ditch or storm drain is clear, and whether the downspouts carry water well away.</p><p>On the street, a house raised above its older neighbors can be one that flooded and was rebuilt. <a href="#empty-lots" style="color:var(--navy);text-decoration:underline">Empty lots between houses</a> can be a flood buyout.</p><p class="miss"><b>What it misses:</b> Proof. These are clues, and the records above confirm or rule them out.</p></li></ol><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What if the seller will not send the records?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If the seller refuses, or does not answer, we tell you right away. You decide with what the maps, the county and the house showed: offer, offer less, or walk away.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I back out if I find a flood after I sign?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, inside the due diligence period on the South Carolina REALTORS sales contract. In that period the buyer <a href="https://rosenhagood.com/sc-residential-property-agreements-transitions-to-due-diligence-only-model/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">can end the contract</a> with a written notice of termination to the seller. We tell you what ending it would cost under the contract you sign, before you sign it. That is why we run these checks first.</p></div></section><section style="background:var(--ivory)" id="seller-disclosure"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What the seller must disclose">Does a seller have to disclose flooding in South Carolina?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, on the state's disclosure form, but only for the years the seller owned the house. <a href="https://www.scstatehouse.gov/code/t27c050.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">South Carolina law</a> requires the form for a home with one to four units. The seller hands it over before you sign the contract, unless the contract says otherwise. Our guide to <a href="/sell/seller-disclosure/" style="color:var(--navy);text-decoration:underline">the seller disclosure form</a> lists every question on it.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="https://llr.sc.gov/re/recpdf/Property-Condition-Disclosure-Statement-06.2025.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">The form</a> asks about floods, flood insurance claims, flood repairs and federal flood aid, each only for the seller's years. One question asks about any flood risk the seller knows of.</p><figure class="c3-uf-years" role="group" aria-label="For about 3 in 4 resale houses for sale in Horry County, Florence came before the seller bought, in the years the form does not ask about"><span class="cap">For about 3 in 4 resale houses for sale here, Florence came before the seller bought</span><div class="c3-uf-bar"><div class="before"><b>Before the seller bought</b>The form does not ask.<br/><span class="c3-uf-pin"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8.5h10.5a3 3 0 1 0-3-3M3 12.5h15a3 3 0 1 1-3 3M3 16.5h6"/></svg></span>Florence, 2018, is here</span></div><div class="mine"><b>The seller's years</b>The form asks about floods, claims, repairs and federal flood aid.</div></div><div class="c3-uf-ends" aria-hidden="true"><span>↑ House built</span><span><span>↑ Seller buys</span><span>Your offer ↑</span></span></div><figcaption>Resale houses for sale (not new builds) that we could match to a county parcel. Our count, from Horry County's parcel records and homes for sale counted in aggregate.</figcaption></figure><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What does "No Representation" mean?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">It is an answer on the form. A seller may choose it only when they do not have the knowledge to answer. The form says a seller may not choose it to avoid a question, must still disclose what they know, and is not freed from liability by it.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Which sales need no disclosure form?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Some sales need no form at all. Among them are estate and trust sales, foreclosure sales, public auctions, the first sale of a <a href="/buyers/new-construction/" style="color:var(--navy);text-decoration:underline">new home no one has lived in</a>, and a sale where both sides agree in writing to skip it. In those sales, the five checks matter more.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Get the flood claim records a buyer cannot get alone</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We ask the seller for the house's flood claim reports and tell you right away if they refuse.</p><a class="btn btn-brass" href="/contact/">Have us ask the seller</a></div></div></section><section style="background:var(--ivory-2)" id="outside-the-zone"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Outside the flood zone">Can a house flood if it is not in a flood zone?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, and in Horry County it happens most in rain and river floods. Since 1978, nearly 1 in 4 paid flood insurance claims here were on buildings insured as outside FEMA's high-risk zone. That means the policy was priced for a lower-risk zone.</p><figure class="c3-uf-chart"><div role="table" aria-label="Share of paid flood claims in Horry County on buildings outside FEMA's high-risk zone, by storm"><span class="cap" aria-hidden="true">Paid flood claims in Horry County insured as outside FEMA's high-risk zone, by storm</span><div class="c3-uf-grp" role="rowgroup"><div class="gh" aria-hidden="true"><i style="background:#7d8b97"></i>Storm surge on the beach</div><div class="c3-uf-row" role="row"><span role="rowheader">Isaias<small>2020</small></span><span class="bar" role="cell" aria-hidden="true"><i style="width:1.6%;background:#7d8b97"></i></span><em role="cell">2%</em></div><div class="c3-uf-row" role="row"><span role="rowheader">Ian<small>2022</small></span><span class="bar" role="cell" aria-hidden="true"><i style="width:5.5%;background:#7d8b97"></i></span><em role="cell">5%</em></div><div class="c3-uf-row" role="row"><span role="rowheader">Hugo<small>1989</small></span><span class="bar" role="cell" aria-hidden="true"><i style="width:8.9%;background:#7d8b97"></i></span><em role="cell">9%</em></div></div><div class="c3-uf-grp" role="rowgroup"><div class="gh" aria-hidden="true"><i style="background:#a68a6c"></i>Surge and river</div><div class="c3-uf-row" role="row"><span role="rowheader">Matthew<small>2016</small></span><span class="bar" role="cell" aria-hidden="true"><i style="width:19.8%;background:#a68a6c"></i></span><em role="cell">20%</em></div></div><div class="c3-uf-grp" role="rowgroup"><div class="gh" aria-hidden="true"><i style="background:#c4783a"></i>Rain and river floods</div><div class="c3-uf-row" role="row"><span role="rowheader">Floyd<small>1999</small></span><span class="bar" role="cell" aria-hidden="true"><i style="width:36.7%;background:#c4783a"></i></span><em role="cell">37%</em></div><div class="c3-uf-row" role="row"><span role="rowheader">Florence<small>2018</small></span><span class="bar" role="cell" aria-hidden="true"><i style="width:45.3%;background:#c4783a"></i></span><em role="cell">45%</em></div><div class="c3-uf-row" role="row"><span role="rowheader">The October rains<small>2015</small></span><span class="bar" role="cell" aria-hidden="true"><i style="width:50.6%;background:#c4783a"></i></span><em role="cell">51%</em></div></div></div><figcaption>Each bar is the share of that storm's paid flood claims, out of 100 percent, on buildings insured as outside FEMA's high-risk zone. Storms are grouped by their main cause of flooding in FEMA's records.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In storm surge, almost every paid claim here was inside FEMA's high-risk zone. In rain and river floods, far more were outside it.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What Florence did</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">During Hurricane Florence in 2018, the Waccamaw River at Conway rose to a <a href="https://www.weather.gov/ilm/HurricaneFlorence" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">record crest</a>, more than three feet above the old record from <a href="/buyers/relocating/hurricanes/" style="color:var(--navy);text-decoration:underline">Hurricane Matthew in 2016</a>. Nearly 1,000 homes and businesses near the river flooded, many of them badly.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-10-d/buyers-undisclosed-flooding/conway-florence-floodwater-street-1200w.webp" srcset="/images/2026-10-d/buyers-undisclosed-flooding/conway-florence-floodwater-street-600w.webp 600w, /images/2026-10-d/buyers-undisclosed-flooding/conway-florence-floodwater-street-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="844" alt="Floodwater covering a residential street and the yards of single-story houses, with road signs standing in the water, in the Conway area after Hurricane Florence" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://commons.wikimedia.org/wiki/Template:PD-USGov-Military-National_Guard" target="_blank" rel="noopener noreferrer" aria-label="Photo: SC National Guard. License: Public domain" title="License: Public domain">Photo: SC National Guard</a></span></div><figcaption>Floodwater on a street of houses in the Conway area after Florence.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Polo Farms, off SC 905, had five feet of water in homes. Aberdeen Country Club in Longs and Bradford Creek off SC 544 had up to three feet. Silver Fox Landing near the <a href="/buyers/waterfront-homes/" style="color:var(--navy);text-decoration:underline">Intracoastal Waterway</a> had up to eight.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">FEMA's current flood map took effect about three years after Florence. Our map puts it beside the land Florence's water covered.</p><figure class="c3-uf-map" id="florence-map" style="margin:1.6rem 0 1.8rem;max-width:560px"><img src="/images/2026-10-d/buyers-undisclosed-flooding/florence-flood-map.svg" width="440" height="486" loading="lazy" decoding="async" alt="Map of Horry County. FEMA's high-risk flood zone runs along the rivers and the coast. Florence's flood water covered most of it along the Waccamaw and Little Pee Dee rivers, and spread outside it in many places between Loris, Longs, Conway and Socastee."><ul class="c3-uf-key" aria-hidden="true"><li><i style="background:#cfe0ea"></i>FEMA's current high-risk flood zone</li><li><i style="background:#4f7f9f"></i>Land Florence's water covered (the county's map)</li><li><i style="background:#c4783a"></i>Land Florence flooded outside FEMA's zone</li></ul><figcaption style="color:var(--muted);font-size:.95rem;line-height:1.55;margin-top:.6rem">Orange marks land Florence's water covered that FEMA's current map does not call high risk. Map: Chapter3 Realty, from Horry County's flood map layers and the Census Bureau's coastline.</figcaption></figure><ul class="c3-uf-tiles" role="list" aria-label="Houses and homes for sale on land Florence flooded"><li><b>About 400</b><span>houses stand on the orange land, away from its thin edges: flooded in Florence, and not high risk on FEMA's map.</span></li><li><b>More than 2,000</b><span>houses stand on land Florence's water covered. The map shows where water covered the ground, not which houses took water inside.</span></li><li><b>Nearly 90</b><span>homes for sale in Horry County stand on land Florence's water covered.</span></li></ul><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Did Florence's water cover the land under a house you like?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the address. We put it on FEMA's map and the county's Florence map and tell you what each shows. It is free, with no obligation.</p><a class="btn btn-brass" href="/contact/">Send us the address</a></div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does a clean claim history mean the house never flooded?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. A house with no flood insurance leaves no flood claim. Horry County has about one <a href="/buyers/coastal-insurance/" style="color:var(--navy);text-decoration:underline">federal flood policy</a> for every seven residential buildings, so most houses here have no federal flood policy to claim on.</p></div></section><section style="background:var(--ivory)" id="buy-one-that-flooded"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Buying one that flooded">Should you buy a house that flooded?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Buy a house that flooded only when three things are true. Our agents check each one.</p><ul class="c3-uf-three" role="list" aria-label="Three things to know before buying a house that flooded"><li><span class="hd"><span class="c3-uf-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span>It was repaired with permits</span><p>Each flood repair has its permit on file, as in check 4.</p><p class="we">We match each repair to its permit record.</p></li><li><span class="hd"><span class="c3-uf-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 11.5 12 4.5l8 7M6.5 10v4.5M17.5 10v4.5M2 17c1.7 1.2 3.3 1.2 5 0s3.3-1.2 5 0 3.3 1.2 5 0 3.3-1.2 5 0M2 20.5c1.7 1.2 3.3 1.2 5 0s3.3-1.2 5 0 3.3 1.2 5 0 3.3-1.2 5 0"/></svg></span>It is raised, or its risk is known</span><p>If repairs after a flood cost 50 percent or more of the house's value before it, the house must be <a href="https://horrycountysc.gov/departments/emergency-management/flooding/build-responsibly/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">raised above the flood height on FEMA's map</a>.</p><p class="we">We pull the survey of how high its floor sits.</p></li><li><span class="hd"><span class="c3-uf-ic" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 9.4c-.4-1-1.5-1.8-3-1.8-1.8 0-3 1-3 2.2 0 3 6 1.6 6 4.4 0 1.3-1.3 2.2-3 2.2-1.6 0-2.7-.7-3.1-1.8M12 5.8v1.8M12 16.4v1.8"/><circle cx="12" cy="12" r="9"/></svg></span>You know the flood insurance cost</span><p>A house's federal flood claims <a href="https://agents.floodsmart.gov/sites/default/files/bulletins/W-23001/w-23001.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">stay with the address</a>, not the owner, and its claim history can raise the cost of its flood insurance.</p><p class="we">We help you get a flood insurance quote on the house.</p></li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A house outside the high-risk zone can still be a repeat-flood house: nearly 1 in 5 Horry County properties on FEMA's list of repeat flood claims are outside it. The worst, which FEMA calls <a href="https://agents.floodsmart.gov/sites/default/files/media/document/2025-07/fema-nfip-policyholders-guide-severe-repetitive-loss_brochure-07-2023.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">severe repetitive loss</a>, pay at least 15 percent more for federal flood insurance.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A seller who took federal flood aid that required flood insurance must tell you in writing, in the sale papers, that you must keep flood insurance on the house. <a href="https://www.law.cornell.edu/uscode/text/42/5154a" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Federal law</a> requires it.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem"><span id="empty-lots">Why does a street have empty lots between houses?</span></h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Sometimes because of a flood buyout. The <a href="https://scor.sc.gov/news/2024-06/horry-county-buyout-program-begins-demolition" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">state's voluntary buyout program</a> has bought dozens of homes in the Socastee area that flooded again and again. It tears the houses down, and the land stays open green space.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">When a house you like sits beside empty lots, we ask the county's floodplain staff about the street's flood history.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Empty lots beside a house you like?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the address, and we ask the county's floodplain staff about floods on that street.</p><a class="btn btn-brass" href="/contact/">Ask us to check the street</a></div></div></section><section style="background:var(--ivory-2)" id="if-the-seller-hid-it"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="If the seller hid it">What if the seller did not disclose flooding?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A seller who knowingly gives false, incomplete or misleading answers on the form <a href="https://www.scstatehouse.gov/code/t27c050.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">is liable</a> for the buyer's actual damages from them, and court costs. The court may also award reasonable attorney fees to whichever side wins.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Your own <a href="https://www.scstatehouse.gov/code/t40c057.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">buyer's agent</a>, under a written agreement, must tell you every serious problem the agent knows of. A fact that significantly lowers the value or the soundness of the house counts.</p><style>.c3-cc{margin:1.4rem 0 1.8rem;max-width:960px}.c3-cc table{width:100%;border-collapse:collapse;font-size:var(--read,1.0625rem);line-height:1.45;color:var(--muted)}.c3-cc caption{caption-side:top;text-align:left;color:var(--navy);font-weight:600;font-size:1em;line-height:1.4;padding:0 0 .7rem}.c3-cc th,.c3-cc td{padding:.6rem .7rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule);overflow-wrap:break-word}.c3-cc thead th{color:var(--navy);font-weight:600;font-size:1em;border-bottom:2px solid var(--navy);vertical-align:bottom}.c3-cc tbody th{color:var(--navy);font-weight:600}.c3-cc .n{text-align:right;font-variant-numeric:tabular-nums}.c3-cc .i{display:inline-flex;vertical-align:-4px;margin-right:.45rem;color:var(--brass-ink)}.c3-cc tr.c3-self>*{background:#fff}@media (max-width:39.999em){.c3-cc table,.c3-cc tbody,.c3-cc tr,.c3-cc th,.c3-cc td{display:block;width:auto}.c3-cc caption{display:block}.c3-cc thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.c3-cc tbody tr{background:var(--ivory-2);border-top:3px solid var(--brass);margin:0 0 .8rem;padding:.5rem 0 .6rem}section[style*="background:var(--ivory-2)"] .c3-cc tbody tr{background:var(--ivory)}.c3-cc tr.c3-self{background:#fff!important;border:2px solid var(--brass)}.c3-cc tr.c3-self>*{background:transparent}.c3-cc th,.c3-cc td{border:0;padding:.2rem 1rem}.c3-cc tbody th{display:flex;align-items:center;font-size:1.1em;padding-bottom:.35rem}.c3-cc tbody th .i{flex:none;vertical-align:0}.c3-cc tbody th a{display:inline-block;padding:.5rem 0}.c3-cc .n{text-align:left}.c3-cc td[data-label]::before{content:attr(data-label) ": ";color:var(--navy);font-weight:500}}</style><div class="c3-cc"><table><caption>Where a complaint about a flood no one told you about goes</caption><thead><tr><th scope="col">The problem</th><th scope="col">Who handles it</th></tr></thead><tbody><tr><th scope="row">A seller who knew and did not tell you</th><td data-label="Who handles it">A South Carolina real estate attorney</td></tr><tr><th scope="row">An agent who knew and did not tell you</th><td data-label="Who handles it">Real Estate Commission and an attorney</td></tr><tr><th scope="row">A dispute over the sales contract</th><td data-label="Who handles it">An attorney, not the Commission</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The <a href="https://llr.sc.gov/re/complaint.aspx" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Real Estate Commission</a> takes complaints against licensed agents, not private sellers, and it does not handle contract disputes. Claims like these have <a href="https://www.scstatehouse.gov/code/t15c003.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">deadlines in South Carolina law</a>. Many are three years, and for fraud the time starts when the fraud is discovered.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If you already bought a house that flooded and the seller hid it, talk to a South Carolina real estate attorney. We work with several attorneys here and can introduce you. Chapter3 Realty does not give legal advice.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How a flood check can change an offer</h3><div class="c3-story" style="background:var(--ivory);border-top:3px solid var(--brass);padding:1.5rem 1.5rem .7rem;margin:1.4rem 0 1.4rem;max-width:720px"><p style="color:var(--muted);line-height:1.75;max-width:640px;margin:0 0 .9rem"><strong>Example:</strong> A buyer likes a house near the Waccamaw River. The seller bought after Florence and answers No to every flood question on the form.</p><p style="color:var(--muted);line-height:1.75;max-width:640px;margin:0 0 .9rem">A Chapter3 agent puts the lot on the county's Florence flood map. Florence's water covered the yard. The agent asks for the house's FEMA claim records, and the seller will not send them.</p><p style="color:var(--muted);line-height:1.75;max-width:640px;margin:0 0 .9rem">The buyer walks away and offers on a house a mile off, on land the water did not cover.</p></div><p style="color:var(--navy);font-weight:500;font-size:var(--read,1rem);line-height:1.6;max-width:34em;margin-bottom:1rem">The form never asked about that flood. The county's map showed it.</p></div></section><section style="background:var(--ivory)" id="flood-history-questions"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Flood history questions</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I get a CLUE report on a house I want to buy?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. Only the owner, an insurer or a lender can order the CLUE report on a house, and it covers only recent years. We ask the seller to order it.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I see FEMA flood claims by address?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not until you own the house. Once you do, you can ask FEMA for its claims, including those from before you owned it.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What is a severe repetitive loss property?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Severe repetitive loss is FEMA's label for a house that has flooded again and again. FEMA uses it for four or more paid flood claims over $5,000 each, or for building payments that add up to more than the house is worth, with two of them within 10 years of each other. The label stays with the address when the house sells.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Will the lender tell me if the house is in a flood zone?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, if the house is in FEMA's high-risk zone and the loan is from a bank or other federally regulated lender. The lender must make sure you are told in writing a reasonable time before you sign. The notice is about the zone, not about past floods.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.scstatehouse.gov/code/t27c050.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 27-50</a>, <a href="https://llr.sc.gov/re/recpdf/Property-Condition-Disclosure-Statement-06.2025.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC disclosure form</a>, <a href="https://agents.floodsmart.gov/flood-maps-and-data/faqs-about-nfip-data" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">FEMA NFIP data FAQ</a>, <a href="https://www.fema.gov/openfema-data-page/fima-nfip-redacted-claims-v2" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">OpenFEMA NFIP claims</a>, <a href="https://psds.wcu.edu/projects-and-research/municipalprojects/horry-county-flood-mapping-2/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County flood mapping</a>, <a href="https://horrycountysc.gov/departments/emergency-management/flooding/build-responsibly/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County Build Responsibly</a>, <a href="https://www.weather.gov/ilm/HurricaneFlorence" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NWS Hurricane Florence</a>, <a href="https://scor.sc.gov/news/2024-06/horry-county-buyout-program-begins-demolition" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Office of Resilience</a>, <a href="https://www.scstatehouse.gov/code/t40c057.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 40-57</a>, <a href="https://rosenhagood.com/sc-residential-property-agreements-transitions-to-due-diligence-only-model/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Rosen Hagood: SC due diligence contract</a>, <a href="https://www.tn.gov/commerce/insurance/consumer-resources/clue.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Tennessee Insurance: CLUE reports</a>. Claim shares: Chapter3's count of FEMA claims for Horry County. Map and house counts: Chapter3, from Horry County GIS. Homes for sale counted in aggregate from CCMLS listings. Not legal advice.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Floodwater on a street of houses in the Conway area after Florence. Photo: Senior Master Sgt. Edward Snyder, 169th Fighter Wing, South Carolina National Guard, <a href="https://commons.wikimedia.org/wiki/Template:PD-USGov-Military-National_Guard" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://commons.wikimedia.org/wiki/File:Hurricane_Florence_-_South_Carolina_National_Guard_Responds_(44200296354).jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>. Chapter3 Realty cropped the left edge to hide a mailbox number.</div><div role="listitem">Chapter3 Realty resized these photos and cropped some of them.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-10-d/buyers-undisclosed-flooding/conway-florence-floodwater-street-1200w.webp","url":"https://chapter3realty.com/images/2026-10-d/buyers-undisclosed-flooding/conway-florence-floodwater-street-1200w.webp","width":1200,"height":844,"encodingFormat":"image/webp","name":"Floodwater on a street of houses in the Conway area after Florence","caption":"Floodwater on a street of houses in the Conway area after Florence.","description":"Floodwater covering a residential street and the yards of single-story houses, with road signs standing in the water, in the Conway area after Hurricane Florence","creator":{"@type":"Person","name":"Senior Master Sgt. Edward Snyder, 169th Fighter Wing, South Carolina National Guard"},"creditText":"South Carolina National Guard (Senior Master Sgt","copyrightNotice":"Public domain (Senior Master Sgt. Edward Snyder, 169th Fighter Wing, South Carolina National Guard)","license":"https://commons.wikimedia.org/wiki/Template:PD-USGov-Military-National_Guard","acquireLicensePage":"https://commons.wikimedia.org/wiki/File:Hurricane_Florence_-_South_Carolina_National_Guard_Responds_(44200296354).jpg","isBasedOn":"https://commons.wikimedia.org/wiki/File:Hurricane_Florence_-_South_Carolina_National_Guard_Responds_(44200296354).jpg","contentLocation":{"@type":"Place","name":"Conway area, South Carolina (the source does not name the street), Conway, South Carolina"},"representativeOfPage":true}]}</script></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Have us check a house's flood history before you offer</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">We put it on FEMA's map and the county's Florence map, check the permits and the county's flood records, and ask the seller for the two claim reports a buyer cannot get. It is free, with no obligation.</p><a class="btn btn-brass btn-lg" href="/contact/">Send us the address</a></div></section></main>
