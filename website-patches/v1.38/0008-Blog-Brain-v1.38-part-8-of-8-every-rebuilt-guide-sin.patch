y)}@supports (animation-timeline:view()){.c3ph-rowbox{timeline-scope:--c3ph-p1,--c3ph-p2,--c3ph-p3}.c3ph-row>figure:nth-child(1){view-timeline:--c3ph-p1 inline}.c3ph-row>figure:nth-child(2){view-timeline:--c3ph-p2 inline}.c3ph-row>figure:nth-child(3){view-timeline:--c3ph-p3 inline}.c3ph-dots i{animation:c3ph-dot linear both;animation-range:cover}.c3ph-dots i:nth-child(1){animation-timeline:--c3ph-p1}.c3ph-dots i:nth-child(2){animation-timeline:--c3ph-p2}.c3ph-dots i:nth-child(3){animation-timeline:--c3ph-p3}@keyframes c3ph-dot{0%,36%{background:transparent}42%,60%{background:var(--navy)}66%,100%{background:transparent}}}@media (min-width:700px){.c3ph-swipe{display:none}}.c3ph-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:1.4rem 0 1.8rem;padding:0;list-style:none}@media (min-width:700px){.c3ph-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}}@media (min-width:1000px){.c3ph-cards.c3ph-4{grid-template-columns:repeat(4,minmax(0,1fr))}}.c3ph-card{margin:0;background:var(--ivory);border:1px solid var(--rule);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}.c3ph-card .c3ph-f{border-radius:0}.c3ph-card img,.c3ph-card svg{display:block;width:100%;height:auto;aspect-ratio:var(--c3ph-r,4/3);object-fit:cover}.c3ph-card .c3ph-cr{font-size:.56rem;padding:1.2rem .45rem .25rem 1.6rem}.c3ph-card strong{display:block;color:var(--navy);font-size:.98rem;font-weight:500;line-height:1.3;padding:.7rem .8rem 0}.c3ph-card span.c3ph-t{display:block;color:var(--muted);font-size:.86rem;line-height:1.45;padding:.2rem .8rem .85rem}.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:620px}</style><style>main#main .hx-strip:empty{display:none}main#main .hx-strip:not(:empty)+.hx-fallback{display:none}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For golf, anyone who lives or owns a home in Horry County can buy the <a href="https://www.myrtlebeachgolfpassport.com/memberships/annual-membership/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Myrtle Beach Golf Passport</a>, $72 a year, for member rates at the courses that take it. The city's own course, <a href="https://www.cityofmyrtlebeach.com/i_want_to/find/whispering_pines_golf_course.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Whispering Pines</a>, charges county residents $45 a round with a cart, plus tax.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the off season, nothing closes except the tourist attractions and the water parks. The boardwalk stays open, sometimes with shorter hours. Each 55+ community below has its own clubhouse and pool, and three of them have a lifestyle director or a club calendar.</p><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/55-plus/del-webb-grande-dunes/myrtle-beach-beach-from-above-1200w.webp" srcset="/images/55-plus/del-webb-grande-dunes/myrtle-beach-beach-from-above-600w.webp 600w, /images/55-plus/del-webb-grande-dunes/myrtle-beach-beach-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="The wide sand beach, the dunes and the ocean in Myrtle Beach, seen from a high floor" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: 28bytes. License: CC BY-SA 4.0" title="License: CC BY-SA 4.0">Photo: 28bytes</a></span></div><figcaption>The beach and the dunes in Myrtle Beach, with few people on the sand, seen from a high floor.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Family can fly straight here. The <a href="https://www.flymyrtlebeach.com/flight-information/route-map/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Myrtle Beach airport's route map</a> lists nonstop flights to more than 50 cities on ten airlines, among them New York LaGuardia, Newark, Philadelphia, Pittsburgh, Cleveland and Charlotte. The airport is 20 to 35 minutes by car from the four 55+ communities. Plan on a car: most daily life here is built around driving.</p></div></section><section style="background:var(--ivory-2)" id="communities"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="55+ communities">Which 55+ communities near Myrtle Beach should you see?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We have a full guide to each of these four 55+ communities.</p><h3 id="myrtle-trace" style="font-family:var(--serif);font-size:1.35rem;color:var(--navy);margin:2.2rem 0 .7rem;line-height:1.3">1. Myrtle Trace</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Myrtle Trace, just outside Conway, has a calendar of about 70 events and club meetings a month. Its activities committee runs a coffee klatch, a dining-out group and meals for neighbors who cannot get out, and the calendar has had a Labor Day picnic and a craft fair. Owners share a clubhouse, a pool and ponds where they can fish.</p><div class="hx-strip" data-place="myrtle-trace-55" data-name="Myrtle Trace" data-head="For sale now in Myrtle Trace"></div><div class="hx-fallback"><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/55-plus/myrtle-trace/conway-main-street-1200w.webp" srcset="/images/55-plus/myrtle-trace/conway-main-street-600w.webp 600w, /images/55-plus/myrtle-trace/conway-main-street-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="Main Street in downtown Conway, South Carolina, lined with old brick shop buildings" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/publicdomain/mark/1.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: Pubdog. License: Public domain" title="License: Public domain">Photo: Pubdog</a></span></div><figcaption>Main Street in downtown Conway, about 10 minutes from Myrtle Trace by car.</figcaption></figure></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Conway Medical Center is about 3 minutes away by car, downtown Conway about 10 and the beach about 15. Myrtle Trace is outside every hurricane evacuation zone, and outside the city limits, so there is no city tax.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Homes here usually sell for about $300,000, the least of the four. The HOA fee is $95 a month. Nearly 9 in 10 homes are taxed as someone's full-time home. At least one person in each home must be 55 or older, and the HOA's rules set no minimum age for anyone else. Read our <a href="/buyers/55-plus-communities/myrtle-trace/" style="color:var(--navy);text-decoration:underline">Myrtle Trace guide</a>.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Myrtle%20Trace">Get the homes for sale in Myrtle Trace<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p><h3 id="seasons-at-prince-creek-west" style="font-family:var(--serif);font-size:1.35rem;color:var(--navy);margin:2.2rem 0 .7rem;line-height:1.3">2. Seasons at Prince Creek West</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Seasons at Prince Creek West, near Murrells Inlet, has a clubhouse with an indoor pool, an outdoor pool and a fitness center, plus tennis and bocce. Publix is about 5 minutes away by car, and the Murrells Inlet MarshWalk about 10.</p><div class="hx-strip" data-place="prince-creek-55" data-name="Seasons at Prince Creek West" data-head="For sale now in Seasons at Prince Creek West"></div><div class="hx-fallback"><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/55-plus/seasons-at-prince-creek-west/murrells-inlet-boats-1200w.webp" srcset="/images/55-plus/seasons-at-prince-creek-west/murrells-inlet-boats-600w.webp 600w, /images/55-plus/seasons-at-prince-creek-west/murrells-inlet-boats-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="759" alt="White fishing boats tied up at a marina on calm water in Murrells Inlet, South Carolina" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: Pollinator. License: CC BY-SA 3.0" title="License: CC BY-SA 3.0">Photo: Pollinator</a></span></div><figcaption>Fishing boats at a marina in Murrells Inlet.</figcaption></figure></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Tidelands Waccamaw Community Hospital is about 8 minutes away, and the beach at Garden City about 13. Seasons is the one of the four inside a hurricane evacuation zone: every home is in Zone C.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Homes here usually sell for about $500,000. The HOA fee, about $340 a month, includes internet, weekly trash pickup and lawn care. More than 9 in 10 homes are taxed as someone's full-time home, the most of the four. The 55+ resident must live there at least six months a year. No one under 18 may live there, and a visitor under 18 may stay up to 60 days a year. Read our <a href="/buyers/55-plus-communities/seasons-at-prince-creek-west/" style="color:var(--navy);text-decoration:underline">Seasons guide</a>.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Seasons%20at%20Prince%20Creek%20West">Get the homes for sale in Seasons at Prince Creek West<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p><h3 id="del-webb-grande-dunes" style="font-family:var(--serif);font-size:1.35rem;color:var(--navy);margin:2.2rem 0 .7rem;line-height:1.3">3. Del Webb at Grande Dunes</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Del Webb at Grande Dunes, in Myrtle Beach beside the Intracoastal Waterway, is the one with a beach club in the HOA fee. Each household gets a membership in the Grande Dunes Ocean Club, with a pool and private beach access, about 8 minutes away by car. The club runs groups such as Mexican Train and mahjong, holiday events and wine tastings.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">At home, the clubhouse has indoor and outdoor pools, a fitness center, an arts and crafts room and courts for tennis, pickleball and bocce, and staff are there every day.</p><div class="hx-strip" data-place="del-webb-grande-dunes-55" data-name="Del Webb at Grande Dunes" data-head="For sale now in Del Webb at Grande Dunes"></div><div class="hx-fallback"><div class="c3-aerial c3-aerial-close"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/55-plus/del-webb-grande-dunes/del-webb-grande-dunes-clubhouse-from-above-1200w.webp" srcset="/images/55-plus/del-webb-grande-dunes/del-webb-grande-dunes-clubhouse-from-above-600w.webp 600w, /images/55-plus/del-webb-grande-dunes/del-webb-grande-dunes-clubhouse-from-above-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="900" alt="The Del Webb at Grande Dunes clubhouse from above, with its large outdoor pool, parking, courts and a pond beside it, and the entrance marked" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo. License: Public domain" title="License: Public domain">U.S. government aerial photo</a></span></div><figcaption>The Del Webb at Grande Dunes clubhouse from above, with its outdoor pool and the courts beside it.</figcaption></figure></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Grand Strand Medical Center is about 6 minutes away, and the nearest beach access about 4. Del Webb at Grande Dunes is outside every hurricane evacuation zone. It is inside the Myrtle Beach city limits.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Houses here usually sell for about $665,000, and villas for about $430,000. With the city's tax added, a house at that price that is your home pays about $2,700 a year, before the $50,000 exemption at 65.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The HOA fee is about $400 a month for a house and about $445 for a villa. More than 8 in 10 homes are taxed as someone's full-time home. Every lived-in home needs one resident 55 or older, and a visitor under 19 may stay overnight up to 90 days in any 12 months. Read our <a href="/buyers/55-plus-communities/del-webb-grande-dunes/" style="color:var(--navy);text-decoration:underline">Grande Dunes guide</a>.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Del%20Webb%20at%20Grande%20Dunes">Get the homes for sale in Del Webb at Grande Dunes<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p><h3 id="del-webb-north-myrtle-beach" style="font-family:var(--serif);font-size:1.35rem;color:var(--navy);margin:2.2rem 0 .7rem;line-height:1.3">4. Del Webb North Myrtle Beach</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Del Webb North Myrtle Beach is the newest of the four: about 400 homes built since 2022, and the builder still sells new ones. Its clubhouse has an indoor lap pool, an outdoor pool with a walk-in entry and a fitness center, with pickleball and bocce courts and walking trails.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The city's community center is about a minute away by car. On weekdays you can play indoor pickleball there for a few dollars a day, and its outdoor courts are free.</p><div class="hx-strip" data-place="del-webb-nmb-55" data-name="Del Webb North Myrtle Beach" data-head="For sale now in Del Webb North Myrtle Beach"></div><div class="hx-fallback"><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/55-plus/del-webb-north-myrtle-beach/north-myrtle-beach-beach-umbrellas-1200w.webp" srcset="/images/55-plus/del-webb-north-myrtle-beach/north-myrtle-beach-beach-umbrellas-600w.webp 600w, /images/55-plus/del-webb-north-myrtle-beach/north-myrtle-beach-beach-umbrellas-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="800" alt="Rows of beach chairs and blue, green and yellow umbrellas on the wide sand beach in North Myrtle Beach" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: JefferyGoldman. License: CC BY-SA 4.0" title="License: CC BY-SA 4.0">Photo: JefferyGoldman</a></span></div><figcaption>Beach chairs and umbrellas on the beach in North Myrtle Beach.</figcaption></figure></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The nearest city beach parking lot is about 4 minutes away, and city beach parking is free all winter. McLeod Health Seacoast hospital is about 10 minutes away, and the North Strand emergency room, open day and night, about 5. Del Webb North Myrtle Beach is outside every hurricane evacuation zone.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the last year, new homes from the builder usually sold for about $635,000, and homes resold by their owners for about $535,000. The HOA fee is about $315 a month. More than 8 in 10 homes are taxed as someone's full-time home. At least one person in each household must be 55 or older. Read our <a href="/buyers/55-plus-communities/del-webb-north-myrtle-beach/" style="color:var(--navy);text-decoration:underline">Del Webb North Myrtle Beach guide</a>.</p><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Del%20Webb%20North%20Myrtle%20Beach">Get the homes for sale in Del Webb North Myrtle Beach<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do you need a 55+ community?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. About 2,100 houses on one level are for sale across the area, and fewer than 40 homes are for sale in these four 55+ communities. About two in three of the one-level houses are under $400,000. Of the seven towns in the chart, Conway has the most of those; Surfside Beach and North Myrtle Beach have the fewest.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.