 -113.9L1427.6 -63.3L1390.8 17.5L1390.5 17.9M1390.5 17.9L1372.2 60.3L1335.7 145.5L1316 186.3M1316 186.3L1286.2 248.9L1285.9 249.6L1246.8 333.1L1207.7 417.3L1175.3 498.2L1158.2 540.6L1117.7 637.3L1092.4 683.5L1065.4 729.3L1064.2 731.3L1045.7 773.4L1008 855.6L969.2 939.4L930.4 1023.7L891.8 1107.5L871.6 1150.3L831.7 1233.8L791.7 1317.4L751.8 1400.9L712.1 1484.1L672.2 1567.6L632 1651.2L592.3 1734.7L568.7 1760.6L554.1 1771.8L538.9 1766.7L509.6 1752.2L475.6 1727L471.9 1724.9" fill="none" stroke="#1c2028" stroke-opacity=".55" stroke-width="9"/><path d="M1467.6 -168.4L1445.3 -113.9L1427.6 -63.3L1390.8 17.5L1390.5 17.9M1390.5 17.9L1372.2 60.3L1335.7 145.5L1316 186.3M1316 186.3L1286.2 248.9L1285.9 249.6L1246.8 333.1L1207.7 417.3L1175.3 498.2L1158.2 540.6L1117.7 637.3L1092.4 683.5L1065.4 729.3L1064.2 731.3L1045.7 773.4L1008 855.6L969.2 939.4L930.4 1023.7L891.8 1107.5L871.6 1150.3L831.7 1233.8L791.7 1317.4L751.8 1400.9L712.1 1484.1L672.2 1567.6L632 1651.2L592.3 1734.7L568.7 1760.6L554.1 1771.8L538.9 1766.7L509.6 1752.2L475.6 1727L471.9 1724.9" fill="none" stroke="#ffd27a" stroke-width="5" stroke-dasharray="16 10"/><path d="M464.6 1741.8L500.3 1768L531.8 1783.9L557.7 1792.6L581.3 1774.4L607.8 1745.1M607.8 1745.1L647.4 1661.6L687.7 1578.1L727.3 1494.5L767.2 1411.3L806.9 1327.8L847.1 1244.3L887.1 1160.7L908.4 1115.6L947.2 1031.4L986.1 947.5L1024.6 863.3L1062.8 781.1L1081.1 738.7L1108.4 692.5L1134.3 645.4L1175.3 547.7L1192.5 505.3L1224.8 424.1L1263.9 340.2L1302.7 256.7L1352.5 153.3L1389.1 68L1407.7 24.6L1444.5 -56.6L1462.8 -107.8L1487.5 -168.4" fill="none" stroke="#1c2028" stroke-opacity=".55" stroke-width="9"/><path d="M464.6 1741.8L500.3 1768L531.8 1783.9L557.7 1792.6L581.3 1774.4L607.8 1745.1M607.8 1745.1L647.4 1661.6L687.7 1578.1L727.3 1494.5L767.2 1411.3L806.9 1327.8L847.1 1244.3L887.1 1160.7L908.4 1115.6L947.2 1031.4L986.1 947.5L1024.6 863.3L1062.8 781.1L1081.1 738.7L1108.4 692.5L1134.3 645.4L1175.3 547.7L1192.5 505.3L1224.8 424.1L1263.9 340.2L1302.7 256.7L1352.5 153.3L1389.1 68L1407.7 24.6L1444.5 -56.6L1462.8 -107.8L1487.5 -168.4" fill="none" stroke="#fff" stroke-width="5"/><path d="M1045.7 773.4L1125.7 718.4" stroke="#fff" stroke-width="4"/><circle cx="1045.7" cy="773.4" r="8" fill="#fff" stroke="#1c2028" stroke-width="4"/><text class="lb sb" x="1133.7" y="663.4">Setback</text><text class="lb sb" x="1133.7" y="721.4">line</text><path d="M986.1 947.5L1076.1 967.5" stroke="#fff" stroke-width="4"/><circle cx="986.1" cy="947.5" r="8" fill="#fff" stroke="#1c2028" stroke-width="4"/><text class="lb" x="1084.1" y="987.5">Top of</text><text class="lb" x="1084.1" y="1043.5">the dune</text><text class="lb" x="1084.1" y="1099.5">(baseline)</text></svg></div><ul class="c3-pi-legend"><li><i style="background:rgba(196,120,58,.75);border:2px solid #ffb35c"></i>Part of the house, about 200 square feet or more, is past the setback line</li><li><i style="background:rgba(255,255,255,.6);border:2px solid #8a96a3"></i>The house is behind it</li></ul><figcaption>A stretch of the south end of the island, north of the south-end parking lot. Lines: the state's current baseline and setback line. Outlines: Georgetown County's 2024 building footprints. Aerial: USDA NAIP via The National Map (USGS), public domain. Map: Chapter3 Realty.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For a house past the setback line, state law allows:</p><ul class="c3-pi-rules one"><li><strong>Repair</strong>A house damaged by a storm, but not destroyed, can be repaired.</li><li><strong>Rebuild</strong>A house a storm destroys can be rebuilt no larger past the setback line, no wider along the beach and no farther toward the ocean than before. It moves back from the ocean where possible, and never past the baseline.</li><li><strong>New house</strong>A new house built partly past the setback line can have at most 5,000 square feet of heated space.</li><li><strong>The town's own line</strong>The town draws its own line too, the Shore Protection Line, and it is usually stricter than the state's.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Before you offer on an oceanfront house, we get the survey and see where all three lines fall on the lot.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What the town lets you build</h3><ul class="c3-pi-rules"><li><strong>Height</strong>Up to 35 feet above the town's flood height for the lot, which is 3 feet above FEMA's.</li><li><strong>Size</strong>Heated floor area between 2,000 and 4,000 square feet, and no more than 40 percent of the lot.</li><li><strong>Paving</strong>Roofs and paved areas together no more than 40 percent of the lot. Driveways are gravel, shell or crushed stone, never paved.</li><li><strong>Approval</strong>A new house needs the town's Architectural Review Board. Taking down a protected tree needs a town permit.</li></ul><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);letter-spacing:.01em;color:#fff;text-align:right;background:radial-gradient(farthest-side at 100% 100%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.c3ph-cr a{color:#fff;text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);text-underline-offset:2px;pointer-events:auto;padding:10px 0 6px}.c3ph-hero{margin:1.6rem 0 2rem}.c3ph-hero .c3ph-f{border-radius:8px}.c3ph-hero img{aspect-ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}</style><figure class="c3ph-hero c3-pi-side" style="margin:1.4rem 0 1.6rem;max-width:720px;"><div class="c3ph-f"><img src="/images/2026-11-a/submarkets-pawleys-island/pawleys-island-north-end-1200w.webp" srcset="/images/2026-11-a/submarkets-pawleys-island/pawleys-island-north-end-600w.webp 600w, /images/2026-11-a/submarkets-pawleys-island/pawleys-island-north-end-1200w.webp 1200w" sizes="(max-width: 700px) 100vw, (max-width: 1099px) 720px, 380px" width="1200" height="900" alt="A wide beach at low tide with a row of raised houses along the dunes and an inlet beyond" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: Phoebe. License: CC BY-SA 4.0" title="License: CC BY-SA 4.0">Photo: Phoebe</a></span></div><figcaption>The north end of Pawleys Island at low tide: houses along the dune line, and the inlet at right.</figcaption></figure><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">The beach in front</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The town rebuilt its beach with about 1.1 million cubic yards of new sand. The plan paid for it from three sources: the town's beach fund, which is its 3 percent lodging tax on rentals, a state grant and a bank loan.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The south tip will change. Under a settlement with the Prince George community across the inlet, a new inlet is to be cut about 800 feet south of the south-end parking lot and kept inside a set zone. The town gets a right to sand for future beach work.</p></div></section><section style="background:var(--ivory-2)" id="pawleys-island-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Pawleys Island FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What county is Pawleys Island in?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Georgetown County, both the island and the mainland that shares its name. Its property taxes and its public schools are Georgetown County's.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is Pawleys Island part of Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. The island is its own town, and the mainland around it is run by Georgetown County. Broadway at the Beach, in Myrtle Beach, is about 26 miles north by road.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What is the ZIP code for Pawleys Island?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">29585. It covers the island and most of the mainland around it, from the beach to well west of US 17.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How many people live on Pawleys Island?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Census counted 130 people living in the town in 2020. Most island houses are second homes or rentals, so far more people stay in the summer.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is Pawleys Island expensive?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On the island, yes: over three years a house sold for about $2.45 million at the middle. On the mainland, a house sold for about $580,000 to $675,000 at the middle in the past year.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can you drive a golf cart on Pawleys Island?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, on island roads. The cart needs a state registration and a town sticker, and the address on its registration must be within 2 miles of the town limits. The driver must be 16 or older with a license. No driving at night or in the rain.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://gis1.georgetowncountysc.org/portal/rest/services" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Georgetown County GIS</a>, <a href="https://www.gtcountysc.gov/385/Property-Tax-Calculator" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">county tax calculator</a>, <a href="https://data.census.gov/profile/Pawleys_Island_town,_South_Carolina?g=160XX00US4555015" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Census</a>, <a href="https://www.fema.gov/api/open/v3/NfipPolicies" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">OpenFEMA</a>, <a href="https://www.nhc.noaa.gov/data/#hurdat" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NOAA storm tracks</a>, <a href="https://www.scstatehouse.gov/code/t48c039.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC beachfront law</a>, <a href="https://www.scstatehouse.gov/code/t12c043.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC property tax law</a>, <a href="https://www.scstatehouse.gov/code/t12c036.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC lodging tax</a>, <a href="https://dor.sc.gov/sites/dor/files/forms/ST575.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SCDOR tax rates</a>, <a href="https://npgallery.nps.gov/AssetDetail/NRIS/72001211" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">National Register</a>, <a href="https://www.townofpawleysisland.com/about-pawleys-island/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">the town</a>, <a href="https://www.townofpawleysisland.com/wp-content/uploads/2025/12/2026-Annual-Budget-FINAL.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">town budget</a>, <a href="https://www.townofpawleysisland.com/wp-content/uploads/2026/02/Pawleys-Island-Atax-Agenda_Packet-Nov-2025-1.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">lodging tax</a>, <a href="https://www.townofpawleysisland.com/passed-ordinances/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">passed ordinances</a>, <a href="https://www.townofpawleysisland.com/2025-legal-settlement-faqs/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">inlet settlement</a>, <a href="https://southcarolinaparks.com/huntington-beach" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">state park</a>, <a href="https://hammockshops.com/pages/history" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Hammock Shops</a>, <a href="https://www.ncei.noaa.gov/products/land-based-station/us-climate-normals" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NOAA normals</a>, <a href="https://www.nhc.noaa.gov/climo/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NHC</a>, <a href="https://www.townofpawleysisland.com/dogs-on-the-beach/" style=