.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h8l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v4h4M9 17l6-6"/><circle cx="9.5" cy="11.5" r="1"/><circle cx="14.5" cy="16.5" r="1"/></svg></span><span><strong>Town property tax</strong><span class="t">None</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span><strong>Sold last year</strong><span class="t">10 houses</span></span></li></ul><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);letter-spacing:.01em;color:#fff;text-align:right;background:radial-gradient(farthest-side at 100% 100%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.c3ph-cr a{color:#fff;text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);text-underline-offset:2px;pointer-events:auto;padding:10px 0 6px}.c3ph-hero{margin:1.6rem 0 2rem}.c3ph-hero .c3ph-f{border-radius:8px}.c3ph-hero img{aspect-ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}</style><figure class="c3ph-hero c3-pi-hero" style=""><div class="c3ph-f"><img src="/images/55-plus/seasons-at-prince-creek-west/pawleys-island-beach-walkway-1200w.webp" srcset="/images/55-plus/seasons-at-prince-creek-west/pawleys-island-beach-walkway-600w.webp 600w, /images/55-plus/seasons-at-prince-creek-west/pawleys-island-beach-walkway-1200w.webp 1200w" sizes="(max-width: 1099px) 100vw, 380px" width="1200" height="900" alt="A wooden walkway over green dunes leading to the ocean on Pawleys Island" fetchpriority="high" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: Phoebe. License: CC BY-SA 4.0" title="License: CC BY-SA 4.0">Photo: Phoebe</a></span></div><figcaption>A wooden walkway over the dunes to the beach on Pawleys Island.</figcaption></figure></div><p style="color:var(--muted);font-size:.9rem;margin-bottom:1rem">By <strong style="color:var(--navy);font-weight:600">Devin Day</strong>, Operations Officer &middot; Reviewed by <strong style="color:var(--navy);font-weight:600">Tim Nash</strong>, Broker-in-Charge &middot; <span style="white-space:nowrap">Updated November 12, 2026</span></p><p class="detail-sub">Pawleys Island is the south end of the Grand Strand: old beach houses on an island, with most homes that share its name on the mainland.</p></div></div><section style="background:var(--ivory)"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">The short answer</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Pawleys Island is a quiet beach town of about 480 houses on a barrier island, a narrow strip of land just off the coast. The ocean is in front, and a tidal creek and salt marsh are behind. The middle of the island is a historic district of old wooden summer houses, and beach parking is free.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Island houses rarely come up for sale: 10 sold at a market price in the past year, and over three years one sold for about $2.45 million at the middle. Most homes with a Pawleys Island address are on the mainland, where a house sold for about $580,000 to $675,000. Every island house but one is in a high-risk flood zone.</p></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><p style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Island houses rarely list. We watch the island and call you.</p><a class="btn btn-brass btn-lg" href="/contact/?place=Pawleys%20Island">Ask us to watch the island</a></div></section><section style="background:var(--ivory);padding-top:2.5rem"><div class="wrap"><nav aria-label="On this page" style="margin-top:0;max-width:720px"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.3rem;font-weight:600">On this page</p><ul style="list-style:none;margin:0;padding:0"><li><a href="#places" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">The four parts</a></li><li><a href="#living" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Living there all year</a></li><li><a href="#how-often" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">How often one sells</a></li><li><a href="#history" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">The old houses</a></li><li><a href="#taxes" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Yearly costs</a></li><li><a href="#renting" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Renting it out</a></li><li><a href="#flooding" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Flooding and storms</a></li><li><a href="#rebuild" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Building on the ocean</a></li><li><a href="#pawleys-island-faq" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Pawleys Island FAQ</a></li></ul></nav></div></section><section style="background:var(--ivory-2)" id="places"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The four parts">Is Pawleys Island an island, and what are its four parts like?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. Pawleys Island is a barrier island, less than 4 miles long and mostly one house wide, with salt marsh between it and the mainland. Two short causeways, the North Causeway and the South Causeway, cross the marsh.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Town of Pawleys Island is the island itself. The mainland around it has no town government; it is run by Georgetown County. Much of it shares the island's name and its ZIP code, 29585, so a Pawleys Island address can be a house on the mainland. This page covers four parts, from the beach inland.</p><figure class="c3-pi-fig"><div class="c3-pi-frame"><svg class="c3-pi-map" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1400 1603" role="img" aria-labelledby="c3-pi-map-t"><title id="c3-pi-map-t">Aerial map of Pawleys Island, South Carolina, and the mainland around it. The island is a thin strip along the ocean with salt marsh behind it; the town limits are shaded and outlined. Two causeways cross the marsh to the mainland. US 17 runs inland, parallel to the coast. Litchfield is north of the island on the ocean side of US 17; the mainland behind the island lies between US 17 and the marsh; about 4,800 houses are west of US 17.</title><image href="/images/2026-11-a/submarkets-pawleys-island/pawleys-area-aerial-1000.webp" x="0" y="0" width="1400" height="1603" preserveAspectRatio="none"/><path d="M538.3 1492.4L538.9 1482.1L547 1462.9L552.4 1452.1L566.8 1435.5L573.2 1421.9L578.8 1407.4L589 1386.4L596.2 1366.7L605.3 1345.7L613.3 1329.7L617.2 1319.8L619.2 1312.3L621.9 1298.1L623.1 1285.7L622 1275.4L618.3 1261.3L605.2 1246.5L603.6 1243.3L602.4 1240.2L601.8 1235.1L603.5 1229.8L607.7 1224.3L612.1 1220L624.4 1211.1L636.7 1205.3L681.6 1188L687.8 1183.5L691.2 1178.4L692.8 1173L693.3 1165.7L691.2 1158.6L688.9 1156L687 1151.8L686.5 1146.6L684.4 1140.2L684.8 1134.5L684.1 1131.8L686.5 1129.3L689.5 1128.8L692.8 1130.7L694.9 1130.4L699 1128.2L703.3 1123.6L705.3 1120L705.8 1116.5L705.7 1107L702.5 1098.9L698.4 1095.8L683.7 1096.5L680.6 1094.8L679.2 1092.3L678.1 1086.7L674.4 1083.4L675.5 1079.9L678.9 1073.3L679.2 1063.6L676.3 1058.5L664.6 1054.3L661.9 1051L660.6 1046.4L660.6 1042.3L663.2 1030.8L666.3 1027.2L669 1026.1L670.6 1029.4L673.2 1031.7L678 1034.4L681.9 1035.2L688.4 1040.5L697.7 1035.3L704.4 1037.7L706.8 1037.5L710.6 1035.6L711.3 1033.8L710.4 1028.5L699.2 1018.8L701.3 1015.8L709.6 1018.8L708.8 1010.7L704.2 1009.6L698.1 1002.8L697 998L703.1 995.9L707.3 1000L709.5 1006.5L718.3 996.1L720.4 995.9L729.8 999.3L731.2 998.7L733.9 996L735 992.2L742.4 988.2L743.4 987.1L743.6 985.2L742.2 979.3L740.5 978.3L738.6 973.9L733.6 970.7L731.7 966.7L729.7 965.2L727.4 964.8L727 963.6L727.7 962.3L730.4 962.8L735.6 966.5L738.3 962.2L741.9 963.3L743.6 962.5L744.7 959.4L759 963.5L766.5 961.1L769.8 956.3L773 955.3L775.5 956.1L778.9 955.5L781 954.2L782 951.4L780.9 948.2L686.5 923.1L687 915.9L688.5 914.2L687.8 912.3L690.5 912.2L692 909.9L697.8 906.7L700.5 906.4L702.5 908.1L704.9 905.9L708.1 905.6L711.5 900.1L719.3 896.4L734.9 885L739 877L741.3 869.1L755.5 847.2L757.9 840.8L763 815.7L766.6 807.9L770