ar(--rule)">$28,667</td><td style="text-align:right;padding:.55rem .9rem;border-bottom:1px solid var(--rule)">32.2%</td><td style="text-align:right;padding:.55rem .9rem;border-bottom:1px solid var(--rule)">$374</td><td style="text-align:right;padding:.55rem .9rem;border-bottom:1px solid var(--rule)">4,406</td><td style="text-align:right;padding:.55rem .9rem;border-bottom:1px solid var(--rule)"><span style="color:#a32b1f;font-weight:600">-5.4%</span></td></tr><tr><td style="padding:.55rem .9rem;border-bottom:1px solid var(--rule)"><a href="/submarkets/pawleys-island/" style="color:var(--brass);font-weight:600;text-decoration:none">Pawleys Island</a></td><td style="text-align:right;padding:.55rem .9rem;border-bottom:1px solid var(--rule)">$27,953</td><td style="text-align:right;padding:.55rem .9rem;border-bottom:1px solid var(--rule)">33.4%</td><td style="text-align:right;padding:.55rem .9rem;border-bottom:1px solid var(--rule)">$392</td><td style="text-align:right;padding:.55rem .9rem;border-bottom:1px solid var(--rule)">428</td><td style="text-align:right;padding:.55rem .9rem;border-bottom:1px solid var(--rule)"><span style="color:#2e7d4f;font-weight:600">+9.9%</span></td></tr><tr><td style="padding:.55rem .9rem;border-bottom:1px solid var(--rule)"><a href="/submarkets/conway/" style="color:var(--brass);font-weight:600;text-decoration:none">Conway</a></td><td style="text-align:right;padding:.55rem .9rem;border-bottom:1px solid var(--rule)">$21,285</td><td style="text-align:right;padding:.55rem .9rem;border-bottom:1px solid var(--rule)">34.7%</td><td style="text-align:right;padding:.55rem .9rem;border-bottom:1px solid var(--rule)">$245</td><td style="text-align:right;padding:.55rem .9rem;border-bottom:1px solid var(--rule)">106</td><td style="text-align:right;padding:.55rem .9rem;border-bottom:1px solid var(--rule)"><span style="color:#2e7d4f;font-weight:600">+9.2%</span></td></tr><tr><td style="padding:.55rem .9rem;border-bottom:1px solid var(--rule)"><a href="/submarkets/myrtle-beach/" style="color:var(--brass);font-weight:600;text-decoration:none">Myrtle Beach</a></td><td style="text-align:right;padding:.55rem .9rem;border-bottom:1px solid var(--rule)">$20,946</td><td style="text-align:right;padding:.55rem .9rem;border-bottom:1px solid var(--rule)">33.2%</td><td style="text-align:right;padding:.55rem .9rem;border-bottom:1px solid var(--rule)">$253</td><td style="text-align:right;padding:.55rem .9rem;border-bottom:1px solid var(--rule)">8,583</td><td style="text-align:right;padding:.55rem .9rem;border-bottom:1px solid var(--rule)"><span style="color:#a32b1f;font-weight:600">-10.7%</span></td></tr><tr><td style="padding:.55rem .9rem;border-bottom:1px solid var(--rule)"><a href="/submarkets/little-river/" style="color:var(--brass);font-weight:600;text-decoration:none">Little River</a></td><td style="text-align:right;padding:.55rem .9rem;border-bottom:1px solid var(--rule)">$12,243</td><td style="text-align:right;padding:.55rem .9rem;border-bottom:1px solid var(--rule)">30.3%</td><td style="text-align:right;padding:.55rem .9rem;border-bottom:1px solid var(--rule)">$202</td><td style="text-align:right;padding:.55rem .9rem;border-bottom:1px solid var(--rule)">171</td><td style="text-align:right;padding:.55rem .9rem;border-bottom:1px solid var(--rule)"><span style="color:#2e7d4f;font-weight:600">+1.8%</span></td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.7;max-width:720px;margin-top:1.2rem;font-size:.9rem">Airbtics, counting only full-time listings, puts North Myrtle Beach at a $58,000 annual median, which is what a committed whole-home operation there looks like rather than the tower average.</p></div></section>
