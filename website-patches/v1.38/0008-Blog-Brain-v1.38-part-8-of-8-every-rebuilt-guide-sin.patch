+};
+const CHIP_ROWS = [
+  ["Price", [["b1", "Up to $300,000"], ["b2", "$300,000 to $450,000"], ["b3", "Over $450,000"]]],
+  ["Must have", [["sand", "Beach in 10 minutes"], ["land", "Acre lots common"], ["new", "Builders selling now"], ["dry", "Few in a flood zone"], ["nohoa", "Mostly no HOA fee"]]],
