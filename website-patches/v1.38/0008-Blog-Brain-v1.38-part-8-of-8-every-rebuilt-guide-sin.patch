em;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:720px}</style><div class="pl-side"><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A house near the ocean is the most likely to have its own pool. About 1 in 3 houses for sale with a pool is east of US 17, the highway along the coast. Of all houses for sale, about 1 in 6 is.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-n/buyers-pool-homes/surfside-beach-houses-with-pools-2011-1200w.webp" srcset="/images/2026-11-n/buyers-pool-homes/surfside-beach-houses-with-pools-2011-600w.webp 600w, /images/2026-11-n/buyers-pool-homes/surfside-beach-houses-with-pools-2011-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="675" alt="Four beach houses in a row, each with a small fenced pool between the house and the dunes, with wooden walkways over the dunes to the beach" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="USGS photo, 2011. License: Public domain" title="License: Public domain">USGS photo, 2011</a></span></div><figcaption>Four oceanfront houses in Surfside Beach, each with its own pool behind the dunes, seen from a plane in 2011.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Surfside Beach and the Garden City area have the highest share. In each, 1 house in 4 or more for sale has its own pool.</p></div><style>main#main .hx-strip:empty{display:none}main#main .hx-strip:not(:empty)+.hx-fallback{display:none}</style><div class="hx-strip" data-place="pool-homes-east-of-17" data-name="pool homes east of US 17" data-head="Houses with a pool for sale east of US 17"></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We checked every house for sale on our site on November 8, 2026 and counted the ones that list their own pool:</p><table class="pl-towns"><caption>Houses for sale with their own pool, by town</caption><thead><tr><th scope="col">Town</th><th scope="col">With a pool</th><th scope="col">Middle asking price, with a pool</th><th scope="col">Middle asking price, no pool</th></tr></thead><tbody><tr><th scope="row"><a href="/homes/map/?type=house&amp;city=Myrtle%20Beach&amp;has=pool,county_horry">Myrtle Beach</a></th><td data-l="With a pool">113 of 1,049</td><td data-l="Middle price, with a pool">$1,120,000</td><td data-l="Middle price, no pool">$460,000</td></tr><tr><th scope="row"><a href="/homes/map/?type=house&amp;city=North%20Myrtle%20Beach&amp;has=pool,county_horry">North Myrtle Beach</a></th><td data-l="With a pool">47 of 257</td><td data-l="Middle price, with a pool">$1,000,000</td><td data-l="Middle price, no pool">$650,000</td></tr><tr><th scope="row"><a href="/homes/map/?type=house&amp;has=pool,area_carolina_forest,county_horry">Carolina Forest area</a></th><td data-l="With a pool">33 of 300</td><td data-l="Middle price, with a pool">$985,000</td><td data-l="Middle price, no pool">$465,000</td></tr><tr><th scope="row"><a href="/homes/map/?type=house&amp;city=Conway&amp;has=pool,county_horry">Conway</a></th><td data-l="With a pool">23 of 643</td><td data-l="Middle price, with a pool">$515,000</td><td data-l="Middle price, no pool">$325,000</td></tr><tr><th scope="row"><a href="/homes/map/?type=house&amp;city=Surfside%20Beach&amp;has=pool,county_horry">Surfside Beach</a></th><td data-l="With a pool">21 of 84</td><td data-l="Middle price, with a pool">$1,250,000</td><td data-l="Middle price, no pool">$500,000</td></tr><tr><th scope="row"><a href="/homes/map/?type=house&amp;city=Murrells%20Inlet&amp;has=pool,county_horry">Murrells Inlet, Horry County side</a></th><td data-l="With a pool">20 of 134</td><td data-l="Middle price, with a pool">$1,000,000</td><td data-l="Middle price, no pool">$530,000</td></tr><tr><th scope="row"><a href="/homes/map/?type=house&amp;city=Longs&amp;has=pool,county_horry">Longs</a></th><td data-l="With a pool">14 of 325</td><td data-l="Middle price, with a pool">$435,000</td><td data-l="Middle price, no pool">$320,000</td></tr><tr><th scope="row"><a href="/homes/map/?type=house&amp;has=pool,area_garden_city,county_horry">Garden City area</a></th><td data-l="With a pool">11 of 36</td><td data-l="Middle price, with a pool">$1,000,000</td><td data-l="Middle price, no pool">$730,000</td></tr><tr class="all"><th scope="row">All of Horry County</th><td data-l="With a pool">257 of 2,950</td><td data-l="Middle price, with a pool">$955,000</td><td data-l="Middle price, no pool">$400,000</td></tr></tbody></table><p class="pl-note">A town here is the mailing address, not the city limits. Carolina Forest and Garden City are areas, not towns, and they overlap the towns. Above-ground pools are not counted. Each name opens its pool homes on our map.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Little River (8), Loris (5), Socastee area (4) and Aynor (1) each had fewer than 10, too few for a middle price. Across the county line in Georgetown County, 16 of the 117 houses for sale in <a href="/homes/map/?q=house%20with%20a%20pool%20in%20pawleys%20island" style="color:var(--navy);text-decoration:underline">Pawleys Island</a> have a pool.</p></div></section><section style="background:var(--ivory)" id="cost"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Prices">How much does a house with a pool cost in Myrtle Beach?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A private pool comes mostly with the top of the market. Over $1,000,000, more than half of houses for sale have one.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="Share of houses for sale with their own pool, by asking price"><span class="cap" aria-hidden="true">Share of houses for sale with their own pool, by asking price</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Asking price</span><span role="columnheader">share with a pool</span></div></div><div role="rowgroup"><div role="row" class="ref"><span role="rowheader"><span class="n">$300,000 or less</span></span><span role="cell"><span class="b" style="--f:0.013" aria-hidden="true"></span><span class="v">1%</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">$300,000 to $400,000</span></span><span role="cell"><span class="b" style="--f:0.029" aria-hidden="true"></span><span class="v">2%</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">$400,000 to $500,000</span></span><span role="cell"><span class="b" style="--f:0.043" aria-hidden="true"></span><span class="v">3%</span></span></div><div role="row"><span role="rowheader"><span class="n">$500,000 to $750,000</span></span><span role="cell"><span class="b" style="--f:0.107" aria-hidden="true"></span><span class="v">8%</span></span></div><div role="row"><span role="rowheader"><span class="n">$750,000 to $1,000,000</span></span><span role="cell"><span class="b" style="--f:0.371" aria-hidden="true"></span><span class="v">26%</span></span></div><div role="row"><span role="rowheader"><span class="n">$1,000,000 to $1,500,000</span></span><span role="cell"><span class="b" style="--f:0.663" aria-hidden="true"></span><span class="v">46%</span></span></div><div role="row"><span role="rowheader"><span class="n">$1,500,000 to $2,000,000</span></span><span role="cell"><span class="b" style="--f:0.851" aria-hidden="true"></span><span class="v">60%</span></span></div><div role="row"><span role="rowheader"><span class="n">Over $2,000,000</span></span><span role="cell"><span class="b" style="--f:0.997" aria-hidden="true"></span><span class="v">70%</span></span></div></div></div><figcaption>Houses for sale in Horry County, our count. Under $500,000 the bars are gray.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">At the same size, a house with a pool still asks far more. Houses of 1,500 to 1,999 square feet ask about $515,000 with a pool and $350,000 without. At 3,000 to 3,999 square feet it is about $1,120,000 against $775,000.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">That gap is not the price of a pool. Houses with a pool are more often on the water, about 1 in 5 against 1 in 7.</p><div class="hx-strip" data-place="pool-homes-under-400k" data-name="pool homes at $400,000 or less" data-head="Houses with a pool at $400,000 or less"></div><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Is that pool house priced right?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the listing. We set its asking price beside the houses most like it nearby, with and without a pool.</p><a class="btn btn-brass" href="/contact/">Have us price a pool house</a></div></div></section><section style="background:var(--ivory-2)" id="own-or-shared"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Own or shared">Should you buy a house with a pool or use a community pool?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A house with its own pool asks more than twice as much in the middle as one in a neighborhood with a shared pool.</p><ul class="pl-cards" aria-label="Your own pool or a neighborhood pool"><li><span class="k">Your own pool</span><b>Swim when you like, and keep it up yourself</b><p>You pay for the chemicals, the repairs, the fence and the power for the pump. A pool pump can use as much as $310 of electricity a year.</p><p>About 1 in 4 of these houses also lists a hot tub.</p></li><li><span class="k">A neighborhood pool</span><b>Swim down the street, and the HOA keeps it up</b><p>The middle homeowners association (HOA) fee in these neighborhoods is about $105 a month. The middle asking price of their houses is about $435,000.</p><p>The state requires a yearly permit for the pool, and a certified pool operator checks it at least three times a week while it is open.</p></li></ul><div class="pl-stat"><p class="k">On a budget of $500,000 or less</p><ul><li><strong>37</strong><span>houses for sale with their own pool, in all of Horry County</span></li><li><strong>827</strong><span>houses for sale in a neighborhood with a shared pool</span></li></ul></div></div></section><section style="background:var(--ivory)" id="neighborhoods"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Neighborhoods">Which neighborhoods near Myrtle Beach have a shared pool?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Five of them follow, from the lowest middle price to the highest. Each name opens its houses for sale on our map. The counts are from the same day as the town table.</p><ul class="pl-plain pl-nb" aria-label="Five neighborhoods with a shared pool"><li><b><a href="/homes/map/?type=house&amp;subdivision=Golf%20%26%20Yacht&amp;has=county_horry">Myrtle Beach Golf and Yacht Club</a>, off Bay Road near Socastee</b>Mostly one-story houses behind a gatehouse. Owners share a pool and a hot tub, open April 15 to October 15, with tennis courts and a community center. Of its 11 houses for sale, 9 asked $300,000 or less. <a class="pl-ask" href="/contact/">Have us send you its houses for sale as they list</a></li><li><b><a href="/homes/map/?type=house&amp;subdivision=Carolina%20Forest%20-%20The%20Farm&amp;has=county_horry">The Farm at Carolina Forest</a></b>The HOA has a large pool and a small pool. Its rules allow no private pool on a lot, so owners swim at these. Its 15 houses for sale had a middle asking price of about $350,000. Our <a href="/submarkets/carolina-forest/the-farm/" style="color:var(--navy);text-decoration:underline">guide to The Farm</a> has its fee and rules. <a class="pl-ask" href="/contact/">Have us find you a house in The Farm</a></li><li><b><a href="/homes/map/?type=house&amp;subdivision=Berkshire%20Forest&amp;has=county_horry">Berkshire Forest</a>, in Carolina Forest</b>Two pool areas. The first, beside a lake, has a pool with a water slide. The second has a pool and pickleball courts. 13 of its 17 houses for sale asked $500,000 or less. <a class="pl-ask" href="/contact/">Have us show you houses in Berkshire Forest</a></li><li><b><a href="/homes/map/?type=house&amp;subdivision=Waterbridge&amp;has=county_horry">Waterbridge</a>, in Carolina Forest</b>Its HOA describes a swimming pool complex, pocket parks and over 80 acres of lakes and natural areas. Its 27 houses for sale had a middle asking price of about $680,000. <a class="pl-ask" href="/contact/">Have us price a house in Waterbridge</a></li><li><b><a href="/homes/map/?type=house&amp;subdivision=Plantation%20Lakes&amp;has=county_horry">Plantation Lakes</a>, in Carolina Forest</b>Two large pools joined by waterfalls, a clubhouse with a gym, and lakes where owners take out pontoon boats. 5 of its 14 houses for sale also have a pool of their own. <a class="pl-ask" href="/contact/">Have us set up a search in Plantation Lakes</a></li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Each community on our <a href="/buyers/55-plus-communities/" style="color:var(--navy);text-decoration:underline">55+ communities page</a> also has its own clubhouse and pool.</p></div></section><section style="background:var(--ivory-2)" id="upkeep"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Upkeep">What does a pool cost to keep up in Horry County?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A pool adds power, care and insurance to your bills. A pool you add later also raises your property tax.</p><ul class="pl-plain" aria-label="What a pool adds to the cost of owning"><li><b>Power for the pump</b>The pump can be a home's second largest user of energy. An <a href="https://www.energystar.gov/products/pool_pumps" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">ENERGY STAR</a> certified in-ground pump uses about 20 percent less and saves about $50 a year.</li><li><b>Chemicals and care</b>Each pool service company charges its own price for weekly care and chemicals. We get a quote for the house you want before you make an offer.</li><li><b>Insurance</b>Tell your insurer about the pool before you buy. A pool can raise the premium, and the insurer can ask whether it is covered or locked when no one is using it, and what fence you have. An umbrella policy adds liability coverage above your homeowners policy.</li><li><b>Property tax</b>A pool that is already there is part of the home's value for tax. If you add a pool after you buy, the county adds its full value to your home's value. There is a 15 percent limit on how much the county can raise a home's value at a countywide revaluation. It does not cover the new pool in its first taxed year. Our <a href="/buyers/property-taxes/" style="color:var(--navy);text-decoration:underline">property tax page</a> has the rates.</li></ul><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">What will this pool cost you to keep?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us which house. We get a quote from a pool service company and ask the seller for the pool's repair bills.</p><a class="btn btn-brass" href="/contact/">Have us get a pool service quote</a></div></div></section><section style="background:var(--ivory)" id="fence"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Fence rule">Do you need a fence around a pool in Horry County?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. Outside city limits, Horry County requires a fence or other barrier with gates around a pool. The county uses the 2021 International Swimming Pool and Spa Code.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Inside a city such as Myrtle Beach or North Myrtle Beach, the city's own building official issues the pool permit. South Carolina has no statewide pool code, so each city decides its own rule. We ask the city's building office about the house you want.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We read the county's pool fence form, which quotes the code, and drew its rule:</p><figure class="pl-fig"><p class="cap">Horry County's pool fence rule, outside city limits</p><div class="pl-fig-in"><svg class="pl-svg" viewBox="0 0 480 360" role="img" aria-labelledby="plSvgT" xmlns="http://www.w3.org/2000/svg"><title id="plSvgT">Drawing of a backyard pool from above: the house wall on one side and a fence on the other three, a gate that swings out, and the pump outside the fence. The words House, Pool and Outside the fence label the parts. Numbers 1 to 6 match the list.</title><rect x="0" y="0" width="480" height="360" rx="18" fill="#fbf8f3"/><rect x="40" y="82" width="360" height="218" fill="#e3ecd6"/><rect x="20" y="16" width="400" height="66" rx="4" fill="#e8dfd2" stroke="#1c2028" stroke-width="2"/><rect x="228" y="70" width="34" height="12" rx="2" fill="#c4783a"/><rect x="112" y="128" width="196" height="116" rx="20" fill="#a9d3e6" stroke="#5c8fa8" stroke-width="3"/><path d="M140 170q12-8 24 0t24 0t24 0M200 205q12-8 24 0t24 0t24 0" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" opacity=".8"/><path d="M40 82L40 300" stroke="#c4783a" stroke-width="5" stroke-linecap="round"/><path d="M45.0 89.0L35.0 89.0M45.0 103.0L35.0 103.0M45.0 117.0L35.0 117.0M45.0 131.0L35.0 131.0M45.0 145.0L35.0 145.0M45.0 159.0L35.0 159.0M45.0 173.0L35.0 173.0M45.0 187.0L35.0 187.0M45.0 201.0L35.0 201.0M45.0 215.0L35.0 215.0M45.0 229.0L35.0 229.0M45.0 243.0L35.0 243.0M45.0 257.0L35.0 257.0M45.0 271.0L35.0 271.0M45.0 285.0L35.0 285.0M45.0 299.0L35.0 299.0" stroke="#c4783a" stroke-width="2"/><path d="M40 300L190 300" stroke="#c4783a" stroke-width="5" stroke-linecap="round"/><path d="M47.0 295.0L47.0 305.0M61.0 295.0L61.0 305.0M75.0 295.0L75.0 305.0M89.0 295.0L89.0 305.0M103.0 295.0L103.0 305.0M117.0 295.0L117.0 305.0M131.0 295.0L131.0 305.0M145.0 295.0L145.0 305.0M159.0 295.0L159.0 305.0M173.0 295.0L173.0 305.0M187.0 295.0L187.0 305.0" stroke="#c4783a" stroke-width="2"/><path d="M240 300L400 300" stroke="#c4783a" stroke-width="5" stroke-linecap="round"/><path d="M247.0 295.0L247.0 305.0M261.0 295.0L261.0 305.0M275.0 295.0L275.0 305.0M289.0 295.0L289.0 305.0M303.0 295.0L303.0 305.0M317.0 295.0L317.0 305.0M331.0 295.0L331.0 305.0M345.0 295.0L345.0 305.0M359.0 295.0L359.0 305.0M373.0 295.0L373.0 305.0M387.0 295.0L387.0 305.0" stroke="#c4783a" stroke-width="2"/><path d="M400 300L400 82" stroke="#c4783a" stroke-width="5" stroke-linecap="round"/><path d="M395.0 293.0L405.0 293.0M395.0 279.0L405.0 279.0M395.0 265.0L405.0 265.0M395.0 251.0L405.0 251.0M395.0 237.0L405.0 237.0M395.0 223.0L405.0 223.0M395.0 209.0L405.0 209.0M395.0 195.0L405.0 195.0M395.0 181.0L405.0 181.0M395.0 167.0L405.0 167.0M395.0 153.0L405.0 153.0M395.0 139.0L405.0 139.0M395.0 125.0L405.0 125.0M395.0 111.0L405.0 111.0M395.0 97.0L405.0 97.0M395.0 83.0L405.0 83.0" stroke="#c4783a" stroke-width="2"/><path d="M190 300L225.4 335.4" stroke="#1c2028" stroke-width="5" stroke-linecap="round"/><path d="M240 300A50 50 0 0 1 225.4 335.4" fill="none" stroke="#1c2028" stroke-width="2" stroke-dasharray="4 4"/><circle cx="234" cy="293" r="4.5" fill="#1c2028"/><rect x="436" y="168" width="26" height="40" rx="5" fill="#1c2028"/><circle cx="449" cy="182" r="6" fill="none" stroke="#fff" stroke-width="2"/><path d="M404 222H432M404 216v12M432 216v12" stroke="#8a5226" stroke-width="2.5" stroke-linecap="round"/><text x="70" y="56" text-anchor="start" font-family="Inter,Arial,sans-serif" font-size="17" font-weight="600" fill="#1c2028">House</text><text x="272" y="230" text-anchor="middle" font-family="Inter,Arial,sans-serif" font-size="17" font-weight="600" fill="#1c2028">Pool</text><text x="60" y="340" text-anchor="start" font-family="Inter,Arial,sans-serif" font-size="14" font-weight="500" fill="#5a5f6b">Outside the fence</text><g><circle cx="40" cy="190" r="15" fill="#1c2028"/><text x="40" y="196" text-anchor="middle" font-family="Inter,Arial,sans-serif" font-size="17" font-weight="700" fill="#fff">1</text></g><g><circle cx="330" cy="300" r="15" fill="#1c2028"/><text x="330" y="306" text-anchor="middle" font-family="Inter,Arial,sans-serif" font-size="17" font-weight="700" fill="#fff">2</text></g><g><circle cx="258" cy="338" r="15" fill="#1c2028"/><text x="258" y="344" text-anchor="middle" font-family="Inter,Arial,sans-serif" font-size="17" font-weight="700" fill="#fff">3</text></g><g><circle cx="216" cy="276" r="15" fill="#1c2028"/><text x="216" y="282" text-anchor="middle" font-family="Inter,Arial,sans-serif" font-size="17" font-weight="700" fill="#fff">4</text></g><g><circle cx="245" cy="48" r="15" fill="#1c2028"/><text x="245" y="54" text-anchor="middle" font-family="Inter,Arial,sans-serif" font-size="17" font-weight="700" fill="#fff">5</text></g><g><circle cx="449" cy="140" r="15" fill="#1c2028"/><text x="449" y="146" text-anchor="middle" font-family="Inter,Arial,sans-serif" font-size="17" font-weight="700" fill="#fff">6</text></g></svg><ol class="pl-key" aria-label="What the numbers in the drawing show"><li><span class="n" aria-hidden="true">1</span><span><b>Height</b>At least 48 inches tall, measured on the side away from the pool.</span></li><li><span class="n" aria-hidden="true">2</span><span><b>Gaps</b>No opening a 4-inch ball could pass through. The gap under the fence is at most 2 inches over grass, or 4 over concrete.</span></li><li><span class="n" aria-hidden="true">3</span><span><b>The gate</b>It opens outward, away from the pool. It closes by itself and latches by itself.</span></li><li><span class="n" aria-hidden="true">4</span><span><b>The latch</b>A latch lower than 54 inches goes on the pool side, at least 3 inches below the top of the gate.</span></li><li><span class="n" aria-hidden="true">5</span><span><b>Doors and windows</b>Where the house wall is part of the barrier, each door to the pool needs an alarm. Each window with a sill under 48 inches needs one too.</span></li><li><span class="n" aria-hidden="true">6</span><span><b>The pump</b>Pumps, filters and heaters sit at least 36 inches from the outside of the fence, so they cannot be used to climb over it.</span></li></ol></div><figcaption>Our drawing of section 305 of the 2021 International Swimming Pool and Spa Code, as Horry County's pool fence form quotes it.</figcaption></figure><ul class="pl-plain" aria-label="Three more parts of the county's rule"><li><b>Covers instead of a fence</b>A hot tub with a safety cover that locks needs no fence. Neither does a pool with a powered safety cover that meets the safety standard.</li><li><b>Instead of door alarms</b>The code also allows a safety cover on the pool, tested and labeled to the safety standard. The county can approve another protection, such as doors that close and latch by themselves.</li><li><b>A new pool</b>It needs a county permit and inspections, and no one may swim in it until the county approves them.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The rule is there for small children. Most children who drown in a pool or spa drown at a home, the <a href="https://www.cpsc.gov/s3fs-public/Pool-or-Spa-Submersion-Estimated-Nonfatal-Drowning-Injuries-and-Reported-Drownings-2026-Report.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Consumer Product Safety Commission</a> reports.</p></div></section><section style="background:var(--ivory-2)" id="inspection"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Inspection">Do home inspectors check pools in South Carolina?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not unless you ask. The standard South Carolina home inspectors follow comes from the <a href="https://www.homeinspector.org/Resources/Standard-of-Practice" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">American Society of Home Inspectors</a>. It does not require them to inspect a pool, a hot tub or a fence.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You and the inspector can agree to add the pool. The inspector must tell you before the inspection what it will not cover.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Buying a house with a pool?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us which house. We ask the seller for the pool's county permit papers and tell you what the inspection will leave out.</p><a class="btn btn-brass" href="/contact/">Have us look into the pool</a></div></div></section><section style="background:var(--ivory)" id="pool-homes-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Pool homes FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Are there homes with a pool under $300,000 in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Few. On the day we counted, 5 of the 575 houses for sale in Horry County at $300,000 or less had their own pool. 168 houses at that price were in a neighborhood with a shared pool.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does a pool add value to a home in Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On asking prices, yes. At every size we checked, houses with a pool ask more than houses without one. Part of that gap comes from where they are: nearer the beach and more often on the water.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do pool homes in Myrtle Beach allow short-term rentals?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">More often than other houses. About 28 percent of houses for sale with their own pool say short-term rentals are allowed, against about 12 percent of all houses.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Are pool homes near Myrtle Beach in gated communities?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About 1 in 5 houses for sale with their own pool is in a gated community, against about 1 in 9 of all houses.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do townhouses near Myrtle Beach have a pool?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Many share one. Half of the 298 townhouses for sale in Horry County, 149, are in a community with a shared pool. Their middle asking price is about $270,000.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.horrycountysc.gov/media/r2sebvu1/pool-fence-affidavit-2021-ispsc.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County fence form</a>, <a href="https://www.scstatehouse.gov/code/statmast.php?title=6&chapter=9" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 6-9</a>, <a href="https://llr.sc.gov/bcc/PDFfiles/Building%20Codes%20in%20Effect%20for%20South%20Carolina%20Final.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC codes council</a>, <a href="https://www.scstatehouse.gov/code/statmast.php?title=40&chapter=59" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 40-59</a>, <a href="https://www.llr.sc.gov/res/PDF/FAQ/RBI%20FAQ.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">LLR inspector FAQ</a>, <a href="https://www.homeinspector.org/Resources/Standard-of-Practice" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">ASHI standard</a>, <a href="https://www.scstatehouse.gov/code/t12c037.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-37</a>, <a href="https://www.des.sc.gov/sites/des/files/Library/Regulations/R.61-51.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">DES R.61-51</a>, <a href="https://content.naic.org/article/consumer_insight_protecting_your_home_coverage_pools_hot_tubs_and_backyard_toys.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NAIC</a>, <a href="https://www.energystar.gov/products/pool_pumps" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">ENERGY STAR</a>, <a href="https://www.cpsc.gov/s3fs-public/Pool-or-Spa-Submersion-Estimated-Nonfatal-Drowning-Injuries-and-Reported-Drownings-2026-Report.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">CPSC</a>, <a href="https://www.ncei.noaa.gov/products/land-based-station/us-climate-normals" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NOAA normals</a>, <a href="https://www.mbgyc.com/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Golf and Yacht Club HOA</a>, <a href="https://waterbridgehoa.com/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Waterbridge HOA</a>, <a href="https://www.plantationlakespoa.com/community.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Plantation Lakes POA</a>. Homes for sale: our count of the listings on our site, Horry County, November 8, 2026, asking prices. Source: Coastal Carolinas Association of REALTORS® Multiple Listing Service (CCMLS).</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1rem"><strong style="color:var(--navy)">Legal notice.</strong> Chapter3 Realty Corp is a licensed South Carolina real estate brokerage. We are not attorneys, insurers or tax advisers, and nothing on this page is legal, insurance or tax advice. For the rule on one property, ask the county or city building office or a South Carolina attorney.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Four beach houses in a row, each with a small fenced pool between the house and the dunes, with wooden walkways over the dunes to the beach. Photo: U.S. Geological Survey, <a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://doi.org/10.5066/F7N877XX" target="_blank" rel="noopener noreferrer">U.S. Geological Survey</a>.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-11-n/buyers-pool-homes/surfside-beach-houses-with-pools-2011-1200w.webp","url":"https://chapter3realty.com/images/2026-11-n/buyers-pool-homes/surfside-beach-houses-with-pools-2011-1200w.webp","width":1200,"height":675,"encodingFormat":"image/webp","name":"Four beach houses in a row, each with a small fenced pool between the house and the dunes, with wooden walkways over the dunes to the beach","caption":"Four oceanfront houses in Surfside Beach, each with its own pool behind the dunes, seen from a plane in 2011.","description":"Four beach houses in a row, each with a small fenced pool between the house and the dunes, with wooden walkways over the dunes to the beach","creator":{"@type":"Organization","name":"U.S. Geological Survey"},"creditText":"U.S","copyrightNotice":"Public domain (U.S. Geological Survey)","license":"https://www.usa.gov/publicdomain/label/1.0/","acquireLicensePage":"https://doi.org/10.5066/F7N877XX","isBasedOn":"https://doi.org/10.5066/F7N877XX","contentLocation":{"@type":"Place","name":"The oceanfront of the Town of Surfside Beach (Horry 