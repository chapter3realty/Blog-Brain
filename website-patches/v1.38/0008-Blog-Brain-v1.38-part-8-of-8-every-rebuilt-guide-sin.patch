igure{flex:0 0 82%;scroll-snap-align:start}}.c3ph-swipe{display:flex;align-items:center;gap:.75rem;margin:.5rem 0 1.6rem;color:var(--navy);font:500 .95rem/1.3 var(--sans)}.c3ph-dots{display:inline-flex;gap:.45rem}.c3ph-dots i{display:block;width:10px;height:10px;border-radius:50%;border:1.5px solid var(--navy);box-sizing:border-box}.c3ph-dots i:first-child{background:var(--navy)}@supports (animation-timeline:view()){.c3ph-rowbox{timeline-scope:--c3ph-p1,--c3ph-p2,--c3ph-p3}.c3ph-row>figure:nth-child(1){view-timeline:--c3ph-p1 inline}.c3ph-row>figure:nth-child(2){view-timeline:--c3ph-p2 inline}.c3ph-row>figure:nth-child(3){view-timeline:--c3ph-p3 inline}.c3ph-dots i{animation:c3ph-dot linear both;animation-range:cover}.c3ph-dots i:nth-child(1){animation-timeline:--c3ph-p1}.c3ph-dots i:nth-child(2){animation-timeline:--c3ph-p2}.c3ph-dots i:nth-child(3){animation-timeline:--c3ph-p3}@keyframes c3ph-dot{0%,36%{background:transparent}42%,60%{background:var(--navy)}66%,100%{background:transparent}}}@media (min-width:700px){.c3ph-swipe{display:none}}.c3ph-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:1.4rem 0 1.8rem;padding:0;list-style:none}@media (min-width:700px){.c3ph-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}}@media (min-width:1000px){.c3ph-cards.c3ph-4{grid-template-columns:repeat(4,minmax(0,1fr))}}.c3ph-card{margin:0;background:var(--ivory);border:1px solid var(--rule);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}.c3ph-card .c3ph-f{border-radius:0}.c3ph-card img,.c3ph-card svg{display:block;width:100%;height:auto;aspect-ratio:var(--c3ph-r,4/3);object-fit:cover}.c3ph-card .c3ph-cr{font-size:.56rem;padding:1.2rem .45rem .25rem 1.6rem}.c3ph-card strong{display:block;color:var(--navy);font-size:.98rem;font-weight:500;line-height:1.3;padding:.7rem .8rem 0}.c3ph-card span.c3ph-t{display:block;color:var(--muted);font-size:.86rem;line-height:1.45;padding:.2rem .8rem .85rem}.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:640px}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Only when the home is rented out. The IRS lists homeowners association (HOA) fees, condo fees and common charges with homeowners insurance, utilities and internet service as costs you <a href="https://www.irs.gov/publications/p530" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">cannot deduct on a home</a>. On a rental, <a href="https://www.irs.gov/publications/p527" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">IRS Publication 527</a> lets you deduct dues paid for upkeep of the shared parts of a condo building.</p><figure class="tx-fig tx-rulefig"><p class="cap">Are the HOA dues deductible? It depends on how the home is used</p><table class="tx-rules"><thead><tr><th scope="col">How you use the home</th><th scope="col">Deductible?</th><th scope="col">What it means</th></tr></thead><tbody><tr><th scope="row">You live in it all year</th><td data-label="Deductible?"><span class="tx-a no">No</span></td><td data-label="What it means">HOA fees on a home you live in are a personal cost, like your insurance and utilities.</td></tr><tr><th scope="row">A second home you never rent</th><td data-label="Deductible?"><span class="tx-a no">No</span></td><td data-label="What it means">The same rule as a main home. The dues are not deductible.</td></tr><tr><th scope="row">You rent it out and never stay there</th><td data-label="Deductible?"><span class="tx-a yes">Yes, all</span></td><td data-label="What it means">All of the dues are a rental expense, including months it sits empty while you hold it out for rent (listed and open to bookings).</td></tr><tr><th scope="row">You rent it out and stay there some nights</th><td data-label="Deductible?"><span class="tx-a part">Partly</span></td><td data-label="What it means">You deduct the rented share of the dues, worked out by nights.</td></tr><tr><th scope="row">Your home, rented fewer than 15 days</th><td data-label="Deductible?"><span class="tx-a no">No</span></td><td data-label="What it means">You report no rent and deduct no rental costs.</td></tr><tr><th scope="row">You work from home</th><td data-label="Deductible?"><span class="tx-a no">Not for employees</span></td><td data-label="What it means">An employee gets no home office deduction. A self-employed owner who qualifies splits whole-home costs by the share used for business.</td></tr></tbody></table></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A deduction is not money back. It lowers the rental income that is taxed, and what it saves depends on the rest of your return.</p></div></section><section style="background:var(--ivory)" id="rented-share"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Your rented share">How much of the HOA fee can I deduct if I rent and use the condo?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">You deduct the rented share: rented nights as a share of rented nights plus personal nights. Nights the condo sat empty count on neither side.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A night rented at a fair price counts as rented, even if you were there that day. A fair price is about what a person not related to you would pay. A rent far below what similar condos nearby charge is not a fair price.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Put in your own numbers:</p><figure class="tx-cfig"><div class="tx-calc" role="group" aria-labelledby="txcalc-h"><p class="k" id="txcalc-h">Work out your deductible dues</p><div class="f"><label for="txDues">HOA dues a month</label><span class="in">$ <input id="txDues" type="number" min="0" step="25" value="650" inputmode="numeric"></span></div><div class="f"><label for="txRent">Nights rented at a fair price this year</label><span class="in"><input id="txRent" type="number" min="0" max="365" step="1" value="120" inputmode="numeric"></span></div><div class="f"><label for="txMine">Your personal nights this year</label><span class="in"><input id="txMine" type="number" min="0" max="365" step="1" value="20" inputmode="numeric"></span></div><div class="out"><span>Dues you deduct for the year</span><strong id="txDed" aria-live="polite">$6,686</strong></div><div class="out s"><span>Rented share of the nights</span><strong id="txShare">86%</strong></div><p id="txSay" class="say">This condo counts as your home under the IRS test below, because your personal nights are more than 14. The figure above is the most you can deduct. It is cut if your rental costs are more than the rent.</p></div></figure><script>(function(){var D=function deduct(monthly, rented, personal) {
+  const year = monthly * 12;
+  if (!(rented > 0)) return { share: 0, ded: 0, kind: "none" };
+  const limit = Math.max(14, rented / 10);
+  const home = personal > limit;
+  if (home && rented < 15) return { share: 0, ded: 0, kind: "short", limit };
+  if (!(personal > 0)) return { share: 1, ded: year, kind: "all", limit };
+  const share = rented / (rented + personal);
+  return { share, ded: Math.round(year * share), kind: home ? "home" : "split", limit };
+};var V=function view(D, m, md, r, p) {
+  const x = D(md, r, p);
+  const lim = x.limit >= 15 ? "more than 10 percent of the " + r + " nights rented" : "more than 14";
+  if (r + p > 365) return { ded: m(x.ded), share: Math.round(x.share * 100) + "%", say: "A year has 365 nights. Check the two counts." };
+  if (x.kind === "none" && !(p > 0)) return { ded: m(0) + " or " + m(md * 12), share: "0% or 100%",
+    say: "If you held it out for rent all year, all of the dues are a rental expense. If you did not, none are." };
+  const say = x.kind === "none" ? "With no nights rented, none of the dues are deductible."
+    : x.kind === "short" ? "This counts as your home and was rented fewer than 15 days. You report no rent and deduct no rental costs."
+    : x.kind === "all" ? "No personal nights: all of the dues are a rental expense, including weeks it sits empty while you hold it out for rent."
+    : x.kind === "home" ? "This condo counts as your home under the IRS test below, because your personal nights are " + lim + ". The figure above is the most you can deduct. It is cut if your rental costs are more than the rent."
+    : "This condo does not count as your home under the IRS test below: your personal nights are not " + lim + ". Your rental costs can be more than the rent.";
+  return { ded: m(x.ded), share: Math.round(x.share * 100) + "%", say };
+};function n(id){var e=document.getElementById(id);var v=e?parseFloat(e.value):NaN;return isFinite(v)&&v>0?v:0}function m(v){return "$"+Math.round(v).toLocaleString("en-US")}function run(){var o=document.getElementById("txDed"),s=document.getElementById("txShare"),y=document.getElementById("txSay");if(!o||!s||!y)return;var md=n("txDues"),r=Math.min(365,Math.round(n("txRent"))),p=Math.min(365,Math.round(n("txMine")));var x=V(D,m,md,r,p);o.textContent=x.ded;s.textContent=x.share;y.textContent=x.say}["txDues","txRent","txMine"].forEach(function(id){var e=document.getElementById(id);if(e)e.addEventListener("input",run)});run()})();</script><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Worked example: fewer personal nights can mean a larger deduction. On the condo below, rented 120 nights, cutting personal nights from 20 to 14 raises the deductible dues. The condo also stops counting as your home.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="Example: deductible dues on one condo with $7,800 a year in dues"><span class="cap" aria-hidden="true">Example: deductible dues on one condo with $7,800 a year in dues</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">How the condo is used, rented share</span><span role="columnheader">dues you deduct</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Lived in all year</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">a home: no deduction</span></span><span role="cell"><span class="b" style="--f:0" aria-hidden="true"></span><span class="v">$0</span></span></div><div role="row"><span role="rowheader"><span class="n">Rented 120 nights, 20 personal nights</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">86%; counts as your home</span></span><span role="cell"><span class="b" style="--f:0.857" aria-hidden="true"></span><span class="v">$6,686</span></span></div><div role="row"><span role="rowheader"><span class="n">Rented 120 nights, 14 personal nights</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">90%; not your home</span></span><span role="cell"><span class="b" style="--f:0.896" aria-hidden="true"></span><span class="v">$6,985</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">Held for rent all year, no personal nights</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">all of the dues</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">$7,800</span></span></div></div></div><figcaption>The condo has the middle dues of Horry County condos for sale, $650 a month.</figcaption></figure><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">When the condo counts as your home</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The IRS counts a condo as your home if your personal nights are more than 14. If you rent it more than 140 nights at a fair price, the line is 10 percent of those nights instead.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Counting as your home matters when the rent is less than your rental costs. Then the deductions stop at the rent, and you can use the rest on next year's return for the same condo.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If it does not count as your home, the rental can show a loss. Whether that loss lowers the tax on your other income, such as wages, depends on the loss limits on our <a href="/invest/str-tax-treatment/" style="color:var(--navy);text-decoration:underline">short-term rental tax page</a>.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">This IRS test is not the county's 72-day limit for the property tax rate, which comes below. The <a href="/invest/14-day-rule/" style="color:var(--navy);text-decoration:underline">14-day rule page</a> has the other IRS day counts.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What counts as a personal night</h3><div class="tx-two"><div class="pers"><p class="k">Counts as a personal night</p><ul><li>A night you or a co-owner stays there</li><li>A night a relative stays, unless they rent it at a fair price as their main home</li><li>A night anyone pays less than a fair rent</li><li>A night someone stays in a swap that lets you use another home</li></ul></div><div class="rent"><p class="k">Does not count as a personal night</p><ul><li>A night rented at a fair price, even if you were there that day</li><li>A day you spend working close to full time on repairs and upkeep, even if family members enjoy the condo that day</li></ul></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Relatives are a spouse, brothers and sisters including half, parents, grandparents and earlier generations, and children, grandchildren and later generations. A day spent improving the condo, not repairing it, is not a repair day.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Want the numbers for one condo?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the condo you are looking at. We find its dues, what they include, and whether its rules allow short-term rentals, before you make an offer.</p><a class="btn btn-brass" href="/contact/">Have us check one condo</a></div></div></section><section style="background:var(--ivory-2)" id="dues-by-area"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Dues by area">What do condo HOA fees cost in Horry County?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About $650 a month, or $7,800 a year, for the middle condo for sale in Horry County. In oceanfront buildings the middle is about $925 a month. The middle dues are about $375 a month in Socastee and about $875 at the north end of Myrtle Beach.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="Middle monthly HOA dues of condos for sale, by ZIP code"><span class="cap" aria-hidden="true">Middle monthly HOA dues of condos for sale, by ZIP code</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Area, a year of dues</span><span role="columnheader">dues a month</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Myrtle Beach, north end (ZIP 29572)</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about $10,500 a year</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">about $875</span></span></div><div role="row"><span role="rowheader"><span class="n">Myrtle Beach, central and south (ZIP 29577)</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about $9,300 a year</span></span><span role="cell"><span class="b" style="--f:0.886" aria-hidden="true"></span><span class="v">about $775</span></span></div><div role="row"><span role="rowheader"><span class="n">North Myrtle Beach (ZIP 29582)</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about $8,400 a year</span></span><span role="cell"><span class="b" style="--f:0.8" aria-hidden="true"></span><span class="v">about $700</span></span></div><div role="row"><span role="rowheader"><span class="n">Surfside Beach (ZIP 29575)</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about $6,300 a year</span></span><span role="cell"><span class="b" style="--f:0.6" aria-hidden="true"></span><span class="v">about $525</span></span></div><div role="row"><span role="rowheader"><span class="n">Murrells Inlet and Garden City (ZIP 29576)</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about $6,300 a year</span></span><span role="cell"><span class="b" style="--f:0.6" aria-hidden="true"></span><span class="v">about $525</span></span></div><div role="row"><span role="rowheader"><span class="n">Little River (ZIP 29566)</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about $6,300 a year</span></span><span role="cell"><span class="b" style="--f:0.6" aria-hidden="true"></span><span class="v">about $525</span></span></div><div role="row"><span role="rowheader"><span class="n">Carolina Forest (ZIP 29579)</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about $5,100 a year</span></span><span role="cell"><span class="b" style="--f:0.486" aria-hidden="true"></span><span class="v">about $425</span></span></div><div role="row"><span role="rowheader"><span class="n">Socastee (ZIP 29588)</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">about $4,500 a year</span></span><span role="cell"><span class="b" style="--f:0.429" aria-hidden="true"></span><span class="v">about $375</span></span></div></div></div><figcaption>Half the condos for sale in each ZIP code list higher dues, half lower. ZIP codes with 50 or more condos for sale. A condo held for rent all year, with no personal nights, deducts the whole year of dues.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most Horry County condos for sale say their dues include the building's insurance, water and sewer, trash and internet.</p><figure class="tx-fig"><p class="cap">What Horry County condos for sale say their dues include</p><ul class="tx-inc"><li><strong>91%</strong><span>trash pickup</span></li><li><strong>85%</strong><span>water and sewer</span></li><li><strong>79%</strong><span>insurance on the building</span></li><li><strong>71%</strong><span>internet</span></li><li><strong>27%</strong><span>electric<small>58% in oceanfront buildings</small></span></li></ul><figcaption>Share of condos for sale in Horry County whose listing says the dues include each one. Our count of the condo listings on our site.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On a rental, the insurance, utilities and internet are rental costs too, inside the dues or not.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The deduction needs nights you are allowed to rent. About 7 in 10 condos for sale in Horry County say they allow short-term rentals. When we search for a buyer who plans to rent, we filter out communities that ban renting. Then our agents read the <a href="/hoa/rental-restrictions/" style="color:var(--navy);text-decoration:underline">rental rules</a> in the HOA documents.</p></div></section><section style="background:var(--ivory)" id="property-tax"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="HOA fees and property tax">Do HOA fees count as property tax?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. HOA fees are not a property tax, because an association, not a government, charges them. The IRS says you <a href="https://www.irs.gov/publications/p530" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">cannot deduct them as real estate tax</a>.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A home you live in, once you claim it with the county, is taxed at the 4 percent rate. Rentals, second homes and any home whose owner has not claimed that rate pay 6 percent. An owner who lives in another state pays 6 percent, because the 4 percent rate is only for the owner's <a href="https://www.scstatehouse.gov/code/t12c043.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">domicile</a>.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On a Myrtle Beach condo at the 4 percent rate, a year of dues at the middle for condos for sale in ZIP 29577 is about $9,300. That is about 11 times the 2026 tax bill on a middle-valued condo in the city taxed at that rate, about $830.</p><figure class="tx-fig"><p class="cap">A year of HOA dues against a year of property tax, three condos in Myrtle Beach and North Myrtle Beach</p><ul class="tx-pairs"><li class="hot"><p class="l">Myrtle Beach condo at the 4 percent rate<span class="x">Dues are about 11 times the tax</span></p><div class="row"><span class="k">Dues</span><span class="bar d" style="--f:1.000"></span><span class="v">about $9,300</span></div><div class="row"><span class="k">Tax</span><span class="bar t" style="--f:0.089"></span><span class="v">about $830</span></div></li><li><p class="l">Myrtle Beach condo at the 6 percent rate<span class="x">Dues are about 4 times the tax</span></p><div class="row"><span class="k">Dues</span><span class="bar d" style="--f:1.000"></span><span class="v">about $9,300</span></div><div class="row"><span class="k">Tax</span><span class="bar t" style="--f:0.260"></span><span class="v">about $2,420</span></div></li><li><p class="l">North Myrtle Beach condo at the 6 percent rate<span class="x">Dues are about 2.5 times the tax</span></p><div class="row"><span class="k">Dues</span><span class="bar d" style="--f:0.903"></span><span class="v">about $8,400</span></div><div class="row"><span class="k">Tax</span><span class="bar t" style="--f:0.358"></span><span class="v">about $3,330</span></div></li></ul><figcaption>Dues: the middle monthly dues of condos for sale in ZIP 29577 (Myrtle Beach) or 29582 (North Myrtle Beach), times 12. Tax: the 2026 county bill of the middle-valued condo at that rate in Myrtle Beach or North Myrtle Beach.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On a home you live in, the property tax counts on the federal return if you itemize, meaning you list your deductions instead of taking the standard deduction. The dues never do. On a rental, both are rental expenses.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">The county's 72-day limit</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A condo you live in can be rented for part of the year and keep the 4 percent rate. It keeps that rate only while you still qualify and rent it no more than 72 days in a calendar year. The assessor may ask for your Schedule E.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The <a href="/buyers/property-taxes/" style="color:var(--navy);text-decoration:underline">property tax page</a> explains the two rates and works out the bill at either one.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">What will one condo cost you each year?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the condo you like. We pull its county tax bill, read the association's budget for the dues, and send you both for a year.</p><a class="btn btn-brass" href="/contact/">Have us pull the tax bill and dues</a></div></div></section><section style="background:var(--ivory-2)" id="special-assessments"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Special assessments">Is an HOA special assessment tax deductible?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On a rental, yes if it pays for upkeep, and slowly if it pays for an improvement. On a home you live in, no. A <a href="/hoa/special-assessments/" style="color:var(--navy);text-decoration:underline">special assessment</a> is a one-time bill on top of the dues, usually for a large job.</p><figure class="tx-fig"><p class="cap">Is a special assessment deductible?</p><div class="tx-grid"><div class="yes"><p class="k">Rental, for upkeep</p><b>Deductible the year you pay it</b><p>An assessment for upkeep of the shared parts is a rental expense, like the dues.</p></div><div class="part"><p class="k">Rental, for an improvement</p><b>Spread over 27.5 years</b><p>You deduct a share each year, starting when the work is finished and ready to use. The IRS calls this depreciation.</p></div><div class="no"><p class="k">Your home, for upkeep</p><b>Not deductible</b><p>An assessment for upkeep on a home you live in gives no deduction.</p></div><div class="part"><p class="k">Your condo, for an improvement</p><b>Added to your cost basis</b><p>It gives no deduction the year you pay it. It lowers the taxable gain when you sell.</p></div></div></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Worked example: your share of a roof assessment on a condo you rent out is $10,000. You deduct about $364 a year in each full year, over 27.5 years from when the new roof is in service. In service means finished and ready to use.</p><figure class="tx-fig"><p class="cap">A $10,000 roof assessment on a condo you rent out, spread over the years</p><ul class="tx-roof"><li><strong>$10,000</strong><span>your share of the roof, paid to the association</span></li><li><strong>27.5 years</strong><span>the period the IRS uses for a rental home and its roof</span></li><li class="hot"><strong>about $364</strong><span>deducted in each full year; the first and last years are less</span></li></ul></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our page on <a href="/invest/rental-depreciation/" style="color:var(--navy);text-decoration:underline">rental depreciation</a> shows how the first and last years are counted.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On a condo you live in, an assessment that is not just for repairs or upkeep is added to your cost basis, what the home cost you. The basis rarely matters on a main home. If you qualify, the <a href="https://www.irs.gov/publications/p523" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">first $250,000 of gain</a> is not taxed, or $500,000 for a married couple filing jointly.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Whether a job is upkeep or an improvement depends on the work. The assessment notice and the board's minutes say what the work is.</p></div></section><section style="background:var(--ivory)" id="south-carolina"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="South Carolina and owners out of state">Does South Carolina treat HOA fees differently?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. <a href="https://www.scstatehouse.gov/code/t12c006.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">South Carolina starts from the federal figures</a>, so the same rules on dues, rental days and depreciation apply on the state return. From 2026, <a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/4216.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">South Carolina does not use</a> the federal itemized deductions. That does not touch the dues on a rental, which come off the rent, not off a list of itemized deductions.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">About 6 in 10 Horry County condo units have their tax bill mailed to an address outside South Carolina. For an owner who lives in another state, the rent from a Grand Strand condo, less its costs and dues, is South Carolina income.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On the South Carolina return, the dues come off that rent the same way they do on the federal return. How your home state treats the same rent depends on that state's law, not South Carolina's.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-a/hoa-tax-deductible/myrtle-beach-condo-tower-1200w.webp" srcset="/images/2026-11-a/hoa-tax-deductible/myrtle-beach-condo-tower-600w.webp 600w, /images/2026-11-a/hoa-tax-deductible/myrtle-beach-condo-tower-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="1125" alt="A tall blue, gray and yellow condo tower in Myrtle Beach at dusk, with palm trees in front" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/licenses/by/2.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: Carl Dunn. License: CC BY 2.0" title="License: CC BY 2.0">Photo: Carl Dunn</a></span></div><figcaption>A condo tower in Myrtle Beach. Inside the city, only about 1 in 11 condo units is taxed at the 4 percent rate as the home its owner lives in.</figcaption></figure></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Across Horry County, only about 1 in 5 condo units is taxed at the 4 percent rate as the home its owner lives in. Our <a href="/invest/condos/" style="color:var(--navy);text-decoration:underline">condo investing page</a> has the counts by town.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Buying a Grand Strand condo from another state?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We read the building's rental rules and budget, pull its tax bill, and send you what the dues and the tax come to in a year.</p><a class="btn btn-brass" href="/contact/">Send us the condo you like</a></div></div></section><section style="background:var(--ivory-2)" id="schedule-e"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Schedule E and records">Where do HOA fees go on Schedule E, and what records do I keep?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Schedule E has no line for association dues. An expense not listed on lines 5 to 18 goes on <a href="https://www.irs.gov/instructions/i1040se" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">line 19, Other</a>.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Line 2 asks for the nights rented at a fair price and the nights of personal use. Keep these four records:</p><ol class="tx-steps" aria-label="The records to keep for the dues on a rental"><li><span class="n" aria-hidden="true">1</span><span class="c"><b>The association's statements</b>They show what you paid in dues and in any special assessment, and when.</span></li><li><span class="n" aria-hidden="true">2</span><span class="c"><b>A log of nights</b>Write down each night rented at a fair price, each personal night and each repair day, as they happen.</span></li><li><span class="n" aria-hidden="true">3</span><span class="c"><b>The assessment notice and the minutes</b>They say what an assessment paid for, which decides whether it is upkeep or an improvement.</span></li><li><span class="n" aria-hidden="true">4</span><span class="c"><b>The two night counts</b>Give them to whoever prepares your return. Schedule E asks for both.</span></li></ol><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The <a href="/hoa/documents/" style="color:var(--navy);text-decoration:underline">HOA documents page</a> lists what each paper shows. What you pay the association at closing is on our page on <a href="/hoa/estoppel-and-transfer-fees/" style="color:var(--navy);text-decoration:underline">transfer fees</a>.</p></div></section><section style="background:var(--ivory)" id="hoa-fees-and-taxes-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">HOA fees and taxes FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Are HOA fees tax deductible on my primary residence?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. On a home you live in, HOA and condo fees are a personal cost, like insurance and utilities. They are not a property tax either, because an association, not a government, charges them.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Are HOA fees deductible on a rental property?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. On a condo you rent out, the dues are a rental expense on Schedule E. On a house in an HOA that you rent out, the dues are a cost of renting it, like insurance and repairs.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Are HOA fees deductible on a second home I do not rent?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. A second home you never rent follows the same rule as a main home. If you rent it for 15 days or more, the rented share of the nights becomes deductible.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I deduct HOA fees if I work from home?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not as an employee: an employee gets no home office deduction. A self-employed owner who qualifies splits whole-home costs by the share of the home used for business. The IRS's examples are insurance, utilities and general repairs. Its home office guide does not say whether association dues count, so this page does not say they do.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do HOA special assessments lower capital gains when I sell?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On a condo you live in, an assessment for an improvement is added to your cost basis, which lowers the taxable gain. If you qualify, the first $250,000 of gain on a main home is not taxed, or $500,000 for a married couple filing jointly.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do family stays count as personal use?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, unless the relative rents it at a fair price as their main home. A stay by you, a co-owner or a relative is a personal night, and so is any night rented below a fair price.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.irs.gov/publications/p527" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">IRS Pub. 527</a>, <a href="https://www.irs.gov/publications/p530" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">IRS Pub. 530</a>, <a href="https://www.irs.gov/publications/p523" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">IRS Pub. 523</a>, <a href="https://www.irs.gov/publications/p587" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">IRS Pub. 587</a>, <a href="https://www.irs.gov/instructions/i1040se" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Schedule E instructions</a>, <a href="https://www.scstatehouse.gov/code/t12c006.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-6</a>, <a href="https://www.scstatehouse.gov/code/t12c037.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-37</a>, <a href="https://www.scstatehouse.gov/code/t12c043.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-43</a>, <a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/4216.htm" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Act 110 (H. 4216)</a>, <a href="https://horrycountytreasurer.qpaybill.com/Taxes/TaxesDefaultType4.aspx" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County Treasurer</a>. Condo counts: Horry County parcel records. Dues and what they include: CCMLS listings on our site, counted in total. Not tax advice.</p><p style="font-size:.95rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1rem"><strong style="color:var(--navy)">Tax notice.</strong> Chapter3 Realty Corp is a licensed South Carolina real estate brokerage. We do not prepare tax returns, and nothing on this page is tax advice.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">A condo tower in Myrtle Beach. Photo: Carl Dunn, <a href="https://creativecommons.org/licenses/by/2.0/" target="_blank" rel="noopener noreferrer">CC BY 2.0</a>, via <a href="https://commons.wikimedia.org/wiki/File:Atlantica_III_%26_II,_Myrtle_Beach,_SC.jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>. Chapter3 Realty cropped and resized the photo.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-11-a/hoa-tax-deductible/myrtle-beach-condo-tower-1200w.webp","url":"https://chapter3realty.com/images/2026-11-a/hoa-tax-deductible/myrtle-beach-condo-tower-