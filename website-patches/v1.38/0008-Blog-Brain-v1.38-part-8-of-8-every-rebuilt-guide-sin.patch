ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}.c3ph-gal{display:grid;grid-template-columns:minmax(0,1fr);gap:1.5rem;margin:1.6rem 0;padding:0;list-style:none}.c3ph-gal>figure{margin:0;min-width:0}.c3ph-gal img{aspect-ratio:var(--c3ph-r,4/3)}.c3ph-gal figcaption{color:var(--muted);font-size:.85rem;line-height:1.45;margin-top:.5rem}@media (min-width:700px){.c3ph-gal{display:grid;grid-template-columns:repeat(var(--c3ph-n,3),minmax(0,1fr));gap:1rem;overflow:visible;padding:0}.c3ph-gal>figure{min-width:0}}@media (max-width:699px){.c3ph-gal.c3ph-row{display:flex;gap:.75rem;padding:0 var(--c3ph-bleed,1.4rem) .4rem;margin:1.6rem calc(-1*var(--c3ph-bleed,1.4rem)) 0;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding:0 var(--c3ph-bleed,1.4rem);-webkit-overflow-scrolling:touch;scrollbar-width:none}.c3ph-row::-webkit-scrollbar{display:none}.c3ph-row>figure{flex:0 0 82%;scroll-snap-align:start}}.c3ph-swipe{display:flex;align-items:center;gap:.75rem;margin:.5rem 0 1.6rem;color:var(--navy);font:500 .95rem/1.3 var(--sans)}.c3ph-dots{display:inline-flex;gap:.45rem}.c3ph-dots i{display:block;width:10px;height:10px;border-radius:50%;border:1.5px solid var(--navy);box-sizing:border-box}.c3ph-dots i:first-child{background:var(--navy)}@supports (animation-timeline:view()){.c3ph-rowbox{timeline-scope:--c3ph-p1,--c3ph-p2,--c3ph-p3}.c3ph-row>figure:nth-child(1){view-timeline:--c3ph-p1 inline}.c3ph-row>figure:nth-child(2){view-timeline:--c3ph-p2 inline}.c3ph-row>figure:nth-child(3){view-timeline:--c3ph-p3 inline}.c3ph-dots i{animation:c3ph-dot linear both;animation-range:cover}.c3ph-dots i:nth-child(1){animation-timeline:--c3ph-p1}.c3ph-dots i:nth-child(2){animation-timeline:--c3ph-p2}.c3ph-dots i:nth-child(3){animation-timeline:--c3ph-p3}@keyframes c3ph-dot{0%,36%{background:transparent}42%,60%{background:var(--navy)}66%,100%{background:transparent}}}@media (min-width:700px){.c3ph-swipe{display:none}}.c3ph-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:1.4rem 0 1.8rem;padding:0;list-style:none}@media (min-width:700px){.c3ph-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}}@media (min-width:1000px){.c3ph-cards.c3ph-4{grid-template-columns:repeat(4,minmax(0,1fr))}}.c3ph-card{margin:0;background:var(--ivory);border:1px solid var(--rule);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}.c3ph-card .c3ph-f{border-radius:0}.c3ph-card img,.c3ph-card svg{display:block;width:100%;height:auto;aspect-ratio:var(--c3ph-r,4/3);object-fit:cover}.c3ph-card .c3ph-cr{font-size:.56rem;padding:1.2rem .45rem .25rem 1.6rem}.c3ph-card strong{display:block;color:var(--navy);font-size:.98rem;font-weight:500;line-height:1.3;padding:.7rem .8rem 0}.c3ph-card span.c3ph-t{display:block;color:var(--muted);font-size:.86rem;line-height:1.45;padding:.2rem .8rem .85rem}.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:720px}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">South Carolina's HOA laws are three state laws, plus the papers each community records at the county. Consumer Affairs lists the three: the HOA Act, the Nonprofit Corporation Act and the condo law.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Each common question has its answer in one of them, or in your HOA's own papers:</p><div class="c3-sl-tab c3-sl-law"><table><caption>South Carolina HOA law, question by question</caption><thead><tr><th scope="col">Question</th><th scope="col">What South Carolina law says</th><th scope="col">Read more</th></tr></thead><tbody><tr><th scope="row">Do the HOA's papers have to be recorded?</th><td>Yes. The papers count only once they are recorded at the county. A new rule must be recorded by January 10 of the next year. <span class="sec">SC Code 27-30-130</span></td><td class="more"><span class="l">Read more</span><a href="#unenforceable" style="color:var(--navy);text-decoration:underline">Unenforceable rules</a><a href="/hoa/documents/" style="color:var(--navy);text-decoration:underline">HOA documents</a></td></tr><tr><th scope="row">Does the HOA have to give notice before raising the budget?</th><td>48 hours' notice of the vote, unless the HOA is a nonprofit. A nonprofit HOA follows its bylaws. <span class="sec">SC Code 27-30-140</span></td><td class="more"><span class="l">Read more</span><a href="/hoa/dues-increases/" style="color:var(--navy);text-decoration:underline">Dues increases</a></td></tr><tr><th scope="row">Can owners see the HOA's records?</th><td>Yes. The budget and owner list, and more if the HOA is a nonprofit. In a condo, the account book too. <span class="sec">SC Code 27-30-150</span></td><td class="more"><span class="l">Read more</span><a href="#records" style="color:var(--navy);text-decoration:underline">Records and meetings</a></td></tr><tr><th scope="row">Must board meetings be open to owners?</th><td>No state law requires it. A nonprofit HOA must hold an owners' meeting once a year. <span class="sec">SC Code 33-31-701</span></td><td class="more"><span class="l">Read more</span><a href="#records" style="color:var(--navy);text-decoration:underline">Records and meetings</a></td></tr><tr><th scope="row">Is there a cap on HOA fines?</th><td>No. Neither the HOA Act nor the condo law caps fines or says a hearing must come before one. Whether a fine can become a lien depends on the papers.</td><td class="more"><span class="l">Read more</span><a href="/hoa/violations-and-fines/" style="color:var(--navy);text-decoration:underline">Violations and fines</a></td></tr><tr><th scope="row">Can the HOA foreclose?</th><td>Yes, through the court. A condo's lien is in the condo law. A neighborhood's is in its recorded papers. <span class="sec">SC Code 27-31-210</span></td><td class="more"><span class="l">Read more</span><a href="/hoa/liens-and-foreclosure/" style="color:var(--navy);text-decoration:underline">Liens and foreclosure</a></td></tr><tr><th scope="row">Is there a cap on dues or special assessments?</th><td>No. State law also requires no reserve fund.</td><td class="more"><span class="l">Read more</span><a href="/hoa/special-assessments/" style="color:var(--navy);text-decoration:underline">Special assessments</a><a href="/hoa/reserves/" style="color:var(--navy);text-decoration:underline">Reserves</a></td></tr><tr><th scope="row">Can the HOA ban rentals?</th><td>Yes, if its recorded papers say so. State law has no limit on rental rules, and no rule that exempts earlier buyers. <span class="sec">SC Code 27-31-100</span></td><td class="more"><span class="l">Read more</span><a href="/hoa/rental-restrictions/" style="color:var(--navy);text-decoration:underline">Rental restrictions</a></td></tr><tr><th scope="row">When must the developer hand the HOA to the owners?</th><td>There is no deadline in state law.</td><td class="more"><span class="l">Read more</span><a href="/hoa/developer-control-turnover/" style="color:var(--navy);text-decoration:underline">Developer turnover</a></td></tr><tr><th scope="row">Can the HOA ban the U.S. flag?</th><td>Not one portable, removable U.S. flag, shown in a respectful manner. <span class="sec">SC Code 27-1-60</span></td><td class="more"><span class="l">Read more</span><a href="#unenforceable" style="color:var(--navy);text-decoration:underline">Unenforceable rules</a></td></tr><tr><th scope="row">Who takes complaints about an HOA?</th><td>Consumer Affairs records them and sends each one to the HOA. The law bars it from acting as a referee. <span class="sec">SC Code 27-30-340</span></td><td class="more"><span class="l">Read more</span><a href="#complaint" style="color:var(--navy);text-decoration:underline">Complaints</a></td></tr><tr><th scope="row">Where can a money dispute go?</th><td>Magistrate court, for $7,500 or less. <span class="sec">SC Code 27-30-160</span></td><td class="more"><span class="l">Read more</span><a href="#who-enforces" style="color:var(--navy);text-decoration:underline">Who enforces</a></td></tr></tbody></table></div></div></section><section style="background:var(--ivory)" id="which-law"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Which applies">Which South Carolina law applies to my HOA or condo?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The HOA Act applies to every HOA and condo whose owners must pay assessments. A nonprofit HOA also follows the Nonprofit Corporation Act, and a condo also follows the condo law.</p><ul class="c3-sl-rules c3-sl-one"><li><strong>The HOA Act</strong><span>Every neighborhood or condo where recorded papers make owners pay assessments, except a timeshare. The HOA Act dates from 2018. It has been changed once, in 2019, when its definition of an HOA was edited where it leaves out timeshares.</span></li><li><strong>The Nonprofit Corporation Act</strong><span>An HOA that filed nonprofit papers with the Secretary of State also follows this law on meetings, notice, the board and records. Whether an HOA did shows in the <a href="https://businessfilings.sc.gov/BusinessFiling/Entity/Search" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Secretary of State's business name search</a>.</span></li><li><strong>The condo law</strong><span>The Horizontal Property Act, from 1962, applies to condos. It says what a condo's founding papers and bylaws must include, how records are kept and how shared costs are split.</span></li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The HOA Act itself is short. It deals with five things: recording the papers, notice before a budget increase, the budget and owner list, magistrate court for money disputes, and complaints to Consumer Affairs.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The HOA Act has no rule on late fees, fines, liens or foreclosure.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A property owners association is an HOA under the Act if it meets the same test; our page on <a href="/hoa/hoa-vs-poa/" style="color:var(--navy);text-decoration:underline">HOA vs POA</a> explains the names. An owner cannot opt out, because the recorded papers require each owner to pay. Our <a href="/hoa/" style="color:var(--navy);text-decoration:underline">HOA guide</a> shows what the fees pay for.</p></div></section><section style="background:var(--ivory-2)" id="other-states"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Other states">How do South Carolina's HOA laws compare with North Carolina and Florida?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Households moving to Horry County come most often from other South Carolina counties, then North Carolina, New York, New Jersey, Pennsylvania, Florida and Maryland. North Carolina and Florida both limit HOA fines in law:</p><div class="c3-sl-tab c3-sl-states"><table><caption>HOA fines in three states</caption><thead><tr><th scope="col">State</th><th scope="col">Cap on a fine</th><th scope="col">Hearing before a fine</th></tr></thead><tbody><tr><th scope="row">South Carolina</th><td><span class="l">Cap on a fine</span>None in the HOA Act or the condo law</td><td><span class="l">Hearing before a fine</span>Not required by either law</td></tr><tr><th scope="row">North Carolina</th><td><span class="l">Cap on a fine</span>Up to $100 for the violation, and up to $100 for each day it goes on more than five days after the decision</td><td><span class="l">Hearing before a fine</span>Yes, unless the declaration has its own process. If a panel made the decision, the owner may appeal to the full board within 15 days.</td></tr><tr><th scope="row">Florida</th><td><span class="l">Cap on a fine</span>$100 a violation, and $1,000 in all for one that goes on, unless the papers say otherwise. A fine under $1,000 cannot become a lien.</td><td><span class="l">Hearing before a fine</span>Yes, with 14 days' written notice. The hearing is before a committee of at least three members who are not officers, directors or employees of the association, or their close relatives.</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Florida's limits cover HOAs, not condos. North Carolina's cover planned communities.</p><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Moving here from another state? Have us read the papers against how you live</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">The biggest mistake New York buyers make is not checking that the community's rules fit how they live: HOA rules on boats, golf carts, rentals and pools. We read them against your plans before you offer.</p><a class="btn btn-brass" href="/contact/">Have us read the papers</a></div></div></section><section style="background:var(--ivory)" id="unenforceable"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Unenforceable rules">What HOA rules are unenforceable in South Carolina?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">An HOA rule is unenforceable in South Carolina if it was not recorded at the county by January 10 of the year after it was adopted or changed.</p><ul class="c3-sl-rules c3-sl-one"><li><strong>A rule not recorded in time</strong><span>A rule takes effect when it is adopted. It stays enforceable only if it is recorded by January 10 of the next year. The HOA must give you a copy on request, unless it is posted in a common area or on its website.</span></li><li><strong>Papers never recorded</strong><span>An HOA's governing papers must be recorded in the county where the property is to be enforceable.</span></li><li><strong>An amendment without the vote</strong><span>A South Carolina appeals court <a href="https://www.sccourts.org/media/opinions/HTMLFiles/COA/5312.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">threw out an amendment</a> to a subdivision's restrictions because it did not have the vote the restrictions required.</span></li><li><strong>A ban on the U.S. flag</strong><span>Whatever the papers say, an owner or tenant may display one portable, removable U.S. flag in a respectful manner, on the property they are entitled to use.</span></li><li><strong>An unclear rule</strong><span>It can be read against the HOA. In a <a href="https://www.sccourts.org/media/opinions/HTMLFiles/COA/5525.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Hilton Head rental case</a>, the court took the reading that "least restricts the use of the property", and both sides agreed short-term renting was allowed. Our page on <a href="/hoa/rental-restrictions/" style="color:var(--navy);text-decoration:underline">HOA rental restrictions</a> tells the story.</span></li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Horry County's <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeDocType" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">index of recorded papers</a> is online, and copies come from the Register of Deeds in Conway. Our page on <a href="/hoa/documents/" style="color:var(--navy);text-decoration:underline">HOA documents before you buy</a> shows which papers to get.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Have us pull a community's recorded rules before you offer</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the community's name. We ask the seller for the papers and check the county's index for each rule's recording, so you know which rules count.</p><a class="btn btn-brass" href="/contact/">Have us pull the recorded rules</a></div></div></section><section style="background:var(--ivory-2)" id="records"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Records and meetings">Can I see my HOA's records and go to its meetings?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes to the records. A nonprofit HOA must also hold an owners' meeting each year, but owners have no right under state law to attend board meetings.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">The records you can see</h3><ul class="c3-sl-rules c3-sl-one"><li><strong>An HOA that is not a nonprofit</strong><span>Its yearly budget and owner list.</span></li><li><strong>A nonprofit HOA</strong><span>Its articles, bylaws, minutes of owners' meetings and three years of financial statements. You can inspect and copy them with written notice five business days ahead, paying only for copies.</span></li><li><strong>A condo</strong><span>The board must keep a dated book of every receipt and expense. It is open to all owners at set hours on working days.</span></li></ul><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">The meetings you can go to</h3><ul class="c3-sl-rules c3-sl-one"><li><strong>A yearly owners' meeting</strong><span>A nonprofit HOA must hold one each year. Notice 10 to 60 days ahead is fair under the law, or 30 to 60 days if it is not sent first class or registered.</span></li><li><strong>A special meeting</strong><span>Owners with at least 5 percent of the votes can demand one.</span></li><li><strong>Board meetings</strong><span>The Nonprofit Corporation Act's notice rules for board meetings are about notice to directors. Owners have no right under it to notice of a board meeting, and no right under any of the three laws to attend one. Bylaws can give both.</span></li><li><strong>A condo owners' vote</strong><span>Decisions need a majority of at least 51 percent, counted by the units' value percentages. Changing the system of running the building takes owners with two-thirds of the value.</span></li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">When you buy, the seller must tell you about the HOA. Unless the sale is exempt, the seller fills in the state's disclosure form before the contract is signed. If the home is in an association, that includes a one-page HOA addendum.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our page on <a href="/hoa/documents/" style="color:var(--navy);text-decoration:underline">what to check in HOA documents</a> lists the papers we get from the seller.</p></div></section><section style="background:var(--ivory)" id="who-enforces"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Who enforces">Who enforces South Carolina HOA law?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No state agency enforces South Carolina's HOA Act. In its own words, Consumer Affairs "does not administer or enforce" the Act. It records each complaint and sends it to the HOA.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The law bars Consumer Affairs from issuing rules on how an HOA is run, and from acting as a referee in a dispute. Its complaint process is voluntary mediation. It cannot make an HOA or an owner take part, require an outcome or arbitrate.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Where an owner can take a dispute</h3><ul class="c3-sl-rules c3-sl-one"><li><strong>Magistrate court</strong><span>A money dispute under the HOA Act of $7,500 or less can go to magistrate court.</span></li><li><strong>The condo law</strong><span>In a condo, the board, or an owner who is harmed, can sue an owner who breaks the bylaws or the recorded restrictions, for damages or a court order.</span></li><li><strong>A lawyer</strong><span>The <a href="https://www.scbar.org/for-the-public/quicklinks/get-legal-help/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Bar</a> runs a lawyer referral service, at 800-868-2284.</span></li></ul></div></section><section style="background:var(--ivory-2)" id="complaint"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Complaints">How do I file an HOA complaint in South Carolina?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">File an HOA complaint with the SC Department of Consumer Affairs, online or by mail, and send the HOA Supplemental Questionnaire with it.</p><ol class="c3-sl-steps"><li><strong>Raise it with the board first</strong><span>Talk with the board, and check your HOA's papers for a dispute process. That is Consumer Affairs' first advice. 98 percent of those who filed in 2025 said they had raised the issue with the HOA or its management company first.</span></li><li><strong>File online or by mail</strong><span>Use Consumer Affairs' <a href="https://consumer.sc.gov/consumer-resources/consumer-complaints" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">online complaint portal</a>, or mail the paper form to PO Box 5757, Columbia, SC 29250. The online form times out after 30 minutes.</span></li><li><strong>Send the HOA Supplemental Questionnaire</strong><span>Consumer Affairs requires it. In the same year, 78 complaints were closed and left out of its report because the owner did not send it. Questions go to hoahelp@scconsumer.gov or (800) 922-1594, toll free in South Carolina.</span></li><li><strong>Consumer Affairs sends it to the HOA</strong><span>The HOA may answer. The agency cannot make it take part.</span></li><li><strong>The complaint is closed</strong><span>Consumer Affairs closes it and counts it in its yearly report. It says the data helps lawmakers decide if the law needs to change.</span></li></ol><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Horry County leads the state. In 2025, 140 of the 452 HOA complaints in the state's yearly report, 31 percent, were about associations in Horry County. That is the most of any county.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We counted how the state closed Horry County's 416 complaints over four years, 2022 to 2025:</p><figure class="c3-sl-fig"><p class="cap">Only 10 of 416 Horry County HOA complaints ended with the owner satisfied</p><svg class="kn" viewBox="0 0 360 318" role="img" aria-label="Bar chart of how SC Consumer Affairs closed 416 Horry County HOA complaints. The HOA answered every point: 269. Facts in dispute, left undecided: 101. The HOA never answered: 19. Still open when the report was made: 15. The owner was satisfied: 10. The owner did not send what the state asked for: 2." style="font-family:var(--sans),system-ui,sans-serif"><text x="0" y="19" font-size="15" fill="#1c2028">The HOA answered every point</text><rect x="0" y="28" width="306.0" height="16" rx="8" fill="#a7b0ba"/><text x="314.0" y="41" font-size="15" font-weight="700" fill="#1c2028">269</text><text x="0" y="71" font-size="15" fill="#1c2028">Facts in dispute, left undecided</text><rect x="0" y="80" width="114.9" height="16" rx="8" fill="#a7b0ba"/><text x="122.9" y="93" font-size="15" font-weight="700" fill="#1c2028">101</text><text x="0" y="123" font-size="15" fill="#1c2028">The HOA never answered</text><rect x="0" y="132" width="21.6" height="16" rx="8" fill="#a7b0ba"/><text x="29.6" y="145" font-size="15" font-weight="700" fill="#1c2028">19</text><text x="0" y="175" font-size="15" fill="#1c2028">Still open when the report was made</text><rect x="0" y="184" width="17.1" height="16" rx="8" fill="#a7b0ba"/><text x="25.1" y="197" font-size="15" font-weight="700" fill="#1c2028">15</text><text x="0" y="227" font-size="15" fill="#1c2028" font-weight="700">The owner was satisfied</text><rect x="0" y="236" width="11.4" height="16" rx="8" fill="#c4783a"/><text x="19.4" y="249" font-size="15" font-weight="700" fill="#8a5226">10</text><text x="0" y="279" font-size="15" fill="#1c2028">The owner did not send what the state asked for</text><rect x="0" y="288" width="4.0" height="16" rx="8" fill="#a7b0ba"/><text x="12.0" y="301" font-size="15" font-weight="700" fill="#1c2028">2</text></svg><svg class="kw" viewBox="0 0 640 210" role="img" aria-label="Bar chart of how SC Consumer Affairs closed 416 Horry County HOA complaints. The HOA answered every point: 269. Facts in dispute, left undecided: 101. The HOA never answered: 19. Still open when the report was made: 15. The owner was satisfied: 10. The owner did not send what the state asked for: 2." style="font-family:var(--sans),system-ui,sans-serif"><text x="0" y="25" font-size="15" fill="#1c2028">The HOA answered every point</text><rect x="372" y="12" width="214.0" height="16" rx="8" fill="#a7b0ba"/><text x="594.0" y="25" font-size="15" font-weight="700" fill="#1c2028">269</text><text x="0" y="59" font-size="15" fill="#1c2028">Facts in dispute, left undecided</text><rect x="372" y="46" width="80.3" height="16" rx="8" fill="#a7b0ba"/><text x="460.3" y="59" font-size="15" font-weight="700" fill="#1c2028">101</text><text x="0" y="93" font-size="15" fill="#1c2028">The HOA never answered</text><rect x="372" y="80" width="15.1" height="16" rx="8" fill="#a7b0ba"/><text x="395.1" y="93" font-size="15" font-weight="700" fill="#1c2028">19</text><text x="0" y="127" font-size="15" fill="#1c2028">Still open when the report was made</text><rect x="372" y="114" width="11.9" height="16" rx="8" fill="#a7b0ba"/><text x="391.9" y="127" font-size="15" font-weight="700" fill="#1c2028">15</text><text x="0" y="161" font-size="15" fill="#1c2028" font-weight="700">The owner was satisfied</text><rect x="372" y="148" width="8.0" height="16" rx="8" fill="#c4783a"/><text x="388.0" y="161" font-size="15" font-weight="700" fill="#8a5226">10</text><text x="0" y="195" font-size="15" fill="#1c2028">The owner did not send what the state asked for</text><rect x="372" y="182" width="4.0" height="16" rx="8" fill="#a7b0ba"/><text x="384.0" y="195" font-size="15" font-weight="700" fill="#1c2028">2</text></svg><figcaption>Our count of SC Consumer Affairs' complaint files for Horry County, 2022 to 2025. "The HOA answered every point" is the state's "adequate business response". It means the HOA answered every point and named a policy that backs it, whether or not the owner was satisfied. The middle complaint took 33 days to close.</figcaption></figure><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Done with HOA boards? We find homes with no HOA</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us the area and your price. We send you homes for sale with no HOA fee.</p><a class="btn btn-brass" href="/contact/">Send me homes with no HOA</a></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our page on <a href="/buyers/no-hoa-homes/" style="color:var(--navy);text-decoration:underline">homes with no HOA near Myrtle Beach</a> shows the areas where they are.</p></div></section><section style="background:var(--ivory)" id="changes"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Changes">Is South Carolina changing its HOA laws?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not yet. None of the five HOA bills below, from the 2025-2026 session, has become law.</p><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-11-b/hoa-south-carolina-hoa-laws/south-carolina-state-house-columbia-1200w.webp" srcset="/images/2026-11-b/hoa-south-carolina-hoa-laws/south-carolina-state-house-columbia-600w.webp 600w, /images/2026-11-b/hoa-south-carolina-hoa-laws/south-carolina-state-house-columbia-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="676" alt="The South Carolina State House in Columbia, a granite building with tall columns, a wide stair and a copper dome under a blue sky" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: Farragutful. License: CC BY-SA 4.0" title="License: CC BY-SA 4.0">Photo: Farragutful</a></span></div><figcaption>The South Carolina State House in Columbia, where the General Assembly meets.</figcaption></figure></div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Five HOA bills from the 2025-2026 session</h3><ul class="c3-sl-rules c3-sl-one"><li><strong><a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/3447" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">H. 3447</a></strong><span>A court hearing before an HOA foreclosure sale. Passed the House 110 to 2; now in the Senate Judiciary Committee.</span></li><li><strong><a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/903" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">S. 903</a></strong><span>Would count rules as governing documents, hold them all to the January 10 recording rule, and from 2027 require them to be witnessed and acknowledged to be recorded. Passed the Senate 39 to 0; now in a House committee.</span></li><li><strong><a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/366" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">S. 366</a></strong><span>Would void foreclosure clauses in HOA papers. In the Senate Judiciary Committee.</span></li><li><strong><a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/3350" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">H. 3350</a></strong><span>Would require a dispute process inside every HOA, and let magistrate court hear all matters between an owner and an HOA. In the House.</span></li><li><strong><a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/5204" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">H. 5204</a></strong><span>Would require a seller packet, and a minimum debt, notice and mediation before foreclosure. In a House committee.</span></li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our page on <a href="/hoa/liens-and-foreclosure/" style="color:var(--navy);text-decoration:underline">HOA foreclosure in South Carolina</a> has more on the foreclosure bills.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What Horry County complaints would change</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">When they file, owners must say what they would change in their HOA's papers and how the papers should be enforced. Of 416 Horry County complaints, 171 named open meetings and notice rules.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="The change Horry County HOA complaints named most: open meetings"><span class="cap" aria-hidden="true">The change Horry County HOA complaints named most: open meetings</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Change to the HOA's papers</span><span role="columnheader">Complaints</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n"><a href="#records">Open meetings and notice</a></span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">171 of 416</span></span></div><div role="row"><span role="rowheader"><span class="n"><a href="/hoa/documents/">Rules for seeing and copying records</a></span></span><span role="cell"><span class="b" style="--f:0.725" aria-hidden="true"></span><span class="v">124 of 416</span></span></div><div role="row"><span role="rowheader"><span class="n"><a href="/hoa/liens-and-foreclosure/">A ban on HOA liens and foreclosure</a></span></span><span role="cell"><span class="b" style="--f:0.491" aria-hidden="true"></span><span class="v">84 of 416</span></span></div><div role="row"><span role="rowheader"><span class="n"><a href="/hoa/developer-control-turnover/">Rules for developer turnover</a></span></span><span role="cell"><span class="b" style="--f:0.45" aria-hidden="true"></span><span class="v">77 of 416</span></span></div></div></div><figcaption>Our count of 416 Horry County complaints to SC Consumer Affairs, 2022 to 2025. A complaint could name more than one change. Each topic links to the page that covers it.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On enforcement, 210 of the 416 named state agency oversight, and 183 named a dispute process inside the HOA.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Statewide, in the state's latest report, state agency oversight was also the top choice for enforcing the papers, at 31 percent of all recommendations.</p></div></section><section style="background:var(--ivory-2)" id="south-carolina-hoa-law-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">South Carolina HOA law FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What is the South Carolina Homeowners Association Act?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The HOA Act is a 2018 state law, SC Code Title 27, Chapter 30. It requires an HOA's papers to be recorded at the county to be enforced, and gives owners the budget and owner list. It lets magistrate court hear money disputes under the Act, and requires Consumer Affairs to record complaints. It has been changed once, in 2019.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Who regulates HOAs in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No state agency enforces South Carolina's HOA Act. Consumer Affairs records complaints and sends each one to the HOA, and the law bars it from acting as a referee. An HOA that is a nonprofit files its papers with the Secretary of State. The rest is in each community's recorded papers.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I complain about my HOA to the state?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. File with SC Consumer Affairs online or by mail, with the HOA Supplemental Questionnaire. The agency sends the complaint to the HOA, but its process is voluntary mediation. Of 416 Horry County complaints from 2022 to 2025, 10 ended with the owner satisfied.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Do HOA documents have to be recorded in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. Under the HOA Act, an HOA's governing papers must be recorded at the county's register of deeds to be enforceable. A new rule stays enforceable only if it is recorded by January 10 of the year after it was adopted.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does a seller have to disclose an HOA in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, unless the sale is exempt. The seller fills in the state's disclosure form before the contract is signed. If the home is in an association, the form includes a one-page HOA addendum.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I sue my HOA in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A money dispute under the HOA Act of $7,500 or less can go to magistrate court. For anything larger, or any other dispute, talk to a South Carolina attorney. The SC Bar's lawyer referral service is at 800-868-2284.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Is condo law different from HOA law in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. A condo follows the HOA Act and also the Horizontal Property Act, the state's condo law. The condo law puts a lien on a unit for unpaid assessments and opens the condo's account book to owners. It also requires a condo's founding papers to state any limits on leasing.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.scstatehouse.gov/code/t27c030.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 27-30</a>, <a href="https://www.scstatehouse.gov/code/t27c031.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">27-31</a>, <a href="https://www.scstatehouse.gov/code/t33c031.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">33-31</a>, <a href="https://www.scstatehouse.gov/code/t27c001.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">27-1-60</a>, <a href="https://www.scstatehouse.gov/code/t27c050.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">27-50</a>, <a href="https://www.scstatehouse.gov/code/t22c003.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">22-3</a>, <a href="https://consumer.sc.gov/hoa-ed" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SCDCA HOA page</a>, <a href="https://consumer.sc.gov/consumer-resources/consumer-complaints" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SCDCA complaints</a>, <a href="https://consumer.sc.gov/sites/consumer/files/Documents/HOA/2026_HOA_Complaint_Report.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SCDCA report</a>, <a href="https://www.consumer.sc.gov/HOA-reports" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SCDCA workbooks</a>, <a href="https://businessfilings.sc.gov/BusinessFiling/Entity/Search" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC business filings</a>, <a href="https://www.sccourts.org/media/opinions/HTMLFiles/COA/5525.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Op. 5525</a>, <a href="https://www.sccourts.org/media/opinions/HTMLFiles/COA/5312.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Op. 5312</a>, <a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/3447" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">H. 3447</a>, <a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/903" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">S. 903</a>, <a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/366" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">S. 366</a>, <a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/3350" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">H. 3350</a>, <a href="https://www.scstatehouse.gov/sess126_2025-2026/bills/5204" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">H. 5204</a>, <a href="https://www.ncleg.gov/EnactedLegislation/Statutes/HTML/BySection/Chapter_47F/GS_47F-3-107.1.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">NC 47F-3-107.1</a>, <a href="https://www.flsenate.gov/Laws/Statutes/2026/720.305" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Fla. 720.305</a>, <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeDocType" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry deeds</a>, <a href="https://www.scbar.org/for-the-public/quicklinks/get-legal-help/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Bar</a>, <a href="https://www.irs.gov/statistics/soi-tax-stats-migration-data" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">IRS migration</a>. Our counts: Horry County complaints in the SCDCA workbooks, 2022 to 2025, and the county's index of association papers.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1rem"><strong style="color:var(--navy)">Legal notice.</strong> Chapter3 Realty Corp is a licensed South Carolina real estate brokerage. We are not attorneys, and nothing on this page is legal advice. For advice on your own dispute, talk to a South Carolina attorney.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">The South Carolina State House in Columbia, where the General Assembly meets. Photo: Farragutful, <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a>, via <a href="https://commons.wikimedia.org/wiki/File:2018_South_Carolina_State_House_(cropped).jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>. Chapter3 Realty resized it for the page and saved it as WebP.</div><div role="listitem"> Each photo keeps the license listed with it.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":