ed);font-size:.95rem;line-height:1.55;margin:1.1rem 0 0;padding:0}@media (max-width:699px){.c3-gchart{padding:1rem .95rem .9rem}.c3-gchart .b{width:calc((100% - 6.2rem) * var(--f))}}</style><style>.c3-glance{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(var(--n),minmax(0,1fr));gap:.75rem;max-width:760px}.c3-glance li{display:flex;align-items:center;gap:.55rem;margin:0;padding:.5rem .6rem;background:rgba(255,255,255,.55);border:1px solid var(--rule);border-radius:6px;line-height:1.25}.c3-glance .i{flex:0 0 auto;display:flex;width:2rem;height:2rem;border-radius:50%;background:var(--ivory-2);color:var(--brass-ink);align-items:center;justify-content:center}.c3-glance strong{display:block;color:var(--navy);font-size:.9rem;font-weight:500}.c3-glance span.t{display:block;color:var(--muted);font-size:1rem}@media (max-width:699px){.c3-glance{gap:.3rem}.c3-glance li{flex-direction:column;justify-content:flex-start;text-align:center;gap:.2rem;padding:.4rem .1rem}.c3-glance .i{width:1.6rem;height:1.6rem}.c3-glance strong{font-size:.875rem}.c3-glance span.t{font-size:1rem;line-height:1.2}}</style><ul role="list" class="c3-glance" style="--n:3"><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.8 12.2 20 3M16.8 6.2l2.5 2.5M14.3 8.7l2 2"/><circle cx="7.5" cy="15.5" r="4.5"/></svg></span><span><strong>About $1,600</strong><span class="t">a house on a new lease</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 3.5l9 8M5.5 10v10.5h13V10M10 20.5V15h4v5.5"/></svg></span><span><strong>About $1,150</strong><span class="t">a 2-bedroom apartment, old and new leases</span></span></li><li><span class="i"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 9.4c-.4-1-1.5-1.8-3-1.8-1.8 0-3 1-3 2.2 0 3 6 1.6 6 4.4 0 1.3-1.3 2.2-3 2.2-1.6 0-2.7-.7-3.1-1.8M12 5.8v1.8M12 16.4v1.8"/><circle cx="12" cy="12" r="9"/></svg></span><span><strong>Up about 3%</strong><span class="t">house rents in a year</span></span></li></ul></div><p style="color:var(--muted);font-size:.9rem;margin-bottom:1rem">By <strong style="color:var(--navy);font-weight:600">Devin Day</strong>, Operations Officer &middot; Reviewed by <strong style="color:var(--navy);font-weight:600">Tim Nash</strong>, Broker-in-Charge &middot; <span style="white-space:nowrap">Updated November 12, 2026</span></p><p class="detail-sub">Rents on leases of a year or more, by bedrooms and in ten ZIP codes from Little River to Murrells Inlet.</p></div></div><section style="background:var(--ivory)"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">The short answer</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A house rents for about $1,600 a month on a new lease in Horry County outside the Loris, Aynor and Green Sea area. The tenant also pays about $200 a month for power, water and gas. That is the middle rent for houses leased in the last two years: half rent for more, and half for less.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">An apartment or condo rents for about $1,100 a month with one bedroom and about $1,150 with two, plus about $100 of utilities. Those apartment figures count leases old and new, so a new lease costs more than that.</p></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><p style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">An agent works out the rent for one house before you offer.</p><a class="btn btn-brass btn-lg" href="/contact/">Ask an agent</a></div></section><section style="background:var(--ivory);padding-top:2.5rem"><div class="wrap"><nav aria-label="On this page" style="margin-top:0;max-width:720px"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.3rem;font-weight:600">On this page</p><ul style="list-style:none;margin:0;padding:0"><li><a href="#by-bedrooms" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">By bedrooms</a></li><li><a href="#new-leases" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">New leases</a></li><li><a href="#by-area" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">By area</a></li><li><a href="#up-or-down" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Are rents rising</a></li><li><a href="#best-month" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Best month</a></li><li><a href="#your-house" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">What will my house rent for</a></li><li><a href="#fair-market-rent" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Fair market rent</a></li><li><a href="#raising-the-rent" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Raising the rent</a></li><li><a href="#rent-prices-faq" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Rent prices FAQ</a></li></ul></nav></div></section><section style="background:var(--ivory-2)" id="by-bedrooms"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="By bedrooms">How much is rent in Myrtle Beach, by bedrooms?</h2><style>
