3.5" fill="#4a4f5c">Jan</text><text x="414.7" y="225.1" text-anchor="middle" font-size="13.5" fill="#4a4f5c">Feb</text><text x="463.9" y="225.1" text-anchor="middle" font-size="13.5" fill="#4a4f5c">Mar</text><text x="513.1" y="225.1" text-anchor="middle" font-size="13.5" fill="#4a4f5c">Apr</text><text x="562.3" y="225.1" text-anchor="middle" font-size="13.5" fill="#4a4f5c">May</text><text x="611.4" y="225.1" text-anchor="middle" font-size="13.5" fill="#4a4f5c">Jun</text><text x="55.3" y="242.6" text-anchor="start" font-size="12.15" fill="#4a4f5c">2025</text><text x="350.3" y="242.6" text-anchor="start" font-size="12.15" fill="#4a4f5c">2026</text></svg><figcaption>Change in houses for sale at the end of each month, from the same month a year before. Horry and Georgetown Counties.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Months of supply is how long the homes for sale would last at the past year's pace of accepted offers, if no new homes were listed. There were still more houses for sale than two Junes before, when 3,342 were listed and houses had 3.8 months of supply.</p></div></section><section style="background:var(--ivory)" id="buyers"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Buyers in June">Were buyers coming back to Myrtle Beach in June 2026?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, most of all for condos. Sellers accepted 486 offers on condos in June, 21.5 percent more than a year earlier and the most of the last three Junes.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">House buyers had about 8 percent more offers accepted. June also had 1,127 house sales closed, the most of any month in the year to June.</p><div class="hx-strip" data-place="mrj-oceanfront-condos-under-205k" data-name="Myrtle Beach" data-head="Oceanfront condos under $205,000 in and around Myrtle Beach"></div><div class="hx-fallback"><p class="c3-offer"><a class="c3-offer-pill" href="/contact/">Oceanfront condos under $205,000 in and around Myrtle Beach<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Found a condo you like? We check the building first.</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">We pull the building's recent sales, its HOA fee and its insurance before you make an offer.</p><a class="btn btn-brass" href="/contact/">Have us check the building</a></div></div></section><section style="background:var(--ivory-2)" id="by-area"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Prices by area">What did homes sell for in each Myrtle Beach area in the first half of 2026?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Pawleys Island and North Myrtle Beach had the highest median house prices from January to June, and Conway and Loris / Longs the lowest.</p><div class="mj-tw"><table class="mj-tab mj-area"><caption>Median sale price by area, January to June 2026</caption><thead><tr><th scope="col">Area</th><th scope="col">Houses</th><th scope="col">Condos</th></tr></thead><tbody><tr><th scope="row"><a href="/submarkets/pawleys-island/" style="color:var(--navy);text-decoration:underline">Pawleys Island</a> / Litchfield<span class="z">ZIP code 29585</span></th><td>$656,250<span class="was">204 sold</span></td><td>$317,500<span class="was">133 sold</span></td></tr><tr><th scope="row"><a href="/submarkets/north-myrtle-beach/" style="color:var(--navy);text-decoration:underline">North Myrtle Beach</a><span class="z">ZIP code 29582</span></th><td>$566,748<span class="was">364 sold</span></td><td>$310,000<span class="was">438 sold</span></td></tr><tr><th scope="row"><a href="/submarkets/myrtle-beach/" style="color:var(--navy);text-decoration:underline">Myrtle Beach</a><span class="z">ZIP codes 29572 and 29577</span></th><td>$525,000<span class="was">319 sold</span></td><td>$205,000<span class="was">879 sold</span></td></tr><tr><th scope="row"><a href="/submarkets/carolina-forest/" style="color:var(--navy);text-decoration:underline">Carolina Forest</a><span class="z">MLS area 10B</span></th><td>$471,239<span class="was">459 sold</span></td><td>$197,500<span class="was">184 sold</span></td></tr><tr><th scope="row"><a href="/submarkets/garden-city/" style="color:var(--navy);text-decoration:underline">Garden City</a> / <a href="/submarkets/murrells-inlet/" style="color:var(--navy);text-decoration:underline">Murrells Inlet</a><span class="z">ZIP code 29576</span></th><td>$455,000<span class="was">393 sold</span></td><td>$304,960<span class="was">240 sold</span></td></tr><tr><th scope="row"><a href="/submarkets/surfside-beach/" style="color:var(--navy);text-decoration:underline">Surfside Beach</a><span class="z">ZIP code 29575</span></th><td>$418,000<span class="was">271 sold</span></td><td>$179,000<span class="was">187 sold</span></td></tr><tr><th scope="row">Socastee<span class="z">ZIP code 29588</span></th><td>$358,000<span class="was">627 sold</span></td><td>$173,500<span class="was">101 sold</span></td></tr><tr><th scope="row"><a href="/submarkets/little-river/" style="color:var(--navy);text-decoration:underline">Little River</a><span class="z">ZIP code 29566</span></th><td>$349,900<span class="was">301 sold</span></td><td>$200,000<span class="was">159 sold</span></td></tr><tr><th scope="row"><a href="/submarkets/conway/" style="color:var(--navy);text-decoration:underline">Conway</a><span class="z">ZIP codes 29526 and 29527</span></th><td>$311,000<span class="was">1,133 sold</span></td><td>$224,000<span class="was">121 sold</span></td></tr><tr><th scope="row">Loris / Longs<span class="z">ZIP codes 29568 and 29569</span></th><td>$301,120<span class="was">901 sold</span></td><td>$306,880<span class="was">85 sold</span></td></tr><tr class="all"><th scope="row">All of Horry and Georgetown Counties</th><td>$359,843</td><td>$232,500</td></tr></tbody></table><p class="nt">January to June, because June alone had too few sales in most areas. CCAR's areas follow ZIP codes or MLS areas, not city limits. Condos include townhouses. Sorted by the house price.</p></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">More than a third of the region's house sales in the first half were in the Conway and Loris / Longs ZIP codes. The median house there sold for about $301,000 to $311,000. The region's median house price was below the median in Myrtle Beach, North Myrtle Beach, Surfside Beach, Garden City / Murrells Inlet and Pawleys Island / Litchfield.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the Myrtle Beach area, ZIP codes 29572 and 29577, the median condo sold for $205,000 in the first half, down 12.8 percent from a year before. Our <a href="/sell/home-value/" style="color:var(--navy);text-decoration:underline">home value page</a> shows what homes in your area sold for since then.</p></div></section><section style="background:var(--ivory)" id="what-it-meant"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Using the numbers">How could Myrtle Beach buyers and sellers use the June 2026 numbers?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Set the one home you want against them, before you write an offer or set a price.</p><ul class="mj-list"><li><b>Buying a house</b>From January to June, the average house waited 125 days for an accepted offer. Our agents check how long the house you like has been for sale, and any price cuts, before you write your offer. <a href="/contact/" style="color:var(--navy);text-decoration:underline">Ask us about a house</a></li><li><b>Buying a condo</b>From January to June, condos sold for 95.9 percent of their last asking price on average. Before you offer, our agents check what the same floor plan sold for in that building. <a href="/contact/" style="color:var(--navy);text-decoration:underline">Ask us about a building</a></li><li><b>Selling</b>Over the year to June, the median condo moved between $220,000 in February and $248,000 the November before. One month's median says little about one home, so we price yours from the sales closest to it. <a href="/contact/" style="color:var(--navy);text-decoration:underline">Ask us to price your home</a></li></ul></div></section><section style="background:var(--ivory-2)" id="what-else-changed-in-june-2026"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">What else changed in June 2026?</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Did Myrtle Beach condos take longer to sell in June 2026?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. The average condo took 137 days from listing to an accepted offer, up from 102 days two Junes before.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Were fewer new homes permitted in Horry County in June 2026?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. Building permits were issued for 555 new homes in Horry County that month, 6.9 percent fewer than the June before. From January to June, permits covered 3,336 homes, 6.8 percent fewer than a year before.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Where are the newest Myrtle Beach market numbers?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our Myrtle Beach market reports page has the latest month, with the past year in one chart. This page stays up as the record of that June.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.ccarsc.org/clientuploads/2026_Market_Stats/Coastal-Carolinas_MMI_2026-06.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">CCAR Monthly Indicators, June 2026</a>, <a href="https://www.ccarsc.org/clientuploads/2026_Market_Stats/July_2026_All_Cities.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">CCAR Local Market Update, June 2026</a>, <a href="https://www.ccarsc.org/pages/mls-faqs/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">CCAR MLS questions</a>, <a href="https://www2.census.gov/econ/bps/CBSA%20(beginning%20Jan%202024)/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Census Building Permits Survey</a>. Market: sales through CCAR's MLS in Horry and Georgetown Counties, current as of July 10, 2026. Permits: the Census count for the Myrtle Beach metro, which is Horry County. Our <a href="/invest/what-is-being-built/" style="color:var(--navy);text-decoration:underline">new home permits page</a> has every month.</p><style>.c3ph-credits{margin:2rem 0 1rem;padding:1r