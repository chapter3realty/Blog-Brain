 .rr-tab0 thead th{font-size:.875rem!important}}main#main .rr-tw{margin:1.3rem 0 1.4rem}main#main .rr-tw table{width:100%;border-collapse:collapse;font-family:var(--sans);font-size:1.0625rem;color:var(--navy)}main#main .rr-tw caption{text-align:left;font-weight:600;line-height:1.4;padding:0 0 .7rem}main#main .rr-tw thead th{font-size:.95rem;font-weight:600;text-align:left;padding:0 .8rem .5rem 0;border-bottom:1px solid rgba(28,32,40,.3);vertical-align:bottom}main#main .rr-tw tbody th{text-align:left;font-weight:600;padding:.75rem .9rem .75rem 0;border-bottom:1px solid rgba(28,32,40,.16);line-height:1.4;vertical-align:top;width:30%}main#main .rr-tw td{padding:.75rem .8rem .75rem 0;border-bottom:1px solid rgba(28,32,40,.16);vertical-align:top;line-height:1.5;color:var(--muted)}main#main .rr-tw td.k{font-weight:700;color:var(--navy)}main#main .rr-tw td .l{display:none}main#main .rr-tw a{color:var(--navy)}@media (max-width:599px){main#main .rr-tab,main#main .rr-tab tbody,main#main .rr-tab caption{display:block;width:100%}main#main .rr-tab thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}main#main .rr-tab tr{display:block;padding:.8rem 0;border-bottom:1px solid rgba(28,32,40,.16)}main#main .rr-tab th,main#main .rr-tab td{display:block;border:0!important;padding:0!important;width:auto!important}main#main .rr-tab tbody th{padding-bottom:.25rem!important}main#main .rr-tab td{padding-top:.2rem!important}main#main .rr-tab td .l{display:block;font-size:.875rem;color:var(--muted);font-weight:400}}main#main .rr-plain{list-style:none;margin:1.1rem 0 1.4rem;padding:0}main#main .rr-plain li{margin:0;padding:.8rem 0;border-top:1px solid rgba(28,32,40,.16);color:var(--muted);line-height:1.6;font-size:1.0625rem}main#main .rr-plain li:last-child{border-bottom:1px solid rgba(28,32,40,.16)}main#main .rr-plain b{display:block;color:var(--navy);font-family:var(--sans);font-size:1.08rem;line-height:1.35;margin-bottom:.2rem}main#main .rr-b{margin:2.2rem 0 0;padding-top:1.4rem;border-top:1px solid rgba(28,32,40,.16)}main#main .rr-bh{display:flex;align-items:baseline;gap:.65rem;font-family:var(--serif);font-size:1.3rem;color:var(--navy);margin:0 0 .7rem;line-height:1.3}main#main .rr-n{flex:none;display:inline-flex;align-items:center;justify-content:center;width:1.75rem;height:1.75rem;border-radius:50%;background:rgba(196,120,58,.16);color:#8a5226;font-family:var(--sans);font-weight:700;font-size:.95rem;position:relative;top:-.12rem}main#main .rr-b+.hx-strip:not(:empty){margin-top:1.1rem}main#main .rr-b+.hx-strip+.hx-fallback .c3-offer{margin:.4rem 0 .6rem}main#main .rr-after{margin-top:2.2rem;padding-top:1.4rem;border-top:1px solid rgba(28,32,40,.16);max-width:720px}main#main .rr-after>h3{margin-top:0!important}main#main .rr-steps{list-style:none;counter-reset:rr;margin:1.1rem 0 1.4rem;padding:0}main#main .rr-steps li{counter-increment:rr;position:relative;margin:0;padding:.85rem 0 .85rem 2.6rem;border-top:1px solid rgba(28,32,40,.16);color:var(--muted);line-height:1.6;font-size:1.0625rem}main#main .rr-steps li:last-child{border-bottom:1px solid rgba(28,32,40,.16)}main#main .rr-steps li::before{content:counter(rr);position:absolute;left:0;top:.85rem;width:1.75rem;height:1.75rem;border-radius:50%;background:rgba(196,120,58,.16);color:#8a5226;font-family:var(--sans);font-weight:700;font-size:.95rem;display:flex;align-items:center;justify-content:center}main#main .rr-steps b{color:var(--navy)}main#main .rr-note{font-family:var(--sans);font-size:.95rem;line-height:1.6;color:var(--muted);max-width:720px;margin:.2rem 0 1.2rem}@media (max-width:379px){main#main .hx-fb,main#main .hx-fb>*{min-width:0;max-width:100%}main#main .hx-fb-ai,main#main .hx-fb-q{min-width:0!important;max-width:100%!important;flex-wrap:wrap;box-sizing:border-box}main#main .hx-fb-q textarea{min-width:0;flex:1 1 100%;width:100%}main#main .hx-fb-go{flex:1 1 100%}}@media (min-width:1000px) and (max-width:1100px){.header-ctas .hdr-phone{display:none!important}}main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2){padding:.9rem 0!important}main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2)>.wrap{display:block!important;text-align:center!important;background:linear-gradient(160deg,rgba(42,48,64,.95),rgba(28,32,40,.97))!important;border:1px solid rgba(255,255,255,.14)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.14),0 26px 60px -30px rgba(28,32,40,.6)!important;border-radius:28px!important;padding:2.2rem 1.6rem!important;margin-left:auto!important;margin-right:auto!important;width:calc(100% - 32px);max-width:720px;box-sizing:border-box}@media (max-width:699px){main#main>section[style^="background:var(--navy)"]:has(>.wrap>h2)>.wrap{padding:1.6rem 1.2rem 1.7rem!important;border-radius:24px!important}}</style><style>main#main .hx-strip:empty{display:none}main#main .hx-strip:not(:empty)+.hx-fallback{display:none}</style></div><p style="color:var(--muted);font-size:.9rem;margin-bottom:1rem">By <strong style="color:var(--navy);font-weight:600">Devin Day</strong>, Operations Officer &middot; Reviewed by <strong style="color:var(--navy);font-weight:600">Tim Nash</strong>, Broker-in-Charge &middot; <span style="white-space:nowrap">Updated November 12, 2026</span></p><p class="detail-sub">An HOA or condo can limit renting in Horry County when its recorded papers say so, and the real rules differ by community.</p></div></div><section style="background:var(--ivory)"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">The short answer</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. A South Carolina HOA or condo association can ban or limit renting when the rule is in its recorded papers. South Carolina law has no exemption for owners who bought before a new rule.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">On the Grand Strand, North Beach Plantation's papers allow "any form of rental". At Del Webb at Grande Dunes and Robber's Roost, no lease may be shorter than a year.</p></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><p style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Tell us your rental plan. We read the rules for the home before you offer.</p><a class="btn btn-brass btn-lg" href="/contact/">Have us read the rules</a></div></section><section style="background:var(--ivory);padding-top:2.5rem"><div class="wrap"><nav aria-label="On this page" style="margin-top:0;max-width:720px"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.3rem;font-weight:600">On this page</p><ul style="list-style:none;margin:0;padding:0"><li><a href="#the-law" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">The law</a></li><li><a href="#real-rules" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Real rules</a></li><li><a href="#rule-changes" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Rule changes</a></li><li><a href="#airbnb-or-yearly" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Airbnb or yearly</a></li><li><a href="#loans" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Loans</a></li><li><a href="#renter-rules" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Renter rules</a></li><li><a href="#before-you-offer" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">Before you offer</a></li><li><a href="#hoa-rental-restrictions-faq" style="display:block;padding:.65rem 0;color:var(--navy);text-decoration:underline;text-underline-offset:.18em;line-height:1.35">HOA rental restrictions FAQ</a></li></ul></nav></div></section><section style="background:var(--ivory-2)" id="the-law"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The law">Can an HOA ban rentals in South Carolina?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, when the rule is in the association's papers and its words are clear. State law and the courts say four things about it:</p><ul class="rr-plain"><li><b>The papers must be recorded</b>An HOA's governing documents must be recorded at the county to be enforced. Board rules take effect when adopted, and stay enforceable only if recorded by January 10 of the next year (<a href="https://www.scstatehouse.gov/code/t27c030.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">27-30-130</a>).</li><li><b>A condo's master deed states it</b>The master deed is the paper that creates a condo building and its association. South Carolina requires it to state any limits on leasing a unit, including the term. Each owner must follow it strictly (<a href="https://www.scstatehouse.gov/code/t27c031.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">27-31-100 and 27-31-170</a>).</li><li><b>No cap and no grandfather rule</b>Neither South Carolina's HOA Act nor its condo law caps an association's rental rules, or exempts owners who bought before a new one.</li><li><b>A clear rule holds; an unclear one is read for the owner</b>In <a href="https://www.sccourts.org/media/opinions/HTMLFiles/COA/5362.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">a 2015 case</a>, a Richland County condo barred renting to college students not related to the owner. Owners who paid $470,000 in 2007 rented to students anyway, and lost. In <a href="https://www.sccourts.org/media/opinions/HTMLFiles/COA/5525.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">a 2017 Hilton Head case</a>, the court read unclear rules the way that "least restricts the use of the property", and the owners won.</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the 2015 case, the court also said the association had not given up its rule, even if it had not watched rentals before. It acted once it got a complaint.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The city's rule comes on top. The city or county decides whether a home may be rented by the night at that address. The association's papers say whether that one home may be. Both must say yes.</p><div class="rr-tw"><table class="rr-tab0"><caption>You can rent by the night only when both say yes</caption><thead><tr><th scope="col">City or county</th><th scope="col">HOA or condo papers</th><th scope="col">Rent by the night?</th></tr></thead><tbody><tr><th scope="row">Yes</th><td><span class="l">HOA or condo papers</span>Yes</td><td class="k"><span class="l">Rent by the night?</span>Yes</td></tr><tr><th scope="row">Yes</th><td><span class="l">HOA or condo papers</span>No</td><td class="k"><span class="l">Rent by the night?</span>No</td></tr><tr><th scope="row">No</th><td><span class="l">HOA or condo papers</span>Yes</td><td class="k"><span class="l">Rent by the night?</span>No</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The rules for each town are on our <a href="/invest/str-rules/" style="color:var(--navy);text-decoration:underline">Myrtle Beach short-term rental rules page</a>.</p></div></section><section style="background:var(--ivory)" id="real-rules"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Real rules">What do HOA rental rules say in real Grand Strand communities?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Some allow any rental at all. Others require a lease of a year or more. These 15 come from each community's own posted or recorded papers. The first seven are ordered from the most open to the most limited.</p><div class="rr-b" id="north-beach-plantation"><h3 class="rr-bh"><span class="rr-n">1</span><span>North Beach Plantation, North Myrtle Beach: rent it any way you like</span></h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Its resort towers stand on a 7.5-acre island between the Atlantic Ocean and Whitepoint Swash. Around them are <a href="https://www.northbeachrentals.com/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">2.5 acres of pools</a>, spas, a lazy river and a swim-up pool bar.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The <a href="https://www.coastalassociationmanagement.com/Site/FileDownload/Index/5456" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">master declaration</a> says its residential-use rule "shall not prohibit or restrict any form of rental". The Exchange lets an owner rent by the day, week, month or year.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Rental guests must register. In the Exchange, the single-family homes and the Villas, a guest not staying with the owner registers with the on-site access company. The unit's front door must have that company's lock and fob system.</p></div><div class="hx-strip" data-place="north-beach-plantation" data-name="North Beach Plantation" data-head="North Beach Plantation: an island resort you can rent your way"></div><div class="hx-fallback"><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=North%20Beach%20Plantation">Send me homes in North Beach Plantation<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div><div class="rr-b" id="sand-dunes"><h3 class="rr-bh"><span class="rr-n">2</span><span>Sand Dunes Oceanfront Tower, Myrtle Beach: papers that allow short stays</span></h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Sand Dunes Resort has <a href="https://www.sandsresorts.com/sand-dunes-resort/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">a water park with slides</a> and a large lazy river on the oceanfront. Our <a href="/invest/condo-buildings/#sand-dunes-resort" style="color:var(--navy);text-decoration:underline">oceanfront condo building guide</a> has its fees and prices.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The tower's <a href="https://www.coastalassociationmanagement.com/Site/FileDownload/Index/2357" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">master deed</a> allows "permanent or transient residential use". It also says nothing in it limits an owner's right to rent or lease a unit.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Transient means short stays. The city's zoning says whether a stay by the night is legal in a unit, so we check it for that unit before you offer.</p></div><div class="hx-strip" data-place="sand-dunes-resort" data-name="Sand Dunes" data-head="Sand Dunes condos for sale, with a lazy river on the oceanfront"></div><div class="hx-fallback"><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Sand%20Dunes">Get the Sand Dunes condos for sale<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div><div class="rr-b" id="the-farm"><h3 class="rr-bh"><span class="rr-n">3</span><span>The Farm at Carolina Forest: renting is allowed, and no board rule can ban it</span></h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The state land along The Farm's north side holds habitat for the wild Venus flytrap. <a href="https://www.dnr.sc.gov/news/2025/Jun/jun10-lewisoceanbay.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">South Carolina's largest wild population</a> of the plant is centered in the Lewis Ocean Bay Heritage Preserve.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The declaration says no board rule may prohibit leasing, though the board may require a minimum lease of up to six months. Its <a href="https://www.farmatcarolinaforest.com/uploads/documents_page/NEW%20Rules%20%26%20Regulations.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">rules</a> require every lease in writing. The owner sends the manager a copy and the tenants' names and phone numbers within 10 days.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The board's <a href="https://www.farmatcarolinaforest.com/uploads/documents_page/May%20signed%20minutes.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">minutes</a> say the builder's documents include no limit on the share of homes that may be rented. More on the neighborhood is in our <a href="/submarkets/carolina-forest/the-farm/" style="color:var(--navy);text-decoration:underline">guide to The Farm</a>.</p></div><div class="hx-strip" data-place="the-farm" data-name="The Farm at Carolina Forest" data-head="The Farm homes, where the board can't ban renting"></div><div class="hx-fallback"><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=The%20Farm">Have us read The Farm's rules for one home<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div><div class="rr-b" id="coquina-harbour"><h3 class="rr-bh"><span class="rr-n">4</span><span>Coquina Harbour, Little River: a condo on a boat basin, with 12-month leases</span></h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Coquina Harbour's condos line a marina basin off the Intracoastal Waterway in Little River. The county lists 78 boat-slip parcels in the harbor's marina, each its own parcel, about 100 to 500 feet from the condo buildings.</p><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);letter-spacing:.01em;color:#fff;text-align:right;background:radial-gradient(farthest-side at 100% 100%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.c3ph-cr a{color:#fff;text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);text-underline-offset:2px;pointer-events:auto;padding:10px 0 6px}.c3ph-hero{margin:1.6rem 0 2rem}.c3ph-hero .c3ph-f{border-radius:8px}.c3ph-hero img{aspect-ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}</style><figure class="c3ph-hero" style="margin:1.3rem 0 1.5rem;max-width:720px;"><div class="c3ph-f"><img src="/images/2026-11-a/submarkets-little-river/little-river-harbours-from-above-1200w.webp" srcset="/images/2026-11-a/submarkets-little-river/little-river-harbours-from-above-600w.webp 600w, /images/2026-11-a/submarkets-little-river/little-river-harbours-from-above-1200w.webp 1200w" sizes="(max-width: 760px) 100vw, 720px" style="aspect-ratio:4/3" width="1200" height="900" alt="A marina basin full of boats off the Intracoastal Waterway, from above, with Coquina Harbour labelled at its upper end, Lightkeepers Village near its mouth, US 17 at the top left and a golf course at the upper right" loading="lazy" decoding="async"></div><span class="c3ph-cr" style="position:static;display:block;background:none;color:var(--muted);text-align:left;white-space:normal;padding:.4rem 0 0"><a style="color:inherit;text-decoration-color:rgba(28,32,40,.3)" href="https://www.fsa.usda.gov/help/policies-and-links/" target="_blank" rel="noopener noreferrer" aria-label="U.S. government aerial photo. License: Public domain" title="License: Public domain">U.S. government aerial photo</a></span><figcaption>Coquina Harbour and Lightkeepers Village share one marina basin between US 17 and the Intracoastal Waterway in Little River.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The <a href="https://www.coastalassociationmanagement.com/Site/FileDownload/Index/3130" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">association's rules</a> require a lease of at least 12 months. A copy of each lease goes to the management company.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">It fits a buyer who wants a harbor home and a tenant by the year. It does not fit a plan to rent it by the week.</p></div><div class="hx-strip" data-place="coquina-harbour" data-name="Coquina Harbour" data-head="Coquina Harbour condos on a boat basin off the waterway"></div><div class="hx-fallback"><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Coquina%20Harbour">Have us find a condo in Coquina Harbour<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div><div class="rr-b" id="del-webb-grande-dunes"><h3 class="rr-bh"><span class="rr-n">5</span><span>Del Webb at Grande Dunes, Myrtle Beach: a year's lease, once a year</span></h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">At Del Webb at Grande Dunes, every owner pays a required fee for the Grande Dunes Ocean Club, the beach club, and the association bills it with its own dues. <a href="https://www.pultegroupinc.com/investor-relations/news/news-details/2017/Del-Webb-Expands-Into-Myrtle-Beach-With-New-55-Community-at-Grande-Dunes/default.aspx" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Pulte said in 2017</a> it was the only Del Webb in the country to include beach club access in its base HOA dues.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The recorded declaration requires a lease of at least 12 months, one time a year, unless the association's rules say otherwise. The <a href="https://www.delwebbatgrandedunes.com/ResourceCenter/Download/48372~3083089" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">posted rules</a> add that the whole home is leased, in writing, with notice to the manager within 10 days.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">This is a 55+ community. An owner may not lease to anyone under 55 who will live in the home without the board's written approval. Life there is in our <a href="/buyers/55-plus-communities/del-webb-grande-dunes/" style="color:var(--navy);text-decoration:underline">Del Webb at Grande Dunes guide</a>.</p></div><div class="hx-strip" data-place="del-webb-grande-dunes" data-name="Del Webb at Grande Dunes" data-head="Del Webb homes with the beach club in the dues"></div><div class="hx-fallback"><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Del%20Webb%20at%20Grande%20Dunes">Ask us about homes in Del Webb at Grande Dunes<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div><div class="rr-b" id="seasons-at-prince-creek-west"><h3 class="rr-bh"><span class="rr-n">6</span><span>Seasons at Prince Creek West, Murrells Inlet area: a one-year lease</span></h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The Murrells Inlet MarshWalk is about 10 minutes away by car, and so is the beach in Garden City. At home, the <a href="https://www.fsresidential.com/south-carolina/news-events/press-releases/firstservice-residential-welcomes-five-grand-stran/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">management company lists</a> indoor and outdoor pools, tennis and bocce.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The association's <a href="https://www.seasons55.com/editor_upload/File/Community%20Management/Policies%20%26%20Rules/communitycharter2.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">posted copy of its charter</a> says no lease may be shorter than one year. Every lease is in writing and says the homes are for people 55 or older.</p></div><div class="hx-strip" data-place="prince-creek-55" data-name="Seasons at Prince Creek West" data-head="Seasons at Prince Creek West homes, 10 minutes from the MarshWalk"></div><div class="hx-fallback"><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Seasons%20at%20Prince%20Creek%20West">Send me Seasons at Prince Creek West homes<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div><div class="rr-b" id="myrtle-trace"><h3 class="rr-bh"><span class="rr-n">7</span><span>Myrtle Trace, Conway: a tenant 55 or older who lives there full time</span></h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Myrtle Trace has fifteen ponds. They sit on 42 acres of common land the HOA owns, with <a href="/hoa/benefits/" style="color:var(--navy);text-decoration:underline">the clubhouse and the pool</a>.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Its <a href="https://myrtletracesc.org/wp-content/uploads/Guidelines/Owner_Tenant_Agreement.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">owner and tenant agreement</a> says at least one person on the lease must be 55 or older and live in the home full time. If no one on the lease meets that rule, the lease ends and the tenants leave within 30 days.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The rule fits a tenant who lives there, not a vacation guest. Our <a href="/buyers/55-plus-communities/myrtle-trace/" style="color:var(--navy);text-decoration:underline">Myrtle Trace guide</a> covers the rest.</p></div><div class="hx-strip" data-place="myrtle-trace" data-name="Myrtle Trace" data-head="Myrtle Trace homes among fifteen ponds"></div><div class="hx-fallback"><p class="c3-offer"><a class="c3-offer-pill" href="/contact/?place=Myrtle%20Trace">Get the Myrtle Trace homes for sale<span class="c3-offer-ar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a></p></div><div class="rr-after"><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Eight more rules we read</h3><div class="rr-tw"><table class="rr-tab"><caption>The shortest stay allowed comes first</caption><thead><tr><th scope="col">Community</th><th scope="col">Homes</th><th scope="col">What the papers say</th></tr></thead><tbody><tr><th scope="row"><a href="https://www.coastalassociationmanagement.com/Site/FileDownload/Index/2399" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">The Atrium</a></th><td><span class="l">Homes</span>Condos on North Ocean Boulevard, Myrtle Beach</td><td><span class="l">What the papers say</span>No lease of 30 days or less, since a 1998 amendment (below)</td></tr><tr><th scope="row"><a href="https://www.coastalassociationmanagement.com/Site/FileDownload/Index/3642" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Sugarloaf</a></th><td><span class="l">Homes</span>Houses near Longs</td><td><span class="l">What the papers say</span>At least 6 months, unless the board approves. No nightly or vacation rental</td></tr><tr><th scope="row"><a href="https://www.coastalassociationmanagement.com/Site/FileDownload/Index/3444" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Bellasera on the Waterway</a></th><td><span class="l">Homes</span>Homes in North Myrtle Beach</td><td><span class="l">What the papers say</span>At least 6 months, for the whole home. No hotel use</td></tr><tr><th scope="row"><a href="https://www.coastalassociationmanagement.com/Site/FileDownload/Index/773" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Villa Firenze at Grande Dunes</a></th><td><span class="l">Homes</span>Condos in Myrtle Beach</td><td><span class="l">What the papers say</span>At least 1 year, or 6 months with the board's written consent</td></tr><tr><th scope="row"><a href="https://www.coastalassociationmanagement.com/Site/FileDownload/Index/4463" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Intercoastal Village Resort</a></th><td><span class="l">Homes</span>Condos in Little River</td><td><span class="l">What the papers say</span>At least 1 year. An owner who does not file the lease is fined $100 a month, then $200, then $400</td></tr><tr><th scope="row"><a href="https://www.coastalassociationmanagement.com/Site/FileDownload/Index/3496" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Robber's Roost</a></th><td><span class="l">Homes</span>Houses in North Myrtle Beach</td><td><span class="l">What the papers say</span>No lease under 1 year</td></tr><tr><th scope="row"><a href="https://www.coastalassociationmanagement.com/Site/FileDownload/Index/2429" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Surf Estates</a></th><td><span class="l">Homes</span>Houses in North Myrtle Beach</td><td><span class="l">What the papers say</span>No weekly or short-term rental, and short-term means under 1 year</td></tr><tr><th scope="row"><a href="https://www.coastalassociationmanagement.com/Site/FileDownload/Index/2646" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Waterfall</a></th><td><span class="l">Homes</span>Houses</td><td><span class="l">What the papers say</span>At least 1 year, for the whole home. Airbnb and VRBO are prohibited</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Plenty of communities here ban renting the house out at all. When you buy a rental with us, our agents leave those out of your search. We read each home's papers for rules that would block your plan.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">New communities differ. There is no single pattern for rental caps in them, so we check each new community case by case. Our <a href="/hoa/documents/" style="color:var(--navy);text-decoration:underline">guide to HOA documents</a> shows what to ask for.</p></div><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Found a community you like?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us its name. We read its recorded rules and tell you whether your rental plan fits, before you offer.</p><a class="btn btn-brass" href="/contact/">Send us the community</a></div></div></section><section style="background:var(--ivory-2)" id="rule-changes"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Rule changes">Can the HOA change the rental rules after you buy?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, by the vote its papers require.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">The Atrium, a condo building on North Ocean Boulevard</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In 1997 the owners of The Atrium, at 7600 North Ocean Boulevard in Myrtle Beach, met with 93.75 percent of owners present. Not less than two-thirds of all owners voted to <a href="https://www.coastalassociationmanagement.com/Site/FileDownload/Index/2399" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">amend the master deed</a>.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The amendment, filed in 1998, says no unit may be leased for 30 days or less. It says it was meant to end "short term or vacation rentals". The posted papers show no later change.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Its <a href="https://www.coastalassociationmanagement.com/Site/FileDownload/Index/2400" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">master deed</a> asks for two approvals: owners of at least 66 percent of the units, and the lenders holding first mortgages on 66 percent of them.</p><div class="rr-tw"><table class="rr-tab"><caption>What it takes to change the papers in five more communities</caption><thead><tr><th scope="col">Community</th><th scope="col">Homes</th><th scope="col">The vote the papers require</th></tr></thead><tbody><tr><th scope="row"><a href="https://www.coastalassociationmanagement.com/Site/FileDownload/Index/2740" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">A Place at the Beach II</a></th><td><span class="l">Homes</span>Condos, Cherry Grove</td><td><span class="l">The vote the papers require</span>Owners of 75 percent of the building's value</td></tr><tr><th scope="row"><a href="https://www.coastalassociationmanagement.com/Site/FileDownload/Index/2429" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Surf Estates</a></th><td><span class="l">Homes</span>Houses, North Myrtle Beach</td><td><span class="l">The vote the papers require</span>Owners of 75 percent of the lots, not counting the developer's, and the developer's written consent while it still owns a lot</td></tr><tr><th scope="row"><a href="https://www.coastalassociationmanagement.com/Site/FileDownload/Index/5446" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">The Exchange at North Beach Plantation</a></th><td><span class="l">Homes</span>Condos, North Myrtle Beach</td><td><span class="l">The vote the papers require</span>67 percent of the total vote</td></tr><tr><th scope="row"><a href="https://www.coastalassociationmanagement.com/Site/FileDownload/Index/2409" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Crescent Shores</a> and <a href="https://www.coastalassociationmanagement.com/Site/FileDownload/Index/886" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Yacht Club Villas</a></th><td><span class="l">Homes</span>Condos, North Myrtle Beach</td><td><span class="l">The vote the papers require</span>Owners of two-thirds of the units and of the common areas, and the lenders holding liens on two-thirds</td></tr></tbody></table></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A vote that misses the papers' number fails. In <a href="https://www.sccourts.org/media/opinions/HTMLFiles/COA/5312.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">a 2015 case</a>, affirmed in 2017, a South Carolina court threw out a subdivision's amendment that lacked the vote its restrictions required.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">How often the papers change</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">More often than buyers expect. From 2012 through October 2026, the <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeDocType" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">county's index</a> lists 10 amendments to The Farm at Carolina Forest's declaration, its sixth to fifteenth, and 7 to Berkshire Forest's.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Who can change the papers while the builder still runs the HOA is on our <a href="/hoa/developer-control-turnover/" style="color:var(--navy);text-decoration:underline">developer turnover page</a>.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Buyers from Florida: the law here is different</h3><div class="rr-tw"><table class="rr-tab"><caption>If the owners add a rental rule after you buy</caption><thead><tr><th scope="col">Where</th><th scope="col">Who the new rule binds</th></tr></thead><tbody><tr><th scope="row">South Carolina, condos and HOAs</th><td><span class="l">Who the new rule binds</span>Everyone, including owners who bought first.</td></tr><tr><th scope="row">Florida, condos</th><td><span class="l">Who the new rule binds</span>Only owners who consent to the amendment, and later buyers (<a href="https://www.leg.state.fl.us/statutes/index.cfm?App_mode=Display_Statute&URL=0700-0799/0718/Sections/0718.110.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">718.110(13)</a>).</td></tr><tr><th scope="row">Florida, HOAs</th><td><span class="l">Who the new rule binds</span>For a rental rule adopted after July 1, 2021, only owners who agree and later buyers. A rule against leases under 6 months, or more than three a year, binds everyone (<a href="https://www.leg.state.fl.us/statutes/index.cfm?App_mode=Display_Statute&URL=0700-0799/0720/Sections/0720.306.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">720.306(1)(h)</a>).</td></tr></tbody></table></div><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Worried about a rental vote?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Send us the community. We read how its papers can be changed and what vote it takes.</p><a class="btn btn-brass" href="/contact/">Ask us to read the papers</a></div></div></section><section style="background:var(--ivory)" id="airbnb-or-yearly"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Airbnb or yearly">Can an HOA ban Airbnb but allow yearly leases?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes. Eleven of the 15 communities above do: their papers bar stays of a month or less and allow a longer lease. Waterfall's rules name Airbnb and VRBO.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For the state's lodging tax, a short-term rental is a stay of fewer than 90 days in a row by the same guest (<a href="https://www.scstatehouse.gov/code/t12c036.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">12-36-920</a>). Papers may use their own definition: Surf Estates calls any use under a year short-term.</p><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="Few houses with an HOA fee say nightly rentals are allowed"><span class="cap" aria-hidden="true">Few houses with an HOA fee say nightly rentals are allowed</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Kind of home for sale</span><span role="columnheader">Say nightly rentals are allowed</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Houses with an HOA fee</span></span><span role="cell"><span class="b" style="--f:0.108" aria-hidden="true"></span><span class="v">about 4 in 100</span></span></div><div role="row"><span role="rowheader"><span class="n">Townhouses with an HOA fee</span></span><span role="cell"><span class="b" style="--f:0.6" aria-hidden="true"></span><span class="v">about 1 in 4</span></span></div><div role="row"><span role="rowheader"><span class="n">Houses with no HOA fee</span></span><span role="cell"><span class="b" style="--f:0.79" aria-hidden="true"></span><span class="v">about 3 in 10</span></span></div></div></div><figcaption>Homes for sale in Horry County, our count of the rental flags on each listing on November 10, 2026. It covers 2,140 houses with an HOA fee, 283 townhouses and 795 houses with no fee. A listing that does not say so may have a ban, a limit or a blank field.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The same city can give two answers. In <a href="https://www.nmb.us/833/Short-term-Rentals" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">North Myrtle Beach</a>, the city asks for no special zoning or permit beyond its license. There, 27 of 119 houses for sale with an HOA fee say nightly rentals are allowed, fewer than 1 in 4.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Of the 135 houses there with no HOA fee, 86 do, about 6 in 10.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In Carolina Forest, every one of the 297 houses for sale has an HOA fee, and 1 says nightly rentals are allowed. Most of them are outside city limits, where <a href="https://www.horrycountysc.gov/media/i0pfcm2o/appendix-b-zoning-ordinance-upated-912026.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">the county's zoning</a> has no limit on how long a home may be rented.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Condos lean the other way: about 7 in 10 condos for sale say short-term rentals are allowed. Our <a href="/invest/condos/" style="color:var(--navy);text-decoration:underline">guide to Myrtle Beach condos</a> has that count by area.</p><style>.c3ph-f{position:relative;margin:0;border-radius:6px;overflow:hidden;background:var(--ivory-2)}.c3ph-f img{display:block;width:100%;height:auto;object-fit:cover}.c3ph-cr{position:absolute;right:0;bottom:0;max-width:100%;padding:1.6rem .6rem .35rem 2.6rem;font:400 .625rem/1.3 var(--sans);letter-spacing:.01em;color:#fff;text-align:right;background:radial-gradient(farthest-side at 100% 100%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.c3ph-cr a{color:#fff;text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);text-underline-offset:2px;pointer-events:auto;padding:10px 0 6px}.c3ph-hero{margin:1.6rem 0 2rem}.c3ph-hero .c3ph-f{border-radius:8px}.c3ph-hero img{aspect-ratio:4/3}@media (min-width:700px){.c3ph-hero img{aspect-ratio:16/9}}.c3ph-hero figcaption{color:var(--muted);font-size:.85rem;line-height:1.5;margin-top:.55rem}</style><figure class="c3ph-hero" style="margin:1.3rem 0 1.5rem;max-width:720px;"><div class="c3ph-f"><img src="/images/2026-10-d/hoa-reserves/myrtle-beach-oceanfront-towers-2011-1200w.webp" srcset="/images/2026-10-d/hoa-reserves/myrtle-beach-oceanfront-towers-2011-600w.webp 600w, /images/2026-10-d/hoa-reserves/myrtle-beach-oceanfront-towers-2011-1200w.webp 1200w" sizes="(max-width: 760px) 100vw, 720px" width="1200" height="675" alt="A row of oceanfront towers in Myrtle Beach with flat roofs, stacked balconies and pools behind the dunes, seen from a plane over the ocean" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: U.S. Geological Survey. License: Public domain" title="License: Public domain">Photo: U.S. Geological Survey</a></span></div><figcaption>Oceanfront condo towers in Myrtle Beach, seen from a plane over the ocean.</figcaption></figure><div class="hx-strip" data-place="no-hoa-nightly-houses" data-name="Houses with no HOA fee" data-head="No HOA, and you can rent it by the night"></div><div class="hx-fallback"><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Prefer a house with no HOA at all?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Houses with no HOA fee have no association to say no. We send the ones whose listing says nightly rentals are allowed.</p><a class="btn btn-brass" href="/contact/">Send me houses with no HOA</a></div></div></div></section><section style="background:var(--ivory-2)" id="loans"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Loans">Does a building full of renters change the loan?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">It can. FHA and Fannie Mae both look at how many owners live in a condo building and how it is rented.</p><ul class="rr-plain"><li><b>FHA approval of the building</b>At least half of a condo project's units must be owner-occupied. Under extra conditions, an existing project more than a year old can be approved with 35 percent, and a new one with 30 percent (<a href="https://www.hud.gov/sites/default/files/Housing/documents/40001-hsgh-Update-18.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">HUD Handbook 4000.1</a>).</li><li><b>What counts as owner-occupied</b>A unit counts only if the owner lives there part of the year and does not rent it out for most of the year.</li><li><b>One unit in an unapproved building</b>FHA may insure it only if, among other things, at least half the units are owner-occupied. In a building of 20 or more units, FHA may stop new loans once it insures more than 10 percent of them. In a smaller one, the limit is two.</li><li><b>Fannie Mae</b>It will not buy a loan in a building whose papers require a rental pool or limit when owners may stay. The same goes for papers that make owners share rental profits with the association or a rental company. A building with hotel services, such as daily rentals and daily cleaning, is out too (<a href="https://selling-guide.fanniemae.com/sel/b4-2.1-03/ineligible-projects" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">B4-2.1-03</a>).</li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Loans on these buildings are on our <a href="/invest/non-warrantable-condos/" style="color:var(--navy);text-decoration:underline">page on condos most lenders will not lend on</a> and our <a href="/invest/condotel-financing/" style="color:var(--navy);text-decoration:underline">condotel financing page</a>.</p></div></section><section style="background:var(--ivory)" id="renter-rules"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Renter rules">What other HOA rules apply only to renters?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Some papers keep a few rules for renters alone. The ones we read cover pets and parking:</p><ul class="rr-plain"><li><b>Pets</b>At Teal Lake Village, North Myrtle Beach condos, renters on a lease shorter than half a year may not keep pets. A lease of 6 months or longer on file allows them. At <a href="https://www.coastalassociationmanagement.com/Site/FileDownload/Index/5485" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Cypress Bay II</a> and <a href="https://www.coastalassociationmanagement.com/Site/FileDownload/Index/5444" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">North Beach Towers</a>, renters and guests may not bring pets.</li><li><b>The golf cart space</b>At <a href="https://www.coastalassociationmanagement.com/Site/FileDownload/Index/4894" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Carolina Keyes</a>, an owner who rents the unit to long-term renters loses the unit's golf cart parking space.</li></ul></div></section><section style="background:var(--ivory-2)" id="before-you-offer"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Before you offer">How do you find out before you buy?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">We find out for the one home, before you make an offer, in three steps:</p><ol class="rr-steps"><li><b>We check the address.</b> Whether the city or county allows the rental you plan there. Each town's rule is on our <a href="/invest/str-rules/" style="color:var(--navy);text-decoration:underline">short-term rental rules page</a>.</li><li><b>We pull the papers.</b> The recorded papers, their amendments and the latest rules. The county's index is online, but its pages are not, so the copies come from the Register of Deeds or the association. One North Myrtle Beach manager <a href="https://www.coastalassociationmanagement.com/Site/GoverningDoc" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">posts 210 files</a> for the 62 associations it runs.</li><li><b>We read the seller's answer.</b> South Carolina's <a href="https://www.llr.sc.gov/re/RECPDF/Residential%20Property%20Condition%20Disclosure%20Statement%20Addendum.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">HOA disclosure addendum</a> asks the seller about any owners association "resale or rental restrictions". The seller may answer "No Representation", so we read the papers either way.</li></ol></div></section><section style="background:var(--ivory)" id="hoa-rental-restrictions-faq"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">HOA rental restrictions FAQ</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Am I grandfathered if my HOA bans rentals after I buy?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not by South Carolina law. Neither its HOA law nor its condo law exempts owners who bought before a new rule. Florida has such a law, and South Carolina does not. At The Atrium in Myrtle Beach, a 1998 amendment ended leases of 30 days or less for every unit.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does residential use only ban Airbnb?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Not by those words alone in the papers we read. North Beach Plantation's residential-use rule says it does not restrict any form of rental, and Sand Dunes Oceanfront Tower allows transient residential use. A South Carolina court reads unclear words the way that least restricts the owner.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can an HOA make my renters register?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, if its papers say so. In parts of North Beach Plantation, rental guests not staying with the owner register with the on-site access company. Del Webb at Grande Dunes wants notice of each lease within 10 days, and The Farm at Carolina Forest wants the tenants' names.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">What counts as a short-term rental in South Carolina?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For the state's lodging tax, a stay of fewer than 90 days in a row by the same guest. A community's papers can define it differently. Surf Estates treats any use under a year as short-term.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I rent out a home in a 55+ community near Myrtle Beach?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Yes, with the age rule. Del Webb at Grande Dunes asks for a 12-month lease and board approval for a tenant under 55. Seasons at Prince Creek West asks for a one-year lease. At Myrtle Trace, a tenant 55 or older must live there full time.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.scstatehouse.gov/code/t27c030.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 27-30</a>, <a href="https://www.scstatehouse.gov/code/t27c031.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 27-31</a>, <a href="https://www.scstatehouse.gov/code/t12c036.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 12-36-920</a>, <a href="https://www.sccourts.org/media/opinions/HTMLFiles/COA/5362.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Op. 5362</a>, <a href="https://www.sccourts.org/media/opinions/HTMLFiles/COA/5525.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Op. 5525</a>, <a href="https://www.sccourts.org/media/opinions/HTMLFiles/COA/5312.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Op. 5312</a>, <a href="https://www.leg.state.fl.us/statutes/index.cfm?App_mode=Display_Statute&URL=0700-0799/0718/Sections/0718.110.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Fla. Stat. 718.110</a>, <a href="https://www.leg.state.fl.us/statutes/index.cfm?App_mode=Display_Statute&URL=0700-0799/0720/Sections/0720.306.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">720.306</a>, <a href="https://www.hud.gov/sites/default/files/Housing/documents/40001-hsgh-Update-18.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">HUD Handbook 4000.1</a>, <a href="https://selling-guide.fanniemae.com/sel/b4-2.1-03/ineligible-projects" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Fannie Mae B4-2.1-03</a>, <a href="https://www.llr.sc.gov/re/RECPDF/Residential%20Property%20Condition%20Disclosure%20Statement%20Addendum.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC HOA addendum</a>, <a href="https://www.coastalassociationmanagement.com/Site/GoverningDoc" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">posted HOA papers</a>, <a href="https://acclaimweb.horrycounty.org/AcclaimWeb/search/SearchTypeDocType" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">county deed index</a>, <a href="https://www.horrycountysc.gov/media/i0pfcm2o/appendix-b-zoning-ordinance-upated-912026.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Horry County zoning</a>, <a href="https://www.nmb.us/833/Short-term-Rentals" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">North Myrtle Beach</a>. Each community's rule is linked to its own posted or recorded paper. Listing counts: the rental flags on homes for sale, November 10, 2026, in total only. General information, not legal advice.</p><style>.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Coquina Harbour from above. Photo: USDA Farm Service Agency, NAIP, <a href="https://www.fsa.usda.gov/hel