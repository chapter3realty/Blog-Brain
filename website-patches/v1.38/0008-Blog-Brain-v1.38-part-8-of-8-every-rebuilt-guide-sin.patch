lay:flex;gap:.75rem;padding:0 var(--c3ph-bleed,1.4rem) .4rem;margin:1.6rem calc(-1*var(--c3ph-bleed,1.4rem)) 0;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding:0 var(--c3ph-bleed,1.4rem);-webkit-overflow-scrolling:touch;scrollbar-width:none}.c3ph-row::-webkit-scrollbar{display:none}.c3ph-row>figure{flex:0 0 82%;scroll-snap-align:start}}.c3ph-swipe{display:flex;align-items:center;gap:.75rem;margin:.5rem 0 1.6rem;color:var(--navy);font:500 .95rem/1.3 var(--sans)}.c3ph-dots{display:inline-flex;gap:.45rem}.c3ph-dots i{display:block;width:10px;height:10px;border-radius:50%;border:1.5px solid var(--navy);box-sizing:border-box}.c3ph-dots i:first-child{background:var(--navy)}@supports (animation-timeline:view()){.c3ph-rowbox{timeline-scope:--c3ph-p1,--c3ph-p2,--c3ph-p3}.c3ph-row>figure:nth-child(1){view-timeline:--c3ph-p1 inline}.c3ph-row>figure:nth-child(2){view-timeline:--c3ph-p2 inline}.c3ph-row>figure:nth-child(3){view-timeline:--c3ph-p3 inline}.c3ph-dots i{animation:c3ph-dot linear both;animation-range:cover}.c3ph-dots i:nth-child(1){animation-timeline:--c3ph-p1}.c3ph-dots i:nth-child(2){animation-timeline:--c3ph-p2}.c3ph-dots i:nth-child(3){animation-timeline:--c3ph-p3}@keyframes c3ph-dot{0%,36%{background:transparent}42%,60%{background:var(--navy)}66%,100%{background:transparent}}}@media (min-width:700px){.c3ph-swipe{display:none}}.c3ph-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:1.4rem 0 1.8rem;padding:0;list-style:none}@media (min-width:700px){.c3ph-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}}@media (min-width:1000px){.c3ph-cards.c3ph-4{grid-template-columns:repeat(4,minmax(0,1fr))}}.c3ph-card{margin:0;background:var(--ivory);border:1px solid var(--rule);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}.c3ph-card .c3ph-f{border-radius:0}.c3ph-card img,.c3ph-card svg{display:block;width:100%;height:auto;aspect-ratio:var(--c3ph-r,4/3);object-fit:cover}.c3ph-card .c3ph-cr{font-size:.56rem;padding:1.2rem .45rem .25rem 1.6rem}.c3ph-card strong{display:block;color:var(--navy);font-size:.98rem;font-weight:500;line-height:1.3;padding:.7rem .8rem 0}.c3ph-card span.c3ph-t{display:block;color:var(--muted);font-size:.86rem;line-height:1.45;padding:.2rem .8rem .85rem}.c3ph-credits{margin:2rem 0 1rem;padding:1rem 0 0;border-top:1px solid var(--rule);color:var(--muted);font-size:.8rem;line-height:1.55;max-width:760px}.c3ph-credits .c3ph-h{font-family:var(--sans);font-size:.8rem;font-weight:500;color:var(--navy);margin:0 0 .4rem}.c3ph-credits [role=listitem]{margin:0 0 .3rem}.c3ph-credits a{color:inherit;text-decoration:underline;text-decoration-color:rgba(28,32,40,.3);text-underline-offset:2px}</style><style>section[style*="background:var(--ivory)"] .c3ph-card{background:var(--ivory-2)}.c3ph-cards{max-width:920px}.c3ph-card strong{font-family:var(--sans)}.c3ph-card span.c3ph-t{font-size:1rem!important}.c3ph-card strong{font-size:1rem!important}ul[role=list] li span[style*="font-size:.9rem"]{font-size:1rem!important}section#c3-photo{padding-top:0}section:has(+section#c3-photo){background:var(--ivory-2)!important;padding-bottom:2rem}.c3ph-hero{margin:0}.c3-aerial .c3ph-hero{max-width:900px;margin:1.4rem 0 1.6rem}.c3-aerial .c3ph-hero img{aspect-ratio:auto!important;height:auto}.c3-aerial-close .c3ph-hero{max-width:640px}.c3-aerial-ctop .c3ph-cr{top:0;bottom:auto;padding:.35rem .6rem 1.6rem 2.6rem;background:radial-gradient(farthest-side at 100% 0%,rgba(28,32,40,.72),rgba(28,32,40,.4) 55%,rgba(28,32,40,0))}@media (max-width:699px){.c3ph-cards>:last-child:nth-child(odd){grid-column:1/-1}}.c3-maps{display:grid;gap:0 1.5rem;max-width:1136px}@media (min-width:900px){.c3-maps{grid-template-columns:1fr 1fr;align-items:start}}.c3-maps figure{max-width:none!important;margin:1.4rem 0 .4rem!important}.c3-maps svg,.c3-maps img{display:block;width:100%;height:auto}.c3-map-links{row-gap:0!important}.c3-map-links a{padding:.55rem 0}ul[role=list][style*="minmax(13rem,1fr)"]{grid-template-columns:repeat(auto-fill,minmax(min(13rem,100%),1fr))!important}</style><style>.c3-aerial .c3ph-hero,.c3-aerial-close .c3ph-hero{max-width:720px}</style><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A reserve fund is money a homeowners association (HOA) or condo association saves each year for big repairs it knows are coming. The roof, the elevators and the paving are the usual ones.</p><ul class="rs-pots" aria-label="Where a condo association's money goes"><li><span class="k">Account 1</span><b>The operating budget</b><span class="t">Pays this year's bills, from this year's dues.</span></li><li><span class="k">Account 2</span><b>The reserve fund</b><span class="t">Saves for the big repairs ahead: the roof, the elevators, the paving.</span></li><li class="hot"><span class="k">When the reserve is short</span><b>The owners</b><span class="t">Pay the rest, often as a <a href="/hoa/special-assessments/" style="color:var(--navy);text-decoration:underline">special assessment</a>.</span></li></ul><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Saving ahead spreads the cost of a roof across every owner who uses it. Without savings, the whole bill falls on whoever owns a unit the year the roof fails.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A reserve study is a report on the building's big shared parts: what each one costs, how long it lasts, and how much the fund should hold by now.</p></div></section><section style="background:var(--ivory)" id="south-carolina-rule"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="The South Carolina rule">Does South Carolina require HOA reserves or a reserve study?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No. <a href="/hoa/south-carolina-hoa-laws/" style="color:var(--navy);text-decoration:underline">South Carolina law</a> does not require a condo or an HOA to keep a reserve fund, to put any amount into one, or to have a reserve study. How much a building saves is up to its board and its own documents.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In a South Carolina condo, every owner shares the cost of keeping up and repairing the shared parts. Each unit's share is the percentage set for it in the condo's founding papers, the recorded documents that created it. <a href="/hoa/who-pays-for-damage/" style="color:var(--navy);text-decoration:underline">After damage, the bill is paid</a> in this order:</p><ol class="rs-flow" aria-label="Who pays for a repair after damage, in order"><li><b>Insurance</b>Pays first, for what the <a href="/hoa/master-insurance-ho6/" style="color:var(--navy);text-decoration:underline">master policy</a> covers.</li><li><b>The reserve fund</b>Pays next, from what the board has saved.</li><li class="last"><b>The owners</b>Share the rest, by each unit's percentage in the founding papers.</li></ol><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A condo board must keep a book of every receipt and expense, with repair costs shown, open to every owner. A buyer is not yet an owner, so we get the papers through the seller.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Not an owner yet? We ask the seller for the papers</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">A buyer cannot see the board's books, so we ask the seller for them before you sign.</p><a class="btn btn-brass" href="/contact/">Have us ask for the papers</a></div></div></section><section style="background:var(--ivory-2)" id="how-much"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="How much is enough">How much should a Myrtle Beach condo association have in reserves?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Enough to cover the part of each big repair that has already worn out. A roof halfway through its life should have about half its cost saved.</p><figure class="rs-fig"><p class="cap">Percent funded: the cash in the fund, as a share of what it should hold by now</p><svg role="img" aria-label="Gauge of percent funded from 0 to 100 percent: weak under 30, fair from 30 to 70, strong from 70 up. The example building is at 26 percent, in the weak band. The same building with more saved is at 75 percent, in the strong band." viewBox="0 0 320 166" width="100%" style="display:block;max-width:500px;height:auto;margin:0 auto;font-family:var(--sans)"><clipPath id="rsBar"><rect x="6" y="62" width="308" height="30" rx="15"/></clipPath><g clip-path="url(#rsBar)"><rect x="6.0" y="62" width="92.4" height="30" fill="#a8482f"/><rect x="98.4" y="62" width="123.2" height="30" fill="#8f6131"/><rect x="221.6" y="62" width="92.4" height="30" fill="#3f7461"/></g><text x="52.2" y="82" text-anchor="middle" font-size="16" font-weight="700" fill="#fff">Weak</text><text x="160.0" y="82" text-anchor="middle" font-size="16" font-weight="700" fill="#fff">Fair</text><text x="267.8" y="82" text-anchor="middle" font-size="16" font-weight="700" fill="#fff">Strong</text><line x1="86.1" x2="86.1" y1="46" y2="92" stroke="#1c2028" stroke-width="2.5"/><circle cx="86.1" cy="46" r="4" fill="#1c2028"/><text x="80.1" y="36" text-anchor="start" font-size="17" font-weight="700" fill="#1c2028">Example: 26%</text><line x1="237.0" x2="237.0" y1="62" y2="108" stroke="#1c2028" stroke-width="2.5"/><circle cx="237.0" cy="108" r="4" fill="#1c2028"/><text x="243.0" y="128" text-anchor="end" font-size="17" font-weight="700" fill="#1c2028">With more saved: 75%</text><text x="6.0" y="154" text-anchor="start" font-size="15" fill="#5c6b78">0%</text><text x="98.4" y="154" text-anchor="middle" font-size="15" fill="#5c6b78">30%</text><text x="221.6" y="154" text-anchor="middle" font-size="15" fill="#5c6b78">70%</text><text x="314.0" y="154" text-anchor="end" font-size="15" fill="#5c6b78">100%</text></svg><figcaption>Association Reserves, a national reserve-study firm, set these bands from its clients' studies. The two marks show the example building below: as it is, and with more saved.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">In the weak band, repairs are often put off. In the strong band, the risk of a special assessment is low, and a fund does not need to be full to get there.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Among the firm's own clients, about a third were weak and a quarter strong. Those are associations that pay for a study, and the firm says they may be more careful with money than most.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Percent funded is a snapshot of today. It does not grade the plan, so we read the plan as well.</p></div></section><section style="background:var(--ivory)" id="example"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="An example">What does an underfunded condo building look like?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Here is one building with round numbers. It has 80 units, is 30 years old and has $400,000 saved.</p><figure class="rs-parts"><p class="cap">The example building's six big parts, and how much of each one's life is used</p><div class="in"><svg role="img" aria-label="Drawing of the example building with its six big parts numbered: 1 the flat roof, 2 the elevator machinery in the box on the roof, 3 the exterior paint, 4 the concrete balconies, 5 the parking lot, 6 the pool equipment. Parts 1, 2 and 3 are due within five years." viewBox="0 0 210 300" style="font-family:var(--sans)"><rect x="0" y="0" width="210" height="300" rx="14" fill="#e2ebe9"/><rect x="0" y="262" width="210" height="38" fill="#e2c69b"/><rect x="6" y="267" width="72" height="26" rx="3" fill="#8b9097"/><line x1="22" y1="269" x2="22" y2="281" stroke="#fff" stroke-width="1.5"/><line x1="38" y1="269" x2="38" y2="281" stroke="#fff" stroke-width="1.5"/><line x1="54" y1="269" x2="54" y2="281" stroke="#fff" stroke-width="1.5"/><line x1="70" y1="269" x2="70" y2="281" stroke="#fff" stroke-width="1.5"/><rect x="62" y="62" width="96" height="200" fill="#ede5d8" stroke="#1c2028" stroke-width="2"/><rect x="70" y="74" width="80" height="12" fill="#9fc6ce"/><rect x="65" y="87" width="90" height="3.5" fill="#5c6b78"/><rect x="70" y="95" width="80" height="12" fill="#9fc6ce"/><rect x="65" y="108" width="90" height="3.5" fill="#5c6b78"/><rect x="70" y="116" width="80" height="12" fill="#9fc6ce"/><rect x="65" y="129" width="90" height="3.5" fill="#5c6b78"/><rect x="70" y="137" width="80" height="12" fill="#9fc6ce"/><rect x="65" y="150" width="90" height="3.5" fill="#5c6b78"/><rect x="70" y="158" width="80" height="12" fill="#9fc6ce"/><rect x="65" y="171" width="90" height="3.5" fill="#5c6b78"/><rect x="70" y="179" width="80" height="12" fill="#9fc6ce"/><rect x="65" y="192" width="90" height="3.5" fill="#5c6b78"/><rect x="70" y="200" width="80" height="12" fill="#9fc6ce"/><rect x="65" y="213" width="90" height="3.5" fill="#5c6b78"/><rect x="70" y="221" width="80" height="12" fill="#9fc6ce"/><rect x="65" y="234" width="90" height="3.5" fill="#5c6b78"/><rect x="100" y="244" width="20" height="18" fill="#2a3040"/><rect x="57" y="55" width="106" height="8" fill="#2a3040"/><rect x="112" y="34" width="34" height="21" fill="#c9bfae" stroke="#1c2028" stroke-width="2"/><rect x="164" y="272" width="40" height="14" rx="3" fill="#80b1bc"/><rect x="166" y="252" width="15" height="12" fill="#c9bfae" stroke="#1c2028" stroke-width="1.5"/><circle cx="42" cy="59" r="10" fill="#a8482f" stroke="#fff" stroke-width="2"/><text x="42" y="63.5" text-anchor="middle" font-size="13" font-weight="700" fill="#fff">1</text><circle cx="168" cy="44" r="10" fill="#a8482f" stroke="#fff" stroke-width="2"/><text x="168" y="48.5" text-anchor="middle" font-size="13" font-weight="700" fill="#fff">2</text><circle cx="46" cy="150" r="10" fill="#a8482f" stroke="#fff" stroke-width="2"/><text x="46" y="154.5" text-anchor="middle" font-size="13" font-weight="700" fill="#fff">3</text><circle cx="174" cy="118" r="10" fill="#1c2028" stroke="#fff" stroke-width="2"/><text x="174" y="122.5" text-anchor="middle" font-size="13" font-weight="700" fill="#fff">4</text><circle cx="42" cy="280" r="10" fill="#1c2028" stroke="#fff" stroke-width="2"/><text x="42" y="284.5" text-anchor="middle" font-size="13" font-weight="700" fill="#fff">5</text><circle cx="195" cy="246" r="10" fill="#1c2028" stroke="#fff" stroke-width="2"/><text x="195" y="250.5" text-anchor="middle" font-size="13" font-weight="700" fill="#fff">6</text></svg><ol aria-label="The six parts and the share of each one's life used"><li class="due"><span class="no" aria-hidden="true">1</span><span class="nm">Flat roof<small>15 of 20 years used</small></span><span class="bar" aria-hidden="true"><i style="--f:0.750"></i></span></li><li class="due"><span class="no" aria-hidden="true">2</span><span class="nm">Elevator machinery, two elevators<small>17 of 20 years used</small></span><span class="bar" aria-hidden="true"><i style="--f:0.850"></i></span></li><li class="due"><span class="no" aria-hidden="true">3</span><span class="nm">Exterior paint<small>6 of 8 years used</small></span><span class="bar" aria-hidden="true"><i style="--f:0.750"></i></span></li><li><span class="no" aria-hidden="true">4</span><span class="nm">Concrete balconies<small>30 of 40 years used</small></span><span class="bar" aria-hidden="true"><i style="--f:0.750"></i></span></li><li><span class="no" aria-hidden="true">5</span><span class="nm">Parking lot paving<small>12 of 25 years used</small></span><span class="bar" aria-hidden="true"><i style="--f:0.480"></i></span></li><li><span class="no" aria-hidden="true">6</span><span class="nm">Pool equipment<small>4 of 10 years used</small></span><span class="bar" aria-hidden="true"><i style="--f:0.400"></i></span></li></ol></div><figcaption class="key"><b aria-hidden="true"></b>Red: due within the next 5 years. Each part's life is the planning life used by the U.S. Department of Housing and Urban Development (HUD).</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Together, these parts should have about $1.5 million saved by now. The fund is 26 percent funded: weak.</p><div class="rs-gap"><p class="k">The example building, the next 5 years</p><p class="big"><strong>$380,000</strong><span>short</span></p><p class="t">The flat roof, the elevator machinery and the exterior paint come due. By then the fund will hold about two thirds of what they cost.</p><p class="per">Split evenly: about <strong>$4,750</strong> for each of the 80 owners.</p></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The same building at 75 percent funded has no gap. The concrete balconies come next, 10 years out.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The example leaves out inflation and interest. A real condo splits a gap by each unit's percentage in its founding papers, not evenly.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Saving ahead costs owners less</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Saved money earns interest. A special assessment pays the full price, and a bank loan adds its interest.</p><div class="rs-roof"><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="What a $250,000 roof costs the owners, three ways"><span class="cap" aria-hidden="true">What a $250,000 roof costs the owners, three ways</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">How it is paid, why</span><span role="columnheader">cost to owners</span></div></div><div role="rowgroup"><div role="row"><span role="rowheader"><span class="n">Paid from savings</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">less than the price, as savings earn interest</span></span><span role="cell"><span class="b" style="--f:0.724" aria-hidden="true"></span><span class="v">$230,000</span></span></div><div role="row" class="ref"><span role="rowheader"><span class="n">A special assessment</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">the full price, all at once</span></span><span role="cell"><span class="b" style="--f:0.781" aria-hidden="true"></span><span class="v">$250,000</span></span></div><div role="row"><span role="rowheader"><span class="n">A bank loan</span><span class="dot" aria-hidden="true">&middot;</span><span class="f">plus the interest on the loan</span></span><span role="cell"><span class="b" style="--f:1" aria-hidden="true"></span><span class="v">$320,000</span></span></div></div></div><figcaption>The same reserve-study firm's example, rounded to the nearest $10,000.</figcaption></figure></div><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Is a building you like this far behind?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Tell us the building, and we compare its reserve cash with what its study says it should hold.</p><a class="btn btn-brass" href="/contact/">Have us check its savings</a></div></div></section><section style="background:var(--ivory-2)" id="lenders"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What lenders require">What do lenders require for condo reserves?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">For most conventional condo loans, the lender tests the building's budget. Fannie Mae and Freddie Mac buy these loans from lenders, and the test is theirs.</p><ul class="rs-ways" aria-label="What the lender's reserve test means for a buyer"><li><b>How a building passes</b>At least 10 percent of its dues goes into reserves. Or it saves what a current reserve study says it should.</li><li class="no"><b>When it fails</b>A buyer there cannot get a conventional loan that follows these rules, though <a href="/invest/non-warrantable-condos/" style="color:var(--navy);text-decoration:underline">some other loans</a> still work. When you <a href="/sell/sell-my-condo/" style="color:var(--navy);text-decoration:underline">sell a condo</a> there, your buyer's lender runs the same test.</li></ul><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">10 percent or 15 percent?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Freddie Mac raises its line to 15 percent for loan applications received on or after January 4, 2027. It says it made the change with its regulator and in alignment with Fannie Mae. Fannie Mae's own guide still says 10 percent.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">From that date, a building that puts 12 percent into reserves fails Freddie Mac's test and passes Fannie Mae's guide as it reads now. Which one applies depends on which company buys your loan. Your loan officer can tell you before you apply.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Freddie Mac made the change after buildings with underfunded reserves turned out to be the same ones needing critical repairs. It says owners in those buildings can face special assessments or <a href="/hoa/dues-increases/" style="color:var(--navy);text-decoration:underline">higher dues</a>.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">A building can pass and still be weak</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The test reads one line of this year's budget, not the cash in the bank. Our example building puts 10.4 percent of its dues into reserves, so it passes while 26 percent funded. Try your own building's numbers:</p><div class="rs-calc"><p class="k">Does this budget pass the lender's test?</p><div class="g"><label>Units in the building<span class="u"><input id="rsUnits" type="text" value="80" inputmode="numeric" autocomplete="off" oninput="c3Rs()" onchange="c3RsF(this)" aria-label="Units in the building"></span></label><label>Dues per unit, a month<span class="u">$<input id="rsDues" type="text" value="600" inputmode="numeric" autocomplete="off" oninput="c3Rs()" onchange="c3RsF(this)" aria-label="Dues per unit, a month"></span></label><label>Reserve line in the yearly budget<span class="u">$<input id="rsRes" type="text" value="60,000" inputmode="numeric" autocomplete="off" oninput="c3Rs()" onchange="c3RsF(this)" aria-label="Reserve line in the yearly budget"></span></label></div><div class="out"><span>Share of dues going to reserves</span><strong id="rsShare">10.4%</strong></div><p class="note" id="rsNote">Passes 10 percent. Short of Freddie Mac's 15 percent by about $28 per unit a month in dues.</p><p class="k k2">If the building has a reserve study</p><div class="g"><label>Cash in the reserve fund<span class="u">$<input id="rsBal" type="text" value="400,000" inputmode="numeric" autocomplete="off" oninput="c3Rs()" onchange="c3RsF(this)" aria-label="Cash in the reserve fund"></span></label><label>What the study says it should hold<span class="u">$<input id="rsFfb" type="text" value="1,515,600" inputmode="numeric" autocomplete="off" oninput="c3Rs()" onchange="c3RsF(this)" aria-label="What the study says it should hold"></span></label></div><div class="out"><span>Percent funded</span><strong id="rsPf">26%</strong></div><p class="note" id="rsBand">Weak.</p></div><script>function c3RsN(id){var e=document.getElementById(id);if(!e)return NaN;var t=String(e.value).replace(/[$,\s]/g,"");if(t==="")return NaN;var v=parseFloat(t);return isFinite(v)&&v>=0?v:NaN}function c3RsF(e){var t=String(e.value).replace(/[$,\s]/g,""),v=parseFloat(t);if(t!==""&&isFinite(v)&&v>=0)e.value=Math.round(v).toLocaleString("en-US")}function c3Rs(){var g=function(id){var v=c3RsN(id);return isFinite(v)?v:0};var s=document.getElementById("rsShare"),n=document.getElementById("rsNote"),p=document.getElementById("rsPf"),b=document.getElementById("rsBand");if(!s||!n||!p||!b)return;var inc=g("rsUnits")*g("rsDues")*12,res=g("rsRes");if(!inc){s.textContent="--";n.textContent="Enter the units and the dues.";}else{var sh=res/inc*100;s.textContent=(Math.round(sh*10)/10)+"%";var need=Math.max(0,(0.15*inc-res)/g("rsUnits")/12);n.textContent=sh>=15?"Passes both the 10 and the 15 percent line.":sh>=10?"Passes 10 percent. Short of Freddie Mac's 15 percent by about $"+Math.ceil(need)+" per unit a month in dues.":"Fails the 10 percent test. To reach it: about $"+Math.ceil(Math.max(0,(0.1*inc-res)/g("rsUnits")/12))+" more per unit a month in dues.";}var ffb=c3RsN("rsFfb"),bal=c3RsN("rsBal");if(!(ffb>0)){p.textContent="--";b.textContent="Enter what the study says the fund should hold.";return}if(!isFinite(bal))bal=0;var pf=Math.round(bal/ffb*100);p.textContent=pf+"%";b.textContent=pf<30?"Weak.":pf<70?"Fair.":"Strong.";}document.addEventListener("DOMContentLoaded",c3Rs);</script></div></section><section style="background:var(--ivory)" id="why-here"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Why it matters here">Why do reserves matter more on the Grand Strand?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Most condos for sale here are in buildings 30 years or older, and the elevator and oceanfront buildings are older still.</p><div class="rs-here"><div><style>main#main .c3-gchart.c3-gchart-compact{padding-top:1rem;padding-bottom:.85rem}main#main .c3-gchart.c3-gchart-compact .cap{margin-bottom:.7rem}main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.5rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.1rem .9rem}main#main .c3-gchart.c3-gchart-compact [role=rowheader]{line-height:1.3}main#main .c3-gchart.c3-gchart-compact .b{height:.5rem;min-width:.5rem}main#main .c3-gchart.c3-gchart-compact .v{line-height:1.25}main#main .c3-gchart.c3-gchart-compact figcaption{margin-top:.8rem}@media (max-width:699px){main#main .c3-gchart.c3-gchart-compact [role=rowgroup]{gap:.45rem}main#main .c3-gchart.c3-gchart-compact [role=row]{gap:.05rem}}</style><figure class="c3-gchart c3-gchart-compact"><div role="table" aria-label="Share of Grand Strand condos for sale in buildings 30 years or older"><span class="cap" aria-hidden="true">Share of Grand Strand condos for sale in buildings 30 years or older</span><div role="rowgroup" class="sr"><div role="row"><span role="columnheader">Condos for sale</span><span role="columnheader">share</span></div></div><div role="rowgroup"><div role="row" class="ref"><span role="rowheader"><span class="n">All condos for sale</span></span><span role="cell"><span class="b" style="--f:0.56" aria-hidden="true"></span><span class="v">56%</span></span></div><div role="row"><span role="rowheader"><span class="n">In elevator buildings</span></span><span role="cell"><span class="b" style="--f:0.58" aria-hidden="true"></span><span class="v">58%</span></span></div><div role="row"><span role="rowheader"><span class="n">In oceanfront buildings</span></span><span role="cell"><span class="b" style="--f:0.65" aria-hidden="true"></span><span class="v">65%</span></span></div></div></div><figcaption>Our count of the condos for sale in the local MLS, by the year built on each listing. Each listing also says whether its building has an elevator and whether it is oceanfront.</figcaption></figure><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">HUD plans on elevator machinery lasting 20 years and a flat roof 15 to 20. A 30-year-old tower has passed one planning life of each.</p></div><div class="c3-aerial"><figure class="c3ph-hero" style=""><div class="c3ph-f"><img src="/images/2026-10-d/hoa-reserves/myrtle-beach-oceanfront-towers-2011-1200w.webp" srcset="/images/2026-10-d/hoa-reserves/myrtle-beach-oceanfront-towers-2011-600w.webp 600w, /images/2026-10-d/hoa-reserves/myrtle-beach-oceanfront-towers-2011-1200w.webp 1200w" sizes="(max-width: 1200px) 100vw, 1136px" width="1200" height="675" alt="A row of oceanfront towers in Myrtle Beach with flat roofs, stacked balconies and pools behind the dunes, seen from a plane over the ocean" loading="lazy" decoding="async"><span class="c3ph-cr"><a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer" aria-label="Photo: U.S. Geological Survey. License: Public domain" title="License: Public domain">Photo: U.S. Geological Survey</a></span></div><figcaption>Oceanfront towers in Myrtle Beach, seen from a plane over the ocean. Their roofs, rooftop boxes and stacked balconies are the kind of parts a reserve fund saves for.</figcaption></figure></div></div><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The HOA fee will not tell you which <a href="/invest/condo-buildings/" style="color:var(--navy);text-decoration:underline">condo buildings</a> have saved. In buildings 30 years or older, the middle listed fee is about $700 a month, close to the $640 for all condos for sale. We read the study instead.</p><div style="border-left:3px solid var(--brass);background:var(--ivory-2);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">Has an older tower saved for its elevators?</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Name the tower. We find when its roof and elevators were last replaced, and whether its fund covers the next ones.</p><a class="btn btn-brass" href="/contact/">Ask us to check an older tower</a></div></div></section><section style="background:var(--ivory-2)" id="other-states"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="Other states">What do other states require for condo reserves?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem"><a href="/buyers/relocating/from-florida/" style="color:var(--navy);text-decoration:underline">Florida</a>, <a href="/buyers/relocating/from-new-jersey/" style="color:var(--navy);text-decoration:underline">New Jersey</a>, <a href="/buyers/relocating/from-maryland/" style="color:var(--navy);text-decoration:underline">Maryland</a> and Virginia make condo boards study their reserves on a schedule. A buyer from one of them should not expect the same here.</p><div class="rs-st"><p class="cap">What the law requires of condo associations, by state</p><table><thead><tr><th scope="col">State</th><th scope="col">Reserve study required</th><th scope="col">How often</th></tr></thead><tbody><tr class="sc"><th scope="row">South Carolina</th><td data-l="Reserve study required">No</td><td data-l="How often">Never required</td></tr><tr><th scope="row">Florida</th><td data-l="Reserve study required">Yes, for condo buildings 3 stories or taller</td><td data-l="How often">At least every 10 years</td></tr><tr><th scope="row">New Jersey</th><td data-l="Reserve study required">Yes</td><td data-l="How often">At least every 5 years for concrete, masonry or steel condo buildings</td></tr><tr><th scope="row">Maryland</th><td data-l="Reserve study required">Yes</td><td data-l="How often">At least every 5 years</td></tr><tr><th scope="row">Virginia</th><td data-l="Reserve study required">Yes, unless the condo's own papers say otherwise</td><td data-l="How often">At least every 5 years</td></tr></tbody></table></div></div></section><section style="background:var(--ivory)" id="reserve-study"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="No study, or an old one">What if a building has no reserve study, or an old one?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No law here requires a reserve study, so a building can have none, or one that is years old. A missing study is a reason to look harder, not proof of a problem.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Without one, we judge the building from its budget, its balance sheet, its board minutes and the age of its big parts.</p><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">When there is a study, a lender accepts it, or an update, only if it is no more than three years old. Among the same reserve-study firm's clients, associations that update at least every three years were told to charge a new special assessment about half as often as those that update every five.</p></div></section><section style="background:var(--ivory-2)" id="what-we-read"><div class="wrap"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3" data-toc="What we read">What should a buyer check in a condo's reserves?</h2><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Our agents read the HOA documents for a buyer. For reserves, these five tell us whether the building can pay for its own roof:</p><ol style="color:var(--muted);line-height:1.75;max-width:720px;margin:0 0 1rem 1.3rem;padding:0"><li style="margin-bottom:.5rem"><strong>The reserve study.</strong> Its date, the percent funded and its plan. A plan that only keeps the fund above zero is a warning.</li><li style="margin-bottom:.5rem"><strong>The budget's reserve line.</strong> The share of the dues it puts into reserves.</li><li style="margin-bottom:.5rem"><strong>The balance sheet.</strong> The cash in reserves, against what the study says should be there.</li><li style="margin-bottom:.5rem"><strong>The age of the big parts.</strong> The roof, the elevators, the paint and the balconies, against HUD's lives and the year the building was built.</li><li style="margin-bottom:.5rem"><strong>The board's minutes.</strong> Repairs put off, or a special assessment under discussion. <a href="/hoa/documents/" style="color:var(--navy);text-decoration:underline">The HOA documents a buyer receives</a> are only part of what we ask for.</li></ol><div style="border-left:3px solid var(--brass);background:var(--ivory);padding:1.2rem 1.4rem;margin:1.8rem 0;max-width:720px"><p style="color:var(--navy);font-weight:600;margin-bottom:.4rem">What you get when we read a building</p><p style="color:var(--muted);line-height:1.7;margin-bottom:.8rem">Its percent funded, its cash against the study, whether its budget passes a lender's test, and the big parts coming due.</p><a class="btn btn-brass" href="/contact/">Send us the building's name</a></div><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">When you see the papers, and when you can still back out</h3><ol class="rs-flow rs-when" aria-label="When a buyer sees the papers, and when the buyer can still back out"><li><b>Before you sign</b>In most resales, the seller fills in a disclosure form. It asks whether the association has levied any special assessments.</li><li><b>After you sign</b>The standard South Carolina sales contract has a due diligence period. In it, you <a href="https://rosenhagood.com/sc-residential-property-agreements-transitions-to-due-diligence-only-model/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">can end the contract</a> with a written notice to the seller.</li><li class="last"><b>Inside that period</b>Read the reserve study, the budget, the balance sheet and the minutes.</li></ol><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">If they are weak, you can ask for a lower price or a credit at closing, or walk away.</p></div></section><section style="background:var(--ivory)" id="reserve-questions"><div class="wrap"><p style="font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--brass);margin-bottom:.5rem;font-weight:600">Common questions</p><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--navy);margin-bottom:1rem;line-height:1.3">Reserve questions</h2><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does South Carolina require a reserve study?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">No, and it requires no reserve fund either. A board can still choose to get one, and a lender can accept a current study in place of its budget test.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Who pays a special assessment voted before closing?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">The purchase contract decides, so it belongs in the offer. A bill the seller already owes is paid at closing, and a buyer can be held to it only up to the association's written statement of it.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Can I see an HOA's reserve records before I buy?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">Members can. An HOA member can inspect and copy the budget and the accounting records after giving written notice five business days ahead. A buyer is not yet a member, so we ask the seller for them.</p><h3 style="font-family:var(--serif);font-size:1.25rem;color:var(--navy);margin:1.6rem 0 .6rem">Does a newer condo building need strong reserves?</h3><p style="color:var(--muted);line-height:1.75;max-width:720px;margin-bottom:1rem">A newer building needs less saved by now. A building finished in 2015 is 11 years old, short of HUD's planning life for its elevator machinery and its flat roof, so less of each has worn out. Percent funded still applies: what the fund holds against that smaller amount.</p><p style="font-size:.78rem;color:var(--muted);line-height:1.7;max-width:760px;margin-top:1.6rem"><strong style="color:var(--navy)">Sources:</strong> <a href="https://www.scstatehouse.gov/code/t27c031.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 27-31</a>, <a href="https://www.scstatehouse.gov/code/t27c030.php" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">SC Code 27-30</a>, <a href="https://selling-guide.fanniemae.com/sel/b4-2.2-02/full-review-process" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Fannie Mae B4-2.2-01</a>, <a href="https://guide.freddiemac.com/app/guide/bulletin/2026-C" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Freddie Mac Bulletin 2026-C</a>, <a href="https://www.caionline.org/getmedia/7b5f1422-d10b-4cad-87b7-d1339c0f0ee8/explanation-of-reserve-study-standards-2025-final.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Community Associations Institute reserve study standards</a>, <a href="https://www.reservestudy.com/wp-content/uploads/2026/05/2026-04-29-100000-Industry-Insights-Report-FINAL.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Association Reserves 2026 report</a>, <a href="https://www.hud.gov/sites/documents/eul_for_cna_e_tool.pdf" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">HUD useful lives</a>, <a href="https://www.leg.state.fl.us/statutes/index.cfm?App_mode=Display_Statute&URL=0700-0799/0718/Sections/0718.112.html" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Fla. Stat. 718.112</a>, <a href="https://pub.njleg.state.nj.us/Bills/2022/PL23/214_.HTM" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">N.J. P.L.2023 c.214</a>, <a href="https://mgaleg.maryland.gov/mgawebsite/Laws/StatuteText?article=grp&section=11-109.4&enactments=false" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Md. Real Prop. 11-109.4</a>, <a href="https://law.lis.virginia.gov/vacode/title55.1/chapter19/section55.1-1965/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Va. Code 55.1-1965</a>, <a href="https://rosenhagood.com/sc-residential-property-agreements-transitions-to-due-diligence-only-model/" style="color:var(--navy);text-decoration:underline" target="_blank" rel="noopener noreferrer">Rosen Hagood: SC due diligence contract</a>. Condos for sale: our count of active MLS listings, by year built. The example uses round numbers. Not legal advice.</p><div class="c3ph-credits"><div class="c3ph-h" id="photo-credits">Photo credits</div><div role="list" aria-labelledby="photo-credits"><div role="listitem">Oceanfront towers in Myrtle Beach, seen from a plane over the ocean. Photo: U.S. Geological Survey, <a href="https://www.usa.gov/publicdomain/label/1.0/" target="_blank" rel="noopener noreferrer">Public domain</a>, via <a href="https://doi.org/10.5066/F7N877XX" target="_blank" rel="noopener noreferrer">U.S. Geological Survey</a>. Chapter3 Realty cropped and resized the photo.</div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"ImageObject","contentUrl":"https://chapter3realty.com/images/2026-10-d/hoa-reserves/myrtle-beach-oceanfront-towers-2011-1200w.webp","url":"https://chapter3realty.com/images/2026-10-d/hoa-reserves/myrtle-beach-oceanfront-towers-2011-1200w.webp","width":1200,"height":675,"encodingFormat":"image/webp","name":"Oceanfront towers in Myrtle Beach, seen from a plane over the ocean","caption":"Oceanfront towers in Myrtle Beach, seen from a plane over the ocean. Their roofs, rooftop boxes and stacked balconies are the kind of parts a reserve fund saves for.","description":"A row of oceanfront towers in Myrtle Beach with flat roofs, stacked balconies and pools behind the dunes, seen from a plane over the ocean","creator":{"@type":"Organization","name":"U.S. Geological Survey"},"creditText":"U.S","copyrightNotice":"Public domain (U.S. Geological Survey)","license":"https://www.usa.gov/publicdomain/label/1.0/","acquireLicensePage":"https://doi.org/10.5066/F7N877XX","isBasedOn":"https://doi.org/10.5066/F7N877XX","contentLocation":{"@type":"Place","name":"Oceanfront, central Myrtle Beach, Myrtle Beach, South Carolina"},"representativeOfPage":true}]}</script></div></section><section style="background:var(--navy);padding:3rem 0"><div class="wrap" style="text-align:center;max-width:720px;margin:0 auto"><h2 style="font-family:var(--serif);font-size:1.7rem;color:var(--ivory);margin-bottom:1rem">Not sure whether a building has saved enough?</h2><p style="color:rgba(244,239,232,.75);line-height:1.7;margin-bottom:1.6rem">Send the name. We read the study, the budget and the balance sheet and give you a straight answer.</p><a class="btn btn-brass btn-lg" href="/contact/">Ask about a building</a></div></section></main>
